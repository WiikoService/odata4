#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

// Профиль с ошибками (неизвестные объекты и поля, неразбираемые выражения отборов, неположительные правила
// частоты) не записывается: текст ошибок — в исключении.
Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Ошибки = OData4_Профили.ПроверитьПрофиль(ЭтотОбъект);
	Если Ошибки.Количество() > 0 Тогда
		ВызватьИсключение "Профиль OData4 " + Наименование + " не записан:" + Символы.ПС + СтрСоединить(Ошибки, Символы.ПС);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли
