#Область ПрограммныйИнтерфейс

// Обрабатывает запрос к HTTP-сервису: вход (OData4_Безопасность.Войти), маршрут, выполнение, ответ OData;
// затем заголовки CORS и журнал (OData4_Журнал: ни то, ни другое ответ не меняет, кроме заголовков CORS
// разрешённого источника). ИмяСервиса: "odata" (Basic) или "odatat" (токены; публикация с фиксированным
// пользователем; путь «/t/<токен>/v4/…» — см. OData4_Безопасность.ЗапросСТокеномВПути).
Функция Обработать(Запрос, ИмяСервиса = "odata") Экспорт
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Итог = Новый Структура("Строк, ТекстОшибки", 0, "");
	ЗапросСервиса = OData4_Безопасность.ЗапросСТокеномВПути(Запрос, ИмяСервиса);
	Ответ = ВыполнитьЗапрос(ЗапросСервиса, Итог, ИмяСервиса);
	Завершить(ЗапросСервиса, Ответ, Начало, Итог, ИмяСервиса);
	Возврат Ответ;
КонецФункции

// Отвечает на OPTIONS: 204 с Allow (методы шаблонов сервиса из метаданных) и заголовками CORS разрешённого
// источника; журнал — как у GET.
// Вход не выполняется: предварительный запрос браузера идёт без учётных данных и без токена.
Функция ОбработатьOPTIONS(Запрос, ИмяСервиса = "odata") Экспорт
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Итог = Новый Структура("Строк, ТекстОшибки", 0, "");
	ЗапросСервиса = OData4_Безопасность.ЗапросСТокеномВПути(Запрос, ИмяСервиса);
	Попытка
		Ответ = OData4_Журнал.ОтветOPTIONS(ЗапросСервиса, ИмяСервиса);
	Исключение
		ЗаписьЖурналаРегистрации("OData4.Журнал", УровеньЖурналаРегистрации.Ошибка, , ,
			"Ответ на OPTIONS без заголовков CORS: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Ответ = Новый HTTPСервисОтвет(204);
		Ответ.Заголовки.Вставить("Allow", OData4_Журнал.МетодыСервиса(ИмяСервиса));
	КонецПопытки;
	Завершить(ЗапросСервиса, Ответ, Начало, Итог, ИмяСервиса);
	Возврат Ответ;
КонецФункции

// Вход, разбор и выполнение запроса; Итог получает число строк и текст ошибки для журнала. Ресурс $batch (этап 7)
// проверяется до ветки записи: POST $batch — OData4_ПакетВыполнение (операции — ВыполнитьОперацию), иной метод — 405.
Функция ВыполнитьЗапрос(Запрос, Итог, ИмяСервиса)
	Попытка
		OData4_Безопасность.Войти(Запрос, ИмяСервиса);
		Если OData4_ПакетВыполнение.ЭтоПакет(Запрос) Тогда
			Возврат OData4_ПакетВыполнение.ВыполнитьПакет(Запрос, Итог, ИмяСервиса);
		КонецЕсли;
		Возврат ВыполнитьМаршрут(Запрос, Итог);
	Исключение
		Возврат ОтветПоИсключению(ИнформацияОбОшибке(), Итог);
	КонецПопытки;
КонецФункции

// Операция пакета $batch (этап 7): тот же конвейер, что у одиночного запроса, без входа (он один на пакет), заголовков
// CORS и журнала. Запрос — Структура с полями HTTPСервисЗапрос (HTTPМетод, ОтносительныйURL «/v4/…»,
// ПараметрыЗапроса, БазовыйURL, Заголовки, Тело строкой). Ошибка — ответ OData об ошибке, как у одиночного запроса;
// Итог получает число строк и текст ошибки для журнала операции.
Функция ВыполнитьОперацию(Запрос, Итог) Экспорт
	Попытка
		Возврат ВыполнитьМаршрут(Запрос, Итог);
	Исключение
		Возврат ОтветПоИсключению(ИнформацияОбОшибке(), Итог);
	КонецПопытки;
КонецФункции

// Маршрут и выполнение запроса после входа; ошибки — исключением (ответ — ОтветПоИсключению у вызывающего).
Функция ВыполнитьМаршрут(Запрос, Итог)
	Если OData4_Запись.ЭтоЗапись(Запрос) Тогда
		// Методы записи и действия (6.2): свой маршрут и свой ответ; ошибки — сюда же, в ОтветПоИсключению.
		Возврат OData4_Запись.ВыполнитьЗапрос(Запрос, Итог);
	КонецЕсли;
	Маршрут = OData4_Маршрутизатор.Разобрать(Запрос.ОтносительныйURL, Запрос.ПараметрыЗапроса);
	OData4_Безопасность.ПроверитьЛимиты(Маршрут);
	Адрес = Запрос.БазовыйURL + "/v4";
	Если Маршрут.Вид = "СлужебныйДокумент" Тогда
		Возврат OData4_Сериализация.ОтветJSON(200, OData4_Чтение.СлужебныйДокумент(Адрес));
	КонецЕсли;
	Если Маршрут.Вид = "Метаданные" Тогда
		Если ФорматМетаданных(Маршрут, Запрос.Заголовки) = "json" Тогда
			Возврат OData4_Сериализация.ОтветТекст(200, OData4_МодельПовтИсп.Метаданные("JSON"),
				"application/json;charset=utf-8");
		КонецЕсли;
		Возврат OData4_Сериализация.ОтветТекст(200, OData4_МодельПовтИсп.Метаданные("XML"), "application/xml;charset=utf-8");
	КонецЕсли;
	Если Маршрут.Вид = "Коллекция" Тогда
		// Одним ответом (настройка ВыдачаКоллекций) — только одиночный запрос: операция $batch (Запрос — Структура)
		// встраивает текст ответа.
		Результат = OData4_Чтение.Коллекция(Маршрут, Адрес, Запрос.Заголовки, , ТипЗнч(Запрос) <> Тип("Структура"));
		Итог.Строк = Результат.Строк;
		Если Результат.Свойство("Ответ") Тогда
			Возврат Результат.Ответ;
		КонецЕсли;
		Возврат OData4_Сериализация.ОтветJSON(200, Результат.Текст, Результат.Заголовки);
	КонецЕсли;
	Если Маршрут.Вид = "Сущность" Тогда
		Версия = "";
		Текст = OData4_Чтение.Сущность(Маршрут, Адрес, Версия);
		Итог.Строк = 1;
		Заголовки = Новый Соответствие;
		Если Версия <> "" Тогда
			Заголовки.Вставить("ETag", OData4_Сериализация.ЗначениеETag(Версия));
		КонецЕсли;
		Возврат OData4_Сериализация.ОтветJSON(200, Текст, Заголовки);
	КонецЕсли;
	Если Маршрут.Вид = "Количество" Тогда
		Возврат OData4_Сериализация.ОтветТекст(200, Формат(OData4_Чтение.Количество(Маршрут), "ЧН=0; ЧГ=0"),
			"text/plain;charset=utf-8");
	КонецЕсли;
	ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Запрос.ОтносительныйURL);
КонецФункции

// Прерывает обработку ответом OData с указанным статусом.
Процедура ОшибкаOData(Статус, Код, Сообщение) Экспорт
	ВызватьИсключение "ODATA4|" + Формат(Статус, "ЧГ=0") + "|" + Код + "|" + Сообщение;
КонецПроцедуры

// Постоянный текст ответа 500 (решение 16): подробности — только в журнале регистрации.
Функция ТекстВнутреннейОшибки() Экспорт
	Возврат "Внутренняя ошибка сервиса OData4 (подробности — в журнале регистрации, событие OData4)";
КонецФункции

// Текст сообщения из исключения OData4_Сервис.ОшибкаOData; иное исключение — краткое представление.
Функция СообщениеОшибки(Информация) Экспорт
	Текст = Информация.Описание;
	Позиция = СтрНайти(Текст, "ODATA4|");
	Если Позиция = 0 Тогда
		Возврат КраткоеПредставлениеОшибки(Информация);
	КонецЕсли;
	Части = СтрРазделить(Сред(Текст, Позиция), "|");
	Сообщение = Новый Массив;
	Для Индекс = 3 По Части.ВГраница() Цикл
		Сообщение.Добавить(Части[Индекс]);
	КонецЦикла;
	Возврат СтрСоединить(Сообщение, "|");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ответ об ошибке: исключение OData4_Сервис.ОшибкаOData — его статус и текст; нарушение прав пользователя 1С
// («Недостаточно прав…») — 403 с именем объекта; иное — 500 с постоянным текстом: подробности (в них бывает
// текст запроса 1С с именами таблиц и полей, в том числе исключённых профилем) — только в журнале регистрации.
// Заголовки контекста запроса (Retry-After) добавляются к ответу. Итог.ТекстОшибки — текст, который
// получил клиент (он же уходит в журнал запросов). Экспорт — для операций $batch (OData4_ПакетВыполнение).
Функция ОтветПоИсключению(Информация, Итог) Экспорт
	Текст = Информация.Описание;
	Позиция = СтрНайти(Текст, "ODATA4|");
	Если Позиция > 0 Тогда
		Части = СтрРазделить(Сред(Текст, Позиция), "|");
		Сообщение = Новый Массив;
		Для Индекс = 3 По Части.ВГраница() Цикл
			Сообщение.Добавить(Части[Индекс]);
		КонецЦикла;
		Итог.ТекстОшибки = СтрСоединить(Сообщение, "|");
		// Подробности (error.details) — у ошибок записи (6.2): сообщения пользователю и текст исключения.
		Ответ = OData4_Сериализация.ОтветОшибки(Число(Части[1]), Части[2], Итог.ТекстОшибки, OData4_Запись.ПодробностиОшибки());
	ИначеЕсли OData4_Безопасность.ЭтоНарушениеПрав(Информация) Тогда
		ЗаписьЖурналаРегистрации("OData4", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(Информация));
		Итог.ТекстОшибки = ТекстНарушенияПрав(Информация);
		Ответ = OData4_Сериализация.ОтветОшибки(403, "Forbidden", Итог.ТекстОшибки);
	Иначе
		ЗаписьЖурналаРегистрации("OData4", УровеньЖурналаРегистрации.Ошибка, , ,
			ПодробноеПредставлениеОшибки(Информация));
		Итог.ТекстОшибки = ТекстВнутреннейОшибки();
		Ответ = OData4_Сериализация.ОтветОшибки(500, "InternalError", Итог.ТекстОшибки);
	КонецЕсли;
	Попытка
		Для Каждого КлючИЗначение Из OData4_БезопасностьВызов.Контекст().ЗаголовкиОтвета Цикл
			Ответ.Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	Исключение
		// Контекст недоступен — ответ без дополнительных заголовков.
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// «Служебному пользователю не хватает прав на Справочник.Валюты» (сервис odatat) или «Пользователю <имя> …»
// (odata): объект — из текста платформы «Недостаточно прав для работы с таблицей "…"», если он есть.
Функция ТекстНарушенияПрав(Информация)
	Контекст = OData4_БезопасностьВызов.Контекст();
	Кому = ?(Контекст.Сервис = "odatat", "Служебному пользователю", "Пользователю " + ИмяПользователя());
	Текст = Информация.Описание;
	Объект = "";
	Начало = СтрНайти(Текст, "таблицей """);
	Если Начало > 0 Тогда
		Остаток = Сред(Текст, Начало + 9);
		Конец = СтрНайти(Остаток, """");
		Если Конец > 1 Тогда
			Объект = Лев(Остаток, Конец - 1);
		КонецЕсли;
	КонецЕсли;
	Возврат Кому + " не хватает прав" + ?(Объект = "", "", " на " + Объект);
КонецФункции

// Признак сервиса, заголовки CORS и журнал запроса (OData4_Журнал: ни то, ни другое не бросает исключение).
// X-OData4-Server — в каждом ответе, и в ошибке: по нему клиенты (onec-rest-mcp) отличают OData4 от другого
// сервиса OData v4 и знают, что состав и права задаются в самой базе (обработка «Настройки OData4»).
Процедура Завершить(Запрос, Ответ, Начало, Итог, ИмяСервиса)
	Ответ.Заголовки.Вставить("X-OData4-Server", "OData4");
	OData4_Журнал.ДобавитьЗаголовкиCORS(Запрос, Ответ);
	Контекст = Новый Структура("Начало, Сервис, Метод, Путь, Параметры, Статус, Длительность, Строк, ТекстОшибки");
	Контекст.Начало = Начало;
	Контекст.Сервис = ИмяСервиса;
	Контекст.Метод = Запрос.HTTPМетод;
	Контекст.Путь = Запрос.ОтносительныйURL;
	Контекст.Параметры = Запрос.ПараметрыЗапроса;
	Контекст.Статус = Ответ.КодСостояния;
	Контекст.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Контекст.Строк = Итог.Строк;
	Контекст.ТекстОшибки = Итог.ТекстОшибки;
	Пакет = Неопределено;
	Если Итог.Свойство("Пакет", Пакет) Тогда
		// Запись самого $batch: общая метка с записями его операций (OData4_ПакетВыполнение).
		Контекст.Вставить("Пакет", Пакет);
	КонецЕсли;
	ЗаписьВПакете = Неопределено;
	Если Итог.Свойство("ЗаписьВПакете", ЗаписьВПакете) Тогда
		// Уровень журнала «Запись» пишет POST $batch, только если в пакете есть изменение (OData4_Журнал.Записать).
		Контекст.Вставить("ЗаписьВПакете", ЗаписьВПакете);
	КонецЕсли;
	Если Ответ.КодСостояния = 401 Тогда
		// Отказ входа: адрес клиента (доверенный заголовок прокси) — ключ прореживания таких записей журнала
		// (настройка ЖурналОтказовВхода, OData4_Журнал.ПисатьОтказВхода).
		Попытка
			Контекст.Вставить("АдресКлиента", OData4_Безопасность.АдресКлиента(Запрос));
		Исключение
			Контекст.Вставить("АдресКлиента", "");
		КонецПопытки;
	КонецЕсли;
	Если Не ПустаяСтрока(Итог.ТекстОшибки) Тогда
		// Тело — только для маскировки его значений в тексте ошибки журнала (Д1 приёмки 6.3); нигде не хранится.
		Попытка
			Контекст.Вставить("Тело", ?(ТипЗнч(Запрос) = Тип("Структура"), Запрос.Тело, Запрос.ПолучитьТелоКакСтроку()));
		Исключение
			Контекст.Вставить("Тело", "");
		КонецПопытки;
	КонецЕсли;
	OData4_Журнал.Записать(Контекст);
КонецПроцедуры

// Формат $metadata: CSDL JSON по $format=json|application/json или по заголовку Accept, где первым указан
// application/json и нет application/xml; иначе CSDL XML (так же отвечают клиенты, которые шлют
// в Accept и JSON, и XML).
Функция ФорматМетаданных(Маршрут, Заголовки)
	Если Маршрут.Опции.format <> Неопределено Тогда
		ВидФормата = НРег(СокрЛП(СтрРазделить(Маршрут.Опции.format + ";", ";")[0]));
		Возврат ?(ВидФормата = "json" Или ВидФормата = "application/json", "json", "xml");
	КонецЕсли;
	Для Каждого КлючИЗначение Из Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) <> "accept" Тогда
			Продолжить;
		КонецЕсли;
		Принимает = НРег(КлючИЗначение.Значение);
		Первый = СокрЛП(СтрРазделить(СтрРазделить(Принимает + ",", ",")[0] + ";", ";")[0]);
		Если Первый = "application/json" И СтрНайти(Принимает, "application/xml") = 0 Тогда
			Возврат "json";
		КонецЕсли;
	КонецЦикла;
	Возврат "xml";
КонецФункции

#КонецОбласти
