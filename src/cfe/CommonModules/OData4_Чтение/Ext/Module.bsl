#Область ПрограммныйИнтерфейс

Функция СлужебныйДокумент(Адрес) Экспорт
	Модель = OData4_МодельПовтИсп.МодельДокументов();
	Запись = OData4_Сериализация.НоваяЗапись();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("@odata.context");
	Запись.ЗаписатьЗначение(Адрес + "/$metadata");
	Запись.ЗаписатьИмяСвойства("value");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого Имя Из Модель.Порядок Цикл
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("name");
		Запись.ЗаписатьЗначение(Имя);
		Запись.ЗаписатьИмяСвойства("kind");
		Запись.ЗаписатьЗначение("EntitySet");
		Запись.ЗаписатьИмяСвойства("url");
		Запись.ЗаписатьЗначение(Имя);
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
КонецФункции

// Страница набора: $filter, $orderby, $select, $expand, $top, $skip, $count, $skiptoken, Prefer: odata.maxpagesize.
// Страница — ПЕРВЫЕ (пропуск + размер + 1): лишняя строка говорит, что есть продолжение.
// РежимВыдачи — "BSL", "Компонента" или "Сверка" вместо настройки (тесты сверяют движки); Неопределено — настройка.
// ОднимОтветом — разрешена выдача одним ответом (настройка ВыдачаКоллекций, см. КоллекцияОднимОтветом): только у
// одиночного GET, операция $batch встраивает текст ответа. Тогда результат может содержать готовый Ответ
// (HTTPСервисОтвет с телом, записанным потоком) вместо Текст.
Функция Коллекция(Маршрут, Адрес, Заголовки, РежимВыдачи = Неопределено, ОднимОтветом = Ложь) Экспорт
	Модель = OData4_МодельПовтИсп.Модель();
	Набор = OData4_Безопасность.НаборМаршрута(Модель, Маршрут.Набор);
	Опции = Маршрут.Опции;
	Предпочтение = ПредпочтениеРазмера(Заголовки);
	// Одним ответом — по настройке, если клиент не просит размер страницы, это не продолжение по $skiptoken и профиль
	// не ограничивает страницу.
	Если ОднимОтветом И Предпочтение = Неопределено И Опции.skiptoken = Неопределено
		И OData4_Безопасность.РазмерСтраницыПрофиля() = 0
		И OData4_НастройкиСервиса.Значение("ВыдачаКоллекций", "Страницами") = "ОднимОтветом" Тогда
		Возврат КоллекцияОднимОтветом(Модель, Набор, Маршрут, Адрес, РежимВыдачи);
	КонецЕсли;
	Размер = РазмерСтраницы(Предпочтение);
	РазмерПрофиля = OData4_Безопасность.РазмерСтраницыПрофиля();
	Если РазмерПрофиля > 0 Тогда
		Размер = Мин(Размер, РазмерПрофиля);
	КонецЕсли;
	Пропуск = ?(Опции.skip = Неопределено, 0, Опции.skip);
	Лимит = ?(Опции.top = Неопределено, Размер, Мин(Опции.top, Размер));
	План = OData4_Планировщик.ПланЧтения(Модель, Набор, Опции, "Коллекция", Маршрут.Функция, Маршрут.ПараметрыФункции);
	Если План.Группы И План.Продолжение = "Ключ" И НаибольшаяДлинаСсылки(План, Маршрут, Адрес, Набор)
		> МаксимальнаяДлинаСсылки() Тогда
		// Метка по многим или длинным полям группировки могла бы сделать @odata.nextLink длиннее, чем
		// принимает веб-сервер (Apache — 8190 символов строки запроса): такой результат продолжается $skip.
		// Оценка не зависит от $top и страницы, поэтому режим одинаков у всех страниц одного запроса.
		План.Продолжение = "Пропуск";
		План.ПричинаПропуска = "метка по " + Формат(План.Порядок.Количество() + План.КлючПорядка.Количество(), "ЧГ=0")
			+ " полям могла бы сделать @odata.nextLink длиннее " + Формат(МаксимальнаяДлинаСсылки(), "ЧГ=0") + " символов";
	КонецЕсли;
	Если Пропуск > МаксимальныйПропуск() И План.Продолжение <> "Пропуск" Тогда
		// Результат groupby, который продолжается только по $skip (решение 11), предела не имеет: его
		// @odata.nextLink ведёт за 10000, и отказ сделал бы конец результата недостижимым. Строк в нём не
		// больше, чем групп, а группы уже собраны во временной таблице шага.
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Значение $skip больше " + Формат(МаксимальныйПропуск(), "ЧГ=0")
			+ ": " + Формат(Пропуск, "ЧГ=0"));
	КонецЕсли;
	Если Опции.skiptoken <> Неопределено Тогда
		OData4_Планировщик.ДобавитьПродолжение(План, Опции.skiptoken);
	КонецЕсли;
	Результат = ВыполнитьВыборку(План, Пропуск + Лимит + 1, Опции.count = Истина);
	Всего = Результат.Строки.Количество();
	ЕстьЕще = Всего > Пропуск + Лимит;
	Строки = Новый Массив;
	Для Индекс = Пропуск По Мин(Всего, Пропуск + Лимит) - 1 Цикл
		Строки.Добавить(Результат.Строки[Индекс]);
	КонецЦикла;
	Таблицы = Новый Соответствие;
	Коллекции = ЗагрузитьКоллекции(План, Строки, Таблицы);
	Контекст = Адрес + "/$metadata#" + ИмяКонтекста(План, Набор) + СписокКонтекста(План);
	Количество0 = ?(Опции.count = Истина, Результат.Количество, Неопределено);
	// Строки groupby и aggregate набора сущностей — не сущности: "@odata.id": null (примеры расширения
	// агрегации OData 4.0); у комплексного результата виртуальной таблицы идентификатора нет и так.
	БезИдентификатора = План.Группы И (План.Функция = Неопределено Или План.Функция.ВозвратНабор);
	Следующая = Неопределено;
	Если ЕстьЕще И (Опции.top = Неопределено Или Опции.top > Лимит) Тогда
		// Продолжение — меткой по ключу (у результата groupby — по полям группировки), а у результата groupby,
		// условие продолжения которого не помещается в пределы генератора (План.Продолжение = «Пропуск»), —
		// $skip (решение 11).
		Метка = "";
		Если План.Продолжение <> "Пропуск" Тогда
			Метка = OData4_Планировщик.МеткаПродолжения(План, Строки[Строки.ВГраница()]);
		КонецЕсли;
		ПараметрыСсылки = ПараметрыПродолжения(Маршрут.Параметры, Опции, Лимит, Метка, Пропуск + Лимит);
		// Токен — только если пришёл в адресе, ключ продолжения — при включённых токенах продолжения (5.2).
		ПараметрыСсылки = ПараметрыСсылки + OData4_Безопасность.ПараметрыСекретов(
			Маршрут.Набор + ?(Маршрут.ТекстФункции = "", "", "/" + Маршрут.ТекстФункции), ПараметрыСсылки);
		Следующая = Адрес + "/" + КодироватьСтроку(Набор.Имя, СпособКодированияСтроки.КодировкаURL)
			+ СегментФункции(Маршрут) + "?" + ПараметрыСсылки;
	КонецЕсли;
	// Выдача JSON (этап 8.1): язык 1С, компонента или оба со сверкой (OData4_Движок.РежимДвижка).
	Режим = ?(РежимВыдачи = Неопределено, OData4_Движок.РежимДвижка("РежимВыдачи"), РежимВыдачи);
	Текст = Неопределено;
	Если Режим <> "BSL" И Строки.Количество() > 0 Тогда
		Текст = OData4_ВыдачаNative.Текст(Новый Структура("Вид, Узел, Строки, С, По, Таблицы, Контекст, Количество, "
			+ "БезИдентификатора, Следующая", "collection", План.Узел, Результат.Строки, Пропуск, Пропуск + Строки.Количество(),
			Таблицы, Контекст, Количество0, БезИдентификатора, Следующая));
	КонецЕсли;
	Если Текст = Неопределено Или Режим = "Сверка" Тогда
		ТекстBSL = ТекстКоллекции(План, Строки, Коллекции, Контекст, Количество0, БезИдентификатора, Следующая);
		Если Текст <> Неопределено Тогда
			OData4_Движок.СверитьВыходы("OData4.СверкаВыдачи", Контекст, ТекстBSL, Текст);
		КонецЕсли;
		Текст = ТекстBSL;
	КонецЕсли;
	ЗаголовкиОтвета = Новый Соответствие;
	Если Предпочтение <> Неопределено Тогда
		ЗаголовкиОтвета.Вставить("Preference-Applied", "odata.maxpagesize=" + Формат(Размер, "ЧГ=0"));
	КонецЕсли;
	Возврат Новый Структура("Текст, Заголовки, Строк", Текст, ЗаголовкиОтвета, Строки.Количество());
КонецФункции

// Сущность по ключу маршрута: текст JSON. ВерсияДанных (необязательный, по ссылке) получает DataVersion сущности для
// заголовка ETag ("" — у набора нет версии или она не выбрана $select).
Функция Сущность(Маршрут, Адрес, ВерсияДанных = "", РежимВыдачи = Неопределено) Экспорт
	Модель = OData4_МодельПовтИсп.Модель();
	Набор = OData4_Безопасность.НаборМаршрута(Модель, Маршрут.Набор);
	План = OData4_Планировщик.ПланЧтения(Модель, Набор, Маршрут.Опции, "Сущность");
	OData4_Планировщик.ДобавитьУсловиеКлюча(План, Маршрут.Ключ);
	Строки = ВыполнитьВыборку(План, 1, Ложь).Строки;
	Если Строки.Количество() = 0 Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Объект не найден: " + Набор.Имя + "(" + Маршрут.ТекстКлюча + ")");
	КонецЕсли;
	Таблицы = Новый Соответствие;
	Коллекции = ЗагрузитьКоллекции(План, Строки, Таблицы);
	Контекст = Адрес + "/$metadata#" + Набор.Имя + СписокКонтекста(План) + "/$entity";
	Колонка = КолонкаВерсии(План.Узел);
	ВерсияДанных = ?(Колонка = "", "", Строки[0][Колонка]);
	Режим = ?(РежимВыдачи = Неопределено, OData4_Движок.РежимДвижка("РежимВыдачи"), РежимВыдачи);
	Текст = Неопределено;
	Если Режим <> "BSL" Тогда
		Текст = OData4_ВыдачаNative.Текст(Новый Структура("Вид, Узел, Строки, С, По, Таблицы, Контекст, Количество, "
			+ "БезИдентификатора, Следующая", "entity", План.Узел, Строки, 0, 1, Таблицы, Контекст, Неопределено, Ложь,
			Неопределено));
	КонецЕсли;
	Если Текст = Неопределено Или Режим = "Сверка" Тогда
		Запись = OData4_Сериализация.НоваяЗапись();
		Запись.ЗаписатьНачалоОбъекта();
		Запись.ЗаписатьИмяСвойства("@odata.context");
		Запись.ЗаписатьЗначение(Контекст);
		ЗаписатьСвойстваУзла(Запись, План.Узел, Строки[0], Коллекции);
		Запись.ЗаписатьКонецОбъекта();
		ТекстBSL = Запись.Закрыть();
		Если Текст <> Неопределено Тогда
			OData4_Движок.СверитьВыходы("OData4.СверкаВыдачи", Контекст, ТекстBSL, Текст);
		КонецЕсли;
		Текст = ТекстBSL;
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Значения полей сущности набора по ключу маршрута (Массив пар «Имя, Текст» маршрутизатора), прочитанные тем же планом,
// что и чтение сущности (отборы профиля, RLS): Соответствие «поле 1С (Свойство.Поле) → значение». Нет такой
// видимой сущности — Неопределено. Для записи (6.2): существование и видимость объекта, ссылка и ключ записи регистра.
Функция СтрокаСущности(Модель, Набор, Ключ) Экспорт
	Опции = OData4_Разбор.НовыеОпции();
	Опции.Вставить("skiptoken", Неопределено);
	Опции.Вставить("format", Неопределено);
	Опции.Вставить("apply", Неопределено);
	План = OData4_Планировщик.ПланЧтения(Модель, Набор, Опции, "Сущность");
	OData4_Планировщик.ДобавитьУсловиеКлюча(План, Ключ);
	Строки = ВыполнитьВыборку(План, 1, Ложь).Строки;
	Если Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Значения = Новый Соответствие;
	Для Каждого Элемент Из План.Узел.Свойства Цикл
		Если Элемент.Колонка <> "" И Элемент.Свойство.Поле <> "" Тогда
			Значения.Вставить(Элемент.Свойство.Поле, Строки[0][Элемент.Колонка]);
		КонецЕсли;
	КонецЦикла;
	Возврат Значения;
КонецФункции

Функция Количество(Маршрут) Экспорт
	Модель = OData4_МодельПовтИсп.Модель();
	Набор = OData4_Безопасность.НаборМаршрута(Модель, Маршрут.Набор);
	План = OData4_Планировщик.ПланЧтения(Модель, Набор, Маршрут.Опции, "Количество",
		Маршрут.Функция, Маршрут.ПараметрыФункции);
	Тексты = Новый Массив;
	Для Каждого Шаг Из План.Шаги Цикл
		Тексты.Добавить(OData4_Генератор.ТекстВыборки(Шаг));
	КонецЦикла;
	Тексты.Добавить(OData4_Генератор.ТекстКоличества(План.Выборка));
	Пакет = ВыполнитьПакет(НовыйЗапрос(СтрСоединить(Тексты, ";" + Символы.ПС), План.Параметры));
	Выборка = Пакет[Пакет.ВГраница()].Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Количество;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Основная выборка плана с ПЕРВЫЕ Первые; перед ней в том же пакете — выборки шагов $apply.
// СКоличеством — ещё один запрос пакета КОЛИЧЕСТВО(*) с теми же условиями.
// Результат — Структура «Строки (ТаблицаЗначений), Количество».
Функция ВыполнитьВыборку(План, Первые, СКоличеством)
	План.Выборка.Первые = Первые;
	Тексты = Новый Массив;
	Для Каждого Выборка Из План.Шаги Цикл
		Тексты.Добавить(OData4_Генератор.ТекстВыборки(Выборка));
	КонецЦикла;
	Тексты.Добавить(OData4_Генератор.ТекстВыборки(План.Выборка));
	Основная = Тексты.Количество() - 1;
	Если СКоличеством Тогда
		Тексты.Добавить(OData4_Генератор.ТекстКоличества(План.Выборка));
	КонецЕсли;
	Пакет = ВыполнитьПакет(НовыйЗапрос(СтрСоединить(Тексты, ";" + Символы.ПС), План.Параметры));
	Всего = 0;
	Если СКоличеством Тогда
		Итог = Пакет[Основная + 1].Выбрать();
		Итог.Следующий();
		Всего = Итог.Количество;
	КонецЕсли;
	Возврат Новый Структура("Строки, Количество", Пакет[Основная].Выгрузить(), Всего);
КонецФункции

// Пакет запроса; в режиме прав служебного пользователя «Привилегированный» (сервис odatat) — в привилегированном
// режиме: доступ определяет только профиль, RLS не действует (5.2, задача 14).
Функция ВыполнитьПакет(Запрос)
	Если Не OData4_Безопасность.ПривилегированноеЧтение() Тогда
		Возврат Запрос.ВыполнитьПакет();
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Пакет = Запрос.ВыполнитьПакет();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Пакет;
КонецФункции

Функция НовыйЗапрос(Текст, Параметры)
	Запрос = Новый Запрос(Текст);
	Для Каждого КлючИЗначение Из Параметры Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Запрос;
КонецФункции

// Строки коллекций (табличных частей) волнами: коллекция волны N берёт ключи владельцев из строк, где лежит
// её родитель (страница основной выборки или строки коллекции волны N-1); вся волна — один пакет
// «ключи во временную таблицу + выборка строк» на каждую коллекцию. Результат — Соответствие
// код коллекции → Соответствие (ссылка владельца → Массив строк). Таблицы (необязательный) получает сами выборки
// коллекций: Соответствие «код → ТаблицаЗначений» (выдача компонентой, OData4_ВыдачаNative).
Функция ЗагрузитьКоллекции(План, Строки, Таблицы = Неопределено)
	Результат = Новый Соответствие;
	Если Строки.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Источники = Новый Соответствие;
	Источники.Вставить("", Строки);
	Волна = 1;
	Пока Истина Цикл
		Текущие = Новый Массив;
		Для Каждого Описание Из План.Коллекции Цикл
			Если Описание.Волна = Волна Тогда
				Текущие.Добавить(Описание);
			КонецЕсли;
		КонецЦикла;
		Если Текущие.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Тексты = Новый Массив;
		Параметры = Новый Структура;
		Для Каждого КлючИЗначение Из План.Параметры Цикл
			Параметры.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Для Каждого Описание Из Текущие Цикл
			ИмяКлючей = "Ключи" + Формат(Описание.Номер, "ЧГ=0");
			Параметры.Вставить(ИмяКлючей, КлючиВладельцев(Описание.Родитель, Источники.Получить(Описание.Источник)));
			Тексты.Добавить("ВЫБРАТЬ К.Ссылка КАК Ссылка ПОМЕСТИТЬ ВТ_" + ИмяКлючей + " ИЗ &" + ИмяКлючей + " КАК К");
			Тексты.Добавить(OData4_Генератор.ТекстВыборки(Описание.Выборка));
		КонецЦикла;
		Пакет = ВыполнитьПакет(НовыйЗапрос(СтрСоединить(Тексты, ";" + Символы.ПС), Параметры));
		Для Индекс = 0 По Текущие.ВГраница() Цикл
			Описание = Текущие[Индекс];
			СтрокиКоллекции = Пакет[Индекс * 2 + 1].Выгрузить();
			ПоВладельцам = Новый Соответствие;
			Для Каждого СтрокаКоллекции Из СтрокиКоллекции Цикл
				Владелец = СтрокаКоллекции[Описание.Узел.КолонкаСсылки];
				Список = ПоВладельцам.Получить(Владелец);
				Если Список = Неопределено Тогда
					Список = Новый Массив;
					ПоВладельцам.Вставить(Владелец, Список);
				КонецЕсли;
				Список.Добавить(СтрокаКоллекции);
			КонецЦикла;
			Результат.Вставить(Описание.Код, ПоВладельцам);
			Если Таблицы <> Неопределено Тогда
				Таблицы.Вставить(Описание.Код, СтрокиКоллекции);
			КонецЕсли;
			Источники.Вставить(Описание.Код, СтрокиКоллекции);
		КонецЦикла;
		Волна = Волна + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Ключи владельцев: различные ссылки из колонки КолонкаСсылки узла-родителя (NULL — нет объекта — пропускается).
Функция КлючиВладельцев(Родитель, Источник)
	Ключи = Новый ТаблицаЗначений;
	Ключи.Колонки.Добавить("Ссылка", Родитель.Набор.ТипСвязи);
	Встречены = Новый Соответствие;
	Для Каждого СтрокаИсточника Из Источник Цикл
		Ссылка = СтрокаИсточника[Родитель.КолонкаСсылки];
		Если Ссылка = NULL Или Встречены.Получить(Ссылка) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Встречены.Вставить(Ссылка, Истина);
		Ключи.Добавить().Ссылка = Ссылка;
	КонецЦикла;
	Возврат Ключи;
КонецФункции

Процедура ЗаписатьУзел(Запись, Узел, СтрокаВыборки, Коллекции)
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьСвойстваУзла(Запись, Узел, СтрокаВыборки, Коллекции);
	Запись.ЗаписатьКонецОбъекта();
КонецПроцедуры

// Свойства узла, строки его табличных частей (с пропуском и ограничением из $expand) и раскрытые объекты;
// раскрытие без объекта (пустая ссылка) — null.
Процедура ЗаписатьСвойстваУзла(Запись, Узел, СтрокаВыборки, Коллекции)
	Колонка = КолонкаВерсии(Узел);
	Если Колонка <> "" Тогда
		// ETag сущности (6.2): версия данных выбрана — аннотация перед свойствами, как требует формат OData JSON.
		Версия = СтрокаВыборки[Колонка];
		Если ЗначениеЗаполнено(Версия) Тогда
			Запись.ЗаписатьИмяСвойства("@odata.etag");
			Запись.ЗаписатьЗначение(OData4_Сериализация.ЗначениеETag(Версия));
		КонецЕсли;
	КонецЕсли;
	Для Каждого Элемент Из Узел.Свойства Цикл
		Если Элемент.Свойство.Вид = "Вложенный" Тогда
			// Свойство результата groupby по навигационному пути — вложенный объект (см. ВложенныеСвойства);
			// объекта нет (все значения пусты) — null, как раскрытие пустой ссылки.
			Запись.ЗаписатьИмяСвойства(Элемент.Свойство.Имя);
			Если ВложенныйПуст(Элемент.Узел, СтрокаВыборки) Тогда
				Запись.ЗаписатьЗначение(Неопределено);
			Иначе
				ЗаписатьУзел(Запись, Элемент.Узел, СтрокаВыборки, Коллекции);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		// Свойство без колонки (суррогатный ключ) значение берёт не из строки.
		Значение = ?(Элемент.Колонка = "", Неопределено, СтрокаВыборки[Элемент.Колонка]);
		OData4_Сериализация.ЗаписатьСвойство(Запись, Элемент.Свойство, Значение);
	КонецЦикла;
	Для Каждого ТЧ Из Узел.ТабличныеЧасти Цикл
		СтрокиТЧ = Коллекции.Получить(ТЧ.Код).Получить(СтрокаВыборки[Узел.КолонкаСсылки]);
		Всего = ?(СтрокиТЧ = Неопределено, 0, СтрокиТЧ.Количество());
		Если ТЧ.СКоличеством Тогда
			Запись.ЗаписатьИмяСвойства(ТЧ.Имя + "@odata.count");
			Запись.ЗаписатьЗначение(Всего);
		КонецЕсли;
		Запись.ЗаписатьИмяСвойства(ТЧ.Имя);
		Запись.ЗаписатьНачалоМассива();
		Последняя = ?(ТЧ.Первые < 0, Всего, Мин(Всего, ТЧ.Пропуск + ТЧ.Первые)) - 1;
		Для Индекс = ТЧ.Пропуск По Последняя Цикл
			ЗаписатьУзел(Запись, ТЧ.Узел, СтрокиТЧ[Индекс], Коллекции);
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	КонецЦикла;
	Для Каждого Раскрытие Из Узел.Раскрытия Цикл
		Запись.ЗаписатьИмяСвойства(Раскрытие.Имя);
		Если СтрокаВыборки[Раскрытие.Узел.КолонкаСсылки] = NULL Тогда
			Запись.ЗаписатьЗначение(Неопределено);
		Иначе
			ЗаписатьУзел(Запись, Раскрытие.Узел, СтрокаВыборки, Коллекции);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Колонка версии данных (DataVersion) узла выдачи или "": свойство не выбрано или у набора версии нет. Запоминается в
// узле (КолонкаВерсии), чтобы не искать для каждой строки.
Функция КолонкаВерсии(Узел) Экспорт
	Колонка = Неопределено;
	Если Узел.Свойство("КолонкаВерсии", Колонка) Тогда
		Возврат Колонка;
	КонецЕсли;
	Колонка = "";
	Для Каждого Элемент Из Узел.Свойства Цикл
		Если Элемент.Свойство.Вид <> "Вложенный" И Элемент.Свойство.Имя = "DataVersion" И Элемент.Свойство.Поле = "ВерсияДанных" Тогда
			Колонка = Элемент.Колонка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Узел.Вставить("КолонкаВерсии", Колонка);
	Возврат Колонка;
КонецФункции

// Коллекция одним ответом (настройка ВыдачаКоллекций = «ОднимОтветом»): весь результат без @odata.nextLink, как у
// standard.odata. Сервер читает его порциями по РазмерПорцииВыдачи строк (та же выборка с продолжением по метке или
// $skip, что у страниц) и сразу дописывает каждую порцию в тело ответа потоком: в памяти — одна порция, а не весь
// набор. $top ограничивает число строк; НаибольшееЧислоСтрокОтвета (0 — без предела) ограничивает ответ, и тогда в
// нём есть @odata.nextLink на продолжение, как у страницы. Результат — Структура «Ответ, Строк».
Функция КоллекцияОднимОтветом(Модель, Набор, Маршрут, Адрес, РежимВыдачи)
	Опции = Маршрут.Опции;
	НаибольшаяПорция = Макс(1, OData4_НастройкиСервиса.Значение("РазмерПорцииВыдачи", 5000));
	// Порция подстраивается под ширину строк: первая — до 1000 строк, следующие — чтобы текст порции был около
	// 30 млн символов (широкие строки документов с табличными частями — меньше строк, узкие записи регистров — до
	// наибольшей порции): большие строки 1С дорого копировать, а частые запросы — дорого выполнять.
	Порция = Мин(НаибольшаяПорция, 1000);
	Предел = OData4_НастройкиСервиса.Значение("НаибольшееЧислоСтрокОтвета", 0);
	Нужно0 = ?(Опции.top = Неопределено, Предел, ?(Предел = 0, Опции.top, Мин(Опции.top, Предел)));
	Режим = ?(РежимВыдачи = Неопределено, OData4_Движок.РежимДвижка("РежимВыдачи"), РежимВыдачи);
	Пропуск0 = ?(Опции.skip = Неопределено, 0, Опции.skip);
	Если Пропуск0 > МаксимальныйПропуск() Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Значение $skip больше " + Формат(МаксимальныйПропуск(), "ЧГ=0")
			+ ": " + Формат(Пропуск0, "ЧГ=0"));
	КонецЕсли;
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json;odata.metadata=minimal;charset=utf-8");
	Ответ.Заголовки.Вставить("OData-Version", "4.0");
	Запись = Новый ЗаписьДанных(Ответ.ПолучитьТелоКакПоток());
	Выдано = 0;
	Метка = Неопределено;
	ЕстьЕще = Ложь;
	ПоследняяСтрока = Неопределено;
	ПланПервый = Неопределено;
	Пока Истина Цикл
		План = OData4_Планировщик.ПланЧтения(Модель, Набор, Опции, "Коллекция", Маршрут.Функция, Маршрут.ПараметрыФункции);
		Если План.Группы И План.Продолжение = "Ключ" И НаибольшаяДлинаСсылки(План, Маршрут, Адрес, Набор)
			> МаксимальнаяДлинаСсылки() Тогда
			План.Продолжение = "Пропуск";
		КонецЕсли;
		Если Метка <> Неопределено Тогда
			OData4_Планировщик.ДобавитьПродолжение(План, Метка);
		КонецЕсли;
		// Первая порция — с $skip клиента; дальше — меткой по ключу, а у результата, который продолжается только $skip
		// (решение 11), — $skip клиента плюс выданное.
		Пропуск = ?(Метка = Неопределено, Пропуск0 + Выдано, 0);
		Нужно = ?(Нужно0 = 0, Порция, Мин(Порция, Нужно0 - Выдано));
		Результат = ВыполнитьВыборку(План, Пропуск + Нужно + 1, ПланПервый = Неопределено И Опции.count = Истина);
		Всего = Результат.Строки.Количество();
		ЕстьЕще = Всего > Пропуск + Нужно;
		Строки = Новый Массив;
		Для Индекс = Пропуск По Мин(Всего, Пропуск + Нужно) - 1 Цикл
			Строки.Добавить(Результат.Строки[Индекс]);
		КонецЦикла;
		БезИдентификатора = План.Группы И (План.Функция = Неопределено Или План.Функция.ВозвратНабор);
		Если ПланПервый = Неопределено Тогда
			ПланПервый = План;
			ЗаписатьСтроку(Запись, ОткрытыйОбъект(Адрес + "/$metadata#" + ИмяКонтекста(План, Набор) + СписокКонтекста(План),
				?(Опции.count = Истина, Результат.Количество, Неопределено)) + """value"":[");
		КонецЕсли;
		Если Строки.Количество() > 0 Тогда
			Таблицы = Новый Соответствие;
			Коллекции = ЗагрузитьКоллекции(План, Строки, Таблицы);
			Если Выдано > 0 Тогда
				ЗаписатьСтроку(Запись, ",");
			КонецЕсли;
			ТекстПорции0 = ТекстПорции(Режим, План, Результат.Строки, Пропуск, Строки, Таблицы, Коллекции, БезИдентификатора);
			ЗаписатьСтроку(Запись, ТекстПорции0);
			Порция = Мин(НаибольшаяПорция, Макс(100, Цел(Строки.Количество() * 30000000 / Макс(1, СтрДлина(ТекстПорции0)))));
			Выдано = Выдано + Строки.Количество();
			ПоследняяСтрока = Строки[Строки.ВГраница()];
		КонецЕсли;
		Если Не ЕстьЕще Или (Нужно0 > 0 И Выдано >= Нужно0) Или Строки.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		Если План.Продолжение <> "Пропуск" Тогда
			Метка = OData4_Планировщик.МеткаПродолжения(План, ПоследняяСтрока);
		КонецЕсли;
	КонецЦикла;
	Хвост = "]}";
	Если ЕстьЕще И (Опции.top = Неопределено Или Опции.top > Выдано) Тогда
		// Предел ответа достигнут: продолжение — как у страницы (метка по последней строке или $skip).
		МеткаСсылки = "";
		Если ПланПервый.Продолжение <> "Пропуск" Тогда
			МеткаСсылки = OData4_Планировщик.МеткаПродолжения(ПланПервый, ПоследняяСтрока);
		КонецЕсли;
		ПараметрыСсылки = ПараметрыПродолжения(Маршрут.Параметры, Опции, Выдано, МеткаСсылки, Пропуск0 + Выдано);
		ПараметрыСсылки = ПараметрыСсылки + OData4_Безопасность.ПараметрыСекретов(
			Маршрут.Набор + ?(Маршрут.ТекстФункции = "", "", "/" + Маршрут.ТекстФункции), ПараметрыСсылки);
		Следующая = Адрес + "/" + КодироватьСтроку(Набор.Имя, СпособКодированияСтроки.КодировкаURL)
			+ СегментФункции(Маршрут) + "?" + ПараметрыСсылки;
		Хвост = "]," + Сред(ОткрытыйОбъект(Неопределено, Неопределено, Следующая), 2);
	КонецЕсли;
	ЗаписатьСтроку(Запись, Хвост);
	Запись.Закрыть();
	Возврат Новый Структура("Ответ, Строк", Ответ, Выдано);
КонецФункции

// Объекты строк порции через запятую (без скобок массива): компонента, язык 1С или оба со сверкой.
Функция ТекстПорции(Режим, План, ТаблицаСтрок, Пропуск, Строки, Таблицы, Коллекции, БезИдентификатора)
	Текст = Неопределено;
	Если Режим <> "BSL" Тогда
		Текст = OData4_ВыдачаNative.Текст(Новый Структура("Вид, Узел, Строки, С, По, Таблицы, Контекст, Количество, "
			+ "БезИдентификатора, Следующая", "rows", План.Узел, ТаблицаСтрок, Пропуск, Пропуск + Строки.Количество(),
			Таблицы, "", Неопределено, БезИдентификатора, Неопределено));
	КонецЕсли;
	Если Текст = Неопределено Или Режим = "Сверка" Тогда
		Запись = OData4_Сериализация.НоваяЗапись();
		Запись.ЗаписатьНачалоМассива();
		Для Каждого СтрокаВыборки Из Строки Цикл
			Запись.ЗаписатьНачалоОбъекта();
			Если БезИдентификатора Тогда
				Запись.ЗаписатьИмяСвойства("@odata.id");
				Запись.ЗаписатьЗначение(Неопределено);
			КонецЕсли;
			ЗаписатьСвойстваУзла(Запись, План.Узел, СтрокаВыборки, Коллекции);
			Запись.ЗаписатьКонецОбъекта();
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
		Массив0 = Запись.Закрыть();
		ТекстBSL = Сред(Массив0, 2, СтрДлина(Массив0) - 2);
		Если Текст <> Неопределено Тогда
			OData4_Движок.СверитьВыходы("OData4.СверкаВыдачи", "порция выдачи одним ответом", ТекстBSL, Текст);
		КонецЕсли;
		Текст = ТекстBSL;
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Начало объекта ответа без закрывающей скобки — «{"@odata.context":…,"@odata.count":…,» (поля, заданные не
// Неопределено) — или, для хвоста, «{"@odata.nextLink":"…"}» целиком. Экранирование — ЗаписьJSON.
Функция ОткрытыйОбъект(Контекст, Количество0, Следующая = Неопределено)
	Запись = OData4_Сериализация.НоваяЗапись();
	Запись.ЗаписатьНачалоОбъекта();
	Если Контекст <> Неопределено Тогда
		Запись.ЗаписатьИмяСвойства("@odata.context");
		Запись.ЗаписатьЗначение(Контекст);
	КонецЕсли;
	Если Количество0 <> Неопределено Тогда
		Запись.ЗаписатьИмяСвойства("@odata.count");
		Запись.ЗаписатьЗначение(Количество0);
	КонецЕсли;
	Если Следующая <> Неопределено Тогда
		Запись.ЗаписатьИмяСвойства("@odata.nextLink");
		Запись.ЗаписатьЗначение(Следующая);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();
	Текст = Запись.Закрыть();
	Если Следующая <> Неопределено Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Лев(Текст, СтрДлина(Текст) - 1) + ",";
КонецФункции

Процедура ЗаписатьСтроку(Запись, Текст)
	Запись.ЗаписатьСтроку(Текст, КодировкаТекста.UTF8);
КонецПроцедуры

// Текст ответа коллекции на языке 1С (ЗаписьJSON): головные поля — готовые значения (Количество, Следующая —
// Неопределено, если поля нет).
Функция ТекстКоллекции(План, Строки, Коллекции, Контекст, Количество0, БезИдентификатора, Следующая)
	Запись = OData4_Сериализация.НоваяЗапись();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("@odata.context");
	Запись.ЗаписатьЗначение(Контекст);
	Если Количество0 <> Неопределено Тогда
		Запись.ЗаписатьИмяСвойства("@odata.count");
		Запись.ЗаписатьЗначение(Количество0);
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства("value");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого СтрокаВыборки Из Строки Цикл
		Запись.ЗаписатьНачалоОбъекта();
		Если БезИдентификатора Тогда
			Запись.ЗаписатьИмяСвойства("@odata.id");
			Запись.ЗаписатьЗначение(Неопределено);
		КонецЕсли;
		ЗаписатьСвойстваУзла(Запись, План.Узел, СтрокаВыборки, Коллекции);
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Если Следующая <> Неопределено Тогда
		Запись.ЗаписатьИмяСвойства("@odata.nextLink");
		Запись.ЗаписатьЗначение(Следующая);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
КонецФункции

// Вложенный узел результата groupby пуст: каждое значение — NULL, у ключа навигации (КлючНавигации) — ещё
// и пустая ссылка (объекта нет). Глубина рекурсии — число сегментов пути.
Функция ВложенныйПуст(Узел, СтрокаВыборки)
	Для Каждого Элемент Из Узел.Свойства Цикл
		Если Элемент.Свойство.Вид = "Вложенный" Тогда
			Если Не ВложенныйПуст(Элемент.Узел, СтрокаВыборки) Тогда
				Возврат Ложь;
			КонецЕсли;
			Продолжить;
		ИначеЕсли Элемент.Колонка = "" Тогда
			Возврат Ложь;
		КонецЕсли;
		Значение = СтрокаВыборки[Элемент.Колонка];
		Если Значение = NULL Тогда
			Продолжить;
		ИначеЕсли Элемент.Свойство.Свойство("КлючНавигации") И Не ЗначениеЗаполнено(Значение) Тогда
			Продолжить;
		КонецЕсли;
		Возврат Ложь;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// «(Code,Description)» для @odata.context при $select и у результата $apply со сменой колонок, иначе пусто.
Функция СписокКонтекста(План)
	Список = План.Узел.СписокКонтекста;
	Возврат ?(Список = "", "", "(" + Список + ")");
КонецФункции

// Сегмент вызова функции для следующей страницы: «/Balance(Dimensions='…')» или пусто. Косая черта
// остаётся как есть (Condition может содержать путь «Организация/Description»; %2F веб-сервер
// в пути отвергает), маршрутизатор делит путь только вне кавычек и скобок.
Функция СегментФункции(Маршрут)
	Если Маршрут.ТекстФункции = "" Тогда
		Возврат "";
	КонецЕсли;
	Возврат "/" + СтрЗаменить(КодироватьСтроку(Маршрут.ТекстФункции, СпособКодированияСтроки.КодировкаURL), "%2F", "/");
КонецФункции

// Параметры @odata.nextLink: исходные $filter, $orderby, $select, $expand, $count, $inlinecount, $format, $apply,
// оставшийся $top и метка продолжения ($skip тогда не нужен — его учитывает метка), а без метки (результат
// groupby и aggregate: ключа сущности нет) — $skip следующей страницы.
Функция ПараметрыПродолжения(ПараметрыЗапроса, Опции, Лимит, Метка, СледующийПропуск)
	Части = Новый Массив;
	Для Каждого Имя Из СтрРазделить("$filter,$orderby,$select,$expand,$count,$inlinecount,$format,$apply", ",") Цикл
		Значение = ПараметрыЗапроса.Получить(Имя);
		Если Значение <> Неопределено Тогда
			Части.Добавить(Имя + "=" + КодироватьСтроку(Значение, СпособКодированияСтроки.КодировкаURL));
		КонецЕсли;
	КонецЦикла;
	Если Опции.top <> Неопределено Тогда
		Части.Добавить("$top=" + Формат(Опции.top - Лимит, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Если Метка = "" Тогда
		Части.Добавить("$skip=" + Формат(СледующийПропуск, "ЧН=0; ЧГ=0"));
	Иначе
		Части.Добавить("$skiptoken=" + КодироватьСтроку(Метка, СпособКодированияСтроки.КодировкаURL));
	КонецЕсли;
	Возврат СтрСоединить(Части, "&");
КонецФункции

Функция ПредпочтениеРазмера(Заголовки)
	Для Каждого КлючИЗначение Из Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) <> "prefer" Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Часть Из СтрРазделить(КлючИЗначение.Значение, ",;", Ложь) Цикл
			Пара = СтрРазделить(СокрЛП(Часть), "=", Ложь);
			Если Пара.Количество() = 2 И НРег(Пара[0]) = "odata.maxpagesize" Тогда
				Попытка
					Возврат Число(Пара[1]);
				Исключение
					OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверный odata.maxpagesize: " + Пара[1]);
				КонецПопытки;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Размер страницы по odata.maxpagesize (Неопределено — не задан): 1…5000, по умолчанию 1000.
Функция РазмерСтраницы(Предпочтение)
	Если Предпочтение = Неопределено Тогда
		Возврат 1000;
	КонецЕсли;
	Возврат Макс(1, Мин(Цел(Предпочтение), 5000));
КонецФункции

// Наибольшая длина @odata.nextLink с меткой: ссылка без $top и с пустой меткой, запас на $top и оценка метки
// сверху (OData4_Планировщик.НаибольшаяДлинаМетки).
Функция НаибольшаяДлинаСсылки(План, Маршрут, Адрес, Набор)
	БезОграничения = Новый Структура("top");
	Ссылка = Адрес + "/" + КодироватьСтроку(Набор.Имя, СпособКодированияСтроки.КодировкаURL) + СегментФункции(Маршрут)
		+ "?" + ПараметрыПродолжения(Маршрут.Параметры, БезОграничения, 0, "[]", 0);
	Возврат СтрДлина(Ссылка) + 20 + OData4_Планировщик.НаибольшаяДлинаМетки(План);
КонецФункции

// Наибольшая длина @odata.nextLink с меткой: строка запроса Apache по умолчанию — 8190 символов вместе
// с методом и версией протокола, ссылка здесь ещё и с адресом сервера.
Функция МаксимальнаяДлинаСсылки()
	Возврат 8000;
КонецФункции

// Наибольший $skip: страница читается как ПЕРВЫЕ (пропуск + размер + 1).
Функция МаксимальныйПропуск()
	Возврат 10000;
КонецФункции

// Имя ресурса в @odata.context: набор сущностей, а у функции с комплексным результатом —
// «Collection(StandardODATA.Тип)», как в standard.odata.
Функция ИмяКонтекста(План, Набор)
	Если План.Функция <> Неопределено И Не План.Функция.ВозвратНабор Тогда
		Возврат "Collection(StandardODATA." + План.Функция.ИмяТипа + ")";
	КонецЕсли;
	Возврат Набор.Имя;
КонецФункции

#КонецОбласти
