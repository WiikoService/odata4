#Область ПрограммныйИнтерфейс

// Разбор и сборка пакета $batch (этап 7.1): multipart/mixed (OData 4.0) и JSON batch (OData 4.01). Только формат:
// маршрут, выполнение, лимиты и журнал — в OData4_ПакетВыполнение (7.2). Без рекурсии: набор изменений — один
// вложенный уровень multipart, JSON разбирает платформа.

// Разбор тела $batch. ТипСодержимого — заголовок Content-Type запроса, Тело — строка UTF-8.
// Результат — Структура:
//   Формат — "multipart" или "json";
//   Операции — Массив Структура, по порядку тела:
//     Ид        — Content-ID части (multipart) или id (json); "" — не задан;
//     Набор     — ид набора изменений: граница changeset (multipart) или atomicityGroup (json); "" — вне набора;
//     Метод     — HTTP-метод прописными;
//     Адрес     — адрес операции как в теле: относительный к корню сервиса ("Catalog_X?$top=1"), абсолютный
//                 ("http://…/v4/Catalog_X"), от корня хоста ("/…/v4/Catalog_X") или ссылка "$1/…";
//     Заголовки — Соответствие «имя → значение» (имена как в теле);
//     Тело      — строка ("" — нет);
//     ЗависитОт — Массив ид (json dependsOn; multipart — пустой).
// Нарушение формата — OData4_Сервис.ОшибкаOData(400, "BadRequest", факт); Content-Type не multipart/mixed и не
// application/json — ОшибкаOData(415, …). Операций нет — 400.
// multipart: концы строк CRLF и LF равноправны (тело части возвращается с LF); части — Content-Type
// application/http (Content-Transfer-Encoding, если задан, — binary) или multipart/mixed со своей границей (набор
// изменений, внутри — только application/http); Content-ID — заголовок части MIME (угловые скобки снимаются), в
// наборе изменений — без повторов. json: id обязателен и уникален, запросы одной atomicityGroup идут подряд,
// dependsOn ссылается на предшествующие id или группы; body-объект (и любое значение при JSON-типе содержимого
// операции) — текстом JSON, body при типе содержимого не JSON и не text/* — строка base64url (декодируется в текст
// UTF-8), иначе body-строка — как есть.
// Движок разбора — настройка РежимРазбораТел (этап 8.2, см. OData4_РазборТелNative): в любом режиме результат и
// ошибки — как у разбора на языке 1С (РазобратьПакетBSL).
Функция РазобратьПакет(ТипСодержимого, Тело) Экспорт
	ЗначениеТипа = ?(ТипЗнч(ТипСодержимого) = Тип("Строка"), ТипСодержимого, "");
	Текст = ?(ТипЗнч(Тело) = Тип("Строка"), Тело, "");
	Если Лев(Текст, 1) = Символ(65279) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Возврат РазобратьПакетДвижком(ЗначениеТипа, Текст, OData4_Движок.РежимДвижка("РежимРазбораТел"));
КонецФункции

// Разбор пакета (ЗначениеТипа и Текст — строки, текст без BOM) движком Режим: "BSL", "Компонента" (отказ или сбой
// компоненты — язык 1С) или "Сверка" (оба, результат — язык 1С, расхождение — в журнал). Для РазобратьПакет и тестов,
// которым режим нужен без записи настройки (настройки кэшируются на время вызова сервера).
Функция РазобратьПакетДвижком(ЗначениеТипа, Текст, Режим) Экспорт
	Если Режим = "BSL" Тогда
		Возврат РазобратьПакетBSL(ЗначениеТипа, Текст);
	КонецЕсли;
	Ответ = OData4_РазборТелNative.ПакетКомпонентой(ЗначениеТипа, Текст);
	Если Режим = "Компонента" Тогда
		Возврат ?(Ответ.Вид = "значение", Ответ.Значение, РазобратьПакетBSL(ЗначениеТипа, Текст));
	КонецЕсли;
	Описание = OData4_РазборТелNative.ОписаниеПакета(ЗначениеТипа, Текст);
	Попытка
		Разбор = РазобратьПакетBSL(ЗначениеТипа, Текст);
	Исключение
		OData4_РазборТелNative.СверитьОшибку(Описание, Ответ, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	OData4_РазборТелNative.Сверить(Описание, Ответ, Разбор);
	Возврат Разбор;
КонецФункции

// Нижняя оценка числа операций пакета multipart/mixed до разбора (отзыв безопасности: тело с тысячами частей не
// режется на строки, если лимит операций заведомо превышен): число строк-разделителей «--граница» верхнего уровня до
// закрывающей «--граница--», подсчёт платформенной СтрЧислоВхождений за один проход. Каждая часть — операция или
// непустой набор изменений, поэтому операций не меньше. Разделитель с пробелами в конце строки и разделители подряд
// без содержимого между ними не считаются (оценка только занижается). Не multipart/mixed, нет boundary или нет
// закрывающей границы — 0: ошибку формата даст разбор.
Функция НижняяОценкаЧислаОпераций(ТипСодержимого, Текст) Экспорт
	ЗначениеТипа = ?(ТипЗнч(ТипСодержимого) = Тип("Строка"), ТипСодержимого, "");
	Если ТипЗнч(Текст) <> Тип("Строка") Или ВидСодержимого(ЗначениеТипа) <> "multipart/mixed" Тогда
		Возврат 0;
	КонецЕсли;
	Граница = ГраницаИзТипа(ЗначениеТипа);
	Если Граница = "" Тогда
		Возврат 0;
	КонецЕсли;
	Разделитель = Символы.ПС + "--" + Граница;
	Тело = Символы.ПС + Текст;
	Конец = СтрНайти(Тело, Разделитель + "--");
	Если Конец = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Тело = Лев(Тело, Конец);
	Возврат СтрЧислоВхождений(Тело, Разделитель + Символы.ПС)
		+ СтрЧислоВхождений(Тело, Разделитель + Символы.ВК + Символы.ПС);
КонецФункции

// Ответ $batch по результатам операций. Разбор — результат РазобратьПакет. Результаты — Массив Структура
// («Ид, Набор, Статус, Заголовки, Тело, ОтказНабора»): по одному на выполненную операцию в порядке выполнения;
// Заголовки — Соответствие, Тело — строка. Отклонённый набор изменений (ОтказНабора = Истина у его записей):
//   multipart — одна запись с Набор = ид набора и ошибкой (выдаётся одним ответом application/http вместо набора);
//   json — записи всех операций группы: выполнявшая — со своей ошибкой, остальные — 424 Failed Dependency.
// Успешный набор — в multipart вложенный multipart/mixed с ответами его операций (Content-ID как в запросе);
// в json — atomicityGroup у ответов. Ответ — HTTPСервисОтвет 200 с Content-Type multipart/mixed;
// boundary=batchresponse_<uuid> или application/json; тело JSON-ответа операции встраивается объектом, иное — строкой.
// В json тело JSON встраивается исходным текстом (порядок свойств сохраняется), тело не JSON и не text/* — строкой
// base64url (OData JSON Format 4.01 §19).
// Допуски: в multipart из нескольких записей отклонённого набора выдаётся первая с ошибкой (статус 400 и выше, иначе
// первая); в json операции отклонённой группы берутся из Разбор (порядок тела): запись с ошибкой — как есть, прочие
// (в том числе откаченные успешные и не выполнявшиеся) — 424. JSON-ответ — с OData-Version 4.01 (JSON batch — формат
// OData 4.01).
Функция ОтветПакета(Разбор, Результаты) Экспорт
	Если Разбор.Формат = "json" Тогда
		Ответ = OData4_Сериализация.ОтветТекст(200, ТекстОтветаJSON(Разбор, Результаты), "application/json");
		Ответ.Заголовки.Вставить("OData-Version", "4.01");
		Возврат Ответ;
	КонецЕсли;
	Граница = "batchresponse_" + НовыйИдентификатор();
	Возврат OData4_Сериализация.ОтветТекст(200, ТекстОтветаMultipart(Результаты, Граница),
		"multipart/mixed; boundary=" + Граница);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбор пакета на языке 1С (контракт — РазобратьПакет); ЗначениеТипа и Текст — строки, текст без BOM.
Функция РазобратьПакетBSL(ЗначениеТипа, Текст)
	ВидПакета = ВидСодержимого(ЗначениеТипа);
	Если ВидПакета = "multipart/mixed" Тогда
		ФорматПакета = "multipart";
		Операции = ОперацииMultipart(ЗначениеТипа, Текст);
	ИначеЕсли ВидПакета = "application/json" Тогда
		ФорматПакета = "json";
		Операции = ОперацииJSON(Текст);
	Иначе
		OData4_Сервис.ОшибкаOData(415, "UnsupportedMediaType",
			"Пакет $batch принимается в multipart/mixed или application/json, получен Content-Type: "
			+ ?(ПустаяСтрока(ЗначениеТипа), "(не задан)", ЗначениеТипа));
	КонецЕсли;
	Если Операции.Количество() = 0 Тогда
		Ошибка400("в пакете $batch нет операций");
	КонецЕсли;
	Возврат Новый Структура("Формат, Операции", ФорматПакета, Операции);
КонецФункции

#Область РазборMultipart

// Операции пакета multipart/mixed: части верхнего уровня и один уровень наборов изменений.
Функция ОперацииMultipart(ТипСодержимого, Текст)
	Граница = ГраницаИзТипа(ТипСодержимого);
	Если Граница = "" Тогда
		Ошибка400("в Content-Type пакета нет параметра boundary: " + ТипСодержимого);
	КонецЕсли;
	Операции = Новый Массив;
	ГраницыНаборов = Новый Соответствие;
	Части = СтрокиЧастей(Текст, Граница, "пакет");
	Номер = 0;
	Для Каждого СтрокиЧасти Из Части Цикл
		Номер = Номер + 1;
		Место = "часть " + Формат(Номер, "ЧГ=0");
		Часть = ЧастьMIME(СтрокиЧасти, Место);
		ВидЧасти = ВидСодержимого(Часть.ТипСодержимого);
		Если ВидЧасти = "application/http" Тогда
			Операции.Добавить(ОперацияHTTP(Часть, "", Место));
		ИначеЕсли ВидЧасти = "multipart/mixed" Тогда
			ДобавитьНаборИзменений(Операции, Часть, Место, ГраницыНаборов);
		Иначе
			Ошибка400(Место + ": Content-Type части должен быть application/http или multipart/mixed, получен: "
				+ ?(Часть.ТипСодержимого = "", "(не задан)", Часть.ТипСодержимого));
		КонецЕсли;
	КонецЦикла;
	Возврат Операции;
КонецФункции

// Операции набора изменений (часть multipart/mixed верхнего уровня); Набор операций — граница набора.
Процедура ДобавитьНаборИзменений(Операции, Часть, Место, ГраницыНаборов)
	ГраницаНабора = ГраницаИзТипа(Часть.ТипСодержимого);
	Если ГраницаНабора = "" Тогда
		Ошибка400(Место + ": в Content-Type набора изменений нет параметра boundary: " + Часть.ТипСодержимого);
	КонецЕсли;
	Если ГраницыНаборов.Получить(ГраницаНабора) <> Неопределено Тогда
		Ошибка400(Место + ": граница набора изменений «" + ГраницаНабора + "» уже использована в пакете");
	КонецЕсли;
	ГраницыНаборов.Вставить(ГраницаНабора, Истина);
	ЧастиНабора = СтрокиЧастей(Часть.Содержимое, ГраницаНабора, Место + " (набор изменений)");
	Если ЧастиНабора.Количество() = 0 Тогда
		Ошибка400(Место + ": набор изменений пуст");
	КонецЕсли;
	ИдыНабора = Новый Соответствие;
	Номер = 0;
	Для Каждого СтрокиЧасти Из ЧастиНабора Цикл
		Номер = Номер + 1;
		МестоВНаборе = Место + "." + Формат(Номер, "ЧГ=0");
		ЧастьНабора = ЧастьMIME(СтрокиЧасти, МестоВНаборе);
		ВидЧасти = ВидСодержимого(ЧастьНабора.ТипСодержимого);
		Если ВидЧасти = "multipart/mixed" Тогда
			Ошибка400(МестоВНаборе + ": набор изменений не может содержать вложенный multipart/mixed");
		ИначеЕсли ВидЧасти <> "application/http" Тогда
			Ошибка400(МестоВНаборе + ": Content-Type части набора изменений должен быть application/http, получен: "
				+ ?(ЧастьНабора.ТипСодержимого = "", "(не задан)", ЧастьНабора.ТипСодержимого));
		КонецЕсли;
		Операция = ОперацияHTTP(ЧастьНабора, ГраницаНабора, МестоВНаборе);
		Если Операция.Ид <> "" Тогда
			Если ИдыНабора.Получить(Операция.Ид) <> Неопределено Тогда
				Ошибка400(МестоВНаборе + ": Content-ID «" + Операция.Ид + "» повторяется в наборе изменений");
			КонецЕсли;
			ИдыНабора.Вставить(Операция.Ид, Истина);
		КонецЕсли;
		Операции.Добавить(Операция);
	КонецЦикла;
КонецПроцедуры

// Части тела multipart по границе: Массив частей, часть — Массив строк между разделителями (без концов строк).
// Преамбула до первого разделителя и эпилог после закрывающего пропускаются. Разделитель — строка «--граница»,
// закрывающий — «--граница--» (пробелы в конце строки допускаются).
Функция СтрокиЧастей(Текст, Граница, Место)
	СтрокиТекста = СтрРазделить(СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС), Символы.ПС, Истина);
	Разделитель = "--" + Граница;
	Закрывающий = Разделитель + "--";
	Части = Новый Массив;
	Текущая = Неопределено;
	Открыт = Ложь;
	Закрыт = Ложь;
	Для Каждого СтрокаТекста Из СтрокиТекста Цикл
		Проверка = СокрП(СтрокаТекста);
		Если Проверка = Закрывающий Тогда
			Если Текущая <> Неопределено Тогда
				Части.Добавить(Текущая);
			КонецЕсли;
			Закрыт = Истина;
			Прервать;
		ИначеЕсли Проверка = Разделитель Тогда
			Если Текущая <> Неопределено Тогда
				Части.Добавить(Текущая);
			КонецЕсли;
			Текущая = Новый Массив;
			Открыт = Истина;
		ИначеЕсли Текущая <> Неопределено Тогда
			Текущая.Добавить(СтрокаТекста);
		КонецЕсли;
	КонецЦикла;
	Если Не Открыт И Не Закрыт Тогда
		Ошибка400(Место + ": в теле нет границы «" + Разделитель + "» из Content-Type");
	КонецЕсли;
	Если Не Закрыт Тогда
		Ошибка400(Место + ": нет закрывающей границы «" + Закрывающий + "»");
	КонецЕсли;
	Возврат Части;
КонецФункции

// Часть MIME по её строкам: Структура("ТипСодержимого, Кодирование, Ид, Содержимое"). Заголовки части — до первой
// пустой строки; Содержимое — остальные строки через LF.
Функция ЧастьMIME(СтрокиЧасти, Место)
	Заголовки = Новый Соответствие;
	Индекс = ПрочитатьЗаголовки(СтрокиЧасти, 0, Заголовки, Место + ": неверный заголовок части");
	Часть = Новый Структура("ТипСодержимого, Кодирование, Ид, Содержимое", "", "", "", "");
	Для Каждого КлючИЗначение Из Заголовки Цикл
		Имя = НРег(КлючИЗначение.Ключ);
		Если Имя = "content-type" Тогда
			Часть.ТипСодержимого = КлючИЗначение.Значение;
		ИначеЕсли Имя = "content-transfer-encoding" Тогда
			Часть.Кодирование = КлючИЗначение.Значение;
		ИначеЕсли Имя = "content-id" Тогда
			Часть.Ид = БезУгловыхСкобок(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Часть.Содержимое = СоединитьСтроки(СтрокиЧасти, Индекс, Ложь);
	Возврат Часть;
КонецФункции

// Операция из части application/http: строка запроса «МЕТОД адрес HTTP/1.1», заголовки, пустая строка, тело.
Функция ОперацияHTTP(Часть, Набор, Место)
	Если Часть.Кодирование <> "" И НРег(Часть.Кодирование) <> "binary" Тогда
		Ошибка400(Место + ": Content-Transfer-Encoding должен быть binary, получен: " + Часть.Кодирование);
	КонецЕсли;
	СтрокиЗапроса = СтрРазделить(Часть.Содержимое, Символы.ПС, Истина);
	Индекс = 0;
	Пока Индекс < СтрокиЗапроса.Количество() И ПустаяСтрока(СтрокиЗапроса[Индекс]) Цикл
		Индекс = Индекс + 1;
	КонецЦикла;
	Если Индекс >= СтрокиЗапроса.Количество() Тогда
		Ошибка400(Место + ": нет строки запроса «МЕТОД адрес HTTP/1.1»");
	КонецЕсли;
	СтрокаЗапроса = СокрЛП(СтрокиЗапроса[Индекс]);
	Слова = СтрРазделить(СтрЗаменить(СтрокаЗапроса, Символы.Таб, " "), " ", Ложь);
	Если Слова.Количество() <> 3 Или Не СтрНачинаетсяС(ВРег(Слова[2]), "HTTP/") Тогда
		Ошибка400(Место + ": неверная строка запроса «" + СтрокаЗапроса + "» (ожидается «МЕТОД адрес HTTP/1.1»)");
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Индекс = ПрочитатьЗаголовки(СтрокиЗапроса, Индекс + 1, Заголовки, Место + ": неверный заголовок запроса");
	Операция = НоваяОперация();
	Операция.Ид = Часть.Ид;
	Операция.Набор = Набор;
	Операция.Метод = ВРег(Слова[0]);
	Операция.Адрес = Слова[1];
	Операция.Заголовки = Заголовки;
	Операция.Тело = СоединитьСтроки(СтрокиЗапроса, Индекс, Истина);
	Возврат Операция;
КонецФункции

// Читает заголовки «Имя: значение» с позиции Начало до пустой строки (строки продолжения, начатые пробелом или
// табуляцией, дописываются к предыдущему значению; повтор имени — значения через «, »; имя — как в первом
// вхождении). Результат — позиция после пустой строки (или конец строк). Заголовки — пустое Соответствие, заполняется
// в порядке первых вхождений имён.
// Время линейно по числу строк (отзыв безопасности): имя ищется по НРег в Соответствии, а не перебором прежних
// заголовков, значение собирается из частей одним СтрСоединить, а не склейкой строки на каждом повторе.
Функция ПрочитатьЗаголовки(СтрокиТекста, Начало, Заголовки, ТекстОшибки)
	Индекс = Начало;
	ИменаПоНРег = Новый Соответствие;
	Имена = Новый Массив;
	Части = Новый Массив;
	Последний = -1;
	Пока Индекс < СтрокиТекста.Количество() Цикл
		СтрокаЗаголовка = СтрокиТекста[Индекс];
		Индекс = Индекс + 1;
		Если ПустаяСтрока(СтрокаЗаголовка) Тогда
			Прервать;
		КонецЕсли;
		Первый = Лев(СтрокаЗаголовка, 1);
		Если (Первый = " " Или Первый = Символы.Таб) И Последний >= 0 Тогда
			Части[Последний].Добавить(" " + СокрЛП(СтрокаЗаголовка));
			Продолжить;
		КонецЕсли;
		Позиция = СтрНайти(СтрокаЗаголовка, ":");
		Имя = ?(Позиция = 0, "", СокрЛП(Лев(СтрокаЗаголовка, Позиция - 1)));
		Если Имя = "" Или СтрНайти(Имя, " ") > 0 Тогда
			Ошибка400(ТекстОшибки + " «" + СтрокаЗаголовка + "» (ожидается «Имя: значение»)");
		КонецЕсли;
		Значение = СокрЛП(Сред(СтрокаЗаголовка, Позиция + 1));
		Номер = ИменаПоНРег.Получить(НРег(Имя));
		Если Номер = Неопределено Тогда
			Номер = Имена.Количество();
			ИменаПоНРег.Вставить(НРег(Имя), Номер);
			Имена.Добавить(Имя);
			ЧастиЗначения = Новый Массив;
			ЧастиЗначения.Добавить(Значение);
			Части.Добавить(ЧастиЗначения);
		Иначе
			Части[Номер].Добавить(", " + Значение);
		КонецЕсли;
		Последний = Номер;
	КонецЦикла;
	Для Номер = 0 По Имена.ВГраница() Цикл
		Заголовки.Вставить(Имена[Номер], СтрСоединить(Части[Номер], ""));
	КонецЦикла;
	Возврат Индекс;
КонецФункции

// Строки с позиции Начало через LF; БезПустыхВКонце — без пустых строк в конце (перенос перед границей).
Функция СоединитьСтроки(СтрокиТекста, Начало, БезПустыхВКонце)
	Конец = СтрокиТекста.ВГраница();
	Если БезПустыхВКонце Тогда
		Пока Конец >= Начало И ПустаяСтрока(СтрокиТекста[Конец]) Цикл
			Конец = Конец - 1;
		КонецЦикла;
	КонецЕсли;
	Выбранные = Новый Массив;
	Для Индекс = Начало По Конец Цикл
		Выбранные.Добавить(СтрокиТекста[Индекс]);
	КонецЦикла;
	Возврат СтрСоединить(Выбранные, Символы.ПС);
КонецФункции

// Параметр boundary типа содержимого (кавычки снимаются); "" — нет.
Функция ГраницаИзТипа(ТипСодержимого)
	Параметры = СтрРазделить(ТипСодержимого, ";", Ложь);
	Для Индекс = 1 По Параметры.ВГраница() Цикл
		Параметр = СокрЛП(Параметры[Индекс]);
		Позиция = СтрНайти(Параметр, "=");
		Если Позиция = 0 Или НРег(СокрЛП(Лев(Параметр, Позиция - 1))) <> "boundary" Тогда
			Продолжить;
		КонецЕсли;
		Значение = СокрЛП(Сред(Параметр, Позиция + 1));
		Если СтрДлина(Значение) >= 2 И Лев(Значение, 1) = """" И Прав(Значение, 1) = """" Тогда
			Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
		КонецЕсли;
		Возврат Значение;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция БезУгловыхСкобок(Значение)
	Результат = СокрЛП(Значение);
	Если СтрДлина(Результат) >= 2 И Лев(Результат, 1) = "<" И Прав(Результат, 1) = ">" Тогда
		Результат = Сред(Результат, 2, СтрДлина(Результат) - 2);
	КонецЕсли;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область РазборJSON

// Операции JSON batch (OData 4.01): {"requests":[{"id","method","url","headers","body","atomicityGroup","dependsOn"}]}.
Функция ОперацииJSON(Текст)
	Данные = ЗначениеJSON(Текст);
	Если Данные.Причина <> "" Тогда
		Ошибка400("тело пакета — не JSON: " + Данные.Причина);
	КонецЕсли;
	Если ТипЗнч(Данные.Значение) <> Тип("Соответствие") Тогда
		Ошибка400("тело пакета JSON — не объект");
	КонецЕсли;
	Запросы = Данные.Значение.Получить("requests");
	Если ТипЗнч(Запросы) <> Тип("Массив") Тогда
		Ошибка400("в теле пакета JSON нет массива requests");
	КонецЕсли;
	Операции = Новый Массив;
	Иды = Новый Соответствие;
	Группы = Новый Соответствие;
	ПредыдущаяГруппа = "";
	Номер = 0;
	Для Каждого Запрос Из Запросы Цикл
		Номер = Номер + 1;
		Место = "запрос " + Формат(Номер, "ЧГ=0");
		Если ТипЗнч(Запрос) <> Тип("Соответствие") Тогда
			Ошибка400(Место + ": элемент requests — не объект");
		КонецЕсли;
		Операция = НоваяОперация();
		Операция.Ид = СвойствоСтрокой(Запрос, "id", Место, Истина);
		Если Иды.Получить(Операция.Ид) <> Неопределено Тогда
			Ошибка400(Место + ": id «" + Операция.Ид + "» повторяется в пакете");
		КонецЕсли;
		Место = Место + " (id «" + Операция.Ид + "»)";
		Операция.Метод = ВРег(СвойствоСтрокой(Запрос, "method", Место, Истина));
		Операция.Адрес = СвойствоСтрокой(Запрос, "url", Место, Истина);
		Операция.Набор = СвойствоСтрокой(Запрос, "atomicityGroup", Место, Ложь);
		Операция.Заголовки = ЗаголовкиJSON(Запрос.Получить("headers"), Место);
		Операция.Тело = ТелоJSON(Запрос, Операция.Заголовки, Место);
		Операция.ЗависитОт = ЗависимостиJSON(Запрос.Получить("dependsOn"), Иды, Группы, Место);
		Если Операция.Набор <> "" И Операция.Набор <> ПредыдущаяГруппа Тогда
			Если Группы.Получить(Операция.Набор) <> Неопределено Тогда
				Ошибка400(Место + ": запросы группы atomicityGroup «" + Операция.Набор + "» должны идти подряд");
			КонецЕсли;
			Если Иды.Получить(Операция.Набор) <> Неопределено Тогда
				Ошибка400(Место + ": atomicityGroup «" + Операция.Набор + "» совпадает с id другого запроса");
			КонецЕсли;
			Группы.Вставить(Операция.Набор, Истина);
		КонецЕсли;
		Если Группы.Получить(Операция.Ид) <> Неопределено Тогда
			Ошибка400(Место + ": id совпадает с именем группы atomicityGroup");
		КонецЕсли;
		ПредыдущаяГруппа = Операция.Набор;
		Иды.Вставить(Операция.Ид, Истина);
		Операции.Добавить(Операция);
	КонецЦикла;
	Возврат Операции;
КонецФункции

// Строковое свойство запроса JSON; Обязательное — отсутствие или пустое значение — 400. Не строка — 400.
Функция СвойствоСтрокой(Запрос, Имя, Место, Обязательное)
	Значение = Запрос.Получить(Имя);
	Если Значение = Неопределено Тогда
		Если Обязательное Тогда
			Ошибка400(Место + ": нет свойства " + Имя);
		КонецЕсли;
		Возврат "";
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Ошибка400(Место + ": свойство " + Имя + " должно быть строкой");
	КонецЕсли;
	Если Обязательное И ПустаяСтрока(Значение) Тогда
		Ошибка400(Место + ": пустое свойство " + Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// headers запроса JSON: объект «имя → строка» (число и булево — их XML-представлением); нет — пустое Соответствие.
Функция ЗаголовкиJSON(Значение, Место)
	Заголовки = Новый Соответствие;
	Если Значение = Неопределено Тогда
		Возврат Заголовки;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Соответствие") Тогда
		Ошибка400(Место + ": headers должен быть объектом");
	КонецЕсли;
	Для Каждого КлючИЗначение Из Значение Цикл
		ТипЗначения = ТипЗнч(КлючИЗначение.Значение);
		Если ТипЗначения = Тип("Строка") Тогда
			Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		ИначеЕсли ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
			Заголовки.Вставить(КлючИЗначение.Ключ, XMLСтрока(КлючИЗначение.Значение));
		Иначе
			Ошибка400(Место + ": значение заголовка " + КлючИЗначение.Ключ + " должно быть строкой");
		КонецЕсли;
	КонецЦикла;
	Возврат Заголовки;
КонецФункции

// body запроса JSON строкой (OData JSON Format 4.01 §19): нет или null — ""; тип содержимого операции JSON — текст
// JSON значения; иной тип, кроме text/*, — строка base64url, декодируется (UTF-8); text/* или тип не задан — строка
// как есть (не строка — текст JSON).
Функция ТелоJSON(Запрос, Заголовки, Место)
	Значение = Запрос.Получить("body");
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Вид = ВидТела(ЗначениеЗаголовка(Заголовки, "Content-Type"));
	Если Вид = "двоичное" Тогда
		Если ТипЗнч(Значение) <> Тип("Строка") Тогда
			Ошибка400(Место + ": body с Content-Type " + ЗначениеЗаголовка(Заголовки, "Content-Type")
				+ " должен быть строкой base64url");
		КонецЕсли;
		Возврат ИзBase64URL(Значение, Место);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И Вид <> "json" Тогда
		Возврат Значение;
	КонецЕсли;
	Запись = OData4_Сериализация.НоваяЗапись();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

// dependsOn запроса JSON: массив строк — id предшествующих запросов или имён предшествующих групп.
Функция ЗависимостиJSON(Значение, Иды, Группы, Место)
	Зависимости = Новый Массив;
	Если Значение = Неопределено Тогда
		Возврат Зависимости;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Ошибка400(Место + ": dependsOn должен быть массивом");
	КонецЕсли;
	Для Каждого Ид Из Значение Цикл
		Если ТипЗнч(Ид) <> Тип("Строка") Тогда
			Ошибка400(Место + ": элементы dependsOn должны быть строками");
		КонецЕсли;
		Если Иды.Получить(Ид) = Неопределено И Группы.Получить(Ид) = Неопределено Тогда
			Ошибка400(Место + ": dependsOn ссылается на «" + Ид + "» — нет такого предшествующего запроса или группы");
		КонецЕсли;
		Зависимости.Добавить(Ид);
	КонецЦикла;
	Возврат Зависимости;
КонецФункции

#КонецОбласти

#Область ОтветMultipart

// Тело ответа multipart/mixed: записи вне набора — части application/http; подряд идущие записи набора — вложенный
// multipart/mixed (успех) или одна часть application/http с ошибкой (отказ набора).
Функция ТекстОтветаMultipart(Результаты, Граница)
	Части = Новый Массив;
	Количество = Результаты.Количество();
	Индекс = 0;
	Пока Индекс < Количество Цикл
		Результат = Результаты[Индекс];
		Набор = Поле(Результат, "Набор", "");
		Если Набор = "" Тогда
			Части.Добавить(ЧастьОтвета(Результат, Истина));
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Группа = Новый Массив;
		Отказ = Неопределено;
		Пока Индекс < Количество И Поле(Результаты[Индекс], "Набор", "") = Набор Цикл
			Результат = Результаты[Индекс];
			Группа.Добавить(Результат);
			Если Поле(Результат, "ОтказНабора", Ложь) = Истина
				И (Отказ = Неопределено Или Поле(Отказ, "Статус", 0) < 400 И Поле(Результат, "Статус", 0) >= 400) Тогда
				Отказ = Результат;
			КонецЕсли;
			Индекс = Индекс + 1;
		КонецЦикла;
		Если Отказ <> Неопределено Тогда
			Части.Добавить(ЧастьОтвета(Отказ, Ложь));
			Продолжить;
		КонецЕсли;
		ГраницаНабора = "changesetresponse_" + НовыйИдентификатор();
		ЧастиНабора = Новый Массив;
		Для Каждого Результат Из Группа Цикл
			ЧастиНабора.Добавить(ЧастьОтвета(Результат, Истина));
		КонецЦикла;
		Части.Добавить("Content-Type: multipart/mixed; boundary=" + ГраницаНабора + ПереводСтроки() + ПереводСтроки()
			+ ТелоMultipart(ЧастиНабора, ГраницаНабора));
	КонецЦикла;
	Возврат ТелоMultipart(Части, Граница);
КонецФункции

// Части через разделители «--граница» и закрывающий «--граница--»; концы строк — CRLF.
Функция ТелоMultipart(Части, Граница)
	Фрагменты = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Фрагменты.Добавить("--" + Граница + ПереводСтроки() + Часть + ПереводСтроки());
	КонецЦикла;
	Фрагменты.Добавить("--" + Граница + "--" + ПереводСтроки());
	Возврат СтрСоединить(Фрагменты, "");
КонецФункции

// Часть application/http с ответом операции: «HTTP/1.1 <статус> <фраза>», заголовки, пустая строка, тело.
// СContentID — Content-ID части по Ид записи (если задан).
Функция ЧастьОтвета(Результат, СContentID)
	СтрокиЧасти = Новый Массив;
	СтрокиЧасти.Добавить("Content-Type: application/http");
	СтрокиЧасти.Добавить("Content-Transfer-Encoding: binary");
	Ид = Поле(Результат, "Ид", "");
	Если СContentID И Ид <> "" Тогда
		СтрокиЧасти.Добавить("Content-ID: " + Ид);
	КонецЕсли;
	СтрокиЧасти.Добавить("");
	Статус = Поле(Результат, "Статус", 500);
	СтрокиЧасти.Добавить("HTTP/1.1 " + Формат(Статус, "ЧГ=0") + " " + ФразаСостояния(Статус));
	Заголовки = Поле(Результат, "Заголовки", Неопределено);
	Если Заголовки <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Заголовки Цикл
			СтрокиЧасти.Добавить(КлючИЗначение.Ключ + ": " + КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	СтрокиЧасти.Добавить("");
	СтрокиЧасти.Добавить(Поле(Результат, "Тело", ""));
	Возврат СтрСоединить(СтрокиЧасти, ПереводСтроки());
КонецФункции

#КонецОбласти

#Область ОтветJSON

// Тело ответа JSON batch: {"responses":[…]} в порядке Результаты; отклонённая группа — все её операции из Разбор.
// Объекты ответов собираются текстом: JSON-тело операции встраивается без изменений (порядок свойств, в том числе
// @odata.context первым, сохраняется; повторного разбора нет).
Функция ТекстОтветаJSON(Разбор, Результаты)
	Ответы = Новый Массив;
	Выведенные = Новый Соответствие;
	Для Каждого Результат Из Результаты Цикл
		Набор = Поле(Результат, "Набор", "");
		Если Набор = "" Или Поле(Результат, "ОтказНабора", Ложь) <> Истина Тогда
			ДобавитьОтветJSON(Ответы, Поле(Результат, "Ид", ""), Набор, Поле(Результат, "Статус", 500),
				Поле(Результат, "Заголовки", Неопределено), Поле(Результат, "Тело", ""));
			Продолжить;
		КонецЕсли;
		Если Выведенные.Получить(Набор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Выведенные.Вставить(Набор, Истина);
		ДобавитьОтказГруппы(Ответы, Разбор, Результаты, Набор);
	КонецЦикла;
	Возврат "{""responses"":[" + СтрСоединить(Ответы, ",") + "]}";
КонецФункции

// Ответы отклонённой группы: каждая операция группы (порядок Разбор) — её запись с ошибкой (статус 400 и выше) или 424.
Процедура ДобавитьОтказГруппы(Ответы, Разбор, Результаты, Набор)
	Ошибки = Новый Соответствие;
	Для Каждого Результат Из Результаты Цикл
		Если Поле(Результат, "Набор", "") = Набор И Поле(Результат, "Статус", 0) >= 400 Тогда
			Ошибки.Вставить(Поле(Результат, "Ид", ""), Результат);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Операция Из Разбор.Операции Цикл
		Если Операция.Набор <> Набор Тогда
			Продолжить;
		КонецЕсли;
		Результат = Ошибки.Получить(Операция.Ид);
		Если Результат <> Неопределено Тогда
			ДобавитьОтветJSON(Ответы, Операция.Ид, Набор, Поле(Результат, "Статус", 500),
				Поле(Результат, "Заголовки", Неопределено), Поле(Результат, "Тело", ""));
			Продолжить;
		КонецЕсли;
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Content-Type", "application/json");
		ДобавитьОтветJSON(Ответы, Операция.Ид, Набор, 424, Заголовки, ТекстОшибкиЗависимости(Набор));
	КонецЦикла;
КонецПроцедуры

// Текст объекта ответа в Ответы: id, status, headers, body, atomicityGroup. body по типу содержимого (OData JSON
// Format 4.01 §19): JSON — встраивается как есть (объект или массив — исходным текстом, иное значение — через разбор,
// не JSON — строкой); text/* или тип не задан — строка; иной тип — строка base64url (байты UTF-8 тела).
Процедура ДобавитьОтветJSON(Ответы, Ид, Набор, Статус, Заголовки, Тело)
	Запись = OData4_Сериализация.НоваяЗапись();
	Запись.ЗаписатьНачалоОбъекта();
	Если Ид <> "" Тогда
		Запись.ЗаписатьИмяСвойства("id");
		Запись.ЗаписатьЗначение(Ид);
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства("status");
	Запись.ЗаписатьЗначение(Статус);
	ТипТела = Неопределено;
	Если Заголовки <> Неопределено И Заголовки.Количество() > 0 Тогда
		ТипТела = ЗначениеЗаголовка(Заголовки, "Content-Type");
		Запись.ЗаписатьИмяСвойства("headers");
		Запись.ЗаписатьНачалоОбъекта();
		Для Каждого КлючИЗначение Из Заголовки Цикл
			Запись.ЗаписатьИмяСвойства(КлючИЗначение.Ключ);
			Запись.ЗаписатьЗначение(КлючИЗначение.Значение);
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
	КонецЕсли;
	Встроить = "";
	Метка = "";
	Если ТипЗнч(Тело) = Тип("Строка") И Тело <> "" Тогда
		Запись.ЗаписатьИмяСвойства("body");
		Вид = ВидТела(ТипТела);
		Если Вид = "json" Тогда
			Текст = СокрЛП(?(Лев(Тело, 1) = Символ(65279), Сред(Тело, 2), Тело));
			Первый = Лев(Текст, 1);
			Если Первый = "{" Или Первый = "[" Тогда
				// ЗаписатьБезОбработки после имени свойства недопустим: метка-строка заменяется текстом тела.
				Встроить = Текст;
				Метка = НовыйИдентификатор();
				Запись.ЗаписатьЗначение(Метка);
			Иначе
				Данные = ЗначениеJSON(Текст);
				Если Данные.Причина = "" Тогда
					ЗаписатьJSON(Запись, Данные.Значение);
				Иначе
					Запись.ЗаписатьЗначение(Тело);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Вид = "двоичное" Тогда
			Запись.ЗаписатьЗначение(ВBase64URL(Тело));
		Иначе
			Запись.ЗаписатьЗначение(Тело);
		КонецЕсли;
	КонецЕсли;
	Если Набор <> "" Тогда
		Запись.ЗаписатьИмяСвойства("atomicityGroup");
		Запись.ЗаписатьЗначение(Набор);
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();
	Текст = Запись.Закрыть();
	Если Метка <> "" Тогда
		Текст = СтрЗаменить(Текст, """" + Метка + """", Встроить);
	КонецЕсли;
	Ответы.Добавить(Текст);
КонецПроцедуры

Функция ТекстОшибкиЗависимости(Набор)
	Запись = OData4_Сериализация.НоваяЗапись();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("error");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("code");
	Запись.ЗаписатьЗначение("FailedDependency");
	Запись.ЗаписатьИмяСвойства("message");
	Запись.ЗаписатьЗначение("Операция не выполнена: группа atomicityGroup «" + Набор + "» отклонена");
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
КонецФункции

#КонецОбласти

#Область Общие

Функция НоваяОперация()
	Возврат Новый Структура("Ид, Набор, Метод, Адрес, Заголовки, Тело, ЗависитОт",
		"", "", "", "", Новый Соответствие, "", Новый Массив);
КонецФункции

// Тип содержимого без параметров, строчными ("multipart/mixed").
Функция ВидСодержимого(ТипСодержимого)
	Возврат НРег(СокрЛП(СтрРазделить(ТипСодержимого + ";", ";")[0]));
КонецФункции

// Вид тела по Content-Type (OData JSON Format 4.01 §19): "json" (application/json, …+json), "текст" (text/*),
// "двоичное" (иной тип), "" — тип не задан.
Функция ВидТела(ТипТела)
	Если ТипЗнч(ТипТела) <> Тип("Строка") Или ПустаяСтрока(ТипТела) Тогда
		Возврат "";
	КонецЕсли;
	Вид = ВидСодержимого(ТипТела);
	Если Вид = "application/json" Или СтрЗаканчиваетсяНа(Вид, "+json") Тогда
		Возврат "json";
	КонецЕсли;
	Если СтрНачинаетсяС(Вид, "text/") Тогда
		Возврат "текст";
	КонецЕсли;
	Возврат "двоичное";
КонецФункции

// Строка base64url без дополнения «=» (RFC 4648 §5) от байтов UTF-8 текста.
Функция ВBase64URL(Текст)
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Текст, КодировкаТекста.UTF8, Ложь);
	Результат = СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символы.ВК, ""), Символы.ПС, "");
	Результат = СтрЗаменить(СтрЗаменить(Результат, "+", "-"), "/", "_");
	Пока СтрЗаканчиваетсяНа(Результат, "=") Цикл
		Результат = Лев(Результат, СтрДлина(Результат) - 1);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Текст (UTF-8) из строки base64url (дополнение «=» необязательно; допускается и обычный base64). Неверная строка —
// 400: проверка — обратным кодированием.
Функция ИзBase64URL(Значение, Место)
	Исходное = СтрЗаменить(СтрЗаменить(СокрЛП(Значение), Символы.ВК, ""), Символы.ПС, "");
	Исходное = СтрЗаменить(СтрЗаменить(Исходное, "-", "+"), "_", "/");
	Пока СтрЗаканчиваетсяНа(Исходное, "=") Цикл
		Исходное = Лев(Исходное, СтрДлина(Исходное) - 1);
	КонецЦикла;
	Если Исходное = "" Тогда
		Возврат "";
	КонецЕсли;
	Дополненное = Исходное + Лев("===", (4 - СтрДлина(Исходное) % 4) % 4);
	Данные = Base64Значение(Дополненное);
	Проверка = "";
	Если ТипЗнч(Данные) = Тип("ДвоичныеДанные") Тогда
		Проверка = СтрЗаменить(СтрЗаменить(Base64Строка(Данные), Символы.ВК, ""), Символы.ПС, "");
	КонецЕсли;
	Если Проверка <> Дополненное Тогда
		Ошибка400(Место + ": body — не строка base64url");
	КонецЕсли;
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Данные, КодировкаТекста.UTF8);
КонецФункции

// Значение заголовка по имени без учёта регистра; Неопределено — нет.
Функция ЗначениеЗаголовка(Заголовки, Имя)
	Искомое = НРег(Имя);
	Для Каждого КлючИЗначение Из Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) = Искомое Тогда
			Возврат КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Структура("Значение, Причина"): значение JSON (объекты — Соответствие); Причина — текст ошибки разбора ("" — нет).
Функция ЗначениеJSON(Текст)
	Результат = Новый Структура("Значение, Причина", Неопределено, "");
	Чтение = Новый ЧтениеJSON;
	Попытка
		Чтение.УстановитьСтроку(Текст);
		Результат.Значение = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Результат.Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Чтение.Закрыть();
	Возврат Результат;
КонецФункции

// Поле записи результата; нет поля — Умолчание.
Функция Поле(Запись, Имя, Умолчание)
	Значение = Неопределено;
	Если ТипЗнч(Запись) = Тип("Структура") И Запись.Свойство(Имя, Значение) И Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Умолчание;
КонецФункции

Функция НовыйИдентификатор()
	Идентификатор = Новый УникальныйИдентификатор;
	Возврат СтрЗаменить(НРег(Строка(Идентификатор)), "-", "");
КонецФункции

Функция ПереводСтроки()
	Возврат Символы.ВК + Символы.ПС;
КонецФункции

// Фраза состояния HTTP для строки статуса ответа операции.
Функция ФразаСостояния(Статус)
	Фразы = Новый Соответствие;
	Фразы.Вставить(200, "OK");
	Фразы.Вставить(201, "Created");
	Фразы.Вставить(202, "Accepted");
	Фразы.Вставить(204, "No Content");
	Фразы.Вставить(304, "Not Modified");
	Фразы.Вставить(400, "Bad Request");
	Фразы.Вставить(401, "Unauthorized");
	Фразы.Вставить(403, "Forbidden");
	Фразы.Вставить(404, "Not Found");
	Фразы.Вставить(405, "Method Not Allowed");
	Фразы.Вставить(406, "Not Acceptable");
	Фразы.Вставить(409, "Conflict");
	Фразы.Вставить(412, "Precondition Failed");
	Фразы.Вставить(413, "Payload Too Large");
	Фразы.Вставить(415, "Unsupported Media Type");
	Фразы.Вставить(424, "Failed Dependency");
	Фразы.Вставить(428, "Precondition Required");
	Фразы.Вставить(429, "Too Many Requests");
	Фразы.Вставить(500, "Internal Server Error");
	Фразы.Вставить(501, "Not Implemented");
	Фразы.Вставить(503, "Service Unavailable");
	Фраза = Фразы.Получить(Статус);
	Возврат ?(Фраза = Неопределено, "Status", Фраза);
КонецФункции

Процедура Ошибка400(Факт)
	OData4_Сервис.ОшибкаOData(400, "BadRequest", "$batch: " + Факт);
КонецПроцедуры

