#Область ПрограммныйИнтерфейс

// Выборка — описание одного запроса ВЫБРАТЬ: таблица (или текст источника), колонки, левые соединения,
// условия, порядок, ПЕРВЫЕ, признак РАЗЛИЧНЫЕ и выражение для КОЛИЧЕСТВО (по умолчанию «*»).
// КоличествоПодзапросом — строки считаются подзапросом и без группировки (КОЛИЧЕСТВО(*) прямо из таблицы
// остатков 1С отвергает: «должно быть указано хотя бы одно измерение или ресурс»).
Функция НоваяВыборка(Таблица, Псевдоним) Экспорт
	Выборка = Новый Структура;
	Выборка.Вставить("Таблица", Таблица);
	Выборка.Вставить("Псевдоним", Псевдоним);
	Выборка.Вставить("Колонки", Новый Массив);
	Выборка.Вставить("Соединения", Новый Массив);
	Выборка.Вставить("Условия", Новый Массив);
	Выборка.Вставить("УсловияПродолжения", Новый Массив);
	Выборка.Вставить("Порядок", Новый Массив);
	Выборка.Вставить("Первые", 0);
	Выборка.Вставить("Различные", Ложь);
	Выборка.Вставить("ПолеКоличества", "*");
	Выборка.Вставить("Источник", "");
	Выборка.Вставить("Группировка", Новый Массив);
	Выборка.Вставить("Поместить", "");
	Выборка.Вставить("КоличествоПодзапросом", Ложь);
	Возврат Выборка;
КонецФункции

// Добавляет колонку «Выражение КАК КN» и возвращает её имя.
// Колонка выборки по тексту выражения. Одинаковое выражение не дублируется: ключ набора попадает
// в выборку и как выбранное свойство, и как поле порядка, а две одинаковые колонки в ВЫБРАТЬ —
// лишняя работа СУБД и лишний столбец в результате.
Функция ДобавитьКолонку(Выборка, ТекстВыражения) Экспорт
	Для Каждого Колонка Из Выборка.Колонки Цикл
		Если Колонка.Выражение = ТекстВыражения Тогда
			Возврат Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	Имя = "К" + Формат(Выборка.Колонки.Количество() + 1, "ЧГ=0");
	Выборка.Колонки.Добавить(Новый Структура("Выражение, Имя", ТекстВыражения, Имя));
	Возврат Имя;
КонецФункции

// Текст запроса по выборке: ВЫБРАТЬ РАЗРЕШЕННЫЕ [ПЕРВЫЕ N] … [ПОМЕСТИТЬ ВТ] ИЗ … [ЛЕВОЕ СОЕДИНЕНИЕ …] [ГДЕ …]
// [СГРУППИРОВАТЬ ПО …] [УПОРЯДОЧИТЬ ПО …].
Функция ТекстВыборки(Выборка) Экспорт
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ РАЗРЕШЕННЫЕ" + ?(Выборка.Различные, " РАЗЛИЧНЫЕ", "")
		+ ?(Выборка.Первые > 0, " ПЕРВЫЕ " + Формат(Выборка.Первые, "ЧГ=0"), ""));
	Колонки = Новый Массив;
	Для Каждого Колонка Из Выборка.Колонки Цикл
		Колонки.Добавить(Символы.Таб + Колонка.Выражение + " КАК " + Колонка.Имя);
	КонецЦикла;
	Строки.Добавить(СтрСоединить(Колонки, "," + Символы.ПС));
	Если Выборка.Поместить <> "" Тогда
		Строки.Добавить("ПОМЕСТИТЬ " + Выборка.Поместить);
	КонецЕсли;
	ДобавитьИсточник(Строки, Выборка);
	Условия = Новый Массив;
	Для Каждого ТекстУсловия Из Выборка.Условия Цикл
		Условия.Добавить(ТекстУсловия);
	КонецЦикла;
	Для Каждого ТекстУсловия Из Выборка.УсловияПродолжения Цикл
		Условия.Добавить(ТекстУсловия);
	КонецЦикла;
	ДобавитьУсловия(Строки, Условия);
	Если Выборка.Группировка.Количество() > 0 Тогда
		Строки.Добавить("СГРУППИРОВАТЬ ПО");
		Поля = Новый Массив;
		Для Каждого Выражение0 Из Выборка.Группировка Цикл
			Поля.Добавить(Символы.Таб + Выражение0);
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Поля, "," + Символы.ПС));
	КонецЕсли;
	Если Выборка.Порядок.Количество() > 0 Тогда
		Строки.Добавить("УПОРЯДОЧИТЬ ПО");
		Элементы = Новый Массив;
		Для Каждого Элемент Из Выборка.Порядок Цикл
			Элементы.Добавить(Символы.Таб + Элемент.Выражение + ?(Элемент.Убывание, " УБЫВ", ""));
		КонецЦикла;
		Строки.Добавить(СтрСоединить(Элементы, "," + Символы.ПС));
	КонецЕсли;
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Текст запроса количества строк выборки с её условиями (без продолжения, порядка и ПЕРВЫЕ).
// При группировке (и с КоличествоПодзапросом) считается число строк подзапроса без РАЗРЕШЕННЫЕ.
Функция ТекстКоличества(Выборка) Экспорт
	Если Выборка.Группировка.Количество() > 0 Или Выборка.КоличествоПодзапросом Тогда
		Внутренняя = КопияВыборки(Выборка);
		Внутренняя.Порядок = Новый Массив;
		Внутренняя.Первые = 0;
		Внутренняя.УсловияПродолжения = Новый Массив;
		Строки = Новый Массив;
		Строки.Добавить("ВЫБРАТЬ РАЗРЕШЕННЫЕ");
		Строки.Добавить(Символы.Таб + "КОЛИЧЕСТВО(*) КАК Количество");
		Строки.Добавить("ИЗ");
		Строки.Добавить(Символы.Таб + "(" + ТекстВнутренней(Внутренняя) + ") КАК П");
		Возврат СтрСоединить(Строки, Символы.ПС);
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("ВЫБРАТЬ РАЗРЕШЕННЫЕ");
	Строки.Добавить(Символы.Таб + "КОЛИЧЕСТВО(" + ?(Выборка.Различные, "РАЗЛИЧНЫЕ ", "")
		+ Выборка.ПолеКоличества + ") КАК Количество");
	Строки.Добавить("ИЗ");
	Строки.Добавить(Символы.Таб + ?(Выборка.Источник = "", Выборка.Таблица, Выборка.Источник)
		+ " КАК " + Выборка.Псевдоним);
	ДобавитьУсловия(Строки, Выборка.Условия);
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

// Контекст генерации выражений: модель, общие параметры плана, корневая область (набор и псевдоним),
// области лямбд, счётчик псевдонимов подзапросов, ошибка перевода выражения (см. Условие).
Функция НовыйКонтекст(Модель, Параметры, Набор, Псевдоним) Экспорт
	Контекст = Новый Структура;
	Контекст.Вставить("Модель", Модель);
	Контекст.Вставить("Параметры", Параметры);
	Контекст.Вставить("Области", Новый Массив);
	Контекст.Вставить("ПрефиксКорня", Псевдоним);
	Контекст.Вставить("Подзапросов", 0);
	Контекст.Вставить("Ошибка", Неопределено);
	Контекст.Области.Добавить(Новый Структура("Переменная, Набор, Префикс", "", Набор, Псевдоним));
	Возврат Контекст;
КонецФункции

// Добавляет параметр запроса и возвращает его имя в тексте («&П1»).
Функция ДобавитьПараметр(Контекст, Значение) Экспорт
	Имя = "П" + Формат(Контекст.Параметры.Количество() + 1, "ЧГ=0");
	Контекст.Параметры.Вставить(Имя, Значение);
	Возврат "&" + Имя;
КонецФункции

// Тип выражения по свойству набора — для ключа, порядка и агрегатов (см. ТипСвойства).
Функция ТипПоляНабора(Свойство, Набор, Модель) Экспорт
	Возврат ТипСвойства(Свойство, Набор, Модель);
КонецФункции

// Значение параметра запроса по узлу-литералу дерева разбора и ожидаемому типу выражения.
// Ошибка — исключение OData 400 (вызывается на верхнем уровне, рекурсии здесь нет).
Функция ЗначениеПоТипу(Литерал, Тип0, Контекст) Экспорт
	Контекст.Ошибка = Неопределено;
	Значение = ЗначениеЛитерала(Литерал, Тип0, Контекст);
	ПроверитьОшибку(Контекст);
	Возврат Значение;
КонецФункции

// Тип выражения по виду — для параметров виртуальных таблиц и агрегатов $apply.
Функция НовыйТипВыражения(Вид) Экспорт
	Возврат НовыйТип(Вид);
КонецФункции

#КонецОбласти

#Область Выражения

// Условие языка запросов по дереву $filter. Перевод дерева рекурсивен и не бросает исключений из глубины
// (исключение, прошедшее через десятки вложенных вызовов, роняет процесс 1С): первая ошибка запоминается
// в Контекст.Ошибка, перевод сворачивается обычными возвратами, исключение OData вызывается здесь.
Функция Условие(Узел, Контекст) Экспорт
	Контекст.Ошибка = Неопределено;
	Текст = УсловиеУзла(Узел, Контекст);
	ПроверитьОшибку(Контекст);
	ПроверитьВложенность(Текст);
	Возврат Текст;
КонецФункции

// Выражение языка запросов по узлу дерева: Структура «Текст, Тип, Литерал». У литерала Тип.Вид = "Литерал",
// текст пуст: литерал становится параметром, когда известен тип второго операнда. Ошибка — исключение OData.
Функция Выражение(Узел, Контекст) Экспорт
	Контекст.Ошибка = Неопределено;
	Выр = ВыражениеУзла(Узел, Контекст);
	ПроверитьОшибку(Контекст);
	ПроверитьВложенность(Выр.Текст);
	Возврат Выр;
КонецФункции

// Литерал без второго операнда (compute $apply) — параметр запроса своего типа: Структура «Текст, Тип,
// Литерал». Не литерал возвращается как есть; ошибка — исключение OData (рекурсии здесь нет).
Функция ПараметрЛитерала(Выр, Контекст) Экспорт
	Если Выр.Литерал = Неопределено Тогда
		Возврат Выр;
	КонецЕсли;
	Контекст.Ошибка = Неопределено;
	Итог = Операнд(Выр, НовыйТип("Литерал"), Контекст);
	ПроверитьОшибку(Контекст);
	Возврат Итог;
КонецФункции

// Выражение для УПОРЯДОЧИТЬ ПО и метки продолжения: перечисление — по порядку значений, булево и условие —
// числом 0/1. Строки неограниченной длины, составные, хранилища и литералы не упорядочиваются (400).
Функция ВыражениеПорядка(Выр, Контекст) Экспорт
	Вид = Выр.Тип.Вид;
	Если Выр.Тип.Приведение Тогда
		Ошибка400("Нельзя упорядочить по выражению: cast");
	ИначеЕсли Вид = "ВидДвижения" И Выр.Тип.Перечисление = "ВидСчета" Тогда
		Возврат Выражение2("ВЫБОР КОГДА " + Выр.Текст + " = ЗНАЧЕНИЕ(ВидСчета.Активный) ТОГДА 0 КОГДА " + Выр.Текст
			+ " = ЗНАЧЕНИЕ(ВидСчета.Пассивный) ТОГДА 1 ИНАЧЕ 2 КОНЕЦ", НовыйТип("Число"));
	ИначеЕсли Вид = "ВидДвижения" Тогда
		Первое = ?(Выр.Тип.Перечисление = "ВидДвиженияБухгалтерии",
			"ЗНАЧЕНИЕ(ВидДвиженияБухгалтерии.Дебет)", "ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)");
		Возврат Выражение2("ВЫБОР КОГДА " + Выр.Текст + " = " + Первое + " ТОГДА 0 ИНАЧЕ 1 КОНЕЦ", НовыйТип("Число"));
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат Выражение2(Выр.Текст + ".Порядок", НовыйТип("Число"));
	ИначеЕсли Вид = "Булево" Тогда
		Возврат Выражение2("ВЫБОР КОГДА " + Выр.Текст + " ТОГДА 1 КОГДА НЕ " + Выр.Текст + " ТОГДА 0 КОНЕЦ",
			НовыйТип("Число"));
	ИначеЕсли Вид = "Условие" Тогда
		Возврат Выражение2("ВЫБОР КОГДА " + Выр.Текст + " ТОГДА 1 ИНАЧЕ 0 КОНЕЦ", НовыйТип("Число"));
	ИначеЕсли Вид = "Строка" И Выр.Тип.ПолеПорядка <> "" И СтрЗаканчиваетсяНа(Выр.Текст, ".Код") Тогда
		Тип0 = НовыйТип("Строка");
		Тип0.Длина = 1024;
		Возврат Выражение2(Лев(Выр.Текст, СтрДлина(Выр.Текст) - 3) + Выр.Тип.ПолеПорядка, Тип0);
	ИначеЕсли Вид = "Строка" И Выр.Тип.Длина = 0 Тогда
		Ошибка400("Строку неограниченной длины нельзя упорядочить: " + ИмяВыражения(Выр));
	ИначеЕсли Вид = "Литерал" Или Вид = "Составной" Или Вид = "Хранилище" Или Вид = "Null" Тогда
		Ошибка400("Нельзя упорядочить по выражению: " + ИмяВыражения(Выр));
	КонецЕсли;
	Возврат Выр;
КонецФункции

// Условие по узлу дерева (рекурсивно, без исключений).
Функция УсловиеУзла(Узел, Контекст)
	Возврат КакУсловие(ВыражениеУзла(Узел, Контекст), Контекст);
КонецФункции

// Выражение по узлу дерева (рекурсивно, без исключений): после ошибки — Сбой().
Функция ВыражениеУзла(Узел, Контекст)
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	Вид = Узел.kind;
	Если Вид = "literal" Тогда
		Возврат Новый Структура("Текст, Тип, Литерал", "", НовыйТип("Литерал"), Узел);
	ИначеЕсли Вид = "path" Тогда
		Возврат Путь(Узел, Контекст);
	ИначеЕсли Вид = "binary" Тогда
		Возврат Бинарное(Узел, Контекст);
	ИначеЕсли Вид = "unary" Тогда
		Возврат Унарное(Узел, Контекст);
	ИначеЕсли Вид = "in" Тогда
		Возврат ВхождениеВСписок(Узел, Контекст);
	ИначеЕсли Вид = "call" Тогда
		Возврат ВызовФункции(Узел, Контекст);
	ИначеЕсли Вид = "cast" Тогда
		Возврат Приведение(Узел, Контекст);
	ИначеЕсли Вид = "lambda" Тогда
		Возврат Лямбда(Узел, Контекст);
	КонецЕсли;
	Возврат Отказ(Контекст, "Неизвестный узел дерева разбора: " + Вид);
КонецФункции

// Ошибка перевода без исключения: запоминается первая, возвращается Сбой(). Статус — 400 или 501.
Функция Отказ(Контекст, Сообщение, Статус = 400)
	Если Контекст.Ошибка = Неопределено Тогда
		Контекст.Ошибка = Новый Структура("Статус, Сообщение", Статус, Сообщение);
	КонецЕсли;
	Возврат Сбой();
КонецФункции

// Выражение-заглушка после ошибки перевода.
Функция Сбой()
	Возврат Выражение2("", НовыйТип("Ошибка"));
КонецФункции

// Запомненная ошибка перевода — исключение OData (вызывается только на верхнем уровне).
Процедура ПроверитьОшибку(Контекст)
	Ошибка = Контекст.Ошибка;
	Если Ошибка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Контекст.Ошибка = Неопределено;
	Если Ошибка.Статус = 501 Тогда
		Ошибка501(Ошибка.Сообщение);
	ИначеЕсли Ошибка.Статус = 500 Тогда
		OData4_Сервис.ОшибкаOData(500, "InternalError", Ошибка.Сообщение);
	КонецЕсли;
	Ошибка400(Ошибка.Сообщение);
КонецПроцедуры

// Вложенность скобок и ВЫБОР … КОНЕЦ в тексте выражения — не больше 60: платформа отвергает запрос
// с вложенностью больше ~70 («Превышение допустимой вложенности операций»). Имена полей и параметров
// скобок не содержат, литералов в тексте нет.
Процедура ПроверитьВложенность(Текст)
	Если ВложенностьВыражения(Текст) > 60 Тогда
		Ошибка400("Слишком глубокая вложенность выражения");
	КонецЕсли;
КонецПроцедуры

// Наибольшая вложенность скобок и ВЫБОР … КОНЕЦ в тексте выражения языка запросов (см. ПроверитьВложенность).
Функция ВложенностьВыражения(Текст) Экспорт
	Скобки = СтрЗаменить(СтрЗаменить(Текст, "ВЫБОР КОГДА ", "("), " КОНЕЦ", ")");
	Уровень = 0;
	Наибольший = 0;
	Позиция = 1;
	Длина = СтрДлина(Скобки);
	Пока Позиция <= Длина Цикл
		Сим = Сред(Скобки, Позиция, 1);
		Если Сим = "(" Тогда
			Уровень = Уровень + 1;
			Наибольший = Макс(Наибольший, Уровень);
		ИначеЕсли Сим = ")" Тогда
			Уровень = Уровень - 1;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Возврат Наибольший;
КонецФункции

// Тип выражения: Вид — Строка, Число, Булево, Дата, Гуид, Ссылка, Перечисление, Составной, Хранилище,
// Условие, Литерал, Null (и Ошибка у Сбой()). Длина — для строк (0 — неограниченная), ЧастиДаты — для дат,
// ТипСсылки и Набор — для ссылок (Набор — описание целевого набора модели или Неопределено), Навигация — путь
// оканчивается навигационным свойством, Перечисление — имя перечисления, Имя — путь OData для сообщений,
// Приведение — значение cast(…) (с ним сравнивается составное свойство).
Функция НовыйТип(Вид)
	Тип0 = Новый Структура;
	Тип0.Вставить("Вид", Вид);
	Тип0.Вставить("Длина", 0);
	Тип0.Вставить("ЧастиДаты", "");
	Тип0.Вставить("ТипСсылки", Неопределено);
	Тип0.Вставить("Набор", Неопределено);
	Тип0.Вставить("Навигация", Ложь);
	Тип0.Вставить("Перечисление", "");
	Тип0.Вставить("Имя", "");
	Тип0.Вставить("Приведение", Ложь);
	// Поле, по которому 1С на самом деле упорядочивает это поле (Код плана счетов — Порядок); "" — само поле.
	Тип0.Вставить("ПолеПорядка", "");
	Возврат Тип0;
КонецФункции

Функция Выражение2(Текст, Тип0)
	Возврат Новый Структура("Текст, Тип, Литерал", Текст, Тип0, Неопределено);
КонецФункции

// Тип свойства модели; Набор — набор, которому принадлежит свойство.
Функция ТипСвойства(Свойство, Набор, Модель)
	Если Свойство.Вид = "Ключ" Тогда
		Тип0 = НовыйТип("Ссылка");
		Тип0.ТипСсылки = Тип(Набор.ИмяТипаСсылки);
		Тип0.Набор = НаборПоИмени(Модель, ?(Набор.Вид = "ТабличнаяЧасть", Набор.Родитель, Набор.Имя));
	ИначеЕсли Свойство.Вид = "Ссылка" Тогда
		Тип0 = НовыйТип("Ссылка");
		Тип0.ТипСсылки = Свойство.ТипСсылки;
		Тип0.Набор = НаборПоИмени(Модель, Свойство.ЦелевойНабор);
	ИначеЕсли Свойство.Вид = "Перечисление" Тогда
		Тип0 = НовыйТип("Перечисление");
		Тип0.Перечисление = Свойство.Перечисление;
	ИначеЕсли Свойство.Вид = "ВидДвижения" Тогда
		Тип0 = НовыйТип("ВидДвижения");
		Тип0.Перечисление = Свойство.Перечисление;
	ИначеЕсли Свойство.Вид = "Составной" Или Свойство.Вид = "Хранилище" Тогда
		Тип0 = НовыйТип(Свойство.Вид);
	ИначеЕсли Свойство.ЧастиДаты <> "" Тогда
		Тип0 = НовыйТип("Дата");
		Тип0.ЧастиДаты = Свойство.ЧастиДаты;
	ИначеЕсли Свойство.ТипEdm = "Edm.String" Тогда
		Тип0 = НовыйТип("Строка");
		Тип0.Длина = Свойство.Длина;
	ИначеЕсли Свойство.ТипEdm = "Edm.Boolean" Тогда
		Тип0 = НовыйТип("Булево");
	ИначеЕсли Свойство.ТипEdm = "Edm.Guid" Тогда
		Тип0 = НовыйТип("Гуид");
	Иначе
		Тип0 = НовыйТип("Число");
	КонецЕсли;
	Тип0.Имя = Свойство.Имя;
	Если Свойство.Поле = "Код" И СтрНачинаетсяС(Набор.ТаблицаЗапроса, "ПланСчетов.") Тогда
		// 1С упорядочивает код счёта по полю Порядок (проба p1-order: «УПОРЯДОЧИТЬ ПО Код» ставит «000»
		// после «99.1»), а «Код > &М» сравнивает строки: порядок и метка продолжения — по Порядок.
		Тип0.ПолеПорядка = "Порядок";
	КонецЕсли;
	Возврат Тип0;
КонецФункции

// Тип литерала без второго операнда; ошибка — Отказ и тип «Ошибка».
Функция ТипЛитерала(Литерал, Контекст)
	ТипL = Литерал.type;
	Если ТипL = "Edm.String" Тогда
		Тип0 = НовыйТип("Строка");
		Тип0.Длина = Макс(1, СтрДлина(Литерал.value));
	ИначеЕсли ЭтоЧисловойЛитерал(ТипL) Тогда
		Тип0 = НовыйТип("Число");
	ИначеЕсли ТипL = "Edm.Boolean" Тогда
		Тип0 = НовыйТип("Булево");
	ИначеЕсли ТипL = "Edm.Guid" Тогда
		Тип0 = НовыйТип("Гуид");
	ИначеЕсли ТипL = "Edm.Date" Тогда
		Тип0 = НовыйТип("Дата");
		Тип0.ЧастиДаты = "Дата";
	ИначеЕсли ТипL = "Edm.TimeOfDay" Тогда
		Тип0 = НовыйТип("Дата");
		Тип0.ЧастиДаты = "Время";
	ИначеЕсли ТипL = "Edm.DateTimeOffset" Или ТипL = "Edm.DateTime" Тогда
		Тип0 = НовыйТип("Дата");
		Тип0.ЧастиДаты = "ДатаВремя";
	ИначеЕсли ТипL = "null" Тогда
		Тип0 = НовыйТип("Null");
	ИначеЕсли ТипL = "Edm.Binary" Или ТипL = "Edm.Duration" Тогда
		Возврат Отказ(Контекст, "Литерал не поддерживается: " + ТипL, 501).Тип;
	Иначе
		Возврат Отказ(Контекст, "Литерал перечисления без свойства перечисления: " + ТипL + "'" + Литерал.value + "'").Тип;
	КонецЕсли;
	Возврат Тип0;
КонецФункции

// Имя типа для сообщений.
Функция ИмяТипа(Тип0)
	Вид = Тип0.Вид;
	Если Вид = "Строка" Тогда
		Возврат "Edm.String";
	ИначеЕсли Вид = "Число" Тогда
		Возврат "Edm.Decimal";
	ИначеЕсли Вид = "Булево" Или Вид = "Условие" Тогда
		Возврат "Edm.Boolean";
	ИначеЕсли Вид = "Гуид" Или Вид = "Ссылка" Тогда
		Возврат "Edm.Guid";
	ИначеЕсли Вид = "ВидДвижения" Тогда
		Возврат "Edm.String";
	ИначеЕсли Вид = "Перечисление" Тогда
		Возврат "StandardODATA." + Тип0.Перечисление;
	ИначеЕсли Вид = "Дата" Тогда
		Возврат OData4_Сериализация.ТипДаты(Тип0.ЧастиДаты);
	КонецЕсли;
	Возврат Вид;
КонецФункции

Функция ИмяВыражения(Выр)
	Если Выр.Литерал <> Неопределено Тогда
		Возврат Выр.Литерал.type;
	ИначеЕсли Выр.Тип.Имя <> "" Тогда
		Возврат Выр.Тип.Имя;
	КонецЕсли;
	Возврат Выр.Текст;
КонецФункции

// Значение литерала для параметра запроса по типу второго операнда; ошибка — Отказ и Неопределено.
Функция ЗначениеЛитерала(Литерал, Тип0, Контекст)
	ТипL = Литерал.type;
	Значение = Литерал.value;
	Вид = Тип0.Вид;
	Если Вид = "Строка" И ТипL = "Edm.String" Тогда
		Возврат Значение;
	ИначеЕсли Вид = "Число" И ЭтоЧисловойЛитерал(ТипL) Тогда
		Возврат ЧислоИзЛитерала(Значение, Контекст);
	ИначеЕсли Вид = "Булево" И ТипL = "Edm.Boolean" Тогда
		Возврат Значение = "true";
	ИначеЕсли Вид = "Дата" И ЭтоЛитералДаты(ТипL) Тогда
		Возврат ДатаИзЛитерала(Литерал, Контекст);
	ИначеЕсли Вид = "Гуид" И ТипL = "Edm.Guid" Тогда
		Возврат Новый УникальныйИдентификатор(Значение);
	ИначеЕсли Вид = "Ссылка" И ТипL = "Edm.Guid" Тогда
		Возврат XMLЗначение(Тип0.ТипСсылки, Значение);
	ИначеЕсли Вид = "Перечисление" И (ТипL = "Edm.String" Или Не СтрНачинаетсяС(ТипL, "Edm.") И ТипL <> "null") Тогда
		Если ТипL <> "Edm.String" И ТипL <> "StandardODATA." + Тип0.Перечисление Тогда
			Отказ(Контекст, СтрШаблон("Литерал %1 несовместим с типом %2", ТипL, ИмяТипа(Тип0)));
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЗначениеПеречисления(Тип0.Перечисление, Значение, Контекст);
	ИначеЕсли Вид = "ВидДвижения" И ТипL = "Edm.String" Тогда
		Значение0 = OData4_Сериализация.ВидДвиженияПоИмени(Тип0.Перечисление, Значение);
		Если Значение0 = Неопределено Тогда
			Отказ(Контекст, СтрШаблон("Неизвестное значение %1: %2",
				?(Тип0.Перечисление = "ВидСчета", "Type", "RecordType"), Значение));
			Возврат Неопределено;
		КонецЕсли;
		Возврат Значение0;
	ИначеЕсли Вид = "Литерал" Тогда
		ТипЗначения = ТипЛитерала(Литерал, Контекст);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат ЗначениеЛитерала(Литерал, ТипЗначения, Контекст);
	КонецЕсли;
	Отказ(Контекст, СтрШаблон("Литерал %1 несовместим с типом %2", ТипL, ИмяТипа(Тип0)));
	Возврат Неопределено;
КонецФункции

Функция ЗначениеПеречисления(ИмяПеречисления, ИмяЗначения, Контекст)
	ОбъектМетаданных = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если ОбъектМетаданных = Неопределено Или ОбъектМетаданных.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		Отказ(Контекст, СтрШаблон("Перечисление %1 не содержит значение %2", ИмяПеречисления, ИмяЗначения));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];
КонецФункции

Функция ЭтоЧисловойЛитерал(ТипL)
	Возврат ТипL = "Edm.Int64" Или ТипL = "Edm.Decimal" Или ТипL = "Edm.Double" Или ТипL = "Edm.Single";
КонецФункции

Функция ЭтоЛитералДаты(ТипL)
	Возврат ТипL = "Edm.Date" Или ТипL = "Edm.DateTimeOffset" Или ТипL = "Edm.DateTime" Или ТипL = "Edm.TimeOfDay";
КонецФункции

// Число из текста литерала: знак, целая и дробная части, порядок e±N. Модуль не меньше 10^38 (столько
// цифр не принимает запрос) или порядок больше 400 по модулю — Отказ и Неопределено.
Функция ЧислоИзЛитерала(Текст, Контекст)
	Мантисса = Текст;
	Порядок0 = 0;
	ПозицияE = СтрНайти(Текст, "e");
	Если ПозицияE > 0 Тогда
		Мантисса = Лев(Текст, ПозицияE - 1);
		ТекстПорядка = Сред(Текст, ПозицияE + 1);
		Множитель = 1;
		Если Лев(ТекстПорядка, 1) = "-" Или Лев(ТекстПорядка, 1) = "+" Тогда
			Множитель = ?(Лев(ТекстПорядка, 1) = "-", -1, 1);
			ТекстПорядка = Сред(ТекстПорядка, 2);
		КонецЕсли;
		Пока СтрДлина(ТекстПорядка) > 1 И Лев(ТекстПорядка, 1) = "0" Цикл
			ТекстПорядка = Сред(ТекстПорядка, 2);
		КонецЦикла;
		// Порядок без ведущих нулей длиннее 4 цифр заведомо больше 400: берутся первые 4 цифры и умножаются
		// на 10 — результат ≥ 10000 (дальше Отказ), а Число не разбирает сколь угодно длинный текст.
		Порядок0 = Множитель * Число(Лев(ТекстПорядка, 4)) * ?(СтрДлина(ТекстПорядка) > 4, 10, 1);
	КонецЕсли;
	Результат = Число(Мантисса);
	Если Результат = 0 Тогда
		Возврат 0;
	ИначеЕсли Порядок0 > 400 Или Порядок0 < -400 Тогда
		Отказ(Контекст, "Число вне допустимого диапазона: " + Текст);
		Возврат Неопределено;
	КонецЕсли;
	Пока Порядок0 > 0 Цикл
		Результат = Результат * 10;
		Порядок0 = Порядок0 - 1;
	КонецЦикла;
	Пока Порядок0 < 0 Цикл
		Результат = Результат / 10;
		Порядок0 = Порядок0 + 1;
	КонецЦикла;
	Если Макс(Результат, -Результат) >= 100000000000000000000000000000000000000 Тогда
		Отказ(Контекст, "Число вне допустимого диапазона: " + Текст);
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Дата литерала в поясе базы. Edm.DateTimeOffset в строгом режиме переводится из своего смещения
// в пояс базы; в совместимом режиме и у Edm.DateTime (v3) время берётся как есть. Доли секунды отбрасываются.
// Момент в первые или последние сутки допустимого диапазона дат со смещением — Отказ и Неопределено
// (перевод поясов вышел бы за диапазон).
Функция ДатаИзЛитерала(Литерал, Контекст)
	Текст = Литерал.value;
	Если Литерал.type = "Edm.TimeOfDay" Тогда
		Возврат Дата(1, 1, 1, Число(Сред(Текст, 1, 2)), Число(Сред(Текст, 4, 2)),
			?(Сред(Текст, 6, 1) = ":", Число(Сред(Текст, 7, 2)), 0));
	КонецЕсли;
	Результат = Дата(Число(Сред(Текст, 1, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)));
	Если СтрДлина(Текст) = 10 Тогда
		Возврат Результат;
	КонецЕсли;
	Результат = Результат + Число(Сред(Текст, 12, 2)) * 3600 + Число(Сред(Текст, 15, 2)) * 60
		+ ?(Сред(Текст, 17, 1) = ":", Число(Сред(Текст, 18, 2)), 0);
	Если Литерал.type <> "Edm.DateTimeOffset" Или OData4_Сериализация.РежимДат() = "Совместимый" Тогда
		Возврат Результат;
	КонецЕсли;
	Если Результат < Дата(1, 1, 2) Или Результат >= Дата(9999, 12, 31) Тогда
		Отказ(Контекст, "Дата вне допустимого диапазона: " + Текст);
		Возврат Неопределено;
	КонецЕсли;
	Смещение = 0;
	Если Прав(Текст, 1) <> "Z" Тогда
		Зона = Прав(Текст, 6);
		Смещение = (Число(Сред(Зона, 2, 2)) * 3600 + Число(Сред(Зона, 5, 2)) * 60) * ?(Лев(Зона, 1) = "-", -1, 1);
	КонецЕсли;
	Возврат МестноеВремя(Результат - Смещение, OData4_ПовтИспВызова.ЧасовойПоясБазы());
КонецФункции

// Выражение-операнд с типом: литерал становится параметром по типу Тип0.
Функция Операнд(Выр, Тип0, Контекст)
	Если Выр.Литерал = Неопределено Тогда
		Возврат Выр;
	КонецЕсли;
	Если Выр.Литерал.type = "null" Тогда
		Возврат Отказ(Контекст, "Литерал null здесь не допускается");
	КонецЕсли;
	ТипЗначения = ?(Тип0.Вид = "Литерал", ТипЛитерала(Выр.Литерал, Контекст), Тип0);
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	Значение = ЗначениеЛитерала(Выр.Литерал, ТипЗначения, Контекст);
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	Возврат Выражение2(ДобавитьПараметр(Контекст, Значение), ТипЗначения);
КонецФункции

// Операнд ожидаемого вида: литерал — параметром этого вида, выражение — проверка вида.
Функция ОперандВида(Выр, Вид, Контекст, Где)
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	Если Выр.Литерал <> Неопределено Тогда
		Тип0 = НовыйТип(Вид);
		Если Вид = "Строка" И Выр.Литерал.type = "Edm.String" Тогда
			Тип0.Длина = Макс(1, СтрДлина(Выр.Литерал.value));
		КонецЕсли;
		Возврат Операнд(Выр, Тип0, Контекст);
	КонецЕсли;
	Если Выр.Тип.Вид = "Условие" И Вид = "Булево" Тогда
		Возврат Выражение2(КакЗначение(Выр), НовыйТип("Булево"));
	КонецЕсли;
	Если Выр.Тип.Вид <> Вид Тогда
		Возврат Отказ(Контекст, СтрШаблон("%1: ожидалось значение типа %2, получено %3", Где, ИмяТипа(НовыйТип(Вид)),
			ИмяТипа(Выр.Тип)));
	КонецЕсли;
	Возврат Выр;
КонецФункции

// Путь к свойству: через навигационные свойства — разыменование «Т.Реквизит.Поле».
Функция Путь(Узел, Контекст)
	Модель = Контекст.Модель;
	Если Узел.variable = "" Тогда
		Область = Контекст.Области[0];
		Текст = Контекст.ПрефиксКорня;
		БезПрефикса = Текст = "";
	Иначе
		Область = Неопределено;
		Для Каждого Кандидат Из Контекст.Области Цикл
			Если Кандидат.Переменная = Узел.variable Тогда
				Область = Кандидат;
			КонецЕсли;
		КонецЦикла;
		Если Область = Неопределено Тогда
			Возврат Отказ(Контекст, "Неизвестная переменная: " + Узел.variable);
		КонецЕсли;
		Текст = Область.Префикс;
		Если Узел.segments.Количество() = 0 Тогда
			Возврат Отказ(Контекст, "Строка табличной части целиком в выражении не поддерживается: " + Узел.variable);
		КонецЕсли;
	КонецЕсли;
	Набор = Область.Набор;
	Если Узел.segments.Количество() > 1 Тогда
		// Свойство результата groupby по навигационному пути называется путём целиком («Owner/Description»).
		Полное = СтрСоединить(Узел.segments, "/");
		Свойство = Набор.ПоИмени.Получить(Полное);
		Если Свойство <> Неопределено Тогда
			Тип0 = ТипСвойства(Свойство, Набор, Модель);
			Тип0.Имя = Полное;
			Возврат Выражение2(СоединитьПуть(Текст, Свойство.Поле), Тип0);
		КонецЕсли;
	КонецЕсли;
	Имена = Новый Массив;
	Последний = Узел.segments.ВГраница();
	// Условия отборов профиля целей пройденных навигаций (5.2): значение пути выдаётся, только если связанный объект
	// виден профилю, иначе NULL (решение контроллера: скрытые строки не видны и через навигацию).
	УсловияПути = Новый Массив;
	Начало = 0;
	Переходов = 0;
	Если Набор.Свойство("НавигацияГрупп") Тогда
		// Результат groupby по навигационному пути (groupby((Owner))): путь «Owner» — навигация к связанному
		// объекту, колонка группы — его ссылка; дальше путь идёт по целевому набору, как у набора сущностей.
		// Берётся самый длинный префикс пути, который — такая группа.
		Для Обратный = 0 По Последний Цикл
			Длина = Последний + 1 - Обратный;
			Части = Новый Массив;
			Для Индекс = 0 По Длина - 1 Цикл
				Части.Добавить(Узел.segments[Индекс]);
			КонецЦикла;
			Группа = Набор.НавигацияГрупп.Получить(СтрСоединить(Части, "/"));
			Если Группа = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Текст = СоединитьПуть(Текст, Группа.Поле);
			Для Каждого Часть Из Части Цикл
				Имена.Добавить(Часть);
			КонецЦикла;
			Если Длина = Последний + 1 Тогда
				Тип0 = ТипСвойства(Группа, Набор, Модель);
				Тип0.Навигация = Истина;
				Тип0.Имя = СтрСоединить(Имена, "/");
				Возврат Выражение2(Текст, Тип0);
			КонецЕсли;
			Переходов = Длина;
			Набор = НаборПоИмени(Модель, Группа.ЦелевойНабор, Контекст);
			Если Набор = Неопределено Тогда
				Возврат Отказ(Контекст, "Навигация в неопубликованный набор: " + СтрСоединить(Узел.segments, "/"));
			КонецЕсли;
			Если Не ДобавитьУсловиеПерехода(УсловияПути, Набор, Текст, Контекст) Тогда
				Возврат Сбой();
			КонецЕсли;
			Начало = Длина;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	Для Индекс = Начало По Последний Цикл
		Имя = Узел.segments[Индекс];
		Имена.Добавить(Имя);
		Свойство = Набор.ПоИмени.Получить(Имя);
		Если Свойство <> Неопределено Тогда
			Если Индекс < Последний Тогда
				Возврат Отказ(Контекст, "Свойство не навигационное: " + СтрСоединить(Узел.segments, "/"));
			ИначеЕсли Свойство.Поле = "" Тогда
				// Суррогатный ключ (SurrogateKey): поля в таблице 1С у него нет.
				Возврат Отказ(Контекст, "Свойство не хранится в базе: " + Набор.Имя + "." + Имя);
			ИначеЕсли Свойство.Вид = "ОписаниеТипов" Или Свойство.Вид = "ТипДокумента" Или Свойство.Вид = "ТочкаМаршрута" Тогда
				// Описание типов, тип документа журнала и точка маршрута выдаются представлением, а не значением поля.
				Возврат Отказ(Контекст, "Свойство не применяется в выражениях: " + Набор.Имя + "." + Имя);
			КонецЕсли;
			Тип0 = ТипСвойства(Свойство, Набор, Модель);
			Тип0.Имя = СтрСоединить(Имена, "/");
			Возврат ОбернутьПуть(Выражение2(СоединитьПуть(Текст, Свойство.Поле), Тип0), УсловияПути);
		КонецЕсли;
		Навигация = Набор.Навигация.Получить(Имя);
		Если Навигация <> Неопределено Тогда
			Текст = СоединитьПуть(Текст, Навигация.Поле);
			Если Индекс = Последний Тогда
				Тип0 = ТипСвойства(Навигация, Набор, Модель);
				Тип0.Навигация = Истина;
				Тип0.Имя = СтрСоединить(Имена, "/");
				Возврат ОбернутьПуть(Выражение2(Текст, Тип0), УсловияПути);
			КонецЕсли;
			Переходов = Переходов + 1;
			Если Переходов > МаксимумПереходовПути() Тогда
				// Каждый переход — неявное соединение в запросе: путь «Parent/Parent/…» из сотен сегментов дал бы
				// сотни соединений.
				Возврат Отказ(Контекст, "Путь длиннее " + Формат(МаксимумПереходовПути(), "ЧГ=0")
					+ " навигационных свойств: " + СтрСоединить(Имена, "/") + "/…");
			КонецЕсли;
			Набор = НаборПоИмени(Модель, Навигация.ЦелевойНабор, Контекст);
			Если Набор = Неопределено Тогда
				// Набор результата виртуальной таблицы ссылается и на неопубликованные наборы (план счетов).
				Возврат Отказ(Контекст, "Навигация в неопубликованный набор: " + СтрСоединить(Узел.segments, "/"));
			КонецЕсли;
			Если Не ДобавитьУсловиеПерехода(УсловияПути, Набор, Текст, Контекст) Тогда
				Возврат Сбой();
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		Если Набор.ТабличныеЧастиПоИмени.Получить(Имя) <> Неопределено Тогда
			Возврат Отказ(Контекст, "Коллекция в пути без any или all: " + СтрСоединить(Имена, "/"));
		ИначеЕсли Набор.Свойство("НеЗаполняются") И Набор.НеЗаполняются.Получить(Имя) = Истина Тогда
			// Свойство объявлено в типе результата виртуальной таблицы, но в строках его нет (Period оборотов).
			Возврат Отказ(Контекст, "Свойство не заполняется в результате функции: " + Набор.Имя + "." + Имя);
		КонецЕсли;
		Возврат Отказ(Контекст, "Свойство не найдено: " + Набор.Имя + "." + Имя);
	КонецЦикла;
	Возврат Отказ(Контекст, "Свойство не найдено: " + Набор.Имя);
КонецФункции

Функция Бинарное(Узел, Контекст)
	Оператор = Узел.op;
	Если Оператор = "and" Или Оператор = "or" Тогда
		// Левоассоциативная цепочка одного оператора — в одних скобках: вложенность скобок в тексте запроса
		// ограничена платформой, а цепочка «or» из сотни сравнений — обычный запрос клиента.
		Члены = Новый Массив;
		Текущий = Узел;
		Пока Текущий.kind = "binary" И Текущий.op = Оператор Цикл
			Члены.Вставить(0, Текущий.right);
			Текущий = Текущий.left;
		КонецЦикла;
		Члены.Вставить(0, Текущий);
		Тексты = Новый Массив;
		Для Каждого Член Из Члены Цикл
			Тексты.Добавить(УсловиеУзла(Член, Контекст));
		КонецЦикла;
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2("(" + СтрСоединить(Тексты, ?(Оператор = "and", " И ", " ИЛИ ")) + ")", НовыйТип("Условие"));
	ИначеЕсли Оператор = "has" Тогда
		Возврат Отказ(Контекст, "Оператор has не поддерживается", 501);
	КонецЕсли;
	Левое = ВыражениеУзла(Узел.left, Контекст);
	Правое = ВыражениеУзла(Узел.right, Контекст);
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	Если СтрРазделить("eq,ne,gt,ge,lt,le", ",").Найти(Оператор) <> Неопределено Тогда
		Возврат Сравнение(Оператор, Левое, Правое, Контекст);
	КонецЕсли;
	Возврат Арифметика(Оператор, Левое, Правое, Контекст);
КонецФункции

Функция Сравнение(Оператор, Левое, Правое, Контекст)
	ЛевоеNull = Левое.Литерал <> Неопределено И Левое.Литерал.type = "null";
	ПравоеNull = Правое.Литерал <> Неопределено И Правое.Литерал.type = "null";
	Если ЛевоеNull Или ПравоеNull Тогда
		Если Оператор <> "eq" И Оператор <> "ne" Тогда
			Возврат Отказ(Контекст, "Сравнение с null — только eq и ne");
		КонецЕсли;
		Если ЛевоеNull И ПравоеNull Тогда
			Возврат Отказ(Контекст, "Сравнение null с null");
		КонецЕсли;
		Текст = ЕстьNull(?(ЛевоеNull, Правое, Левое), Контекст);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2(?(Оператор = "eq", Текст, "НЕ " + Текст), НовыйТип("Условие"));
	КонецЕсли;
	Если Левое.Тип.Вид = "Составной" Или Правое.Тип.Вид = "Составной" Тогда
		Возврат СравнениеСоставного(Оператор, Левое, Правое, Контекст);
	КонецЕсли;
	Если Левое.Тип.Вид = "Условие" Тогда
		Левое = Выражение2(КакЗначение(Левое), НовыйТип("Булево"));
	КонецЕсли;
	Если Правое.Тип.Вид = "Условие" Тогда
		Правое = Выражение2(КакЗначение(Правое), НовыйТип("Булево"));
	КонецЕсли;
	ПроверитьСторону(Оператор, Левое, Контекст);
	ПроверитьСторону(Оператор, Правое, Контекст);
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	Если Левое.Литерал <> Неопределено И Правое.Литерал = Неопределено Тогда
		Левое = Операнд(Левое, Правое.Тип, Контекст);
	ИначеЕсли Правое.Литерал <> Неопределено И Левое.Литерал = Неопределено Тогда
		Правое = Операнд(Правое, Левое.Тип, Контекст);
	Иначе
		Левое = Операнд(Левое, Левое.Тип, Контекст);
		Правое = Операнд(Правое, Правое.Тип, Контекст);
	КонецЕсли;
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	ПроверитьСторону(Оператор, Левое, Контекст);
	ПроверитьСторону(Оператор, Правое, Контекст);
	ПроверитьСовместимость(Левое, Правое, Контекст);
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	ТекстЛевого = Левое.Текст;
	ТекстПравого = Правое.Текст;
	Если Левое.Тип.Вид = "Перечисление" И Оператор <> "eq" И Оператор <> "ne" Тогда
		ТекстЛевого = ПорядокПеречисления(Левое, Контекст);
		ТекстПравого = ПорядокПеречисления(Правое, Контекст);
	КонецЕсли;
	Знаки = Новый Структура("eq, ne, gt, ge, lt, le", "=", "<>", ">", ">=", "<", "<=");
	Возврат Выражение2(ТекстЛевого + " " + Знаки[Оператор] + " " + ТекстПравого, НовыйТип("Условие"));
КонецФункции

// Сравнение составного свойства (субконто, регистратор, значение субконто): только eq и ne, как у standard.odata.
// Второй операнд — значение cast(…) (ссылка или значение перечисления) или литерал примитивного типа —
// параметр своего типа (ExtDimension1 eq 'x' — строки, где значение — такая строка; standard.odata так же).
// GUID без cast не говорит, чья это ссылка, — 400 (standard.odata — 500 из СУБД).
Функция СравнениеСоставного(Оператор, Левое, Правое, Контекст)
	СоставноеСлева = Левое.Тип.Вид = "Составной";
	Составное = ?(СоставноеСлева, Левое, Правое);
	Другое = ?(СоставноеСлева, Правое, Левое);
	Если Оператор <> "eq" И Оператор <> "ne" Тогда
		Возврат Отказ(Контекст, "Составное свойство сравнивается только eq и ne: " + ИмяВыражения(Составное));
	ИначеЕсли Другое.Литерал <> Неопределено И Другое.Литерал.type = "Edm.Guid" Тогда
		Возврат Отказ(Контекст, "GUID сравнивается с составным свойством только через cast(guid'…','Набор'): "
			+ ИмяВыражения(Составное));
	ИначеЕсли Другое.Литерал <> Неопределено Тогда
		Другое = Операнд(Другое, НовыйТип("Литерал"), Контекст);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
	ИначеЕсли Не Другое.Тип.Приведение Тогда
		Возврат Отказ(Контекст, "Сравнение составного свойства не поддерживается: " + ИмяВыражения(Составное), 501);
	КонецЕсли;
	Знак = ?(Оператор = "eq", " = ", " <> ");
	Текст = ?(СоставноеСлева, Составное.Текст + Знак + Другое.Текст, Другое.Текст + Знак + Составное.Текст);
	Возврат Выражение2(Текст, НовыйТип("Условие"));
КонецФункции

// Порядок значения перечисления: у выражения — поле Порядок; у параметра-значения — тот же параметр,
// значение которого заменяется индексом значения в перечислении.
Функция ПорядокПеречисления(Выр, Контекст)
	Если СтрНачинаетсяС(Выр.Текст, "&") Тогда
		Имя = Сред(Выр.Текст, 2);
		Значение = Контекст.Параметры[Имя];
		Контекст.Параметры[Имя] = Перечисления[Выр.Тип.Перечисление].Индекс(Значение);
		Возврат Выр.Текст;
	КонецЕсли;
	Возврат Выр.Текст + ".Порядок";
КонецФункции

// Сторона сравнения, которую нельзя сравнивать этим оператором, — Отказ.
Процедура ПроверитьСторону(Оператор, Сторона, Контекст)
	Если Сторона.Литерал <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Вид = Сторона.Тип.Вид;
	Если Вид = "Составной" Тогда
		Отказ(Контекст, "Сравнение составного свойства не поддерживается: " + ИмяВыражения(Сторона), 501);
	ИначеЕсли Вид = "Хранилище" Тогда
		Отказ(Контекст, "Хранилище значения нельзя сравнивать: " + ИмяВыражения(Сторона));
	ИначеЕсли Вид = "Строка" И Сторона.Тип.Длина = 0 Тогда
		Отказ(Контекст, "Строку неограниченной длины нельзя сравнивать: " + ИмяВыражения(Сторона));
	ИначеЕсли Вид = "ВидДвижения" И Оператор <> "eq" И Оператор <> "ne" Тогда
		Отказ(Контекст, "Значения RecordType сравниваются только eq и ne");
	ИначеЕсли Вид = "Булево" И Оператор <> "eq" И Оператор <> "ne" Тогда
		Отказ(Контекст, "Значения Edm.Boolean сравниваются только eq и ne");
	КонецЕсли;
КонецПроцедуры

Процедура ПроверитьСовместимость(Левое, Правое, Контекст)
	Если Левое.Тип.Вид <> Правое.Тип.Вид
		Или Левое.Тип.Вид = "Перечисление" И Левое.Тип.Перечисление <> Правое.Тип.Перечисление Тогда
		Отказ(Контекст, СтрШаблон("Несравнимые типы: %1 и %2", ИмяТипа(Левое.Тип), ИмяТипа(Правое.Тип)));
	КонецЕсли;
КонецПроцедуры

// Условие «значение пусто» для eq null: NULL, а также пустые значения, которые в JSON выдаются как null —
// пустая дата в строгом режиме, пустое значение перечисления, пустая ссылка навигационного свойства.
Функция ЕстьNull(Выр, Контекст)
	Если Выр.Литерал <> Неопределено Тогда
		Отказ(Контекст, "Сравнение литерала с null");
		Возврат "";
	ИначеЕсли Выр.Тип.Вид = "Условие" Тогда
		Отказ(Контекст, "Сравнение условия с null");
		Возврат "";
	КонецЕсли;
	Тип0 = Выр.Тип;
	Если Тип0.Вид = "Дата" И OData4_Сериализация.РежимДат() = "Строгий" Тогда
		Возврат "(" + Выр.Текст + " ЕСТЬ NULL ИЛИ " + Выр.Текст + " = ДАТАВРЕМЯ(1, 1, 1))";
	ИначеЕсли Тип0.Вид = "Перечисление" И Метаданные.Перечисления[Тип0.Перечисление].ЗначенияПеречисления.Количество() > 0 Тогда
		Пустое = ДобавитьПараметр(Контекст, Перечисления[Тип0.Перечисление].ПустаяСсылка());
		Возврат "(" + Выр.Текст + " ЕСТЬ NULL ИЛИ " + Выр.Текст + " = " + Пустое + ")";
	ИначеЕсли Тип0.Вид = "Ссылка" И Тип0.Навигация Тогда
		Пустое = ДобавитьПараметр(Контекст, XMLЗначение(Тип0.ТипСсылки, "00000000-0000-0000-0000-000000000000"));
		Возврат "(" + Выр.Текст + " ЕСТЬ NULL ИЛИ " + Выр.Текст + " = " + Пустое + ")";
	КонецЕсли;
	Возврат Выр.Текст + " ЕСТЬ NULL";
КонецФункции

Функция Арифметика(Оператор, Левое, Правое, Контекст)
	Если СтрРазделить("add,sub,mul,div,divby,mod", ",").Найти(Оператор) = Неопределено Тогда
		Возврат Отказ(Контекст, "Неизвестный оператор: " + Оператор);
	КонецЕсли;
	Если Левое.Тип.Вид = "Дата" Или Правое.Тип.Вид = "Дата" Тогда
		Возврат Отказ(Контекст, "Арифметика с датами не поддерживается", 501);
	КонецЕсли;
	Где = "Оператор " + Оператор;
	Левое = ОперандВида(Левое, "Число", Контекст, Где);
	Правое = ОперандВида(Правое, "Число", Контекст, Где);
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	А = Левое.Текст;
	Б = Правое.Текст;
	// div и mod повторяют операнды в тексте (mod: А дважды, Б трижды): цепочка удваивает текст на каждом
	// уровне. Длина проверяется до сборки текста.
	Если СтрДлина(А) * 2 + СтрДлина(Б) * 3 > 50000 Тогда
		Возврат Отказ(Контекст, "Слишком длинное выражение");
	КонецЕсли;
	Если Оператор = "add" Тогда
		Текст = "(" + А + " + " + Б + ")";
	ИначеЕсли Оператор = "sub" Тогда
		Текст = "(" + А + " - " + Б + ")";
	ИначеЕсли Оператор = "mul" Тогда
		Текст = "(" + А + " * " + Б + ")";
	ИначеЕсли Оператор = "div" Или Оператор = "divby" Тогда
		Текст = "(ВЫБОР КОГДА " + Б + " = 0 ТОГДА NULL ИНАЧЕ " + А + " / " + Б + " КОНЕЦ)";
	Иначе
		Если Не ПроверитьФункцию("ЦЕЛ", "mod", Контекст) Тогда
			Возврат Сбой();
		КонецЕсли;
		Текст = "(ВЫБОР КОГДА " + Б + " = 0 ТОГДА NULL ИНАЧЕ " + А + " - ЦЕЛ(" + А + " / " + Б + ") * " + Б + " КОНЕЦ)";
	КонецЕсли;
	Возврат Выражение2(Текст, НовыйТип("Число"));
КонецФункции

Функция Унарное(Узел, Контекст)
	Операнд0 = ВыражениеУзла(Узел.operand, Контекст);
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	Если Узел.op = "not" Тогда
		Текст = КакУсловие(Операнд0, Контекст);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2("НЕ (" + Текст + ")", НовыйТип("Условие"));
	КонецЕсли;
	Операнд0 = ОперандВида(Операнд0, "Число", Контекст, "Унарный минус");
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	Возврат Выражение2("(-" + Операнд0.Текст + ")", НовыйТип("Число"));
КонецФункции

Функция ВхождениеВСписок(Узел, Контекст)
	Левое = ВыражениеУзла(Узел.operand, Контекст);
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	ИначеЕсли Левое.Литерал <> Неопределено Тогда
		Возврат Отказ(Контекст, "Левая часть in — литерал");
	КонецЕсли;
	Если Левое.Тип.Вид = "Условие" Тогда
		Левое = Выражение2(КакЗначение(Левое), НовыйТип("Булево"));
	КонецЕсли;
	ПроверитьСторону("eq", Левое, Контекст);
	ВсеЛитералы = Истина;
	Элементы = Новый Массив;
	Для Каждого Элемент Из Узел.items Цикл
		Выр = ВыражениеУзла(Элемент, Контекст);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		ИначеЕсли Выр.Литерал <> Неопределено И Выр.Литерал.type = "null" Тогда
			Возврат Отказ(Контекст, "null в списке in не поддерживается");
		КонецЕсли;
		ВсеЛитералы = ВсеЛитералы И Выр.Литерал <> Неопределено;
		Элементы.Добавить(Выр);
	КонецЦикла;
	Если ВсеЛитералы Тогда
		Значения = Новый Массив;
		Для Каждого Выр Из Элементы Цикл
			Значения.Добавить(ЗначениеЛитерала(Выр.Литерал, Левое.Тип, Контекст));
			Если Контекст.Ошибка <> Неопределено Тогда
				Возврат Сбой();
			КонецЕсли;
		КонецЦикла;
		Возврат Выражение2(Левое.Текст + " В (" + ДобавитьПараметр(Контекст, Значения) + ")", НовыйТип("Условие"));
	КонецЕсли;
	Тексты = Новый Массив;
	Для Каждого Выр Из Элементы Цикл
		ПроверитьСторону("eq", Выр, Контекст);
		Правое = Операнд(Выр, Левое.Тип, Контекст);
		Если Контекст.Ошибка = Неопределено Тогда
			ПроверитьСовместимость(Левое, Правое, Контекст);
		КонецЕсли;
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Тексты.Добавить(Правое.Текст);
	КонецЦикла;
	Возврат Выражение2(Левое.Текст + " В (" + СтрСоединить(Тексты, ", ") + ")", НовыйТип("Условие"));
КонецФункции

// Условие из выражения: логическое поле или параметр допустимы как условие; ошибка — Отказ и "".
Функция КакУсловие(Выр, Контекст)
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат "";
	ИначеЕсли Выр.Литерал <> Неопределено Тогда
		Если Выр.Литерал.type <> "Edm.Boolean" Тогда
			Отказ(Контекст, "Ожидалось логическое выражение");
		Иначе
			Отказ(Контекст, "Литерал " + Выр.Литерал.value + " вместо условия");
		КонецЕсли;
		Возврат "";
	ИначеЕсли Выр.Тип.Вид <> "Условие" И Выр.Тип.Вид <> "Булево" Тогда
		Отказ(Контекст, "Ожидалось логическое выражение");
		Возврат "";
	КонецЕсли;
	Возврат Выр.Текст;
КонецФункции

// Логическое значение из условия (для сравнения условия с true/false).
Функция КакЗначение(Выр)
	Возврат "ВЫБОР КОГДА " + Выр.Текст + " ТОГДА ИСТИНА ИНАЧЕ ЛОЖЬ КОНЕЦ";
КонецФункции

#КонецОбласти

#Область Функции

// Функции $filter → язык запросов. Функции, которых нет на платформе (OData4_МодельПовтИсп.ДоступныеФункции),
// и функции без соответствия (fractionalseconds, geo.*, matchesPattern …) — 501 с именем функции.
// Рекурсия без исключений: ошибка — Отказ, дальше Сбой() (см. Условие).
Функция ВызовФункции(Узел, Контекст)
	Имя = Узел.name;
	Аргументы = Новый Массив;
	Для Каждого Аргумент Из Узел.args Цикл
		Аргументы.Добавить(ВыражениеУзла(Аргумент, Контекст));
	КонецЦикла;
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	Где = "Функция " + Имя;
	Если Имя = "contains" Или Имя = "startswith" Или Имя = "endswith" Тогда
		Строка0 = ОперандВида(Аргументы[0], "Строка", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Образец = Аргументы[1];
		Если Образец.Литерал = Неопределено Или Образец.Литерал.type <> "Edm.String" Тогда
			Возврат Отказ(Контекст, Где + ": второй аргумент — только строковый литерал", 501);
		КонецЕсли;
		Шаблон = ЭкранироватьПодобно(Образец.Литерал.value);
		Шаблон = ?(Имя = "startswith", "", "%") + Шаблон + ?(Имя = "endswith", "", "%");
		Возврат Выражение2(Строка0.Текст + " ПОДОБНО " + ДобавитьПараметр(Контекст, Шаблон) + " СПЕЦСИМВОЛ ""~""",
			НовыйТип("Условие"));
	ИначеЕсли Имя = "length" Тогда
		Если Не ПроверитьФункцию("ДЛИНАСТРОКИ", Имя, Контекст) Тогда
			Возврат Сбой();
		КонецЕсли;
		Строка0 = ОперандВида(Аргументы[0], "Строка", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2("ДЛИНАСТРОКИ(" + Строка0.Текст + ")", НовыйТип("Число"));
	ИначеЕсли Имя = "tolower" Или Имя = "toupper" Или Имя = "trim" Тогда
		ФункцияЯзыка = ?(Имя = "tolower", "НРЕГ", ?(Имя = "toupper", "ВРЕГ", "СОКРЛП"));
		Если Не ПроверитьФункцию(ФункцияЯзыка, Имя, Контекст) Тогда
			Возврат Сбой();
		КонецЕсли;
		Строка0 = ОперандВида(Аргументы[0], "Строка", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2(ФункцияЯзыка + "(" + Строка0.Текст + ")", ТипСтроки(Строка0.Тип.Длина));
	ИначеЕсли Имя = "indexof" Тогда
		Если Не ПроверитьФункцию("СТРНАЙТИ", Имя, Контекст) Тогда
			Возврат Сбой();
		КонецЕсли;
		Строка0 = ОперандВида(Аргументы[0], "Строка", Контекст, Где);
		Искомое = ОперандВида(Аргументы[1], "Строка", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2("(СТРНАЙТИ(" + Строка0.Текст + ", " + Искомое.Текст + ") - 1)", НовыйТип("Число"));
	ИначеЕсли Имя = "substring" Тогда
		Строка0 = ОперандВида(Аргументы[0], "Строка", Контекст, Где);
		Начало = ОперандВида(Аргументы[1], "Число", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		// Длину результата платформа знает, только если длина подстроки — число или параметр; с выражением
		// (ДЛИНАСТРОКИ) результат считается строкой неограниченной длины, и сравнивать его нельзя.
		Длина0 = Строка0.Тип.Длина;
		Если Аргументы.Количество() = 3 Тогда
			Если Аргументы[2].Литерал = Неопределено Тогда
				Длина0 = 0;
			КонецЕсли;
			ДлинаТекст = ОперандВида(Аргументы[2], "Число", Контекст, Где).Текст;
		ИначеЕсли Длина0 > 0 Тогда
			// До конца строки: длина из модели — не больше длины самого свойства.
			ДлинаТекст = Формат(Длина0, "ЧГ=0");
		ИначеЕсли Не ПроверитьФункцию("ДЛИНАСТРОКИ", Имя, Контекст) Тогда
			Возврат Сбой();
		// Текст первого аргумента повторяется: без предела длины вложенные substring растили бы текст вдвое.
		ИначеЕсли Не ПроверитьДлину(Контекст, 2 * СтрДлина(Строка0.Текст) + 40) Тогда
			Возврат Сбой();
		Иначе
			ДлинаТекст = "ДЛИНАСТРОКИ(" + Строка0.Текст + ")";
		КонецЕсли;
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2("ПОДСТРОКА(" + Строка0.Текст + ", " + Начало.Текст + " + 1, " + ДлинаТекст + ")",
			ТипСтроки(Длина0));
	ИначеЕсли Имя = "concat" Тогда
		Первая = ОперандВида(Аргументы[0], "Строка", Контекст, Где);
		Вторая = ОперандВида(Аргументы[1], "Строка", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Длина0 = ?(Первая.Тип.Длина = 0 Или Вторая.Тип.Длина = 0, 0, Первая.Тип.Длина + Вторая.Тип.Длина);
		Возврат Выражение2("(" + Первая.Текст + " + " + Вторая.Текст + ")", ТипСтроки(Длина0));
	ИначеЕсли СтрРазделить("year,month,day,hour,minute,second", ",").Найти(Имя) <> Неопределено Тогда
		ЧастиФункций = Новый Структура("year, month, day, hour, minute, second",
			"ГОД", "МЕСЯЦ", "ДЕНЬ", "ЧАС", "МИНУТА", "СЕКУНДА");
		Дата0 = ОперандВида(Аргументы[0], "Дата", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2(ЧастиФункций[Имя] + "(" + Дата0.Текст + ")", НовыйТип("Число"));
	ИначеЕсли Имя = "date" Тогда
		Дата0 = ОперандВида(Аргументы[0], "Дата", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2("НАЧАЛОПЕРИОДА(" + Дата0.Текст + ", ДЕНЬ)", ТипДаты0("Дата"));
	ИначеЕсли Имя = "time" Тогда
		Дата0 = ОперандВида(Аргументы[0], "Дата", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		// Текст аргумента повторяется: предел длины до сборки текста (см. Арифметика).
		ИначеЕсли Не ПроверитьДлину(Контекст, 2 * СтрДлина(Дата0.Текст) + 90) Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2("ДОБАВИТЬКДАТЕ(ДАТАВРЕМЯ(1, 1, 1), СЕКУНДА, РАЗНОСТЬДАТ(НАЧАЛОПЕРИОДА(" + Дата0.Текст
			+ ", ДЕНЬ), " + Дата0.Текст + ", СЕКУНДА))", ТипДаты0("Время"));
	ИначеЕсли Имя = "now" Тогда
		Возврат Выражение2(ДобавитьПараметр(Контекст, ТекущаяДатаСеанса()), ТипДаты0("ДатаВремя"));
	ИначеЕсли Имя = "round" Тогда
		Если Не ПроверитьФункцию("ОКР", Имя, Контекст) Тогда
			Возврат Сбой();
		КонецЕсли;
		Числовой = ОперандВида(Аргументы[0], "Число", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Возврат Выражение2("ОКР(" + Числовой.Текст + ", 0)", НовыйТип("Число"));
	ИначеЕсли Имя = "floor" Или Имя = "ceiling" Тогда
		Если Не ПроверитьФункцию("ЦЕЛ", Имя, Контекст) Тогда
			Возврат Сбой();
		КонецЕсли;
		Числовой = ОперандВида(Аргументы[0], "Число", Контекст, Где);
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
		Х = Числовой.Текст;
		// Текст аргумента повторяется трижды: предел длины до сборки текста (см. Арифметика).
		Если Не ПроверитьДлину(Контекст, 3 * СтрДлина(Х) + 70) Тогда
			Возврат Сбой();
		КонецЕсли;
		Если Имя = "floor" Тогда
			Текст = "(ЦЕЛ(" + Х + ") - ВЫБОР КОГДА " + Х + " < ЦЕЛ(" + Х + ") ТОГДА 1 ИНАЧЕ 0 КОНЕЦ)";
		Иначе
			Текст = "(ЦЕЛ(" + Х + ") + ВЫБОР КОГДА " + Х + " > ЦЕЛ(" + Х + ") ТОГДА 1 ИНАЧЕ 0 КОНЕЦ)";
		КонецЕсли;
		Возврат Выражение2(Текст, НовыйТип("Число"));
	КонецЕсли;
	Возврат Отказ(Контекст, "Функция не поддерживается: " + Имя, 501);
КонецФункции

// cast(литерал, 'Тип') — параметр-значение этого типа: cast(guid'…', 'Catalog_X') — ссылка (тип по имени, как
// в standard.odata, см. OData4_Модель.ТипПоИмениТипа), cast('Член', 'Перечисление') — значение перечисления.
// С ним сравнивается составное свойство (ExtDimension1 eq cast(…)), ссылочное свойство и перечисление.
// Приведение к примитивному типу Edm, приведение выражения и cast(Тип) без выражения — 501.
Функция Приведение(Узел, Контекст)
	Операнд0 = Узел.operand;
	ИмяТипа0 = Узел.type;
	Если Операнд0 = Неопределено Или Операнд0.kind <> "literal" Или СтрНачинаетсяС(ИмяТипа0, "Edm.") Тогда
		Возврат Отказ(Контекст, "Функция не поддерживается: cast", 501);
	КонецЕсли;
	Описание = OData4_Модель.ТипПоИмениТипа(ИмяТипа0);
	НаборЦели = Неопределено;
	Если Описание <> Неопределено И Описание.Перечисление = "" Тогда
		// Ссылочный тип — только набора модели запроса (отзыв безопасности): скрытый профилем или составом набор —
		// та же ошибка, что несуществующий тип, иначе cast отвечал бы, есть ли такой объект в конфигурации.
		НаборЦели = НаборПоИмени(Контекст.Модель, Сред(Описание.ИмяТипа, 15), Контекст);
	КонецЕсли;
	Если Описание = Неопределено Или Описание.Перечисление = "" И НаборЦели = Неопределено Тогда
		Возврат Отказ(Контекст, "Неизвестный тип в cast: " + ИмяТипа0);
	КонецЕсли;
	ТипL = Операнд0.type;
	Если Описание.Перечисление <> "" И ТипL = "Edm.String" Тогда
		Значение = ЗначениеПеречисления(Описание.Перечисление, Операнд0.value, Контекст);
		Тип0 = НовыйТип("Перечисление");
		Тип0.Перечисление = Описание.Перечисление;
	ИначеЕсли Описание.Перечисление = "" И ТипL = "Edm.Guid" Тогда
		Значение = XMLЗначение(Описание.Тип, Операнд0.value);
		Тип0 = НовыйТип("Ссылка");
		Тип0.ТипСсылки = Описание.Тип;
		Тип0.Набор = НаборЦели;
	Иначе
		Возврат Отказ(Контекст, СтрШаблон("Литерал %1 несовместим с типом %2", ТипL, Описание.ИмяТипа));
	КонецЕсли;
	Если Контекст.Ошибка <> Неопределено Тогда
		Возврат Сбой();
	КонецЕсли;
	Тип0.Имя = "cast";
	Тип0.Приведение = Истина;
	Возврат Выражение2(ДобавитьПараметр(Контекст, Значение), Тип0);
КонецФункции

// Экранирование шаблона ПОДОБНО спецсимволом «~».
Функция ЭкранироватьПодобно(Текст)
	Результат = СтрЗаменить(Текст, "~", "~~");
	Для Каждого Спецсимвол Из СтрРазделить("%,_,[,],^", ",") Цикл
		Результат = СтрЗаменить(Результат, Спецсимвол, "~" + Спецсимвол);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ТипСтроки(Длина0)
	Тип0 = НовыйТип("Строка");
	Тип0.Длина = Длина0;
	Возврат Тип0;
КонецФункции

Функция ТипДаты0(Части)
	Тип0 = НовыйТип("Дата");
	Тип0.ЧастиДаты = Части;
	Возврат Тип0;
КонецФункции

// Ложь и Отказ, если текст выражения после сборки стал бы слишком длинным (см. Арифметика).
Функция ПроверитьДлину(Контекст, Длина)
	Если Длина > 50000 Тогда
		Отказ(Контекст, "Слишком длинное выражение");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// any и all по табличной части: подзапрос по строкам; путь без переменной внутри условия — свойство
// владельца через «Лn.Ссылка» (подзапрос не опирается на псевдонимы внешнего запроса).
Функция Лямбда(Узел, Контекст)
	Коллекция = Узел.collection;
	Корень = Контекст.Области[0];
	Если Коллекция.variable <> "" Или Коллекция.segments.Количество() <> 1 Тогда
		Возврат Отказ(Контекст, "any и all применяются только к табличной части: "
			+ СтрСоединить(Коллекция.segments, "/"));
	КонецЕсли;
	ИмяТЧ = Корень.Набор.ТабличныеЧастиПоИмени.Получить(Коллекция.segments[0]);
	Если ИмяТЧ = Неопределено Тогда
		Возврат Отказ(Контекст, "any и all применяются только к табличной части: " + Коллекция.segments[0]);
	КонецЕсли;
	Если Корень.Набор.Вид = "Шаг" Тогда
		// Строки шага $apply сохраняют табличные части (решение 22), но свойства владельца внутри условия
		// берутся через «Лn.Ссылка», а у строки шага они — колонки временной таблицы.
		Возврат Отказ(Контекст, "any и all после шагов $apply не поддерживаются: " + Коллекция.segments[0], 501);
	КонецЕсли;
	ТЧ = НаборПоИмени(Контекст.Модель, ИмяТЧ, Контекст);
	Контекст.Подзапросов = Контекст.Подзапросов + 1;
	Псевдоним = "Л" + Формат(Контекст.Подзапросов, "ЧГ=0");
	ВнешнийПрефикс = Контекст.ПрефиксКорня;
	// Поле связи строк с владельцем: «Ссылка» у табличной части, «Регистратор» у записей набора по регистратору.
	ПолеВладельца = ?(Корень.Набор.ПолеСвязи = "", "Ссылка", Корень.Набор.ПолеСвязи);
	// У набора по регистратору свойства владельца (Recorder) — поля самой записи, а не разыменование ссылки.
	ПоляВладельцаВСтроке = Корень.Набор.Вид = "НаборЗаписей";
	// Ссылка владельца: у корня набора — «Т.Ссылка», внутри лямбды префикс корня уже «Лk.Ссылка».
	СсылкаВладельца = ?(Контекст.Области.Количество() = 1 Или ПоляВладельцаВСтроке,
		ВнешнийПрефикс + "." + ПолеВладельца, ВнешнийПрефикс);
	Условие0 = "";
	Если Узел.predicate <> Неопределено Тогда
		Контекст.Области.Добавить(Новый Структура("Переменная, Набор, Префикс", Узел.variable, ТЧ, Псевдоним));
		Контекст.ПрефиксКорня = ?(ПоляВладельцаВСтроке, Псевдоним, Псевдоним + "." + ПолеВладельца);
		Условие0 = УсловиеУзла(Узел.predicate, Контекст);
		Контекст.ПрефиксКорня = ВнешнийПрефикс;
		Контекст.Области.Удалить(Контекст.Области.ВГраница());
		Если Контекст.Ошибка <> Неопределено Тогда
			Возврат Сбой();
		КонецЕсли;
	ИначеЕсли Узел.op = "all" Тогда
		Возврат Отказ(Контекст, "all применяется только с условием");
	КонецЕсли;
	Подзапрос = "ВЫБРАТЬ " + Псевдоним + "." + ПолеВладельца + " ИЗ " + OData4_Модель.ТаблицаЧтения(ТЧ) + " КАК " + Псевдоним;
	// Записи коллекции, скрытые отбором профиля (5.2), в any и all не участвуют; строки табличной части видимого
	// владельца видны все.
	УсловияПрофиля = Новый Массив;
	Если ТЧ.Вид <> "ТабличнаяЧасть" И Не ДобавитьУсловиеПерехода(УсловияПрофиля, ТЧ, Псевдоним, Контекст) Тогда
		Возврат Сбой();
	КонецЕсли;
	Если Узел.op = "any" Тогда
		Если Условие0 <> "" Тогда
			УсловияПрофиля.Добавить(Условие0);
		КонецЕсли;
		Если УсловияПрофиля.Количество() > 0 Тогда
			Подзапрос = Подзапрос + " ГДЕ " + СтрСоединить(УсловияПрофиля, " И ");
		КонецЕсли;
		Возврат Выражение2(СсылкаВладельца + " В (" + Подзапрос + ")", НовыйТип("Условие"));
	КонецЕсли;
	// Пустая табличная часть удовлетворяет all: нет строки, нарушающей условие.
	УсловияПрофиля.Добавить("НЕ (" + Условие0 + ")");
	Возврат Выражение2("НЕ " + СсылкаВладельца + " В (" + Подзапрос + " ГДЕ " + СтрСоединить(УсловияПрофиля, " И ") + ")",
		НовыйТип("Условие"));
КонецФункции

// Ложь и Отказ (501), если функции языка запросов нет на этой платформе.
Функция ПроверитьФункцию(ФункцияЯзыка, ФункцияOData, Контекст)
	Если OData4_МодельПовтИсп.ДоступныеФункции().Получить(ФункцияЯзыка) <> Истина Тогда
		Отказ(Контекст, "Функция не поддерживается: " + ФункцияOData, 501);
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Ошибка400(Сообщение)
	OData4_Сервис.ОшибкаOData(400, "BadRequest", Сообщение);
КонецПроцедуры

Процедура Ошибка501(Сообщение)
	OData4_Сервис.ОшибкаOData(501, "NotImplemented", Сообщение);
КонецПроцедуры

Процедура ДобавитьИсточник(Строки, Выборка)
	Строки.Добавить("ИЗ");
	Строки.Добавить(Символы.Таб + ?(Выборка.Источник = "", Выборка.Таблица, Выборка.Источник)
		+ " КАК " + Выборка.Псевдоним);
	Для Каждого Соединение Из Выборка.Соединения Цикл
		Строки.Добавить(Символы.Таб + Символы.Таб + "ЛЕВОЕ СОЕДИНЕНИЕ " + Соединение.Таблица + " КАК " + Соединение.Псевдоним);
		Строки.Добавить(Символы.Таб + Символы.Таб + "ПО " + Соединение.Условие);
	КонецЦикла;
КонецПроцедуры

// Текст выборки без «РАЗРЕШЕННЫЕ» — для подзапроса-источника.
Функция ТекстВнутренней(Выборка)
	Возврат СтрЗаменить(ТекстВыборки(Выборка), "ВЫБРАТЬ РАЗРЕШЕННЫЕ", "ВЫБРАТЬ");
КонецФункции

// Поверхностная копия выборки со всеми полями: массивы общие с исходной, поэтому изменяемые
// поля копии присваиваются заново, а не меняются на месте.
Функция КопияВыборки(Выборка)
	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из Выборка Цикл
		Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции

Процедура ДобавитьУсловия(Строки, Условия)
	Если Условия.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Строки.Добавить("ГДЕ");
	Строки.Добавить(Символы.Таб + СтрСоединить(Условия, Символы.ПС + Символы.Таб + "И "));
КонецПроцедуры

// Наибольшее число переходов по навигационным свойствам в одном пути $filter, $orderby, $apply и Condition.
Функция МаксимумПереходовПути()
	Возврат 10;
КонецФункции

// Набор модели по имени с проверками профиля по месту (OData4_Безопасность.НаборМодели); в контексте отборов
// профиля (Контекст.БезПрофиля — выражения строятся по полной модели, решение 7 плана 5.2) — набор модели как есть.
Функция НаборПоИмени(Модель, Имя, Контекст = Неопределено)
	Если Контекст <> Неопределено И Контекст.Свойство("БезПрофиля") Тогда
		Возврат OData4_Модель.НайтиНабор(Модель, Имя);
	КонецЕсли;
	Возврат OData4_Безопасность.НаборМодели(Модель, Имя);
КонецФункции

// Условие отборов профиля цели навигации по пути до связанного объекта (Префикс) — в УсловияПути. Ложь и Отказ,
// если отбор профиля не переводится. Без исключений: вызывается из рекурсивного перевода.
Функция ДобавитьУсловиеПерехода(УсловияПути, Набор, Префикс, Контекст)
	Если Контекст.Свойство("БезПрофиля") Тогда
		Возврат Истина;
	КонецЕсли;
	Итог = OData4_Безопасность.УсловиеЦелиНавигации(Контекст.Параметры, Набор, Префикс);
	Если Итог.Ошибка <> Неопределено Тогда
		Отказ(Контекст, Итог.Ошибка, 500);
		Возврат Ложь;
	КонецЕсли;
	Если Итог.Текст <> "" Тогда
		УсловияПути.Добавить(Итог.Текст);
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Значение пути через навигации к наборам с отборами профиля: «ВЫБОР КОГДА <условия целей> ТОГДА <значение>
// ИНАЧЕ NULL КОНЕЦ». Без условий — выражение как есть (тексты запросов без профиля не меняются).
Функция ОбернутьПуть(Выр, УсловияПути)
	Если УсловияПути.Количество() = 0 Тогда
		Возврат Выр;
	КонецЕсли;
	Выр.Текст = "ВЫБОР КОГДА " + СтрСоединить(УсловияПути, " И ") + " ТОГДА " + Выр.Текст + " ИНАЧЕ NULL КОНЕЦ";
	Возврат Выр;
КонецФункции

// Путь поля: «Т.Поле», а при пустом префиксе (условие внутри скобок виртуальной таблицы) — «Поле».
Функция СоединитьПуть(Префикс, Поле)
	Возврат ?(Префикс = "", Поле, Префикс + "." + Поле);
КонецФункции

#КонецОбласти
