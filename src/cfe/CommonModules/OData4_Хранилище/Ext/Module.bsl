#Область ПрограммныйИнтерфейс

// Выполняет запрос к хранилищу расширения (настройки, состав, снимок, профили, токены, счётчики) на пути запроса.
// Гонка сеанса HTTP-сервиса платформы (сеанс в начале или на границе 20 с простоя, решение 19 этапа 4) даёт
// «Таблица не найдена» или «Тип не определен» на таблицах расширения: такая ошибка повторяется до 3 раз с паузами
// (всего не больше 200 мс, решение контроллера 5.2); иная ошибка и ошибка после повторов — исключение, как у
// Запрос.Выполнить(): вызывающий берёт прежнее значение сеанса или отвечает 503.
Функция ВыполнитьЗапрос(Запрос) Экспорт
	Паузы = Паузы();
	Для Номер = 0 По Паузы.ВГраница() Цикл
		Попытка
			Возврат Запрос.Выполнить();
		Исключение
			Если Не ЭтоГонкаСеанса(ИнформацияОбОшибке()) Тогда
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
		Подождать(Паузы[Номер]);
	КонецЦикла;
	Возврат Запрос.Выполнить();
КонецФункции

// То же для пакета запросов.
Функция ВыполнитьПакетЗапроса(Запрос) Экспорт
	Паузы = Паузы();
	Для Номер = 0 По Паузы.ВГраница() Цикл
		Попытка
			Возврат Запрос.ВыполнитьПакет();
		Исключение
			Если Не ЭтоГонкаСеанса(ИнформацияОбОшибке()) Тогда
				ВызватьИсключение;
			КонецЕсли;
		КонецПопытки;
		Подождать(Паузы[Номер]);
	КонецЦикла;
	Возврат Запрос.ВыполнитьПакет();
КонецФункции

// Ошибка — гонка сеанса платформы: таблица или тип расширения временно не найдены.
Функция ЭтоГонкаСеанса(Информация) Экспорт
	Текст = ПодробноеПредставлениеОшибки(Информация);
	Возврат СтрНайти(Текст, "Таблица не найдена") > 0 Или СтрНайти(Текст, "Тип не определен") > 0;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Паузы перед повторами, мс: всего 200.
Функция Паузы()
	Результат = Новый Массив;
	Результат.Добавить(40);
	Результат.Добавить(60);
	Результат.Добавить(100);
	Возврат Результат;
КонецФункции

// Пауза без внешних средств (в безопасном режиме приостановка потока недоступна): ожидание по часам.
Процедура Подождать(Миллисекунд)
	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Миллисекунд;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
