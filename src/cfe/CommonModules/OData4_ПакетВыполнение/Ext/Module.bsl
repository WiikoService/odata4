#Область ПрограммныйИнтерфейс

// Выполнение $batch (этап 7, часть 7.2). Разбор тела и сборка ответа — OData4_Пакет (часть 7.1); здесь — маршрут,
// лимиты, выполнение операций в процессе тем же конвейером, что одиночные запросы (OData4_Сервис.ВыполнитьОперацию:
// без входа, CORS и журнала), наборы изменений в одной транзакции, ссылки $<Content-ID>, продолжение после ошибки
// (Prefer: odata.continue-on-error) и записи журнала операций.

// Запрос к ресурсу $batch: путь «/v4/$batch» (у токена в пути — после OData4_Безопасность.ЗапросСТокеномВПути).
Функция ЭтоПакет(Запрос) Экспорт
	Путь = OData4_Безопасность.ПутьРесурса(Запрос.ОтносительныйURL);
	Возврат Путь = "$batch" Или НРег(Путь) = "%24batch";
КонецФункции

// Выполняет запрос $batch после входа (OData4_Безопасность.Войти, один на пакет). До выполнения операций, по порядку:
// метод (не POST — 405), размер тела (больше настройки НаибольшийРазмерBatchМБ — 413, тело не разбирается), разбор
// (OData4_Пакет.РазобратьПакет: 400, 415), число операций (больше НаибольшееЧислоОпераций — 400 с фактом), наборы
// изменений и ссылки (ПроверитьПакет — 400), частота (OData4_Безопасность.ПроверитьЧастотуПакета — 429). Отказ —
// исключением OData4_Сервис.ОшибкаOData: ответ и запись журнала пакета — у вызывающего. Затем операции
// (ВыполнитьОперации) и ответ OData4_Пакет.ОтветПакета. Итог: Строк — число операций пакета; Пакет — UUID строкой,
// общий для записи журнала пакета и записей его операций.
Функция ВыполнитьПакет(Запрос, Итог, ИмяСервиса) Экспорт
	Итог.Вставить("Пакет", Строка(Новый УникальныйИдентификатор));
	Метод = ВРег(Запрос.HTTPМетод);
	Если Метод <> "POST" Тогда
		OData4_БезопасностьВызов.Контекст().ЗаголовкиОтвета.Вставить("Allow", "POST, OPTIONS");
		OData4_Сервис.ОшибкаOData(405, "MethodNotAllowed", "Ресурс $batch принимает только метод POST, а не " + Метод);
	КонецЕсли;
	Тело = ТелоВПределах(Запрос, НаибольшийРазмерТела());
	ТипСодержимого = OData4_Безопасность.ЗначениеЗаголовка(Запрос, "Content-Type");
	ПроверитьВерсиюФормата(ТипСодержимого, OData4_Безопасность.ЗначениеЗаголовка(Запрос, "OData-MaxVersion"));
	// Частей multipart заведомо больше лимита — 400 до разбора (тело не режется на строки).
	Наибольшее = НаибольшееЧислоОпераций();
	НеМеньше = OData4_Пакет.НижняяОценкаЧислаОпераций(ТипСодержимого, Тело);
	Если НеМеньше > Наибольшее Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Число операций в $batch больше " + Формат(Наибольшее, "ЧН=0; ЧГ=0")
			+ ": не меньше " + Формат(НеМеньше, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Разбор = OData4_Пакет.РазобратьПакет(ТипСодержимого, Тело);
	ЧислоОпераций = Разбор.Операции.Количество();
	Итог.Строк = ЧислоОпераций;
	// Уровень журнала «Запись»: запись самого пакета — только если в нём есть операция изменения (наблюдение Н3 приёмки 7).
	Итог.Вставить("ЗаписьВПакете", ЕстьИзменение(Разбор));
	ПроверитьЧислоОпераций(ЧислоОпераций, Наибольшее);
	ПроверитьПакет(Разбор);
	OData4_Безопасность.ПроверитьЧастотуПакета(ЧислоОпераций);
	Продолжать = ПредпочтениеПродолжать(OData4_Безопасность.ЗначениеЗаголовка(Запрос, "Prefer"));
	ТокенПути = "";
	Если ТипЗнч(Запрос) = Тип("Структура") Тогда
		Запрос.Свойство("ТокенПути", ТокенПути);
	КонецЕсли;
	Основа = НоваяОснова(Запрос.БазовыйURL, ?(ТокенПути = Неопределено, "", ТокенПути), ИмяСервиса, Итог.Пакет,
		Продолжать <> "");
	Основа.Вставить("Хосты", ХостыСервиса(Запрос));
	Результаты = ВыполнитьОперации(Разбор, Основа);
	Ответ = OData4_Пакет.ОтветПакета(Разбор, Результаты);
	Если Продолжать <> "" Тогда
		Ответ.Заголовки.Вставить("Preference-Applied", Продолжать);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Основа выполнения операций пакета: Структура «БазовыйURL, Корни, Сервис, Пакет, Продолжать». БазовыйURL — как у
// запроса $batch (у токена в пути — с «/t/<токен>»): от него строятся ссылки ответов операций; Корни — КорниСервиса;
// Пакет — UUID записей журнала; Продолжать — выполнять операции и после ошибки (odata.continue-on-error).
Функция НоваяОснова(БазовыйURL, ТокенПути, ИмяСервиса, Пакет, Продолжать) Экспорт
	Возврат Новый Структура("БазовыйURL, Корни, Сервис, Пакет, Продолжать", БазовыйURL,
		КорниСервиса(БазовыйURL, ТокенПути), ИмяСервиса, Пакет, Продолжать);
КонецФункции

// Выполняет операции разобранного пакета (Разбор — результат OData4_Пакет.РазобратьПакет, уже проверенный
// ПроверитьПакет) и возвращает Результаты для OData4_Пакет.ОтветПакета: Массив Структура «Ид, Набор, Статус,
// Заголовки, Тело, ОтказНабора» в порядке выполнения. Операция вне набора изменений — сама по себе; ошибка (статус
// 400 и выше) останавливает пакет, если не Основа.Продолжать. Набор изменений (подряд идущие операции с одним Набор) —
// одна транзакция: первая ошибка откатывает весь набор (см. ВыполнитьНабор). Записи журнала операций пишутся после
// операции, а в наборе — после его фиксации или отката, вне транзакции набора.
Функция ВыполнитьОперации(Разбор, Основа) Экспорт
	Состояние = Новый Структура("Адреса, Статусы, Иды, Снимок, Наборы", Новый Соответствие, Новый Соответствие,
		Новый Соответствие, OData4_Запись.СнимокВызова(), Новый Соответствие);
	Для Каждого Операция Из Разбор.Операции Цикл
		Если Операция.Ид <> "" Тогда
			Состояние.Иды.Вставить(Операция.Ид, Истина);
			Состояние.Наборы.Вставить(Операция.Ид, Операция.Набор);
		КонецЕсли;
	КонецЦикла;
	Результаты = Новый Массив;
	Операции = Разбор.Операции;
	Индекс = 0;
	Пока Индекс < Операции.Количество() Цикл
		Операция = Операции[Индекс];
		Если Операция.Набор = "" Тогда
			Выполненная = ВыполнитьОдну(Операция, Основа, Состояние);
			Результаты.Добавить(Выполненная.Результат);
			OData4_Журнал.Записать(Выполненная.Журнал);
			Успех = Выполненная.Результат.Статус < 400;
			Индекс = Индекс + 1;
		Иначе
			Группа = Новый Массив;
			Пока Индекс < Операции.Количество() И Операции[Индекс].Набор = Операция.Набор Цикл
				Группа.Добавить(Операции[Индекс]);
				Индекс = Индекс + 1;
			КонецЦикла;
			Успех = ВыполнитьНабор(Группа, Операция.Набор, Основа, Состояние, Результаты, Разбор.Формат);
		КонецЕсли;
		Если Не Успех И Не Основа.Продолжать Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	// Запись пакета в журнале — без операции и заголовков последней операции.
	ПодготовитьВызов(Состояние.Снимок);
	Возврат Результаты;
КонецФункции

// Проверки пакета до выполнения (400 всего пакета): операции набора изменений идут подряд; в наборе — только методы
// изменения данных и действий (GET и иные — 400, спецификация OData); Content-ID не повторяется; dependsOn ссылается на
// предшествующую операцию или набор (либо на свой набор).
Процедура ПроверитьПакет(Разбор) Экспорт
	Изменения = СтрРазделить("POST,PUT,PATCH,MERGE,DELETE", ",");
	Закрытые = Новый Соответствие;
	Известные = Новый Соответствие;
	Иды = Новый Соответствие;
	Текущий = "";
	Номер = 0;
	Для Каждого Операция Из Разбор.Операции Цикл
		Номер = Номер + 1;
		Если Операция.Набор <> Текущий Тогда
			Если Текущий <> "" Тогда
				Закрытые.Вставить(Текущий, Истина);
			КонецЕсли;
			Если Операция.Набор <> "" И Закрытые.Получить(Операция.Набор) <> Неопределено Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "Операции набора изменений «" + Операция.Набор
					+ "» идут не подряд (операция " + ПредставлениеОперации(Операция, Номер) + ")");
			КонецЕсли;
			Текущий = Операция.Набор;
		КонецЕсли;
		Если Операция.Набор <> "" И Изменения.Найти(ВРег(Операция.Метод)) = Неопределено Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Метод " + Операция.Метод + " внутри набора изменений «"
				+ Операция.Набор + "» (операция " + ПредставлениеОперации(Операция, Номер)
				+ "): в наборе допустимы только изменения данных и действия");
		КонецЕсли;
		Если Операция.Ид <> "" Тогда
			Если Иды.Получить(Операция.Ид) <> Неопределено Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "Content-ID «" + Операция.Ид + "» повторяется в $batch");
			КонецЕсли;
			Иды.Вставить(Операция.Ид, Истина);
		КонецЕсли;
		Если Операция.Набор <> "" Тогда
			Известные.Вставить(Операция.Набор, Истина);
		КонецЕсли;
		Для Каждого Зависимость Из Операция.ЗависитОт Цикл
			Если Известные.Получить(Зависимость) = Неопределено Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "dependsOn операции " + ПредставлениеОперации(Операция, Номер)
					+ ": нет предшествующей операции или набора «" + Строка(Зависимость) + "»");
			КонецЕсли;
		КонецЦикла;
		Если Операция.Ид <> "" Тогда
			Известные.Вставить(Операция.Ид, Истина);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// JSON batch — формат OData 4.01: клиент с OData-MaxVersion ниже 4.01 его ответ не примет — 400 до разбора
// (дефект Д1 приёмки 7). Multipart и запрос без OData-MaxVersion — без проверки.
Процедура ПроверитьВерсиюФормата(ТипСодержимого, НаибольшаяВерсия) Экспорт
	Вид = НРег(СокрЛП(СтрРазделить(ТипСодержимого + ";", ";")[0]));
	Если Вид <> "application/json" Или СокрЛП(НаибольшаяВерсия) = "" Тогда
		Возврат;
	КонецЕсли;
	Части = СтрРазделить(СокрЛП(НаибольшаяВерсия) + ".", ".");
	Старшая = ЧислоВерсии(Части[0]);
	Младшая = ЧислоВерсии(Части[1]);
	Если Старшая = Неопределено Или Младшая = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверный заголовок OData-MaxVersion: " + НаибольшаяВерсия);
	КонецЕсли;
	Если Старшая < 4 Или Старшая = 4 И Младшая < 1 Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "JSON batch — формат OData 4.01, а OData-MaxVersion запроса "
			+ СокрЛП(НаибольшаяВерсия) + "; для OData 4.0 используйте multipart/mixed");
	КонецЕсли;
КонецПроцедуры

// Есть ли в пакете операция изменения данных или действие (метод не GET).
Функция ЕстьИзменение(Разбор) Экспорт
	Для Каждого Операция Из Разбор.Операции Цикл
		Если ВРег(Операция.Метод) <> "GET" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Наибольшее число операций пакета: настройка (0 и меньше — 100), а профиль (ОперацийBatch > 0) — если он строже.
Функция ЛимитОпераций(Настройка, Профиль) Экспорт
	Лимит = ?(ТипЗнч(Настройка) = Тип("Число") И Настройка > 0, Настройка, 100);
	Если ТипЗнч(Профиль) = Тип("Число") И Профиль > 0 И Профиль < Лимит Тогда
		Лимит = Профиль;
	КонецЕсли;
	Возврат Лимит;
КонецФункции

// Больше Наибольшее операций — 400 с фактом.
Процедура ПроверитьЧислоОпераций(ЧислоОпераций, Наибольшее) Экспорт
	Если ЧислоОпераций > Наибольшее Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Число операций в $batch больше " + Формат(Наибольшее, "ЧН=0; ЧГ=0")
			+ ": " + Формат(ЧислоОпераций, "ЧН=0; ЧГ=0"));
	КонецЕсли;
КонецПроцедуры

// Предпочтение продолжения после ошибки из значения заголовка Prefer: имя, как его передал клиент
// («odata.continue-on-error» или «continue-on-error» OData 4.01), для Preference-Applied; нет или «=false» — "".
Функция ПредпочтениеПродолжать(Предпочтения) Экспорт
	Для Каждого Часть Из СтрРазделить(Предпочтения, ",", Ложь) Цикл
		Предпочтение = СокрЛП(СтрРазделить(Часть + ";", ";")[0]);
		Равно = СтрНайти(Предпочтение, "=");
		Имя = СокрЛП(?(Равно = 0, Предпочтение, Лев(Предпочтение, Равно - 1)));
		Значение = НРег(СокрЛП(?(Равно = 0, "", Сред(Предпочтение, Равно + 1))));
		Если (НРег(Имя) = "odata.continue-on-error" Или НРег(Имя) = "continue-on-error") И Значение <> "false" Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Пути корня сервиса от корня хоста для адресов операций: «<путь БазовыйURL>/v4»; у токена в пути — ещё и тот же
// корень без «/t/<токен>» (тот же сервис, вход уже выполнен).
Функция КорниСервиса(БазовыйURL, ТокенПути = "") Экспорт
	Корни = Новый Массив;
	Путь = ПутьОтХоста(БазовыйURL);
	Пока СтрЗаканчиваетсяНа(Путь, "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;
	Корни.Добавить(Путь + "/v4");
	Хвост = "/t/" + ТокенПути;
	Если ТокенПути <> "" И СтрЗаканчиваетсяНа(Путь, Хвост) Тогда
		Корни.Добавить(Лев(Путь, СтрДлина(Путь) - СтрДлина(Хвост)) + "/v4");
	КонецЕсли;
	Возврат Корни;
КонецФункции

// Адрес операции относительно корня сервиса («Catalog_X(…)?$top=1», "" — служебный документ). Принимается адрес
// относительно корня сервиса, абсолютный («http://хост/…/v4/…») и от корня хоста («/…/v4/…») одного из Корни.
// Хосты (Соответствие «хост[:порт]» в нижнем регистре → Истина, см. ХостыСервиса; Неопределено — хост не
// сравнивается) — имена, под которыми сервис виден клиенту (адрес запроса, Host, X-Forwarded-Host, адреса публикации
// из настроек): абсолютный адрес другого хоста — Неопределено (отзыв безопасности, группа B: операция выполняется в
// этом сервисе и никуда не отправляется, но адрес чужого сервиса — ошибка клиента, а не молчаливая подмена). Путь
// другого корня — Неопределено.
Функция ОтносительныйАдрес(Адрес, Корни, Хосты = Неопределено) Экспорт
	Текст = СокрЛП(Адрес);
	Если ЭтоАбсолютныйАдрес(Текст) Тогда
		Если Хосты <> Неопределено И Хосты.Получить(ХостАдреса(Текст)) = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		Текст = ПутьОтХоста(Текст);
		Если Текст = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	Если Не СтрНачинаетсяС(Текст, "/") Тогда
		Возврат Текст;
	КонецЕсли;
	Нижний = НРег(Текст);
	Для Каждого Корень Из Корни Цикл
		КореньНРег = НРег(Корень);
		Длина = СтрДлина(КореньНРег);
		Если Нижний = КореньНРег Тогда
			Возврат "";
		ИначеЕсли СтрНачинаетсяС(Нижний, КореньНРег + "/") Тогда
			Возврат Сред(Текст, Длина + 2);
		ИначеЕсли СтрНачинаетсяС(Нижний, КореньНРег + "?") Тогда
			Возврат Сред(Текст, Длина + 1);
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Ссылка $<Content-ID> в начале адреса операции («$1», «$1/Товары», «$1?$select=…») → адрес сущности, созданной
// операцией с этим Content-ID (Адреса: Ид → путь от корня сервиса). Content-ID операции пакета без созданной
// сущности — 400; сущность есть, но недоступна этой операции (Недоступные: Ид → Истина, см. ДоступныеАдреса) — 400.
// Иной адрес (и «$metadata») — как есть.
Функция РазрешитьСсылку(Адрес, Адреса, Иды, Недоступные = Неопределено) Экспорт
	Если Не СтрНачинаетсяС(Адрес, "$") Тогда
		Возврат Адрес;
	КонецЕсли;
	Конец = СтрДлина(Адрес) + 1;
	Для Каждого Разделитель Из СтрРазделить("/,?", ",") Цикл
		Позиция = СтрНайти(Адрес, Разделитель);
		Если Позиция > 0 И Позиция < Конец Тогда
			Конец = Позиция;
		КонецЕсли;
	КонецЦикла;
	Ид = Сред(Адрес, 2, Конец - 2);
	Путь = Адреса.Получить(Ид);
	Если Путь <> Неопределено Тогда
		Возврат Путь + Сред(Адрес, Конец);
	КонецЕсли;
	Если Недоступные <> Неопределено И Недоступные.Получить(Ид) <> Неопределено Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Ссылка $" + Ид + ": сущность создана операцией вне набора изменений "
			+ "этой операции (ссылки $<Content-ID> действуют внутри набора изменений; в JSON batch — и на операции из "
			+ "dependsOn)");
	КонецЕсли;
	Если Иды.Получить(Ид) <> Неопределено Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Ссылка $" + Ид + ": операция с Content-ID «" + Ид
			+ "» не создала сущность");
	КонецЕсли;
	Возврат Адрес;
КонецФункции

// Тело операции с разрешёнными ссылками $<Content-ID> в значениях свойств «…@odata.bind» (строка или массив строк,
// на любой глубине): значение «$1» заменяется адресом сущности (РазрешитьСсылку). Остальной текст тела не меняется
// (тело не пересобирается из разобранного JSON). Обход — по тексту, без рекурсии.
Функция ПодставитьВТеле(Тело, Адреса, Иды, Недоступные = Неопределено) Экспорт
	Если ТипЗнч(Тело) <> Тип("Строка") Или СтрНайти(Тело, "@odata.bind") = 0 Или СтрНайти(Тело, """$") = 0 Тогда
		Возврат Тело;
	КонецЕсли;
	Части = Новый Массив;
	Длина = СтрДлина(Тело);
	Скопировано = 1;
	Позиция = 1;
	Привязка = Ложь;
	ВМассиве = Ложь;
	Пока Позиция <= Длина Цикл
		Знак = Сред(Тело, Позиция, 1);
		Если Знак = """" Тогда
			Конец = Позиция + 1;
			Пока Конец <= Длина Цикл
				ЗнакСтроки = Сред(Тело, Конец, 1);
				Если ЗнакСтроки = "\" Тогда
					Конец = Конец + 2;
					Продолжить;
				ИначеЕсли ЗнакСтроки = """" Тогда
					Прервать;
				КонецЕсли;
				Конец = Конец + 1;
			КонецЦикла;
			Содержимое = Сред(Тело, Позиция + 1, Конец - Позиция - 1);
			Следующая = Конец + 1;
			Пока Следующая <= Длина И ПустаяСтрока(Сред(Тело, Следующая, 1)) Цикл
				Следующая = Следующая + 1;
			КонецЦикла;
			Если Сред(Тело, Следующая, 1) = ":" Тогда
				Привязка = СтрЗаканчиваетсяНа(Содержимое, "@odata.bind");
				ВМассиве = Ложь;
			ИначеЕсли Привязка Тогда
				Если СтрНачинаетсяС(Содержимое, "$") Тогда
					Замена = РазрешитьСсылку(Содержимое, Адреса, Иды, Недоступные);
					Если Замена <> Содержимое Тогда
						Части.Добавить(Сред(Тело, Скопировано, Позиция - Скопировано));
						Части.Добавить(СтрокаJSON(Замена));
						Скопировано = Конец + 1;
					КонецЕсли;
				КонецЕсли;
				Привязка = ВМассиве;
			КонецЕсли;
			Позиция = Конец + 1;
			Продолжить;
		КонецЕсли;
		Если Привязка Тогда
			Если Знак = "[" И Не ВМассиве Тогда
				ВМассиве = Истина;
			ИначеЕсли Знак = "]" Тогда
				Привязка = Ложь;
				ВМассиве = Ложь;
			ИначеЕсли Не (Знак = ":" Или Знак = "," И ВМассиве Или ПустаяСтрока(Знак)) Тогда
				Привязка = Ложь;
				ВМассиве = Ложь;
			КонецЕсли;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Части.Добавить(Сред(Тело, Скопировано));
	Возврат СтрСоединить(Части, "");
КонецФункции

// Результат операции для OData4_Пакет.ОтветПакета из ответа конвейера: Структура «Ид, Набор, Статус, Заголовки
// (Соответствие), Тело (строка), ОтказНабора».
Функция РезультатОтвета(Операция, Ответ) Экспорт
	Заголовки = Новый Соответствие;
	Для Каждого КлючИЗначение Из Ответ.Заголовки Цикл
		Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	// Тело ответа сервиса — UTF-8 (OData4_Сериализация.ОтветТекст); у ответа без тела — пустые двоичные данные.
	Данные = Ответ.ПолучитьТелоКакДвоичныеДанные();
	Тело = ?(Данные = Неопределено Или Данные.Размер() = 0, "", ПолучитьСтрокуИзДвоичныхДанных(Данные, "UTF-8"));
	Возврат Новый Структура("Ид, Набор, Статус, Заголовки, Тело, ОтказНабора", Операция.Ид, Операция.Набор,
		Ответ.КодСостояния, Заголовки, Тело, Ложь);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Набор изменений (решение 6): одна транзакция 1С, проведение внутри разрешено. Код записи открывает и отменяет свои
// вложенные транзакции; после первой ошибки (статус 400 и выше) или сбоя фиксации транзакция отменяется целиком
// (Пока ТранзакцияАктивна()), ссылки $<Content-ID> на созданное в наборе сбрасываются. Результаты отказа — по
// контракту OData4_Пакет.ОтветПакета: multipart — одна запись с ошибкой; json — запись каждой операции набора
// (выполнявшая — со своей ошибкой, остальные — 424). В журнал операции набора пишутся после фиксации или отката:
// выполненные и отменённые откатом — со статусом 424. Возвращает Истина, если набор зафиксирован.
Функция ВыполнитьНабор(Группа, Набор, Основа, Состояние, Результаты, Формат0)
	Выполненные = Новый Массив;
	Отказ = Неопределено;
	НачатьТранзакцию();
	Попытка
		Для Каждого Операция Из Группа Цикл
			Выполненная = ВыполнитьОдну(Операция, Основа, Состояние);
			Выполненные.Добавить(Выполненная);
			Если Выполненная.Результат.Статус >= 400 Тогда
				Отказ = Выполненная;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Отказ = Неопределено Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	Исключение
		// Операции ловят свои исключения сами: сюда попадает сбой фиксации набора.
		ЗаписьЖурналаРегистрации("OData4.Пакет", УровеньЖурналаРегистрации.Ошибка, , ,
			"Набор изменений " + Набор + " не зафиксирован: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Если Выполненные.Количество() = 0 Тогда
			Выполненные.Добавить(Новый Структура("Операция, Результат, Журнал", Группа[0], Неопределено, Неопределено));
		КонецЕсли;
		Отказ = Выполненные[Выполненные.ВГраница()];
		Отказ.Результат = РезультатОшибки(Отказ.Операция, 500, "InternalError", OData4_Сервис.ТекстВнутреннейОшибки());
		Если Отказ.Журнал <> Неопределено Тогда
			Отказ.Журнал.Статус = 500;
			Отказ.Журнал.ТекстОшибки = OData4_Сервис.ТекстВнутреннейОшибки();
		КонецЕсли;
	КонецПопытки;
	Если Отказ = Неопределено Тогда
		Состояние.Статусы.Вставить(Набор, Истина);
		Для Каждого Выполненная Из Выполненные Цикл
			Результаты.Добавить(Выполненная.Результат);
			OData4_Журнал.Записать(Выполненная.Журнал);
		КонецЦикла;
		Возврат Истина;
	КонецЕсли;
	Пока ТранзакцияАктивна() Цикл
		ОтменитьТранзакцию();
	КонецЦикла;
	Состояние.Статусы.Вставить(Набор, Ложь);
	Текст424 = "Набор изменений «" + Набор + "» отменён: операция " + ПредставлениеОперации(Отказ.Операция, 0)
		+ " не выполнена";
	Для Каждого Выполненная Из Выполненные Цикл
		Если Выполненная.Операция.Ид <> "" Тогда
			Состояние.Адреса.Удалить(Выполненная.Операция.Ид);
			Состояние.Статусы.Вставить(Выполненная.Операция.Ид, Ложь);
		КонецЕсли;
		Если Выполненная.Журнал = Неопределено Тогда
			Продолжить;
		ИначеЕсли Выполненная <> Отказ Тогда
			Выполненная.Журнал.Статус = 424;
			Выполненная.Журнал.ТекстОшибки = Текст424;
		КонецЕсли;
		OData4_Журнал.Записать(Выполненная.Журнал);
	КонецЦикла;
	Отказ.Результат.ОтказНабора = Истина;
	Если Формат0 = "json" Тогда
		Для Каждого Операция Из Группа Цикл
			Если Операция = Отказ.Операция Тогда
				Результаты.Добавить(Отказ.Результат);
			Иначе
				Результат = РезультатОшибки(Операция, 424, "FailedDependency", Текст424);
				Результат.ОтказНабора = Истина;
				Результаты.Добавить(Результат);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Результаты.Добавить(Отказ.Результат);
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Одна операция тем же конвейером, что одиночный запрос (OData4_Сервис.ВыполнитьОперацию). Возвращает Структура
// «Операция, Результат, Журнал» (Журнал — контекст OData4_Журнал.Записать, ещё не записанный).
Функция ВыполнитьОдну(Операция, Основа, Состояние)
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Итог = Новый Структура("Строк, ТекстОшибки", 0, "");
	ПодготовитьВызов(Состояние.Снимок);
	Запрос = Неопределено;
	Невыполненная = НевыполненнаяЗависимость(Операция, Состояние);
	Если Невыполненная <> "" Тогда
		Итог.ТекстОшибки = "Операция зависит от невыполненной операции «" + Невыполненная + "»";
		Ответ = OData4_Сериализация.ОтветОшибки(424, "FailedDependency", Итог.ТекстОшибки);
	Иначе
		Попытка
			Запрос = ЗапросОперации(Операция, Основа, Состояние);
			Ответ = OData4_Сервис.ВыполнитьОперацию(Запрос, Итог);
		Исключение
			Ответ = OData4_Сервис.ОтветПоИсключению(ИнформацияОбОшибке(), Итог);
		КонецПопытки;
	КонецЕсли;
	Результат = РезультатОтвета(Операция, Ответ);
	Если Операция.Ид <> "" Тогда
		Состояние.Статусы.Вставить(Операция.Ид, Результат.Статус < 400);
		Если Результат.Статус < 300 Тогда
			ЗапомнитьАдрес(Операция.Ид, Результат.Заголовки, Основа, Состояние);
		КонецЕсли;
	КонецЕсли;
	Журнал = Новый Структура("Начало, Сервис, Метод, Путь, Параметры, Статус, Длительность, Строк, ТекстОшибки, Операция,
		|Объект, Пакет");
	Журнал.Начало = Начало;
	Журнал.Сервис = Основа.Сервис;
	Журнал.Метод = ВРег(Операция.Метод);
	Журнал.Путь = ?(Запрос = Неопределено, Операция.Адрес, Запрос.ОтносительныйURL);
	Журнал.Параметры = ?(Запрос = Неопределено, "", Запрос.ПараметрыЗапроса);
	Журнал.Статус = Результат.Статус;
	Журнал.Длительность = ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало;
	Журнал.Строк = Итог.Строк;
	Журнал.ТекстОшибки = Итог.ТекстОшибки;
	ОперацияЗаписи = OData4_Запись.ТекущаяОперация();
	Журнал.Операция = ?(ОперацияЗаписи = Неопределено, "", ОперацияЗаписи.Операция);
	Журнал.Объект = ?(ОперацияЗаписи = Неопределено, "", ОперацияЗаписи.Объект);
	Журнал.Пакет = Основа.Пакет;
	// Тело — только для маскировки его значений в тексте ошибки журнала (как у одиночного запроса); не хранится.
	Журнал.Вставить("Тело", Операция.Тело);
	Возврат Новый Структура("Операция, Результат, Журнал", Операция, Результат, Журнал);
КонецФункции

// Запрос операции для конвейера (поля, как у OData4_Безопасность.ЗапросСТокеномВПути): ссылка $<Content-ID> в начале
// адреса и в «…@odata.bind» тела разрешена, адрес приведён к пути сервиса («/v4/…», путь раскодирован, параметры —
// Соответствие раскодированных значений). Адрес чужого корня, вложенный $batch, неизвестный метод — 400/405 операции.
Функция ЗапросОперации(Операция, Основа, Состояние)
	Метод = ВРег(Операция.Метод);
	Если СтрРазделить("GET,POST,PUT,PATCH,MERGE,DELETE", ",").Найти(Метод) = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(405, "MethodNotAllowed", "Метод " + Операция.Метод + " не поддерживается в $batch");
	КонецЕсли;
	Доступные = ДоступныеАдреса(Операция, Состояние);
	Адрес = РазрешитьСсылку(Операция.Адрес, Доступные.Адреса, Состояние.Иды, Доступные.Недоступные);
	Хосты = Неопределено;
	Основа.Свойство("Хосты", Хосты);
	Относительный = ОтносительныйАдрес(Адрес, Основа.Корни, Хосты);
	Если Относительный = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Адрес операции вне корня сервиса: " + Адрес);
	КонецЕсли;
	Вопрос = СтрНайти(Относительный, "?");
	Попытка
		Путь = РаскодироватьСтроку(?(Вопрос = 0, Относительный, Лев(Относительный, Вопрос - 1)),
			СпособКодированияСтроки.КодировкаURL);
		Параметры = ПараметрыИзСтроки(?(Вопрос = 0, "", Сред(Относительный, Вопрос + 1)));
	Исключение
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверная кодировка адреса операции: " + Адрес);
	КонецПопытки;
	// Сегменты «.» и «..» (и в кодировке URL) выводили бы адрес за корень сервиса (отзыв безопасности, группа B).
	Для Каждого Сегмент Из СтрРазделить(Путь, "/") Цикл
		Если Сегмент = "." Или Сегмент = ".." Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Адрес операции вне корня сервиса: " + Адрес);
		КонецЕсли;
	КонецЦикла;
	Если Путь = "$batch" Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Вложенный $batch не поддерживается");
	КонецЕсли;
	Заголовки = Новый Соответствие;
	Для Каждого КлючИЗначение Из Операция.Заголовки Цикл
		Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Запрос = Новый Структура("HTTPМетод, ОтносительныйURL, ПараметрыЗапроса, БазовыйURL, Заголовки, Тело");
	Запрос.HTTPМетод = Метод;
	Запрос.ОтносительныйURL = "/v4" + ?(Путь = "", "", "/" + Путь);
	Запрос.ПараметрыЗапроса = Параметры;
	Запрос.БазовыйURL = Основа.БазовыйURL;
	Запрос.Заголовки = Заголовки;
	Запрос.Тело = ПодставитьВТеле(?(Операция.Тело = Неопределено, "", Операция.Тело), Доступные.Адреса, Состояние.Иды,
		Доступные.Недоступные);
	Возврат Запрос;
КонецФункции

// Адреса созданных сущностей, на которые операция может ссылаться $<Content-ID> (OData 4.0: внутри своего набора
// изменений; JSON batch 4.01 — ещё и на операцию или набор из её dependsOn): Структура «Адреса (Ид → путь),
// Недоступные (Ид → Истина: сущность создана, но операции недоступна)».
Функция ДоступныеАдреса(Операция, Состояние)
	Адреса = Новый Соответствие;
	Недоступные = Новый Соответствие;
	Для Каждого КлючИЗначение Из Состояние.Адреса Цикл
		Ид = КлючИЗначение.Ключ;
		НаборИда = Состояние.Наборы.Получить(Ид);
		Доступен = Операция.Набор <> "" И НаборИда = Операция.Набор;
		Для Каждого Зависимость Из Операция.ЗависитОт Цикл
			Если Зависимость = Ид Или НаборИда <> Неопределено И НаборИда <> "" И Зависимость = НаборИда Тогда
				Доступен = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Доступен Тогда
			Адреса.Вставить(Ид, КлючИЗначение.Значение);
		Иначе
			Недоступные.Вставить(Ид, Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Адреса, Недоступные", Адреса, Недоступные);
КонецФункции

// Имена хоста, под которыми клиент обращается к сервису (для абсолютных адресов операций): хост адреса запроса
// $batch, заголовки Host и X-Forwarded-Host (сервис за прокси) и хосты адресов публикации из настроек. Соответствие
// «хост[:порт]» в нижнем регистре (порт 80/443 опускается) → Истина.
Функция ХостыСервиса(Запрос) Экспорт
	Хосты = Новый Соответствие;
	Хосты.Вставить(ХостАдреса(Запрос.БазовыйURL), Истина);
	Для Каждого Имя Из СтрРазделить("Host,X-Forwarded-Host", ",") Цикл
		Для Каждого Значение Из СтрРазделить(OData4_Безопасность.ЗначениеЗаголовка(Запрос, Имя), ",", Ложь) Цикл
			Хосты.Вставить(НормальныйХост(Значение), Истина);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("АдресПубликации,АдресПубликацииТокенов", ",") Цикл
		Адрес = OData4_НастройкиСервиса.Значение(Имя, "");
		Если ТипЗнч(Адрес) = Тип("Строка") И ЭтоАбсолютныйАдрес(СокрЛП(Адрес)) Тогда
			Хосты.Вставить(ХостАдреса(СокрЛП(Адрес)), Истина);
		КонецЕсли;
	КонецЦикла;
	Хосты.Удалить("");
	Возврат Хосты;
КонецФункции

// Хост абсолютного адреса («http://Хост:80/a» → «хост»), без учётной записи; не абсолютный — "".
Функция ХостАдреса(Адрес)
	Если Не ЭтоАбсолютныйАдрес(Адрес) Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(Адрес, СтрНайти(Адрес, "://") + 3);
	Конец = СтрДлина(Остаток) + 1;
	Для Каждого Разделитель Из СтрРазделить("/,?,#", ",") Цикл
		Позиция = СтрНайти(Остаток, Разделитель);
		Если Позиция > 0 И Позиция < Конец Тогда
			Конец = Позиция;
		КонецЕсли;
	КонецЦикла;
	Хост = Лев(Остаток, Конец - 1);
	Собака = СтрНайти(Хост, "@", НаправлениеПоиска.СКонца);
	Если Собака > 0 Тогда
		Хост = Сред(Хост, Собака + 1);
	КонецЕсли;
	Возврат НормальныйХост(Хост);
КонецФункции

// Хост в нижнем регистре без порта 80 и 443.
Функция НормальныйХост(Хост)
	Результат = НРег(СокрЛП(Хост));
	Для Каждого Порт Из СтрРазделить(":80,:443", ",") Цикл
		Если СтрЗаканчиваетсяНа(Результат, Порт) Тогда
			Возврат Лев(Результат, СтрДлина(Результат) - СтрДлина(Порт));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Параметры строки запроса «a=1&b=2» (в кодировке URL) → Соответствие раскодированных имён и значений; «+» остаётся
// знаком плюс (RFC 3986).
Функция ПараметрыИзСтроки(Текст)
	Параметры = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить(Текст, "&", Ложь) Цикл
		Равно = СтрНайти(Часть, "=");
		Имя = РаскодироватьСтроку(?(Равно = 0, Часть, Лев(Часть, Равно - 1)), СпособКодированияСтроки.КодировкаURL);
		Значение = ?(Равно = 0, "", РаскодироватьСтроку(Сред(Часть, Равно + 1), СпособКодированияСтроки.КодировкаURL));
		Параметры.Вставить(Имя, Значение);
	КонецЦикла;
	Возврат Параметры;
КонецФункции

// Запоминает адрес сущности, созданной операцией с Content-ID Ид: Location (или OData-EntityId у return=minimal)
// ответа — путь от корня сервиса.
Процедура ЗапомнитьАдрес(Ид, Заголовки, Основа, Состояние)
	Адрес = "";
	Для Каждого КлючИЗначение Из Заголовки Цикл
		Имя = НРег(КлючИЗначение.Ключ);
		Если Имя = "location" Или Имя = "odata-entityid" И Адрес = "" Тогда
			Адрес = КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	Если Адрес = "" Тогда
		Возврат;
	КонецЕсли;
	Путь = ОтносительныйАдрес(Адрес, Основа.Корни);
	Если Путь <> Неопределено И Путь <> "" Тогда
		Состояние.Адреса.Вставить(Ид, Путь);
	КонецЕсли;
КонецПроцедуры

// Первая зависимость dependsOn (операция или набор), которая не выполнена успешно; "" — все выполнены. Свой набор
// операции не проверяется (он ещё выполняется).
Функция НевыполненнаяЗависимость(Операция, Состояние)
	Для Каждого Зависимость Из Операция.ЗависитОт Цикл
		Если Операция.Набор <> "" И Зависимость = Операция.Набор Тогда
			Продолжить;
		КонецЕсли;
		Если Состояние.Статусы.Получить(Зависимость) <> Истина Тогда
			Возврат Строка(Зависимость);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Значения «на время вызова» перед операцией и после пакета: контекст входа восстановлен (запись объектов может
// сбросить кэши вызова), операция записи, её подробности и заголовки ответа об ошибке — пустые: у каждой операции
// свои.
Процедура ПодготовитьВызов(Снимок)
	OData4_Запись.ВосстановитьВызов(Снимок);
	ОперацияВызова = OData4_ЗаписьВызов.Операция();
	ОперацияВызова.Операция = "";
	ОперацияВызова.Объект = "";
	ОперацияВызова.Подробности = Неопределено;
	OData4_БезопасностьВызов.Контекст().ЗаголовкиОтвета.Очистить();
КонецПроцедуры

Функция РезультатОшибки(Операция, Статус, Код, Сообщение)
	Возврат РезультатОтвета(Операция, OData4_Сериализация.ОтветОшибки(Статус, Код, Сообщение));
КонецФункции

Функция ПредставлениеОперации(Операция, Номер)
	Если Операция.Ид <> "" Тогда
		Возврат "«" + Операция.Ид + "»";
	КонецЕсли;
	Возврат ?(Номер > 0, "№" + Формат(Номер, "ЧГ=0") + " ", "") + Операция.Метод + " " + Операция.Адрес;
КонецФункции

// Тело запроса $batch строкой UTF-8, если его размер в байтах не больше Наибольший; иначе 413 до разбора.
Функция ТелоВПределах(Запрос, Наибольший)
	Если ТипЗнч(Запрос) = Тип("Структура") Тогда
		Тело = ?(Запрос.Тело = Неопределено, "", Запрос.Тело);
		Размер = ?(Тело = "", 0, ПолучитьДвоичныеДанныеИзСтроки(Тело, "UTF-8", Ложь).Размер());
	Иначе
		Данные = Запрос.ПолучитьТелоКакДвоичныеДанные();
		Размер = ?(Данные = Неопределено, 0, Данные.Размер());
		Тело = "";
	КонецЕсли;
	Если Размер > Наибольший Тогда
		OData4_Сервис.ОшибкаOData(413, "PayloadTooLarge", "Тело $batch больше " + Формат(Наибольший / 1048576, "ЧН=0; ЧГ=0")
			+ " МБ: " + Формат(Размер, "ЧН=0; ЧГ=0") + " байт");
	КонецЕсли;
	Если ТипЗнч(Запрос) <> Тип("Структура") И Размер > 0 Тогда
		Тело = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	КонецЕсли;
	Возврат ?(Тело = Неопределено, "", Тело);
КонецФункции

// Наибольший размер тела $batch в байтах: настройка НаибольшийРазмерBatchМБ (по умолчанию 10).
Функция НаибольшийРазмерТела()
	МБ = OData4_НастройкиСервиса.Значение("НаибольшийРазмерBatchМБ", 10);
	Возврат ?(ТипЗнч(МБ) = Тип("Число") И МБ > 0, МБ, 10) * 1048576;
КонецФункции

Функция НаибольшееЧислоОпераций()
	Возврат ЛимитОпераций(OData4_НастройкиСервиса.Значение("НаибольшееЧислоОперацийBatch", 100),
		OData4_Безопасность.ОперацийBatchПрофиля());
КонецФункции

// Неотрицательное целое из цифр версии или Неопределено.
Функция ЧислоВерсии(Текст)
	Цифры = СокрЛП(Текст);
	Если Цифры = "" Или СтрДлина(Цифры) > 3 Тогда
		Возврат ?(Цифры = "", 0, Неопределено);
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Цифры) Цикл
		Если СтрНайти("0123456789", Сред(Цифры, Номер, 1)) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Возврат Число(Цифры);
КонецФункции

Функция ЭтоАбсолютныйАдрес(Текст)
	Позиция = СтрНайти(Текст, "://");
	Если Позиция < 2 Тогда
		Возврат Ложь;
	КонецЕсли;
	Схема = Лев(Текст, Позиция - 1);
	Возврат СтрНайти(Схема, "/") = 0 И СтрНайти(Схема, "?") = 0 И СтрНайти(Схема, "$") = 0;
КонецФункции

// Путь адреса от корня хоста: «http://хост:порт/a/b?x» → «/a/b?x»; адрес без схемы — как есть; без пути — "".
Функция ПутьОтХоста(Адрес)
	Если Не ЭтоАбсолютныйАдрес(Адрес) Тогда
		Возврат Адрес;
	КонецЕсли;
	Остаток = Сред(Адрес, СтрНайти(Адрес, "://") + 3);
	Косая = СтрНайти(Остаток, "/");
	Вопрос = СтрНайти(Остаток, "?");
	Если Косая = 0 Или Вопрос > 0 И Вопрос < Косая Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Остаток, Косая);
КонецФункции

Функция СтрокаJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Запись.ЗаписатьЗначение(Значение);
	Возврат Запись.Закрыть();
КонецФункции

#КонецОбласти
