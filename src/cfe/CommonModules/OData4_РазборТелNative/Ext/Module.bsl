#Область СлужебныйПрограммныйИнтерфейс

// Разбор тел запросов компонентой OData4Native (этап 8.2): JSON-тело записи (OData4_ЗаписьПоля.ТелоИзТекста) и
// пакет $batch (OData4_Пакет.РазобратьПакет). Движок выбирает настройка РежимРазбораТел (OData4_Движок.РежимДвижка):
// "BSL" — только язык 1С; "Компонента" — компонента, при отказе или сбое — язык 1С; "Сверка" — оба, ответ — язык 1С,
// расхождение — в журнал регистрации (событие OData4.СверкаТел).
// Компонента отвечает внутренним форматом 1С (ЗначениеИзСтрокиВнутр — без повторного разбора JSON на языке 1С) или
// отказом: тело не строгий JSON (ЧтениеJSON 1С снисходительнее — висячие запятые, одинарные кавычки, мусор после
// значения), нарушение формата пакета, вложенность глубже 64, случаи, которые без таблиц 1С не повторить (см.
// native/odata4_core/src/batch.rs). Отказ — разбор на языке 1С: он же даёт статус, текст и место ошибки, поэтому
// ошибки в любом режиме те же, что у BSL. Сбой компоненты (исключение, ответ «!…», неверный внутренний формат) —
// запись OData4_Движок.ЗаписатьСбойКомпоненты и разбор на языке 1С.

// Ответ компоненты на тело записи (текст без BOM, не пустой): Структура «Вид, Значение»; Вид — "значение" (Значение —
// Соответствие, как у ПрочитатьJSON(Чтение, Истина)), "отказ" или "сбой".
Функция ТелоКомпонентой(Текст) Экспорт
	Ответ = ОтветКомпоненты("Тело", "", Текст);
	Если Ответ.Вид = "значение" И ТипЗнч(Ответ.Значение) <> Тип("Соответствие") Тогда
		Сбой(Ответ, ОписаниеТела(Текст), "ответ не Соответствие: " + Строка(ТипЗнч(Ответ.Значение)));
	КонецЕсли;
	Возврат Ответ;
КонецФункции

// Ответ компоненты на пакет $batch (ТипСодержимого и Текст — строки, текст без BOM): Структура «Вид, Значение»;
// Значение — результат контракта OData4_Пакет.РазобратьПакет. Для JSON batch результат дорабатывается так же, как его
// строит язык 1С (ДоработатьПакетJSON).
Функция ПакетКомпонентой(ТипСодержимого, Текст) Экспорт
	Ответ = ОтветКомпоненты("Пакет", ТипСодержимого, Текст);
	Если Ответ.Вид <> "значение" Тогда
		Возврат Ответ;
	КонецЕсли;
	Попытка
		ДоработатьПакетJSON(Ответ.Значение);
	Исключение
		Сбой(Ответ, ОписаниеПакета(ТипСодержимого, Текст),
			"неверная структура пакета: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// Режим «Сверка», язык 1С разобрал тело: итог компоненты (если она дала значение) сверяется с ИтогBSL по
// ЗначениеВСтрокуВнутр. Внутренний формат, а не канонический JSON: он различает типы (Число и Строка, Соответствие и
// Структура) и порядок обхода Соответствие, от которого зависит порядок свойств при записи и первая ошибка в теле;
// оба итога построены вставкой ключей в одном порядке, поэтому их внутренние строки совпадают побайтно. Отказ
// компоненты расхождением не считается: это нестрогий JSON, который 1С принимает.
Процедура Сверить(Описание, Ответ, ИтогBSL) Экспорт
	Если Ответ.Вид <> "значение" Тогда
		Возврат;
	КонецЕсли;
	OData4_Движок.СверитьВыходы("OData4.СверкаТел", Описание, ЗначениеВСтрокуВнутр(ИтогBSL),
		ЗначениеВСтрокуВнутр(Ответ.Значение));
КонецПроцедуры

// Режим «Сверка», язык 1С отверг тело (Информация — ИнформацияОбОшибке): компонента, давшая значение, расходится.
Процедура СверитьОшибку(Описание, Ответ, Информация) Экспорт
	Если Ответ.Вид <> "значение" Тогда
		Возврат;
	КонецЕсли;
	OData4_Движок.СверитьВыходы("OData4.СверкаТел", Описание, "ошибка: " + Информация.Описание,
		ЗначениеВСтрокуВнутр(Ответ.Значение));
КонецПроцедуры

// Описание тела записи для журнала регистрации.
Функция ОписаниеТела(Текст) Экспорт
	Возврат "Разбор тела записи (" + Формат(СтрДлина(Текст), "ЧН=0; ЧГ=0") + " симв.)";
КонецФункции

// Разбор JSON batch на языке 1С копирует заголовки операции из прочитанного Соответствие в новое в порядке обхода
// (OData4_Пакет.ЗаголовкиJSON), а порядок обхода копии не совпадает с порядком обхода источника; тело-значение JSON
// записывает ЗаписатьJSON с порядком ключей по обходу Соответствие. Компонента порядок обхода 1С повторить не может,
// поэтому отдаёт заголовки в порядке документа (как у прочитанного Соответствие), а такое тело — Массив из одного
// значения; здесь то и другое доводится тем же кодом, что у языка 1С. Разбор — значение ответа компоненты
// (ЗначениеИзСтрокиВнутр); multipart не меняется.
Процедура ДоработатьПакетJSON(Разбор) Экспорт
	Если Разбор.Формат <> "json" Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Операция Из Разбор.Операции Цикл
		Заголовки = Новый Соответствие;
		Для Каждого КлючИЗначение Из Операция.Заголовки Цикл
			Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Операция.Заголовки = Заголовки;
		Если ТипЗнч(Операция.Тело) = Тип("Массив") Тогда
			Запись = OData4_Сериализация.НоваяЗапись();
			ЗаписатьJSON(Запись, Операция.Тело[0]);
			Операция.Тело = Запись.Закрыть();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Описание пакета для журнала регистрации.
Функция ОписаниеПакета(ТипСодержимого, Текст) Экспорт
	Возврат "Разбор пакета $batch (Content-Type: " + ТипСодержимого + ", " + Формат(СтрДлина(Текст), "ЧН=0; ЧГ=0")
		+ " симв.)";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вызов метода компоненты РазобратьТело или РазобратьПакет. Ответ компоненты: внутренний формат 1С, "" — отказ,
// "!текст" — сбой.
Функция ОтветКомпоненты(Метод, ТипСодержимого, Текст)
	Ответ = Новый Структура("Вид, Значение", "отказ", Неопределено);
	Компонента = OData4_Движок.КомпонентаСеанса();
	Если Компонента = Неопределено Тогда
		Возврат Ответ;
	КонецЕсли;
	Описание = ?(Метод = "Тело", ОписаниеТела(Текст), ОписаниеПакета(ТипСодержимого, Текст));
	Попытка
		Если Метод = "Тело" Тогда
			ТекстОтвета = Компонента.РазобратьТело(Текст);
		Иначе
			ТекстОтвета = Компонента.РазобратьПакет(ТипСодержимого, Текст);
		КонецЕсли;
	Исключение
		Сбой(Ответ, Описание, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ответ;
	КонецПопытки;
	Если ТипЗнч(ТекстОтвета) <> Тип("Строка") Тогда
		Сбой(Ответ, Описание, "ответ не строка: " + Строка(ТипЗнч(ТекстОтвета)));
		Возврат Ответ;
	ИначеЕсли ТекстОтвета = "" Тогда
		Возврат Ответ;
	ИначеЕсли Лев(ТекстОтвета, 1) = "!" Тогда
		Сбой(Ответ, Описание, Сред(ТекстОтвета, 2));
		Возврат Ответ;
	КонецЕсли;
	Попытка
		Ответ.Значение = ЗначениеИзСтрокиВнутр(ТекстОтвета);
		Ответ.Вид = "значение";
	Исключение
		Сбой(Ответ, Описание, "неверный внутренний формат (" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			+ "): " + Лев(ТекстОтвета, 200));
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Процедура Сбой(Ответ, Описание, ТекстСбоя)
	OData4_Движок.ЗаписатьСбойКомпоненты(Описание, ТекстСбоя);
	Ответ.Вид = "сбой";
	Ответ.Значение = Неопределено;
КонецПроцедуры

#КонецОбласти
