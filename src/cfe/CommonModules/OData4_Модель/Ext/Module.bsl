#Область ПрограммныйИнтерфейс

// Модель EDM по составу публикации (OData4_Состав.ДействующийСостав, если Состав не передан), построенная
// целиком: объекты состава, кроме объектов OData4_*, доступные текущему пользователю на чтение, без исключённых
// полей и табличных частей. Имена — как в standard.odata. Сеанс сервиса строит модель лениво (НоваяМодель).
Функция Построить(Состав = Неопределено) Экспорт
	Модель = НоваяМодель(Состав);
	ПостроитьВсё(Модель);
	Возврат Модель;
КонецФункции

// Ленивая модель (этап 6.1): сразу строится только индекс «имя набора → объект метаданных» по составу — имена и
// порядок наборов (Порядок), без свойств, табличных частей и навигаций. Описания наборов объекта строятся при
// первом обращении к любому его набору (НайтиНабор, Набор) и остаются в Модель.Наборы. Модель.Наборы — только
// построенные описания: обходить их или читать напрямую нельзя (НайтиНабор, ПостроитьВсё, Целиком).
Функция НоваяМодель(Состав = Неопределено) Экспорт
	Если Состав = Неопределено Тогда
		Состав = OData4_Состав.ДействующийСостав();
	КонецЕсли;
	Модель = Новый Структура;
	Модель.Вставить("Наборы", Новый Соответствие);
	Модель.Вставить("Перечисления", Новый Соответствие);
	Модель.Вставить("Порядок", Новый Массив);
	Модель.Вставить("Состав", Состав);
	// Есть свойства ValueType (описание типов): в $metadata нужны комплексные типы TypeDescription.
	Модель.Вставить("ЕстьОписаниеТипов", Ложь);
	// Индекс: имя набора → Структура «Объект (полное имя), Вид (как у описания), ИмяВВладельце»; скрытых коллекций
	// в индексе нет — они строятся с владельцем.
	Модель.Вставить("Индекс", Новый Соответствие);
	// Полные имена объектов в порядке построения и основной набор объекта (см. ОсновнойНабор).
	Модель.Вставить("Объекты", Новый Массив);
	Модель.Вставить("Основные", Новый Соответствие);
	Модель.Вставить("ПостроенныеОбъекты", Новый Соответствие);
	Модель.Вставить("Построена", Ложь);
	ЗаполнитьИндекс(Модель);
	Возврат Модель;
КонецФункции

// Описание набора по имени или ошибка 404. Скрытая коллекция (ExtDimensionTypes и т. п.) набором не является.
Функция Набор(Модель, Имя) Экспорт
	Набор = НайтиНабор(Модель, Имя);
	Если Набор = Неопределено Или Набор.Скрытый Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Набор сущностей не найден: " + Имя);
	КонецЕсли;
	Возврат Набор;
КонецФункции

// Описание набора по имени (и скрытой коллекции построенного владельца) или Неопределено. Ленивая модель строит
// наборы объекта при первом обращении; модель профиля (OData4_ПрофильМодели.МодельПрофиля) урезает набор при его
// построении. Исключений не бросает, кроме сбоя платформы при чтении метаданных.
Функция НайтиНабор(Модель, Имя) Экспорт
	Набор = Модель.Наборы.Получить(Имя);
	Если Набор <> Неопределено Или ПостроенаЦеликом(Модель) Тогда
		Возврат Набор;
	КонецЕсли;
	Если Модель.Свойство("Основа") Тогда
		Возврат OData4_ПрофильМодели.НаборПрофиля(Модель, Имя);
	КонецЕсли;
	Запись = Модель.Индекс.Получить(Имя);
	Если Запись = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПостроитьОбъект(Модель, Запись.Объект);
	Возврат Модель.Наборы.Получить(Имя);
КонецФункции

// Сведения о наборе без его построения: Структура «Объект (полное имя объекта метаданных), Вид, ИмяВВладельце» —
// по построенному описанию или по индексу ленивой модели; набора нет — Неопределено.
Функция СведенияНабора(Модель, Имя) Экспорт
	Набор = Модель.Наборы.Получить(Имя);
	Если Набор <> Неопределено Тогда
		Возврат Новый Структура("Объект, Вид, ИмяВВладельце", OData4_ПрофильМодели.ПолноеИмяОбъекта(Набор), Набор.Вид,
			Набор.ИмяВВладельце);
	ИначеЕсли ПостроенаЦеликом(Модель) Или Не Модель.Свойство("Индекс") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Модель.Индекс.Получить(Имя);
КонецФункции

// Достраивает все наборы модели («построить всё»: $metadata, проверка профиля). Модель профиля — вместе с основой.
Процедура ПостроитьВсё(Модель) Экспорт
	Если ПостроенаЦеликом(Модель) Тогда
		Возврат;
	КонецЕсли;
	Если Модель.Свойство("Основа") Тогда
		OData4_ПрофильМодели.ПостроитьВсё(Модель);
		Возврат;
	КонецЕсли;
	// Индекс состава общих реквизитов на время построения всей модели: ОбщийРеквизит.Состав.Найти стоит около
	// 0,5 мс, а вызывался для каждого объекта и реквизита (4–5 с из 9 на полном составе, проба p1-prof). Один набор
	// обходится без индекса (ОбщиеРеквизитыОбъекта).
	Модель.Вставить("ОбщиеРеквизиты", ИндексОбщихРеквизитов());
	Модель.Вставить("ТипыПостроения", Новый Соответствие);
	// Объекты — обходом коллекций метаданных в порядке индекса: Метаданные.НайтиПоПолномуИмени на каждый объект
	// стоил около 0,23 с из 1,7 на демобазе (замечание Н1 QA 6.1).
	ВИндексе = Новый Соответствие;
	Для Каждого ПолноеИмя Из Модель.Объекты Цикл
		ВИндексе.Вставить(ПолноеИмя, Истина);
	КонецЦикла;
	Для Каждого Вид Из ВидыОбъектов() Цикл
		Для Каждого ОбъектМетаданных Из Вид.Коллекция Цикл
			ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
			Если ВИндексе.Получить(ПолноеИмя) = Истина Тогда
				ПостроитьОбъект(Модель, ПолноеИмя, ОбъектМетаданных);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Модель.Удалить("ОбщиеРеквизиты");
	Модель.Удалить("ТипыПостроения");
	Модель.Построена = Истина;
КонецПроцедуры

// Модель, построенная целиком: сама Модель, если она уже построена, иначе ПолнаяКопия. Ленивую модель сеанса
// не раздувает: всё строится во временной копии, которую вызывающий отпускает после использования.
Функция Целиком(Модель) Экспорт
	Если ПостроенаЦеликом(Модель) Тогда
		Возврат Модель;
	КонецЕсли;
	Возврат ПолнаяКопия(Модель);
КонецФункции

// Новая модель с тем же индексом, построенная целиком заново (порядок перечислений и наборов — как у Построить,
// независимо от того, что уже построено в Модель). Модель не меняется. У модели профиля — копия основы и урезание
// тем же описанием профиля.
Функция ПолнаяКопия(Модель) Экспорт
	Если Модель.Свойство("Основа") Тогда
		Копия = OData4_ПрофильМодели.МодельПрофиля(ПолнаяКопия(Модель.Основа), Модель.Описание);
	Иначе
		Копия = Новый Структура;
		Копия.Вставить("Наборы", Новый Соответствие);
		Копия.Вставить("Перечисления", Новый Соответствие);
		Копия.Вставить("Порядок", Модель.Порядок);
		Копия.Вставить("Состав", Модель.Состав);
		Копия.Вставить("ЕстьОписаниеТипов", Ложь);
		Копия.Вставить("Индекс", Модель.Индекс);
		Копия.Вставить("Объекты", Модель.Объекты);
		Копия.Вставить("Основные", Модель.Основные);
		Копия.Вставить("ПостроенныеОбъекты", Новый Соответствие);
		Копия.Вставить("Построена", Ложь);
	КонецЕсли;
	ПостроитьВсё(Копия);
	Возврат Копия;
КонецФункции

// Модель построена целиком: Построить, ПостроитьВсё или модель без признака (собранная вручную).
Функция ПостроенаЦеликом(Модель) Экспорт
	Построена = Истина;
	Модель.Свойство("Построена", Построена);
	Возврат Построена = Истина;
КонецФункции

// Основной набор объекта ПолноеИмя («Справочник.Банки»): набор справочника или документа, у регистра — набор
// записей (вид «Регистр»). Нет — Неопределено. Строит только этот объект.
Функция ОсновнойНабор(Модель, ПолноеИмя) Экспорт
	Основа = Модель;
	Если Модель.Свойство("Основа") Тогда
		Основа = Модель.Основа;
	КонецЕсли;
	Если Не Основа.Свойство("Основные") Тогда
		// Модель, собранная вручную: перебор порядка, как до этапа 6.1.
		Для Каждого Имя Из Модель.Порядок Цикл
			Набор = НайтиНабор(Модель, Имя);
			Если Набор <> Неопределено И Набор.ТаблицаЗапроса = ПолноеИмя
				И (Набор.Вид = "Справочник" Или Набор.Вид = "Документ" Или Набор.Вид = "Регистр") Тогда
				Возврат Набор;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
	Имя = Основа.Основные.Получить(ПолноеИмя);
	Если Имя = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Набор = НайтиНабор(Модель, Имя);
	Если Набор = Неопределено Или Набор.ТаблицаЗапроса <> ПолноеИмя Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Набор;
КонецФункции

// Регистрирует построенное описание набора в модели (строители наборов объекта). Имя, которое индекс отдал другому
// объекту (совпадение имён наборов разных объектов), не занимается: как при полной сборке, где набор последнего
// объекта затирал прежний.
Процедура ДобавитьНабор(Модель, Набор) Экспорт
	// Навигации и индексы описания заполняются в любом случае (владелец читает свои табличные части из построенных
	// вместе с ним наборов, решение 9 плана 6.1).
	Новые = Неопределено;
	Если Модель.Свойство("НовыеНаборы", Новые) Тогда
		Новые.Добавить(Набор);
	КонецЕсли;
	Если Модель.Свойство("Индекс") Тогда
		Запись = Модель.Индекс.Получить(Набор.Имя);
		Если Запись <> Неопределено И Запись.Объект <> OData4_ПрофильМодели.ПолноеИмяОбъекта(Набор) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Модель.Наборы.Вставить(Набор.Имя, Набор);
КонецПроцедуры

// Имена значений перечисления в порядке standard.odata — по возрастанию кодов символов.
Функция ИменаЗначенийПеречисления(ОбъектМетаданных) Экспорт
	Имена = Новый Массив;
	Для Каждого ЗначениеПеречисления Из ОбъектМетаданных.ЗначенияПеречисления Цикл
		Имена.Добавить(ЗначениеПеречисления.Имя);
	КонецЦикла;
	Возврат УпорядочитьСтроки(Имена);
КонецФункции

// Новый массив строк по возрастанию кодов символов (порядок байтов UTF-8, как sort.Strings в Go).
Функция УпорядочитьСтроки(Исходные) Экспорт
	Результат = Новый Массив;
	Для Каждого Элемент Из Исходные Цикл
		Позиция = Результат.Количество();
		Пока Позиция > 0 И МеньшеПоКодам(Элемент, Результат[Позиция - 1]) Цикл
			Позиция = Позиция - 1;
		КонецЦикла;
		Результат.Вставить(Позиция, Элемент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Описание набора сущностей. Вид: Справочник, Документ, ТабличнаяЧасть, Регистр (записи регистра),
// НаборЗаписей (набор по регистратору со свойством-коллекцией RecordSet).
// Ключ — имена свойств ключа в порядке standard.odata; ПоляКлюча — описания свойств, чьи поля
// образуют ключ (спутники Имя_Type в ПоляКлюча не входят). ВидРегистра — "", Сведений, Накопления,
// Бухгалтерии, Расчета. ВиртуальныеТаблицы — Соответствие имя функции → описание (Task 4).
// КлючПродолжения — свойства с полями, которые продолжают порядок и метку $skiptoken после ПоляКлюча,
// но в ключ сущности не входят: у записей подчинённого регистра с одним суррогатным ключом (SurrogateKey)
// — Recorder и LineNumber.
Функция НовыйНабор(Имя, Вид, ТаблицаЗапроса, ИмяТипаСсылки, Родитель) Экспорт
	Набор = Новый Структура;
	Набор.Вставить("Имя", Имя);
	Набор.Вставить("Вид", Вид);
	Набор.Вставить("ТаблицаЗапроса", ТаблицаЗапроса);
	// ТаблицаЧтения — источник «ИЗ» запросов чтения, если он не ТаблицаЗапроса (строки регистра бухгалтерии с субконто
	// читаются из ДвиженияССубконто, часть 6.4); "" — ТаблицаЗапроса. Имя объекта и профиль — по ТаблицаЗапроса.
	Набор.Вставить("ТаблицаЧтения", "");
	Набор.Вставить("ИмяТипаСсылки", ИмяТипаСсылки);
	Набор.Вставить("Родитель", Родитель);
	Набор.Вставить("ИмяВВладельце", "");
	Набор.Вставить("Свойства", Новый Массив);
	Набор.Вставить("ТабличныеЧасти", Новый Массив);
	Набор.Вставить("Ключ", Новый Массив);
	Набор.Вставить("ПоляКлюча", Новый Массив);
	Набор.Вставить("КлючПродолжения", Новый Массив);
	Набор.Вставить("ИмяОбъекта", "");
	Набор.Вставить("ВидРегистра", "");
	Набор.Вставить("Периодический", Ложь);
	Набор.Вставить("ПоРегистратору", Ложь);
	Набор.Вставить("ВиртуальныеТаблицы", Новый Соответствие);
	Набор.Вставить("ПолеСвязи", "");
	Набор.Вставить("ТипСвязи", Неопределено);
	// Скрытый — коллекция в сущности без собственного набора (ExtDimensionTypes, LeadingCalculationTypes):
	// нет EntitySet и маршрута, в строке нет Ref_Key, тип строк — ComplexType с именем набора.
	Набор.Вставить("Скрытый", Ложь);
	Возврат Набор;
КонецФункции

// Таблица «ИЗ» запросов чтения набора: ТаблицаЧтения, если задана, иначе ТаблицаЗапроса (наборы, собранные вручную, —
// виртуальные таблицы и $apply — поля ТаблицаЧтения не имеют).
Функция ТаблицаЧтения(Набор) Экспорт
	Значение = "";
	Если Набор.Свойство("ТаблицаЧтения", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Набор.ТаблицаЗапроса;
КонецФункции

Функция НовоеСвойство(Имя, Поле, Вид, ТипEdm) Экспорт
	Свойство = Новый Структура;
	Свойство.Вставить("Имя", Имя);
	Свойство.Вставить("Поле", Поле);
	Свойство.Вставить("Вид", Вид);
	Свойство.Вставить("ТипEdm", ТипEdm);
	Свойство.Вставить("ВКлюче", Ложь);
	Свойство.Вставить("Длина", 0);
	Свойство.Вставить("Разрядность", 0);
	Свойство.Вставить("Дробная", 0);
	Свойство.Вставить("ЧастиДаты", "");
	Свойство.Вставить("ИмяНавигации", "");
	Свойство.Вставить("ЦелевойНабор", "");
	Свойство.Вставить("ТипСсылки", Неопределено);
	Свойство.Вставить("Перечисление", "");
	// NULL в строке выдаётся пустым значением типа, а не null (как у standard.odata): поля «ИмяДт»/«ИмяКт» регистра
	// бухгалтерии, которые счёт строки не ведёт.
	Свойство.Вставить("NullКакПустое", Ложь);
	Возврат Свойство;
КонецФункции

Функция СвойствоКлюча(Имя, Поле) Экспорт
	Свойство = НовоеСвойство(Имя, Поле, "Ключ", "Edm.Guid");
	Свойство.ВКлюче = Истина;
	Возврат Свойство;
КонецФункции

Функция Публикуется(ОбъектМетаданных, Состав) Экспорт
	Возврат Состав.Получить(ОбъектМетаданных.ПолноеИмя()) <> Неопределено
		И Не СтрНачинаетсяС(ОбъектМетаданных.Имя, "OData4_")
		И ПравоДоступа("Чтение", ОбъектМетаданных);
КонецФункции

// Поле 1С объекта исключено составом («Реквизит», «ИмяТЧ.Реквизит», стандартный — по русскому имени).
Функция Исключено(Состав, ОбъектМетаданных, ИмяПоля) Экспорт
	Описание0 = Состав.Получить(ОбъектМетаданных.ПолноеИмя());
	Возврат Описание0 <> Неопределено И Описание0.ИсключённыеПоля.Найти(ИмяПоля) <> Неопределено;
КонецФункции

// Табличная часть объекта исключена составом.
Функция ТЧИсключена(Состав, ОбъектМетаданных, ИмяТЧ) Экспорт
	Описание0 = Состав.Получить(ОбъектМетаданных.ПолноеИмя());
	Возврат Описание0 <> Неопределено И Описание0.ИсключённыеТЧ.Найти(ИмяТЧ) <> Неопределено;
КонецФункции

// Убирает из набора свойства исключённых полей. Поле ключа (ВКлюче, ПоляКлюча, КлючПродолжения, поле
// связи) не исключается. ПрефиксТЧ — «ИмяТЧ.» у набора табличной части, иначе "".
Процедура УбратьИсключённые(Модель, Набор, ОбъектМетаданных, ПрефиксТЧ) Экспорт
	Описание0 = Модель.Состав.Получить(ОбъектМетаданных.ПолноеИмя());
	Если Описание0 = Неопределено Или Описание0.ИсключённыеПоля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Индекс = Набор.Свойства.ВГраница();
	Пока Индекс >= 0 Цикл
		Свойство = Набор.Свойства[Индекс];
		Если Описание0.ИсключённыеПоля.Найти(ПрефиксТЧ + Свойство.Поле) <> Неопределено
			И Не ПолеКлюча(Набор, Свойство) Тогда
			Набор.Свойства.Удалить(Индекс);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
КонецПроцедуры

// Свойство входит в ключ набора или связывает его с владельцем: исключить его нельзя.
Функция ПолеКлюча(Набор, Свойство) Экспорт
	Возврат Свойство.ВКлюче Или Свойство.Поле = "" Или Свойство.Поле = Набор.ПолеСвязи
		Или Набор.ПоляКлюча.Найти(Свойство) <> Неопределено
		Или Набор.КлючПродолжения.Найти(Свойство) <> Неопределено;
КонецФункции

// Добавляет свойство по описанию типов реквизита, измерения или ресурса: ссылка — Имя_Key
// с навигационным свойством Имя, составной — Имя (значение строкой) и Имя_Type,
// хранилище — Имя, Имя_Type и Имя_Base64Data. Возвращает добавленное свойство
// или Неопределено, если тип не публикуется.
Функция ДобавитьРеквизит(Модель, Свойства, ИмяOData, Поле, ОписаниеТипов) Экспорт
	Типы = ОписаниеТипов.Типы();
	Если Типы.Количество() = 0 Тогда
		Возврат Неопределено;
	ИначеЕсли Типы.Количество() > 1 Тогда
		Составное = НовоеСвойство(ИмяOData, Поле, "Составной", "Edm.String");
		// Перечисления составного — в EnumType, чтобы на них указывали значения *_Type.
		// Перечисление без значений в EnumType не выводится.
		Для Каждого ТипЗначения Из Типы Цикл
			Сведения = СведенияТипа(Модель, ТипЗначения);
			Если Сведения <> Неопределено И Сведения.Перечисление И Сведения.ЕстьЗначения Тогда
				Модель.Перечисления.Вставить(Сведения.Объект.Имя, Сведения.Объект);
			КонецЕсли;
		КонецЦикла;
		Свойства.Добавить(Составное);
		Возврат Составное;
	КонецЕсли;
	ТипЗначения = Типы[0];
	Если ТипЗначения = Тип("Строка") Тогда
		Свойство = НовоеСвойство(ИмяOData, Поле, "Примитив", "Edm.String");
		Свойство.Длина = ОписаниеТипов.КвалификаторыСтроки.Длина;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Свойство = НовоеСвойство(ИмяOData, Поле, "Примитив", "Edm.Decimal");
		Свойство.Разрядность = ОписаниеТипов.КвалификаторыЧисла.Разрядность;
		Свойство.Дробная = ОписаниеТипов.КвалификаторыЧисла.РазрядностьДробнойЧасти;
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Свойство = НовоеСвойство(ИмяOData, Поле, "Примитив", "Edm.Boolean");
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Части = ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
		Состав = ?(Части = ЧастиДаты.Дата, "Дата", ?(Части = ЧастиДаты.Время, "Время", "ДатаВремя"));
		Свойство = НовоеСвойство(ИмяOData, Поле, "Примитив", OData4_Сериализация.ТипДаты(Состав));
		Свойство.ЧастиДаты = Состав;
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Свойство = НовоеСвойство(ИмяOData, Поле, "Примитив", "Edm.Guid");
	ИначеЕсли ТипЗначения = Тип("ХранилищеЗначения") Тогда
		// Как в standard.odata: поток Реквизит, рядом Реквизит_Base64Data и Реквизит_Type.
		Свойство = НовоеСвойство(ИмяOData, Поле, "Хранилище", "Edm.Stream");
	Иначе
		Сведения = СведенияТипа(Модель, ТипЗначения);
		Если Сведения = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		ОбъектТипа = Сведения.Объект;
		Если Сведения.Перечисление И Не Сведения.ЕстьЗначения Тогда
			// EnumType без членов не выводится: свойство — строка.
			Свойство = НовоеСвойство(ИмяOData, Поле, "Перечисление", "Edm.String");
		ИначеЕсли Сведения.Перечисление Тогда
			Свойство = НовоеСвойство(ИмяOData, Поле, "Перечисление", "StandardODATA." + Сведения.ИмяНабора);
			Модель.Перечисления.Вставить(ОбъектТипа.Имя, ОбъектТипа);
		Иначе
			Свойство = НовоеСвойство(ИмяOData + "_Key", Поле, "Ссылка", "Edm.Guid");
			Свойство.ИмяНавигации = ИмяOData;
			Свойство.ЦелевойНабор = Сведения.ИмяНабора;
			Свойство.ТипСсылки = ТипЗначения;
		КонецЕсли;
		Если Свойство.Вид = "Перечисление" Тогда
			Свойство.Перечисление = ОбъектТипа.Имя;
		КонецЕсли;
	КонецЕсли;
	Свойства.Добавить(Свойство);
	Возврат Свойство;
КонецФункции

// Общий реквизит входит в набор, как в standard.odata: объект в составе реквизита, а разделитель —
// только с использованием разделяемых данных «Независимо и совместно».
Функция ОбщийРеквизитВСоставе(ОбщийРеквизит, ОбъектМетаданных) Экспорт
	Свойства = Метаданные.СвойстваОбъектов;
	Если ОбщийРеквизит.РазделениеДанных = Свойства.РазделениеДанныхОбщегоРеквизита.Разделять
		И ОбщийРеквизит.ИспользованиеРазделяемыхДанных
			<> Свойства.ИспользованиеРазделяемыхДанныхОбщегоРеквизита.НезависимоИСовместно Тогда
		Возврат Ложь;
	КонецЕсли;
	Элемент = ОбщийРеквизит.Состав.Найти(ОбъектМетаданных);
	Если Элемент = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Элемент.Использование = Свойства.ИспользованиеОбщегоРеквизита.Использовать
		Или Элемент.Использование = Свойства.ИспользованиеОбщегоРеквизита.Авто
			И ОбщийРеквизит.АвтоИспользование = Свойства.АвтоИспользованиеОбщегоРеквизита.Использовать;
КонецФункции

// Общие реквизиты объекта по индексу построения: Массив Структура("Реквизит, Разделитель") в порядке
// Метаданные.ОбщиеРеквизиты. Правило — ОбщийРеквизитВСоставе; ВсеРазделители — разделители при любом режиме
// использования разделяемых данных (планы обмена, как в standard.odata).
Функция ОбщиеРеквизитыОбъекта(Модель, ОбъектМетаданных, ВсеРазделители = Ложь) Экспорт
	Индекс = Неопределено;
	Если Не Модель.Свойство("ОбщиеРеквизиты", Индекс) Тогда
		Возврат ОбщиеРеквизитыПоМетаданным(ОбъектМетаданных, ВсеРазделители);
	КонецЕсли;
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Результат = Новый Массив;
	Для Каждого Элемент Из Индекс Цикл
		Если Элемент.Объекты.Получить(ПолноеИмя) = Истина
			И (Элемент.Допустим Или ВсеРазделители И Элемент.Разделитель) Тогда
			Результат.Добавить(Новый Структура("Реквизит, Разделитель", Элемент.Реквизит, Элемент.Разделитель));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сведения о ссылочном типе или перечислении: Структура «Объект, Перечисление, ЕстьЗначения, ИмяНабора» или
// Неопределено (тип не из метаданных). На время построения кэшируются в Модель.ТипыПостроения: НайтиПоТипу
// и перебор коллекций в ИмяНабора повторялись для каждого типа каждого составного реквизита.
Функция СведенияТипа(Модель, ТипЗначения)
	Кэш = Неопределено;
	Если Модель.Свойство("ТипыПостроения", Кэш) Тогда
		Сведения = Кэш.Получить(ТипЗначения);
		Если Сведения <> Неопределено Тогда
			Возврат ?(Сведения.Объект = Неопределено, Неопределено, Сведения);
		КонецЕсли;
	КонецЕсли;
	ОбъектТипа = Метаданные.НайтиПоТипу(ТипЗначения);
	Сведения = Новый Структура("Объект, Перечисление, ЕстьЗначения, ИмяНабора", ОбъектТипа, Ложь, Ложь, "");
	Если ОбъектТипа <> Неопределено Тогда
		Сведения.Перечисление = Метаданные.Перечисления.Содержит(ОбъектТипа);
		Сведения.ЕстьЗначения = Сведения.Перечисление И ОбъектТипа.ЗначенияПеречисления.Количество() > 0;
		Сведения.ИмяНабора = ИмяНабора(ОбъектТипа);
	КонецЕсли;
	Если Кэш <> Неопределено Тогда
		Кэш.Вставить(ТипЗначения, Сведения);
	КонецЕсли;
	Возврат ?(ОбъектТипа = Неопределено, Неопределено, Сведения);
КонецФункции

// Состав общих реквизитов одним обходом: Массив Структура("Реквизит, Разделитель, Допустим, Объекты"),
// Объекты — Соответствие «полное имя объекта → Истина», если реквизит в объекте используется; Допустим —
// реквизит не отсекается режимом разделения (см. ОбщийРеквизитВСоставе).
Функция ИндексОбщихРеквизитов()
	Свойства = Метаданные.СвойстваОбъектов;
	Индекс = Новый Массив;
	Для Каждого ОбщийРеквизит Из Метаданные.ОбщиеРеквизиты Цикл
		Разделитель = ОбщийРеквизит.РазделениеДанных = Свойства.РазделениеДанныхОбщегоРеквизита.Разделять;
		Допустим = Не Разделитель Или ОбщийРеквизит.ИспользованиеРазделяемыхДанных
			= Свойства.ИспользованиеРазделяемыхДанныхОбщегоРеквизита.НезависимоИСовместно;
		Авто = ОбщийРеквизит.АвтоИспользование = Свойства.АвтоИспользованиеОбщегоРеквизита.Использовать;
		Объекты = Новый Соответствие;
		Для Каждого ЭлементСостава Из ОбщийРеквизит.Состав Цикл
			Если ЭлементСостава.Использование = Свойства.ИспользованиеОбщегоРеквизита.Использовать
				Или Авто И ЭлементСостава.Использование = Свойства.ИспользованиеОбщегоРеквизита.Авто Тогда
				Объекты.Вставить(ЭлементСостава.Метаданные.ПолноеИмя(), Истина);
			КонецЕсли;
		КонецЦикла;
		Индекс.Добавить(Новый Структура("Реквизит, Разделитель, Допустим, Объекты", ОбщийРеквизит, Разделитель,
			Допустим, Объекты));
	КонецЦикла;
	Возврат Индекс;
КонецФункции

Функция МеньшеПоКодам(Первая, Вторая)
	Длина = Мин(СтрДлина(Первая), СтрДлина(Вторая));
	Для Индекс = 1 По Длина Цикл
		КодПервой = КодСимвола(Первая, Индекс);
		КодВторой = КодСимвола(Вторая, Индекс);
		Если КодПервой <> КодВторой Тогда
			Возврат КодПервой < КодВторой;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрДлина(Первая) < СтрДлина(Вторая);
КонецФункции

Процедура ДобавитьОбъект(Модель, ОбъектМетаданных, Префикс, ВидТаблицы, ВидСсылки)
	Набор = НовыйНабор(Префикс + ОбъектМетаданных.Имя, ВидТаблицы, ВидТаблицы + "." + ОбъектМетаданных.Имя,
		ВидСсылки + "." + ОбъектМетаданных.Имя, "");
	Набор.ПолеСвязи = "Ссылка";
	Набор.ТипСвязи = Новый ОписаниеТипов(Набор.ИмяТипаСсылки);
	Свойства = Набор.Свойства;
	Свойства.Добавить(СвойствоКлюча("Ref_Key", "Ссылка"));
	Свойства.Добавить(НовоеСвойство("DataVersion", "ВерсияДанных", "Примитив", "Edm.String"));
	Свойства.Добавить(НовоеСвойство("DeletionMark", "ПометкаУдаления", "Примитив", "Edm.Boolean"));
	Если ВидТаблицы = "Справочник" Тогда
		ДобавитьСтандартныеСправочника(Модель, Набор, ОбъектМетаданных);
	Иначе
		ДобавитьСтандартныеДокумента(Набор, ОбъектМетаданных);
	КонецЕсли;
	Для Каждого Реквизит Из ОбъектМетаданных.Реквизиты Цикл
		ДобавитьРеквизит(Модель, Свойства, Реквизит.Имя, Реквизит.Имя, Реквизит.Тип);
	КонецЦикла;
	Для Каждого Элемент Из ОбщиеРеквизитыОбъекта(Модель, ОбъектМетаданных) Цикл
		ДобавитьРеквизит(Модель, Свойства, Элемент.Реквизит.Имя, Элемент.Реквизит.Имя, Элемент.Реквизит.Тип);
	КонецЦикла;
	УбратьИсключённые(Модель, Набор, ОбъектМетаданных, "");
	ДобавитьТабличныеЧасти(Модель, Набор, ОбъектМетаданных);
	ДобавитьНабор(Модель, Набор);
КонецПроцедуры

// Табличные части ссылочного объекта — наборы «Владелец_ТЧ» (ключ Ref_Key, LineNumber) и свойства-коллекции
// владельца; исключённые составом табличные части и поля пропускаются.
Процедура ДобавитьТабличныеЧасти(Модель, Набор, ОбъектМетаданных) Экспорт
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		Если ТЧИсключена(Модель.Состав, ОбъектМетаданных, ТабличнаяЧасть.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ТЧ = НовыйНабор(Набор.Имя + "_" + ТабличнаяЧасть.Имя, "ТабличнаяЧасть",
			Набор.ТаблицаЗапроса + "." + ТабличнаяЧасть.Имя, Набор.ИмяТипаСсылки, Набор.Имя);
		ТЧ.ИмяВВладельце = ТабличнаяЧасть.Имя;
		ТЧ.ПолеСвязи = "Ссылка";
		ТЧ.ТипСвязи = Набор.ТипСвязи;
		ТЧ.Свойства.Добавить(СвойствоКлюча("Ref_Key", "Ссылка"));
		НомерСтроки = НовоеСвойство("LineNumber", "НомерСтроки", "Примитив", "Edm.Int64");
		НомерСтроки.ВКлюче = Истина;
		ТЧ.Свойства.Добавить(НомерСтроки);
		Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			ДобавитьРеквизит(Модель, ТЧ.Свойства, Реквизит.Имя, Реквизит.Имя, Реквизит.Тип);
		КонецЦикла;
		УбратьИсключённые(Модель, ТЧ, ОбъектМетаданных, ТабличнаяЧасть.Имя + ".");
		Набор.ТабличныеЧасти.Добавить(ТЧ.Имя);
		ДобавитьНабор(Модель, ТЧ);
	КонецЦикла;
КонецПроцедуры

// Коллекция в сущности без собственного набора (Скрытый): таблица «ТаблицаВладельца.ИмяТаблицы», строки
// связаны полем Ссылка, ключ строки — LineNumber, Ref_Key в строке нет. Возвращает набор коллекции; свойства
// после LineNumber добавляет вызывающий.
Функция НоваяСкрытаяКоллекция(Модель, Владелец, ИмяOData, ИмяТаблицы) Экспорт
	Коллекция = НовыйНабор(Владелец.Имя + "_" + ИмяOData, "ТабличнаяЧасть",
		Владелец.ТаблицаЗапроса + "." + ИмяТаблицы, Владелец.ИмяТипаСсылки, Владелец.Имя);
	Коллекция.ИмяВВладельце = ИмяOData;
	Коллекция.ПолеСвязи = "Ссылка";
	Коллекция.ТипСвязи = Владелец.ТипСвязи;
	Коллекция.Скрытый = Истина;
	НомерСтроки = НовоеСвойство("LineNumber", "НомерСтроки", "Примитив", "Edm.Int64");
	НомерСтроки.ВКлюче = Истина;
	Коллекция.Свойства.Добавить(НомерСтроки);
	Владелец.ТабличныеЧасти.Добавить(Коллекция.Имя);
	ДобавитьНабор(Модель, Коллекция);
	Возврат Коллекция;
КонецФункции

Процедура ДобавитьСтандартныеСправочника(Модель, Набор, ОбъектМетаданных)
	Свойства = Набор.Свойства;
	Если ОбъектМетаданных.Иерархический Тогда
		Родитель = НовоеСвойство("Parent_Key", "Родитель", "Ссылка", "Edm.Guid");
		Родитель.ИмяНавигации = "Parent";
		Родитель.ЦелевойНабор = Набор.Имя;
		Родитель.ТипСсылки = Тип(Набор.ИмяТипаСсылки);
		Свойства.Добавить(Родитель);
		Если ОбъектМетаданных.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
			Свойства.Добавить(НовоеСвойство("IsFolder", "ЭтоГруппа", "Примитив", "Edm.Boolean"));
		КонецЕсли;
	КонецЕсли;
	Если ОбъектМетаданных.Владельцы.Количество() > 0 Тогда
		ТипыВладельцев = Новый Массив;
		Для Каждого Владелец Из ОбъектМетаданных.Владельцы Цикл
			ТипыВладельцев.Добавить(Тип(ИмяТипаСсылки(Владелец)));
		КонецЦикла;
		ДобавитьРеквизит(Модель, Свойства, "Owner", "Владелец", Новый ОписаниеТипов(ТипыВладельцев));
	КонецЕсли;
	Если ОбъектМетаданных.ДлинаКода > 0 Тогда
		Если ОбъектМетаданных.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Строка Тогда
			Код = НовоеСвойство("Code", "Код", "Примитив", "Edm.String");
			Код.Длина = ОбъектМетаданных.ДлинаКода;
		Иначе
			Код = НовоеСвойство("Code", "Код", "Примитив", "Edm.Decimal");
			Код.Разрядность = ОбъектМетаданных.ДлинаКода;
		КонецЕсли;
		Свойства.Добавить(Код);
	КонецЕсли;
	Если ОбъектМетаданных.ДлинаНаименования > 0 Тогда
		Наименование = НовоеСвойство("Description", "Наименование", "Примитив", "Edm.String");
		Наименование.Длина = ОбъектМетаданных.ДлинаНаименования;
		Свойства.Добавить(Наименование);
	КонецЕсли;
	Свойства.Добавить(НовоеСвойство("Predefined", "Предопределенный", "Примитив", "Edm.Boolean"));
	Свойства.Добавить(НовоеСвойство("PredefinedDataName", "ИмяПредопределенныхДанных", "Примитив", "Edm.String"));
КонецПроцедуры

Процедура ДобавитьСтандартныеДокумента(Набор, ОбъектМетаданных)
	Свойства = Набор.Свойства;
	Если ОбъектМетаданных.ДлинаНомера > 0 Тогда
		Если ОбъектМетаданных.ТипНомера = Метаданные.СвойстваОбъектов.ТипНомераДокумента.Строка Тогда
			Номер = НовоеСвойство("Number", "Номер", "Примитив", "Edm.String");
			Номер.Длина = ОбъектМетаданных.ДлинаНомера;
		Иначе
			Номер = НовоеСвойство("Number", "Номер", "Примитив", "Edm.Decimal");
			Номер.Разрядность = ОбъектМетаданных.ДлинаНомера;
		КонецЕсли;
		Свойства.Добавить(Номер);
	КонецЕсли;
	Дата = НовоеСвойство("Date", "Дата", "Примитив", OData4_Сериализация.ТипДаты("ДатаВремя"));
	Дата.ЧастиДаты = "ДатаВремя";
	Свойства.Добавить(Дата);
	// Как в standard.odata: Posted есть у всех документов, в том числе непроводимых.
	Свойства.Добавить(НовоеСвойство("Posted", "Проведен", "Примитив", "Edm.Boolean"));
КонецПроцедуры

// Индекс наборов по составу (НоваяМодель): объекты в порядке полной сборки — справочники, документы, ссылочные
// виды 5.1, константы, журналы, регистры; у ссылочного объекта сначала наборы табличных частей (кроме исключённых
// составом), затем сам набор; у регистра — записи, затем набор по регистратору. Так же добавляли имена в Порядок
// строители наборов до этапа 6.1. Свойства, табличные части объекта метаданных и права здесь не читаются, кроме
// права чтения объекта (Публикуется) и списка табличных частей ссылочного объекта.
Процедура ЗаполнитьИндекс(Модель)
	Состав = Модель.Состав;
	Для Каждого Вид Из ВидыОбъектов() Цикл
		Для Каждого ОбъектМетаданных Из Вид.Коллекция Цикл
			Если Не Публикуется(ОбъектМетаданных, Состав) Тогда
				Продолжить;
			КонецЕсли;
			ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
			Модель.Объекты.Добавить(ПолноеИмя);
			Имя = Вид.Префикс + ОбъектМетаданных.Имя;
			Если Вид.Группа = "Ссылочный" Тогда
				Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
					Если Не ТЧИсключена(Состав, ОбъектМетаданных, ТабличнаяЧасть.Имя) Тогда
						ДобавитьВИндекс(Модель, Имя + "_" + ТабличнаяЧасть.Имя, ПолноеИмя, "ТабличнаяЧасть",
							ТабличнаяЧасть.Имя);
					КонецЕсли;
				КонецЦикла;
				ДобавитьВИндекс(Модель, Имя, ПолноеИмя, Вид.ВидТаблицы, "");
				Если Вид.ВидТаблицы = "Справочник" Или Вид.ВидТаблицы = "Документ" Тогда
					ДобавитьОсновной(Модель, ПолноеИмя, Имя);
				КонецЕсли;
			ИначеЕсли Вид.Группа = "Регистр" Тогда
				Подчинён = OData4_РегистрыМодель.ПоРегистратору(ОбъектМетаданных, Вид.ВидРегистра);
				ИмяЗаписей = Имя + ?(Подчинён, "_RecordType", "");
				ДобавитьВИндекс(Модель, ИмяЗаписей, ПолноеИмя, "Регистр", ?(Подчинён, "RecordSet", ""));
				ДобавитьОсновной(Модель, ПолноеИмя, ИмяЗаписей);
				Если Подчинён Тогда
					ДобавитьВИндекс(Модель, Имя, ПолноеИмя, "НаборЗаписей", "");
				КонецЕсли;
			Иначе
				ДобавитьВИндекс(Модель, Имя, ПолноеИмя, Вид.Группа, "");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьВИндекс(Модель, Имя, ПолноеИмя, Вид, ИмяВВладельце)
	Модель.Индекс.Вставить(Имя, Новый Структура("Объект, Вид, ИмяВВладельце", ПолноеИмя, Вид, ИмяВВладельце));
	Модель.Порядок.Добавить(Имя);
КонецПроцедуры

Процедура ДобавитьОсновной(Модель, ПолноеИмя, Имя)
	Если Модель.Основные.Получить(ПолноеИмя) = Неопределено Тогда
		Модель.Основные.Вставить(ПолноеИмя, Имя);
	КонецЕсли;
КонецПроцедуры

// Виды объектов модели в порядке сборки: Массив Структура «Коллекция, Префикс, ВидТаблицы (первая часть полного
// имени), Группа (Ссылочный, Константа, Журнал, Регистр; у константы и журнала это и вид набора), ВидРегистра».
Функция ВидыОбъектов()
	Виды = Новый Массив;
	Виды.Добавить(НовыйВидОбъектов(Метаданные.Справочники, "Catalog_", "Справочник", "Ссылочный", ""));
	Виды.Добавить(НовыйВидОбъектов(Метаданные.Документы, "Document_", "Документ", "Ссылочный", ""));
	Для Каждого Вид Из OData4_ОбъектыМодель.ВидыСсылочных() Цикл
		Виды.Добавить(НовыйВидОбъектов(Вид.Коллекция, Вид.Префикс, Вид.ВидТаблицы, "Ссылочный", ""));
	КонецЦикла;
	Виды.Добавить(НовыйВидОбъектов(Метаданные.Константы, "Constant_", "Константа", "Константа", ""));
	Виды.Добавить(НовыйВидОбъектов(Метаданные.ЖурналыДокументов, "DocumentJournal_", "ЖурналДокументов", "Журнал", ""));
	Для Каждого Вид Из OData4_РегистрыМодель.ВидыРегистров() Цикл
		Виды.Добавить(НовыйВидОбъектов(Вид.Коллекция, Вид.Префикс, Вид.ВидТаблицы, "Регистр", Вид.ВидРегистра));
	КонецЦикла;
	Возврат Виды;
КонецФункции

Функция НовыйВидОбъектов(Коллекция, Префикс, ВидТаблицы, Группа, ВидРегистра)
	Возврат Новый Структура("Коллекция, Префикс, ВидТаблицы, Группа, ВидРегистра", Коллекция, Префикс, ВидТаблицы, Группа,
		ВидРегистра);
КонецФункции

// Строит наборы объекта ПолноеИмя (сам набор, табличные части, скрытые коллекции; у регистра — записи и набор по
// регистратору), затем навигации и индексы этих наборов. Объект строится один раз.
Процедура ПостроитьОбъект(Модель, ПолноеИмя, Знач ОбъектМетаданных = Неопределено)
	Если Модель.ПостроенныеОбъекты.Получить(ПолноеИмя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ОбъектМетаданных = Неопределено Тогда
		ОбъектМетаданных = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	КонецЕсли;
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВидТаблицы = СтрРазделить(ПолноеИмя, ".")[0];
	СвойКэшТипов = Не Модель.Свойство("ТипыПостроения");
	Если СвойКэшТипов Тогда
		Модель.Вставить("ТипыПостроения", Новый Соответствие);
	КонецЕсли;
	Новые = Новый Массив;
	Модель.Вставить("НовыеНаборы", Новые);
	Попытка
		Если ВидТаблицы = "Справочник" Тогда
			ДобавитьОбъект(Модель, ОбъектМетаданных, "Catalog_", "Справочник", "СправочникСсылка");
		ИначеЕсли ВидТаблицы = "Документ" Тогда
			ДобавитьОбъект(Модель, ОбъектМетаданных, "Document_", "Документ", "ДокументСсылка");
		ИначеЕсли СтрНачинаетсяС(ВидТаблицы, "Регистр") Тогда
			OData4_РегистрыМодель.ДобавитьРегистр(Модель, ОбъектМетаданных, ВидТаблицы);
		Иначе
			OData4_ОбъектыМодель.ДобавитьОбъектВида(Модель, ОбъектМетаданных, ВидТаблицы);
		КонецЕсли;
	Исключение
		Модель.Удалить("НовыеНаборы");
		Если СвойКэшТипов Тогда
			Модель.Удалить("ТипыПостроения");
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Модель.Удалить("НовыеНаборы");
	Если СвойКэшТипов Тогда
		Модель.Удалить("ТипыПостроения");
	КонецЕсли;
	Для Каждого ОписаниеНабора Из Новые Цикл
		ЗаполнитьНавигацию(Модель, ОписаниеНабора);
	КонецЦикла;
	НовыеПоИмени = Новый Соответствие;
	Для Каждого ОписаниеНабора Из Новые Цикл
		НовыеПоИмени.Вставить(ОписаниеНабора.Имя, ОписаниеНабора);
	КонецЦикла;
	Для Каждого ОписаниеНабора Из Новые Цикл
		ЗаполнитьИндексы(Модель, ОписаниеНабора, НовыеПоИмени);
	КонецЦикла;
	Модель.ПостроенныеОбъекты.Вставить(ПолноеИмя, Истина);
КонецПроцедуры

// Оставляет навигацию только на наборы, которые есть в модели (в индексе ленивой модели).
Процедура ЗаполнитьНавигацию(Модель, ОписаниеНабора)
	Для Каждого Свойство Из ОписаниеНабора.Свойства Цикл
		Если Свойство.Вид = "Ссылка" И Модель.Индекс.Получить(Свойство.ЦелевойНабор) = Неопределено
			И Модель.Наборы.Получить(Свойство.ЦелевойНабор) = Неопределено Тогда
			Свойство.ИмяНавигации = "";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Общие реквизиты объекта без индекса построения (один объект ленивой модели): то же правило, что у
// ИндексОбщихРеквизитов, через ОбщийРеквизит.Состав.Найти по каждому общему реквизиту.
Функция ОбщиеРеквизитыПоМетаданным(ОбъектМетаданных, ВсеРазделители)
	Свойства = Метаданные.СвойстваОбъектов;
	Результат = Новый Массив;
	Для Каждого ОбщийРеквизит Из Метаданные.ОбщиеРеквизиты Цикл
		Элемент = ОбщийРеквизит.Состав.Найти(ОбъектМетаданных);
		Если Элемент = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Авто = ОбщийРеквизит.АвтоИспользование = Свойства.АвтоИспользованиеОбщегоРеквизита.Использовать;
		Если Не (Элемент.Использование = Свойства.ИспользованиеОбщегоРеквизита.Использовать
			Или Авто И Элемент.Использование = Свойства.ИспользованиеОбщегоРеквизита.Авто) Тогда
			Продолжить;
		КонецЕсли;
		Разделитель = ОбщийРеквизит.РазделениеДанных = Свойства.РазделениеДанныхОбщегоРеквизита.Разделять;
		Допустим = Не Разделитель Или ОбщийРеквизит.ИспользованиеРазделяемыхДанных
			= Свойства.ИспользованиеРазделяемыхДанныхОбщегоРеквизита.НезависимоИСовместно;
		Если Допустим Или ВсеРазделители И Разделитель Тогда
			Результат.Добавить(Новый Структура("Реквизит, Разделитель", ОбщийРеквизит, Разделитель));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Индексы набора для разбора путей и $select: ПоИмени — свойства по имени OData; ВыборПоИмени — то же
// и имена X_Type, X_Base64Data (они выводятся вместе со свойством X); Навигация — навигационные свойства
// по имени навигации; ТабличныеЧастиПоИмени — имя табличной части в владельце → имя набора табличной части.
Процедура ЗаполнитьИндексы(Модель, ОписаниеНабора, НовыеПоИмени)
	ПоИмени = Новый Соответствие;
	ВыборПоИмени = Новый Соответствие;
	Навигация = Новый Соответствие;
	Для Каждого Свойство Из ОписаниеНабора.Свойства Цикл
		ПоИмени.Вставить(Свойство.Имя, Свойство);
		ВыборПоИмени.Вставить(Свойство.Имя, Свойство);
		Если Свойство.Вид = "Составной" Или Свойство.Вид = "Хранилище" Тогда
			ВыборПоИмени.Вставить(Свойство.Имя + "_Type", Свойство);
		КонецЕсли;
		Если Свойство.Вид = "Хранилище" Тогда
			ВыборПоИмени.Вставить(Свойство.Имя + "_Base64Data", Свойство);
		КонецЕсли;
		Если Свойство.Вид = "Ссылка" И Свойство.ИмяНавигации <> "" Тогда
			Навигация.Вставить(Свойство.ИмяНавигации, Свойство);
		КонецЕсли;
	КонецЦикла;
	ТабличныеЧасти = Новый Соответствие;
	Для Каждого ИмяТЧ Из ОписаниеНабора.ТабличныеЧасти Цикл
		// Табличная часть — из наборов, построенных вместе с владельцем (имя в модели может принадлежать другому объекту).
		ТЧ = НовыеПоИмени.Получить(ИмяТЧ);
		Если ТЧ = Неопределено Тогда
			ТЧ = Модель.Наборы.Получить(ИмяТЧ);
		КонецЕсли;
		ТабличныеЧасти.Вставить(ТЧ.ИмяВВладельце, ИмяТЧ);
	КонецЦикла;
	ОписаниеНабора.Вставить("ПоИмени", ПоИмени);
	ОписаниеНабора.Вставить("ВыборПоИмени", ВыборПоИмени);
	ОписаниеНабора.Вставить("Навигация", Навигация);
	ОписаниеНабора.Вставить("ТабличныеЧастиПоИмени", ТабличныеЧасти);
	Если ОписаниеНабора.Ключ.Количество() = 0 Тогда
		ЗаполнитьКлючПоПризнаку(ОписаниеНабора);
	КонецЕсли;
КонецПроцедуры

// Имя набора OData для объекта метаданных ссылочного типа; пусто — вид не публикуется на этапе 1.
Функция ИмяНабора(ОбъектМетаданных) Экспорт
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат "Catalog_" + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.Документы.Содержит(ОбъектМетаданных) Тогда
		Возврат "Document_" + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		Возврат "ChartOfCharacteristicTypes_" + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных) Тогда
		Возврат "ChartOfAccounts_" + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных) Тогда
		Возврат "ChartOfCalculationTypes_" + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.ПланыОбмена.Содержит(ОбъектМетаданных) Тогда
		Возврат "ExchangePlan_" + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(ОбъектМетаданных) Тогда
		Возврат "BusinessProcess_" + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.Задачи.Содержит(ОбъектМетаданных) Тогда
		Возврат "Task_" + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.Перечисления.Содержит(ОбъектМетаданных) Тогда
		// Набора нет, это имя EnumType: в standard.odata — без префикса Enum_.
		Возврат ОбъектМетаданных.Имя;
	КонецЕсли;
	Возврат "";
КонецФункции

// Тип значения по имени типа OData, как его пишут standard.odata и cast (обратное ИмяНабора): «Catalog_X»,
// «Document_X», планы, обмены, бизнес-процессы, задачи — ссылка, имя перечисления без префикса — значение
// перечисления; «StandardODATA.» перед именем допускается, регистр букв — как в ИмяНабора. Наборы, которые
// модель не публикует (план счетов), тоже находятся: ссылка по GUID данных не раскрывает, запрос их проверяет.
// Структура «Тип, ИмяТипа, Перечисление» (ИмяТипа — «StandardODATA.Catalog_X», Перечисление — имя
// перечисления или ""); нет такого объекта — Неопределено.
Функция ТипПоИмениТипа(ИмяТипа) Экспорт
	Имя = ?(СтрНачинаетсяС(ИмяТипа, "StandardODATA."), Сред(ИмяТипа, 15), ИмяТипа);
	Виды = Новый Массив;
	Виды.Добавить(Новый Структура("Префикс, Коллекция, Менеджеры", "Catalog_", Метаданные.Справочники, Справочники));
	Виды.Добавить(Новый Структура("Префикс, Коллекция, Менеджеры", "Document_", Метаданные.Документы, Документы));
	Виды.Добавить(Новый Структура("Префикс, Коллекция, Менеджеры", "ChartOfCharacteristicTypes_",
		Метаданные.ПланыВидовХарактеристик, ПланыВидовХарактеристик));
	Виды.Добавить(Новый Структура("Префикс, Коллекция, Менеджеры", "ChartOfAccounts_", Метаданные.ПланыСчетов,
		ПланыСчетов));
	Виды.Добавить(Новый Структура("Префикс, Коллекция, Менеджеры", "ChartOfCalculationTypes_",
		Метаданные.ПланыВидовРасчета, ПланыВидовРасчета));
	Виды.Добавить(Новый Структура("Префикс, Коллекция, Менеджеры", "ExchangePlan_", Метаданные.ПланыОбмена,
		ПланыОбмена));
	Виды.Добавить(Новый Структура("Префикс, Коллекция, Менеджеры", "BusinessProcess_", Метаданные.БизнесПроцессы,
		БизнесПроцессы));
	Виды.Добавить(Новый Структура("Префикс, Коллекция, Менеджеры", "Task_", Метаданные.Задачи, Задачи));
	Для Каждого Вид Из Виды Цикл
		Если Не СтрНачинаетсяС(Имя, Вид.Префикс) Тогда
			Продолжить;
		КонецЕсли;
		ОбъектМетаданных = Вид.Коллекция.Найти(Сред(Имя, СтрДлина(Вид.Префикс) + 1));
		Если ОбъектМетаданных = Неопределено Или ИмяНабора(ОбъектМетаданных) <> Имя Тогда
			Возврат Неопределено;
		КонецЕсли;
		Пустая = Вид.Менеджеры[ОбъектМетаданных.Имя].ПустаяСсылка();
		Возврат Новый Структура("Тип, ИмяТипа, Перечисление", ТипЗнч(Пустая), "StandardODATA." + Имя, "");
	КонецЦикла;
	ОбъектМетаданных = Метаданные.Перечисления.Найти(Имя);
	Если ОбъектМетаданных = Неопределено Или ОбъектМетаданных.Имя <> Имя Тогда
		Возврат Неопределено;
	КонецЕсли;
	Пустая = Перечисления[Имя].ПустаяСсылка();
	Возврат Новый Структура("Тип, ИмяТипа, Перечисление", ТипЗнч(Пустая), "StandardODATA." + Имя, Имя);
КонецФункции

Функция ИмяТипаСсылки(ОбъектМетаданных)
	Если Метаданные.Справочники.Содержит(ОбъектМетаданных) Тогда
		Возврат "СправочникСсылка." + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(ОбъектМетаданных) Тогда
		Возврат "ПланВидовХарактеристикСсылка." + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.ПланыСчетов.Содержит(ОбъектМетаданных) Тогда
		Возврат "ПланСчетовСсылка." + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.ПланыОбмена.Содержит(ОбъектМетаданных) Тогда
		Возврат "ПланОбменаСсылка." + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.ПланыВидовРасчета.Содержит(ОбъектМетаданных) Тогда
		Возврат "ПланВидовРасчетаСсылка." + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.БизнесПроцессы.Содержит(ОбъектМетаданных) Тогда
		Возврат "БизнесПроцессСсылка." + ОбъектМетаданных.Имя;
	ИначеЕсли Метаданные.Задачи.Содержит(ОбъектМетаданных) Тогда
		Возврат "ЗадачаСсылка." + ОбъектМетаданных.Имя;
	КонецЕсли;
	Возврат "ДокументСсылка." + ОбъектМетаданных.Имя;
КонецФункции

// Ключ набора по признаку ВКлюче — для справочников, документов и табличных частей
// (Ref_Key и, у табличной части, LineNumber). Наборы регистров заполняют Ключ сами.
Процедура ЗаполнитьКлючПоПризнаку(Набор)
	Для Каждого Свойство Из Набор.Свойства Цикл
		Если Свойство.ВКлюче Тогда
			Набор.Ключ.Добавить(Свойство.Имя);
			Набор.ПоляКлюча.Добавить(Свойство);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
