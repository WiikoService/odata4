#Область ПрограммныйИнтерфейс

// Параметры запроса → опции разбора, как OData4_Разбор.РазобратьПараметры. Движок выбирают настройки
// регистра OData4_Настройки: язык 1С (по умолчанию) или внешняя компонента OData4Native. При «Сверке
// движков» работают оба, расхождение пишется в журнал регистрации (событие OData4.СверкаДвижков, ошибка).
// Компонента недоступна (безопасный режим расширения) или дала сбой — разбор на языке 1С и предупреждение
// в журнале регистрации (событие OData4.Компонента).
// Компонента $apply не разбирает: при её участии $apply вынимается из параметров, оба движка разбирают
// остальные параметры, а $apply разбирает OData4_Разбор.РазобратьПреобразование (Опции.apply).
// Поэтому в режимах компоненты и сверки $apply разбирается после остальных параметров: если ошибки
// есть и в $apply, и в другом параметре, ответ называет ошибку другого параметра, тогда как
// OData4_Разбор.РазобратьПараметры (режим по умолчанию) идёт по параметрам в порядке их перебора и может
// первой назвать ошибку $apply. Статус и текст каждой ошибки в обоих режимах одинаковы.
Функция РазобратьПараметры(ПараметрыЗапроса) Экспорт
	Настройки = НастройкиДвижка();
	Если Не Настройки.ИспользоватьКомпоненту И Не Настройки.СверкаДвижков Тогда
		Возврат OData4_Разбор.РазобратьПараметры(ПараметрыЗапроса);
	КонецЕсли;
	// Параметр передан по ссылке: копия без $apply — в отдельной переменной, исходное Соответствие не меняется.
	ТекстApply = ПараметрыЗапроса.Получить("$apply");
	ПараметрыДвижков = ?(ТекстApply = Неопределено, ПараметрыЗапроса, ПараметрыБезApply(ПараметрыЗапроса));
	Опции = ОпцииДвижков(ПараметрыДвижков, Настройки);
	Если Не Опции.Свойство("apply") Тогда
		Опции.Вставить("apply", Неопределено);
	КонецЕсли;
	Если ТекстApply <> Неопределено Тогда
		Опции.apply = OData4_Разбор.РазобратьПреобразование(ТекстApply);
	КонецЕсли;
	Возврат Опции;
КонецФункции

// Разбор только компонентой (тесты и сверка): опции (без ключа apply) или исключение OData 400/501; сбой
// компоненты — обычное исключение «Сбой компоненты OData4Native: …». $apply компонента не разбирает (501).
Функция РазобратьКомпонентой(ПараметрыЗапроса) Экспорт
	Ответ = ОтветКомпоненты(ПарыПараметров(ПараметрыЗапроса));
	Если Ответ.Вид = "failure" Тогда
		ВызватьИсключение "Сбой компоненты OData4Native: " + Ответ.Сообщение;
	КонецЕсли;
	Возврат ОпцииОтвета(Ответ);
КонецФункции

// Состояние компоненты: Доступна, Версия, Ошибка, БезопасныйРежим (безопасный режим расширения OData4,
// при котором платформа запрещает подключение компоненты — проба P9 этапа 0).
Функция СостояниеКомпоненты() Экспорт
	Состояние = Новый Структура("Доступна, Версия, Ошибка, БезопасныйРежим", Ложь, "", "", БезопасныйРежим() <> Ложь);
	Причина = "";
	Компонента = НоваяКомпонента(Причина);
	Если Компонента = Неопределено Тогда
		Состояние.Ошибка = Причина;
		Возврат Состояние;
	КонецЕсли;
	Попытка
		Состояние.Версия = Компонента.Версия();
		Состояние.Доступна = Истина;
	Исключение
		Состояние.Ошибка = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Состояние;
КонецФункции

// Настройки движка разбора: Структура «ИспользоватьКомпоненту, СверкаДвижков»; записи нет — обе Ложь.
// Регистр не прочитан — тоже обе Ложь (разбор на языке 1С) и предупреждение в журнале (OData4.Настройки).
// Причина — платформа: у HTTP-сервиса с повторным использованием сеансов (AutoUse, SessionMaxAge=20)
// запрос, пришедший за ~0,1 с до истечения 20 с простоя сеанса, получает сеанс, в котором таблицы
// расширения недоступны: «Таблица не найдена "РегистрСведений.OData4_Настройки"», хотя
// Метаданные.РегистрыСведений.OData4_Настройки есть, запрос к таблице конфигурации в том же сеансе
// выполняется, а повтор в течение 3 с даёт ту же ошибку (проба: 7 из 18 запросов после простоя
// 19,85–19,95 с). Остальной запрос читает только таблицы конфигурации и проходит.
// Откат ловит любой сбой чтения, в том числе настоящее отсутствие таблицы после неудачного развёртывания:
// поэтому в предупреждение идёт подробный текст исключения (ПодробноеПредставлениеОшибки).
Функция НастройкиДвижка() Экспорт
	Попытка
		Возврат ПрочитатьНастройкиДвижка();
	Исключение
		ЗаписьЖурналаРегистрации("OData4.Настройки", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Настройки движка не прочитаны, разбор на языке 1С: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Новый Структура("ИспользоватьКомпоненту, СверкаДвижков", Ложь, Ложь);
КонецФункции

// Настройки движка из регистра без отката: сбой чтения — исключение. Для тех, кому значения по умолчанию
// вместо непрочитанных недопустимы (тесты сохраняют настройки и потом записывают их обратно).
Функция ПрочитатьНастройкиДвижка() Экспорт
	Настройки = Новый Структура("ИспользоватьКомпоненту, СверкаДвижков", Ложь, Ложь);
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		|	Н.ИспользоватьКомпонентуДляРазбора КАК ИспользоватьКомпоненту,
		|	Н.СверкаДвижков КАК СверкаДвижков
		|ИЗ
		|	РегистрСведений.OData4_Настройки КАК Н");
	Выборка = OData4_Хранилище.ВыполнитьЗапрос(Запрос).Выбрать();
	Если Выборка.Следующий() Тогда
		Настройки.ИспользоватьКомпоненту = (Выборка.ИспользоватьКомпоненту = Истина);
		Настройки.СверкаДвижков = (Выборка.СверкаДвижков = Истина);
	КонецЕсли;
	Возврат Настройки;
КонецФункции

// Записывает настройки движка (регистр без измерений — одна запись); остальные ресурсы регистра не
// меняются (OData4_НастройкиСервиса.Записать читает запись перед записью).
Процедура УстановитьНастройкиДвижка(ИспользоватьКомпоненту, СверкаДвижков) Экспорт
	Изменения = Новый Структура;
	Изменения.Вставить("ИспользоватьКомпонентуДляРазбора", ИспользоватьКомпоненту);
	Изменения.Вставить("СверкаДвижков", СверкаДвижков);
	OData4_НастройкиСервиса.Записать(Изменения);
КонецПроцедуры

// Сверка итогов движков («статус текст» или канонический JSON дерева). Истина — совпали; иначе запись
// в журнал регистрации (событие OData4.СверкаДвижков, уровень «Ошибка») с параметрами и обоими итогами.
Функция СверитьИтоги(Пары, Итог1С, ИтогКомпоненты) Экспорт
	Если Итог1С = ИтогКомпоненты Тогда
		Возврат Истина;
	КонецЕсли;
	ЗаписьЖурналаРегистрации("OData4.СверкаДвижков", УровеньЖурналаРегистрации.Ошибка, , ,
		"Параметры: " + Пары + Символы.ПС + "1С: " + Итог1С + Символы.ПС + "Компонента: " + ИтогКомпоненты);
	Возврат Ложь;
КонецФункции

// Режим движка этапа 8 по настройке ИмяНастройки (РежимВыдачи, РежимРазбораТел, РежимМетаданных): "BSL",
// "Компонента" или "Сверка" (оба движка, ответ — BSL, расхождение — в журнал регистрации). Компонента не
// подключается (безопасный режим расширения, сбой подключения) — "BSL" без записи в журнал: причина видна в форме
// настроек, а запись на каждый запрос засорила бы журнал.
Функция РежимДвижка(ИмяНастройки) Экспорт
	Режим = OData4_НастройкиСервиса.Значение(ИмяНастройки, "BSL");
	Если Режим <> "Компонента" И Режим <> "Сверка" Тогда
		Возврат "BSL";
	КонецЕсли;
	Причина = "";
	Если НоваяКомпонента(Причина) = Неопределено Тогда
		Возврат "BSL";
	КонецЕсли;
	Возврат Режим;
КонецФункции

// Объект компоненты OData4Native сеанса (один на сеанс, см. OData4_ДвижокПовтИсп.Компонента) или Неопределено.
Функция КомпонентаСеанса() Экспорт
	Причина = "";
	Возврат НоваяКомпонента(Причина);
КонецФункции

// Сбой компоненты этапа 8 (исключение, паника, неверный ответ): запрос обслуживает язык 1С, в журнал регистрации —
// событие OData4.Компонента с уровнем «Ошибка», что делалось (Описание) и текст сбоя.
Процедура ЗаписатьСбойКомпоненты(Описание, ТекстСбоя) Экспорт
	ЗаписьЖурналаРегистрации("OData4.Компонента", УровеньЖурналаРегистрации.Ошибка, , ,
		Описание + ": ответ на языке 1С. Сбой компоненты: " + ТекстСбоя);
КонецПроцедуры

// Расхождение движков этапа 8 в режиме «Сверка»: Истина — итоги совпали; иначе запись в журнал регистрации (событие
// Событие — OData4.СверкаВыдачи, OData4.СверкаТел или OData4.СверкаМетаданных, уровень «Ошибка»): Описание (что
// сверялось), длины и хеши SHA-256 обоих итогов, место первого расхождения и по 300 символов вокруг него.
Функция СверитьВыходы(Событие, Описание, ИтогBSL, ИтогКомпоненты) Экспорт
	Если ИтогBSL = ИтогКомпоненты Тогда
		Возврат Истина;
	КонецЕсли;
	Место = 1;
	Длина = Мин(СтрДлина(ИтогBSL), СтрДлина(ИтогКомпоненты));
	Пока Место <= Длина И Сред(ИтогBSL, Место, 1) = Сред(ИтогКомпоненты, Место, 1) Цикл
		Место = Место + 1;
	КонецЦикла;
	Начало = Макс(1, Место - 100);
	ЗаписьЖурналаРегистрации(Событие, УровеньЖурналаРегистрации.Ошибка, , ,
		Описание + Символы.ПС + "Первое расхождение: символ " + Формат(Место, "ЧГ=0") + Символы.ПС
		+ "BSL (" + Формат(СтрДлина(ИтогBSL), "ЧН=0; ЧГ=0") + " симв., " + ХешИтога(ИтогBSL) + "): …"
		+ Сред(ИтогBSL, Начало, 300) + "…" + Символы.ПС
		+ "Компонента (" + Формат(СтрДлина(ИтогКомпоненты), "ЧН=0; ЧГ=0") + " симв., " + ХешИтога(ИтогКомпоненты)
		+ "): …" + Сред(ИтогКомпоненты, Начало, 300) + "…");
	Возврат Ложь;
КонецФункции

// JSON с ключами объектов по возрастанию кодов символов — одинаковое представление деревьев обоих движков.
Функция Канон(Значение) Экспорт
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Или ТипЗначения = Тип("ФиксированнаяСтруктура") Тогда
		Ключи = Новый Массив;
		Для Каждого КлючИЗначение Из Значение Цикл
			Ключи.Добавить(Строка(КлючИЗначение.Ключ));
		КонецЦикла;
		Части = Новый Массив;
		Для Каждого Ключ Из OData4_Модель.УпорядочитьСтроки(Ключи) Цикл
			Части.Добавить(СтрокаJSON(Ключ) + ":" + Канон(Значение[Ключ]));
		КонецЦикла;
		Возврат "{" + СтрСоединить(Части, ",") + "}";
	ИначеЕсли ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Части = Новый Массив;
		Для Каждого Элемент Из Значение Цикл
			Части.Добавить(Канон(Элемент));
		КонецЦикла;
		Возврат "[" + СтрСоединить(Части, ",") + "]";
	ИначеЕсли Значение = Неопределено Тогда
		Возврат "null";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧРД=.; ЧН=0; ЧГ=0");
	КонецЕсли;
	Возврат СтрокаJSON(Строка(Значение));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Опции параметров без $apply от компоненты, от движка на языке 1С или от обоих со сверкой.
// Сверка сравнивает деревья без ключа apply: компонента его не выдаёт.
Функция ОпцииДвижков(ПараметрыЗапроса, Настройки)
	Пары = ПарыПараметров(ПараметрыЗапроса);
	Ответ = ОтветКомпоненты(Пары);
	Если Ответ.Вид = "failure" Тогда
		ЗаписьЖурналаРегистрации("OData4.Компонента", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Разбор на языке 1С: " + Ответ.Сообщение);
		Возврат OData4_Разбор.РазобратьПараметры(ПараметрыЗапроса);
	КонецЕсли;
	Если Не Настройки.СверкаДвижков Тогда
		Возврат ОпцииОтвета(Ответ);
	КонецЕсли;
	ИтогКомпоненты = ИтогОтвета(Ответ);
	Попытка
		Опции = OData4_Разбор.РазобратьПараметры(ПараметрыЗапроса);
	Исключение
		СверитьИтоги(Пары, ИтогИсключения(ИнформацияОбОшибке()), ИтогКомпоненты);
		Если Настройки.ИспользоватьКомпоненту Тогда
			Возврат ОпцииОтвета(Ответ);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	СверитьИтоги(Пары, Канон(ОпцииБезApply(Опции)), ИтогКомпоненты);
	Если Настройки.ИспользоватьКомпоненту Тогда
		Возврат ОпцииОтвета(Ответ);
	КонецЕсли;
	Возврат Опции;
КонецФункции

// Копия параметров запроса без $apply.
Функция ПараметрыБезApply(ПараметрыЗапроса)
	Результат = Новый Соответствие;
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Если КлючИЗначение.Ключ <> "$apply" Тогда
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Копия опций верхнего уровня без ключа apply — для сравнения с деревом компоненты.
Функция ОпцииБезApply(Опции)
	Результат = Новый Структура;
	Для Каждого КлючИЗначение Из Опции Цикл
		Если КлючИЗначение.Ключ <> "apply" Тогда
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Параметры запроса → JSON-массив пар в порядке перебора (тот же порядок видит движок на языке 1С).
Функция ПарыПараметров(ПараметрыЗапроса)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Запись.ЗаписатьНачалоМассива();
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Запись.ЗаписатьНачалоМассива();
		Запись.ЗаписатьЗначение(Строка(КлючИЗначение.Ключ));
		Запись.ЗаписатьЗначение(Строка(КлючИЗначение.Значение));
		Запись.ЗаписатьКонецМассива();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Возврат Запись.Закрыть();
КонецФункции

// Ответ компоненты: Структура «Вид (options, error, failure), Опции, Статус, Сообщение».
Функция ОтветКомпоненты(Пары)
	Ответ = Новый Структура("Вид, Опции, Статус, Сообщение", "failure", Неопределено, 0, "");
	Причина = "";
	Компонента = НоваяКомпонента(Причина);
	Если Компонента = Неопределено Тогда
		Ответ.Сообщение = Причина;
		Возврат Ответ;
	КонецЕсли;
	Попытка
		Текст = Компонента.РазобратьПараметры(Пары);
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Ложь);
		Чтение.Закрыть();
	Исключение
		Ответ.Сообщение = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Ответ;
	КонецПопытки;
	Если Данные.Свойство("options") Тогда
		Ответ.Вид = "options";
		Ответ.Опции = Данные.options;
	ИначеЕсли Данные.Свойство("error") Тогда
		Ответ.Вид = "error";
		Ответ.Статус = Данные.error.status;
		Ответ.Сообщение = Данные.error.message;
	ИначеЕсли Данные.Свойство("failure") Тогда
		Ответ.Сообщение = Данные.failure;
	Иначе
		Ответ.Сообщение = "неизвестный ответ компоненты: " + Лев(Текст, 200);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

// Опции из ответа компоненты; ошибка разбора — исключение OData с тем же статусом и текстом.
Функция ОпцииОтвета(Ответ)
	Если Ответ.Вид = "error" Тогда
		OData4_Сервис.ОшибкаOData(Ответ.Статус, ?(Ответ.Статус = 501, "NotImplemented", "BadRequest"), Ответ.Сообщение);
	КонецЕсли;
	Возврат Ответ.Опции;
КонецФункции

// Итог компоненты для сверки: канонический JSON дерева, «статус текст» или «сбой: текст».
Функция ИтогОтвета(Ответ)
	Если Ответ.Вид = "options" Тогда
		Возврат Канон(Ответ.Опции);
	ИначеЕсли Ответ.Вид = "error" Тогда
		Возврат Формат(Ответ.Статус, "ЧН=0; ЧГ=0") + " " + Ответ.Сообщение;
	КонецЕсли;
	Возврат "сбой: " + Ответ.Сообщение;
КонецФункции

// Итог движка на языке 1С при исключении: «статус текст» для ошибок OData, иначе «исключение текст».
Функция ИтогИсключения(Информация)
	Текст = Информация.Описание;
	Позиция = СтрНайти(Текст, "ODATA4|");
	Если Позиция = 0 Тогда
		Возврат "исключение " + Текст;
	КонецЕсли;
	Части = СтрРазделить(Сред(Текст, Позиция), "|");
	Сообщение = Новый Массив;
	Для Индекс = 3 По Части.ВГраница() Цикл
		Сообщение.Добавить(Части[Индекс]);
	КонецЦикла;
	Возврат Части[1] + " " + СтрСоединить(Сообщение, "|");
КонецФункции

// Объект компоненты или Неопределено с причиной (в безопасном режиме расширения подключение запрещено).
// Объект компоненты берётся из кэша на сеанс: создавать его на каждый разбор нельзя — платформа
// падает на 475-м повторении цикла жизни объекта (см. OData4_ДвижокПовтИсп.Компонента).
Функция ХешИтога(Текст)
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(Текст);
	Возврат "SHA-256 " + НРег(СтрЗаменить(Строка(Хеш.ХешСумма), " ", ""));
КонецФункции

Функция НоваяКомпонента(Причина)
	Состояние = OData4_ДвижокПовтИсп.Компонента();
	Причина = Состояние.Причина;
	Возврат Состояние.Объект;
КонецФункции

Функция СтрокаJSON(Текст)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Запись.ЗаписатьЗначение(Текст);
	Возврат Запись.Закрыть();
КонецФункции

#КонецОбласти
