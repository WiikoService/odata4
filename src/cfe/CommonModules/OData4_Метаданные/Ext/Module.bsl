#Область ПрограммныйИнтерфейс

// Документ $metadata в формате CSDL XML 4.0.
Функция ДокументCSDL(Знач Модель = Неопределено) Экспорт
	Если Модель = Неопределено Тогда
		Модель = OData4_МодельПовтИсп.Модель();
	КонецЕсли;
	// $metadata строит всё: по ленивой модели сеанса — во временной полной копии (решение 6.1).
	Модель = OData4_Модель.Целиком(Модель);
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку("UTF-8");
	Запись.ЗаписатьОбъявлениеXML();
	Запись.ЗаписатьНачалоЭлемента("edmx:Edmx");
	Запись.ЗаписатьСоответствиеПространстваИмен("edmx", "http://docs.oasis-open.org/odata/ns/edmx");
	Запись.ЗаписатьАтрибут("Version", "4.0");
	Запись.ЗаписатьНачалоЭлемента("edmx:DataServices");
	Запись.ЗаписатьНачалоЭлемента("Schema");
	Запись.ЗаписатьСоответствиеПространстваИмен("", "http://docs.oasis-open.org/odata/ns/edm");
	Запись.ЗаписатьАтрибут("Namespace", "StandardODATA");
	Для Каждого Описание0 Из ОписанияПеречислений(Модель) Цикл
		ЗаписатьПеречисление(Запись, Описание0);
	КонецЦикла;
	Если Модель.ЕстьОписаниеТипов Тогда
		ЗаписатьОписаниеТипов(Запись);
	КонецЕсли;
	Для Каждого Имя Из Модель.Порядок Цикл
		Набор = OData4_Модель.НайтиНабор(Модель, Имя);
		Если Набор.Вид = "ТабличнаяЧасть" Тогда
			ЗаписатьТип(Запись, "ComplexType", Набор.Имя + "_RowType", Набор, Модель, Ложь);
		ИначеЕсли Набор.Вид = "Регистр" И Набор.Родитель <> "" Тогда
			ЗаписатьТип(Запись, "ComplexType", Набор.Родитель + "_RowType", Набор, Модель, Ложь);
		КонецЕсли;
		Для Каждого ИмяТЧ Из Набор.ТабличныеЧасти Цикл
			ТЧ = OData4_Модель.НайтиНабор(Модель, ИмяТЧ);
			Если ТЧ.Скрытый Тогда
				ЗаписатьТип(Запись, "ComplexType", ТЧ.Имя, ТЧ, Модель, Ложь);
			КонецЕсли;
		КонецЦикла;
		ЗаписатьТип(Запись, "EntityType", Набор.Имя, Набор, Модель, Истина);
		ЗаписатьТипыРезультатов(Запись, Набор);
	КонецЦикла;
	Для Каждого Имя Из Модель.Порядок Цикл
		Набор = OData4_Модель.НайтиНабор(Модель, Имя);
		ЗаписатьФункцииНабора(Запись, Набор);
		OData4_Действия.ЗаписатьДействияCSDL(Запись, Набор);
	КонецЦикла;
	Запись.ЗаписатьНачалоЭлемента("EntityContainer");
	Запись.ЗаписатьАтрибут("Name", "EnterpriseV8");
	Для Каждого Имя Из Модель.Порядок Цикл
		ЗаписатьНаборСущностей(Запись, OData4_Модель.НайтиНабор(Модель, Имя));
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Запись.ЗаписатьКонецЭлемента();
	Возврат Запись.Закрыть();
КонецФункции

// Документ $metadata в формате CSDL JSON (OData CSDL JSON, $Version 4.0): те же перечисления, типы
// и наборы, что в ДокументCSDL. В CSDL JSON $Nullable по умолчанию false, $Type по умолчанию Edm.String.
Функция ДокументCSDLJSON(Знач Модель = Неопределено) Экспорт
	Если Модель = Неопределено Тогда
		Модель = OData4_МодельПовтИсп.Модель();
	КонецЕсли;
	// $metadata строит всё: по ленивой модели сеанса — во временной полной копии (решение 6.1).
	Модель = OData4_Модель.Целиком(Модель);
	Запись = OData4_Сериализация.НоваяЗапись();
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПару(Запись, "$Version", "4.0");
	ЗаписатьПару(Запись, "$EntityContainer", "StandardODATA.EnterpriseV8");
	Запись.ЗаписатьИмяСвойства("StandardODATA");
	Запись.ЗаписатьНачалоОбъекта();
	Функции = Новый Структура("Имена, Перегрузки", Новый Массив, Новый Соответствие);
	Для Каждого Описание0 Из ОписанияПеречислений(Модель) Цикл
		ЗаписатьПеречислениеJSON(Запись, Описание0);
	КонецЦикла;
	Если Модель.ЕстьОписаниеТипов Тогда
		ЗаписатьОписаниеТиповJSON(Запись);
	КонецЕсли;
	Для Каждого Имя Из Модель.Порядок Цикл
		Набор = OData4_Модель.НайтиНабор(Модель, Имя);
		Если Набор.Вид = "ТабличнаяЧасть" Тогда
			ЗаписатьТипJSON(Запись, "ComplexType", Набор.Имя + "_RowType", Набор, Модель, Ложь);
		ИначеЕсли Набор.Вид = "Регистр" И Набор.Родитель <> "" Тогда
			ЗаписатьТипJSON(Запись, "ComplexType", Набор.Родитель + "_RowType", Набор, Модель, Ложь);
		КонецЕсли;
		Для Каждого ИмяТЧ Из Набор.ТабличныеЧасти Цикл
			ТЧ = OData4_Модель.НайтиНабор(Модель, ИмяТЧ);
			Если ТЧ.Скрытый Тогда
				ЗаписатьТипJSON(Запись, "ComplexType", ТЧ.Имя, ТЧ, Модель, Ложь);
			КонецЕсли;
		КонецЦикла;
		ЗаписатьТипJSON(Запись, "EntityType", Набор.Имя, Набор, Модель, Истина);
		ЗаписатьТипыРезультатовJSON(Запись, Набор);
		СобратьФункцииJSON(Функции, Набор);
	КонецЦикла;
	ЗаписатьФункцииJSON(Запись, Функции);
	OData4_Действия.ЗаписатьДействияJSON(Запись, Модель);
	Запись.ЗаписатьИмяСвойства("EnterpriseV8");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПару(Запись, "$Kind", "EntityContainer");
	Для Каждого Имя Из Модель.Порядок Цикл
		ЗаписатьНаборСущностейJSON(Запись, OData4_Модель.НайтиНабор(Модель, Имя));
	КонецЦикла;
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
КонецФункции

// Документ $metadata ВидДокумента ("XML" или "JSON") по модели Модель движком настройки РежимМетаданных (этап 8.3):
// BSL — ДокументCSDL / ДокументCSDLJSON; Компонента — метод ВывестиCSDL компоненты OData4Native по ОписаниеCSDL, её
// сбой — OData4_Движок.ЗаписатьСбойКомпоненты и документ BSL; Сверка — оба движка, ответ BSL, расхождение —
// событие OData4.СверкаМетаданных.
Функция Документ(Знач Модель, ВидДокумента) Экспорт
	Режим = OData4_Движок.РежимДвижка("РежимМетаданных");
	Если Режим = "BSL" Тогда
		Возврат ДокументBSL(Модель, ВидДокумента);
	КонецЕсли;
	// Одна полная копия на оба движка (при ленивой модели сеанса Целиком строит её заново).
	Модель = OData4_Модель.Целиком(Модель);
	ТекстСбоя = "";
	ИтогКомпоненты = ДокументКомпонентой(Модель, ВидДокумента, ТекстСбоя);
	Описание = "$metadata " + ВидДокумента;
	Если ИтогКомпоненты = Неопределено Тогда
		OData4_Движок.ЗаписатьСбойКомпоненты(Описание, ТекстСбоя);
		Возврат ДокументBSL(Модель, ВидДокумента);
	ИначеЕсли Режим = "Компонента" Тогда
		Возврат ИтогКомпоненты;
	КонецЕсли;
	ИтогBSL = ДокументBSL(Модель, ВидДокумента);
	OData4_Движок.СверитьВыходы("OData4.СверкаМетаданных", Описание, ИтогBSL, ИтогКомпоненты);
	Возврат ИтогBSL;
КонецФункции

// Документ $metadata компонентой OData4Native (без отката к BSL) или Неопределено и причина в ТекстСбоя: компонента
// недоступна, исключение вызова, ответ {"failure": …}. Для тестов и режимов «Компонента» и «Сверка».
Функция ДокументКомпонентой(Знач Модель, ВидДокумента, ТекстСбоя = "") Экспорт
	Компонента = OData4_Движок.КомпонентаСеанса();
	Если Компонента = Неопределено Тогда
		ТекстСбоя = "компонента недоступна";
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Текст = Компонента.ВывестиCSDL(ОписаниеCSDL(Модель), ?(ВидДокумента = "JSON", "JSON", "XML"));
	Исключение
		ТекстСбоя = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Неопределено;
	КонецПопытки;
	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		ТекстСбоя = "ответ компоненты не строка: " + Строка(ТипЗнч(Текст));
		Возврат Неопределено;
	ИначеЕсли СтрНачинаетсяС(Текст, "{""failure""") Тогда
		ТекстСбоя = Текст;
		Возврат Неопределено;
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Описание модели для вывода CSDL компонентой (контракт — native/odata4_core/src/csdl.rs, версия 1): JSON с
// перечислениями, признаком описания типов, наборами в порядке модели и скрытыми коллекциями, на которые ссылаются
// табличные части. Модель — любая (ленивая строится во временной полной копии). Общие примеры —
// tests/fixtures/metadata/*.json (поле model), обратное преобразование — МодельИзОписанияCSDL.
Функция ОписаниеCSDL(Знач Модель) Экспорт
	Модель = OData4_Модель.Целиком(Модель);
	Запись = OData4_Сериализация.НоваяЗапись();
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПару(Запись, "Версия", 1);
	ЗаписатьПару(Запись, "ЕстьОписаниеТипов", Модель.ЕстьОписаниеТипов = Истина);
	Запись.ЗаписатьИмяСвойства("Перечисления");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого Описание0 Из ОписанияПеречислений(Модель) Цикл
		Запись.ЗаписатьНачалоОбъекта();
		ЗаписатьПару(Запись, "Имя", Описание0.Имя);
		Запись.ЗаписатьИмяСвойства("Члены");
		Запись.ЗаписатьНачалоМассива();
		Для Каждого ИмяЗначения Из Описание0.Члены Цикл
			Запись.ЗаписатьЗначение(ИмяЗначения);
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Записанные = Новый Соответствие;
	Коллекции = Новый Массив;
	Запись.ЗаписатьИмяСвойства("Наборы");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого Имя Из Модель.Порядок Цикл
		Записанные.Вставить(Имя, Истина);
	КонецЦикла;
	Для Каждого Имя Из Модель.Порядок Цикл
		Набор = OData4_Модель.НайтиНабор(Модель, Имя);
		ЗаписатьНаборОписания(Запись, Набор);
		ДобавитьКоллекции(Модель, Набор, Записанные, Коллекции);
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьИмяСвойства("Коллекции");
	Запись.ЗаписатьНачалоМассива();
	Индекс = 0;
	// Коллекции дописываются в Коллекции по ходу (у скрытой коллекции могут быть свои табличные части).
	Пока Индекс < Коллекции.Количество() Цикл
		ЗаписатьНаборОписания(Запись, Коллекции[Индекс]);
		ДобавитьКоллекции(Модель, Коллекции[Индекс], Записанные, Коллекции);
		Индекс = Индекс + 1;
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();
	Возврат Запись.Закрыть();
КонецФункции

// Модель для ДокументCSDL / ДокументCSDLJSON по описанию ОписаниеCSDL (текст JSON): наборы — Структуры с теми же
// именами полей, что у описаний OData4_Модель, перечисления и виртуальные таблицы — массивами (порядок описания).
// Для общих примеров tests/fixtures/metadata и проверки полноты описания.
Функция МодельИзОписанияCSDL(Текст) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Если Данные.Получить("Версия") <> 1 Тогда
		ВызватьИсключение "Описание модели CSDL: неизвестная версия " + Строка(Данные.Получить("Версия"));
	КонецЕсли;
	Модель = Новый Структура;
	Модель.Вставить("Наборы", Новый Соответствие);
	Модель.Вставить("Перечисления", Новый Массив);
	Модель.Вставить("Порядок", Новый Массив);
	Модель.Вставить("ЕстьОписаниеТипов", Данные.Получить("ЕстьОписаниеТипов") = Истина);
	// Все наборы уже есть: OData4_Модель.Целиком и НайтиНабор ничего не достраивают.
	Модель.Вставить("Построена", Истина);
	Для Каждого Элемент Из Данные.Получить("Перечисления") Цикл
		Модель.Перечисления.Добавить(Новый Структура("Имя, Члены", Элемент.Получить("Имя"), Элемент.Получить("Члены")));
	КонецЦикла;
	Для Каждого Элемент Из Данные.Получить("Наборы") Цикл
		Набор = НаборИзОписания(Элемент);
		Модель.Наборы.Вставить(Набор.Имя, Набор);
		Модель.Порядок.Добавить(Набор.Имя);
	КонецЦикла;
	Коллекции = Данные.Получить("Коллекции");
	Если Коллекции <> Неопределено Тогда
		Для Каждого Элемент Из Коллекции Цикл
			Набор = НаборИзОписания(Элемент);
			Модель.Наборы.Вставить(Набор.Имя, Набор);
		КонецЦикла;
	КонецЕсли;
	Возврат Модель;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДокументBSL(Модель, ВидДокумента)
	Если ВидДокумента = "JSON" Тогда
		Возврат ДокументCSDLJSON(Модель);
	КонецЕсли;
	Возврат ДокументCSDL(Модель);
КонецФункции

// Перечисления модели в порядке вывода: Массив Структура «Имя, Члены». У модели OData4_Модель Перечисления —
// Соответствие «имя → объект метаданных» (обход в его порядке), у модели из описания — уже массив описаний.
Функция ОписанияПеречислений(Модель)
	Если ТипЗнч(Модель.Перечисления) = Тип("Массив") Тогда
		Возврат Модель.Перечисления;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из Модель.Перечисления Цикл
		Результат.Добавить(Новый Структура("Имя, Члены", OData4_Модель.ИмяНабора(КлючИЗначение.Значение),
			OData4_Модель.ИменаЗначенийПеречисления(КлючИЗначение.Значение)));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Описания виртуальных таблиц набора в порядке вывода: у набора OData4_Модель — значения Соответствие в порядке его
// обхода, у набора из описания — массив.
Функция ВиртуальныеТаблицыНабора(Набор)
	Если ТипЗнч(Набор.ВиртуальныеТаблицы) = Тип("Массив") Тогда
		Возврат Набор.ВиртуальныеТаблицы;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого КлючИЗначение Из Набор.ВиртуальныеТаблицы Цикл
		Результат.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Набор ОписаниеCSDL: поля, которые читает вывод CSDL.
Процедура ЗаписатьНаборОписания(Запись, Набор)
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПару(Запись, "Имя", Набор.Имя);
	ЗаписатьПару(Запись, "Вид", Набор.Вид);
	ЗаписатьПару(Запись, "Родитель", Набор.Родитель);
	ЗаписатьПару(Запись, "ИмяВВладельце", Набор.ИмяВВладельце);
	ЗаписатьПару(Запись, "Скрытый", Набор.Скрытый = Истина);
	Запись.ЗаписатьИмяСвойства("Ключ");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого ИмяСвойства Из Набор.Ключ Цикл
		Запись.ЗаписатьЗначение(ИмяСвойства);
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	ЗаписатьСвойстваОписания(Запись, Набор.Свойства);
	Запись.ЗаписатьИмяСвойства("ТабличныеЧасти");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого ИмяТЧ Из Набор.ТабличныеЧасти Цикл
		Запись.ЗаписатьЗначение(ИмяТЧ);
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьИмяСвойства("ВиртуальныеТаблицы");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого Описание0 Из ВиртуальныеТаблицыНабора(Набор) Цикл
		Запись.ЗаписатьНачалоОбъекта();
		ЗаписатьПару(Запись, "Имя", Описание0.Имя);
		ЗаписатьПару(Запись, "ИмяТипа", Описание0.ИмяТипа);
		ЗаписатьПару(Запись, "ВозвратНабор", Описание0.ВозвратНабор = Истина);
		ЗаписатьСвойстваОписания(Запись, Описание0.Свойства);
		Запись.ЗаписатьИмяСвойства("Параметры");
		Запись.ЗаписатьНачалоМассива();
		Для Каждого Параметр Из Описание0.Параметры Цикл
			Запись.ЗаписатьНачалоМассива();
			Запись.ЗаписатьЗначение(Параметр.Имя);
			Запись.ЗаписатьЗначение(Параметр.ТипEdm);
			Запись.ЗаписатьКонецМассива();
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Запись.ЗаписатьКонецОбъекта();
КонецПроцедуры

// Свойства описания — массивами [Имя, ТипEdm, Вид, ВКлюче, Длина, Разрядность, Дробная, ИмяНавигации, ЦелевойНабор]
// (вдвое меньше вызовов записи, чем объектами).
Процедура ЗаписатьСвойстваОписания(Запись, Свойства)
	Запись.ЗаписатьИмяСвойства("Свойства");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого Свойство Из Свойства Цикл
		Запись.ЗаписатьНачалоМассива();
		Запись.ЗаписатьЗначение(Свойство.Имя);
		Запись.ЗаписатьЗначение(Свойство.ТипEdm);
		Запись.ЗаписатьЗначение(Свойство.Вид);
		Запись.ЗаписатьЗначение(Свойство.ВКлюче = Истина);
		Запись.ЗаписатьЗначение(Свойство.Длина);
		Запись.ЗаписатьЗначение(Свойство.Разрядность);
		Запись.ЗаписатьЗначение(Свойство.Дробная);
		Запись.ЗаписатьЗначение(Свойство.ИмяНавигации);
		Запись.ЗаписатьЗначение(Свойство.ЦелевойНабор);
		Запись.ЗаписатьКонецМассива();
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
КонецПроцедуры

// Добавляет в Коллекции наборы из ТабличныеЧасти набора Набор, которых ещё нет в описании (скрытые коллекции).
Процедура ДобавитьКоллекции(Модель, Набор, Записанные, Коллекции)
	Для Каждого ИмяТЧ Из Набор.ТабличныеЧасти Цикл
		Если Записанные.Получить(ИмяТЧ) = Неопределено Тогда
			Записанные.Вставить(ИмяТЧ, Истина);
			Коллекции.Добавить(OData4_Модель.НайтиНабор(Модель, ИмяТЧ));
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Набор модели из элемента описания (Соответствие ПрочитатьJSON).
Функция НаборИзОписания(Элемент)
	Набор = Новый Структура;
	Для Каждого Имя Из СтрРазделить("Имя,Вид,Родитель,ИмяВВладельце,Скрытый,Ключ,ТабличныеЧасти", ",") Цикл
		Набор.Вставить(Имя, Элемент.Получить(Имя));
	КонецЦикла;
	Набор.Вставить("Свойства", СвойстваИзОписания(Элемент.Получить("Свойства")));
	Набор.Вставить("ВиртуальныеТаблицы", Новый Массив);
	Для Каждого Таблица Из Элемент.Получить("ВиртуальныеТаблицы") Цикл
		Описание0 = Новый Структура("Имя, ИмяТипа, ВозвратНабор", Таблица.Получить("Имя"), Таблица.Получить("ИмяТипа"),
			Таблица.Получить("ВозвратНабор"));
		Описание0.Вставить("Свойства", СвойстваИзОписания(Таблица.Получить("Свойства")));
		Описание0.Вставить("Параметры", Новый Массив);
		Для Каждого Параметр Из Таблица.Получить("Параметры") Цикл
			Описание0.Параметры.Добавить(Новый Структура("Имя, ТипEdm", Параметр[0], Параметр[1]));
		КонецЦикла;
		Набор.ВиртуальныеТаблицы.Добавить(Описание0);
	КонецЦикла;
	Возврат Набор;
КонецФункции

Функция СвойстваИзОписания(Массив0)
	Результат = Новый Массив;
	Для Каждого Элемент Из Массив0 Цикл
		Результат.Добавить(Новый Структура("Имя, ТипEdm, Вид, ВКлюче, Длина, Разрядность, Дробная, ИмяНавигации, ЦелевойНабор",
			Элемент[0], Элемент[1], Элемент[2], Элемент[3], Элемент[4], Элемент[5], Элемент[6], Элемент[7], Элемент[8]));
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Описание — Структура «Имя, Члены» (ОписанияПеречислений).
Процедура ЗаписатьПеречисление(Запись, Описание)
	Запись.ЗаписатьНачалоЭлемента("EnumType");
	// Как в standard.odata: EnumType без префикса Enum_.
	Запись.ЗаписатьАтрибут("Name", Описание.Имя);
	Индекс = 0;
	// Члены — в порядке standard.odata; Value — номер члена в этом порядке.
	Для Каждого ИмяЗначения Из Описание.Члены Цикл
		Запись.ЗаписатьНачалоЭлемента("Member");
		Запись.ЗаписатьАтрибут("Name", ИмяЗначения);
		Запись.ЗаписатьАтрибут("Value", Формат(Индекс, "ЧН=0; ЧГ=0"));
		Запись.ЗаписатьКонецЭлемента();
		Индекс = Индекс + 1;
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьТип(Запись, Элемент, ИмяТипа, Набор, Модель, СКлючом)
	Запись.ЗаписатьНачалоЭлемента(Элемент);
	Запись.ЗаписатьАтрибут("Name", ИмяТипа);
	Если СКлючом Тогда
		Запись.ЗаписатьНачалоЭлемента("Key");
		Для Каждого ИмяСвойства Из Набор.Ключ Цикл
			Запись.ЗаписатьНачалоЭлемента("PropertyRef");
			Запись.ЗаписатьАтрибут("Name", ИмяСвойства);
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
	Для Каждого Свойство Из Набор.Свойства Цикл
		ЗаписатьСвойство(Запись, Свойство, СКлючом);
	КонецЦикла;
	Для Каждого ИмяТЧ Из Набор.ТабличныеЧасти Цикл
		ТЧ = OData4_Модель.НайтиНабор(Модель, ИмяТЧ);
		Запись.ЗаписатьНачалоЭлемента("Property");
		Запись.ЗаписатьАтрибут("Name", ТЧ.ИмяВВладельце);
		Запись.ЗаписатьАтрибут("Type", "Collection(StandardODATA." + ИмяСтрочногоТипа(Набор, ТЧ) + ")");
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
	Если СКлючом Тогда
		Для Каждого Свойство Из Набор.Свойства Цикл
			Если Свойство.Вид = "Ссылка" И Свойство.ИмяНавигации <> "" Тогда
				Запись.ЗаписатьНачалоЭлемента("NavigationProperty");
				Запись.ЗаписатьАтрибут("Name", Свойство.ИмяНавигации);
				Запись.ЗаписатьАтрибут("Type", "StandardODATA." + Свойство.ЦелевойНабор);
				Запись.ЗаписатьКонецЭлемента();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

// Поток Edm.Stream — только в EntityType: в CSDL 4.0 комплексные типы не содержат потоков.
// ВсеNullable — свойства типа результата виртуальной таблицы: в standard.odata все Nullable="true",
// хотя часть из них (Recorder, LineNumber у RecordsWithExtDimensions) общая с ключом записей.
Процедура ЗаписатьСвойство(Запись, Свойство, ВТипеСущности, ВсеNullable = Ложь)
	Если ВТипеСущности Или Свойство.Вид <> "Хранилище" Тогда
		Запись.ЗаписатьНачалоЭлемента("Property");
		Запись.ЗаписатьАтрибут("Name", Свойство.Имя);
		Запись.ЗаписатьАтрибут("Type", Свойство.ТипEdm);
		Если Свойство.ВКлюче И Не ВсеNullable Тогда
			Запись.ЗаписатьАтрибут("Nullable", "false");
		КонецЕсли;
		Если Свойство.ТипEdm = "Edm.String" И Свойство.Длина > 0 Тогда
			Запись.ЗаписатьАтрибут("MaxLength", Формат(Свойство.Длина, "ЧГ=0"));
		КонецЕсли;
		Если Свойство.ТипEdm = "Edm.Decimal" И Свойство.Разрядность > 0 Тогда
			Запись.ЗаписатьАтрибут("Precision", Формат(Свойство.Разрядность, "ЧГ=0"));
			Запись.ЗаписатьАтрибут("Scale", Формат(Свойство.Дробная, "ЧН=0; ЧГ=0"));
		КонецЕсли;
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
	Если Свойство.Вид = "Хранилище" Тогда
		Запись.ЗаписатьНачалоЭлемента("Property");
		Запись.ЗаписатьАтрибут("Name", Свойство.Имя + "_Base64Data");
		Запись.ЗаписатьАтрибут("Type", "Edm.Binary");
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
	Если Свойство.Вид = "Составной" Или Свойство.Вид = "Хранилище" Тогда
		Запись.ЗаписатьНачалоЭлемента("Property");
		Запись.ЗаписатьАтрибут("Name", Свойство.Имя + "_Type");
		Запись.ЗаписатьАтрибут("Type", "Edm.String");
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьНаборСущностей(Запись, Набор)
	Запись.ЗаписатьНачалоЭлемента("EntitySet");
	Запись.ЗаписатьАтрибут("Name", Набор.Имя);
	Запись.ЗаписатьАтрибут("EntityType", "StandardODATA." + Набор.Имя);
	Для Каждого Свойство Из Набор.Свойства Цикл
		Если Свойство.Вид = "Ссылка" И Свойство.ИмяНавигации <> "" Тогда
			Запись.ЗаписатьНачалоЭлемента("NavigationPropertyBinding");
			Запись.ЗаписатьАтрибут("Path", Свойство.ИмяНавигации);
			Запись.ЗаписатьАтрибут("Target", Свойство.ЦелевойНабор);
			Запись.ЗаписатьКонецЭлемента();
		КонецЕсли;
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента();
КонецПроцедуры

Процедура ЗаписатьПару(Запись, Имя, Значение)
	Запись.ЗаписатьИмяСвойства(Имя);
	Запись.ЗаписатьЗначение(Значение);
КонецПроцедуры

// EnumType: члены в порядке standard.odata, значение — номер в этом порядке (как Value в CSDL XML).
Процедура ЗаписатьПеречислениеJSON(Запись, Описание)
	Запись.ЗаписатьИмяСвойства(Описание.Имя);
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПару(Запись, "$Kind", "EnumType");
	Индекс = 0;
	Для Каждого ИмяЗначения Из Описание.Члены Цикл
		ЗаписатьПару(Запись, ИмяЗначения, Индекс);
		Индекс = Индекс + 1;
	КонецЦикла;
	Запись.ЗаписатьКонецОбъекта();
КонецПроцедуры

// Тип сущности или строки табличной части — те же члены, что в ЗаписатьТип (CSDL XML).
Процедура ЗаписатьТипJSON(Запись, ВидТипа, ИмяТипа, Набор, Модель, СКлючом)
	Запись.ЗаписатьИмяСвойства(ИмяТипа);
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПару(Запись, "$Kind", ВидТипа);
	Если СКлючом Тогда
		Запись.ЗаписатьИмяСвойства("$Key");
		Запись.ЗаписатьНачалоМассива();
		Для Каждого ИмяСвойства Из Набор.Ключ Цикл
			Запись.ЗаписатьЗначение(ИмяСвойства);
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	КонецЕсли;
	Для Каждого Свойство Из Набор.Свойства Цикл
		Если СКлючом Или Свойство.Вид <> "Хранилище" Тогда
			ЗаписатьСвойствоJSON(Запись, Свойство.Имя, Свойство.ТипEdm, Не Свойство.ВКлюче, Свойство);
		КонецЕсли;
		Если Свойство.Вид = "Хранилище" Тогда
			ЗаписатьСвойствоJSON(Запись, Свойство.Имя + "_Base64Data", "Edm.Binary", Истина, Неопределено);
		КонецЕсли;
		Если Свойство.Вид = "Составной" Или Свойство.Вид = "Хранилище" Тогда
			ЗаписатьСвойствоJSON(Запись, Свойство.Имя + "_Type", "Edm.String", Истина, Неопределено);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяТЧ Из Набор.ТабличныеЧасти Цикл
		ТЧ = OData4_Модель.НайтиНабор(Модель, ИмяТЧ);
		Запись.ЗаписатьИмяСвойства(ТЧ.ИмяВВладельце);
		Запись.ЗаписатьНачалоОбъекта();
		ЗаписатьПару(Запись, "$Collection", Истина);
		ЗаписатьПару(Запись, "$Type", "StandardODATA." + ИмяСтрочногоТипа(Набор, ТЧ));
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
	Если СКлючом Тогда
		Для Каждого Свойство Из Набор.Свойства Цикл
			Если Свойство.Вид = "Ссылка" И Свойство.ИмяНавигации <> "" Тогда
				Запись.ЗаписатьИмяСвойства(Свойство.ИмяНавигации);
				Запись.ЗаписатьНачалоОбъекта();
				ЗаписатьПару(Запись, "$Kind", "NavigationProperty");
				ЗаписатьПару(Запись, "$Type", "StandardODATA." + Свойство.ЦелевойНабор);
				ЗаписатьПару(Запись, "$Nullable", Истина);
				Запись.ЗаписатьКонецОбъекта();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();
КонецПроцедуры

// Свойство CSDL JSON: $Type опускается у Edm.String, $Nullable пишется только true.
Процедура ЗаписатьСвойствоJSON(Запись, Имя, ТипEdm, МожетБытьNull, Свойство)
	Запись.ЗаписатьИмяСвойства(Имя);
	Запись.ЗаписатьНачалоОбъекта();
	Если ТипEdm <> "Edm.String" Тогда
		ЗаписатьПару(Запись, "$Type", ТипEdm);
	КонецЕсли;
	Если МожетБытьNull Тогда
		ЗаписатьПару(Запись, "$Nullable", Истина);
	КонецЕсли;
	Если Свойство <> Неопределено Тогда
		Если ТипEdm = "Edm.String" И Свойство.Длина > 0 Тогда
			ЗаписатьПару(Запись, "$MaxLength", Свойство.Длина);
		КонецЕсли;
		Если ТипEdm = "Edm.Decimal" И Свойство.Разрядность > 0 Тогда
			ЗаписатьПару(Запись, "$Precision", Свойство.Разрядность);
			ЗаписатьПару(Запись, "$Scale", Свойство.Дробная);
		КонецЕсли;
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();
КонецПроцедуры

Процедура ЗаписатьНаборСущностейJSON(Запись, Набор)
	Запись.ЗаписатьИмяСвойства(Набор.Имя);
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПару(Запись, "$Collection", Истина);
	ЗаписатьПару(Запись, "$Type", "StandardODATA." + Набор.Имя);
	Привязки = Новый Массив;
	Для Каждого Свойство Из Набор.Свойства Цикл
		Если Свойство.Вид = "Ссылка" И Свойство.ИмяНавигации <> "" Тогда
			Привязки.Добавить(Свойство);
		КонецЕсли;
	КонецЦикла;
	Если Привязки.Количество() > 0 Тогда
		Запись.ЗаписатьИмяСвойства("$NavigationPropertyBinding");
		Запись.ЗаписатьНачалоОбъекта();
		Для Каждого Свойство Из Привязки Цикл
			ЗаписатьПару(Запись, Свойство.ИмяНавигации, Свойство.ЦелевойНабор);
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();
КонецПроцедуры

// Имя комплексного типа строк коллекции: у табличной части — «Имя_RowType» набора табличной части,
// у набора записей регистра — «Имя_RowType» самого набора по регистратору (как в standard.odata).
// Комплексные типы результатов виртуальных таблиц набора в CSDL JSON — то же, что ЗаписатьТипыРезультатов
// для XML. У срезов регистра сведений результат — сам набор, отдельного типа у них нет.
Процедура ЗаписатьТипыРезультатовJSON(Запись, Набор)
	Для Каждого Описание0 Из ВиртуальныеТаблицыНабора(Набор) Цикл
		Если Описание0.ВозвратНабор Тогда
			Продолжить;
		КонецЕсли;
		Запись.ЗаписатьИмяСвойства(Описание0.ИмяТипа);
		Запись.ЗаписатьНачалоОбъекта();
		ЗаписатьПару(Запись, "$Kind", "ComplexType");
		Для Каждого Свойство Из Описание0.Свойства Цикл
			ЗаписатьСвойствоJSON(Запись, Свойство.Имя, Свойство.ТипEdm, Истина, Свойство);
			Если Свойство.Вид = "Составной" Или Свойство.Вид = "Хранилище" Тогда
				ЗаписатьСвойствoJSONТипа(Запись, Свойство);
			КонецЕсли;
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьСвойствoJSONТипа(Запись, Свойство)
	ЗаписатьСвойствоJSON(Запись, Свойство.Имя + "_Type", "Edm.String", Истина, Неопределено);
КонецПроцедуры

// Перегрузки одного имени в CSDL JSON лежат одним массивом на уровне схемы, поэтому функции
// набора сначала собираются по имени, а пишутся после всех типов. Функции — Структура «Имена (в порядке первого
// появления: так порядок не зависит от порядка обхода Соответствие, и его повторяет компонента), Перегрузки».
Процедура СобратьФункцииJSON(Функции, Набор)
	Для Каждого Описание0 Из ВиртуальныеТаблицыНабора(Набор) Цикл
		Перегрузки = Функции.Перегрузки.Получить(Описание0.Имя);
		Если Перегрузки = Неопределено Тогда
			Перегрузки = Новый Массив;
			Функции.Перегрузки.Вставить(Описание0.Имя, Перегрузки);
			Функции.Имена.Добавить(Описание0.Имя);
		КонецЕсли;
		Перегрузки.Добавить(Новый Структура("Набор, Описание", Набор, Описание0));
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьФункцииJSON(Запись, Функции)
	Для Каждого ИмяФункции Из Функции.Имена Цикл
		Запись.ЗаписатьИмяСвойства(ИмяФункции);
		Запись.ЗаписатьНачалоМассива();
		Для Каждого Перегрузка Из Функции.Перегрузки.Получить(ИмяФункции) Цикл
			Набор = Перегрузка.Набор;
			Описание0 = Перегрузка.Описание;
			Запись.ЗаписатьНачалоОбъекта();
			ЗаписатьПару(Запись, "$Kind", "Function");
			ЗаписатьПару(Запись, "$IsBound", Истина);
			Запись.ЗаписатьИмяСвойства("$Parameter");
			Запись.ЗаписатьНачалоМассива();
			Запись.ЗаписатьНачалоОбъекта();
			ЗаписатьПару(Запись, "$Name", "bindingParameter");
			ЗаписатьПару(Запись, "$Collection", Истина);
			ЗаписатьПару(Запись, "$Type", "StandardODATA." + Набор.Имя);
			Запись.ЗаписатьКонецОбъекта();
			Для Каждого Параметр Из Описание0.Параметры Цикл
				Запись.ЗаписатьНачалоОбъекта();
				ЗаписатьПару(Запись, "$Name", Параметр.Имя);
				ЗаписатьПару(Запись, "$Type", Параметр.ТипEdm);
				ЗаписатьПару(Запись, "$Nullable", Истина);
				Запись.ЗаписатьКонецОбъекта();
			КонецЦикла;
			Запись.ЗаписатьКонецМассива();
			Запись.ЗаписатьИмяСвойства("$ReturnType");
			Запись.ЗаписатьНачалоОбъекта();
			ЗаписатьПару(Запись, "$Collection", Истина);
			ЗаписатьПару(Запись, "$Type",
				"StandardODATA." + ?(Описание0.ВозвратНабор, Набор.Имя, Описание0.ИмяТипа));
			Запись.ЗаписатьКонецОбъекта();
			Запись.ЗаписатьКонецОбъекта();
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	КонецЦикла;
КонецПроцедуры

Функция ИмяСтрочногоТипа(Владелец, Коллекция)
	Если Коллекция.Вид = "Регистр" Тогда
		Возврат Владелец.Имя + "_RowType";
	ИначеЕсли Коллекция.Скрытый Тогда
		// Коллекция без собственного набора (ExtDimensionTypes): тип строк — с именем набора, как в standard.odata.
		Возврат Коллекция.Имя;
	КонецЕсли;
	Возврат Коллекция.Имя + "_RowType";
КонецФункции

// Комплексные типы описания типов (ValueType планов видов характеристик), как в standard.odata:
// TypeDescription и квалификаторы. Все свойства обязательные.
Функция ТипыОписанияТипов()
	Типы = Новый Массив;
	Типы.Добавить(Новый Структура("Имя, Свойства", "TypeDescription",
		"Types:Collection(Edm.String),NumberQualifiers:StandardODATA.NumberQualifiers,"
		+ "StringQualifiers:StandardODATA.StringQualifiers,DateQualifiers:StandardODATA.DateQualifiers,"
		+ "BinaryDataQualifiers:StandardODATA.BinaryDataQualifiers"));
	Типы.Добавить(Новый Структура("Имя, Свойства", "NumberQualifiers",
		"AllowedSign:Edm.String,Digits:Edm.Int16,FractionDigits:Edm.Int16"));
	Типы.Добавить(Новый Структура("Имя, Свойства", "StringQualifiers", "AllowedLength:Edm.String,Length:Edm.Int64"));
	Типы.Добавить(Новый Структура("Имя, Свойства", "DateQualifiers", "DateFractions:Edm.String"));
	Типы.Добавить(Новый Структура("Имя, Свойства", "BinaryDataQualifiers", "AllowedLength:Edm.String,Length:Edm.Int64"));
	Возврат Типы;
КонецФункции

Процедура ЗаписатьОписаниеТипов(Запись)
	Для Каждого ОписаниеТипа Из ТипыОписанияТипов() Цикл
		Запись.ЗаписатьНачалоЭлемента("ComplexType");
		Запись.ЗаписатьАтрибут("Name", ОписаниеТипа.Имя);
		Для Каждого Пара Из СтрРазделить(ОписаниеТипа.Свойства, ",") Цикл
			Части = СтрРазделить(Пара, ":");
			Запись.ЗаписатьНачалоЭлемента("Property");
			Запись.ЗаписатьАтрибут("Name", Части[0]);
			Запись.ЗаписатьАтрибут("Type", Части[1]);
			Запись.ЗаписатьАтрибут("Nullable", "false");
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
КонецПроцедуры

Процедура ЗаписатьОписаниеТиповJSON(Запись)
	Для Каждого ОписаниеТипа Из ТипыОписанияТипов() Цикл
		Запись.ЗаписатьИмяСвойства(ОписаниеТипа.Имя);
		Запись.ЗаписатьНачалоОбъекта();
		ЗаписатьПару(Запись, "$Kind", "ComplexType");
		Для Каждого Пара Из СтрРазделить(ОписаниеТипа.Свойства, ",") Цикл
			Части = СтрРазделить(Пара, ":");
			Запись.ЗаписатьИмяСвойства(Части[0]);
			Запись.ЗаписатьНачалоОбъекта();
			Если СтрНачинаетсяС(Части[1], "Collection(") Тогда
				ЗаписатьПару(Запись, "$Collection", Истина);
				ЗаписатьПару(Запись, "$Type", Сред(Части[1], 12, СтрДлина(Части[1]) - 12));
			ИначеЕсли Части[1] <> "Edm.String" Тогда
				ЗаписатьПару(Запись, "$Type", Части[1]);
			КонецЕсли;
			Запись.ЗаписатьКонецОбъекта();
		КонецЦикла;
		Запись.ЗаписатьКонецОбъекта();
	КонецЦикла;
КонецПроцедуры

// Комплексные типы результатов виртуальных таблиц набора (у срезов результат — сам набор).
Процедура ЗаписатьТипыРезультатов(Запись, Набор)
	Для Каждого Описание0 Из ВиртуальныеТаблицыНабора(Набор) Цикл
		Если Описание0.ВозвратНабор Тогда
			Продолжить;
		КонецЕсли;
		Запись.ЗаписатьНачалоЭлемента("ComplexType");
		Запись.ЗаписатьАтрибут("Name", Описание0.ИмяТипа);
		Для Каждого Свойство Из Описание0.Свойства Цикл
			ЗаписатьСвойство(Запись, Свойство, Ложь, Истина);
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
КонецПроцедуры

// Связанные функции набора: <Function IsBound="true"> с привязкой к Collection(набор).
// FunctionImport в CSDL 4.0 объявляет только несвязанные функции, поэтому его нет.
Процедура ЗаписатьФункцииНабора(Запись, Набор)
	Для Каждого Описание0 Из ВиртуальныеТаблицыНабора(Набор) Цикл
		ТипРезультата = "Collection(StandardODATA." + ?(Описание0.ВозвратНабор, Набор.Имя, Описание0.ИмяТипа) + ")";
		Запись.ЗаписатьНачалоЭлемента("Function");
		Запись.ЗаписатьАтрибут("Name", Описание0.Имя);
		Запись.ЗаписатьАтрибут("IsBound", "true");
		Запись.ЗаписатьАтрибут("IsComposable", "false");
		Запись.ЗаписатьНачалоЭлемента("Parameter");
		Запись.ЗаписатьАтрибут("Name", "bindingParameter");
		Запись.ЗаписатьАтрибут("Type", "Collection(StandardODATA." + Набор.Имя + ")");
		Запись.ЗаписатьКонецЭлемента();
		Для Каждого Параметр Из Описание0.Параметры Цикл
			Запись.ЗаписатьНачалоЭлемента("Parameter");
			Запись.ЗаписатьАтрибут("Name", Параметр.Имя);
			Запись.ЗаписатьАтрибут("Type", Параметр.ТипEdm);
			// В CSDL 4.0 признака необязательного параметра нет (он появился в 4.01);
			// Nullable="true" — ближайшее «можно не передавать», как в standard.odata.
			Запись.ЗаписатьАтрибут("Nullable", "true");
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
		Запись.ЗаписатьНачалоЭлемента("ReturnType");
		Запись.ЗаписатьАтрибут("Type", ТипРезультата);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
