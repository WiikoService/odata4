#Область ПрограммныйИнтерфейс

// Заполняет ВиртуальныеТаблицы наборов регистра: срезы — у набора записей регистра сведений,
// остальные — у набора по регистратору. Описание — Структура «Имя, Таблица, ИмяТипа, ВозвратНабор,
// Параметры, Свойства, Измерения, Ресурсы, Обязательные, Ключ, ВидыСубконто, МаксСубконто, ИмяОбъекта,
// ВидТаблицы»: Таблица — имя виртуальной таблицы 1С, ИмяТипа — имя ComplexType результата ("" у среза),
// ВозвратНабор — результат отдаётся сущностями набора, Свойства — описания свойств результата (в каждом
// Поле — колонка виртуальной таблицы 1С), Измерения — Массив Структур «Имя1С, Свойства» для параметра
// Dimensions, Ресурсы — свойства, которые суммируются при группировке, Обязательные — свойства, которые
// есть в результате всегда (при любом Dimensions), Ключ — свойства ключа результата (с выбранными
// измерениями), ВидыСубконто — имя плана видов характеристик видов субконто регистра бухгалтерии
// ("" — нет), МаксСубконто — число колонок субконто.
Процедура ЗаполнитьОписания(Модель, Записи, Владелец, ОбъектМетаданных, ВидРегистра) Экспорт
	Если ВидРегистра = "Сведений" Тогда
		Если Записи.Периодический Тогда
			Записи.ВиртуальныеТаблицы.Вставить("SliceLast", ОписаниеСреза(Записи, "СрезПоследних", "SliceLast"));
			Записи.ВиртуальныеТаблицы.Вставить("SliceFirst", ОписаниеСреза(Записи, "СрезПервых", "SliceFirst"));
		КонецЕсли;
		Возврат;
	ИначеЕсли ВидРегистра = "Накопления" Тогда
		ЗаполнитьНакопления(Модель, Записи, Владелец, ОбъектМетаданных);
	ИначеЕсли ВидРегистра = "Бухгалтерии" Тогда
		ЗаполнитьБухгалтерии(Модель, Записи, Владелец, ОбъектМетаданных);
	КонецЕсли;
КонецПроцедуры

// Описание функции набора по имени или Неопределено.
Функция Описание(Набор, Имя) Экспорт
	Возврат Набор.ВиртуальныеТаблицы.Получить(Имя);
КонецФункции

// Свойство результата виртуальной таблицы: имя OData, колонка 1С, вид и тип Edm.
Функция Свойство(Имя, Поле, Вид, ТипEdm) Экспорт
	Возврат OData4_Модель.НовоеСвойство(Имя, Поле, Вид, ТипEdm);
КонецФункции

// Значения параметров вызова по их объявленным типам: Структура имя → значение
// (дата, строка или число). Неизвестное имя и несовместимый литерал — 400.
Функция ЗначенияПараметров(Модель, Параметры, Набор, Описание0, Тексты) Экспорт
	Значения = Новый Структура;
	Объявленные = Новый Соответствие;
	Для Каждого Параметр Из Описание0.Параметры Цикл
		Объявленные.Вставить(Параметр.Имя, Параметр.ТипEdm);
		Значения.Вставить(Параметр.Имя, Неопределено);
	КонецЦикла;
	Для Каждого КлючИЗначение Из Тексты Цикл
		ТипEdm = Объявленные.Получить(КлючИЗначение.Ключ);
		Если ТипEdm = Неопределено Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest",
				"Неизвестный параметр функции " + Описание0.Имя + ": " + КлючИЗначение.Ключ);
		КонецЕсли;
		Значения[КлючИЗначение.Ключ] = ЗначениеПараметра(Модель, Параметры, Набор, КлючИЗначение.Ключ, ТипEdm,
			КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Значения;
КонецФункции

// Текст источника выборки: «РегистрСведений.X.СрезПоследних(&П1, условие)». Пустые параметры
// печатаются пустым местом, хвостовые — опускаются (проба: 3 параметра у среза — «Неверные параметры»).
Функция ТекстИсточника(Контекст, Описание0, Аргументы) Экспорт
	Последний = -1;
	Для Индекс = 0 По Аргументы.ВГраница() Цикл
		Если Аргументы[Индекс] <> "" Тогда
			Последний = Индекс;
		КонецЕсли;
	КонецЦикла;
	Таблица = Описание0.ВидТаблицы + "." + Описание0.ИмяОбъекта + "." + Описание0.Таблица;
	Если Последний < 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	Части = Новый Массив;
	Для Индекс = 0 По Последний Цикл
		Части.Добавить(Аргументы[Индекс]);
	КонецЦикла;
	Возврат Таблица + "(" + СтрСоединить(Части, ", ") + ")";
КонецФункции

// Условие параметра Condition (или AccountCondition) в терминах полей виртуальной таблицы,
// без псевдонима таблицы. Пустой текст — пустое условие. Запрещенные — Соответствие имя свойства
// (и имя его навигации) → что это за свойство («Ресурс», «Счёт»): условие виртуальной таблицы 1С
// применяется к измерениям (и субконто), ресурс и счёт в нём — 400 (standard.odata отвечает 500
// «Поле не найдено»).
Функция ТекстУсловия(Модель, Параметры, Набор, ИмяПараметра, Текст, Запрещенные = Неопределено) Экспорт
	Если Текст = Неопределено Или СокрЛП(Текст) = "" Тогда
		Возврат "";
	КонецЕсли;
	Узел = РазобратьУсловие(ИмяПараметра, Текст);
	Если Запрещенные <> Неопределено И Запрещенные.Количество() > 0 Тогда
		Имя = ЗапрещенноеВУсловии(Узел, Запрещенные);
		Если Имя <> "" Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest",
				Запрещенные.Получить(Имя) + " в " + ИмяПараметра + " не применяется: " + Имя);
		КонецЕсли;
	КонецЕсли;
	Контекст = OData4_Генератор.НовыйКонтекст(Модель, Параметры, Набор, "");
	Возврат OData4_Генератор.Условие(Узел, Контекст);
КонецФункции

// Свойства результата, недопустимые в Condition таблиц остатков и оборотов: ресурсы и, у регистра
// бухгалтерии, счёт и корреспондирующий счёт (в условии таблицы 1С поля Счет нет — проба:
// «Поле не найдено "Счет"»; условие на счёт — отдельный параметр). Соответствие имя → «Ресурс»/«Счёт».
Функция ЗапрещенныеВУсловии(Описание0)
	Запрещенные = Новый Соответствие;
	Для Каждого Свойство0 Из Описание0.Ресурсы Цикл
		Запрещенные.Вставить(Свойство0.Имя, "Ресурс");
	КонецЦикла;
	// Движения с субконто (ДвиженияССубконто) — поля записи: в их условии счёт есть.
	Если Описание0.ВидТаблицы = "РегистрБухгалтерии" И Описание0.Таблица <> "ДвиженияССубконто" Тогда
		Для Каждого Свойство0 Из Описание0.Обязательные Цикл
			Если Свойство0.Поле = "Счет" Или Свойство0.Поле = "КорСчет" Тогда
				Запрещенные.Вставить(Свойство0.Имя, "Счёт");
				Если Свойство0.ИмяНавигации <> "" Тогда
					Запрещенные.Вставить(Свойство0.ИмяНавигации, "Счёт");
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Запрещенные;
КонецФункции

// Имя первого запрещённого свойства (см. ЗапрещенныеВУсловии), на которое ссылается путь дерева
// условия (без переменной лямбды), или "".
// Обход — стеком, без рекурсии: высота дерева ограничена разбором, но исключений из глубины нет.
Функция ЗапрещенноеВУсловии(Корень, Имена)
	Стек = Новый Массив;
	Стек.Добавить(Корень);
	Пока Стек.Количество() > 0 Цикл
		Узел = Стек[Стек.ВГраница()];
		Стек.Удалить(Стек.ВГраница());
		Если ТипЗнч(Узел) = Тип("Массив") Тогда
			Для Каждого Элемент Из Узел Цикл
				Стек.Добавить(Элемент);
			КонецЦикла;
			Продолжить;
		ИначеЕсли ТипЗнч(Узел) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Вид = Неопределено;
		Если Узел.Свойство("kind", Вид) И Вид = "path" И Узел.variable = "" И Узел.segments.Количество() > 0
			И Имена.Получить(Узел.segments[0]) <> Неопределено Тогда
			Возврат Узел.segments[0];
		КонецЕсли;
		Для Каждого КлючИЗначение Из Узел Цикл
			Стек.Добавить(КлючИЗначение.Значение);
		КонецЦикла;
	КонецЦикла;
	Возврат "";
КонецФункции

// Добавляет в Соответствие Имена первые сегменты путей дерева выражения (без переменной лямбды): свойства
// результата, которые упоминает $filter или $orderby. Обход — стеком, без рекурсии.
Процедура ДобавитьИменаПутей(Корень, Имена) Экспорт
	Стек = Новый Массив;
	Стек.Добавить(Корень);
	Пока Стек.Количество() > 0 Цикл
		Узел = Стек[Стек.ВГраница()];
		Стек.Удалить(Стек.ВГраница());
		Если ТипЗнч(Узел) = Тип("Массив") Тогда
			Для Каждого Элемент Из Узел Цикл
				Стек.Добавить(Элемент);
			КонецЦикла;
			Продолжить;
		ИначеЕсли ТипЗнч(Узел) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Вид = Неопределено;
		Если Узел.Свойство("kind", Вид) И Вид = "path" И Узел.variable = "" И Узел.segments.Количество() > 0 Тогда
			Имена.Вставить(Узел.segments[0], Истина);
		КонецЕсли;
		Для Каждого КлючИЗначение Из Узел Цикл
			Стек.Добавить(КлючИЗначение.Значение);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Имена измерений 1С из Dimensions; Неопределено означает все измерения.
Функция ИменаИзмерений(Описание0, Текст) Экспорт
	Если Текст = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если СокрЛП(Текст) = "" Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Пустое значение Dimensions");
	КонецЕсли;
	Известные = Новый Соответствие;
	Для Каждого Измерение Из Описание0.Измерения Цикл
		Известные.Вставить(Измерение.Имя1С, Истина);
	КонецЦикла;
	Имена = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, ",", Ложь) Цикл
		Имя = СокрЛП(Часть);
		Если Известные.Получить(Имя) <> Истина Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неизвестное измерение в Dimensions: " + Имя);
		КонецЕсли;
		Если Имена.Найти(Имя) = Неопределено Тогда
			Имена.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;
КонецФункции

// Синтетический набор результата виртуальной таблицы. Значения — значения параметров вызова:
// при ExtraDimensions (BalancedExtraDimensions) из N видов у таблицы 1С только N колонок субконто,
// и standard.odata отдаёт только ExtDimension1…N (BalancedExtDimension1…N).
// Упомянутые — Соответствие имён, упомянутых в запросе (см. ДобавитьИменаПутей), или Неопределено: тогда
// в наборе только упомянутые свойства (у измерения, счёта и субконто — по имени, имени «_Type» или имени
// навигации), и ключ — упомянутые из них. Таблица 1С группирует строки по полям, которые есть в запросе, и
// standard.odata выбирает из неё только упомянутое: Balance()?$select=СуммаBalance — одна строка.
Функция НаборРезультата(Модель, Описание0, Имена, Значения = Неопределено, Упомянутые = Неопределено) Экспорт
	Набор = OData4_Модель.НовыйНабор(Описание0.ИмяТипа, "Результат", "", "", "");
	Набор.ИмяОбъекта = Описание0.ИмяОбъекта;
	Лишние = ЛишниеСубконто(Описание0, Значения);
	// Колонки периода, которые заполняет параметр Periodicity: копии свойств с полем таблицы 1С, первыми
	// (как в типе результата) и первыми в ключе — строки различаются периодом.
	Заполненные = Новый Соответствие;
	Периодичность = ПериодичностьВызова(Описание0, Значения);
	Если Периодичность <> Неопределено Тогда
		Для Каждого Свойство0 Из Описание0.Свойства Цикл
			Колонка = Периодичность.Колонки.Получить(Свойство0.Имя);
			Если Колонка = Неопределено И Свойство0.ИмяНавигации <> "" Тогда
				Колонка = Периодичность.Колонки.Получить(Свойство0.ИмяНавигации);
			КонецЕсли;
			Если Колонка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Заполненные.Вставить(Свойство0, Истина);
			Если Упомянуто(Свойство0, Упомянутые) Тогда
				Копия = СкопироватьСвойство(Свойство0, Колонка);
				Набор.Свойства.Добавить(Копия);
				ДобавитьВКлюч(Набор, Копия);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Свойство0 Из Описание0.Обязательные Цикл
		Если Лишние.Получить(Свойство0.Поле) = Неопределено И Упомянуто(Свойство0, Упомянутые) Тогда
			Набор.Свойства.Добавить(Свойство0);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Измерение Из Описание0.Измерения Цикл
		Если Имена <> Неопределено И Имена.Найти(Измерение.Имя1С) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Свойство0 Из Измерение.Свойства Цикл
			Если Упомянуто(Свойство0, Упомянутые) Тогда
				Набор.Свойства.Добавить(Свойство0);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Для Каждого Свойство0 Из Описание0.Ресурсы Цикл
		Если Упомянуто(Свойство0, Упомянутые) Тогда
			Набор.Свойства.Добавить(Свойство0);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Свойство0 Из Описание0.Ключ Цикл
		Если Лишние.Получить(Свойство0.Поле) = Неопределено И Упомянуто(Свойство0, Упомянутые) Тогда
			ДобавитьВКлюч(Набор, Свойство0);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Измерение Из Описание0.Измерения Цикл
		Если Имена = Неопределено Или Имена.Найти(Измерение.Имя1С) <> Неопределено Тогда
			// Все свойства измерения: у оборотов бухгалтерии пара «Валюта, ВалютаКор» — строки
			// различаются и корреспондирующим значением (без него /$count и метка сливали строки).
			// По упомянутым — только упомянутые: таблица 1С группирует по каждому полю отдельно
			// (проба: $select=Валюта_Key у оборотов — 3 строки, как у standard.odata; с ВалютаКор — 5).
			Для Каждого Свойство0 Из Измерение.Свойства Цикл
				Если Упомянуто(Свойство0, Упомянутые) Тогда
					ДобавитьВКлюч(Набор, Свойство0);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьИндексыНабора(Набор);
	Набор.Вставить("НеЗаполняются", НеЗаполняемыеСвойства(Описание0, Заполненные));
	Возврат Набор;
КонецФункции

// Периодичность вызова по параметру Periodicity: Неопределено (параметр не задан) или Структура
// «Слово, Колонки»: Слово — ключевое слово периодичности 1С (из закрытой таблицы, не из URL), Колонки —
// Соответствие «имя свойства результата → колонка таблицы 1С». Значение сравнивается точно, с учётом
// регистра; иное — 400.
Функция ПериодичностьВызова(Описание0, Значения) Экспорт
	Текст = Неопределено;
	Если Значения = Неопределено Или Не Значения.Свойство("Periodicity", Текст) Или Текст = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Таблица = "Record|Запись,Recorder|Регистратор,Second|Секунда,Minute|Минута,Hour|Час,Day|День,Week|Неделя,"
		+ "TenDays|Декада,Month|Месяц,Quarter|Квартал,HalfYear|Полугодие,Year|Год,Auto|Авто";
	Для Каждого Пара Из СтрРазделить(Таблица, ",") Цикл
		Части = СтрРазделить(Пара, "|");
		// Точное сравнение: «=» строк 1С регистр не различает.
		Если СтрДлина(Текст) <> СтрДлина(Части[0]) Или СтрНайти(Текст, Части[0]) <> 1 Тогда
			Продолжить;
		КонецЕсли;
		Колонки = Новый Соответствие;
		Если Части[0] = "Record" Или Части[0] = "Recorder" Тогда
			Колонки.Вставить("Period", "Период");
			Колонки.Вставить("Recorder", "Регистратор");
			Если Части[0] = "Record" Тогда
				Колонки.Вставить("LineNumber", "НомерСтроки");
			КонецЕсли;
		ИначеЕсли Части[0] = "Auto" Тогда
			// При «Авто» колонки «Период» у таблицы 1С нет: есть колонка каждой периодичности.
			Для Каждого ПараАвто Из СтрРазделить("Second|Секунда,Minute|Минута,Hour|Час,Day|День,Week|Неделя,"
				+ "TenDays|Декада,Month|Месяц,Quarter|Квартал,HalfYear|Полугодие,Year|Год", ",") Цикл
				ЧастиАвто = СтрРазделить(ПараАвто, "|");
				Колонки.Вставить(ЧастиАвто[0] + "Period", "Период" + ЧастиАвто[1]);
			КонецЦикла;
			Колонки.Вставить("Recorder", "Регистратор");
			Колонки.Вставить("LineNumber", "НомерСтроки");
		Иначе
			Колонки.Вставить(Части[0] + "Period", "Период");
		КонецЕсли;
		Возврат Новый Структура("Слово, Колонки", Части[1], Колонки);
	КонецЦикла;
	OData4_Сервис.ОшибкаOData(400, "BadRequest", "Недопустимое значение Periodicity: " + Текст);
КонецФункции

// Свойства типа результата, которых нет в строках: Period…YearPeriod, Recorder и LineNumber оборотов —
// standard.odata объявляет их, но заполняет только при периодичности (параметр Periodicity — расширение
// интерфейса, «Решение 4» этапа 4). Заполненные — свойства, которые заполняет заданная периодичность.
// Соответствие имя (и имя навигации, Имя_Type) → Истина; путь к ним — 400 с этим фактом.
Функция НеЗаполняемыеСвойства(Описание0, Заполненные)
	Известные = Новый Соответствие;
	Для Каждого КлючИЗначение Из Заполненные Цикл
		Известные.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;
	Для Каждого Свойство0 Из Описание0.Обязательные Цикл
		Известные.Вставить(Свойство0, Истина);
	КонецЦикла;
	Для Каждого Свойство0 Из Описание0.Ресурсы Цикл
		Известные.Вставить(Свойство0, Истина);
	КонецЦикла;
	Для Каждого Измерение Из Описание0.Измерения Цикл
		Для Каждого Свойство0 Из Измерение.Свойства Цикл
			Известные.Вставить(Свойство0, Истина);
		КонецЦикла;
	КонецЦикла;
	Результат = Новый Соответствие;
	Для Каждого Свойство0 Из Описание0.Свойства Цикл
		Если Известные.Получить(Свойство0) = Истина Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Свойство0.Имя, Истина);
		Если Свойство0.ИмяНавигации <> "" Тогда
			Результат.Вставить(Свойство0.ИмяНавигации, Истина);
		КонецЕсли;
		Если Свойство0.Вид = "Составной" Тогда
			Результат.Вставить(Свойство0.Имя + "_Type", Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовоеОписание(Имя, Таблица, ИмяТипа, ВозвратНабор, Набор)
	Описание0 = Новый Структура;
	Описание0.Вставить("Имя", Имя);
	Описание0.Вставить("Таблица", Таблица);
	Описание0.Вставить("ИмяТипа", ИмяТипа);
	Описание0.Вставить("ВозвратНабор", ВозвратНабор);
	Описание0.Вставить("Параметры", Новый Массив);
	Описание0.Вставить("Свойства", Новый Массив);
	Описание0.Вставить("Измерения", Новый Массив);
	Описание0.Вставить("Ресурсы", Новый Массив);
	Описание0.Вставить("Обязательные", Новый Массив);
	Описание0.Вставить("Ключ", Новый Массив);
	Описание0.Вставить("ВидыСубконто", "");
	Описание0.Вставить("МаксСубконто", 0);
	Описание0.Вставить("ИмяОбъекта", Набор.ИмяОбъекта);
	Описание0.Вставить("ВидТаблицы", Лев(Набор.ТаблицаЗапроса, СтрНайти(Набор.ТаблицаЗапроса, ".") - 1));
	Возврат Описание0;
КонецФункции

Процедура ДобавитьПараметр(Описание0, Имя, ТипEdm)
	Описание0.Параметры.Добавить(Новый Структура("Имя, ТипEdm", Имя, ТипEdm));
КонецПроцедуры

Функция ТипПериода()
	Возврат OData4_Сериализация.ТипДаты("ДатаВремя");
КонецФункции

// Срез последних и срез первых: результат — сущности того же набора, свойства не строятся.
Функция ОписаниеСреза(Набор, Таблица, Имя)
	Описание0 = НовоеОписание(Имя, Таблица, "", Истина, Набор);
	ДобавитьПараметр(Описание0, "Condition", "Edm.String");
	ДобавитьПараметр(Описание0, "Period", ТипПериода());
	Для Каждого Свойство Из Набор.Свойства Цикл
		Описание0.Свойства.Добавить(Свойство);
	КонецЦикла;
	Возврат Описание0;
КонецФункции

Процедура ЗаполнитьНакопления(Модель, Записи, Владелец, ОбъектМетаданных)
	Остатки = ОбъектМетаданных.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Остатки;
	Если Остатки Тогда
		Описание0 = НовоеОписание("Balance", "Остатки", Владелец.Имя + "_Balance", Ложь, Владелец);
		ДобавитьПараметр(Описание0, "Condition", "Edm.String");
		ДобавитьПараметр(Описание0, "Dimensions", "Edm.String");
		ДобавитьПараметр(Описание0, "Period", ТипПериода());
		ЗаполнитьИзмеренияИРесурсы(Модель, Описание0, ОбъектМетаданных, "Остаток|Balance", Ложь);
		Владелец.ВиртуальныеТаблицы.Вставить("Balance", Описание0);
	КонецЕсли;
	Суффиксы = ?(Остатки, "Оборот|Turnover,Приход|Receipt,Расход|Expense", "Оборот|Turnover");
	Обороты = НовоеОписание("Turnovers", "Обороты", Владелец.Имя + "_Turnover", Ложь, Владелец);
	ДобавитьПараметр(Обороты, "Condition", "Edm.String");
	ДобавитьПараметр(Обороты, "Dimensions", "Edm.String");
	ДобавитьПараметр(Обороты, "EndPeriod", ТипПериода());
	ДобавитьПараметр(Обороты, "Periodicity", "Edm.String");
	ДобавитьПараметр(Обороты, "StartPeriod", ТипПериода());
	ЗаполнитьИзмеренияИРесурсы(Модель, Обороты, ОбъектМетаданных, Суффиксы, Истина);
	Владелец.ВиртуальныеТаблицы.Вставить("Turnovers", Обороты);
	Если Не Остатки Тогда
		Возврат;
	КонецЕсли;
	Полное = НовоеОписание("BalanceAndTurnovers", "ОстаткиИОбороты", Владелец.Имя + "_BalanceAndTurnover", Ложь, Владелец);
	ДобавитьПараметр(Полное, "Condition", "Edm.String");
	ДобавитьПараметр(Полное, "Dimensions", "Edm.String");
	ДобавитьПараметр(Полное, "EndPeriod", ТипПериода());
	ДобавитьПараметр(Полное, "Periodicity", "Edm.String");
	ДобавитьПараметр(Полное, "StartPeriod", ТипПериода());
	ЗаполнитьИзмеренияИРесурсы(Модель, Полное, ОбъектМетаданных,
		"НачальныйОстаток|OpeningBalance,Оборот|Turnover,Приход|Receipt,Расход|Expense,КонечныйОстаток|ClosingBalance",
		Истина);
	Владелец.ВиртуальныеТаблицы.Вставить("BalanceAndTurnovers", Полное);
КонецПроцедуры

// Измерения, ресурсы и, при СПериодами, колонки Period…YearPeriod, Recorder и LineNumber.
// Суффиксы — «суффикс1С|суффиксOData» через запятую.
Процедура ЗаполнитьИзмеренияИРесурсы(Модель, Описание0, ОбъектМетаданных, Суффиксы, СПериодами)
	Если СПериодами Тогда
		ДобавитьПериоды(Модель, Описание0, ОбъектМетаданных);
	КонецЕсли;
	Для Каждого Поле Из ОбъектМетаданных.Измерения Цикл
		Если ПолеИсключено(Модель, ОбъектМетаданных, Поле.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьИзмерение(Модель, Описание0, Поле, "");
	КонецЦикла;
	Для Каждого Поле Из ОбъектМетаданных.Ресурсы Цикл
		Если ПолеИсключено(Модель, ОбъектМетаданных, Поле.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьРесурс(Модель, Описание0, Поле, Суффиксы, "");
	КонецЦикла;
КонецПроцедуры

// Колонки периодичности и регистратора: standard.odata объявляет их у оборотных результатов,
// но заполняет только при заданной периодичности, которой в интерфейсе нет («Решение 4»).
Процедура ДобавитьПериоды(Модель, Описание0, ОбъектМетаданных)
	Имена = "Period,SecondPeriod,MinutePeriod,HourPeriod,DayPeriod,WeekPeriod,TenDaysPeriod,MonthPeriod,"
		+ "QuarterPeriod,HalfYearPeriod,YearPeriod";
	Для Каждого Имя Из СтрРазделить(Имена, ",") Цикл
		Период = Свойство(Имя, "", "Примитив", ТипПериода());
		Период.ЧастиДаты = "ДатаВремя";
		Описание0.Свойства.Добавить(Период);
	КонецЦикла;
	// Регистратор описывается по объявленному типу, как в записях: один вид документа — Recorder_Key,
	// несколько — Recorder и Recorder_Type. standard.odata объявляет его так же и здесь.
	OData4_РегистрыМодель.ДобавитьРегистратор(Модель, Описание0.Свойства, ОбъектМетаданных);
	Описание0.Свойства.Добавить(Свойство("LineNumber", "", "Примитив", "Edm.Int64"));
КонецПроцедуры

// Измерение виртуальной таблицы: то же имя, что в записях (суффикс — "" или "Кор").
Процедура ДобавитьИзмерение(Модель, Описание0, Поле, Суффикс)
	Начало = Описание0.Свойства.Количество();
	ИмяOData = OData4_РегистрыМодель.ИмяOData(Поле.Имя, Суффикс);
	OData4_Модель.ДобавитьРеквизит(Модель, Описание0.Свойства, ИмяOData, Поле.Имя + Суффикс, Поле.Тип);
	Свойства = Новый Массив;
	Для Индекс = Начало По Описание0.Свойства.ВГраница() Цикл
		Свойства.Добавить(Описание0.Свойства[Индекс]);
	КонецЦикла;
	Описание0.Измерения.Добавить(Новый Структура("Имя1С, Свойства", Поле.Имя + Суффикс, Свойства));
КонецПроцедуры

// Ресурс виртуальной таблицы: по свойству на каждый суффикс («СуммаОстаток» → «СуммаBalance»).
Процедура ДобавитьРесурс(Модель, Описание0, Поле, Суффиксы, Префикс)
	Для Каждого Пара Из СтрРазделить(Суффиксы, ",") Цикл
		Части = СтрРазделить(Пара, "|");
		Ресурс = Свойство(Префикс + Поле.Имя + Части[1], Поле.Имя + Части[0], "Примитив", "Edm.Decimal");
		Ресурс.Разрядность = Поле.Тип.КвалификаторыЧисла.Разрядность;
		Ресурс.Дробная = Поле.Тип.КвалификаторыЧисла.РазрядностьДробнойЧасти;
		Описание0.Свойства.Добавить(Ресурс);
		Описание0.Ресурсы.Добавить(Ресурс);
	КонецЦикла;
КонецПроцедуры
// Пять виртуальных таблиц регистра бухгалтерии. Счёт и субконто есть в результате всегда;
// измерение и его корреспондирующий двойник идут одной парой (параметр Dimensions выбирает
// их вместе). Суффиксы ресурсов: у остатков — пять, у оборотов — три у балансового ресурса
// и шесть у небалансового.
Процедура ЗаполнитьБухгалтерии(Модель, Записи, Владелец, ОбъектМетаданных)
	Остатки = НовоеОписание("Balance", "Остатки", Владелец.Имя + "_Balance", Ложь, Владелец);
	ДобавитьПараметр(Остатки, "AccountCondition", "Edm.String");
	ДобавитьПараметр(Остатки, "Condition", "Edm.String");
	ДобавитьПараметр(Остатки, "Dimensions", "Edm.String");
	ДобавитьПараметр(Остатки, "ExtraDimensions", "Edm.String");
	ДобавитьПараметр(Остатки, "Period", ТипПериода());
	ДобавитьСчетИСубконто(Модель, Остатки, ОбъектМетаданных, Ложь);
	ДобавитьИзмеренияБухгалтерии(Модель, Остатки, ОбъектМетаданных, Ложь);
	ДобавитьРесурсыБухгалтерии(Модель, Остатки, ОбъектМетаданных,
		"Остаток|Balance,ОстатокДт|BalanceDr,ОстатокКт|BalanceCr,"
		+ "РазвернутыйОстатокДт|SplittedBalanceDr,РазвернутыйОстатокКт|SplittedBalanceCr", "");
	Владелец.ВиртуальныеТаблицы.Вставить("Balance", Остатки);

	Обороты = НовоеОписание("Turnovers", "Обороты", Владелец.Имя + "_Turnover", Ложь, Владелец);
	ДобавитьПараметр(Обороты, "AccountCondition", "Edm.String");
	ДобавитьПараметр(Обороты, "BalancedAccountCondition", "Edm.String");
	ДобавитьПараметр(Обороты, "BalancedExtraDimensions", "Edm.String");
	ДобавитьПараметр(Обороты, "Condition", "Edm.String");
	ДобавитьПараметр(Обороты, "Dimensions", "Edm.String");
	ДобавитьПараметр(Обороты, "EndPeriod", ТипПериода());
	ДобавитьПараметр(Обороты, "ExtraDimensions", "Edm.String");
	ДобавитьПараметр(Обороты, "Periodicity", "Edm.String");
	ДобавитьПараметр(Обороты, "StartPeriod", ТипПериода());
	ДобавитьПериоды(Модель, Обороты, ОбъектМетаданных);
	ДобавитьСчетИСубконто(Модель, Обороты, ОбъектМетаданных, Истина);
	ДобавитьИзмеренияБухгалтерии(Модель, Обороты, ОбъектМетаданных, Истина);
	ДобавитьРесурсыБухгалтерии(Модель, Обороты, ОбъектМетаданных,
		"Оборот|Turnover,ОборотДт|TurnoverDr,ОборотКт|TurnoverCr",
		"КорОборот|BalancedTurnover,КорОборотДт|BalancedTurnoverDr,КорОборотКт|BalancedTurnoverCr");
	Владелец.ВиртуальныеТаблицы.Вставить("Turnovers", Обороты);

	Полное = НовоеОписание("BalanceAndTurnovers", "ОстаткиИОбороты", Владелец.Имя + "_BalanceAndTurnover", Ложь, Владелец);
	ДобавитьПараметр(Полное, "AccountCondition", "Edm.String");
	ДобавитьПараметр(Полное, "Condition", "Edm.String");
	ДобавитьПараметр(Полное, "Dimensions", "Edm.String");
	ДобавитьПараметр(Полное, "EndPeriod", ТипПериода());
	ДобавитьПараметр(Полное, "ExtraDimensions", "Edm.String");
	ДобавитьПараметр(Полное, "Periodicity", "Edm.String");
	ДобавитьПараметр(Полное, "StartPeriod", ТипПериода());
	ДобавитьПериоды(Модель, Полное, ОбъектМетаданных);
	ДобавитьСчетИСубконто(Модель, Полное, ОбъектМетаданных, Ложь);
	ДобавитьИзмеренияБухгалтерии(Модель, Полное, ОбъектМетаданных, Ложь);
	ДобавитьРесурсыБухгалтерии(Модель, Полное, ОбъектМетаданных,
		"НачальныйОстаток|OpeningBalance,НачальныйОстатокДт|OpeningBalanceDr,"
		+ "НачальныйОстатокКт|OpeningBalanceCr,НачальныйРазвернутыйОстатокДт|OpeningSplittedBalanceDr,"
		+ "НачальныйРазвернутыйОстатокКт|OpeningSplittedBalanceCr,Оборот|Turnover,ОборотДт|TurnoverDr,"
		+ "ОборотКт|TurnoverCr,КонечныйОстаток|ClosingBalance,КонечныйОстатокДт|ClosingBalanceDr,"
		+ "КонечныйОстатокКт|ClosingBalanceCr,КонечныйРазвернутыйОстатокДт|ClosingSplittedBalanceDr,"
		+ "КонечныйРазвернутыйОстатокКт|ClosingSplittedBalanceCr", "");
	Владелец.ВиртуальныеТаблицы.Вставить("BalanceAndTurnovers", Полное);

	// Без видов субконто у плана счетов таблицы Субконто нет, и колонок субконто тоже.
	Если ЕстьСубконто(ОбъектМетаданных) Тогда
		Владелец.ВиртуальныеТаблицы.Вставить("ExtDimensions", ОписаниеСубконто(Модель, Владелец, ОбъектМетаданных));
	КонецЕсли;
	Владелец.ВиртуальныеТаблицы.Вставить("RecordsWithExtDimensions",
		ОписаниеДвижений(Модель, Записи, Владелец, ОбъектМетаданных));
КонецПроцедуры

// Счёт и субконто результата: Account_Key и ExtDimension1…N, у оборотов ещё
// BalancedAccount_Key и BalancedExtDimension1…N. Они входят в ключ результата.
Процедура ДобавитьСчетИСубконто(Модель, Описание0, ОбъектМетаданных, СКорреспонденцией)
	Если ЕстьСубконто(ОбъектМетаданных) Тогда
		Описание0.ВидыСубконто = ОбъектМетаданных.ПланСчетов.ВидыСубконто.Имя;
		Описание0.МаксСубконто = ОбъектМетаданных.ПланСчетов.МаксКоличествоСубконто;
	КонецЕсли;
	ДобавитьСчет(Модель, Описание0, ОбъектМетаданных, "Счет", "Account");
	ДобавитьСубконто(Описание0, ОбъектМетаданных, "Субконто", "ExtDimension");
	Если Не СКорреспонденцией Тогда
		Возврат;
	КонецЕсли;
	ДобавитьСчет(Модель, Описание0, ОбъектМетаданных, "КорСчет", "BalancedAccount");
	ДобавитьСубконто(Описание0, ОбъектМетаданных, "КорСубконто", "BalancedExtDimension");
КонецПроцедуры

Процедура ДобавитьСчет(Модель, Описание0, ОбъектМетаданных, Поле, Имя)
	// Счёт исключён составом (в записях — Счет или СчетДт/СчетКт): колонки счёта в результате нет.
	Если ПолеИсключено(Модель, ОбъектМетаданных, "Счет") Или ПолеИсключено(Модель, ОбъектМетаданных, "СчетДт")
		Или ПолеИсключено(Модель, ОбъектМетаданных, "СчетКт") Тогда
		Возврат;
	КонецЕсли;
	Типы = Новый Массив;
	Типы.Добавить(Тип("ПланСчетовСсылка." + ОбъектМетаданных.ПланСчетов.Имя));
	ОписаниеТипов = Новый ОписаниеТипов(Типы);
	Начало = Описание0.Свойства.Количество();
	OData4_Модель.ДобавитьРеквизит(Модель, Описание0.Свойства, Имя, Поле, ОписаниеТипов);
	Для Индекс = Начало По Описание0.Свойства.ВГраница() Цикл
		Описание0.Обязательные.Добавить(Описание0.Свойства[Индекс]);
		Описание0.Ключ.Добавить(Описание0.Свойства[Индекс]);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьСубконто(Описание0, ОбъектМетаданных, Поле, Имя)
	Для Номер = 1 По Описание0.МаксСубконто Цикл
		Значение = Свойство(Имя + Формат(Номер, "ЧГ=0"), Поле + Формат(Номер, "ЧГ=0"), "Составной", "Edm.String");
		Описание0.Свойства.Добавить(Значение);
		Описание0.Обязательные.Добавить(Значение);
		Описание0.Ключ.Добавить(Значение);
	КонецЦикла;
КонецПроцедуры

// Измерения результата: измерение и его корреспондирующий двойник — одна пара
// (Dimensions выбирает их вместе).
Процедура ДобавитьИзмеренияБухгалтерии(Модель, Описание0, ОбъектМетаданных, СКорреспонденцией)
	Для Каждого Поле Из ОбъектМетаданных.Измерения Цикл
		Если ПолеИсключено(Модель, ОбъектМетаданных, Поле.Имя) Тогда
			Продолжить;
		КонецЕсли;
		Начало = Описание0.Свойства.Количество();
		OData4_Модель.ДобавитьРеквизит(Модель, Описание0.Свойства,
			OData4_РегистрыМодель.ИмяOData(Поле.Имя, ""), Поле.Имя, Поле.Тип);
		Если СКорреспонденцией И Не Балансовое(Поле) Тогда
			OData4_Модель.ДобавитьРеквизит(Модель, Описание0.Свойства,
				OData4_РегистрыМодель.ИмяOData(Поле.Имя, "Кор"), Поле.Имя + "Кор", Поле.Тип);
		КонецЕсли;
		Свойства = Новый Массив;
		Для Индекс = Начало По Описание0.Свойства.ВГраница() Цикл
			Свойства.Добавить(Описание0.Свойства[Индекс]);
		КонецЦикла;
		Описание0.Измерения.Добавить(Новый Структура("Имя1С, Свойства", Поле.Имя, Свойства));
	КонецЦикла;
КонецПроцедуры

// Ресурсы результата: балансовые получают суффиксы Суффиксы, небалансовые — ещё и СуффиксыКор.
Процедура ДобавитьРесурсыБухгалтерии(Модель, Описание0, ОбъектМетаданных, Суффиксы, СуффиксыКор)
	Для Каждого Поле Из ОбъектМетаданных.Ресурсы Цикл
		Если ПолеИсключено(Модель, ОбъектМетаданных, Поле.Имя) Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьРесурс(Модель, Описание0, Поле, Суффиксы, "");
		Если СуффиксыКор <> "" И Не Балансовое(Поле) Тогда
			ДобавитьРесурс(Модель, Описание0, Поле, СуффиксыКор, "");
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Поле регистра исключено составом модели: исключённое измерение, ресурс или счёт не попадает ни в записи, ни в
// результаты виртуальных таблиц. ОбъектМетаданных без ПолноеИмя (подмена в тестах) исключений не имеет.
Функция ПолеИсключено(Модель, ОбъектМетаданных, ИмяПоля)
	Состав = Неопределено;
	Если Не Модель.Свойство("Состав", Состав) Или Состав = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат OData4_Модель.Исключено(Состав, ОбъектМетаданных, ИмяПоля);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Балансовое поле; отсутствие свойства Балансовый означает Истина.
Функция Балансовое(Поле)
	Попытка
		Возврат Поле.Балансовый;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

// Субконто (ExtDimensions): параметров нет, ключ — Recorder, LineNumber, Type_Key и RecordType
// (проба: один вид субконто бывает и в дебете, и в кредите строки — без RecordType 62 574 групп
// на 64 738 строк, и постраничная выдача теряла строки).
Функция ОписаниеСубконто(Модель, Владелец, ОбъектМетаданных)
	Описание0 = НовоеОписание("ExtDimensions", "Субконто", Владелец.Имя + "_ExtDimensions", Ложь, Владелец);
	Период = Свойство("Period", "Период", "Примитив", ТипПериода());
	Период.ЧастиДаты = "ДатаВремя";
	Регистратор = Свойство("Recorder", "Регистратор", "Составной", "Edm.String");
	Номер = Свойство("LineNumber", "НомерСтроки", "Примитив", "Edm.Int64");
	ВидДвижения = Свойство("RecordType", "ВидДвижения", "ВидДвижения", "Edm.String");
	ВидДвижения.Перечисление = "ВидДвиженияБухгалтерии";
	Для Каждого Элемент Из Массив3(Период, Регистратор, Номер) Цикл
		Описание0.Свойства.Добавить(Элемент);
		Описание0.Обязательные.Добавить(Элемент);
	КонецЦикла;
	Описание0.Свойства.Добавить(ВидДвижения);
	Описание0.Обязательные.Добавить(ВидДвижения);
	Типы = Новый Массив;
	Типы.Добавить(Тип("ПланВидовХарактеристикСсылка." + ОбъектМетаданных.ПланСчетов.ВидыСубконто.Имя));
	Вид = OData4_Модель.ДобавитьРеквизит(Модель, Описание0.Свойства, "Type", "Вид", Новый ОписаниеТипов(Типы));
	Описание0.Обязательные.Добавить(Вид);
	Значение = Свойство("Value", "Значение", "Составной", "Edm.String");
	Описание0.Свойства.Добавить(Значение);
	Описание0.Обязательные.Добавить(Значение);
	Описание0.Ключ.Добавить(Регистратор);
	Описание0.Ключ.Добавить(Номер);
	Описание0.Ключ.Добавить(Вид);
	Описание0.Ключ.Добавить(ВидДвижения);
	Возврат Описание0;
КонецФункции

// Движения с субконто (RecordsWithExtDimensions): поля записи регистра плюс субконто дебета
// и кредита; ключ — Recorder и LineNumber.
Функция ОписаниеДвижений(Модель, Записи, Владелец, ОбъектМетаданных)
	Описание0 = НовоеОписание("RecordsWithExtDimensions", "ДвиженияССубконто",
		Владелец.Имя + "_RecordsWithExtDimensions", Ложь, Владелец);
	ДобавитьПараметр(Описание0, "Condition", "Edm.String");
	ДобавитьПараметр(Описание0, "EndPeriod", ТипПериода());
	ДобавитьПараметр(Описание0, "Order", "Edm.String");
	ДобавитьПараметр(Описание0, "StartPeriod", ТипПериода());
	ДобавитьПараметр(Описание0, "Top", "Edm.Int64");
	Для Каждого Исходное Из Записи.Свойства Цикл
		// Субконто строк (настройка 6.4) у движений с субконто — свои, ниже; NULL поля Дт/Кт здесь — null, как у
		// standard.odata (в строках набора — пустое значение, NullКакПустое).
		Если СтрНачинаетсяС(Исходное.Поле, "Субконто") Тогда
			Продолжить;
		КонецЕсли;
		Свойство0 = Исходное;
		Если Исходное.NullКакПустое Тогда
			Свойство0 = Новый Структура;
			Для Каждого КлючИЗначение Из Исходное Цикл
				Свойство0.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			КонецЦикла;
			Свойство0.NullКакПустое = Ложь;
		КонецЕсли;
		Описание0.Свойства.Добавить(Свойство0);
		Описание0.Обязательные.Добавить(Свойство0);
		Если Свойство0.Поле = "Регистратор" Или Свойство0.Поле = "НомерСтроки" Тогда
			Описание0.Ключ.Добавить(Свойство0);
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьСубконто(ОбъектМетаданных) Тогда
		Возврат Описание0;
	КонецЕсли;
	Типы = Новый Массив;
	Типы.Добавить(Тип("ПланВидовХарактеристикСсылка." + ОбъектМетаданных.ПланСчетов.ВидыСубконто.Имя));
	ОписаниеВида = Новый ОписаниеТипов(Типы);
	Для Каждого Пара Из СтрРазделить("Дт|Dr,Кт|Cr", ",") Цикл
		Части = СтрРазделить(Пара, "|");
		Для Номер = 1 По ОбъектМетаданных.ПланСчетов.МаксКоличествоСубконто Цикл
			Цифра = Формат(Номер, "ЧГ=0");
			Значение = Свойство("ExtDimension" + Части[1] + Цифра, "Субконто" + Части[0] + Цифра,
				"Составной", "Edm.String");
			Описание0.Свойства.Добавить(Значение);
			Описание0.Обязательные.Добавить(Значение);
			Вид = OData4_Модель.ДобавитьРеквизит(Модель, Описание0.Свойства,
				"ExtDimensionType" + Части[1] + Цифра, "ВидСубконто" + Части[0] + Цифра, ОписаниеВида);
			Описание0.Обязательные.Добавить(Вид);
		КонецЦикла;
	КонецЦикла;
	Возврат Описание0;
КонецФункции

// У плана счетов регистра есть виды субконто (план видов характеристик и хотя бы одна колонка).
Функция ЕстьСубконто(ОбъектМетаданных)
	ПланСчетов = ОбъектМетаданных.ПланСчетов;
	Возврат ПланСчетов.ВидыСубконто <> Неопределено И ПланСчетов.МаксКоличествоСубконто > 0;
КонецФункции

Функция Массив3(Первый, Второй, Третий)
	Результат = Новый Массив;
	Результат.Добавить(Первый);
	Результат.Добавить(Второй);
	Результат.Добавить(Третий);
	Возврат Результат;
КонецФункции

// Колонки субконто сверх числа видов в ExtraDimensions и BalancedExtraDimensions: Поле → Истина.
Функция ЛишниеСубконто(Описание0, Значения)
	Лишние = Новый Соответствие;
	Если Значения = Неопределено Тогда
		Возврат Лишние;
	КонецЕсли;
	Для Каждого Пара Из СтрРазделить("ExtraDimensions|Субконто,BalancedExtraDimensions|КорСубконто", ",") Цикл
		Части = СтрРазделить(Пара, "|");
		Текст = Неопределено;
		Если Не Значения.Свойство(Части[0], Текст) Или Текст = Неопределено Или СокрЛП(Текст) = "" Тогда
			Продолжить;
		КонецЕсли;
		Видов = СтрРазделить(Текст, ",", Ложь).Количество();
		Для Номер = Видов + 1 По Описание0.МаксСубконто Цикл
			Лишние.Вставить(Части[1] + Формат(Номер, "ЧГ=0"), Истина);
		КонецЦикла;
	КонецЦикла;
	Возврат Лишние;
КонецФункции

// Свойство результата упомянуто в запросе: по имени, по имени «Имя_Type» составного или по имени навигации.
// Упомянутые = Неопределено — упомянуты все.
Функция Упомянуто(Свойство0, Упомянутые)
	Если Упомянутые = Неопределено Или Упомянутые.Получить(Свойство0.Имя) <> Неопределено Тогда
		Возврат Истина;
	ИначеЕсли Свойство0.Вид = "Составной" И Упомянутые.Получить(Свойство0.Имя + "_Type") <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Возврат Свойство0.ИмяНавигации <> "" И Упомянутые.Получить(Свойство0.ИмяНавигации) <> Неопределено;
КонецФункции

// Копия описания свойства с другим полем таблицы 1С (колонка периода, заполненная периодичностью).
Функция СкопироватьСвойство(Свойство0, Поле)
	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из Свойство0 Цикл
		Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Копия.Поле = Поле;
	Возврат Копия;
КонецФункции

// Ключевое слово периодичности вызова ("" — параметр не задан).
Функция СловоПериодичности(Описание0, Значения)
	Периодичность = ПериодичностьВызова(Описание0, Значения);
	Возврат ?(Периодичность = Неопределено, "", Периодичность.Слово);
КонецФункции

Процедура ДобавитьВКлюч(Набор, Свойство0)
	Если Набор.Ключ.Найти(Свойство0.Имя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Набор.Ключ.Добавить(Свойство0.Имя);
	Набор.ПоляКлюча.Добавить(Свойство0);
	Если Свойство0.Вид = "Составной" Тогда
		Набор.Ключ.Добавить(Свойство0.Имя + "_Type");
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьИндексыНабора(Набор)
	ПоИмени = Новый Соответствие;
	ВыборПоИмени = Новый Соответствие;
	Для Каждого Свойство0 Из Набор.Свойства Цикл
		ПоИмени.Вставить(Свойство0.Имя, Свойство0);
		ВыборПоИмени.Вставить(Свойство0.Имя, Свойство0);
		Если Свойство0.Вид = "Составной" Или Свойство0.Вид = "Хранилище" Тогда
			ВыборПоИмени.Вставить(Свойство0.Имя + "_Type", Свойство0);
		КонецЕсли;
		Если Свойство0.Вид = "Хранилище" Тогда
			ВыборПоИмени.Вставить(Свойство0.Имя + "_Base64Data", Свойство0);
		КонецЕсли;
	КонецЦикла;
	Навигация = Новый Соответствие;
	Для Каждого Свойство0 Из Набор.Свойства Цикл
		Если Свойство0.Вид = "Ссылка" И Свойство0.ИмяНавигации <> "" Тогда
			Навигация.Вставить(Свойство0.ИмяНавигации, Свойство0);
		КонецЕсли;
	КонецЦикла;
	Набор.Вставить("ПоИмени", ПоИмени);
	Набор.Вставить("ВыборПоИмени", ВыборПоИмени);
	Набор.Вставить("Навигация", Навигация);
	Набор.Вставить("ТабличныеЧастиПоИмени", Новый Соответствие);
КонецПроцедуры

// Значение одного параметра по типу Edm: литерал разбирается лексером $filter.
Функция ЗначениеПараметра(Модель, Параметры, Набор, Имя, ТипEdm, Текст)
	Если ТипEdm = "Edm.String" Тогда
		Возврат ТекстСтрокового(Имя, Текст);
	КонецЕсли;
	Попытка
		Узел = OData4_Разбор.РазобратьФильтр(Текст);
	Исключение
		Узел = Неопределено;
	КонецПопытки;
	Если Узел = Неопределено Или Узел.kind <> "literal" Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest",
			"Значение параметра " + Имя + " несовместимо с типом " + ТипEdm);
	КонецЕсли;
	Контекст = OData4_Генератор.НовыйКонтекст(Модель, Параметры, Набор, "Т");
	Тип0 = ТипПоТипуEdm(ТипEdm);
	Попытка
		Возврат OData4_Генератор.ЗначениеПоТипу(Узел, Тип0, Контекст);
	Исключение
		OData4_Сервис.ОшибкаOData(400, "BadRequest",
			"Значение параметра " + Имя + " несовместимо с типом " + ТипEdm);
	КонецПопытки;
КонецФункции

// Строковый параметр: только строковый литерал в одинарных кавычках (удвоенная кавычка внутри — одна).
Функция ТекстСтрокового(Имя, Текст)
	Если СтрДлина(Текст) >= 2 И Лев(Текст, 1) = "'" И Прав(Текст, 1) = "'" Тогда
		Возврат СтрЗаменить(Сред(Текст, 2, СтрДлина(Текст) - 2), "''", "'");
	КонецЕсли;
	OData4_Сервис.ОшибкаOData(400, "BadRequest",
		"Значение параметра " + Имя + " несовместимо с типом Edm.String");
КонецФункции

Функция ТипПоТипуEdm(ТипEdm)
	Если ТипEdm = "Edm.Int64" Тогда
		Возврат OData4_Генератор.НовыйТипВыражения("Число");
	КонецЕсли;
	Тип0 = OData4_Генератор.НовыйТипВыражения("Дата");
	Тип0.ЧастиДаты = "ДатаВремя";
	Возврат Тип0;
КонецФункции

// Условие параметра Condition вместе с отборами профиля (Профиль — OData4_Безопасность.УсловиеВиртуальнойТаблицы).
Функция УсловиеСПрофилем(Текст, Профиль)
	Если Профиль.Текст = "" Тогда
		Возврат Текст;
	ИначеЕсли Текст = "" Тогда
		Возврат Профиль.Текст;
	КонецЕсли;
	Возврат "(" + Текст + ") И " + Профиль.Текст;
КонецФункции

// Разбор текста Condition как $filter; ошибка разбора получает имя параметра вместо «$filter». Сложность
// выражения ограничена лимитом профиля (5.2).
Функция РазобратьУсловие(ИмяПараметра, Текст)
	Попытка
		Дерево = OData4_Разбор.РазобратьФильтр(Текст);
	Исключение
		Сообщение = OData4_Сервис.СообщениеОшибки(ИнформацияОбОшибке());
		Если СтрНачинаетсяС(Сообщение, "$filter") Тогда
			Сообщение = ИмяПараметра + Сред(Сообщение, 8);
		КонецЕсли;
		OData4_Сервис.ОшибкаOData(400, "BadRequest", Сообщение);
	КонецПопытки;
	OData4_Безопасность.ПроверитьСложность(Дерево, ИмяПараметра);
	Возврат Дерево;
КонецФункции

// Текст источника плана по описанию и значениям параметров. НаборФункции — набор модели, которому принадлежит
// функция: по нему строятся отборы строк профиля (5.2) — они входят в условие виртуальной таблицы через И;
// отбор, который полями таблицы не выразить, закрывает строки («ЛОЖЬ» в условии выборки).
Функция ИсточникПлана(План, Описание0, Значения, НаборФункции = Неопределено) Экспорт
	Модель = План.Модель;
	Параметры = План.Параметры;
	Набор = План.Набор;
	Контекст = OData4_Генератор.НовыйКонтекст(Модель, Параметры, Набор, "Т");
	Профиль = Новый Структура("Текст, Запрет, Ошибка", "", Ложь, Неопределено);
	Если НаборФункции <> Неопределено Тогда
		Профиль = OData4_Безопасность.УсловиеВиртуальнойТаблицы(Параметры, НаборФункции, Описание0);
	КонецЕсли;
	Если Профиль.Ошибка <> Неопределено Тогда
		OData4_Сервис.ОшибкаOData(500, "InternalError", Профиль.Ошибка);
	КонецЕсли;
	Если Профиль.Запрет Или Профиль.Текст <> "" И Описание0.Таблица = "Субконто" Тогда
		План.Выборка.Условия.Добавить("ЛОЖЬ");
	КонецЕсли;
	// Condition — условие таблицы 1С: в нём доступны все измерения, не только выбранные Dimensions
	// (standard.odata: Balance(Dimensions='Организация',Condition='ФизическоеЛицо_Key ne …') — 200).
	// Набор всех измерений строится, только если Condition задан.
	НаборУсловия = Набор;
	ТекстУсловия0 = Неопределено;
	Если Не Описание0.ВозвратНабор И Значения.Свойство("Condition", ТекстУсловия0) И ТекстУсловия0 <> Неопределено
		И СокрЛП(ТекстУсловия0) <> "" Тогда
		НаборУсловия = НаборРезультата(Модель, Описание0, Неопределено, Значения);
	КонецЕсли;
	Запрещенные = ЗапрещенныеВУсловии(Описание0);
	Аргументы = Новый Массив;
	Таблица = Описание0.Таблица;
	Если Таблица = "СрезПоследних" Или Таблица = "СрезПервых" Тогда
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.Period));
		Аргументы.Добавить(УсловиеСПрофилем(ТекстУсловия(Модель, Параметры, НаборУсловия, "Condition", Значения.Condition, Запрещенные), Профиль));
	ИначеЕсли Таблица = "Остатки" И Описание0.ВидТаблицы = "РегистрНакопления" Тогда
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.Period));
		Аргументы.Добавить(УсловиеСПрофилем(ТекстУсловия(Модель, Параметры, НаборУсловия, "Condition", Значения.Condition, Запрещенные), Профиль));
	ИначеЕсли Таблица = "Обороты" И Описание0.ВидТаблицы = "РегистрНакопления" Тогда
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.StartPeriod));
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.EndPeriod));
		Аргументы.Добавить(СловоПериодичности(Описание0, Значения));
		Аргументы.Добавить(УсловиеСПрофилем(ТекстУсловия(Модель, Параметры, НаборУсловия, "Condition", Значения.Condition, Запрещенные), Профиль));
	ИначеЕсли Таблица = "ОстаткиИОбороты" И Описание0.ВидТаблицы = "РегистрНакопления" Тогда
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.StartPeriod));
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.EndPeriod));
		Аргументы.Добавить(СловоПериодичности(Описание0, Значения));
		Аргументы.Добавить("");
		Аргументы.Добавить(УсловиеСПрофилем(ТекстУсловия(Модель, Параметры, НаборУсловия, "Condition", Значения.Condition, Запрещенные), Профиль));
	ИначеЕсли Таблица = "Остатки" Тогда
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.Period));
		Аргументы.Добавить(ТекстУсловия(Модель, Параметры, Набор, "AccountCondition", Значения.AccountCondition));
		Аргументы.Добавить(ТекстСубконто(Контекст, Описание0, "ExtraDimensions", Значения.ExtraDimensions));
		Аргументы.Добавить(УсловиеСПрофилем(ТекстУсловия(Модель, Параметры, НаборУсловия, "Condition", Значения.Condition, Запрещенные), Профиль));
	ИначеЕсли Таблица = "Обороты" Тогда
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.StartPeriod));
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.EndPeriod));
		Аргументы.Добавить(СловоПериодичности(Описание0, Значения));
		Аргументы.Добавить(ТекстУсловия(Модель, Параметры, Набор, "AccountCondition", Значения.AccountCondition));
		Аргументы.Добавить(ТекстСубконто(Контекст, Описание0, "ExtraDimensions", Значения.ExtraDimensions));
		// Порядок параметров 1С: …, Субконто, Условие, УсловиеКорСчета, КорСубконто (проба: с КорСубконто
		// шестым — «Неверные параметры … Обороты, 6»).
		Аргументы.Добавить(УсловиеСПрофилем(ТекстУсловия(Модель, Параметры, НаборУсловия, "Condition", Значения.Condition, Запрещенные), Профиль));
		Аргументы.Добавить(ТекстУсловия(Модель, Параметры, Набор, "BalancedAccountCondition",
			Значения.BalancedAccountCondition));
		Аргументы.Добавить(ТекстСубконто(Контекст, Описание0, "BalancedExtraDimensions",
			Значения.BalancedExtraDimensions));
	ИначеЕсли Таблица = "ОстаткиИОбороты" Тогда
		// Параметры 1С: Начало, Конец, Периодичность, МетодДополнения, УсловиеСчета, Субконто, Условие
		// (проба: без пустого МетодДополнения — «Неверные параметры … ОстаткиИОбороты, 3»).
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.StartPeriod));
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.EndPeriod));
		Аргументы.Добавить(СловоПериодичности(Описание0, Значения));
		Аргументы.Добавить("");
		Аргументы.Добавить(ТекстУсловия(Модель, Параметры, Набор, "AccountCondition", Значения.AccountCondition));
		Аргументы.Добавить(ТекстСубконто(Контекст, Описание0, "ExtraDimensions", Значения.ExtraDimensions));
		Аргументы.Добавить(УсловиеСПрофилем(ТекстУсловия(Модель, Параметры, НаборУсловия, "Condition", Значения.Condition, Запрещенные), Профиль));
	ИначеЕсли Таблица = "Субконто" Тогда
		// Параметры задавать нельзя (проба: «Нельзя задавать параметры для таблицы … Субконто»).
	ИначеЕсли Таблица = "ДвиженияССубконто" Тогда
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.StartPeriod));
		Аргументы.Добавить(ТекстПериода(Контекст, Значения.EndPeriod));
		Аргументы.Добавить(УсловиеСПрофилем(ТекстУсловия(Модель, Параметры, НаборУсловия, "Condition", Значения.Condition, Запрещенные), Профиль));
		ПроверитьПорядок(Набор, Значения.Order);
		Аргументы.Добавить("");
		Аргументы.Добавить(ТекстПервых(Контекст, Значения.Top));
	Иначе
		OData4_Сервис.ОшибкаOData(501, "NotImplemented", "Виртуальная таблица не поддерживается: " + Описание0.Имя);
	КонецЕсли;
	Возврат ТекстИсточника(Контекст, Описание0, Аргументы);
КонецФункции

// Виды субконто параметром-массивом: GUID через запятую. Пустое значение — пустое место в скобках.
Функция ТекстСубконто(Контекст, Описание0, Имя, Текст)
	Если Текст = Неопределено Или СокрЛП(Текст) = "" Тогда
		Возврат "";
	КонецЕсли;
	Возврат OData4_Генератор.ДобавитьПараметр(Контекст, ЗначенияСубконто(Описание0, Имя, Текст));
КонецФункции

// Массив ссылок на виды субконто (ПланВидовХарактеристикСсылка плана видов субконто регистра)
// по GUID через запятую; не GUID — 400. Виртуальная таблица 1С принимает только ссылки:
// с массивом УникальныйИдентификатор запрос падает.
Функция ЗначенияСубконто(Описание0, Имя, Текст) Экспорт
	Если Описание0.ВидыСубконто = "" Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "У регистра нет видов субконто: " + Имя);
	КонецЕсли;
	Менеджер = ПланыВидовХарактеристик[Описание0.ВидыСубконто];
	Значения = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Текст, ",", Ложь) Цикл
		Текст0 = СокрЛП(Часть);
		Попытка
			Идентификатор = Новый УникальныйИдентификатор(Текст0);
		Исключение
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Значение " + Имя + " не GUID: " + Текст0);
		КонецПопытки;
		Значения.Добавить(Менеджер.ПолучитьСсылку(Идентификатор));
	КонецЦикла;
	Если Значения.Количество() > Описание0.МаксСубконто Тогда
		// standard.odata здесь падает («Недопустимое значение параметра виды субконто»).
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Видов субконто в " + Имя + " больше "
			+ Формат(Описание0.МаксСубконто, "ЧГ=0"));
	КонецЕсли;
	Возврат Значения;
КонецФункции

// Проверка параметра Order: только имена свойств результата, иначе 400. В таблицу 1С Order
// не передаётся: standard.odata его не применяет (Top=3 с Order='Period desc', 'Period' и даже
// 'Нет desc' — те же три первые строки), а с порядком ПЕРВЫЕ N выбрали бы другие строки.
Процедура ПроверитьПорядок(Набор, Текст)
	Если Текст = Неопределено Или СокрЛП(Текст) = "" Тогда
		Возврат;
	КонецЕсли;
	Элементы = OData4_Разбор.РазобратьПорядок(Текст);
	Для Каждого Элемент Из Элементы Цикл
		Узел = Элемент.expression;
		Если Узел.kind <> "path" Или Узел.variable <> "" Или Узел.segments.Количество() <> 1 Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "В Order допустимы только имена свойств");
		КонецЕсли;
		Свойство0 = Набор.ПоИмени.Получить(Узел.segments[0]);
		Если Свойство0 = Неопределено Или Свойство0.Поле = "" Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство не найдено: " + Набор.Имя + "." + Узел.segments[0]);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Top параметром запроса (проба: ДвиженияССубконто(, , , , &Н) принимает параметр); 0 — без ограничения,
// как в standard.odata.
Функция ТекстПервых(Контекст, Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если Значение <> Цел(Значение) Или Значение < 0 Или Значение > 1000000 Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Значение Top вне диапазона: " + Формат(Значение, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Возврат OData4_Генератор.ДобавитьПараметр(Контекст, Значение);
КонецФункции

// Период параметром запроса; Неопределено — пустое место в скобках (граница по умолчанию).
Функция ТекстПериода(Контекст, Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат OData4_Генератор.ДобавитьПараметр(Контекст, Значение);
КонецФункции

#КонецОбласти
