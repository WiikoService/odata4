#Область ПрограммныйИнтерфейс

// Дерево разбора $filter: Структура и Массив с латинскими ключами (формат — tests/fixtures/filter.json).
// Ошибка синтаксиса — исключение OData 400 с позицией (с 1) в тексте параметра.
Функция РазобратьФильтр(Текст) Экспорт
	Разбор = НовыйРазбор(Текст, "$filter");
	Узел = Выражение(Разбор);
	ПроверитьКонец(Разбор);
	Возврат Узел;
КонецФункции

// $orderby: Массив Структур «expression, direction» (asc | desc).
Функция РазобратьПорядок(Текст) Экспорт
	Разбор = НовыйРазбор(Текст, "$orderby");
	Результат = СписокПорядка(Разбор);
	ПроверитьКонец(Разбор);
	Возврат Результат;
КонецФункции

// $select: Массив путей, путь — Массив имён; «*» — Массив из одного "*".
Функция РазобратьВыбор(Текст) Экспорт
	Разбор = НовыйРазбор(Текст, "$select");
	Результат = СписокВыбора(Разбор);
	ПроверитьКонец(Разбор);
	Возврат Результат;
КонецФункции

// $expand: Массив Структур «path, options»; path — Массив имён или ["*"], options — как у РазобратьПараметры
// без skiptoken и format. Вложенность скобок параметров раскрытия вместе со скобками в их выражениях — до 32;
// предел глубины раскрытия по навигации проверяет планировщик.
Функция РазобратьРаскрытие(Текст) Экспорт
	Разбор = НовыйРазбор(Текст, "$expand");
	Результат = СписокРаскрытия(Разбор);
	ПроверитьКонец(Разбор);
	Возврат Результат;
КонецФункции

// $apply: Массив шагов (формат — tests/fixtures/apply.json). Шаг — Структура с ключом kind: identity, filter,
// groupby, aggregate, compute, topcount, bottomcount. Ошибка синтаксиса — исключение OData 400 с позицией;
// неподдерживаемое преобразование — 501. Не больше 10 шагов в запросе (вместе с вложенными в groupby),
// не больше 64 свойств в groupby и элементов в aggregate и compute.
Функция РазобратьПреобразование(Текст) Экспорт
	Разбор = НовыйРазбор(Текст, "$apply");
	Разбор.Вставить("Шагов", 0);
	Результат = ЦепочкаШагов(Разбор);
	ПроверитьКонец(Разбор);
	Возврат Результат;
КонецФункции

// Системные параметры запроса (Соответствие имя → строка) → Структура «filter, orderby, select, expand, top,
// skip, count, skiptoken, format, apply»; отсутствующие — Неопределено. $inlinecount=allpages — то же, что
// $count=true. $search, $compute — 501; неизвестный параметр с $ (в том числе $levels вне $expand) — 400;
// параметры без $ не рассматриваются.
Функция РазобратьПараметры(ПараметрыЗапроса) Экспорт
	Опции = НовыеОпции();
	Опции.Вставить("skiptoken", Неопределено);
	Опции.Вставить("format", Неопределено);
	Опции.Вставить("apply", Неопределено);
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Имя = КлючИЗначение.Ключ;
		Значение = КлючИЗначение.Значение;
		Если Не СтрНачинаетсяС(Имя, "$") Тогда
			Продолжить;
		ИначеЕсли Имя = "$filter" Тогда
			Опции.filter = РазобратьФильтр(Значение);
		ИначеЕсли Имя = "$orderby" Тогда
			Опции.orderby = РазобратьПорядок(Значение);
		ИначеЕсли Имя = "$select" Тогда
			Опции.select = РазобратьВыбор(Значение);
		ИначеЕсли Имя = "$expand" Тогда
			Опции.expand = РазобратьРаскрытие(Значение);
		ИначеЕсли Имя = "$top" Или Имя = "$skip" Тогда
			Если Не ЭтоЦелоеБезЗнака(Значение) Тогда
				ОшибкаРазбора(Имя + ": ожидалось неотрицательное целое число");
			КонецЕсли;
			Опции[Сред(Имя, 2)] = Число(Значение);
		ИначеЕсли Имя = "$count" Тогда
			Если Значение = "true" Тогда
				Опции.count = Истина;
			ИначеЕсли Значение = "false" Тогда
				Опции.count = ?(Опции.count = Истина, Истина, Ложь);
			Иначе
				ОшибкаРазбора("$count: ожидалось true или false");
			КонецЕсли;
		ИначеЕсли Имя = "$inlinecount" Тогда
			Если Значение = "allpages" Тогда
				Опции.count = Истина;
			ИначеЕсли Значение = "none" Тогда
				Опции.count = ?(Опции.count = Истина, Истина, Ложь);
			Иначе
				ОшибкаРазбора("$inlinecount: ожидалось allpages или none");
			КонецЕсли;
		ИначеЕсли Имя = "$skiptoken" Тогда
			Опции.skiptoken = Значение;
		ИначеЕсли Имя = "$format" Тогда
			Опции.format = Значение;
		ИначеЕсли Имя = "$apply" Тогда
			Опции.apply = РазобратьПреобразование(Значение);
		ИначеЕсли ЭтоНеподдерживаемыйПараметр(Имя) Тогда
			OData4_Сервис.ОшибкаOData(501, "NotImplemented", "Параметр запроса не поддерживается: " + Имя);
		Иначе
			ОшибкаРазбора("Неизвестный параметр запроса: " + Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Опции;
КонецФункции

// Опции коллекции и раскрытия: Структура «filter, orderby, select, expand, top, skip, count», все Неопределено.
Функция НовыеОпции() Экспорт
	Возврат Новый Структура("filter, orderby, select, expand, top, skip, count");
КонецФункции

#КонецОбласти

#Область Лексер

// Лексемы текста параметра: Массив Структур «Вид, Текст, Значение, Позиция».
// Вид: Имя, Строка, Литерал (Значение — узел literal), Знак, Конец. Позиция — номер символа с 1.
Функция Лексемы(Текст, Параметр) Экспорт
	Результат = Новый Массив;
	ДлинаТекста = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= ДлинаТекста Цикл
		Сим = Сред(Текст, Позиция, 1);
		Если Сим = " " Или Сим = Символы.Таб Или Сим = Символы.ПС Или Сим = Символы.ВК Тогда
			Позиция = Позиция + 1;
		ИначеЕсли Сим = "'" Тогда
			Край = КонецСтроки(Текст, Позиция, Параметр);
			Результат.Добавить(НоваяЛексема("Строка", Сред(Текст, Позиция, Край - Позиция + 1),
				СодержимоеСтроки(Текст, Позиция, Край), Позиция));
			Позиция = Край + 1;
		ИначеЕсли ЭтоГУИД(Текст, Позиция) Тогда
			Сырой = Сред(Текст, Позиция, 36);
			Результат.Добавить(НоваяЛексема("Литерал", Сырой, УзелЛитерала("Edm.Guid", НРег(Сырой)), Позиция));
			Позиция = Позиция + 36;
		ИначеЕсли ЭтоЦифра(Сим) Тогда
			Позиция = ДобавитьЧисловойЛитерал(Результат, Текст, Позиция, Параметр);
		ИначеЕсли ЭтоНачалоИмени(Сим) Тогда
			Край = Позиция;
			Пока Край < ДлинаТекста И ЭтоСимволИмени(Сред(Текст, Край + 1, 1)) Цикл
				Край = Край + 1;
			КонецЦикла;
			Имя = Сред(Текст, Позиция, Край - Позиция + 1);
			Если Сред(Текст, Край + 1, 1) = "'" Тогда
				КонецКавычки = КонецСтроки(Текст, Край + 1, Параметр);
				Сырой = Сред(Текст, Позиция, КонецКавычки - Позиция + 1);
				Узел = ТипизированныйЛитерал(Имя, СодержимоеСтроки(Текст, Край + 1, КонецКавычки), Сырой, Позиция, Параметр);
				Результат.Добавить(НоваяЛексема("Литерал", Сырой, Узел, Позиция));
				Позиция = КонецКавычки + 1;
			Иначе
				Результат.Добавить(НоваяЛексема("Имя", Имя, Неопределено, Позиция));
				Позиция = Край + 1;
			КонецЕсли;
		ИначеЕсли СтрНайти("(),/:=;*-", Сим) > 0 Тогда
			Результат.Добавить(НоваяЛексема("Знак", Сим, Неопределено, Позиция));
			Позиция = Позиция + 1;
		Иначе
			ОшибкаРазбора(СтрШаблон("%1: недопустимый символ «%2» в позиции %3", Параметр,
				СимволОшибки(Текст, Позиция), Число0(Позиция)));
		КонецЕсли;
	КонецЦикла;
	Результат.Добавить(НоваяЛексема("Конец", "", Неопределено, ДлинаТекста + 1));
	Возврат Результат;
КонецФункции

Функция НоваяЛексема(Вид, Текст, Значение, Позиция)
	Возврат Новый Структура("Вид, Текст, Значение, Позиция", Вид, Текст, Значение, Позиция);
КонецФункции

// Символ для текста ошибки: суррогатная пара (символ вне BMP) — целиком, иначе одна единица строки.
// Позиция при этом остаётся позицией первой единицы: её же считает компонента.
Функция СимволОшибки(Текст, Позиция)
	Код = КодСимвола(Текст, Позиция);
	Если Код >= 55296 И Код <= 56319 И Позиция < СтрДлина(Текст) Тогда
		Следующий = КодСимвола(Текст, Позиция + 1);
		Если Следующий >= 56320 И Следующий <= 57343 Тогда
			Возврат Сред(Текст, Позиция, 2);
		КонецЕсли;
	КонецЕсли;
	Возврат Сред(Текст, Позиция, 1);
КонецФункции

// Позиция закрывающей кавычки строки, открытой в Начало; '' внутри — кавычка.
Функция КонецСтроки(Текст, Начало, Параметр)
	ДлинаТекста = СтрДлина(Текст);
	Позиция = Начало + 1;
	Пока Позиция <= ДлинаТекста Цикл
		Если Сред(Текст, Позиция, 1) = "'" Тогда
			Если Сред(Текст, Позиция + 1, 1) = "'" Тогда
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			Возврат Позиция;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	ОшибкаРазбора(СтрШаблон("%1: незакрытая строка в позиции %2", Параметр, Число0(Начало)));
КонецФункции

Функция СодержимоеСтроки(Текст, Начало, Край)
	Возврат СтрЗаменить(Сред(Текст, Начало + 1, Край - Начало - 1), "''", "'");
КонецФункции

Функция ЭтоЦифра(Сим)
	Возврат Сим <> "" И СтрНайти("0123456789", Сим) > 0;
КонецФункции

Функция ЭтоШестнадцатеричная(Сим)
	Возврат Сим <> "" И СтрНайти("0123456789abcdefABCDEF", Сим) > 0;
КонецФункции

Функция ЭтоБуква(Сим)
	Возврат Сим <> "" И ВРег(Сим) <> НРег(Сим);
КонецФункции

Функция ЭтоНачалоИмени(Сим)
	Возврат ЭтоБуква(Сим) Или Сим = "_" Или Сим = "$";
КонецФункции

Функция ЭтоСимволИмени(Сим)
	Возврат ЭтоБуква(Сим) Или ЭтоЦифра(Сим) Или Сим = "_" Или Сим = ".";
КонецФункции

// Шаблон: цифры (0), шестнадцатеричные (h), прочие символы — как есть.
Функция СовпадаетСШаблоном(Текст, Позиция, Шаблон)
	Если СтрДлина(Текст) - Позиция + 1 < СтрДлина(Шаблон) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Шаблон) Цикл
		Образец = Сред(Шаблон, Индекс, 1);
		Сим = Сред(Текст, Позиция + Индекс - 1, 1);
		Если Образец = "0" Тогда
			Если Не ЭтоЦифра(Сим) Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли Образец = "h" Тогда
			Если Не ЭтоШестнадцатеричная(Сим) Тогда
				Возврат Ложь;
			КонецЕсли;
		ИначеЕсли Сим <> Образец Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЭтоГУИД(Текст, Позиция)
	Возврат СовпадаетСШаблоном(Текст, Позиция, "hhhhhhhh-hhhh-hhhh-hhhh-hhhhhhhhhhhh")
		И Не ЭтоСимволИмени(Сред(Текст, Позиция + 36, 1));
КонецФункции

// Литерал, начинающийся с цифры: дата, дата и время, время или число. Возвращает позицию после литерала.
Функция ДобавитьЧисловойЛитерал(Результат, Текст, Позиция, Параметр)
	Длина = ДлинаДатыВремени(Текст, Позиция);
	Если Длина > 0 Тогда
		Сырой = Сред(Текст, Позиция, Длина);
		Если Длина = 10 Тогда
			ТипЛитерала = "Edm.Date";
		ИначеЕсли ЕстьЗона(Сырой) Тогда
			ТипЛитерала = "Edm.DateTimeOffset";
		Иначе
			ТипЛитерала = "Edm.DateTime";
		КонецЕсли;
		ПроверитьКонецЛитерала(Текст, Сырой, Позиция, Параметр);
		ПроверитьДатуВремя(Сырой, Сырой, Позиция, Параметр);
		Результат.Добавить(НоваяЛексема("Литерал", Сырой, УзелЛитерала(ТипЛитерала, Сырой), Позиция));
		Возврат Позиция + Длина;
	КонецЕсли;
	Длина = ДлинаВремени(Текст, Позиция);
	Если Длина > 0 Тогда
		Сырой = Сред(Текст, Позиция, Длина);
		ПроверитьКонецЛитерала(Текст, Сырой, Позиция, Параметр);
		ПроверитьВремя(Сырой, Сырой, Позиция, Параметр);
		Результат.Добавить(НоваяЛексема("Литерал", Сырой, УзелЛитерала("Edm.TimeOfDay", Сырой), Позиция));
		Возврат Позиция + Длина;
	КонецЕсли;
	Край = Позиция;
	ДлинаТекста = СтрДлина(Текст);
	Пока Край < ДлинаТекста И ЭтоЦифра(Сред(Текст, Край + 1, 1)) Цикл
		Край = Край + 1;
	КонецЦикла;
	ТипЛитерала = "Edm.Int64";
	Если Сред(Текст, Край + 1, 1) = "." И ЭтоЦифра(Сред(Текст, Край + 2, 1)) Тогда
		ТипЛитерала = "Edm.Decimal";
		Край = Край + 2;
		Пока Край < ДлинаТекста И ЭтоЦифра(Сред(Текст, Край + 1, 1)) Цикл
			Край = Край + 1;
		КонецЦикла;
	КонецЕсли;
	Сим = Сред(Текст, Край + 1, 1);
	Если (Сим = "e" Или Сим = "E") И (ЭтоЦифра(Сред(Текст, Край + 2, 1))
		Или СтрНайти("+-", Сред(Текст, Край + 2, 1)) > 0 И ЭтоЦифра(Сред(Текст, Край + 3, 1))) Тогда
		ТипЛитерала = "Edm.Double";
		Край = Край + 2;
		Пока Край < ДлинаТекста И ЭтоЦифра(Сред(Текст, Край + 1, 1)) Цикл
			Край = Край + 1;
		КонецЦикла;
	КонецЕсли;
	Значение = Сред(Текст, Позиция, Край - Позиция + 1);
	Суффикс = ВРег(Сред(Текст, Край + 1, 1));
	Если Суффикс = "M" Тогда
		ТипЛитерала = "Edm.Decimal";
	ИначеЕсли Суффикс = "L" И ТипЛитерала = "Edm.Int64" Тогда
		ТипЛитерала = "Edm.Int64";
	ИначеЕсли Суффикс = "D" Тогда
		ТипЛитерала = "Edm.Double";
	ИначеЕсли Суффикс = "F" Тогда
		ТипЛитерала = "Edm.Single";
	Иначе
		Суффикс = "";
	КонецЕсли;
	Если Суффикс <> "" Тогда
		Край = Край + 1;
	КонецЕсли;
	Сырой = Сред(Текст, Позиция, Край - Позиция + 1);
	ПроверитьКонецЛитерала(Текст, Сырой, Позиция, Параметр);
	Если ТипЛитерала = "Edm.Int64" Тогда
		ТипЛитерала = ТипЦелого(Значение, Ложь);
		Если ТипЛитерала = "" Или Суффикс = "L" И ТипЛитерала <> "Edm.Int64" Тогда
			ОшибкаРазбора(СтрШаблон("%1: неверный литерал %2 в позиции %3", Параметр, Сырой, Число0(Позиция)));
		КонецЕсли;
	КонецЕсли;
	Результат.Добавить(НоваяЛексема("Литерал", Сырой, УзелЛитерала(ТипЛитерала, НРег(Значение)), Позиция));
	Возврат Край + 1;
КонецФункции

// Литерал не может продолжаться символом имени: «12abc», «2024-01-31and» — ошибка с этим символом.
Процедура ПроверитьКонецЛитерала(Текст, Сырой, Позиция, Параметр)
	Следующий = Сред(Текст, Позиция + СтрДлина(Сырой), 1);
	Если ЭтоСимволИмени(Следующий) Тогда
		ОшибкаРазбора(СтрШаблон("%1: неверный литерал %2 в позиции %3", Параметр, Сырой + Следующий, Число0(Позиция)));
	КонецЕсли;
КонецПроцедуры

// Тип целого без знака и суффикса: Edm.Int64 в диапазоне Int64, иначе Edm.Decimal до 29 значащих цифр,
// иначе пусто. Отрицательное — диапазон для числа со знаком минус.
Функция ТипЦелого(Цифры, Отрицательное)
	Значащие = Цифры;
	Пока СтрДлина(Значащие) > 1 И Лев(Значащие, 1) = "0" Цикл
		Значащие = Сред(Значащие, 2);
	КонецЦикла;
	Если СтрДлина(Значащие) > 29 Тогда
		Возврат "";
	КонецЕсли;
	Предел = ?(Отрицательное, 9223372036854775808, 9223372036854775807);
	Возврат ?(Число(Значащие) <= Предел, "Edm.Int64", "Edm.Decimal");
КонецФункции

// Длина литерала даты (10) или даты и времени с необязательными секундами, долями и зоной; 0 — не дата.
Функция ДлинаДатыВремени(Текст, Позиция)
	Если Не СовпадаетСШаблоном(Текст, Позиция, "0000-00-00") Тогда
		Возврат 0;
	КонецЕсли;
	Если Не СовпадаетСШаблоном(Текст, Позиция + 10, "T00:00") Тогда
		Возврат 10;
	КонецЕсли;
	Длина = 16;
	Если СовпадаетСШаблоном(Текст, Позиция + Длина, ":00") Тогда
		Длина = Длина + 3;
		Длина = Длина + ДлинаДолей(Текст, Позиция + Длина);
	КонецЕсли;
	Если Сред(Текст, Позиция + Длина, 1) = "Z" Тогда
		Длина = Длина + 1;
	ИначеЕсли СовпадаетСШаблоном(Текст, Позиция + Длина, "+00:00") Или СовпадаетСШаблоном(Текст, Позиция + Длина, "-00:00") Тогда
		Длина = Длина + 6;
	КонецЕсли;
	Возврат Длина;
КонецФункции

// Длина литерала времени hh:mm[:ss[.fff]]; 0 — не время.
Функция ДлинаВремени(Текст, Позиция)
	Если Не СовпадаетСШаблоном(Текст, Позиция, "00:00") Тогда
		Возврат 0;
	КонецЕсли;
	Длина = 5;
	Если СовпадаетСШаблоном(Текст, Позиция + Длина, ":00") Тогда
		Длина = Длина + 3;
		Длина = Длина + ДлинаДолей(Текст, Позиция + Длина);
	КонецЕсли;
	Возврат Длина;
КонецФункции

// Длина долей секунды «.ddd» с позиции Позиция; 0 — долей нет.
Функция ДлинаДолей(Текст, Позиция)
	Если Сред(Текст, Позиция, 1) <> "." Тогда
		Возврат 0;
	КонецЕсли;
	Цифр = ЧислоЦифр(Текст, Позиция + 1);
	Возврат ?(Цифр > 0, Цифр + 1, 0);
КонецФункции

Функция ЕстьЗона(Текст)
	Возврат Прав(Текст, 1) = "Z" Или СтрДлина(Текст) > 16 И СтрНайти("+-", Сред(Текст, СтрДлина(Текст) - 5, 1)) > 0;
КонецФункции

// Проверка даты по календарю (год от 1, день в пределах месяца с учётом високосных лет), времени
// (часы 0–23, минуты и секунды 0–59) и смещения зоны (часы 0–14, минуты 0–59).
Процедура ПроверитьДатуВремя(Значение, Сырой, Позиция, Параметр)
	Год0 = Число(Лев(Значение, 4));
	Месяц0 = Число(Сред(Значение, 6, 2));
	День0 = Число(Сред(Значение, 9, 2));
	Если Год0 < 1 Или Месяц0 < 1 Или Месяц0 > 12 Или День0 < 1 Или День0 > ДнейВМесяце(Год0, Месяц0) Тогда
		ОшибкаРазбора(СтрШаблон("%1: неверный литерал %2 в позиции %3", Параметр, Сырой, Число0(Позиция)));
	КонецЕсли;
	Если СтрДлина(Значение) > 10 Тогда
		ПроверитьВремя(Сред(Значение, 12), Сырой, Позиция, Параметр);
	КонецЕсли;
	Если ЕстьЗона(Значение) И Прав(Значение, 1) <> "Z" Тогда
		Если Число(Сред(Значение, СтрДлина(Значение) - 4, 2)) > 14 Или Число(Прав(Значение, 2)) > 59 Тогда
			ОшибкаРазбора(СтрШаблон("%1: неверный литерал %2 в позиции %3", Параметр, Сырой, Число0(Позиция)));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Функция ДнейВМесяце(Год0, Месяц0)
	Если Месяц0 = 2 Тогда
		Високосный = Год0 % 4 = 0 И Год0 % 100 <> 0 Или Год0 % 400 = 0;
		Возврат ?(Високосный, 29, 28);
	ИначеЕсли Месяц0 = 4 Или Месяц0 = 6 Или Месяц0 = 9 Или Месяц0 = 11 Тогда
		Возврат 30;
	КонецЕсли;
	Возврат 31;
КонецФункции

Процедура ПроверитьВремя(Значение, Сырой, Позиция, Параметр)
	Часы = Число(Сред(Значение, 1, 2));
	Минуты = Число(Сред(Значение, 4, 2));
	Секунды = ?(Сред(Значение, 6, 1) = ":", Число(Сред(Значение, 7, 2)), 0);
	Если Часы > 23 Или Минуты > 59 Или Секунды > 59 Тогда
		ОшибкаРазбора(СтрШаблон("%1: неверный литерал %2 в позиции %3", Параметр, Сырой, Число0(Позиция)));
	КонецЕсли;
КонецПроцедуры

// Литерал вида префикс'содержимое': guid, datetime, datetimeoffset, time, X, binary, duration,
// перечисление Пространство.Тип'Член'.
Функция ТипизированныйЛитерал(Префикс, Содержимое, Сырой, Позиция, Параметр)
	Вид = НРег(Префикс);
	Если Вид = "guid" И СтрДлина(Содержимое) = 36 И ЭтоГУИД(Содержимое, 1) Тогда
		Возврат УзелЛитерала("Edm.Guid", НРег(Содержимое));
	ИначеЕсли Вид = "datetime" И ДлинаДатыВремени(Содержимое, 1) = СтрДлина(Содержимое)
		И СтрДлина(Содержимое) > 10 И Не ЕстьЗона(Содержимое) Тогда
		ПроверитьДатуВремя(Содержимое, Сырой, Позиция, Параметр);
		Возврат УзелЛитерала("Edm.DateTime", Содержимое);
	ИначеЕсли Вид = "datetimeoffset" И ДлинаДатыВремени(Содержимое, 1) = СтрДлина(Содержимое)
		И СтрДлина(Содержимое) > 10 И ЕстьЗона(Содержимое) Тогда
		ПроверитьДатуВремя(Содержимое, Сырой, Позиция, Параметр);
		Возврат УзелЛитерала("Edm.DateTimeOffset", Содержимое);
	ИначеЕсли Вид = "time" И ДлинаВремени(Содержимое, 1) = СтрДлина(Содержимое) И СтрДлина(Содержимое) > 0 Тогда
		ПроверитьВремя(Содержимое, Сырой, Позиция, Параметр);
		Возврат УзелЛитерала("Edm.TimeOfDay", Содержимое);
	ИначеЕсли (Вид = "x" Или Вид = "binary") И ЭтоШестнадцатеричныйТекст(Содержимое) Тогда
		Возврат УзелЛитерала("Edm.Binary", ВРег(Содержимое));
	ИначеЕсли Вид = "binary" И ЭтоBase64URL(Содержимое) Тогда
		Возврат УзелЛитерала("Edm.Binary", ВРег(ПолучитьHexСтрокуИзДвоичныхДанных(
			Base64Значение(Base64ИзBase64URL(Содержимое)))));
	ИначеЕсли Вид = "duration" И ЭтоДлительность(Содержимое) Тогда
		Возврат УзелЛитерала("Edm.Duration", Содержимое);
	ИначеЕсли СтрНайти(Префикс, ".") > 0 И ЭтоИмяЧлена(Содержимое) Тогда
		Возврат УзелЛитерала(Префикс, Содержимое);
	КонецЕсли;
	ОшибкаРазбора(СтрШаблон("%1: неверный литерал %2 в позиции %3", Параметр, Сырой, Число0(Позиция)));
КонецФункции

Функция ЭтоШестнадцатеричныйТекст(Текст)
	Если Текст = "" Или СтрДлина(Текст) % 2 <> 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Текст) Цикл
		Если Не ЭтоШестнадцатеричная(Сред(Текст, Индекс, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// base64url (RFC 4648 §5): алфавит A–Z a–z 0–9 - _, до двух '=' только в конце и только до длины, кратной 4;
// длина без '=' не даёт остаток 1 при делении на 4; неиспользуемые биты последнего символа — нули.
Функция ЭтоBase64URL(Текст)
	Данные = Текст;
	Заполнение = 0;
	Пока Прав(Данные, 1) = "=" Цикл
		Данные = Лев(Данные, СтрДлина(Данные) - 1);
		Заполнение = Заполнение + 1;
	КонецЦикла;
	Длина = СтрДлина(Данные);
	Если Длина = 0 Или Длина % 4 = 1 Или Заполнение > 2 Или Заполнение > 0 И (Длина + Заполнение) % 4 <> 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";
	Для Индекс = 1 По Длина Цикл
		Если СтрНайти(Алфавит, Сред(Данные, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Последний = СтрНайти(Алфавит, Прав(Данные, 1)) - 1;
	Если Длина % 4 = 2 И Последний % 16 <> 0 Или Длина % 4 = 3 И Последний % 4 <> 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Длительность OData: [+|-]P[nD][T[nH][nM][n[.n]S]], хотя бы одна часть; после T — хотя бы одна часть времени.
Функция ЭтоДлительность(Текст)
	Позиция = ?(Лев(Текст, 1) = "-" Или Лев(Текст, 1) = "+", 2, 1);
	Если Сред(Текст, Позиция, 1) <> "P" Тогда
		Возврат Ложь;
	КонецЕсли;
	Позиция = Позиция + 1;
	Частей = 0;
	Цифр = ЧислоЦифр(Текст, Позиция);
	Если Цифр > 0 И Сред(Текст, Позиция + Цифр, 1) = "D" Тогда
		Позиция = Позиция + Цифр + 1;
		Частей = Частей + 1;
	КонецЕсли;
	Если Сред(Текст, Позиция, 1) = "T" Тогда
		Позиция = Позиция + 1;
		ЧастейВремени = 0;
		Для Каждого Единица Из СтрРазделить("H,M", ",") Цикл
			Цифр = ЧислоЦифр(Текст, Позиция);
			Если Цифр > 0 И Сред(Текст, Позиция + Цифр, 1) = Единица Тогда
				Позиция = Позиция + Цифр + 1;
				ЧастейВремени = ЧастейВремени + 1;
			КонецЕсли;
		КонецЦикла;
		Цифр = ЧислоЦифр(Текст, Позиция);
		Если Цифр > 0 Тогда
			Цифр = Цифр + ДлинаДолей(Текст, Позиция + Цифр);
		КонецЕсли;
		Если Цифр > 0 И Сред(Текст, Позиция + Цифр, 1) = "S" Тогда
			Позиция = Позиция + Цифр + 1;
			ЧастейВремени = ЧастейВремени + 1;
		КонецЕсли;
		Если ЧастейВремени = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Частей = Частей + ЧастейВремени;
	КонецЕсли;
	Возврат Частей > 0 И Позиция = СтрДлина(Текст) + 1;
КонецФункции

Функция ЧислоЦифр(Текст, Позиция)
	Цифр = 0;
	Пока ЭтоЦифра(Сред(Текст, Позиция + Цифр, 1)) Цикл
		Цифр = Цифр + 1;
	КонецЦикла;
	Возврат Цифр;
КонецФункции

Функция Base64ИзBase64URL(Текст)
	Результат = СтрЗаменить(СтрЗаменить(СтрЗаменить(Текст, "=", ""), "-", "+"), "_", "/");
	Пока СтрДлина(Результат) % 4 <> 0 Цикл
		Результат = Результат + "=";
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЭтоИмяЧлена(Текст)
	Если Не ЭтоНачалоИмени(Лев(Текст, 1)) Или Лев(Текст, 1) = "$" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 2 По СтрДлина(Текст) Цикл
		Сим = Сред(Текст, Индекс, 1);
		Если Не (ЭтоБуква(Сим) Или ЭтоЦифра(Сим) Или Сим = "_") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

#КонецОбласти

#Область Разбор

// Пределы разбора: длина текста параметра — 8000 символов; вложенность (скобки, not, унарный минус, вызовы,
// лямбды, списки in) — 32; членов в одной цепочке бинарных операторов — 100; высота дерева — 150.
// Сверх предела — 400: глубже рекурсия 1С роняет процесс. Ошибки разбора — через ОшибкаВРазборе.
Функция НовыйРазбор(Текст, Параметр)
	Если СтрДлина(Текст) > 8000 Тогда
		ОшибкаРазбора(СтрШаблон("%1: слишком длинное выражение", Параметр));
	КонецЕсли;
	Разбор = Новый Структура;
	Разбор.Вставить("Параметр", Параметр);
	Разбор.Вставить("Лексемы", Лексемы(Текст, Параметр));
	Разбор.Вставить("Номер", 0);
	Разбор.Вставить("Переменные", Новый Массив);
	Разбор.Вставить("Глубина", 0);
	Разбор.Вставить("Высота", 0);
	Разбор.Вставить("Ошибка", "");
	Разбор.Вставить("СтатусОшибки", 400);
	Возврат Разбор;
КонецФункции

Функция Текущая(Разбор)
	Возврат Разбор.Лексемы[Разбор.Номер];
КонецФункции

Функция Следующая(Разбор)
	Лексема = Разбор.Лексемы[Разбор.Номер];
	Если Лексема.Вид <> "Конец" Тогда
		Разбор.Номер = Разбор.Номер + 1;
	КонецЕсли;
	Возврат Лексема;
КонецФункции

Функция ЭтоИмя(Лексема, Имя)
	Возврат Лексема.Вид = "Имя" И Лексема.Текст = Имя;
КонецФункции

Функция ЭтоЗнак(Лексема, Знак)
	Возврат Лексема.Вид = "Знак" И Лексема.Текст = Знак;
КонецФункции

Процедура ОжидатьЗнак(Разбор, Знак)
	Если Не ЭтоЗнак(Текущая(Разбор), Знак) Тогда
		Ожидалось(Разбор, "«" + Знак + "»");
	КонецЕсли;
	Следующая(Разбор);
КонецПроцедуры

Процедура Ожидалось(Разбор, Что)
	ОшибкаВРазборе(Разбор, СтрШаблон("%1: ожидалось %2 в позиции %3", Разбор.Параметр, Что,
		Число0(Текущая(Разбор).Позиция)));
КонецПроцедуры

// Конец разбора: запомненная ошибка разбора (400 или 501) или лишний текст (400) — исключение OData.
Процедура ПроверитьКонец(Разбор)
	Если Разбор.Ошибка <> "" И Разбор.СтатусОшибки = 501 Тогда
		OData4_Сервис.ОшибкаOData(501, "NotImplemented", Разбор.Ошибка);
	ИначеЕсли Разбор.Ошибка <> "" Тогда
		ОшибкаРазбора(Разбор.Ошибка);
	КонецЕсли;
	Лексема = Текущая(Разбор);
	Если Лексема.Вид <> "Конец" Тогда
		ОшибкаРазбора(СтрШаблон("%1: лишний текст в позиции %2", Разбор.Параметр, Число0(Лексема.Позиция)));
	КонецЕсли;
КонецПроцедуры

// Приоритеты (OData ABNF, от слабых к сильным): or; and; eq ne; gt ge lt le; add sub; mul div divby mod;
// унарные - и not; постфиксные has и in первичного выражения; первичное — скобки, литерал, вызов, путь.
// Бинарные операторы левоассоциативны. Разбор.Высота — высота дерева последнего разобранного узла.
Функция Выражение(Разбор)
	Возврат Цепочка(Разбор, 1);
КонецФункции

Функция ОператорыУровня(Уровень)
	Если Уровень = 1 Тогда
		Возврат "or";
	ИначеЕсли Уровень = 2 Тогда
		Возврат "and";
	ИначеЕсли Уровень = 3 Тогда
		Возврат "eq,ne";
	ИначеЕсли Уровень = 4 Тогда
		Возврат "gt,ge,lt,le";
	ИначеЕсли Уровень = 5 Тогда
		Возврат "add,sub";
	КонецЕсли;
	Возврат "mul,div,divby,mod";
КонецФункции

// Цепочка бинарных операторов уровня 1–6; операнды — следующий уровень, за шестым — унарное выражение.
Функция Цепочка(Разбор, Уровень)
	Операторы = ОператорыУровня(Уровень);
	Если Уровень = 6 Тогда
		Левое = Унарное(Разбор);
	Иначе
		Левое = Цепочка(Разбор, Уровень + 1);
	КонецЕсли;
	ВысотаЛевого = Разбор.Высота;
	Членов = 1;
	Пока ОператорИз(Текущая(Разбор), Операторы) Цикл
		Оператор = Следующая(Разбор);
		Членов = ПроверитьЧленов(Разбор, Членов);
		Если Уровень = 6 Тогда
			Правое = Унарное(Разбор);
		Иначе
			Правое = Цепочка(Разбор, Уровень + 1);
		КонецЕсли;
		Левое = Составной(Разбор, УзелБинарный(Оператор.Текст, Левое, Правое), Макс(ВысотаЛевого, Разбор.Высота),
			Оператор.Позиция);
		ВысотаЛевого = Разбор.Высота;
	КонецЦикла;
	Возврат Левое;
КонецФункции

Функция Унарное(Разбор)
	Лексема = Текущая(Разбор);
	Если ЭтоЗнак(Лексема, "-") Тогда
		Следующая(Разбор);
		Операнд = Текущая(Разбор);
		Если Операнд.Вид = "Литерал" И Операнд.Позиция = Лексема.Позиция + 1 И ЭтоЧисловойТип(Операнд.Значение.type) Тогда
			// «-5» без пробела — отрицательный литерал; «- 5» и «-(5)» — унарный минус.
			Следующая(Разбор);
			Возврат Постфикс(Разбор, Лист(Разбор, ОтрицательныйЛитерал(Операнд)));
		КонецЕсли;
		Оператор = "neg";
	ИначеЕсли ЭтоИмя(Лексема, "not") Тогда
		Следующая(Разбор);
		Оператор = "not";
	Иначе
		Возврат Постфикс(Разбор, Первичное(Разбор));
	КонецЕсли;
	Войти(Разбор, Лексема);
	Операнд = Унарное(Разбор);
	Выйти(Разбор);
	Возврат Составной(Разбор, Новый Структура("kind, op, operand", "unary", Оператор, Операнд), Разбор.Высота,
		Лексема.Позиция);
КонецФункции

// Литерал со знаком минус; целое без суффикса заново проверяется по диапазону Int64 со знаком.
Функция ОтрицательныйЛитерал(Лексема)
	ТипЛитерала = Лексема.Значение.type;
	Если ЧислоЦифр(Лексема.Текст, 1) = СтрДлина(Лексема.Текст) Тогда
		ТипЛитерала = ТипЦелого(Лексема.Текст, Истина);
	КонецЕсли;
	Возврат УзелЛитерала(ТипЛитерала, "-" + Лексема.Значение.value);
КонецФункции

// Постфиксные has и in после первичного выражения (левоассоциативны).
Функция Постфикс(Разбор, Первое)
	Левое = Первое;
	ВысотаЛевого = Разбор.Высота;
	Членов = 1;
	Пока ОператорИз(Текущая(Разбор), "has,in") Цикл
		Оператор = Следующая(Разбор);
		Членов = ПроверитьЧленов(Разбор, Членов);
		Если Оператор.Текст = "in" Тогда
			Узел = Новый Структура("kind, operand, items", "in", Левое, СписокВыражений(Разбор));
		Иначе
			Узел = УзелБинарный("has", Левое, Первичное(Разбор));
		КонецЕсли;
		Левое = Составной(Разбор, Узел, Макс(ВысотаЛевого, Разбор.Высота), Оператор.Позиция);
		ВысотаЛевого = Разбор.Высота;
	КонецЦикла;
	Возврат Левое;
КонецФункции

Функция Первичное(Разбор)
	Лексема = Текущая(Разбор);
	Если ЭтоЗнак(Лексема, "(") Тогда
		Следующая(Разбор);
		Войти(Разбор, Лексема);
		Узел = Выражение(Разбор);
		ОжидатьЗнак(Разбор, ")");
		Выйти(Разбор);
		Возврат Узел;
	ИначеЕсли Лексема.Вид = "Литерал" Тогда
		Следующая(Разбор);
		Возврат Лист(Разбор, Лексема.Значение);
	ИначеЕсли Лексема.Вид = "Строка" Тогда
		Следующая(Разбор);
		Возврат Лист(Разбор, УзелЛитерала("Edm.String", Лексема.Значение));
	ИначеЕсли Лексема.Вид <> "Имя" Тогда
		Ожидалось(Разбор, "выражение");
	ИначеЕсли Лексема.Текст = "true" Или Лексема.Текст = "false" Тогда
		Следующая(Разбор);
		Возврат Лист(Разбор, УзелЛитерала("Edm.Boolean", Лексема.Текст));
	ИначеЕсли Лексема.Текст = "null" Тогда
		Следующая(Разбор);
		Возврат Лист(Разбор, УзелЛитерала("null", Неопределено));
	ИначеЕсли Лексема.Текст = "INF" Или Лексема.Текст = "NaN" Тогда
		НеПоддерживается(Разбор, Лексема);
	ИначеЕсли ЭтоЗнак(Разбор.Лексемы[Разбор.Номер + 1], "(") Тогда
		Возврат ВызовФункции(Разбор);
	КонецЕсли;
	Возврат Путь(Разбор);
КонецФункции

// Путь: Имя {/ Имя}, первое имя может быть переменной лямбды; /any(…) и /all(…) завершают путь.
// Сегменты, начинающиеся с «$» ($it, $root, $this, $count), не поддерживаются.
Функция Путь(Разбор)
	Первая = Следующая(Разбор);
	Если Лев(Первая.Текст, 1) = "$" Тогда
		НеПоддерживается(Разбор, Первая);
	КонецЕсли;
	Узел = Новый Структура("kind, variable, segments", "path", "", Новый Массив);
	Если Разбор.Переменные.Найти(Первая.Текст) <> Неопределено Тогда
		Узел.variable = Первая.Текст;
	Иначе
		Узел.segments.Добавить(Первая.Текст);
	КонецЕсли;
	Пока ЭтоЗнак(Текущая(Разбор), "/") Цикл
		Следующая(Разбор);
		Лексема = Текущая(Разбор);
		Если Лексема.Вид <> "Имя" Тогда
			Ожидалось(Разбор, "имя");
		КонецЕсли;
		Если Лев(Лексема.Текст, 1) = "$" Тогда
			НеПоддерживается(Разбор, Лексема);
		КонецЕсли;
		Следующая(Разбор);
		Если (Лексема.Текст = "any" Или Лексема.Текст = "all") И ЭтоЗнак(Текущая(Разбор), "(") Тогда
			Возврат Лямбда(Разбор, Лексема, Узел);
		КонецЕсли;
		Узел.segments.Добавить(Лексема.Текст);
	КонецЦикла;
	Возврат Лист(Разбор, Узел);
КонецФункции

Функция Лямбда(Разбор, Лексема, Коллекция)
	ОжидатьЗнак(Разбор, "(");
	Войти(Разбор, Лексема);
	Узел = Новый Структура("kind, op, collection, variable, predicate", "lambda", Лексема.Текст, Коллекция, "",
		Неопределено);
	Разбор.Высота = 1;
	Если Лексема.Текст = "any" И ЭтоЗнак(Текущая(Разбор), ")") Тогда
		Следующая(Разбор);
	Иначе
		Переменная = Текущая(Разбор);
		Если Переменная.Вид <> "Имя" Тогда
			Ожидалось(Разбор, "имя переменной");
		КонецЕсли;
		Следующая(Разбор);
		ОжидатьЗнак(Разбор, ":");
		Узел.variable = Переменная.Текст;
		Разбор.Переменные.Добавить(Переменная.Текст);
		Узел.predicate = Выражение(Разбор);
		Разбор.Переменные.Удалить(Разбор.Переменные.ВГраница());
		ОжидатьЗнак(Разбор, ")");
	КонецЕсли;
	Выйти(Разбор);
	Возврат Составной(Разбор, Узел, Разбор.Высота, Лексема.Позиция);
КонецФункции

Функция ВызовФункции(Разбор)
	Лексема = Следующая(Разбор);
	Имя = Лексема.Текст;
	Если Имя = "isof" Тогда
		НеПоддерживается(Разбор, Лексема);
	ИначеЕсли Имя = "cast" Тогда
		Возврат Приведение(Разбор, Лексема);
	КонецЕсли;
	Арность = АрностьФункции(Имя);
	Если Арность = "" Тогда
		ОшибкаВРазборе(Разбор, СтрШаблон("%1: неизвестная функция %2 в позиции %3", Разбор.Параметр, Имя, Число0(Лексема.Позиция)));
	КонецЕсли;
	ОжидатьЗнак(Разбор, "(");
	Войти(Разбор, Лексема);
	Аргументы = Новый Массив;
	ВысотаАргументов = 0;
	Если Не ЭтоЗнак(Текущая(Разбор), ")") Тогда
		Аргументы.Добавить(Выражение(Разбор));
		ВысотаАргументов = Разбор.Высота;
		Пока ЭтоЗнак(Текущая(Разбор), ",") Цикл
			Следующая(Разбор);
			Аргументы.Добавить(Выражение(Разбор));
			ВысотаАргументов = Макс(ВысотаАргументов, Разбор.Высота);
		КонецЦикла;
	КонецЕсли;
	ОжидатьЗнак(Разбор, ")");
	Выйти(Разбор);
	Если СтрРазделить(Арность, ",").Найти(Формат(Аргументы.Количество(), "ЧН=0; ЧГ=0")) = Неопределено Тогда
		ОшибкаВРазборе(Разбор, СтрШаблон("%1: неверное число аргументов функции %2 в позиции %3", Разбор.Параметр, Имя,
			Число0(Лексема.Позиция)));
	КонецЕсли;
	Если Имя = "substringof" И Аргументы.Количество() = 2 Тогда
		// v3: substringof(подстрока, строка) — то же, что contains(строка, подстрока).
		Переставленные = Новый Массив;
		Переставленные.Добавить(Аргументы[1]);
		Переставленные.Добавить(Аргументы[0]);
		Аргументы = Переставленные;
		Имя = "contains";
	КонецЕсли;
	Возврат Составной(Разбор, Новый Структура("kind, name, args", "call", Имя, Аргументы), ВысотаАргументов,
		Лексема.Позиция);
КонецФункции

// Приведение: cast(Выражение, Тип) или cast(Тип); тип — строка ('Catalog_X', как у standard.odata) или имя
// (StandardODATA.Catalog_X, OData v4). Поддерживается ли приведение, решает генератор.
Функция Приведение(Разбор, Лексема)
	ОжидатьЗнак(Разбор, "(");
	Войти(Разбор, Лексема);
	Узел = Новый Структура("kind, operand, type", "cast", Неопределено, "");
	ВысотаОперанда = 0;
	Первая = Текущая(Разбор);
	Если Не ((Первая.Вид = "Строка" Или Первая.Вид = "Имя") И ЭтоЗнак(Разбор.Лексемы[Разбор.Номер + 1], ")")) Тогда
		Узел.operand = Выражение(Разбор);
		ВысотаОперанда = Разбор.Высота;
		ОжидатьЗнак(Разбор, ",");
	КонецЕсли;
	ЛексемаТипа = Текущая(Разбор);
	Если ЛексемаТипа.Вид = "Строка" Тогда
		Узел.type = ЛексемаТипа.Значение;
	ИначеЕсли ЛексемаТипа.Вид = "Имя" Тогда
		Узел.type = ЛексемаТипа.Текст;
	Иначе
		Ожидалось(Разбор, "имя типа");
	КонецЕсли;
	Следующая(Разбор);
	ОжидатьЗнак(Разбор, ")");
	Выйти(Разбор);
	Возврат Составной(Разбор, Узел, ВысотаОперанда, Лексема.Позиция);
КонецФункции

// Допустимое число аргументов функции через запятую; пусто — функция неизвестна.
Функция АрностьФункции(Имя)
	Таблица = Новый Соответствие;
	Для Каждого Имя2 Из СтрРазделить("contains,startswith,endswith,indexof,concat,substringof,hassubset,hassubsequence,"
		+ "matchesPattern,geo.distance,geo.intersects", ",") Цикл
		Таблица.Вставить(Имя2, "2");
	КонецЦикла;
	Для Каждого Имя2 Из СтрРазделить("length,tolower,toupper,trim,year,month,day,hour,minute,second,fractionalseconds,"
		+ "totalseconds,date,time,totaloffsetminutes,round,floor,ceiling,geo.length", ",") Цикл
		Таблица.Вставить(Имя2, "1");
	КонецЦикла;
	Для Каждого Имя2 Из СтрРазделить("now,mindatetime,maxdatetime", ",") Цикл
		Таблица.Вставить(Имя2, "0");
	КонецЦикла;
	Таблица.Вставить("substring", "2,3");
	Арность = Таблица.Получить(Имя);
	Возврат ?(Арность = Неопределено, "", Арность);
КонецФункции

// Список «(Выражение {, Выражение})»; Разбор.Высота — наибольшая высота элементов.
Функция СписокВыражений(Разбор)
	Скобка = Текущая(Разбор);
	ОжидатьЗнак(Разбор, "(");
	Войти(Разбор, Скобка);
	Элементы = Новый Массив;
	Элементы.Добавить(Выражение(Разбор));
	Высота = Разбор.Высота;
	Пока ЭтоЗнак(Текущая(Разбор), ",") Цикл
		Следующая(Разбор);
		Элементы.Добавить(Выражение(Разбор));
		Высота = Макс(Высота, Разбор.Высота);
	КонецЦикла;
	ОжидатьЗнак(Разбор, ")");
	Выйти(Разбор);
	Разбор.Высота = Высота;
	Возврат Элементы;
КонецФункции

Функция ОператорИз(Лексема, Список)
	Возврат Лексема.Вид = "Имя" И СтрРазделить(Список, ",").Найти(Лексема.Текст) <> Неопределено;
КонецФункции

// Вход во вложенную конструкцию, открытую лексемой; глубже 32 — ошибка в позиции этой лексемы.
Процедура Войти(Разбор, Лексема)
	Разбор.Глубина = Разбор.Глубина + 1;
	Если Разбор.Глубина > 32 Тогда
		ОшибкаГлубины(Разбор, Лексема.Позиция);
	КонецЕсли;
КонецПроцедуры

Процедура Выйти(Разбор)
	Разбор.Глубина = Разбор.Глубина - 1;
КонецПроцедуры

// Число членов цепочки операторов после ещё одного оператора; больше 100 — ошибка.
Функция ПроверитьЧленов(Разбор, Членов)
	Если Членов >= 100 Тогда
		ОшибкаВРазборе(Разбор, СтрШаблон("%1: слишком длинное выражение", Разбор.Параметр));
	КонецЕсли;
	Возврат Членов + 1;
КонецФункции

// Лист дерева: высота 1.
Функция Лист(Разбор, Узел)
	Разбор.Высота = 1;
	Возврат Узел;
КонецФункции

// Составной узел над поддеревьями высотой ВысотаПоддеревьев; дерево выше 150 — ошибка в позиции лексемы узла.
Функция Составной(Разбор, Узел, ВысотаПоддеревьев, Позиция)
	Разбор.Высота = ВысотаПоддеревьев + 1;
	Если Разбор.Высота > 150 Тогда
		ОшибкаГлубины(Разбор, Позиция);
	КонецЕсли;
	Возврат Узел;
КонецФункции

// Ошибка разбора без исключения: исключение, прошедшее через десятки вложенных вызовов, роняет процесс 1С.
// Запоминается первая ошибка, разбор переходит к лексеме «Конец» и сворачивается обычными возвратами;
// исключение вызывает ПроверитьКонец. Статус — 400 (ошибка синтаксиса) или 501 (не поддерживается).
Процедура ОшибкаВРазборе(Разбор, Сообщение, Статус = 400)
	Если Разбор.Ошибка = "" Тогда
		Разбор.Ошибка = Сообщение;
		Разбор.СтатусОшибки = Статус;
	КонецЕсли;
	Разбор.Номер = Разбор.Лексемы.ВГраница();
КонецПроцедуры

Процедура ОшибкаГлубины(Разбор, Позиция)
	ОшибкаВРазборе(Разбор, СтрШаблон("%1: слишком глубокая вложенность в позиции %2", Разбор.Параметр, Число0(Позиция)));
КонецПроцедуры

Процедура НеПоддерживается(Разбор, Лексема)
	ОшибкаВРазборе(Разбор, СтрШаблон("%1: не поддерживается %2 в позиции %3", Разбор.Параметр, Лексема.Текст,
		Число0(Лексема.Позиция)));
КонецПроцедуры

Функция ЭтоЧисловойТип(ТипЛитерала)
	Возврат ТипЛитерала = "Edm.Int64" Или ТипЛитерала = "Edm.Decimal" Или ТипЛитерала = "Edm.Double"
		Или ТипЛитерала = "Edm.Single";
КонецФункции

Функция УзелЛитерала(ТипЛитерала, Значение)
	Возврат Новый Структура("kind, type, value", "literal", ТипЛитерала, Значение);
КонецФункции

Функция УзелБинарный(Оператор, Левое, Правое)
	Возврат Новый Структура("kind, op, left, right", "binary", Оператор, Левое, Правое);
КонецФункции

Процедура ОшибкаРазбора(Сообщение)
	OData4_Сервис.ОшибкаOData(400, "BadRequest", Сообщение);
КонецПроцедуры

Функция Число0(Значение)
	Возврат Формат(Значение, "ЧН=0; ЧГ=0");
КонецФункции

// Неотрицательное целое $top/$skip: от 1 до 9 цифр без знака и суффикса.
Функция ЭтоЦелоеБезЗнака(Текст)
	Возврат Текст <> "" И СтрДлина(Текст) <= 9 И ЧислоЦифр(Текст, 1) = СтрДлина(Текст);
КонецФункции

// $search и $compute — 501 везде; $levels — 501 только внутри $expand (вне — неизвестный параметр).
// $apply на верхнем уровне разбирает РазобратьПреобразование (ветка раньше этой проверки); внутри $expand
// он не поддерживается — вложенная агрегация в этап 4 не входит.
Функция ЭтоНеподдерживаемыйПараметр(Имя)
	Возврат Имя = "$search" Или Имя = "$apply" Или Имя = "$compute";
КонецФункции

// Элементы $orderby до «;», «)» или конца.
Функция СписокПорядка(Разбор)
	Результат = Новый Массив;
	Пока Истина Цикл
		Элемент = Новый Структура("expression, direction", Выражение(Разбор), "asc");
		Лексема = Текущая(Разбор);
		Если ЭтоИмя(Лексема, "asc") Или ЭтоИмя(Лексема, "desc") Тогда
			Элемент.direction = Лексема.Текст;
			Следующая(Разбор);
		КонецЕсли;
		Результат.Добавить(Элемент);
		Если Не ЭтоЗнак(Текущая(Разбор), ",") Тогда
			Прервать;
		КонецЕсли;
		Следующая(Разбор);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СписокВыбора(Разбор)
	Результат = Новый Массив;
	Пока Истина Цикл
		Результат.Добавить(ПутьВыбора(Разбор));
		Если Не ЭтоЗнак(Текущая(Разбор), ",") Тогда
			Прервать;
		КонецЕсли;
		Следующая(Разбор);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Путь в $select и $expand: «*» или Имя {/ Имя} с «*» только последним.
Функция ПутьВыбора(Разбор)
	Сегменты = Новый Массив;
	Пока Истина Цикл
		Лексема = Текущая(Разбор);
		Если ЭтоЗнак(Лексема, "*") Тогда
			Следующая(Разбор);
			Сегменты.Добавить("*");
			Возврат Сегменты;
		ИначеЕсли Лексема.Вид <> "Имя" Или СтрНачинаетсяС(Лексема.Текст, "$") Тогда
			Ожидалось(Разбор, "имя");
			Возврат Сегменты;
		КонецЕсли;
		Следующая(Разбор);
		Сегменты.Добавить(Лексема.Текст);
		Если Не ЭтоЗнак(Текущая(Разбор), "/") Тогда
			Возврат Сегменты;
		КонецЕсли;
		Следующая(Разбор);
	КонецЦикла;
КонецФункции

// Элементы $expand; скобки параметров раскрытия учитываются в общей глубине вложенности (Войти/Выйти).
Функция СписокРаскрытия(Разбор)
	Результат = Новый Массив;
	Пока Истина Цикл
		Элемент = Новый Структура("path, options", ПутьВыбора(Разбор), НовыеОпции());
		Скобка = Текущая(Разбор);
		Если ЭтоЗнак(Скобка, "(") Тогда
			Следующая(Разбор);
			Войти(Разбор, Скобка);
			ОпцииРаскрытия(Разбор, Элемент.options);
			ОжидатьЗнак(Разбор, ")");
			Выйти(Разбор);
		КонецЕсли;
		Результат.Добавить(Элемент);
		Если Не ЭтоЗнак(Текущая(Разбор), ",") Тогда
			Прервать;
		КонецЕсли;
		Следующая(Разбор);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Вложенные параметры раскрытия: $имя=значение через «;». Повторный параметр заменяет прежний.
// Ошибки — через ОшибкаВРазборе (без исключения из глубины).
Процедура ОпцииРаскрытия(Разбор, Опции)
	Пока Истина Цикл
		Лексема = Текущая(Разбор);
		Если Лексема.Вид <> "Имя" Или Не СтрНачинаетсяС(Лексема.Текст, "$") Тогда
			Ожидалось(Разбор, "параметр раскрытия");
			Возврат;
		КонецЕсли;
		Следующая(Разбор);
		ОжидатьЗнак(Разбор, "=");
		Имя = Лексема.Текст;
		Если Имя = "$filter" Тогда
			Опции.filter = Выражение(Разбор);
		ИначеЕсли Имя = "$orderby" Тогда
			Опции.orderby = СписокПорядка(Разбор);
		ИначеЕсли Имя = "$select" Тогда
			Опции.select = СписокВыбора(Разбор);
		ИначеЕсли Имя = "$expand" Тогда
			Опции.expand = СписокРаскрытия(Разбор);
		ИначеЕсли Имя = "$top" Или Имя = "$skip" Тогда
			Значение = Текущая(Разбор);
			Если Значение.Вид = "Литерал" И ЭтоЦелоеБезЗнака(Значение.Текст) Тогда
				Следующая(Разбор);
				Опции[Сред(Имя, 2)] = Число(Значение.Текст);
			Иначе
				Ожидалось(Разбор, "неотрицательное целое число");
			КонецЕсли;
		ИначеЕсли Имя = "$count" Тогда
			Значение = Текущая(Разбор);
			Если ЭтоИмя(Значение, "true") Или ЭтоИмя(Значение, "false") Тогда
				Следующая(Разбор);
				Опции.count = Значение.Текст = "true";
			Иначе
				Ожидалось(Разбор, "true или false");
			КонецЕсли;
		ИначеЕсли Имя = "$levels" Или ЭтоНеподдерживаемыйПараметр(Имя) Тогда
			ОшибкаВРазборе(Разбор, "Параметр запроса не поддерживается: " + Имя, 501);
		Иначе
			ОшибкаВРазборе(Разбор, СтрШаблон("%1: неизвестный параметр %2 в позиции %3", Разбор.Параметр, Имя,
				Число0(Лексема.Позиция)));
		КонецЕсли;
		Если Не ЭтоЗнак(Текущая(Разбор), ";") Тогда
			Прервать;
		КонецЕсли;
		Следующая(Разбор);
	КонецЦикла;
КонецПроцедуры

// Цепочка шагов $apply «шаг / шаг / …». Разбор.Шагов — число шагов во всём тексте, вместе с вложенными
// в groupby: больше 10 — ошибка. Ошибки — через ОшибкаВРазборе, без исключения из глубины.
Функция ЦепочкаШагов(Разбор)
	Шаги = Новый Массив;
	Пока Истина Цикл
		Разбор.Шагов = Разбор.Шагов + 1;
		Если Разбор.Шагов > 10 Тогда
			ОшибкаВРазборе(Разбор, СтрШаблон("%1: слишком много шагов преобразования", Разбор.Параметр));
			Прервать;
		КонецЕсли;
		Шаг = ШагПреобразования(Разбор);
		Если Шаг = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Шаги.Добавить(Шаг);
		Если Не ЭтоЗнак(Текущая(Разбор), "/") Тогда
			Прервать;
		КонецЕсли;
		Следующая(Разбор);
	КонецЦикла;
	Возврат Шаги;
КонецФункции

// Один шаг $apply; Неопределено — после запомненной ошибки. Преобразования, которых нет в этапе 4
// (concat, expand, search, nest, join, toppercent, topsum, bottompercent, bottomsum, rollup и любые
// неизвестные) — 501.
Функция ШагПреобразования(Разбор)
	Лексема = Текущая(Разбор);
	Если Лексема.Вид <> "Имя" Тогда
		Ожидалось(Разбор, "преобразование");
		Возврат Неопределено;
	КонецЕсли;
	Имя = Лексема.Текст;
	Если Имя = "identity" Тогда
		Следующая(Разбор);
		Возврат Новый Структура("kind", "identity");
	ИначеЕсли Имя = "filter" Тогда
		Следующая(Разбор);
		ОжидатьЗнак(Разбор, "(");
		Войти(Разбор, Лексема);
		Узел = Выражение(Разбор);
		ОжидатьЗнак(Разбор, ")");
		Выйти(Разбор);
		Возврат Новый Структура("kind, filter", "filter", Узел);
	ИначеЕсли Имя = "aggregate" Тогда
		Следующая(Разбор);
		Возврат Новый Структура("kind, items", "aggregate", СписокАгрегатов(Разбор, Лексема));
	ИначеЕсли Имя = "compute" Тогда
		Следующая(Разбор);
		Возврат Новый Структура("kind, items", "compute", СписокВычислений(Разбор, Лексема));
	ИначеЕсли Имя = "groupby" Тогда
		Следующая(Разбор);
		Возврат ШагГруппировки(Разбор, Лексема);
	ИначеЕсли Имя = "topcount" Или Имя = "bottomcount" Тогда
		Следующая(Разбор);
		ОжидатьЗнак(Разбор, "(");
		Войти(Разбор, Лексема);
		УзелКоличества = Выражение(Разбор);
		ОжидатьЗнак(Разбор, ",");
		Выражение0 = Выражение(Разбор);
		ОжидатьЗнак(Разбор, ")");
		Выйти(Разбор);
		Возврат Новый Структура("kind, count, expression", Имя, УзелКоличества, Выражение0);
	КонецЕсли;
	ОшибкаВРазборе(Разбор, "Преобразование не поддерживается: " + Имя, 501);
	Возврат Неопределено;
КонецФункции

// groupby((путь, …)[, цепочка шагов])
Функция ШагГруппировки(Разбор, Лексема)
	ОжидатьЗнак(Разбор, "(");
	Войти(Разбор, Лексема);
	Скобка = Текущая(Разбор);
	ОжидатьЗнак(Разбор, "(");
	Войти(Разбор, Скобка);
	Пути = Новый Массив;
	Пока Истина Цикл
		Пути.Добавить(СвойствоГруппировки(Разбор));
		Если Пути.Количество() > 64 Тогда
			ОшибкаВРазборе(Разбор, СтрШаблон("%1: слишком много свойств группировки", Разбор.Параметр));
			Прервать;
		КонецЕсли;
		Если Не ЭтоЗнак(Текущая(Разбор), ",") Тогда
			Прервать;
		КонецЕсли;
		Следующая(Разбор);
	КонецЦикла;
	ОжидатьЗнак(Разбор, ")");
	Выйти(Разбор);
	Вложенные = Неопределено;
	Если ЭтоЗнак(Текущая(Разбор), ",") Тогда
		Следующая(Разбор);
		Вложенные = ЦепочкаШагов(Разбор);
	КонецЕсли;
	ОжидатьЗнак(Разбор, ")");
	Выйти(Разбор);
	Возврат Новый Структура("kind, properties, steps", "groupby", Пути, Вложенные);
КонецФункции

// Свойство группировки: Имя {/ Имя}; «*» и имена с «$» не допускаются.
Функция СвойствоГруппировки(Разбор)
	Сегменты = Новый Массив;
	Пока Истина Цикл
		Лексема = Текущая(Разбор);
		Если Лексема.Вид <> "Имя" Или СтрНачинаетсяС(Лексема.Текст, "$") Тогда
			Ожидалось(Разбор, "имя");
			Возврат Сегменты;
		КонецЕсли;
		Следующая(Разбор);
		Сегменты.Добавить(Лексема.Текст);
		Если Сегменты.Количество() = 1 И Лексема.Текст = "rollup" И ЭтоЗнак(Текущая(Разбор), "(") Тогда
			// groupby((rollup($all,…))) — форма расширения агрегации, в этапе 4 её нет (как и шага rollup).
			ОшибкаВРазборе(Разбор, "Преобразование не поддерживается: rollup", 501);
			Возврат Сегменты;
		КонецЕсли;
		Если Не ЭтоЗнак(Текущая(Разбор), "/") Тогда
			Возврат Сегменты;
		КонецЕсли;
		Следующая(Разбор);
	КонецЦикла;
КонецФункции

// aggregate(выражение with метод as имя, … | $count as имя, …)
Функция СписокАгрегатов(Разбор, Лексема)
	ОжидатьЗнак(Разбор, "(");
	Войти(Разбор, Лексема);
	Элементы = Новый Массив;
	Пока Истина Цикл
		Элементы.Добавить(Агрегат(Разбор));
		Если Элементы.Количество() > 64 Тогда
			ОшибкаВРазборе(Разбор, СтрШаблон("%1: слишком много агрегатов", Разбор.Параметр));
			Прервать;
		КонецЕсли;
		Если Не ЭтоЗнак(Текущая(Разбор), ",") Тогда
			Прервать;
		КонецЕсли;
		Следующая(Разбор);
	КонецЦикла;
	ОжидатьЗнак(Разбор, ")");
	Выйти(Разбор);
	Возврат Элементы;
КонецФункции

// Элемент aggregate: Структура «expression, method, alias»; у $count выражения нет (Неопределено).
Функция Агрегат(Разбор)
	Элемент = Новый Структура("expression, method, alias", Неопределено, "$count", "");
	Если ЭтоИмя(Текущая(Разбор), "$count") Тогда
		Следующая(Разбор);
		Элемент.alias = Псевдоним(Разбор);
		Возврат Элемент;
	КонецЕсли;
	Элемент.expression = Выражение(Разбор);
	Если Не ЭтоИмя(Текущая(Разбор), "with") Тогда
		Ожидалось(Разбор, "with");
		Возврат Элемент;
	КонецЕсли;
	Следующая(Разбор);
	Метод = Текущая(Разбор);
	Если Метод.Вид <> "Имя" Тогда
		Ожидалось(Разбор, "метод агрегации");
		Возврат Элемент;
	КонецЕсли;
	Если СтрРазделить("sum,min,max,average,countdistinct", ",").Найти(Метод.Текст) = Неопределено Тогда
		ОшибкаВРазборе(Разбор, СтрШаблон("%1: неизвестный метод агрегации %2 в позиции %3", Разбор.Параметр,
			Метод.Текст, Число0(Метод.Позиция)));
		Возврат Элемент;
	КонецЕсли;
	Следующая(Разбор);
	Элемент.method = Метод.Текст;
	Элемент.alias = Псевдоним(Разбор);
	Возврат Элемент;
КонецФункции

// compute(выражение as имя, …)
Функция СписокВычислений(Разбор, Лексема)
	ОжидатьЗнак(Разбор, "(");
	Войти(Разбор, Лексема);
	Элементы = Новый Массив;
	Пока Истина Цикл
		Выражение0 = Выражение(Разбор);
		Элементы.Добавить(Новый Структура("expression, alias", Выражение0, Псевдоним(Разбор)));
		Если Элементы.Количество() > 64 Тогда
			ОшибкаВРазборе(Разбор, СтрШаблон("%1: слишком много вычислений", Разбор.Параметр));
			Прервать;
		КонецЕсли;
		Если Не ЭтоЗнак(Текущая(Разбор), ",") Тогда
			Прервать;
		КонецЕсли;
		Следующая(Разбор);
	КонецЦикла;
	ОжидатьЗнак(Разбор, ")");
	Выйти(Разбор);
	Возврат Элементы;
КонецФункции

// «as Имя» после агрегата или вычисления; имя с «$» не допускается.
Функция Псевдоним(Разбор)
	Если Не ЭтоИмя(Текущая(Разбор), "as") Тогда
		Ожидалось(Разбор, "as");
		Возврат "";
	КонецЕсли;
	Следующая(Разбор);
	Лексема = Текущая(Разбор);
	Если Лексема.Вид <> "Имя" Или СтрНачинаетсяС(Лексема.Текст, "$") Тогда
		Ожидалось(Разбор, "имя");
		Возврат "";
	КонецЕсли;
	Следующая(Разбор);
	Возврат Лексема.Текст;
КонецФункции

#КонецОбласти
