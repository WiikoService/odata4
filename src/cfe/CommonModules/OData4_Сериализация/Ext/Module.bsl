#Область ПрограммныйИнтерфейс

Функция НоваяЗапись() Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	Возврат Запись;
КонецФункции

Функция ОтветJSON(Статус, Текст, Заголовки = Неопределено) Экспорт
	Ответ = ОтветТекст(Статус, Текст, "application/json;odata.metadata=minimal;charset=utf-8");
	Если Заголовки <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Заголовки Цикл
			Ответ.Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция ОтветТекст(Статус, Текст, ТипСодержимого) Экспорт
	Ответ = Новый HTTPСервисОтвет(Статус);
	Ответ.Заголовки.Вставить("Content-Type", ТипСодержимого);
	Ответ.Заголовки.Вставить("OData-Version", "4.0");
	Ответ.УстановитьТелоИзСтроки(Текст, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Возврат Ответ;
КонецФункции

// Ответ об ошибке OData. Подробности (6.2) — Массив Структура("code, message, target") для error.details (target
// необязателен: пустой не выводится); Неопределено или пустой массив — без details.
Функция ОтветОшибки(Статус, Код, Сообщение, Подробности = Неопределено) Экспорт
	Запись = НоваяЗапись();
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("error");
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("code");
	Запись.ЗаписатьЗначение(Код);
	Запись.ЗаписатьИмяСвойства("message");
	Запись.ЗаписатьЗначение(Сообщение);
	Если Подробности <> Неопределено И Подробности.Количество() > 0 Тогда
		Запись.ЗаписатьИмяСвойства("details");
		Запись.ЗаписатьНачалоМассива();
		Для Каждого Подробность Из Подробности Цикл
			Запись.ЗаписатьНачалоОбъекта();
			Запись.ЗаписатьИмяСвойства("code");
			Запись.ЗаписатьЗначение(Подробность.code);
			Запись.ЗаписатьИмяСвойства("message");
			Запись.ЗаписатьЗначение(Подробность.message);
			Если ЗначениеЗаполнено(Подробность.target) Тогда
				Запись.ЗаписатьИмяСвойства("target");
				Запись.ЗаписатьЗначение(Подробность.target);
			КонецЕсли;
			Запись.ЗаписатьКонецОбъекта();
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	КонецЕсли;
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецОбъекта();
	Возврат ОтветJSON(Статус, Запись.Закрыть());
КонецФункции

// Значение ETag по версии данных (DataVersion, 6.2): слабый W/"<версия>" — одна версия данных даёт разные
// представления ($select, $expand). Пустая версия — "".
Функция ЗначениеETag(ВерсияДанных) Экспорт
	Если Не ЗначениеЗаполнено(ВерсияДанных) Тогда
		Возврат "";
	КонецЕсли;
	Возврат "W/""" + ВерсияДанных + """";
КонецФункции

// Непрозрачные значения ETag из заголовка If-Match или If-None-Match: Массив строк без W/ и кавычек; «*» — элемент "*".
Функция ЗначенияETag(Заголовок) Экспорт
	Результат = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Заголовок, ",", Ложь) Цикл
		Значение = СокрЛП(Часть);
		Если ВРег(Лев(Значение, 2)) = "W/" Тогда
			Значение = Сред(Значение, 3);
		КонецЕсли;
		Если СтрДлина(Значение) >= 2 И Лев(Значение, 1) = """" И Прав(Значение, 1) = """" Тогда
			Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
		КонецЕсли;
		Если Значение <> "" Тогда
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Режим дат из настроек (ресурс РежимДат регистра OData4_Настройки): Строгий или Совместимый.
Функция РежимДат() Экспорт
	Возврат РежимДатИз(OData4_НастройкиСервиса.Действующие());
КонецФункции

// Режим дат из переданных настроек (Структура с полем РежимДат): всё, кроме «Совместимый», — Строгий.
Функция РежимДатИз(Настройки) Экспорт
	Значение = "";
	Если Настройки.Свойство("РежимДат", Значение) И Значение = "Совместимый" Тогда
		Возврат "Совместимый";
	КонецЕсли;
	Возврат "Строгий";
КонецФункции

Функция ТипДаты(Состав) Экспорт
	Если РежимДат() = "Совместимый" Тогда
		Возврат "Edm.DateTimeOffset";
	ИначеЕсли Состав = "Дата" Тогда
		Возврат "Edm.Date";
	ИначеЕсли Состав = "Время" Тогда
		Возврат "Edm.TimeOfDay";
	КонецЕсли;
	Возврат "Edm.DateTimeOffset";
КонецФункции

// Пустое значение свойства в JSON (NullКакПустое): ссылка — нулевой GUID, строка — "", булево — false, дата —
// 0001-01-01T00:00:00, число — 0.
Функция ПустоеЗначениеEdm(Свойство)
	Если Свойство.Вид = "Ссылка" Тогда
		Возврат "00000000-0000-0000-0000-000000000000";
	ИначеЕсли Свойство.ТипEdm = "Edm.String" Тогда
		Возврат "";
	ИначеЕсли Свойство.ТипEdm = "Edm.Boolean" Тогда
		Возврат Ложь;
	ИначеЕсли Свойство.ЧастиДаты <> "" Тогда
		Возврат "0001-01-01T00:00:00";
	КонецЕсли;
	Возврат 0;
КонецФункции

// Записывает свойство объекта; составное — парой «значение» и «_Type».
// NULL (реквизит не используется в строке, например у группы) — null, у составного _Type — "".
// Суррогатный ключ (SurrogateKey) в базе не хранится — всегда 0, как у standard.odata в константах.
Процедура ЗаписатьСвойство(Запись, Свойство, Значение) Экспорт
	Если Свойство.Вид = "Суррогат" Тогда
		Запись.ЗаписатьИмяСвойства(Свойство.Имя);
		Запись.ЗаписатьЗначение(0);
		Возврат;
	ИначеЕсли Свойство.Вид = "Пусто" Тогда
		// Объявлено в $metadata, но в строках не выдаётся, как у standard.odata (ExchangeDate плана обмена).
		Возврат;
	ИначеЕсли Значение = NULL И Свойство.Свойство("NullКакПустое") И Свойство.NullКакПустое
		И (Свойство.Вид = "Ссылка" Или Свойство.Вид = "Примитив") Тогда
		Запись.ЗаписатьИмяСвойства(Свойство.Имя);
		Запись.ЗаписатьЗначение(ПустоеЗначениеEdm(Свойство));
		Возврат;
	ИначеЕсли Значение = NULL И Свойство.Вид <> "Хранилище" Тогда
		Запись.ЗаписатьИмяСвойства(Свойство.Имя);
		Запись.ЗаписатьЗначение(Неопределено);
		Если Свойство.Вид = "Составной" Тогда
			Запись.ЗаписатьИмяСвойства(Свойство.Имя + "_Type");
			Запись.ЗаписатьЗначение("");
		КонецЕсли;
		Возврат;
	ИначеЕсли Свойство.Вид = "Составной" Тогда
		Запись.ЗаписатьИмяСвойства(Свойство.Имя);
		Запись.ЗаписатьЗначение(ЗначениеСоставного(Значение));
		Запись.ЗаписатьИмяСвойства(Свойство.Имя + "_Type");
		Запись.ЗаписатьЗначение(ИмяТипаЗначения(Значение));
		Возврат;
	ИначеЕсли Свойство.Вид = "Хранилище" Тогда
		ЗаписатьХранилище(Запись, Свойство.Имя, Значение);
		Возврат;
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства(Свойство.Имя);
	Если Свойство.Вид = "ВидДвижения" Тогда
		Запись.ЗаписатьЗначение(ИмяВидаДвижения(Значение));
	ИначеЕсли Свойство.Вид = "ОписаниеТипов" Тогда
		ЗаписатьОписаниеТипов(Запись, Значение);
	ИначеЕсли Свойство.Вид = "ТипДокумента" Тогда
		// Тип документа журнала — представление вида документа (синоним), как у standard.odata.
		Запись.ЗаписатьЗначение(?(ТипЗнч(Значение) = Тип("Тип"), Строка(Значение), ""));
	ИначеЕсли Свойство.Вид = "ТочкаМаршрута" Тогда
		Запись.ЗаписатьЗначение(ИмяТочкиМаршрута(Значение));
	ИначеЕсли Свойство.Вид = "Ключ" Или Свойство.Вид = "Ссылка" Или Свойство.ТипEdm = "Edm.Guid" Тогда
		Запись.ЗаписатьЗначение(ГУИД(Значение));
	ИначеЕсли Свойство.Вид = "Перечисление" Тогда
		// Пустое значение не член EnumType — null; перечисление без значений объявлено Edm.String — "".
		ИмяЗначения = ИмяЗначенияПеречисления(Значение);
		Если ИмяЗначения = "" И Свойство.ТипEdm <> "Edm.String" Тогда
			ИмяЗначения = Неопределено;
		КонецЕсли;
		Запись.ЗаписатьЗначение(ИмяЗначения);
	ИначеЕсли Свойство.ЧастиДаты <> "" Тогда
		Запись.ЗаписатьЗначение(ПредставлениеДаты(Значение, Свойство.ЧастиДаты));
	Иначе
		Запись.ЗаписатьЗначение(Значение);
	КонецЕсли;
КонецПроцедуры

Функция ГУИД(Значение) Экспорт
	Если Значение = NULL Или Значение = Неопределено Тогда
		Возврат "00000000-0000-0000-0000-000000000000";
	ИначеЕсли ТипЗнч(Значение) = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат Строка(Значение.УникальныйИдентификатор());
КонецФункции

// Неопределено — пустая дата в строгом режиме (в JSON — null).
Функция ПредставлениеДаты(Значение, Состав) Экспорт
	Пустая = Значение = NULL Или Значение = Дата(1, 1, 1);
	Если РежимДат() = "Совместимый" Тогда
		Возврат ?(Пустая, "0001-01-01T00:00:00", XMLСтрока(Значение)) + "Z";
	КонецЕсли;
	Если Пустая Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = XMLСтрока(Значение);
	Если Состав = "Дата" Тогда
		Возврат Лев(Текст, 10);
	ИначеЕсли Состав = "Время" Тогда
		Возврат Сред(Текст, 12, 8);
	КонецЕсли;
	Возврат Текст + СмещениеПояса(Значение, OData4_ПовтИспВызова.ЧасовойПоясБазы());
КонецФункции

// Смещение пояса для местного времени Значение («+03:00»). Смещения берутся на универсальный момент
// этого местного времени — иначе час после перехода на летнее время получает неверное смещение.
Функция СмещениеПояса(Значение, Пояс) Экспорт
	Универсальное = УниверсальноеВремя(Значение, Пояс);
	Секунды = СмещениеСтандартногоВремени(Пояс, Универсальное) + СмещениеЛетнегоВремени(Пояс, Универсальное);
	Знак = ?(Секунды < 0, "-", "+");
	Секунды = ?(Секунды < 0, -Секунды, Секунды);
	Часы = Цел(Секунды / 3600);
	Минуты = Цел((Секунды - Часы * 3600) / 60);
	Возврат Знак + Прав("00" + Формат(Часы, "ЧГ=0"), 2) + ":" + Прав("00" + Формат(Минуты, "ЧГ=0"), 2);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяЗначенияПеречисления(Значение)
	Если Значение = NULL Или Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат XMLСтрока(Значение);
КонецФункции

// Значение составного свойства — строка (свойство объявлено Edm.String), как в standard.odata:
// Неопределено — пустая строка, число и булево — XML-представление ("0", "true").
Функция ЗначениеСоставного(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат ПредставлениеДаты(Значение, "ДатаВремя");
	КонецЕсли;
	Описание = ОписаниеТипа(Значение);
	Если Описание <> Неопределено И Описание.ЭтоПеречисление Тогда
		Возврат ИмяЗначенияПеречисления(Значение);
	КонецЕсли;
	Возврат ГУИД(Значение);
КонецФункции

Функция ИмяТипаЗначения(Значение) Экспорт
	Если Значение = NULL Или Значение = Неопределено Тогда
		Возврат "StandardODATA.Undefined";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "Edm.String";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат "Edm.Decimal";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат "Edm.Boolean";
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат "Edm.DateTimeOffset";
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат "Edm.Guid";
	КонецЕсли;
	Описание = ОписаниеТипа(Значение);
	Возврат ?(Описание = Неопределено, "StandardODATA.Undefined", Описание.ИмяТипа);
КонецФункции

// Описание ссылочного типа или перечисления из кэша вызова; Неопределено — у типа нет XML-имени.
Функция ОписаниеТипа(Значение)
	ТипXML = XMLТипЗнч(Значение);
	Если ТипXML = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат OData4_ПовтИспВызова.ОписаниеТипаЗначения(ТипXML.ИмяТипа, ТипXML.URIПространстваИмен);
КонецФункции

// Хранилище значения, как в standard.odata: Имя_Type и Имя_Base64Data, сам поток не пишется.
// NULL — "" и null; Неопределено — XDTO и ""; двоичные данные — octet-stream;
// прочее — base64 XML-сериализации XDTO.
Процедура ЗаписатьХранилище(Запись, Имя, Значение)
	ТипСодержимого = "";
	Данные = Неопределено;
	Если Значение <> NULL Тогда
		Содержимое = Значение.Получить();
		Если ТипЗнч(Содержимое) = Тип("ДвоичныеДанные") Тогда
			ТипСодержимого = "application/octet-stream";
			Данные = Base64Строка(Содержимое);
		Иначе
			ТипСодержимого = "application/xml+xdto";
			Данные = ?(Содержимое = Неопределено, "", Base64Строка(ДанныеXDTO(Содержимое)));
		КонецЕсли;
	КонецЕсли;
	Запись.ЗаписатьИмяСвойства(Имя + "_Type");
	Запись.ЗаписатьЗначение(ТипСодержимого);
	Запись.ЗаписатьИмяСвойства(Имя + "_Base64Data");
	Запись.ЗаписатьЗначение(Данные);
КонецПроцедуры

// XML-сериализация XDTO без BOM и объявления, переводы строк CRLF (запись в поток),
// простой тип — элементом с именем типа с заглавной буквы (<String …>), как в standard.odata.
Функция ДанныеXDTO(Содержимое)
	Поток = Новый ПотокВПамяти;
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьПоток(Поток, "UTF-8", Ложь);
	ТипXML = XMLТипЗнч(Содержимое);
	Если ТипXML <> Неопределено И ТипXML.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema" Тогда
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Содержимое,
			ВРег(Лев(ТипXML.ИмяТипа, 1)) + Сред(ТипXML.ИмяТипа, 2), ТипXML.URIПространстваИмен);
	Иначе
		СериализаторXDTO.ЗаписатьXML(ЗаписьXML, Содержимое);
	КонецЕсли;
	ЗаписьXML.Закрыть();
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
КонецФункции

// Описание типов (ValueType плана видов характеристик) объектом TypeDescription, как в standard.odata:
// Types — XML-имена ссылочных типов (CatalogRef.X) и английские имена примитивов (String, Number…),
// квалификаторы числа, строки, даты и двоичных данных.
Процедура ЗаписатьОписаниеТипов(Запись, Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("ОписаниеТипов") Тогда
		Запись.ЗаписатьЗначение(Неопределено);
		Возврат;
	КонецЕсли;
	Запись.ЗаписатьНачалоОбъекта();
	Запись.ЗаписатьИмяСвойства("Types");
	Запись.ЗаписатьНачалоМассива();
	Для Каждого ТипЗначения Из Значение.Типы() Цикл
		Запись.ЗаписатьЗначение(ИмяТипаВОписании(ТипЗначения));
	КонецЦикла;
	Запись.ЗаписатьКонецМассива();
	Число0 = Значение.КвалификаторыЧисла;
	Запись.ЗаписатьИмяСвойства("NumberQualifiers");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПоле(Запись, "AllowedSign", ?(Число0.ДопустимыйЗнак = ДопустимыйЗнак.Неотрицательный, "Nonnegative", "Any"));
	ЗаписатьПоле(Запись, "Digits", Число0.Разрядность);
	ЗаписатьПоле(Запись, "FractionDigits", Число0.РазрядностьДробнойЧасти);
	Запись.ЗаписатьКонецОбъекта();
	Строка0 = Значение.КвалификаторыСтроки;
	Запись.ЗаписатьИмяСвойства("StringQualifiers");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПоле(Запись, "AllowedLength",
		?(Строка0.ДопустимаяДлина = ДопустимаяДлина.Фиксированная, "Fixed", "Variable"));
	ЗаписатьПоле(Запись, "Length", Строка0.Длина);
	Запись.ЗаписатьКонецОбъекта();
	Части = Значение.КвалификаторыДаты.ЧастиДаты;
	Запись.ЗаписатьИмяСвойства("DateQualifiers");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПоле(Запись, "DateFractions", ?(Части = ЧастиДаты.Дата, "Date", ?(Части = ЧастиДаты.Время, "Time", "DateTime")));
	Запись.ЗаписатьКонецОбъекта();
	Двоичные = Значение.КвалификаторыДвоичныхДанных;
	Запись.ЗаписатьИмяСвойства("BinaryDataQualifiers");
	Запись.ЗаписатьНачалоОбъекта();
	ЗаписатьПоле(Запись, "AllowedLength",
		?(Двоичные.ДопустимаяДлина = ДопустимаяДлина.Фиксированная, "Fixed", "Variable"));
	ЗаписатьПоле(Запись, "Length", Двоичные.Длина);
	Запись.ЗаписатьКонецОбъекта();
	Запись.ЗаписатьКонецОбъекта();
КонецПроцедуры

// Имя типа в описании типов: ссылки — XML-имя (CatalogRef.X), примитивы — английское имя типа 1С.
Функция ИмяТипаВОписании(ТипЗначения) Экспорт
	Примитивы = Новый Соответствие;
	Примитивы.Вставить(Тип("Строка"), "String");
	Примитивы.Вставить(Тип("Число"), "Number");
	Примитивы.Вставить(Тип("Дата"), "Date");
	Примитивы.Вставить(Тип("Булево"), "Boolean");
	Примитивы.Вставить(Тип("УникальныйИдентификатор"), "UUID");
	Примитивы.Вставить(Тип("ХранилищеЗначения"), "ValueStorage");
	Примитивы.Вставить(Тип("ДвоичныеДанные"), "BinaryData");
	Имя = Примитивы.Получить(ТипЗначения);
	Если Имя <> Неопределено Тогда
		Возврат Имя;
	КонецЕсли;
	ТипXML = XMLТип(ТипЗначения);
	Возврат ?(ТипXML = Неопределено, Строка(ТипЗначения), ТипXML.ИмяТипа);
КонецФункции

Процедура ЗаписатьПоле(Запись, Имя, Значение)
	Запись.ЗаписатьИмяСвойства(Имя);
	Запись.ЗаписатьЗначение(Значение);
КонецПроцедуры

// Имя точки маршрута бизнес-процесса; пустое значение — "".
Функция ИмяТочкиМаршрута(Значение)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Попытка
		Возврат Значение.Имя;
	Исключение
		Возврат Строка(Значение);
	КонецПопытки;
КонецФункции

// Вид движения в именах standard.odata: Приход → Receipt, Расход → Expense,
// Дебет → Debit, Кредит → Credit; вид счёта: Active, Passive, ActivePassive; пустое значение — "".
Функция ИмяВидаДвижения(Значение) Экспорт
	Если Значение = NULL Или Значение = Неопределено Тогда
		Возврат "";
	ИначеЕсли Значение = ВидДвиженияНакопления.Приход Тогда
		Возврат "Receipt";
	ИначеЕсли Значение = ВидДвиженияНакопления.Расход Тогда
		Возврат "Expense";
	ИначеЕсли Значение = ВидДвиженияБухгалтерии.Дебет Тогда
		Возврат "Debit";
	ИначеЕсли Значение = ВидДвиженияБухгалтерии.Кредит Тогда
		Возврат "Credit";
	ИначеЕсли Значение = ВидСчета.Активный Тогда
		Возврат "Active";
	ИначеЕсли Значение = ВидСчета.Пассивный Тогда
		Возврат "Passive";
	ИначеЕсли Значение = ВидСчета.АктивноПассивный Тогда
		Возврат "ActivePassive";
	КонецЕсли;
	Возврат "";
КонецФункции

// Значение вида движения по имени standard.odata; неизвестное имя — Неопределено.
Функция ВидДвиженияПоИмени(ИмяПеречисления, ИмяЗначения) Экспорт
	Если ИмяПеречисления = "ВидСчета" Тогда
		Если ИмяЗначения = "Active" Тогда
			Возврат ВидСчета.Активный;
		ИначеЕсли ИмяЗначения = "Passive" Тогда
			Возврат ВидСчета.Пассивный;
		ИначеЕсли ИмяЗначения = "ActivePassive" Тогда
			Возврат ВидСчета.АктивноПассивный;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Если ИмяПеречисления = "ВидДвиженияБухгалтерии" Тогда
		Если ИмяЗначения = "Debit" Тогда
			Возврат ВидДвиженияБухгалтерии.Дебет;
		ИначеЕсли ИмяЗначения = "Credit" Тогда
			Возврат ВидДвиженияБухгалтерии.Кредит;
		КонецЕсли;
		Возврат Неопределено;
	КонецЕсли;
	Если ИмяЗначения = "Receipt" Тогда
		Возврат ВидДвиженияНакопления.Приход;
	ИначеЕсли ИмяЗначения = "Expense" Тогда
		Возврат ВидДвиженияНакопления.Расход;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

#КонецОбласти
