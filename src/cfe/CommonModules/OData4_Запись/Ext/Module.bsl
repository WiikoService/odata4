#Область ПрограммныйИнтерфейс

// Запись через OData4 (этап 6.2): POST на набор, PATCH (MERGE) и PUT по ключу, DELETE, действия Post и Unpost
// (OData4_Действия). Вход (OData4_Безопасность.Войти) уже выполнен. Порядок проверок — решение 14 плана 6.2: набор
// (НаборМаршрута, 404) → вид набора и метод (405) → операция профиля (403) → условия If-Match (428) → объект виден
// чтением (404) → запись правами 1С в транзакции (403, 400, 412) → объект виден и после записи.

// Запрос записи: методы POST, PUT, PATCH, MERGE, DELETE.
Функция ЭтоЗапись(Запрос) Экспорт
	Метод = ВРег(Запрос.HTTPМетод);
	Возврат Метод = "POST" Или Метод = "PUT" Или Метод = "PATCH" Или Метод = "MERGE" Или Метод = "DELETE";
КонецФункции

// Выполняет запрос записи и возвращает ответ; ошибки — исключением OData4_Сервис.ОшибкаOData (подробности —
// ПодробностиОшибки). Итог.Строк — 1 при успехе (журнал запросов). В режиме прав служебного пользователя
// «Привилегированный» (сервис odatat, только без безопасного режима) запись выполняется в привилегированном режиме.
Функция ВыполнитьЗапрос(Запрос, Итог) Экспорт
	Возврат ВыполнитьОписание(ОписаниеЗапроса(Запрос), Итог);
КонецФункции

// Описание запроса записи (поля — как у HTTPСервисЗапрос, тело — строкой): HTTPМетод, ОтносительныйURL,
// ПараметрыЗапроса, БазовыйURL, Заголовки, Тело. Для YAxUnit: запись без HTTP-сервиса. Запрос — HTTPСервисЗапрос
// или такая же структура (токен в пути, OData4_Безопасность.ЗапросСТокеномВПути).
Функция ОписаниеЗапроса(Запрос) Экспорт
	Если ТипЗнч(Запрос) = Тип("Структура") Тогда
		Тело = Запрос.Тело;
	Иначе
		Тело = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	КонецЕсли;
	Возврат Новый Структура("HTTPМетод, ОтносительныйURL, ПараметрыЗапроса, БазовыйURL, Заголовки, Тело", Запрос.HTTPМетод,
		Запрос.ОтносительныйURL, Запрос.ПараметрыЗапроса, Запрос.БазовыйURL, Запрос.Заголовки, ?(Тело = Неопределено, "", Тело));
КонецФункции

// Выполняет запрос записи по описанию (ОписаниеЗапроса) — см. ВыполнитьЗапрос.
Функция ВыполнитьОписание(Запрос, Итог) Экспорт
	ПолучитьСообщенияПользователю(Истина);
	Вызов = СнимокВызова();
	Привилегированно = OData4_Безопасность.ПривилегированноеЧтение();
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Попытка
		К = НовыйКонтекст(Запрос, Вызов);
		Ответ = ВыполнитьСПовтором(К);
	Исключение
		ВосстановитьВызов(Вызов);
		Если Привилегированно Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьВызов(Вызов);
	Если Привилегированно Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	Итог.Строк = 1;
	Возврат Ответ;
КонецФункции

// Операция текущего запроса (договор 6.2 → 6.3, журнал): Структура("Операция, Объект") или Неопределено, если запрос
// не пишет. Операция — Добавление, Изменение, Удаление, ФизическоеУдаление, Проведение, ОтменаПроведения; Объект —
// полное имя объекта метаданных. Исключений не бросает.
Функция ТекущаяОперация() Экспорт
	Попытка
		Операция = OData4_ЗаписьВызов.Операция();
		Если Операция.Операция = "" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Новый Структура("Операция, Объект", Операция.Операция, Операция.Объект);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// error.details ошибки записи текущего вызова (Массив Структура("code, message, target")) или Неопределено.
// Исключений не бросает.
Функция ПодробностиОшибки() Экспорт
	Попытка
		Возврат OData4_ЗаписьВызов.Операция().Подробности;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Отмечает операцию текущего запроса (для журнала: и отказанную).
Процедура УстановитьОперацию(К, Операция) Экспорт
	Вызов = Неопределено;
	Если Не К.Свойство("Вызов", Вызов) Тогда
		Вызов = СнимокВызова();
	КонецЕсли;
	Вызов.Операция.Операция = Операция;
	Вызов.Операция.Объект = К.ПолноеИмя;
	ВосстановитьВызов(Вызов);
КонецПроцедуры

// Снимок значений «на время вызова» (контекст безопасности 5.2 и операция записи): запись объектов конфигурации может
// сбросить кэши повторного использования (проба 6.2, П12), и без восстановления запрос потерял бы профиль, субъекта и
// операцию для журнала.
Функция СнимокВызова() Экспорт
	Возврат Новый Структура("Контекст, Операция", OData4_БезопасностьВызов.Контекст(), OData4_ЗаписьВызов.Операция());
КонецФункции

// Возвращает значения снимка в текущие значения «на время вызова», если кэш был сброшен, и запоминает текущие объекты.
Процедура ВосстановитьВызов(Вызов) Экспорт
	Текущий = OData4_БезопасностьВызов.Контекст();
	Если Текущий <> Вызов.Контекст Тогда
		Для Каждого КлючИЗначение Из Вызов.Контекст Цикл
			Текущий.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Вызов.Контекст = Текущий;
	КонецЕсли;
	Операция = OData4_ЗаписьВызов.Операция();
	Если Операция <> Вызов.Операция Тогда
		ЗаполнитьЗначенияСвойств(Операция, Вызов.Операция);
		Вызов.Операция = Операция;
	КонецЕсли;
КонецПроцедуры

// Операция разрешена профилем субъекта (у субъекта без профиля — права 1С, проверки нет); иначе 403 с фактом.
Процедура ПроверитьОперацию(К, Операция) Экспорт
	ПроверитьПраво1С(К, Операция);
	Если К.Описание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не OData4_Профили.Разрешено(К.Описание, К.ПолноеИмя, Операция) Тогда
		OData4_Сервис.ОшибкаOData(403, "Forbidden", "Операция «" + Операция + "» над набором " + К.Набор.Имя
			+ " запрещена профилем");
	КонецЕсли;
КонецПроцедуры

// Право 1С на операцию до бизнес-логики (решение 35, наблюдение Н1 QA): нет права — 403 с тем же текстом, что при
// нарушении прав в записи, без запуска обработчиков. RLS проверяет запись. В привилегированном режиме не проверяется.
Процедура ПроверитьПраво1С(К, Операция)
	Если ПривилегированныйРежим() Или К.ОбъектМетаданных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Права = Новый Соответствие;
	Права.Вставить("Добавление", "Добавление");
	Права.Вставить("Изменение", "Изменение");
	Права.Вставить("Удаление", "Изменение");
	Права.Вставить("ФизическоеУдаление", "Удаление");
	Права.Вставить("Проведение", "Проведение");
	Права.Вставить("ОтменаПроведения", "ОтменаПроведения");
	Право = Права.Получить(Операция);
	Если К.Вид = "Регистр" Или К.Вид = "Константа" Или К.Вид = "НаборДвижений" Тогда
		Право = "Изменение";
	КонецЕсли;
	Если Право <> Неопределено И Не ПравоДоступа(Право, К.ОбъектМетаданных) Тогда
		OData4_Сервис.ОшибкаOData(403, "Forbidden", ?(К.Контекст.Сервис = "odatat", "Служебному пользователю",
			"Пользователю " + ИмяПользователя()) + " не хватает прав на " + К.ПолноеИмя);
	КонецЕсли;
КонецПроцедуры

// Требование If-Match (настройка ТребоватьIfMatch): нет заголовка — 428.
Процедура ПроверитьНаличиеУсловия(К) Экспорт
	Если К.Настройки.ТребоватьIfMatch И ЗначениеЗаголовка(К, "If-Match") = "" Тогда
		OData4_Сервис.ОшибкаOData(428, "PreconditionRequired", "Изменение " + К.Набор.Имя
			+ " требует заголовка If-Match (настройка «Требовать If-Match»)");
	КонецЕсли;
КонецПроцедуры

// Сверка If-Match и If-None-Match с текущей версией (ВерсияДанных; "" — у ресурса версии нет): If-Match без «*» и без
// текущей версии — 412; If-None-Match: * у существующего — 412.
Процедура ПроверитьВерсию(К, ВерсияДанных) Экспорт
	ЕслиСовпадает = ЗначениеЗаголовка(К, "If-Match");
	Если ЕслиСовпадает <> "" Тогда
		Значения = OData4_Сериализация.ЗначенияETag(ЕслиСовпадает);
		Если Значения.Найти("*") = Неопределено И (ВерсияДанных = "" Или Значения.Найти(ВерсияДанных) = Неопределено) Тогда
			OData4_Сервис.ОшибкаOData(412, "PreconditionFailed", "Версия " + К.Набор.Имя + " не совпадает с If-Match: "
				+ ?(ВерсияДанных = "", "у ресурса нет ETag, подходит только If-Match: *",
				"текущий ETag " + OData4_Сериализация.ЗначениеETag(ВерсияДанных)));
		КонецЕсли;
	КонецЕсли;
	Если OData4_Сериализация.ЗначенияETag(ЗначениеЗаголовка(К, "If-None-Match")).Найти("*") <> Неопределено Тогда
		OData4_Сервис.ОшибкаOData(412, "PreconditionFailed", "Объект " + К.Набор.Имя + " существует (If-None-Match: *)");
	КонецЕсли;
КонецПроцедуры

// Значения полей видимой сущности по ключу (Массив пар маршрутизатора) или 404.
Функция СтрокаСущности(К, Ключ) Экспорт
	Строка0 = OData4_Чтение.СтрокаСущности(К.Модель, К.Набор, Ключ);
	Если Строка0 = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Объект не найден: " + К.Набор.Имя + "(" + ТекстКлючаМаршрута(К) + ")");
	КонецЕсли;
	Возврат Строка0;
КонецФункции

// Управляемая исключительная блокировка объекта по ссылке (в транзакции).
Процедура ЗаблокироватьСсылку(К, Ссылка) Экспорт
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(К.ПолноеИмя);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Ссылка", Ссылка);
	Блокировка.Заблокировать();
КонецПроцедуры

// Запись объекта с бизнес-логикой: ОбменДанными.Загрузка = Ложь, ПроверитьЗаполнение() по настройке (решение 16),
// режим записи документа ("" — Записать() без параметров, «Запись», «Проведение», «ОтменаПроведения»).
Процедура ЗаписатьОбъект(К, Объект, РежимЗаписи = "", РежимПроведения = Неопределено) Экспорт
	Объект.ОбменДанными.Загрузка = Ложь;
	Если РежимЗаписи <> "ОтменаПроведения" И К.Настройки.ПроверятьЗаполнение И Не Объект.ПроверитьЗаполнение() Тогда
		ОшибкаЗаписи(К, 400, "BadRequest", "Объект " + К.Набор.Имя + " не записан: не пройдена проверка заполнения", "");
	КонецЕсли;
	Если РежимЗаписи = "" Тогда
		Объект.Записать();
	ИначеЕсли РежимЗаписи = "Проведение" Тогда
		Объект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведения);
	ИначеЕсли РежимЗаписи = "ОтменаПроведения" Тогда
		Объект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	Иначе
		Объект.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	ВосстановитьВызов(К.Вызов);
КонецПроцедуры

// Режим проведения документа (решение 19): параметр клиента (Истина/Ложь) главнее настройки РежимПроведения;
// «ОперативныйСегодня» — оперативно, если дата документа — сегодня и документ допускает оперативное проведение.
Функция РежимПроведения(К, Объект, Оперативно = Неопределено) Экспорт
	Допустимо = К.ОбъектМетаданных.ОперативноеПроведение = Метаданные.СвойстваОбъектов.ОперативноеПроведение.Разрешить;
	Сегодня = НачалоДня(Объект.Дата) = НачалоДня(ТекущаяДатаСеанса());
	Если Оперативно = Неопределено Тогда
		Оперативно = К.Настройки.РежимПроведения = "ОперативныйСегодня" И Допустимо И Сегодня;
	ИначеЕсли Оперативно И Не Допустимо Тогда
		ОшибкаЗаписи(К, 400, "BadRequest", "Документ " + К.Набор.Имя + " не проводится оперативно", "");
	ИначеЕсли Оперативно И Не Сегодня Тогда
		// Платформа отвечает «Недопустимое значение параметра»; standard.odata — текстом о дате (проба 6.2, П6).
		ОшибкаЗаписи(К, 400, "BadRequest", "Документ " + К.Набор.Имя + " не может быть проведён оперативно: дата документа "
			+ Формат(Объект.Дата, "ДЛФ=D") + " не текущая", "");
	КонецЕсли;
	Возврат ?(Оперативно, РежимПроведенияДокумента.Оперативный, РежимПроведенияДокумента.Неоперативный);
КонецФункции

// После записи объект виден профилю (отборы строк); иначе 403 — запись откатывается вызывающим.
Процедура ПроверитьВидимость(К, Ключ) Экспорт
	Если К.Описание = Неопределено Или Не К.Описание.ЕстьОтборы Тогда
		Возврат;
	КонецЕсли;
	Если OData4_Чтение.СтрокаСущности(К.Модель, К.Набор, Ключ) = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(403, "Forbidden", "Объект " + К.Набор.Имя + " после записи вне отборов профиля");
	КонецЕсли;
КонецПроцедуры

// Откат транзакции и ответ об ошибке (решение 17): исключение OData4 передаётся как есть; иное — в журнал регистрации
// подробно, клиенту — 403 (нарушение прав), 412 (объект изменён другим сеансом), 409 (конфликт блокировок) или 400 с
// сообщениями пользователю в error.details. Сырой текст исключения (в нём бывают тексты запросов обработчиков и данные
// вне профиля) клиенту отдаётся только с настройкой ПодробныеОшибкиЗаписи (отзыв безопасности, группа B); без неё
// подробность Exception несёт постоянный текст.
Процедура ОтменитьИПередать(К, Информация) Экспорт
	Если ТранзакцияАктивна() Тогда
		ОтменитьТранзакцию();
	КонецЕсли;
	ПередатьОшибку(К, Информация);
КонецПроцедуры

// Ответ об ошибке записи по исключению (см. ОтменитьИПередать) — транзакция уже отменена вызывающим.
Процедура ПередатьОшибку(К, Информация)
	ВосстановитьВызов(К.Вызов);
	Если СтрНайти(Информация.Описание, "ODATA4|") > 0 Тогда
		ВызватьИсключение Информация.Описание;
	КонецЕсли;
	Подробно = ПодробноеПредставлениеОшибки(Информация);
	ЗаписьЖурналаРегистрации("OData4.Запись", УровеньЖурналаРегистрации.Предупреждение, , , Подробно);
	Причина = ?(ПодробныеОшибки(К), ТекстПричины(Информация), "");
	Исключение0 = ?(Причина = "", ТекстСкрытогоИсключения(), Причина);
	Операция = OData4_ЗаписьВызов.Операция().Операция;
	Если СтрНайти(Подробно, "Нарушение прав доступа") > 0 Или СтрНайти(Подробно, "Недостаточно прав") > 0 Тогда
		ОшибкаЗаписи(К, 403, "Forbidden", ?(К.Контекст.Сервис = "odatat", "Служебному пользователю",
			"Пользователю " + ИмяПользователя()) + " не хватает прав на " + К.ПолноеИмя, Исключение0);
	ИначеЕсли СтрНайти(Подробно, "изменен или удален другим") > 0 Или СтрНайти(Подробно, "изменен другим") > 0 Тогда
		ОшибкаЗаписи(К, 412, "PreconditionFailed", "Объект " + К.Набор.Имя + " изменён другим сеансом", Исключение0);
	ИначеЕсли СтрНайти(Подробно, "Конфликт блокировок") > 0 Тогда
		ОшибкаЗаписи(К, 409, "Conflict", "Объект " + К.Набор.Имя + " занят другим сеансом", Исключение0);
	КонецЕсли;
	ОшибкаЗаписи(К, 400, "BadRequest", "Операция «" + Операция + "» над набором " + К.Набор.Имя + " не выполнена"
		+ ?(Причина = "", "", ": " + Причина), Исключение0);
КонецПроцедуры

// Настройка «Подробные ошибки записи клиенту» (по умолчанию выключена).
Функция ПодробныеОшибки(К)
	Значение = Ложь;
	Возврат К.Настройки.Свойство("ПодробныеОшибкиЗаписи", Значение) И Значение = Истина;
КонецФункции

// Текст подробности Exception, когда текст исключения клиенту не отдаётся.
Функция ТекстСкрытогоИсключения()
	Возврат "Текст исключения записан в журнал регистрации (событие OData4.Запись); клиенту он отдаётся с настройкой "
		+ "«Подробные ошибки записи клиенту»";
КонецФункции

// Ответ 204 без тела (OData-Version и заголовки).
Функция ОтветБезТела(Заголовки) Экспорт
	Ответ = Новый HTTPСервисОтвет(204);
	Ответ.Заголовки.Вставить("OData-Version", "4.0");
	Для Каждого КлючИЗначение Из Заголовки Цикл
		Ответ.Заголовки.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Возврат Ответ;
КонецФункции

// Ключ ссылочного объекта для маршрута чтения: Массив из одной пары (безымянной) с литералом guid'…'.
Функция КлючСсылки(Ссылка) Экспорт
	Ключ = Новый Массив;
	Ключ.Добавить(Новый Структура("Имя, Текст", "", "guid'" + Строка(Ссылка.УникальныйИдентификатор()) + "'"));
	Возврат Ключ;
КонецФункции

// Значение заголовка запроса без учёта регистра имени ("" — нет).
Функция ЗначениеЗаголовка(К, Имя) Экспорт
	Возврат OData4_Безопасность.ЗначениеЗаголовка(К.Запрос, Имя);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйКонтекст(Запрос, Вызов)
	К = Новый Структура;
	К.Вставить("Запрос", Запрос);
	К.Вставить("Вызов", Вызов);
	К.Вставить("Маршрут", OData4_Маршрутизатор.РазобратьЗапись(Запрос.HTTPМетод, Запрос.ОтносительныйURL,
		Запрос.ПараметрыЗапроса));
	OData4_Безопасность.ПроверитьЛимиты(К.Маршрут);
	К.Вставить("Адрес", Запрос.БазовыйURL + "/v4");
	К.Вставить("Модель", OData4_МодельПовтИсп.Модель());
	К.Вставить("Набор", OData4_Безопасность.НаборМаршрута(К.Модель, К.Маршрут.Набор));
	К.Вставить("Контекст", Вызов.Контекст);
	К.Вставить("Описание", К.Контекст.ОписаниеПрофиля);
	К.Вставить("Настройки", OData4_НастройкиСервиса.Действующие());
	К.Вставить("ПолноеИмя", OData4_ПрофильМодели.ПолноеИмяОбъекта(К.Набор));
	К.Вставить("ОбъектМетаданных", ?(К.ПолноеИмя = "", Неопределено, Метаданные.НайтиПоПолномуИмени(К.ПолноеИмя)));
	К.Вставить("Вид", ВидЗаписи(К));
	ПроверитьОпцииОтвета(К);
	Возврат К;
КонецФункции

// Опции ответа ($select, $expand) проверяются планом чтения до записи (решение 37, дефект Д3 QA): ошибка по модели —
// 400 до транзакции, а не после фиксации.
Процедура ПроверитьОпцииОтвета(К)
	Опции = К.Маршрут.Опции;
	Если К.Маршрут.Вид = "Действие" Или Опции = Неопределено Или Опции.select = Неопределено И Опции.expand = Неопределено Тогда
		Возврат;
	КонецЕсли;
	OData4_Планировщик.ПланЧтения(К.Модель, К.Набор, Опции, "Сущность");
КонецПроцедуры

// Вид записи набора: «Ссылочный» (справочники, документы, планы, бизнес-процессы, задачи), «Регистр» (независимый
// регистр сведений), «Константа», «НаборДвижений» (набор записей регистра по регистратору, часть 6.4: владелец
// <Вид>_<Регистр>; строки …_RecordType пишутся только в его составе); иной набор или метод — 405 (решение 21).
Функция ВидЗаписи(К)
	Набор = К.Набор;
	Маршрут = К.Маршрут;
	Метод = Маршрут.Метод;
	Ссылочные = СтрРазделить("Справочник,Документ,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета,ПланОбмена,"
		+ "БизнесПроцесс,Задача", ",");
	Если Маршрут.Вид = "Действие" И Метод <> "POST" Тогда
		// Действие выполняется только методом POST (решение 34, дефект Д1 QA): DELETE или PATCH на адрес действия не проводят.
		ЗапретМетода("POST", "Действие " + Маршрут.Действие + " выполняется методом POST, а не " + Метод);
	КонецЕсли;
	Если К.ОбъектМетаданных = Неопределено Тогда
		ТолькоЧтение(К, "");
	ИначеЕсли Ссылочные.Найти(Набор.Вид) <> Неопределено Тогда
		Вид = "Ссылочный";
	ИначеЕсли Набор.Вид = "Константа" Тогда
		Вид = "Константа";
	ИначеЕсли Набор.Вид = "Регистр" И Набор.ВидРегистра = "Сведений" И Не Набор.ПоРегистратору Тогда
		Вид = "Регистр";
	ИначеЕсли Набор.Вид = "НаборЗаписей" Тогда
		Вид = "НаборДвижений";
	ИначеЕсли Набор.Вид = "Регистр" И Набор.Родитель <> "" Тогда
		ТолькоЧтение(К, ": строки движений записываются набором " + Набор.Родитель + " целиком");
	ИначеЕсли Набор.Вид = "Регистр" Тогда
		ТолькоЧтение(К, "");
	ИначеЕсли Набор.Вид = "ТабличнаяЧасть" Тогда
		ТолькоЧтение(К, ": строки табличной части записываются в составе объекта-владельца");
	Иначе
		ТолькоЧтение(К, "");
	КонецЕсли;
	Если Маршрут.Вид = "Действие" Тогда
		Возврат Вид;
	КонецЕсли;
	Если Вид = "Константа" Тогда
		Допустимо = Метод = "PATCH" Или Метод = "PUT";
	ИначеЕсли Маршрут.Вид = "Коллекция" Тогда
		Допустимо = Метод = "POST";
	Иначе
		Допустимо = Метод = "PATCH" Или Метод = "PUT" Или Метод = "DELETE";
	КонецЕсли;
	Если Не Допустимо Тогда
		Если Вид = "Константа" Тогда
			Разрешены = "GET, PATCH, PUT, MERGE, OPTIONS";
		ИначеЕсли Маршрут.Вид = "Коллекция" Тогда
			Разрешены = "GET, POST, OPTIONS";
		Иначе
			Разрешены = "GET, PATCH, PUT, MERGE, DELETE, OPTIONS";
		КонецЕсли;
		ЗапретМетода(Разрешены, "Метод " + Метод + " не применяется к " + ?(Маршрут.Вид = "Коллекция", "набору ", "сущности ")
			+ Набор.Имя);
	КонецЕсли;
	Возврат Вид;
КонецФункции

Процедура ТолькоЧтение(К, Причина)
	OData4_БезопасностьВызов.Контекст().ЗаголовкиОтвета.Вставить("Allow", "GET, OPTIONS");
	OData4_Сервис.ОшибкаOData(405, "MethodNotAllowed", "Набор " + К.Набор.Имя + " только для чтения" + Причина);
КонецПроцедуры

// 405 с заголовком Allow (разрешённые методы ресурса): заголовки контекста запроса добавляются к ответу об ошибке.
Процедура ЗапретМетода(Разрешены, Текст)
	OData4_БезопасностьВызов.Контекст().ЗаголовкиОтвета.Вставить("Allow", Разрешены);
	OData4_Сервис.ОшибкаOData(405, "MethodNotAllowed", Текст);
КонецПроцедуры

Функция ВыполнитьЗапись(К)
	Если К.Маршрут.Вид = "Действие" Тогда
		Возврат OData4_Действия.ВыполнитьДействие(К);
	ИначеЕсли К.Вид = "Константа" Тогда
		Возврат ЗаписатьКонстанту(К);
	ИначеЕсли К.Вид = "НаборДвижений" Тогда
		Если К.Маршрут.Метод = "POST" Тогда
			Возврат СоздатьНаборДвижений(К);
		ИначеЕсли К.Маршрут.Метод = "DELETE" Тогда
			Возврат УдалитьНаборДвижений(К);
		КонецЕсли;
		Возврат ЗаменитьНаборДвижений(К);
	ИначеЕсли К.Вид = "Регистр" Тогда
		Если К.Маршрут.Метод = "POST" Тогда
			Возврат СоздатьЗаписьРегистра(К);
		ИначеЕсли К.Маршрут.Метод = "DELETE" Тогда
			Возврат УдалитьЗаписьРегистра(К);
		КонецЕсли;
		Возврат ИзменитьЗаписьРегистра(К);
	ИначеЕсли К.Маршрут.Метод = "POST" Тогда
		Возврат СоздатьОбъект(К);
	ИначеЕсли К.Маршрут.Метод = "DELETE" Тогда
		Возврат УдалитьОбъект(К);
	КонецЕсли;
	Возврат ИзменитьОбъект(К);
КонецФункции

// Запрос с заголовком Repeatability-Request-ID или Idempotency-Key (OData4_ПовторыЗапросов) выполняется в одной
// транзакции с записью его ответа: повтор с тем же ключом ждёт блокировку ключа и получает сохранённый ответ без
// повторного выполнения. Ответ собирается внутри транзакции записи (ОтветПоКлючу до ЗафиксироватьТранзакцию), поэтому
// сбой сборки ответа откатывает и запись. Без заголовка — ВыполнитьЗапись как есть. Код записи открывает и отменяет
// свои вложенные транзакции; здесь отменяется только своя.
Функция ВыполнитьСПовтором(К)
	Повтор = OData4_ПовторыЗапросов.ОписаниеПовтора(К.Запрос);
	Если Повтор = Неопределено Тогда
		Возврат ВыполнитьЗапись(К);
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Сохранённый = OData4_ПовторыЗапросов.Начать(Повтор);
		Если Сохранённый = Неопределено Тогда
			Ответ = ВыполнитьЗапись(К);
			OData4_ПовторыЗапросов.Запомнить(Повтор, Ответ);
		Иначе
			Ответ = OData4_ПовторыЗапросов.СохранённыйОтвет(Сохранённый);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВосстановитьВызов(К.Вызов);
		ВызватьИсключение;
	КонецПопытки;
	ВосстановитьВызов(К.Вызов);
	OData4_ПовторыЗапросов.ОтметитьОтвет(Повтор, Ответ);
	Возврат Ответ;
КонецФункции

#Область Объекты

Функция СоздатьОбъект(К)
	УстановитьОперацию(К, "Добавление");
	ПроверитьОперацию(К, "Добавление");
	ЕслиНе = ЗначениеЗаголовка(К, "If-None-Match");
	Если К.Настройки.ТребоватьIfMatch И OData4_Сериализация.ЗначенияETag(ЕслиНе).Найти("*") = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(428, "PreconditionRequired", "Создание " + К.Набор.Имя
			+ " требует заголовка If-None-Match: * (настройка «Требовать If-Match»)");
	КонецЕсли;
	Данные = OData4_ЗаписьПоля.ЗначенияСвойств(К.Модель, К.Набор, К.ОбъектМетаданных,
		OData4_ЗаписьПоля.РазобратьТело(К.Запрос), "Создание", Строго(К));
	Если Данные.ПометкаУдаления = Истина Тогда
		ПроверитьОперацию(К, "Удаление");
	КонецЕсли;
	ПроверитьСсылкиТела(К, Данные);
	Менеджер = МенеджерОбъекта(К.ПолноеИмя);
	Ссылка = Неопределено;
	Если Данные.Ключ <> Неопределено Тогда
		ПроверитьКлючПриСоздании(К);
		Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.Ключ));
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		Если Ссылка <> Неопределено Тогда
			// Занятость ключа — в транзакции под блокировкой ключа и среди всех объектов, включая скрытые профилем и RLS
			// (отзыв безопасности, группа B): параллельный POST с тем же ключом ждёт блокировку и получает 409, дубля нет.
			ЗаблокироватьСсылку(К, Ссылка);
			Если СсылкаЗанята(К, Ссылка) Тогда
				ПроверитьВерсию(К, "");
				OData4_Сервис.ОшибкаOData(409, "Conflict", "Объект с переданным ключом уже существует в наборе " + К.Набор.Имя);
			КонецЕсли;
		КонецЕсли;
		Объект = НовыйОбъект(К, Менеджер, Данные.ЭтоГруппа = Истина);
		// Как новый объект в форме 1С и у standard.odata: значения по умолчанию из ОбработкаЗаполнения.
		Объект.Заполнить(Неопределено);
		Если Ссылка <> Неопределено Тогда
			Объект.УстановитьСсылкуНового(Ссылка);
		КонецЕсли;
		Заполнить(Объект, Данные);
		Если Данные.ПометкаУдаления = Истина Тогда
			Объект.ПометкаУдаления = Истина;
		КонецЕсли;
		ЗаписатьОбъект(К, Объект, ?(ЭтоДокумент(К), "Запись", ""));
		Ссылка = Объект.Ссылка;
		ПроверитьВидимость(К, КлючСсылки(Ссылка));
		Ответ = ОтветОбъекта(К, КлючСсылки(Ссылка), 201);
		ЗафиксироватьТранзакцию();
	Исключение
		Информация = ИнформацияОбОшибке();
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Если Данные.Ключ <> Неопределено И СтрНайти(Информация.Описание, "ODATA4|") = 0 И КлючЗанятПослеСбоя(К, Ссылка) Тогда
			// Ключ занял параллельный сеанс, чья блокировка не действовала (автоматический режим блокировок): 409, а не
			// текст платформы о неуникальности.
			ВосстановитьВызов(К.Вызов);
			OData4_Сервис.ОшибкаOData(409, "Conflict", "Объект с переданным ключом уже существует в наборе " + К.Набор.Имя);
		КонецЕсли;
		ПередатьОшибку(К, Информация);
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// Ref_Key при создании (настройка КлючПриСоздании): по умолчанию — только у субъекта, для которого у набора нет
// отборов строк профиля. Иначе 409 на ключ объекта, скрытого отбором, раскрывал бы его существование, а создание без
// проверки занятости дало бы дубль (отзыв безопасности, группа B).
Процедура ПроверитьКлючПриСоздании(К)
	Если К.Описание = Неопределено Или К.Настройки.Свойство("КлючПриСоздании") И К.Настройки.КлючПриСоздании = "Разрешён" Тогда
		Возврат;
	КонецЕсли;
	Параметры = Новый Соответствие;
	Итог = OData4_Безопасность.УсловияНабора(Параметры, К.Набор, "Т");
	Если Итог.Условия.Количество() = 0 И Не Итог.Запрет И Итог.Ошибка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство Ref_Key: ключ нового объекта " + К.Набор.Имя
		+ " задаёт сервис — у набора есть отборы строк профиля (настройка «Ref_Key при создании»)");
КонецПроцедуры

// Объект с этой ссылкой есть в базе, включая скрытые отборами профиля и RLS: запрос без РАЗРЕШЕННЫЕ в
// привилегированном режиме, если он доступен; иначе нарушение прав на скрытую RLS строку тоже значит «занят».
Функция СсылкаЗанята(К, Ссылка)
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 ИСТИНА КАК Найдено ИЗ " + К.ПолноеИмя + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Был = ПривилегированныйРежим();
	Если Не Был Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	Занята = Ложь;
	Попытка
		Занята = Не Запрос.Выполнить().Пустой();
	Исключение
		Информация = ИнформацияОбОшибке();
		Если Не Был Тогда
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
		Если Не OData4_Безопасность.ЭтоНарушениеПрав(Информация) Тогда
			ВызватьИсключение;
		КонецЕсли;
		Возврат Истина;
	КонецПопытки;
	Если Не Был Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	Возврат Занята;
КонецФункции

// Сбой записи нового объекта с переданным ключом: ключ уже занят (проверка вне отменённой транзакции; внутри внешней
// транзакции, например набора изменений $batch, проверить нельзя — Ложь).
Функция КлючЗанятПослеСбоя(К, Ссылка)
	Если Ссылка = Неопределено Или ТранзакцияАктивна() Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат СсылкаЗанята(К, Ссылка);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ИзменитьОбъект(К)
	УстановитьОперацию(К, "Изменение");
	ПроверитьОперацию(К, "Изменение");
	ПроверитьНаличиеУсловия(К);
	Замена = К.Маршрут.Метод = "PUT";
	Данные = OData4_ЗаписьПоля.ЗначенияСвойств(К.Модель, К.Набор, К.ОбъектМетаданных,
		OData4_ЗаписьПоля.РазобратьТело(К.Запрос), ?(Замена, "Замена", "Изменение"), Строго(К));
	// Строки заменяются целиком: скрытые профилем колонки сопоставляются по LineNumber тела (решение 38, дефекты Д2, Д5).
	Скрытые = Новый Соответствие;
	Для Каждого ТЧ Из Данные.ТабличныеЧасти Цикл
		Если ЕстьИсключённыеКолонки(К, ТЧ.Набор) Тогда
			ТЧ.Вставить("НомераСтрок", НомераСтрок(ТЧ));
			Скрытые.Вставить(ТЧ.ИмяТЧ, OData4_ПрофильМодели.ИсключённыеПоляНабора(К.Модель, ТЧ.Набор, К.Описание));
		КонецЕсли;
	КонецЦикла;
	Ссылка = СтрокаСущности(К, К.Маршрут.Ключ).Получить("Ссылка");
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСсылку(К, Ссылка);
		Объект = ОбъектПоСсылке(К, Ссылка);
		ПроверитьВерсию(К, Объект.ВерсияДанных);
		ПроверитьСсылкиТела(К, Данные, Объект);
		Если Замена Тогда
			СброситьНепереданные(К, Объект, Данные);
		КонецЕсли;
		Заполнить(Объект, Данные, Скрытые);
		Пометка = Данные.ПометкаУдаления;
		Если Пометка = Неопределено Тогда
			Пометка = ?(Замена, Ложь, Объект.ПометкаУдаления);
		КонецЕсли;
		Проведён = ЭтоДокумент(К) И Объект.Проведен;
		Если Пометка <> Объект.ПометкаУдаления Тогда
			ПроверитьОперацию(К, "Удаление");
			Объект.ПометкаУдаления = Пометка;
		КонецЕсли;
		Если Проведён И Пометка Тогда
			// Помеченный на удаление документ не проводится: пометка снимает проведение (решение 15).
			ПроверитьОперацию(К, "ОтменаПроведения");
			ЗаписатьОбъект(К, Объект, "ОтменаПроведения");
		ИначеЕсли Проведён Тогда
			// Проведённый документ после изменения перепроводится, как «Записать» в форме 1С (решение 15).
			ПроверитьОперацию(К, "Проведение");
			ЗаписатьОбъект(К, Объект, "Проведение", РежимПроведения(К, Объект));
		Иначе
			ЗаписатьОбъект(К, Объект, ?(ЭтоДокумент(К), "Запись", ""));
		КонецЕсли;
		ПроверитьВидимость(К, КлючСсылки(Ссылка));
		Ответ = ОтветОбъекта(К, КлючСсылки(Ссылка), 200);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьИПередать(К, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция УдалитьОбъект(К)
	Физически = ФизическоеУдаление(К);
	Операция = ?(Физически, "ФизическоеУдаление", "Удаление");
	УстановитьОперацию(К, Операция);
	ПроверитьОперацию(К, Операция);
	Если Физически Тогда
		ПроверитьОперацию(К, "Удаление");
	КонецЕсли;
	ПроверитьНаличиеУсловия(К);
	Строка0 = СтрокаСущности(К, К.Маршрут.Ключ);
	Ссылка = Строка0.Получить("Ссылка");
	// Поиск ссылок (на большой базе — минуты) по умолчанию идёт до транзакции удаления, без исключительной блокировки
	// данных (отзыв безопасности, группа B): объект на это время закрыт от изменения объектной блокировкой, и повторный
	// DELETE того же объекта сразу получает 409, а не запускает второй поиск. Настройка ПоискСсылокПриУдалении =
	// «ВТранзакции» — прежний строгий порядок: поиск под блокировкой в транзакции удаления.
	ДоТранзакции = Физически И ПоискСсылокДоТранзакции(К);
	Замок = Неопределено;
	Если ДоТранзакции Тогда
		ВерсияДо = Строка0.Получить("ВерсияДанных");
		Если ВерсияДо <> Неопределено Тогда
			// Устаревший If-Match отклоняется до долгого поиска.
			ПроверитьВерсию(К, ВерсияДо);
		КонецЕсли;
		Замок = ЗакрытьОтИзменения(К, Ссылка);
		Попытка
			ПроверитьСсылки(К, Ссылка);
		Исключение
			ОткрытьДляИзменения(Ссылка, Замок);
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьСсылку(К, Ссылка);
		Объект = ОбъектПоСсылке(К, Ссылка);
		ПроверитьВерсию(К, Объект.ВерсияДанных);
		Если Физически И Не ДоТранзакции Тогда
			ПроверитьСсылки(К, Ссылка);
		КонецЕсли;
		Объект.ОбменДанными.Загрузка = Ложь;
		Если Физически Тогда
			Объект.Удалить();
		ИначеЕсли Не Объект.ПометкаУдаления Тогда
			Если ЭтоДокумент(К) И Объект.Проведен Тогда
				ПроверитьОперацию(К, "ОтменаПроведения");
			КонецЕсли;
			Объект.УстановитьПометкуУдаления(Истина);
		КонецЕсли;
		ВосстановитьВызов(К.Вызов);
		ЗафиксироватьТранзакцию();
	Исключение
		Информация = ИнформацияОбОшибке();
		ОткрытьДляИзменения(Ссылка, Замок);
		ОтменитьИПередать(К, Информация);
	КонецПопытки;
	ОткрытьДляИзменения(Ссылка, Замок);
	Возврат ОтветБезТела(Новый Соответствие);
КонецФункции

// Настройка «Поиск ссылок при физическом удалении»: до транзакции удаления (по умолчанию) или в ней.
Функция ПоискСсылокДоТранзакции(К)
	Значение = "";
	Возврат Не (К.Настройки.Свойство("ПоискСсылокПриУдалении", Значение) И Значение = "ВТранзакции");
КонецФункции

// Объектная блокировка объекта на время поиска ссылок: другие сеансы не изменят его и не начнут параллельный поиск.
// Занят другим сеансом — 409. Возвращает идентификатор блокировки.
Функция ЗакрытьОтИзменения(К, Ссылка)
	Замок = Новый УникальныйИдентификатор;
	Попытка
		ЗаблокироватьДанныеДляРедактирования(Ссылка, , Замок);
	Исключение
		ЗаписьЖурналаРегистрации("OData4.Запись", УровеньЖурналаРегистрации.Информация, К.ОбъектМетаданных, Ссылка,
			"Физическое удаление: объект занят — " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВосстановитьВызов(К.Вызов);
		OData4_Сервис.ОшибкаOData(409, "Conflict", "Объект " + К.Набор.Имя + " занят другим сеансом");
	КонецПопытки;
	Возврат Замок;
КонецФункции

// Снимает объектную блокировку ЗакрытьОтИзменения (Замок = Неопределено — блокировки не было). Исключений не бросает.
Процедура ОткрытьДляИзменения(Ссылка, Замок)
	Если Замок = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		РазблокироватьДанныеДляРедактирования(Ссылка, Замок);
	Исключение
		// Блокировка снимется с окончанием сеанса.
	КонецПопытки;
КонецПроцедуры

// Физическое удаление (решение 13): только при настройке РазрешитьФизическоеУдаление и праве 1С «Удаление»; у субъекта
// с профилем — ещё и при праве профиля «ФизическоеУдаление». Иначе — пометка удаления.
Функция ФизическоеУдаление(К)
	Если Не К.Настройки.РазрешитьФизическоеУдаление Или Не ПравоДоступа("Удаление", К.ОбъектМетаданных) Тогда
		Возврат Ложь;
	КонецЕсли;
	// Профиль: «Физическое удаление» — сильнее «Удаления» и без него не действует (решение 36, наблюдение Н3 QA).
	Возврат К.Описание = Неопределено Или OData4_Профили.Разрешено(К.Описание, К.ПолноеИмя, "ФизическоеУдаление")
		И OData4_Профили.Разрешено(К.Описание, К.ПолноеИмя, "Удаление");
КонецФункции

// Физическое удаление не оставляет ссылок на удалённый объект (решение 30, решение контроллера): программное Удалить()
// ссылочную целостность не проверяет. Ссылки других объектов (НайтиПоСсылкам) есть — 409, подробности (число и все
// виды) — в журнал регистрации; объект не удаляется. Ссылки объекта на самого себя (реквизиты, табличные части) не
// считаются. Клиенту (отзыв безопасности, группа B) — только виды, которые он может читать: право 1С «Чтение» и, у
// субъекта с профилем, право профиля «Чтение»; число ссылающихся объектов — только субъекту без профиля.
Процедура ПроверитьСсылки(К, Ссылка)
	Список = Новый Массив;
	Список.Добавить(Ссылка);
	Найденные = НайтиПоСсылкам(Список);
	Ссылающиеся = Новый Соответствие;
	Виды = Новый Массив;
	ВидимыеВиды = Новый Массив;
	Для Каждого Найденная Из Найденные Цикл
		Если Найденная.Данные = Ссылка Или Ссылающиеся.Получить(Найденная.Данные) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Ссылающиеся.Вставить(Найденная.Данные, Истина);
		ИмяВида = ?(Найденная.Метаданные = Неопределено, "", Найденная.Метаданные.ПолноеИмя());
		Если ИмяВида <> "" И Виды.Найти(ИмяВида) = Неопределено Тогда
			Виды.Добавить(ИмяВида);
			Если ВидВиден(К, Найденная.Метаданные) Тогда
				ВидимыеВиды.Добавить(ИмяВида);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если Ссылающиеся.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ЗаписьЖурналаРегистрации("OData4.Запись", УровеньЖурналаРегистрации.Информация, К.ОбъектМетаданных, Ссылка,
		"Физическое удаление отклонено: ссылающихся объектов " + Формат(Ссылающиеся.Количество(), "ЧГ=0") + " ("
		+ СтрСоединить(Виды, ", ") + ")");
	ВосстановитьВызов(К.Вызов);
	Текст = "Объект " + К.Набор.Имя + "(" + ТекстКлючаМаршрута(К) + ") не удалён физически: на него ссылаются "
		+ ?(ВидимыеВиды.Количество() = 0, "другие объекты", "объекты");
	Если К.Описание = Неопределено Тогда
		Текст = Текст + " (" + Формат(Ссылающиеся.Количество(), "ЧГ=0") + ")";
	КонецЕсли;
	Если ВидимыеВиды.Количество() > 0 Тогда
		Текст = Текст + ": " + СтрСоединить(ВидимыеВиды, ", ");
	КонецЕсли;
	OData4_Сервис.ОшибкаOData(409, "Conflict", Текст);
КонецПроцедуры

// Вид ссылающихся объектов можно назвать клиенту: у пользователя 1С есть право «Чтение» (в привилегированном режиме —
// всегда), у субъекта с профилем профиль разрешает чтение вида.
Функция ВидВиден(К, ОбъектМетаданных)
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не ПривилегированныйРежим() И Не ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат К.Описание = Неопределено Или OData4_Профили.Разрешено(К.Описание, ОбъектМетаданных.ПолноеИмя(), "Чтение");
КонецФункции

// Номера строк тела табличной части со скрытыми колонками (решение 38): LineNumber — целое ≥ 1 числом или строкой
// (как пишет standard.odata), иначе 400; повтор номера — 400 (скрытые значения одной строки не размножаются).
// Массив по строкам тела: число или Неопределено (номера нет).
Функция НомераСтрок(ТЧ)
	Результат = Новый Массив;
	Встречены = Новый Соответствие;
	Для Индекс = 0 По ТЧ.Номера.ВГраница() Цикл
		Значение = ТЧ.Номера[Индекс];
		Место = ТЧ.Имя + "[" + Формат(Индекс, "ЧН=0; ЧГ=0") + "]/LineNumber";
		Если Значение = Неопределено Тогда
			Результат.Добавить(Неопределено);
			Продолжить;
		КонецЕсли;
		Номер = Неопределено;
		Если ТипЗнч(Значение) = Тип("Число") Тогда
			Номер = Значение;
		ИначеЕсли ТипЗнч(Значение) = Тип("Строка") И ЭтоНатуральноеЧисло(Значение) Тогда
			Номер = Число(Значение);
		КонецЕсли;
		Если Номер = Неопределено Или Номер < 1 Или Номер <> Цел(Номер) Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство " + Место + ": ожидается номер строки (целое ≥ 1)");
		КонецЕсли;
		Если Встречены.Получить(Номер) <> Неопределено Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство " + Место + ": номер строки " + Формат(Номер, "ЧГ=0")
				+ " повторяется");
		КонецЕсли;
		Встречены.Вставить(Номер, Истина);
		Результат.Добавить(Номер);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// У всех строк тела нет LineNumber.
Функция НетНомеров(Номера)
	Для Каждого Номер Из Номера Цикл
		Если Номер <> Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЭтоНатуральноеЧисло(Текст)
	Если Текст = "" Или СтрДлина(Текст) > 9 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// У набора табличной части профиль исключает поля (решение 38).
Функция ЕстьИсключённыеКолонки(К, НаборТЧ)
	Возврат К.Описание <> Неопределено
		И OData4_ПрофильМодели.ИсключённыеПоляНабора(К.Модель, НаборТЧ, К.Описание).Количество() > 0;
КонецФункции

Функция НовыйОбъект(К, Менеджер, ЭтоГруппа)
	Вид = Лев(К.ПолноеИмя, СтрНайти(К.ПолноеИмя, ".") - 1);
	Если Вид = "Справочник" Или Вид = "ПланВидовХарактеристик" Тогда
		Возврат ?(ЭтоГруппа, Менеджер.СоздатьГруппу(), Менеджер.СоздатьЭлемент());
	ИначеЕсли ЭтоГруппа Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство IsFolder: у " + К.Набор.Имя + " нет групп");
	ИначеЕсли Вид = "Документ" Тогда
		Возврат Менеджер.СоздатьДокумент();
	ИначеЕсли Вид = "ПланСчетов" Тогда
		Возврат Менеджер.СоздатьСчет();
	ИначеЕсли Вид = "ПланВидовРасчета" Тогда
		Возврат Менеджер.СоздатьВидРасчета();
	ИначеЕсли Вид = "ПланОбмена" Тогда
		Возврат Менеджер.СоздатьУзел();
	ИначеЕсли Вид = "БизнесПроцесс" Тогда
		Возврат Менеджер.СоздатьБизнесПроцесс();
	КонецЕсли;
	Возврат Менеджер.СоздатьЗадачу();
КонецФункции

Функция ОбъектПоСсылке(К, Ссылка)
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Объект не найден: " + К.Набор.Имя + "(" + ТекстКлючаМаршрута(К) + ")");
	КонецЕсли;
	Возврат Объект;
КонецФункции

// Поля и табличные части тела в объект (или запись набора записей): табличная часть заменяется целиком.
Процедура Заполнить(Объект, Данные, Скрытые = Неопределено)
	Для Каждого Поле Из Данные.Поля Цикл
		Объект[Поле.Поле] = Поле.Значение;
	КонецЦикла;
	Для Каждого ТЧ Из Данные.ТабличныеЧасти Цикл
		Таблица = Объект[ТЧ.ИмяТЧ];
		// Скрытые профилем колонки (Соответствие «поле → Истина») берутся у прежней строки с номером LineNumber строки тела
		// (решение 38): нет номера или такой строки не было — пустые значения.
		Поля = ?(Скрытые = Неопределено, Неопределено, Скрытые.Получить(ТЧ.ИмяТЧ));
		Прежние = Новый Соответствие;
		Если Поля <> Неопределено Тогда
			Если Таблица.Количество() > 0 И ТЧ.Строки.Количество() > 0 И НетНомеров(ТЧ.НомераСтрок) Тогда
				// Ни одна строка тела не несёт LineNumber: сопоставить скрытые значения нельзя, а пустые стёрли бы их (решение 38).
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "Табличная часть " + ТЧ.Имя
					+ " содержит скрытые профилем колонки: передайте LineNumber строк");
			КонецЕсли;
			Для Каждого Прежняя Из Таблица Цикл
				Значения = Новый Соответствие;
				Для Каждого КлючИЗначение Из Поля Цикл
					Значения.Вставить(КлючИЗначение.Ключ, Прежняя[КлючИЗначение.Ключ]);
				КонецЦикла;
				Прежние.Вставить(Прежняя.НомерСтроки, Значения);
			КонецЦикла;
		КонецЕсли;
		Таблица.Очистить();
		Номер = 0;
		Для Каждого ПоляСтроки Из ТЧ.Строки Цикл
			НоваяСтрока = Таблица.Добавить();
			Для Каждого Поле Из ПоляСтроки Цикл
				НоваяСтрока[Поле.Поле] = Поле.Значение;
			КонецЦикла;
			Значения = Неопределено;
			Если Поля <> Неопределено И ТЧ.НомераСтрок[Номер] <> Неопределено Тогда
				Значения = Прежние.Получить(ТЧ.НомераСтрок[Номер]);
			КонецЕсли;
			Если Значения <> Неопределено Тогда
				Для Каждого КлючИЗначение Из Значения Цикл
					НоваяСтрока[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
				КонецЦикла;
			КонецЕсли;
			Номер = Номер + 1;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// PUT (решение 11): непереданные записываемые поля набора профиля — пустые значения своего типа, непереданные табличные
// части очищаются. Поля ключа не трогаются. Поле, которое у группы не используется, пропускается.
Процедура СброситьНепереданные(К, Объект, Данные)
	Для Каждого Свойство Из К.Набор.Свойства Цикл
		Если Свойство.ВКлюче Или Не OData4_ЗаписьПоля.ПолеЗаписывается(Свойство)
			Или Данные.Переданные.Получить(Свойство.Поле) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеТипов = OData4_ЗаписьПоля.ОписаниеТиповПоля(К.ОбъектМетаданных, "", Свойство.Поле);
		Попытка
			Объект[Свойство.Поле] = ?(ОписаниеТипов = Неопределено, Неопределено, ОписаниеТипов.ПривестиЗначение(Неопределено));
		Исключение
			// Реквизит не используется у этого объекта (например, у группы справочника) — сбрасывать нечего.
		КонецПопытки;
	КонецЦикла;
	Для Каждого ИмяНабораТЧ Из К.Набор.ТабличныеЧасти Цикл
		НаборТЧ = OData4_Безопасность.НаборМодели(К.Модель, ИмяНабораТЧ);
		Если НаборТЧ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Части = СтрРазделить(НаборТЧ.ТаблицаЗапроса, ".");
		ИмяТЧ = Части[Части.ВГраница()];
		Если Данные.Переданные.Получить(ИмяТЧ) = Неопределено И Не ЕстьИсключённыеКолонки(К, НаборТЧ) Тогда
			Объект[ИмяТЧ].Очистить();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область НаборыДвижений

// Наборы записей регистров по регистратору (часть 6.4, как standard.odata): набор пишется только целиком. POST
// коллекции <Вид>_<Регистр> — новый набор (непустой — 409), PATCH/MERGE/PUT по ключу регистратора — замена набора
// строками тела (PUT без RecordSet — пустой набор), DELETE — очистка. Регистратор — документ, в движения которого
// входит регистр (иначе 400), существует и виден профилю (иначе 404). Всё — по метаданным регистра.

Функция СоздатьНаборДвижений(К)
	УстановитьОперацию(К, "Добавление");
	ПроверитьОперацию(К, "Добавление");
	ЕслиНе = ЗначениеЗаголовка(К, "If-None-Match");
	Если К.Настройки.ТребоватьIfMatch И OData4_Сериализация.ЗначенияETag(ЕслиНе).Найти("*") = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(428, "PreconditionRequired", "Создание " + К.Набор.Имя
			+ " требует заголовка If-None-Match: * (настройка «Требовать If-Match»)");
	КонецЕсли;
	Данные = ДанныеНабораДвижений(К, "Создание");
	Регистратор = Неопределено;
	Для Каждого Поле Из Данные.Поля Цикл
		Если Поле.Поле = "Регистратор" Тогда
			Регистратор = Поле.Значение;
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Регистратор) Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Набор " + К.Набор.Имя + ": не задан регистратор (Recorder)");
	КонецЕсли;
	ПроверитьРегистратор(К, Регистратор);
	ПроверитьСсылкиТела(К, Данные);
	ЗначенияКлюча = Новый Соответствие;
	ЗначенияКлюча.Вставить("Регистратор", Регистратор);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНаборДвижений(К, Регистратор);
		Записи = НаборДвижений(К, Регистратор);
		Если Записи.Количество() > 0 Тогда
			ПроверитьВерсию(К, "");
			OData4_Сервис.ОшибкаOData(409, "Conflict", "Набор движений уже есть: " + К.Набор.Имя + "("
				+ ТекстКлюча(К, ЗначенияКлюча, Ложь) + ")");
		КонецЕсли;
		ЗаполнитьДвижения(Записи, Данные);
		ЗаписатьНабор(К, Записи);
		ПроверитьВидимость(К, КлючЗаписи(К, ЗначенияКлюча));
		Ответ = ОтветНабораДвижений(К, ЗначенияКлюча, Данные, 201);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьИПередать(К, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция ЗаменитьНаборДвижений(К)
	УстановитьОперацию(К, "Изменение");
	ПроверитьОперацию(К, "Изменение");
	ПроверитьНаличиеУсловия(К);
	Замена = К.Маршрут.Метод = "PUT";
	Данные = ДанныеНабораДвижений(К, ?(Замена, "Замена", "Изменение"));
	ЗначенияКлюча = ЗначенияКлючаИзСтроки(К, СтрокаСущности(К, К.Маршрут.Ключ));
	Регистратор = ЗначенияКлюча.Получить("Регистратор");
	Для Каждого Поле Из Данные.Поля Цикл
		Если Поле.Поле = "Регистратор" И Поле.Значение <> Регистратор Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство " + Поле.Свойство.Имя
				+ ": регистратор набора задаёт ключ адреса и не меняется");
		КонецЕсли;
	КонецЦикла;
	ПроверитьРегистратор(К, Регистратор);
	Если Не Замена И Данные.ТабличныеЧасти.Количество() = 0 Тогда
		// PATCH без RecordSet: набор не меняется.
		Возврат ОтветНабораДвижений(К, ЗначенияКлюча, Неопределено, 200);
	КонецЕсли;
	// Строки заменяются целиком: скрытые профилем колонки регистра сопоставляются по LineNumber тела, как у табличных
	// частей (решение 38; отзыв безопасности, группа B).
	Скрытые = СкрытыеКолонкиДвижений(К, Данные);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНаборДвижений(К, Регистратор);
		ПроверитьВерсию(К, "");
		Записи = НаборДвижений(К, Регистратор);
		ПроверитьСсылкиТела(К, Данные, Записи);
		Прежние = СкрытыеЗначенияДвижений(К, Записи, Данные, Скрытые);
		Записи.Очистить();
		ЗаполнитьДвижения(Записи, Данные, Прежние);
		ЗаписатьНабор(К, Записи);
		Если Записи.Количество() > 0 Тогда
			ПроверитьВидимость(К, КлючЗаписи(К, ЗначенияКлюча));
		КонецЕсли;
		Ответ = ОтветНабораДвижений(К, ЗначенияКлюча, Данные, 200);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьИПередать(К, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// Что переносится из прежних строк набора движений при замене (решение 38 и отзыв безопасности, группа B): Структура
// «Поля (Соответствие поле 1С → Истина — скрытые профилем колонки), Субконто (Истина — субконто регистра бухгалтерии,
// настройка «Сохранять субконто при изменении наборов движений» при выключенной «Субконто в строках регистров
// бухгалтерии»)» или Неопределено — переносить нечего (или набор заменяется пустым, PUT без RecordSet). У строк тела
// разбираются номера LineNumber (ТЧ.НомераСтрок).
Функция СкрытыеКолонкиДвижений(К, Данные)
	Если Данные.ТабличныеЧасти.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТЧ = Данные.ТабличныеЧасти[0];
	Если ТЧ.Набор = Неопределено Или ТЧ.Строки.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Поля = ?(К.Описание = Неопределено, Новый Соответствие,
		OData4_ПрофильМодели.ИсключённыеПоляНабора(К.Модель, ТЧ.Набор, К.Описание));
	Субконто = СохранятьСубконто(К);
	Если Поля.Количество() = 0 И Не Субконто Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТЧ.Вставить("НомераСтрок", НомераСтрок(ТЧ));
	Возврат Новый Структура("Поля, Субконто", Поля, Субконто);
КонецФункции

// Субконто прежних строк сохраняются: регистр бухгалтерии, флажок СохранятьСубконтоНаборов включён, а субконто в
// строках тела нет (настройка СубконтоВНаборахЗаписей выключена — с ней субконто пишет сам клиент).
Функция СохранятьСубконто(К)
	Флажок = Ложь;
	ВСтроках = Ложь;
	Возврат К.Набор.ВидРегистра = "Бухгалтерии" И К.Настройки.Свойство("СохранятьСубконтоНаборов", Флажок) И Флажок = Истина
		И Не (К.Настройки.Свойство("СубконтоВНаборахЗаписей", ВСтроках) И ВСтроках = Истина);
КонецФункции

// Значения переносимых колонок прежних строк набора (до очистки): Соответствие НомерСтроки → Соответствие поле →
// значение (субконто — под ключом «#Субконто»: Соответствие имя коллекции «СубконтоДт», «СубконтоКт» или «Субконто» →
// Соответствие вид субконто → значение); Неопределено — переносить нечего. Ни одна строка тела не несёт LineNumber, а
// прежние строки есть — 400: сопоставить нельзя, а пустые значения стёрли бы прежние.
Функция СкрытыеЗначенияДвижений(К, Записи, Данные, Скрытые)
	Если Скрытые = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТЧ = Данные.ТабличныеЧасти[0];
	Если Записи.Количество() > 0 И НетНомеров(ТЧ.НомераСтрок) Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Набор движений " + К.Набор.Имя
			+ ?(Скрытые.Поля.Количество() > 0, " содержит скрытые профилем колонки",
			" сохраняет субконто прежних строк (настройка «Сохранять субконто при изменении наборов движений»)")
			+ ": передайте LineNumber строк " + ТЧ.Имя);
	КонецЕсли;
	Прежние = Новый Соответствие;
	Для Каждого Запись Из Записи Цикл
		Значения = Новый Соответствие;
		Для Каждого КлючИЗначение Из Скрытые.Поля Цикл
			Попытка
				Значения.Вставить(КлючИЗначение.Ключ, Запись[КлючИЗначение.Ключ]);
			Исключение
				// Поле не хранится в записи (исключено по имени, которого у регистра нет) — переносить нечего.
			КонецПопытки;
		КонецЦикла;
		Если Скрытые.Субконто Тогда
			Значения.Вставить("#Субконто", СубконтоЗаписи(Запись));
		КонецЕсли;
		Прежние.Вставить(Запись.НомерСтроки, Значения);
	КонецЦикла;
	Возврат Прежние;
КонецФункции

// Субконто записи регистра бухгалтерии: Соответствие имя коллекции → Соответствие вид субконто → значение (коллекции,
// которых у регистра нет, пропускаются).
Функция СубконтоЗаписи(Запись)
	Результат = Новый Соответствие;
	Для Каждого ИмяКоллекции Из СтрРазделить("СубконтоДт,СубконтоКт,Субконто", ",") Цикл
		Коллекция = Неопределено;
		Попытка
			Коллекция = Запись[ИмяКоллекции];
		Исключение
			Продолжить;
		КонецПопытки;
		Значения = Новый Соответствие;
		Для Каждого КлючИЗначение Из Коллекция Цикл
			Значения.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Результат.Вставить(ИмяКоллекции, Значения);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Переносит прежние субконто в новую запись: только виды субконто, которые ведёт новый счёт строки (СчетДт, СчетКт или
// Счет); вид, которого у счёта нет, пропускается.
Процедура ПеренестиСубконто(Запись, Субконто)
	Для Каждого КлючИЗначение Из Субконто Цикл
		Суффикс = Сред(КлючИЗначение.Ключ, СтрДлина("Субконто") + 1);
		Счет = Неопределено;
		Попытка
			Счет = Запись["Счет" + Суффикс];
		Исключение
			Продолжить;
		КонецПопытки;
		Если Не ЗначениеЗаполнено(Счет) Тогда
			Продолжить;
		КонецЕсли;
		Виды = Счет.ВидыСубконто;
		Для Каждого Пара Из КлючИЗначение.Значение Цикл
			Если Виды.Найти(Пара.Ключ, "ВидСубконто") <> Неопределено Тогда
				Запись[КлючИЗначение.Ключ][Пара.Ключ] = Пара.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция УдалитьНаборДвижений(К)
	УстановитьОперацию(К, "Удаление");
	ПроверитьОперацию(К, "Удаление");
	ПроверитьНаличиеУсловия(К);
	ЗначенияКлюча = ЗначенияКлючаИзСтроки(К, СтрокаСущности(К, К.Маршрут.Ключ));
	Регистратор = ЗначенияКлюча.Получить("Регистратор");
	ПроверитьРегистратор(К, Регистратор);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьНаборДвижений(К, Регистратор);
		ПроверитьВерсию(К, "");
		Записи = НаборДвижений(К, Регистратор);
		Записи.Очистить();
		Записи.ОбменДанными.Загрузка = Ложь;
		Записи.Записать(Истина);
		ВосстановитьВызов(К.Вызов);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьИПередать(К, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат ОтветБезТела(Новый Соответствие);
КонецФункции

// Свойства тела владельца (Recorder) и строки RecordSet (поля регистра; LineNumber и регистратор строки не пишутся).
Функция ДанныеНабораДвижений(К, Вид)
	Данные = OData4_ЗаписьПоля.ЗначенияСвойств(К.Модель, К.Набор, К.ОбъектМетаданных,
		OData4_ЗаписьПоля.РазобратьТело(К.Запрос), Вид, Строго(К));
	Если Вид = "Замена" И Данные.ТабличныеЧасти.Количество() = 0 Тогда
		// PUT заменяет сущность целиком: без RecordSet набор пуст.
		Данные.ТабличныеЧасти.Добавить(Новый Структура("Имя, ИмяТЧ, Набор, Строки, Номера", "RecordSet", "", Неопределено,
			Новый Массив, Новый Массив));
	КонецЕсли;
	Возврат Данные;
КонецФункции

// Регистратор набора: тип — документ, в движения которого входит регистр (по метаданным), иначе 400; документ
// существует и виден профилю (его набор и отборы строк), иначе 404.
Процедура ПроверитьРегистратор(К, Регистратор)
	ТипРегистратора = ТипЗнч(Регистратор);
	Если Не К.ОбъектМетаданных.СтандартныеРеквизиты.Регистратор.Тип.СодержитТип(ТипРегистратора) Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Регистратор " + Строка(ТипРегистратора)
			+ " не пишет движения в " + К.ПолноеИмя);
	КонецЕсли;
	МетаДокумента = Метаданные.НайтиПоТипу(ТипРегистратора);
	ИмяНабора = OData4_Модель.ИмяНабора(МетаДокумента);
	НаборДокумента = ?(ИмяНабора = "", Неопределено, OData4_Безопасность.НаборМодели(К.Модель, ИмяНабора));
	Ключ = Новый Массив;
	Ключ.Добавить(Новый Структура("Имя, Текст", "Ref_Key", "guid'" + XMLСтрока(Регистратор) + "'"));
	Если НаборДокумента = Неопределено Или OData4_Чтение.СтрокаСущности(К.Модель, НаборДокумента, Ключ) = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Регистратор не найден: " + ?(ИмяНабора = "", Строка(ТипРегистратора),
			ИмяНабора) + "(guid'" + XMLСтрока(Регистратор) + "')");
	КонецЕсли;
КонецПроцедуры

// Набор записей регистра по регистратору, прочитанный; менеджер — по виду регистра модели.
Функция НаборДвижений(К, Регистратор)
	Менеджеры = Новый Соответствие;
	Менеджеры.Вставить("Накопления", РегистрыНакопления);
	Менеджеры.Вставить("Бухгалтерии", РегистрыБухгалтерии);
	Менеджеры.Вставить("Расчета", РегистрыРасчета);
	Менеджеры.Вставить("Сведений", РегистрыСведений);
	Записи = Менеджеры.Получить(К.Набор.ВидРегистра)[К.ОбъектМетаданных.Имя].СоздатьНаборЗаписей();
	Записи.Отбор.Регистратор.Установить(Регистратор);
	Записи.Прочитать();
	Возврат Записи;
КонецФункции

// Исключительная блокировка набора записей по регистратору: пространство «<ПолноеИмя>.НаборЗаписей», поле Регистратор.
Процедура ЗаблокироватьНаборДвижений(К, Регистратор)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(К.ПолноеИмя + ".НаборЗаписей");
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Элемент.УстановитьЗначение("Регистратор", Регистратор);
	Блокировка.Заблокировать();
КонецПроцедуры

// Строки RecordSet тела — в набор по порядку. Субконто строки регистра бухгалтерии (поле «Субконто[Дт|Кт]K», настройка
// 6.4) пишется после счетов: K-е значение — K-му виду субконто счёта строки; у счёта меньше K видов — 400. Прежние
// (СкрытыеЗначенияДвижений) — значения скрытых профилем колонок по номеру строки: строка тела с LineNumber N получает
// их от прежней строки N; без номера или без такой строки — пустые.
Процедура ЗаполнитьДвижения(Записи, Данные, Прежние = Неопределено)
	Для Каждого ТЧ Из Данные.ТабличныеЧасти Цикл
		Номера = Неопределено;
		Если Прежние <> Неопределено Тогда
			ТЧ.Свойство("НомераСтрок", Номера);
		КонецЕсли;
		Номер = 0;
		Для Каждого ПоляСтроки Из ТЧ.Строки Цикл
			Запись = Записи.Добавить();
			Субконто = Новый Массив;
			Для Каждого Поле Из ПоляСтроки Цикл
				Если СтрНачинаетсяС(Поле.Поле, "Субконто") Тогда
					Субконто.Добавить(Поле);
				Иначе
					Запись[Поле.Поле] = Поле.Значение;
				КонецЕсли;
			КонецЦикла;
			Значения = Неопределено;
			Если Номера <> Неопределено И Номера[Номер] <> Неопределено Тогда
				Значения = Прежние.Получить(Номера[Номер]);
			КонецЕсли;
			Если Значения <> Неопределено Тогда
				Для Каждого КлючИЗначение Из Значения Цикл
					Если КлючИЗначение.Ключ <> "#Субконто" Тогда
						Запись[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
					КонецЕсли;
				КонецЦикла;
				// Субконто — после счетов строки (в том числе скрытых): переносятся только виды, которые ведёт счёт.
				Если Значения.Получить("#Субконто") <> Неопределено Тогда
					ПеренестиСубконто(Запись, Значения.Получить("#Субконто"));
				КонецЕсли;
			КонецЕсли;
			Для Каждого Поле Из Субконто Цикл
				ЗаполнитьСубконто(Запись, Поле);
			КонецЦикла;
			Номер = Номер + 1;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Поле «СубконтоДтK», «СубконтоКтK» или «СубконтоK»: значение K-го вида субконто счёта СчетДт, СчетКт или Счет строки.
Процедура ЗаполнитьСубконто(Запись, Поле)
	Хвост = Сред(Поле.Поле, СтрДлина("Субконто") + 1);
	Суффикс = "";
	Если СтрНачинаетсяС(Хвост, "Дт") Или СтрНачинаетсяС(Хвост, "Кт") Тогда
		Суффикс = Лев(Хвост, 2);
		Хвост = Сред(Хвост, 3);
	КонецЕсли;
	Номер = Число(Хвост);
	Счет = Запись["Счет" + Суффикс];
	ВидыСубконто = ?(ЗначениеЗаполнено(Счет), Счет.ВидыСубконто, Неопределено);
	Если ВидыСубконто = Неопределено Или ВидыСубконто.Количество() < Номер Тогда
		Если ЗначениеЗаполнено(Поле.Значение) Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство " + Поле.Свойство.Имя + ": у счета «"
				+ Строка(Счет) + "» нет субконто " + Хвост);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Запись["Субконто" + Суффикс][ВидыСубконто[Номер - 1].ВидСубконто] = Поле.Значение;
КонецПроцедуры

// Ответ записи набора: набор прежним чтением; набор пуст после записи (очищен PUT/PATCH пустым RecordSet) — 204.
Функция ОтветНабораДвижений(К, ЗначенияКлюча, Данные, Статус)
	Если Данные <> Неопределено И Данные.ТабличныеЧасти.Количество() > 0
		И Данные.ТабличныеЧасти[0].Строки.Количество() = 0 Тогда
		Возврат ОтветБезТела(Новый Соответствие);
	КонецЕсли;
	Возврат ОтветЗаписи(К, ЗначенияКлюча, Статус);
КонецФункции

#КонецОбласти

#Область Регистры

// Независимый регистр сведений: POST — новая запись (ключ занят — 409, с If-None-Match: * — 412).
Функция СоздатьЗаписьРегистра(К)
	УстановитьОперацию(К, "Добавление");
	ПроверитьОперацию(К, "Добавление");
	ЕслиНе = ЗначениеЗаголовка(К, "If-None-Match");
	Если К.Настройки.ТребоватьIfMatch И OData4_Сериализация.ЗначенияETag(ЕслиНе).Найти("*") = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(428, "PreconditionRequired", "Создание " + К.Набор.Имя
			+ " требует заголовка If-None-Match: * (настройка «Требовать If-Match»)");
	КонецЕсли;
	Данные = OData4_ЗаписьПоля.ЗначенияСвойств(К.Модель, К.Набор, К.ОбъектМетаданных,
		OData4_ЗаписьПоля.РазобратьТело(К.Запрос), "Создание", Строго(К));
	ЗначенияКлюча = ЗначенияКлючаИзДанных(К, Данные);
	ПроверитьСсылкиТела(К, Данные);
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьЗапись(К, ЗначенияКлюча);
		Записи = НаборЗаписей(К, ЗначенияКлюча);
		Если Записи.Количество() > 0 Тогда
			ПроверитьВерсию(К, "");
			OData4_Сервис.ОшибкаOData(409, "Conflict", "Запись уже существует: " + К.Набор.Имя + "("
				+ ТекстКлюча(К, ЗначенияКлюча, Ложь) + ")");
		КонецЕсли;
		Запись = Записи.Добавить();
		Для Каждого КлючИЗначение Из ЗначенияКлюча Цикл
			Запись[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
		КонецЦикла;
		Заполнить(Запись, Данные);
		ЗаписатьНабор(К, Записи);
		ПроверитьВидимость(К, КлючЗаписи(К, ЗначенияКлюча));
		Ответ = ОтветЗаписи(К, ЗначенияКлюча, 201);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьИПередать(К, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// PATCH и PUT записи регистра по ключу адреса; измерение или период в теле, отличные от ключа, — 400 (решение 12).
Функция ИзменитьЗаписьРегистра(К)
	УстановитьОперацию(К, "Изменение");
	ПроверитьОперацию(К, "Изменение");
	ПроверитьНаличиеУсловия(К);
	Замена = К.Маршрут.Метод = "PUT";
	Данные = OData4_ЗаписьПоля.ЗначенияСвойств(К.Модель, К.Набор, К.ОбъектМетаданных,
		OData4_ЗаписьПоля.РазобратьТело(К.Запрос), ?(Замена, "Замена", "Изменение"), Строго(К));
	ЗначенияКлюча = ЗначенияКлючаИзСтроки(К, СтрокаСущности(К, К.Маршрут.Ключ));
	ИзменяемыеПоля = Новый Массив;
	Для Каждого Поле Из Данные.Поля Цикл
		Если Поле.Свойство.ВКлюче Тогда
			Если ЗначенияКлюча.Получить(Поле.Поле) <> Поле.Значение Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство " + Поле.Свойство.Имя
					+ ": ключ записи регистра не меняется");
			КонецЕсли;
		Иначе
			ИзменяемыеПоля.Добавить(Поле);
		КонецЕсли;
	КонецЦикла;
	Данные.Поля = ИзменяемыеПоля;
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьЗапись(К, ЗначенияКлюча);
		ПроверитьВерсию(К, "");
		Записи = НаборЗаписей(К, ЗначенияКлюча);
		Если Записи.Количество() <> 1 Тогда
			OData4_Сервис.ОшибкаOData(404, "NotFound", "Объект не найден: " + К.Набор.Имя + "(" + ТекстКлючаМаршрута(К) + ")");
		КонецЕсли;
		Запись = Записи[0];
		ПроверитьСсылкиТела(К, Данные, Запись);
		Если Замена Тогда
			СброситьНепереданные(К, Запись, Данные);
		КонецЕсли;
		Заполнить(Запись, Данные);
		ЗаписатьНабор(К, Записи);
		ПроверитьВидимость(К, КлючЗаписи(К, ЗначенияКлюча));
		Ответ = ОтветЗаписи(К, ЗначенияКлюча, 200);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьИПередать(К, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// DELETE записи регистра: пометки удаления у записи нет — запись удаляется (операция профиля «Удаление», решение 13).
Функция УдалитьЗаписьРегистра(К)
	УстановитьОперацию(К, "Удаление");
	ПроверитьОперацию(К, "Удаление");
	ПроверитьНаличиеУсловия(К);
	ЗначенияКлюча = ЗначенияКлючаИзСтроки(К, СтрокаСущности(К, К.Маршрут.Ключ));
	НачатьТранзакцию();
	Попытка
		ЗаблокироватьЗапись(К, ЗначенияКлюча);
		ПроверитьВерсию(К, "");
		Записи = НаборЗаписей(К, ЗначенияКлюча);
		Записи.Очистить();
		Записи.ОбменДанными.Загрузка = Ложь;
		Записи.Записать(Истина);
		ВосстановитьВызов(К.Вызов);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьИПередать(К, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат ОтветБезТела(Новый Соответствие);
КонецФункции

// Значения полей ключа записи (период, измерения, общие реквизиты-разделители): Соответствие «поле 1С → значение».
// Не переданные в теле — пустые значения своего типа.
Функция ЗначенияКлючаИзДанных(К, Данные)
	Переданные = Новый Соответствие;
	Для Каждого Поле Из Данные.Поля Цикл
		Переданные.Вставить(Поле.Поле, Поле.Значение);
	КонецЦикла;
	Результат = Новый Соответствие;
	Для Каждого Свойство Из К.Набор.ПоляКлюча Цикл
		Если Свойство.Поле = "" Тогда
			Продолжить;
		КонецЕсли;
		Если Переданные.Получить(Свойство.Поле) <> Неопределено Или Данные.Переданные.Получить(Свойство.Поле) <> Неопределено Тогда
			Результат.Вставить(Свойство.Поле, Переданные.Получить(Свойство.Поле));
		Иначе
			ОписаниеТипов = OData4_ЗаписьПоля.ОписаниеТиповПоля(К.ОбъектМетаданных, "", Свойство.Поле);
			Результат.Вставить(Свойство.Поле, ?(ОписаниеТипов = Неопределено, Неопределено,
				ОписаниеТипов.ПривестиЗначение(Неопределено)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗначенияКлючаИзСтроки(К, Строка0)
	Результат = Новый Соответствие;
	Для Каждого Свойство Из К.Набор.ПоляКлюча Цикл
		Если Свойство.Поле <> "" Тогда
			Результат.Вставить(Свойство.Поле, Строка0.Получить(Свойство.Поле));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Набор записей регистра с отбором по ключу, прочитанный.
Функция НаборЗаписей(К, ЗначенияКлюча)
	Записи = РегистрыСведений[К.ОбъектМетаданных.Имя].СоздатьНаборЗаписей();
	Для Каждого КлючИЗначение Из ЗначенияКлюча Цикл
		Записи.Отбор[КлючИЗначение.Ключ].Установить(КлючИЗначение.Значение);
	КонецЦикла;
	Записи.Прочитать();
	Возврат Записи;
КонецФункции

Процедура ЗаписатьНабор(К, Записи)
	Записи.ОбменДанными.Загрузка = Ложь;
	Если К.Настройки.ПроверятьЗаполнение И Не Записи.ПроверитьЗаполнение() Тогда
		ОшибкаЗаписи(К, 400, "BadRequest", "Запись " + К.Набор.Имя + " не записана: не пройдена проверка заполнения", "");
	КонецЕсли;
	Записи.Записать(Истина);
	ВосстановитьВызов(К.Вызов);
КонецПроцедуры

Процедура ЗаблокироватьЗапись(К, ЗначенияКлюча)
	Блокировка = Новый БлокировкаДанных;
	Элемент = Блокировка.Добавить(К.ПолноеИмя);
	Элемент.Режим = РежимБлокировкиДанных.Исключительный;
	Для Каждого КлючИЗначение Из ЗначенияКлюча Цикл
		Элемент.УстановитьЗначение(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Блокировка.Заблокировать();
КонецПроцедуры

// Ключ записи регистра для маршрута чтения: пары «Имя, Текст» в порядке Набор.ПоляКлюча (составное — ещё «Имя_Type»).
Функция КлючЗаписи(К, ЗначенияКлюча, ДляАдреса = Ложь)
	Ключ = Новый Массив;
	Для Каждого Свойство Из К.Набор.ПоляКлюча Цикл
		Если Свойство.Поле = "" Тогда
			Ключ.Добавить(Новый Структура("Имя, Текст", Свойство.Имя, "0"));
			Продолжить;
		КонецЕсли;
		Значение = ЗначенияКлюча.Получить(Свойство.Поле);
		Ключ.Добавить(Новый Структура("Имя, Текст", Свойство.Имя, ЛитералЗначения(Значение)));
		Если Свойство.Вид = "Составной" Тогда
			Ключ.Добавить(Новый Структура("Имя, Текст", Свойство.Имя + "_Type",
				"'" + OData4_Сериализация.ИмяТипаЗначения(Значение) + "'"));
		КонецЕсли;
	КонецЦикла;
	Возврат Ключ;
КонецФункции

// Текст ключа записи для адреса («Имя=литерал,…»); ДляАдреса — имена и литералы в кодировке URL (заголовок Location
// передаёт только ASCII).
Функция ТекстКлюча(К, ЗначенияКлюча, ДляАдреса)
	Части = Новый Массив;
	Для Каждого Пара Из КлючЗаписи(К, ЗначенияКлюча) Цикл
		Если ДляАдреса Тогда
			Части.Добавить(ЧастьАдреса(Пара.Имя) + "=" + ЧастьАдреса(Пара.Текст));
		Иначе
			Части.Добавить(Пара.Имя + "=" + Пара.Текст);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ",");
КонецФункции

// Литерал значения ключа: дата — datetime'…', строка — '…', ссылка — guid'…', перечисление — '<имя>'.
Функция ЛитералЗначения(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Дата") Тогда
		Возврат "datetime'" + XMLСтрока(Значение) + "'";
	ИначеЕсли ТипЗначения = Тип("Строка") Тогда
		Возврат "'" + СтрЗаменить(Значение, "'", "''") + "'";
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат ?(Значение, "true", "false");
	ИначеЕсли Значение = Неопределено Тогда
		Возврат "null";
	КонецЕсли;
	Если Метаданные.Перечисления.Содержит(Метаданные.НайтиПоТипу(ТипЗначения)) Тогда
		Возврат "'" + XMLСтрока(Значение) + "'";
	КонецЕсли;
	Возврат "guid'" + XMLСтрока(Значение) + "'";
КонецФункции

#КонецОбласти

#Область Константы

// PATCH и PUT константы (свойство Value) по адресу Constant_X, Constant_X(0), Constant_X(SurrogateKey=0) (решение 20).
Функция ЗаписатьКонстанту(К)
	УстановитьОперацию(К, "Изменение");
	ПроверитьОперацию(К, "Изменение");
	ПроверитьНаличиеУсловия(К);
	Данные = OData4_ЗаписьПоля.ЗначенияСвойств(К.Модель, К.Набор, К.ОбъектМетаданных,
		OData4_ЗаписьПоля.РазобратьТело(К.Запрос), ?(К.Маршрут.Метод = "PUT", "Замена", "Изменение"), Строго(К));
	Ключ = К.Маршрут.Ключ;
	Если Ключ = Неопределено Тогда
		Ключ = Новый Массив;
		Ключ.Добавить(Новый Структура("Имя, Текст", "", "0"));
	КонецЕсли;
	СтрокаСущности(К, Ключ);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить(К.ПолноеИмя);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		ПроверитьВерсию(К, "");
		Менеджер = Константы[К.ОбъектМетаданных.Имя].СоздатьМенеджерЗначения();
		Менеджер.Прочитать();
		ПроверитьСсылкиТела(К, Данные, Новый Структура("Значение", Менеджер.Значение));
		Если К.Маршрут.Метод = "PUT" Тогда
			Менеджер.Значение = К.ОбъектМетаданных.Тип.ПривестиЗначение(Неопределено);
		КонецЕсли;
		Для Каждого Поле Из Данные.Поля Цикл
			Если Поле.Поле = "Значение" Тогда
				Менеджер.Значение = Поле.Значение;
			КонецЕсли;
		КонецЦикла;
		Менеджер.ОбменДанными.Загрузка = Ложь;
		Менеджер.Записать();
		ВосстановитьВызов(К.Вызов);
		ПроверитьВидимость(К, Ключ);
		Ответ = ОтветПоКлючу(К, Ключ, 200, "");
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьИПередать(К, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

#КонецОбласти

#Область СсылкиТела

// Ссылки тела записи (отзыв безопасности, группа B): каждое непустое значение ссылочного типа (справочник, документ,
// планы, узел обмена, бизнес-процесс, задача) в полях, в строках табличных частей и наборов движений, в
// «…@odata.bind» и в составных полях должно вести на существующий объект, который субъект видит чтением: набор модели
// профиля, его отборы строк и RLS (ВЫБРАТЬ РАЗРЕШЕННЫЕ) — как при чтении. Иначе — 400 «Свойство X: объект не найден
// или недоступен», одинаково для «нет» и «не видно». Режим — настройка ПроверкаСсылокЗаписи: «ВидимостьПрофилю»
// (по умолчанию), «Существование» (без профиля, только права 1С и RLS), «НеПроверять». Объект вида вне модели
// (состав публикации его не включает) проверяется только на существование. Значение, которое уже было у объекта в
// этом поле (Прежний — объект, запись регистра, прочитанный набор записей или Структура «Значение» константы), не
// проверяется: объект со ссылкой на скрытое меняется, не трогая её. Один запрос на тип ссылок.
Процедура ПроверитьСсылкиТела(К, Данные, Прежний = Неопределено)
	Режим = "";
	Если Не К.Настройки.Свойство("ПроверкаСсылокЗаписи", Режим) Или Режим <> "Существование" И Режим <> "НеПроверять" Тогда
		Режим = "ВидимостьПрофилю";
	ИначеЕсли Режим = "НеПроверять" Тогда
		Возврат;
	КонецЕсли;
	ПоТипам = Новый Соответствие;
	Для Каждого Поле Из Данные.Поля Цикл
		Если Поле.Поле = "Регистратор" И К.Вид = "НаборДвижений" Или Не ЭтоПроверяемаяСсылка(Поле.Значение) Тогда
			// Регистратор набора проверен ПроверитьРегистратор (404).
			Продолжить;
		КонецЕсли;
		Если Прежний <> Неопределено И ПрежнееЗначение(Прежний, Поле.Поле) = Поле.Значение Тогда
			Продолжить;
		КонецЕсли;
		ДобавитьСсылку(ПоТипам, Поле.Значение, Поле.Свойство.Имя);
	КонецЦикла;
	Прежние = Новый Соответствие;
	Для Каждого ТЧ Из Данные.ТабличныеЧасти Цикл
		Номер = 0;
		Для Каждого ПоляСтроки Из ТЧ.Строки Цикл
			Для Каждого Поле Из ПоляСтроки Цикл
				Если Не ЭтоПроверяемаяСсылка(Поле.Значение) Тогда
					Продолжить;
				КонецЕсли;
				Если ПрежниеЗначенияКолонки(Прежние, Прежний, ТЧ, Поле.Поле).Получить(Поле.Значение) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ДобавитьСсылку(ПоТипам, Поле.Значение, ТЧ.Имя + "[" + Формат(Номер, "ЧН=0; ЧГ=0") + "]/" + Поле.Свойство.Имя);
			КонецЦикла;
			Номер = Номер + 1;
		КонецЦикла;
	КонецЦикла;
	Для Каждого КлючИЗначение Из ПоТипам Цикл
		Сведения = КлючИЗначение.Значение;
		Видимые = ВидимыеСсылки(К, Сведения.Метаданные, Сведения.Ссылки, Режим);
		Для Каждого Пара Из Сведения.Места Цикл
			Если Видимые.Получить(Пара.Ключ) = Неопределено Тогда
				ВосстановитьВызов(К.Вызов);
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство " + Пара.Значение + ": объект не найден или недоступен");
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Значение — непустая ссылка на объект ссылочного вида (перечисления, виды движения, примитивы — нет).
Функция ЭтоПроверяемаяСсылка(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если Значение = Неопределено Или ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево")
		Или ТипЗначения = Тип("Дата") Или ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Ложь;
	КонецЕсли;
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗначения);
	Если ОбъектМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Вид = Лев(ОбъектМетаданных.ПолноеИмя(), СтрНайти(ОбъектМетаданных.ПолноеИмя(), ".") - 1);
	Если СтрРазделить("Справочник,Документ,ПланВидовХарактеристик,ПланСчетов,ПланВидовРасчета,ПланОбмена,БизнесПроцесс,"
		+ "Задача", ",").Найти(Вид) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Не Значение.Пустая();
КонецФункции

// Добавляет ссылку в ПоТипам: Соответствие полное имя вида → Структура «Метаданные, Ссылки (Массив), Места
// (Соответствие ссылка → первое место в теле)».
Процедура ДобавитьСсылку(ПоТипам, Значение, Место)
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	ПолноеИмя = ОбъектМетаданных.ПолноеИмя();
	Сведения = ПоТипам.Получить(ПолноеИмя);
	Если Сведения = Неопределено Тогда
		Сведения = Новый Структура("Метаданные, Ссылки, Места", ОбъектМетаданных, Новый Массив, Новый Соответствие);
		ПоТипам.Вставить(ПолноеИмя, Сведения);
	КонецЕсли;
	Если Сведения.Места.Получить(Значение) = Неопределено Тогда
		Сведения.Места.Вставить(Значение, Место);
		Сведения.Ссылки.Добавить(Значение);
	КонецЕсли;
КонецПроцедуры

// Прежнее значение поля объекта или записи (нет такого поля — Неопределено).
Функция ПрежнееЗначение(Прежний, Поле)
	Попытка
		Возврат Прежний[Поле];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Прежние значения колонки строк (Соответствие значение → Истина): табличной части объекта Прежний или прочитанного
// набора записей (ТЧ.ИмяТЧ пустое); субконто строки набора — значения всех субконто прежних записей. Кэш — по имени
// коллекции и полю.
Функция ПрежниеЗначенияКолонки(Кэш, Прежний, ТЧ, Поле)
	Ключ = ТЧ.Имя + "/" + Поле;
	Результат = Кэш.Получить(Ключ);
	Если Результат <> Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Результат = Новый Соответствие;
	Кэш.Вставить(Ключ, Результат);
	Если Прежний = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Попытка
		Строки = ?(ТЧ.ИмяТЧ = "", Прежний, Прежний[ТЧ.ИмяТЧ]);
		Для Каждого СтрокаТЧ Из Строки Цикл
			Если ТЧ.ИмяТЧ = "" И СтрНачинаетсяС(Поле, "Субконто") Тогда
				Для Каждого ИмяКоллекции Из СтрРазделить("СубконтоДт,СубконтоКт,Субконто", ",") Цикл
					Попытка
						Для Каждого КлючИЗначение Из СтрокаТЧ[ИмяКоллекции] Цикл
							Результат.Вставить(КлючИЗначение.Значение, Истина);
						КонецЦикла;
					Исключение
						// У регистра нет такой коллекции субконто.
					КонецПопытки;
				КонецЦикла;
			Иначе
				Результат.Вставить(СтрокаТЧ[Поле], Истина);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Прежних строк нет или поле не хранится — всё проверяется.
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Видимые субъекту объекты из Ссылки (вида ОбъектМетаданных): Соответствие ссылка → Истина. Запрос ВЫБРАТЬ РАЗРЕШЕННЫЕ
// по таблице объекта из метаданных; в режиме «ВидимостьПрофилю» — набор модели профиля и его отборы строк
// (OData4_Безопасность.УсловияНабора, те же, что при чтении). Профиль не читает вид — не видна ни одна. Нарушение прав
// 1С на таблицу — не видна ни одна.
Функция ВидимыеСсылки(К, ОбъектМетаданных, Ссылки, Режим)
	Результат = Новый Соответствие;
	Таблица = ОбъектМетаданных.ПолноеИмя();
	Параметры = Новый Соответствие;
	Условия = Новый Массив;
	Если Режим = "ВидимостьПрофилю" Тогда
		ИмяНабора = OData4_Модель.ИмяНабора(ОбъектМетаданных);
		Если ИмяНабора <> "" И OData4_Модель.НайтиНабор(OData4_МодельПовтИсп.ПолнаяМодель(), ИмяНабора) <> Неопределено Тогда
			Набор = OData4_Безопасность.НаборМодели(К.Модель, ИмяНабора);
			Если Набор = Неопределено Тогда
				Возврат Результат;
			КонецЕсли;
			Итог = OData4_Безопасность.УсловияНабора(Параметры, Набор, "Т");
			Если Итог.Ошибка <> Неопределено Тогда
				OData4_Сервис.ОшибкаOData(500, "InternalError", Итог.Ошибка);
			ИначеЕсли Итог.Запрет Тогда
				Возврат Результат;
			КонецЕсли;
			Условия = Итог.Условия;
			Таблица = Набор.ТаблицаЗапроса;
		КонецЕсли;
	КонецЕсли;
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ Т.Ссылка КАК Ссылка ИЗ " + Таблица + " КАК Т ГДЕ Т.Ссылка В (&OData4Ссылки)";
	Для Каждого Условие0 Из Условия Цикл
		Текст = Текст + " И " + Условие0;
	КонецЦикла;
	Запрос = Новый Запрос(Текст);
	Для Каждого КлючИЗначение Из Параметры Цикл
		Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Запрос.УстановитьПараметр("OData4Ссылки", Ссылки);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
	Исключение
		Информация = ИнформацияОбОшибке();
		Если OData4_Безопасность.ЭтоНарушениеПрав(Информация) Тогда
			Возврат Результат;
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Ссылка, Истина);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Ответы

Функция ОтветОбъекта(К, Ключ, Статус)
	Возврат ОтветПоКлючу(К, Ключ, Статус, Ключ[0].Текст);
КонецФункции

Функция ОтветЗаписи(К, ЗначенияКлюча, Статус)
	Возврат ОтветПоКлючу(К, КлючЗаписи(К, ЗначенияКлюча), Статус, ТекстКлюча(К, ЗначенияКлюча, Истина));
КонецФункции

// Ответ записи (решение 2): объект прежним чтением (с $select/$expand запроса) и ETag; Prefer: return=minimal — 204.
// У создания (201) — Location и OData-EntityId. ТекстАдреса — ключ в адресе ("" — адрес без ключа).
Функция ОтветПоКлючу(К, Ключ, Статус, ТекстАдреса)
	Заголовки = Новый Соответствие;
	Адрес = К.Адрес + "/" + КодироватьСтроку(К.Набор.Имя, СпособКодированияСтроки.КодировкаURL)
		+ ?(ТекстАдреса = "", "", "(" + ТекстАдреса + ")");
	Если Статус = 201 Тогда
		Заголовки.Вставить("Location", Адрес);
	КонецЕсли;
	Предпочтение = ПредпочтениеВозврата(К);
	Маршрут = Новый Структура("Вид, Набор, Ключ, ТекстКлюча, Функция, ПараметрыФункции, ТекстФункции, Параметры, Опции",
		"Сущность", К.Набор.Имя, Ключ, ТекстАдреса, "", Новый Соответствие, "", К.Маршрут.Параметры, К.Маршрут.Опции);
	Версия = "";
	Текст = OData4_Чтение.Сущность(Маршрут, К.Адрес, Версия);
	Если Версия <> "" Тогда
		Заголовки.Вставить("ETag", OData4_Сериализация.ЗначениеETag(Версия));
	КонецЕсли;
	Если Предпочтение = "minimal" Тогда
		Заголовки.Вставить("Preference-Applied", "return=minimal");
		Если Статус = 201 Тогда
			Заголовки.Вставить("OData-EntityId", Адрес);
		КонецЕсли;
		Возврат ОтветБезТела(Заголовки);
	ИначеЕсли Предпочтение = "representation" Тогда
		Заголовки.Вставить("Preference-Applied", "return=representation");
	КонецЕсли;
	Возврат OData4_Сериализация.ОтветJSON(Статус, Текст, Заголовки);
КонецФункции

// Предпочтение return из заголовка Prefer: "minimal", "representation" или "".
Функция ПредпочтениеВозврата(К)
	Для Каждого Часть Из СтрРазделить(ЗначениеЗаголовка(К, "Prefer"), ",;", Ложь) Цикл
		Пара = СтрРазделить(СокрЛП(Часть), "=", Ложь);
		Если Пара.Количество() = 2 И НРег(СокрЛП(Пара[0])) = "return" Тогда
			Значение = НРег(СокрЛП(Пара[1]));
			Если Значение = "minimal" Или Значение = "representation" Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

#КонецОбласти

// Ошибка записи с подробностями (решение 17): сообщения пользователю (с целью-свойством OData) и текст причины
// исключения — в error.details текущего вызова; затем исключение OData4.
Процедура ОшибкаЗаписи(К, Статус, Код, Сообщение, ТекстИсключения)
	Подробности = Новый Массив;
	Для Каждого СообщениеПользователю Из ПолучитьСообщенияПользователю(Истина) Цикл
		Цель = "";
		Попытка
			Цель = OData4_ЗаписьПоля.ЦельСообщения(К.Модель, К.Набор, СообщениеПользователю.Поле,
				СообщениеПользователю.ПутьКДанным);
		Исключение
			Цель = "";
		КонецПопытки;
		Подробности.Добавить(Новый Структура("code, message, target", "Message", СообщениеПользователю.Текст, Цель));
	КонецЦикла;
	Если ТекстИсключения <> "" Тогда
		Подробности.Добавить(Новый Структура("code, message, target", "Exception", ТекстИсключения, ""));
	КонецЕсли;
	К.Вызов.Операция.Подробности = Подробности;
	ВосстановитьВызов(К.Вызов);
	OData4_Сервис.ОшибкаOData(Статус, Код, Сообщение);
КонецПроцедуры

// Текст причины исключения: описание самой глубокой причины (без модулей и строк кода).
Функция ТекстПричины(Информация)
	Текущая = Информация;
	Пока Текущая.Причина <> Неопределено Цикл
		Текущая = Текущая.Причина;
	КонецЦикла;
	Возврат СокрЛП(Текущая.Описание);
КонецФункции

// Настройка «Отвергать неизвестные свойства» (решение 32).
Функция Строго(К)
	Значение = Ложь;
	Возврат К.Настройки.Свойство("ОтвергатьНеизвестныеСвойства", Значение) И Значение = Истина;
КонецФункции

Функция ЭтоДокумент(К)
	Возврат СтрНачинаетсяС(К.ПолноеИмя, "Документ.");
КонецФункции

Функция МенеджерОбъекта(ПолноеИмя)
	Части = СтрРазделить(ПолноеИмя, ".");
	Менеджеры = Новый Соответствие;
	Менеджеры.Вставить("Справочник", Справочники);
	Менеджеры.Вставить("Документ", Документы);
	Менеджеры.Вставить("ПланВидовХарактеристик", ПланыВидовХарактеристик);
	Менеджеры.Вставить("ПланСчетов", ПланыСчетов);
	Менеджеры.Вставить("ПланВидовРасчета", ПланыВидовРасчета);
	Менеджеры.Вставить("ПланОбмена", ПланыОбмена);
	Менеджеры.Вставить("БизнесПроцесс", БизнесПроцессы);
	Менеджеры.Вставить("Задача", Задачи);
	Возврат Менеджеры.Получить(Части[0])[Части[1]];
КонецФункции

// Часть адреса для заголовка (только ASCII): текст из букв, цифр и знаков ключа OData (-._~'():,=+) — как есть, иначе
// в кодировке URL.
Функция ЧастьАдреса(Текст)
	Допустимые = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._~'():,=+";
	Для Номер = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти(Допустимые, Сред(Текст, Номер, 1)) = 0 Тогда
			Возврат КодироватьСтроку(Текст, СпособКодированияСтроки.КодировкаURL);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция ТекстКлючаМаршрута(К)
	Возврат ?(К.Маршрут.ТекстКлюча = Неопределено, "", К.Маршрут.ТекстКлюча);
КонецФункции

#КонецОбласти
