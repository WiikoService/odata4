#Область ПрограммныйИнтерфейс

// Описание профиля (OData4_Профили.Описание). Кэш на сеанс по ссылке и версии данных элемента: изменение
// профиля меняет версию, и новое описание действует со следующего запроса без увеличения ВерсияНастроек.
Функция Описание(Профиль, Версия) Экспорт
	Возврат OData4_Профили.Описание(Профиль);
КонецФункции

// Изменяемое Соответствие на время сеанса: последние удачно прочитанные настройки доступа (на случай, когда
// таблицы расширения временно не читаются — гонка сеанса HTTP-сервиса).
Функция ПамятьСеанса() Экспорт
	Возврат Новый Соответствие;
КонецФункции

// У объекта метаданных с полным именем ПолноеИмя есть поле Поле (реквизит, измерение, ресурс, стандартный или
// общий реквизит). Кэш на сеанс.
Функция ЕстьПоле(ПолноеИмя, Поле) Экспорт
	ОбъектМД = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если ОбъектМД = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат OData4_Профили.ЕстьПоле(ОбъектМД, Поле);
КонецФункции

#КонецОбласти
