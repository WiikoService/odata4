#Область ПрограммныйИнтерфейс

// Вход запроса: субъект, профиль, лимиты частоты. Вызывается из OData4_Сервис.Обработать до маршрутизатора.
// Возвращает Структура("Субъект, ИмяСубъекта, Профиль, ИсточникТокена") или прерывает обработку
// OData4_Сервис.ОшибкаOData (401, 403, 429, 503).
// Сервис odata — Basic: текущий пользователь ИБ и его профиль из OData4_ПрофилиПользователей (токен не читается).
// Сервис odatat — токен из заголовка X-OData4-Token, пути «/t/<токен>/v4/…» или параметра token (в этом порядке
// старшинства), ключ продолжения cont.
Функция Войти(Запрос, ИмяСервиса) Экспорт
	Контекст = OData4_БезопасностьВызов.Контекст();
	Контекст.Сервис = ИмяСервиса;
	Если ВРег(Запрос.HTTPМетод) = "OPTIONS" Тогда
		// OPTIONS (заголовки CORS, 5.3) анонимен на обеих публикациях и данных не отдаёт (решение контроллера).
		Возврат ТекущийКонтекст();
	КонецЕсли;
	Если ИмяСервиса = "odata" Тогда
		// Публикация с фиксированным пользователем отдаёт все HTTP-сервисы без аутентификации; сервис odata
		// принимает только запрос, аутентифицированный платформой по Basic этого пользователя (решение 1).
		ПроверитьАутентификациюBasic(Запрос);
		Настройки = НастройкиДоступа();
		ВойтиBasic(Контекст, Настройки);
	Иначе
		Настройки = НастройкиДоступа();
		ВойтиПоТокену(Запрос, Контекст, Настройки);
		Если Настройки.РежимПравСлужебногоПользователя = "Привилегированный" И БезопасныйРежим() <> Ложь Тогда
			OData4_Сервис.ОшибкаOData(503, "ServiceUnavailable",
				"Привилегированный режим недоступен: расширение OData4 работает в безопасном режиме");
		КонецЕсли;
	КонецЕсли;
	Описание = Контекст.ОписаниеПрофиля;
	Если Описание <> Неопределено И Описание.ЛимитыЧастоты.Количество() > 0 Тогда
		Итог = ПроверитьЧастоту(Контекст.Субъект, Описание.ЛимитыЧастоты, ТекущаяУниверсальнаяДата());
		Если Не Итог.Разрешено Тогда
			Контекст.ЗаголовкиОтвета.Вставить("Retry-After", Формат(Итог.ПовторитьЧерез, "ЧН=0; ЧГ=0"));
			OData4_Сервис.ОшибкаOData(429, "TooManyRequests", "Превышен лимит частоты: "
				+ Формат(Итог.Запросов, "ЧН=0; ЧГ=0") + " запросов за " + Формат(Итог.Секунд, "ЧН=0; ЧГ=0") + " с");
		КонецЕсли;
	КонецЕсли;
	Возврат ТекущийКонтекст();
КонецФункции

// Контекст текущего запроса (копия): Структура("Субъект, ИмяСубъекта, Профиль, ИсточникТокена").
// Вне запроса — пустые значения.
Функция ТекущийКонтекст() Экспорт
	Контекст = OData4_БезопасностьВызов.Контекст();
	Возврат Новый Структура("Субъект, ИмяСубъекта, Профиль, ИсточникТокена",
		Контекст.Субъект, Контекст.ИмяСубъекта, Контекст.Профиль, Контекст.ИсточникТокена);
КонецФункции

// Путь или параметры без секретов (параметров token и cont, без учёта регистра имени): строка
// «путь?a=1&…» → «путь?a=1…», Соответствие параметров → «a=1&…». Для журнала.
Функция УбратьСекреты(ПутьИлиПараметры) Экспорт
	Если ТипЗнч(ПутьИлиПараметры) = Тип("Соответствие") Или ТипЗнч(ПутьИлиПараметры) = Тип("ФиксированноеСоответствие") Тогда
		Части = Новый Массив;
		Для Каждого КлючИЗначение Из ПутьИлиПараметры Цикл
			Если ЭтоСекрет(КлючИЗначение.Ключ) Тогда
				Продолжить;
			КонецЕсли;
			Части.Добавить(КлючИЗначение.Ключ + "=" + КлючИЗначение.Значение);
		КонецЦикла;
		Возврат СтрСоединить(Части, "&");
	КонецЕсли;
	Текст = Строка(ПутьИлиПараметры);
	Вопрос = СтрНайти(Текст, "?");
	Если Вопрос = 0 Тогда
		Если СтрНайти(Текст, "=") = 0 Тогда
			Возврат Текст;
		КонецЕсли;
		Путь = "";
		СтрокаПараметров = Текст;
	Иначе
		Путь = Лев(Текст, Вопрос);
		СтрокаПараметров = Сред(Текст, Вопрос + 1);
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого Часть Из СтрРазделить(СтрокаПараметров, "&", Ложь) Цикл
		Равно = СтрНайти(Часть, "=");
		Имя = ?(Равно = 0, Часть, Лев(Часть, Равно - 1));
		Если Не ЭтоСекрет(РаскодироватьСтроку(Имя, СпособКодированияСтроки.КодировкаURL)) Тогда
			Части.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Если Части.Количество() = 0 И Путь <> "" Тогда
		Возврат Лев(Путь, СтрДлина(Путь) - 1);
	КонецЕсли;
	Возврат Путь + СтрСоединить(Части, "&");
КонецФункции

// Параметры входа для @odata.nextLink: «&token=<токен>», если токен пришёл в адресе; при включённых токенах
// продолжения — «&cont=<ключ>» (см. НовоеПродолжение) при любом источнике токена; иначе "". Токен из заголовка
// в ссылку не переносится. Набор — путь ресурса ссылки после «/v4/», ПараметрыСсылки — её строка параметров.
Функция ПараметрыСекретов(Набор = "", ПараметрыСсылки = "") Экспорт
	Контекст = OData4_БезопасностьВызов.Контекст();
	Если Контекст.Сервис <> "odatat" Или Контекст.ХешТокена = "" Тогда
		Возврат "";
	КонецЕсли;
	Если Контекст.Настройки <> Неопределено И Контекст.Настройки.ТокеныПродолжения Тогда
		Возврат НовоеПродолжение(Набор, ПараметрыСсылки);
	КонецЕсли;
	Если Контекст.ИсточникТокена = "Адрес" Тогда
		Возврат "&token=" + КодироватьСтроку(Контекст.Токен, СпособКодированияСтроки.КодировкаURL);
	КонецЕсли;
	Возврат "";
КонецФункции

// [Экспериментально] Ключ продолжения для @odata.nextLink: «&cont=<ключ>». Ключ одноразовый, привязан к
// исходному токену, профилю, набору и каноническому тексту параметров ссылки; срок — из настроек.
Функция НовоеПродолжение(Набор, ПараметрыСсылки) Экспорт
	Контекст = OData4_БезопасностьВызов.Контекст();
	Ключ = OData4_Профили.СлучайнаяЧасть();
	Срок = Контекст.Настройки.СрокЖизниТокеновПродолжения;
	ЗаписатьПродолжение(Новый Структура("ХешКлюча, ХешТокена, Профиль, Набор, Параметры, Срок, Использован",
		OData4_Профили.ХешТокена(Ключ), Контекст.ХешТокена, Контекст.Профиль, Набор,
		КаноническиеПараметры(ПараметрыСсылки), ТекущаяУниверсальнаяДата() + ?(Срок > 0, Срок, 600), Ложь));
	Возврат "&cont=" + Ключ;
КонецФункции

// Настройки доступа (ресурсы OData4_Настройки части 5.2): ФиксированнаяСтруктура «РежимПримененияПрофиля,
// РежимПравСлужебногоПользователя, СтрогийРежимBasic, СлужебныеПользователи, ТокеныПродолжения,
// СрокЖизниТокеновПродолжения, ЗаголовокАдресаКлиента, ДоверятьЗаголовкуАдресаКлиента, ЧислоДоверенныхПрокси,
// РазрешитьBasicСлужебнымУчёткам, ВерсияНастроек».
// Кэш на запрос. Сбой чтения — настройки, прочитанные в этом сеансе, только при гонке сеанса платформы и не старше
// СрокПрочитанного() (ЗначениеПриСбое, как у профиля и токена; отзыв безопасности: прежде брались последние
// настройки сеанса любой давности при любом сбое); иначе 503 (открыть запрос без настроек доступа нельзя).
Функция НастройкиДоступа() Экспорт
	Контекст = OData4_БезопасностьВызов.Контекст();
	Если Контекст.Настройки <> Неопределено Тогда
		Возврат Контекст.Настройки;
	КонецЕсли;
	Память = OData4_ПрофилиКэш.ПамятьСеанса();
	Попытка
		Настройки = ПрочитатьНастройкиДоступа();
		ЗапомнитьПрочитанное(Память, "Настройки", "", Настройки, ТекущаяУниверсальнаяДата());
	Исключение
		Информация = ИнформацияОбОшибке();
		Настройки = ЗначениеПриСбое(Память, "Настройки", "", Информация, ТекущаяУниверсальнаяДата());
		Если Настройки = Неопределено Тогда
			Недоступно("Настройки доступа недоступны", Информация);
		КонецЕсли;
		ПредупредитьОПрочитанномРанее("Настройки доступа", Информация);
	КонецПопытки;
	Контекст.Настройки = Настройки;
	Возврат Настройки;
КонецФункции

// Значения ресурсов 5.2 по умолчанию (запись регистра OData4_Настройки не сохранена).
Функция НастройкиПоУмолчанию() Экспорт
	Настройки = Новый Структура;
	Настройки.Вставить("РежимПримененияПрофиля", "ПредставлениеМодели");
	Настройки.Вставить("РежимПравСлужебногоПользователя", "РолиКонфигурации");
	Настройки.Вставить("СтрогийРежимBasic", Ложь);
	Настройки.Вставить("СлужебныеПользователи", "");
	Настройки.Вставить("ТокеныПродолжения", Ложь);
	Настройки.Вставить("СрокЖизниТокеновПродолжения", 600);
	Настройки.Вставить("ЗаголовокАдресаКлиента", "");
	Настройки.Вставить("ДоверятьЗаголовкуАдресаКлиента", Ложь);
	Настройки.Вставить("ЧислоДоверенныхПрокси", 1);
	Настройки.Вставить("РазрешитьBasicСлужебнымУчёткам", Ложь);
	Настройки.Вставить("ВерсияНастроек", 0);
	Возврат Настройки;
КонецФункции

// Значение заголовка запроса без учёта регистра имени; нет заголовка — "".
Функция ЗначениеЗаголовка(Запрос, Имя) Экспорт
	ИмяНРег = НРег(Имя);
	Для Каждого КлючИЗначение Из Запрос.Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) = ИмяНРег Тогда
			Возврат СокрЛП(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Адрес клиента из заголовка доверенного прокси (настройки ЗаголовокАдресаКлиента, ДоверятьЗаголовкуАдресаКлиента
// и ЧислоДоверенныхПрокси): см. АдресИзЗаголовка. Заголовок не доверенный или его нет — "".
// Запрос.Контекст в режиме совместимости 8.3.11 недоступен; X-Forwarded-For клиент может прислать сам.
Функция АдресКлиента(Запрос) Экспорт
	Настройки = НастройкиДоступа();
	Если Не АдресКлиентаПроверяется(Настройки) Тогда
		Возврат "";
	КонецЕсли;
	Возврат АдресИзЗаголовка(ЗначениеЗаголовка(Запрос, Настройки.ЗаголовокАдресаКлиента),
		Настройки.ЧислоДоверенныхПрокси);
КонецФункции

// Адрес клиента из значения заголовка прокси: ЧислоПрокси-й адрес списка через запятую, считая справа (отзыв
// безопасности, группа A). Прокси дописывает в конец X-Forwarded-For адрес, с которого к нему пришли (nginx
// $proxy_add_x_forwarded_for, Apache mod_proxy), а всё левее присылает клиент: при одном прокси адрес клиента —
// последний, при двух — предпоследний (последний дописал второй прокси о первом). Заголовок, который прокси
// перезаписывает целиком (X-Real-IP), содержит один адрес — это ЧислоПрокси = 1. Адресов меньше, чем прокси
// (запрос пришёл мимо части прокси), или пустое значение — "" (адрес не определён). ЧислоПрокси меньше 1 — как 1.
Функция АдресИзЗаголовка(Значение, ЧислоПрокси = 1) Экспорт
	Адреса = Новый Массив;
	Для Каждого Часть Из СтрРазделить(Значение, ",", Ложь) Цикл
		Адрес = СокрЛП(Часть);
		Если Адрес <> "" Тогда
			Адреса.Добавить(Адрес);
		КонецЕсли;
	КонецЦикла;
	Прокси = ?(ТипЗнч(ЧислоПрокси) = Тип("Число") И ЧислоПрокси >= 1, Цел(ЧислоПрокси), 1);
	Если Адреса.Количество() < Прокси Тогда
		Возврат "";
	КонецЕсли;
	Возврат Адреса[Адреса.Количество() - Прокси];
КонецФункции

// Адрес клиента читается из заголовка: задан заголовок и включено доверие к нему.
Функция АдресКлиентаПроверяется(Настройки = Неопределено) Экспорт
	Если Настройки = Неопределено Тогда
		Настройки = НастройкиДоступа();
	КонецЕсли;
	Возврат Настройки.ДоверятьЗаголовкуАдресаКлиента И Настройки.ЗаголовокАдресаКлиента <> "";
КонецФункции

// Служебные учётки: имена пользователей ИБ из настройки СлужебныеПользователи (заданные администратором и
// запомненные по запросам к odatat) без пустых и повторов.
Функция СлужебныеУчётки() Экспорт
	Результат = Новый Массив;
	Для Каждого Имя Из СтрРазделить(НастройкиДоступа().СлужебныеПользователи, Символы.ПС + ",", Ложь) Цикл
		ИмяУчётки = СокрЛП(Имя);
		Если ИмяУчётки <> "" И Результат.Найти(ИмяУчётки) = Неопределено Тогда
			Результат.Добавить(ИмяУчётки);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Имя — служебная учётка (СлужебныеУчётки), без учёта регистра: имена пользователей ИБ регистр не различают.
Функция ЭтоСлужебнаяУчётка(Имя) Экспорт
	ИмяНРег = НРег(СокрЛП(Имя));
	Для Каждого ИмяУчётки Из СлужебныеУчётки() Цикл
		Если НРег(ИмяУчётки) = ИмяНРег Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Опасные настройки доступа для предупреждения при запуске: Массив Структура("Вид, Текст"). Виды:
// СлужебнаяУчёткаАдминистратор, СлужебнаяУчёткаПолныеПрава, ПривилегированныйВБезопасном,
// ПривилегированныйРежим, РолиРасширенияНеЗагружены, РасширениеПравУстарело, РолиРасширенияВБезопасном,
// IPТокеновНеПроверяются (у токенов есть IP, а доверенный заголовок адреса не настроен), BasicСлужебнымУчёткам.
Функция ОпасныеНастройки() Экспорт
	Результат = Новый Массив;
	Настройки = НастройкиДоступа();
	Роль = Метаданные.Роли.Найти("OData4_Администратор");
	Для Каждого Имя Из СлужебныеУчётки() Цикл
		Пользователь = ПользовательИБ(Имя);
		Если Пользователь = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Роль <> Неопределено И Пользователь.Роли.Содержит(Роль) Тогда
			Результат.Добавить(Новый Структура("Вид, Текст", "СлужебнаяУчёткаАдминистратор", "Служебная учётка " + Имя
				+ " имеет роль OData4_Администратор: любой действующий токен получает административный доступ к "
				+ "настройкам и токенам OData4; возможна нестабильность"));
		ИначеЕсли ПравоДоступа("Администрирование", Метаданные, Пользователь) Тогда
			Результат.Добавить(Новый Структура("Вид, Текст", "СлужебнаяУчёткаПолныеПрава", "Служебная учётка " + Имя
				+ " имеет полные права: любой действующий токен получает административный доступ к настройкам и "
				+ "токенам OData4; возможна нестабильность"));
		КонецЕсли;
	КонецЦикла;
	Если Настройки.РежимПравСлужебногоПользователя = "Привилегированный" Тогда
		Если БезопасныйРежим() <> Ложь Тогда
			Результат.Добавить(Новый Структура("Вид, Текст", "ПривилегированныйВБезопасном",
				"Привилегированный режим недоступен: расширение OData4 работает в безопасном режиме; запросы по "
				+ "токенам отвечают 503"));
		КонецЕсли;
		Результат.Добавить(Новый Структура("Вид, Текст", "ПривилегированныйРежим",
			"RLS не действует для запросов по токенам: доступ определяет только профиль"));
	ИначеЕсли Настройки.РежимПравСлужебногоПользователя = "РолиРасширения" Тогда
		Если Не РасширениеПравЗагружено() Тогда
			Результат.Добавить(Новый Структура("Вид, Текст", "РолиРасширенияНеЗагружены",
				"Расширение OData4Права не загружено: служебный пользователь читает только то, что дают роли конфигурации"));
		ИначеЕсли РасширениеПравУстарело() Тогда
			Результат.Добавить(Новый Структура("Вид, Текст", "РасширениеПравУстарело",
				"Расширение OData4Права устарело: после него изменились состав публикации, расширение OData4 или его "
				+ "безопасный режим; роли OData4Права могут не действовать — обновите расширение прав "
				+ "(см. README, раздел «Доступ»)"));
		КонецЕсли;
		Если БезопасныйРежим() <> Ложь Тогда
			// Проба 5.2: права ролей расширения на заимствованные объекты действуют, только если и код, который читает
			// данные (OData4), работает без безопасного режима.
			Результат.Добавить(Новый Структура("Вид, Текст", "РолиРасширенияВБезопасном",
				"Роли расширения OData4Права не действуют: расширение OData4 работает в безопасном режиме; служебный "
				+ "пользователь читает только то, что дают роли конфигурации"));
		КонецЕсли;
	КонецЕсли;
	Если Не АдресКлиентаПроверяется(Настройки) И ЕстьТокеныСАдресами() Тогда
		Результат.Добавить(Новый Структура("Вид, Текст", "IPТокеновНеПроверяются",
			"У действующих токенов заданы разрешённые IP, а доверенный заголовок адреса клиента не настроен: такие "
			+ "токены отвергаются (401), пока на вкладке «Аутентификация» не заданы заголовок прокси и доверие к нему"));
	КонецЕсли;
	Если Настройки.РазрешитьBasicСлужебнымУчёткам И СлужебныеУчётки().Количество() > 0 Тогда
		Результат.Добавить(Новый Структура("Вид, Текст", "BasicСлужебнымУчёткам",
			"Служебные учётки публикации токенов входят по Basic на сервис odata: без профиля им доступно всё, что "
			+ "дают их роли"));
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Есть действующие токены (активные, не помеченные на удаление, не просроченные) с разрешёнными IP. Сбой чтения
// (нет прав) — Ложь.
Функция ЕстьТокеныСАдресами() Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	1 КАК Найден
	|ИЗ
	|	Справочник.OData4_Токены КАК Т
	|ГДЕ
	|	Т.Активен
	|	И НЕ Т.ПометкаУдаления
	|	И (Т.СрокДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ Т.СрокДействия > &Сейчас)
	|	И ПОДСТРОКА(Т.РазрешённыеIP, 1, 200) <> """"");
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Попытка
		Возврат Не OData4_Хранилище.ВыполнитьЗапрос(Запрос).Пустой();
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Показывать ли пользователю предупреждение об опасных настройках: роль OData4_Администратор или право
// «Администрирование». ИмяПользователяИБ — имя пользователя ИБ, Неопределено — текущий.
Функция ПоказыватьПредупреждение(ИмяПользователяИБ = Неопределено) Экспорт
	Роль = Метаданные.Роли.Найти("OData4_Администратор");
	Если ИмяПользователяИБ = Неопределено Тогда
		Возврат Роль <> Неопределено И РольДоступна(Роль) Или ПравоДоступа("Администрирование", Метаданные);
	КонецЕсли;
	Пользователь = ПользовательИБ(ИмяПользователяИБ);
	Если Пользователь = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Роль <> Неопределено И Пользователь.Роли.Содержит(Роль)
		Или ПравоДоступа("Администрирование", Метаданные, Пользователь);
КонецФункции

// Расширение OData4Права (роли на объекты состава для режима «Роли расширения») подключено в сеансе.
Функция РасширениеПравЗагружено() Экспорт
	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Если Расширение.Имя = "OData4Права" Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Расширение OData4Права загружено для другого состояния, чем текущее (решение контроллера 5.2): его версия —
// ОтпечатокПрав() на момент генерации (devcli rights); роли OData4Права действуют только после повторной загрузки
// при изменении состава, обновлении OData4 или смене его безопасного режима.
Функция РасширениеПравУстарело() Экспорт
	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Если Расширение.Имя = "OData4Права" Тогда
				Возврат Расширение.Версия <> ОтпечатокПрав();
			КонецЕсли;
		КонецЦикла;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Отпечаток состояния, для которого генерируется OData4Права: SHA-256 (hex, 32 знака) отсортированных полных
// имён действующего состава, контрольной суммы и безопасного режима расширения OData4. devcli rights пишет его
// в версию OData4Права.
Функция ОтпечатокПрав() Экспорт
	Имена = Новый СписокЗначений;
	Для Каждого КлючИЗначение Из OData4_Состав.ДействующийСостав() Цикл
		Имена.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	Имена.СортироватьПоЗначению();
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(СтрСоединить(Имена.ВыгрузитьЗначения(), Символы.ПС));
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Если Расширение.Имя = "OData4" Тогда
			Сумма = Расширение.ХешСумма;
			Хеш.Добавить(Символы.ПС + ?(ТипЗнч(Сумма) = Тип("ДвоичныеДанные"), ПолучитьHexСтрокуИзДвоичныхДанных(Сумма),
				Строка(Сумма)) + Символы.ПС + Строка(Расширение.БезопасныйРежим));
		КонецЕсли;
	КонецЦикла;
	Возврат Лев(НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма)), 32);
КонецФункции

// Лимиты частоты: счётчик фиксированного окна на субъект и правило. Каждое правило увеличивает свой счётчик
// (отклонённый запрос тоже считается); превышение хотя бы одного — отказ. Момент — универсальное время.
// Приращение — сколько запросов добавить (операции $batch, этап 7), по умолчанию 1.
// Результат — Структура «Разрешено, ПовторитьЧерез (секунд до конца окна превышенного правила, наибольшее),
// Запросов, Секунд (превышенное правило с наибольшим ожиданием)».
Функция ПроверитьЧастоту(Субъект, ЛимитыЧастоты, Момент, Приращение = 1) Экспорт
	Результат = Новый Структура("Разрешено, ПовторитьЧерез, Запросов, Секунд", Истина, 0, 0, 0);
	СекундыОтНачала = Момент - '00010101';
	Для Каждого Правило Из ЛимитыЧастоты Цикл
		НачалоОкна = Цел(СекундыОтНачала / Правило.Секунд) * Правило.Секунд;
		Запросов = УвеличитьСчётчик(Субъект, Правило.Правило, НачалоОкна, Приращение);
		Если Запросов > Правило.Запросов Тогда
			Ожидание = Макс(1, НачалоОкна + Правило.Секунд - СекундыОтНачала);
			Если Результат.Разрешено Или Ожидание > Результат.ПовторитьЧерез Тогда
				Результат.ПовторитьЧерез = Ожидание;
				Результат.Запросов = Правило.Запросов;
				Результат.Секунд = Правило.Секунд;
			КонецЕсли;
			Результат.Разрешено = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Первый ли это отказ входа в текущем минутном окне для сервиса Сервис и адреса клиента Адрес (для прореживания
// журнала, OData4_Журнал.ПисатьОтказВхода). Счётчик — общий для сеансов регистр OData4_СчётчикиЗапросов (субъект
// «вход:<сервис>:<адрес>», правило «отказ входа»; старые окна удаляет регламентная очистка); память сеанса
// отвечает на повторы без обращения к базе. Момент — универсальное время. Сбой счётчика — Истина (запись пишется).
Функция ПервыйОтказВходаВОкне(Сервис, Адрес, Момент) Экспорт
	Окно = 60;
	НачалоОкна = Цел((Момент - '00010101') / Окно) * Окно;
	Субъект = Лев("вход:" + Сервис + ":" + Адрес, 150);
	Память = OData4_ПрофилиКэш.ПамятьСеанса();
	Отказы = Память.Получить("ОтказыВхода");
	Если Отказы = Неопределено Или Отказы.НачалоОкна <> НачалоОкна Тогда
		Отказы = Новый Структура("НачалоОкна, Субъекты", НачалоОкна, Новый Соответствие);
		Память.Вставить("ОтказыВхода", Отказы);
	КонецЕсли;
	Если Отказы.Субъекты.Получить(Субъект) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Отказы.Субъекты.Количество() < 1000 Тогда
		Отказы.Субъекты.Вставить(Субъект, Истина);
	КонецЕсли;
	Попытка
		Возврат УвеличитьСчётчик(Субъект, "отказ входа", НачалоОкна) = 1;
	Исключение
		Возврат Истина;
	КонецПопытки;
КонецФункции

// Лимиты частоты для $batch (этап 7): каждая операция пакета — запрос. Вход (Войти) уже посчитал сам запрос
// $batch, здесь добавляются остальные ЧислоОпераций − 1. Не хватает на весь пакет — 429 всего пакета до выполнения
// (с Retry-After). Без профиля или правил частоты — ничего.
Процедура ПроверитьЧастотуПакета(ЧислоОпераций) Экспорт
	Контекст = OData4_БезопасностьВызов.Контекст();
	Описание = Контекст.ОписаниеПрофиля;
	Если Описание = Неопределено Или Описание.ЛимитыЧастоты.Количество() = 0 Или ЧислоОпераций <= 1 Тогда
		Возврат;
	КонецЕсли;
	Итог = ПроверитьЧастоту(Контекст.Субъект, Описание.ЛимитыЧастоты, ТекущаяУниверсальнаяДата(), ЧислоОпераций - 1);
	Если Не Итог.Разрешено Тогда
		Контекст.ЗаголовкиОтвета.Вставить("Retry-After", Формат(Итог.ПовторитьЧерез, "ЧН=0; ЧГ=0"));
		OData4_Сервис.ОшибкаOData(429, "TooManyRequests", "Превышен лимит частоты: "
			+ Формат(Итог.Запросов, "ЧН=0; ЧГ=0") + " запросов за " + Формат(Итог.Секунд, "ЧН=0; ЧГ=0")
			+ " с; операций в $batch: " + Формат(ЧислоОпераций, "ЧН=0; ЧГ=0"));
	КонецЕсли;
КонецПроцедуры

// Лимит профиля «Операций в $batch» (0 — не ограничен или профиля нет).
Функция ОперацийBatchПрофиля() Экспорт
	Лимиты = ЛимитыПрофиля();
	Возврат ?(Лимиты = Неопределено, 0, Лимиты.ОперацийBatch);
КонецФункции

// Наибольшее окно правил частоты всех профилей в секундах (0 — правил нет): для регламентной очистки 5.3.
Функция НаибольшееОкноЧастоты() Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	ЕСТЬNULL(МАКСИМУМ(Л.Секунд), 0) КАК Секунд
	|ИЗ
	|	Справочник.OData4_Профили.ЛимитыЧастоты КАК Л");
	Выборка = OData4_Хранилище.ВыполнитьЗапрос(Запрос).Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Секунд;
КонецФункции

// Лимиты запроса по разобранному маршруту. Базовые (настройки, отзыв безопасности) действуют всегда, и без профиля:
// элементов списка in, длина строкового литерала, элементов $orderby (и во вложенных опциях $expand), сложность
// каждого выражения-отбора ($filter, filter шагов $apply, вложенный $filter раскрытия) — меньшее из базового и
// профильного СложностьФильтра. Лимиты профиля: $top (и у раскрытых коллекций), глубина $expand, число шагов $apply.
// Число раскрытий $expand считает планировщик (НаибольшееЧислоРаскрытий). Превышение — 400 с фактом.
Процедура ПроверитьЛимиты(Маршрут) Экспорт
	Лимиты = ЛимитыПрофиля();
	Опции = Маршрут.Опции;
	ПроверитьСоставВыражений(Опции);
	ПроверитьСложность(Опции.filter, "$filter");
	Если Лимиты = Неопределено Тогда
		Лимиты = Новый Структура("НаибольшийTop, ШаговApply, ГлубинаExpand", 0, 0, 0);
	КонецЕсли;
	ПроверитьTop(Опции.top, Лимиты.НаибольшийTop);
	Шаги = Неопределено;
	Если Опции.Свойство("apply", Шаги) И Шаги <> Неопределено Тогда
		ЧислоШагов = 0;
		Стек = Новый Массив;
		Для Каждого Шаг Из Шаги Цикл
			Стек.Добавить(Шаг);
		КонецЦикла;
		Пока Стек.Количество() > 0 Цикл
			Шаг = Стек[Стек.ВГраница()];
			Стек.Удалить(Стек.ВГраница());
			Если Шаг.kind <> "identity" Тогда
				ЧислоШагов = ЧислоШагов + 1;
			КонецЕсли;
			Если Шаг.kind = "filter" Тогда
				ПроверитьСложность(Шаг.filter, "$apply filter");
			КонецЕсли;
			Вложенные = Неопределено;
			Если Шаг.Свойство("steps", Вложенные) И Вложенные <> Неопределено Тогда
				Для Каждого Вложенный Из Вложенные Цикл
					Стек.Добавить(Вложенный);
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Если Лимиты.ШаговApply > 0 И ЧислоШагов > Лимиты.ШаговApply Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Число шагов $apply больше "
				+ Формат(Лимиты.ШаговApply, "ЧН=0; ЧГ=0") + ": " + Формат(ЧислоШагов, "ЧН=0; ЧГ=0"));
		КонецЕсли;
	КонецЕсли;
	// Раскрытия: глубина (путь «Товары/Номенклатура» — два уровня), $top и $filter вложенных опций.
	Наибольшая = 0;
	Стек = Новый Массив;
	Если Опции.expand <> Неопределено Тогда
		Стек.Добавить(Новый Структура("Раскрытие, Глубина", Опции.expand, 0));
	КонецЕсли;
	Пока Стек.Количество() > 0 Цикл
		Элемент = Стек[Стек.ВГраница()];
		Стек.Удалить(Стек.ВГраница());
		Для Каждого Раскрытие Из Элемент.Раскрытие Цикл
			Глубина = Элемент.Глубина + Раскрытие.path.Количество();
			Наибольшая = Макс(Наибольшая, Глубина);
			Вложенные = Раскрытие.options;
			Если Вложенные = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ПроверитьTop(Вложенные.top, Лимиты.НаибольшийTop);
			ПроверитьСложность(Вложенные.filter, "$expand " + СтрСоединить(Раскрытие.path, "/") + " $filter");
			Если Вложенные.expand <> Неопределено Тогда
				Стек.Добавить(Новый Структура("Раскрытие, Глубина", Вложенные.expand, Глубина));
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Если Лимиты.ГлубинаExpand > 0 И Наибольшая > Лимиты.ГлубинаExpand Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Глубина $expand больше "
			+ Формат(Лимиты.ГлубинаExpand, "ЧН=0; ЧГ=0") + ": " + Формат(Наибольшая, "ЧН=0; ЧГ=0"));
	КонецЕсли;
КонецПроцедуры

// Сложность выражения-отбора (число узлов дерева разбора) не больше меньшего из базового лимита (настройка
// НаибольшаяСложностьВыражения) и лимита профиля СложностьФильтра (0 — у профиля нет), иначе 400 «Сложность <Где>
// больше N узлов: M»; элементы in и строковые литералы дерева — в базовых лимитах (ПроверитьСоставВыражений).
// Дерево Неопределено — ничего.
Процедура ПроверитьСложность(Дерево, Где) Экспорт
	Если Дерево = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Предел = БазовыйЛимит("НаибольшаяСложностьВыражения");
	Лимиты = ЛимитыПрофиля();
	Если Лимиты <> Неопределено И Лимиты.СложностьФильтра > 0 И Лимиты.СложностьФильтра < Предел Тогда
		Предел = Лимиты.СложностьФильтра;
	КонецЕсли;
	Узлов = ЧислоУзлов(Дерево);
	Если Узлов > Предел Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Сложность " + Где + " больше "
			+ Формат(Предел, "ЧН=0; ЧГ=0") + " узлов: " + Формат(Узлов, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	ПроверитьСоставВыражений(Дерево);
КонецПроцедуры

// Базовые лимиты состава выражений и опций (отзыв безопасности, действуют и без профиля) по всему дереву Значение
// (опции маршрута или дерево выражения; обход явным стеком): элементов списка in — не больше
// НаибольшееЧислоЭлементовIn (все литералы списка — один параметр-массив, а СУБД ограничивает число параметров
// запроса: MS SQL — 2100), строковый литерал — не длиннее НаибольшаяДлинаСтроковогоЛитерала символов, элементов
// $orderby в каждых опциях — не больше НаибольшееЧислоЭлементовOrderby. Превышение — 400 с фактом.
Процедура ПроверитьСоставВыражений(Значение) Экспорт
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЭлементовIn = БазовыйЛимит("НаибольшееЧислоЭлементовIn");
	ДлинаСтроки = БазовыйЛимит("НаибольшаяДлинаСтроковогоЛитерала");
	ЭлементовПорядка = БазовыйЛимит("НаибольшееЧислоЭлементовOrderby");
	Стек = Новый Массив;
	Стек.Добавить(Значение);
	Пока Стек.Количество() > 0 Цикл
		Узел = Стек[Стек.ВГраница()];
		Стек.Удалить(Стек.ВГраница());
		ТипУзла = ТипЗнч(Узел);
		Если ТипУзла = Тип("Массив") Или ТипУзла = Тип("ФиксированныйМассив") Тогда
			Для Каждого Элемент Из Узел Цикл
				Стек.Добавить(Элемент);
			КонецЦикла;
			Продолжить;
		ИначеЕсли ТипУзла <> Тип("Структура") И ТипУзла <> Тип("ФиксированнаяСтруктура") Тогда
			Продолжить;
		КонецЕсли;
		Вид = Неопределено;
		Если Узел.Свойство("kind", Вид) Тогда
			Если Вид = "in" И Узел.Свойство("items") И ЧислоЭлементов(Узел.items) > ЭлементовIn Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "Элементов в списке in больше "
					+ Формат(ЭлементовIn, "ЧН=0; ЧГ=0") + ": " + Формат(ЧислоЭлементов(Узел.items), "ЧН=0; ЧГ=0"));
			ИначеЕсли Вид = "literal" И Узел.Свойство("type") И Узел.type = "Edm.String" И Узел.Свойство("value")
				И ТипЗнч(Узел.value) = Тип("Строка") И СтрДлина(Узел.value) > ДлинаСтроки Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "Строковый литерал длиннее "
					+ Формат(ДлинаСтроки, "ЧН=0; ЧГ=0") + " символов: " + Формат(СтрДлина(Узел.value), "ЧН=0; ЧГ=0"));
			КонецЕсли;
		ИначеЕсли Узел.Свойство("orderby") И ЧислоЭлементов(Узел.orderby) > ЭлементовПорядка Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Элементов $orderby больше "
				+ Формат(ЭлементовПорядка, "ЧН=0; ЧГ=0") + ": " + Формат(ЧислоЭлементов(Узел.orderby), "ЧН=0; ЧГ=0"));
		КонецЕсли;
		Для Каждого КлючИЗначение Из Узел Цикл
			Стек.Добавить(КлючИЗначение.Значение);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Базовый лимит запроса (отзыв безопасности: без профиля лимитов не было) — числовая настройка Имя; пусто, 0 или
// не число — значение по умолчанию из OData4_НастройкиСервиса.ПоУмолчанию.
Функция БазовыйЛимит(Имя) Экспорт
	Значение = OData4_НастройкиСервиса.Значение(Имя, 0);
	Если ТипЗнч(Значение) <> Тип("Число") Или Значение <= 0 Тогда
		Значение = OData4_НастройкиСервиса.ПоУмолчанию()[Имя];
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Наибольшее число раскрытий плана чтения (соединения навигаций и табличные части раскрытых объектов) — базовый
// лимит НаибольшееЧислоРаскрытий.
Функция НаибольшееЧислоРаскрытий() Экспорт
	Возврат БазовыйЛимит("НаибольшееЧислоРаскрытий");
КонецФункции

Функция ЧислоЭлементов(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Массив") Или ТипЗначения = Тип("ФиксированныйМассив") Тогда
		Возврат Значение.Количество();
	КонецЕсли;
	Возврат 0;
КонецФункции

// Число узлов дерева разбора (элементы со свойством kind). Обход явным стеком, без рекурсии.
Функция ЧислоУзлов(Дерево) Экспорт
	Узлов = 0;
	Стек = Новый Массив;
	Стек.Добавить(Дерево);
	Пока Стек.Количество() > 0 Цикл
		Узел = Стек[Стек.ВГраница()];
		Стек.Удалить(Стек.ВГраница());
		ТипУзла = ТипЗнч(Узел);
		Если ТипУзла = Тип("Массив") Или ТипУзла = Тип("ФиксированныйМассив") Тогда
			Для Каждого Элемент Из Узел Цикл
				Стек.Добавить(Элемент);
			КонецЦикла;
			Продолжить;
		ИначеЕсли ТипУзла <> Тип("Структура") И ТипУзла <> Тип("ФиксированнаяСтруктура") Тогда
			Продолжить;
		КонецЕсли;
		Если Узел.Свойство("kind") Тогда
			Узлов = Узлов + 1;
		КонецЕсли;
		Для Каждого КлючИЗначение Из Узел Цикл
			Стек.Добавить(КлючИЗначение.Значение);
		КонецЦикла;
	КонецЦикла;
	Возврат Узлов;
КонецФункции

// Размер страницы профиля (0 — не ограничен или профиля нет).
Функция РазмерСтраницыПрофиля() Экспорт
	Лимиты = ЛимитыПрофиля();
	Возврат ?(Лимиты = Неопределено, 0, Лимиты.РазмерСтраницы);
КонецФункции

// Есть профиль и режим применения «Полная модель и проверки по месту».
Функция ПроверкиПоМесту() Экспорт
	Контекст = OData4_БезопасностьВызов.Контекст();
	Возврат Контекст.ОписаниеПрофиля <> Неопределено И Контекст.Настройки <> Неопределено
		И Контекст.Настройки.РежимПримененияПрофиля = "ПроверкиПоМесту";
КонецФункции

// Набор модели по имени с проверками профиля по месту: запрещённый профилем — Неопределено, открытый — копия
// без исключённых полей и табличных частей и без навигаций в запрещённые наборы (кэш на запрос). Без профиля и
// в режиме «Представление модели на профиль» (модель уже урезана) — набор модели как есть.
Функция НаборМодели(Модель, Имя) Экспорт
	Набор = OData4_Модель.НайтиНабор(Модель, Имя);
	Если Набор = Неопределено Или Не ПроверкиПоМесту() Тогда
		Возврат Набор;
	КонецЕсли;
	Контекст = OData4_БезопасностьВызов.Контекст();
	Кэш = Контекст.НаборыПрофиля;
	Копия = Кэш.Получить(Имя);
	Если Копия = Неопределено Тогда
		Копия = OData4_ПрофильМодели.УрезатьНабор(Модель, Набор, Контекст.ОписаниеПрофиля, Контекст.РазрешенияПрофиля);
		Кэш.Вставить(Имя, ?(Копия = Неопределено, Ложь, Копия));
	КонецЕсли;
	Возврат ?(Копия = Ложь, Неопределено, Копия);
КонецФункции

// Набор маршрута или 404 «Набор сущностей не найден» (как OData4_Модель.Набор) — с проверками профиля по месту.
Функция НаборМаршрута(Модель, Имя) Экспорт
	Набор = НаборМодели(Модель, Имя);
	Если Набор = Неопределено Или Набор.Свойство("Скрытый") И Набор.Скрытый Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Набор сущностей не найден: " + Имя);
	КонецЕсли;
	Возврат Набор;
КонецФункции

// Описание виртуальной таблицы с проверками профиля по месту: без исключённых профилем измерений и ресурсов.
// Набор — набор полной модели, которому принадлежит функция.
Функция ОписаниеФункции(Модель, Набор, Описание0) Экспорт
	Если Описание0 = Неопределено Или Не ПроверкиПоМесту() Тогда
		Возврат Описание0;
	КонецЕсли;
	Контекст = OData4_БезопасностьВызов.Контекст();
	Возврат OData4_ПрофильМодели.УрезатьОписание(Модель, Набор, Описание0, Контекст.ОписаниеПрофиля,
		Контекст.РазрешенияПрофиля);
КонецФункции

// Условия отборов профиля для строк набора Набор (набор модели маршрута; ищется по имени в полной модели):
// шаблонные «Префикс.Реквизит В (&П)» и выражения ОтборыОбъектов, переведённые генератором по полной модели,
// каждое в скобках. У набора табличной части — условия владельца через «Префикс.Ссылка». Префикс "" — поля
// без псевдонима. Исключений не бросает: Структура «Условия (Массив текстов), Ошибка (текст или Неопределено)».
Функция УсловияНабора(Параметры, Набор, Префикс) Экспорт
	Результат = Новый Структура("Условия, Ошибка, Запрет", Новый Массив, Неопределено, Ложь);
	Описание = OData4_БезопасностьВызов.Контекст().ОписаниеПрофиля;
	Если Набор = Неопределено Или Описание = Неопределено И Набор.Вид <> "Журнал" Тогда
		Возврат Результат;
	КонецЕсли;
	Полная = OData4_МодельПовтИсп.ПолнаяМодель();
	НаборПолной = OData4_Модель.НайтиНабор(Полная, Набор.Имя);
	Если НаборПолной = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если НаборПолной.Вид = "Журнал" Тогда
		// Журнал не обходит ни состав публикации, ни профиль документов: строки — только видов документов состава,
		// права на чтение и отборы — по виду документа строки (и без профиля — условие состава).
		Возврат УсловиеСтрокЖурнала(Параметры, Полная, НаборПолной, Префикс, Описание);
	КонецЕсли;
	Если Не Описание.ЕстьОтборы Тогда
		Возврат Результат;
	КонецЕсли;
	ПолноеИмя = OData4_ПрофильМодели.ПолноеИмяОбъекта(НаборПолной);
	Если ПолноеИмя = "" Тогда
		Возврат Результат;
	КонецЕсли;
	Если НаборПолной.Вид = "ТабличнаяЧасть" Тогда
		НаборПолей = OData4_Модель.НайтиНабор(Полная, НаборПолной.Родитель);
		ПрефиксПолей = СоединитьПуть(Префикс, "Ссылка");
	Иначе
		НаборПолей = OData4_ПрофильМодели.НаборПолей(Полная, НаборПолной);
		ПрефиксПолей = Префикс;
	КонецЕсли;
	ДобавитьУсловияОбъекта(Результат, Описание, Полная, Параметры, ПолноеИмя, НаборПолей, ПрефиксПолей, Неопределено);
	Возврат Результат;
КонецФункции

// Условие отборов профиля для параметра «Условие» виртуальной таблицы набора Набор (поля без псевдонима):
// Структура «Текст ("" — нет условий), Запрет (Истина — отбор профиля нельзя выразить полями виртуальной таблицы:
// строки не выдаются), Ошибка». Поля остатков и оборотов — измерения описания; у срезов и движений с субконто —
// все поля регистра.
Функция УсловиеВиртуальнойТаблицы(Параметры, Набор, Описание0) Экспорт
	Результат = Новый Структура("Текст, Запрет, Ошибка, Условия", "", Ложь, Неопределено, Новый Массив);
	Описание = ОписаниеСОтборами();
	Если Описание = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Полная = OData4_МодельПовтИсп.ПолнаяМодель();
	НаборПолной = OData4_Модель.НайтиНабор(Полная, Набор.Имя);
	Если НаборПолной = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ПолноеИмя = OData4_ПрофильМодели.ПолноеИмяОбъекта(НаборПолной);
	НаборПолей = OData4_ПрофильМодели.НаборПолей(Полная, НаборПолной);
	Допустимые = Неопределено;
	Таблица = Описание0.Таблица;
	Если Таблица <> "СрезПоследних" И Таблица <> "СрезПервых" И Таблица <> "ДвиженияССубконто" Тогда
		// Условие таблицы остатков и оборотов 1С принимает только измерения.
		Допустимые = Новый Соответствие;
		Для Каждого Измерение Из Описание0.Измерения Цикл
			Допустимые.Вставить(Измерение.Имя1С, Истина);
		КонецЦикла;
	КонецЕсли;
	ДобавитьУсловияОбъекта(Результат, Описание, Полная, Параметры, ПолноеИмя, НаборПолей, "", Допустимые);
	Результат.Текст = СтрСоединить(Результат.Условия, " И ");
	Возврат Результат;
КонецФункции

// Условие цели навигации для пути генератора: условия профиля набора Набор по полям через Префикс (путь до
// связанного объекта, например «Т.Контрагент»), соединённые через И, или "" — отборов нет. Исключений не бросает:
// Структура «Текст, Ошибка».
Функция УсловиеЦелиНавигации(Параметры, Набор, Префикс) Экспорт
	Итог = УсловияНабора(Параметры, Набор, Префикс);
	Возврат Новый Структура("Текст, Ошибка", СтрСоединить(Итог.Условия, " И "), Итог.Ошибка);
КонецФункции

// Чтение по токену выполняется в привилегированном режиме (сервис odatat, режим «Привилегированный»).
Функция ПривилегированноеЧтение() Экспорт
	Контекст = OData4_БезопасностьВызов.Контекст();
	Возврат Контекст.Сервис = "odatat" И Контекст.Настройки <> Неопределено
		И Контекст.Настройки.РежимПравСлужебногоПользователя = "Привилегированный";
КонецФункции

// Исключение платформы «Недостаточно прав…» — нарушение прав пользователя 1С (служебного или Basic). При записи
// (6.2) платформа сообщает «Нарушение прав доступа!» — тоже нарушение прав.
Функция ЭтоНарушениеПрав(Информация) Экспорт
	Возврат СтрНайти(Информация.Описание, "Недостаточно прав") > 0 Или СтрНайти(Информация.Описание, "Нарушение прав доступа") > 0;
КонецФункции

// Имя пользователя из значения заголовка Authorization строго формы «Basic <base64>» (решение контроллера 5.2):
// схема Basic без учёта регистра, ровно один пробел, base64 из [A-Za-z0-9+/] с верным дополнением «=», без
// пробельных знаков и без хвоста; декодированное значение содержит двоеточие. Иная форма — Неопределено (401):
// платформа такой заголовок не разбирает и на публикации с фиксированным пользователем пропускает без пароля.
// Регистр схемы платформа не различает (RFC 7617; проба отзыва безопасности на обычной публикации и на публикации
// с фиксированным пользователем: «basic», «BASIC», «bAsIc» с верным паролем — 200, с неверным — 401 веб-сервера),
// поэтому и здесь он не важен: иначе отвергались бы запросы, которые платформа уже проверила.
Функция ИмяИзЗаголовкаBasic(Значение) Экспорт
	Если ТипЗнч(Значение) <> Тип("Строка") Или СтрДлина(Значение) < 7 Или НРег(Лев(Значение, 6)) <> "basic " Тогда
		Возврат Неопределено;
	КонецЕсли;
	Код = Сред(Значение, 7);
	Длина = СтрДлина(Код);
	Если Длина = 0 Или Длина % 4 <> 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Алфавит = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
	Дополнение = 0;
	Для Номер = 1 По Длина Цикл
		Знак = Сред(Код, Номер, 1);
		Если Знак = "=" Тогда
			Дополнение = Дополнение + 1;
		ИначеЕсли Дополнение > 0 Или СтрНайти(Алфавит, Знак) = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	Если Дополнение > 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Данные = Base64Значение(Код);
		Текст = ?(Данные = Неопределено, "", ПолучитьСтрокуИзДвоичныхДанных(Данные, "UTF-8"));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Двоеточие = СтрНайти(Текст, ":");
	Если Двоеточие = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Лев(Текст, Двоеточие - 1);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Basic: заголовок Authorization «Basic <base64 имя:пароль>» с именем текущего пользователя ИБ. Платформа
// аутентифицировала такой запрос сама (неверный пароль — 401 веб-сервера); на публикации с фиксированным
// пользователем заголовок без пароля или не Basic платформа пропускает под фиксированным пользователем.
Процедура ПроверитьАутентификациюBasic(Запрос)
	Значение = Неопределено;
	Для Каждого КлючИЗначение Из Запрос.Заголовки Цикл
		Если НРег(КлючИЗначение.Ключ) = "authorization" Тогда
			Значение = КлючИЗначение.Значение;
		КонецЕсли;
	КонецЦикла;
	Если Значение = Неопределено Или Значение = "" Тогда
		OData4_Сервис.ОшибкаOData(401, "Unauthorized",
			"Сервис odata требует аутентификации Basic: заголовок Authorization не получен");
	КонецЕсли;
	Имя = ИмяИзЗаголовкаBasic(Значение);
	Если Имя = Неопределено Или НРег(Имя) <> НРег(ИмяПользователя()) Тогда
		OData4_Сервис.ОшибкаOData(401, "Unauthorized",
			"Сервис odata требует аутентификации Basic: заголовок Authorization не подтверждает пользователя");
	КонецЕсли;
КонецПроцедуры

Процедура ВойтиBasic(Контекст, Настройки)
	Имя = ИмяПользователя();
	Контекст.Субъект = "u:" + Имя;
	Контекст.ИмяСубъекта = Имя;
	Если Не Настройки.РазрешитьBasicСлужебнымУчёткам И ЭтоСлужебнаяУчётка(Имя) Тогда
		// Отзыв безопасности, группа A: служебная учётка — фиксированный пользователь публикации токенов; её пароль
		// лежит в default.vrd, а профиль ей приходит только из токена. По Basic без профиля она видела бы всё, что
		// дают её роли (в режиме «Роли расширения» — весь состав), мимо профилей токенов.
		OData4_Сервис.ОшибкаOData(403, "Forbidden", "Вход по Basic на сервис odata служебной учётке публикации токенов "
			+ "запрещён (настройки OData4, вкладка «Аутентификация»: «Разрешить Basic служебным учёткам»)");
	КонецЕсли;
	Найден = Ложь;
	Профиль = Неопределено;
	Версия = "";
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Профиль КАК Профиль,
		|	П.Профиль.ВерсияДанных КАК Версия
		|ИЗ
		|	РегистрСведений.OData4_ПрофилиПользователей КАК П
		|ГДЕ
		|	П.Пользователь = &Имя");
		Запрос.УстановитьПараметр("Имя", Имя);
		Выборка = OData4_Хранилище.ВыполнитьЗапрос(Запрос).Выбрать();
		Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Профиль) Тогда
			Найден = Истина;
			Профиль = Выборка.Профиль;
			Версия = Выборка.Версия;
		КонецЕсли;
		ЗапомнитьПрочитанное(OData4_ПрофилиКэш.ПамятьСеанса(), "Пользователь", НРег(Имя),
			Новый Структура("Найден, Профиль, Версия", Найден, Профиль, Версия), ТекущаяУниверсальнаяДата());
	Исключение
		Информация = ИнформацияОбОшибке();
		Прочитанное = ЗначениеПриСбое(OData4_ПрофилиКэш.ПамятьСеанса(), "Пользователь", НРег(Имя), Информация,
			ТекущаяУниверсальнаяДата());
		Если Прочитанное = Неопределено Тогда
			Недоступно("Профиль пользователя не прочитан", Информация);
		КонецЕсли;
		ПредупредитьОПрочитанномРанее("Профиль пользователя " + Имя, Информация);
		Найден = Прочитанное.Найден;
		Профиль = Прочитанное.Профиль;
		Версия = Прочитанное.Версия;
	КонецПопытки;
	Если Не Найден Тогда
		Если Настройки.СтрогийРежимBasic Тогда
			OData4_Сервис.ОшибкаOData(403, "Forbidden", "Пользователю " + Имя + " не назначен профиль OData4");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ЗаполнитьПрофиль(Контекст, Профиль, Версия);
КонецПроцедуры

// Токен: заголовок X-OData4-Token, иначе путь «/t/<токен>/v4/…» (см. ЗапросСТокеномВПути), иначе параметр token.
Процедура ВойтиПоТокену(Запрос, Контекст, Настройки)
	Токен = ЗначениеЗаголовка(Запрос, "X-OData4-Token");
	Источник = "Заголовок";
	ТокенПути = "";
	Если ТипЗнч(Запрос) = Тип("Структура") Тогда
		Запрос.Свойство("ТокенПути", ТокенПути);
	КонецЕсли;
	Если Токен = "" И ЗначениеЗаполнено(ТокенПути) Тогда
		Токен = ТокенПути;
		Источник = "Путь";
	ИначеЕсли Токен = "" Тогда
		Токен = ПараметрЗапроса(Запрос, "token");
		Источник = "Адрес";
	КонецЕсли;
	Продолжение = ПараметрЗапроса(Запрос, "cont");
	Если Продолжение <> "" И Настройки.ТокеныПродолжения Тогда
		// Токен заголовка и пути сверяется с исходным токеном ключа.
		ВойтиПоПродолжению(Запрос, Контекст, Настройки, Продолжение, ?(Источник = "Адрес", "", Токен));
		Возврат;
	КонецЕсли;
	Если Токен = "" Тогда
		OData4_Сервис.ОшибкаOData(401, "Unauthorized", "Нет токена доступа");
	КонецЕсли;
	Если Не OData4_Профили.ФорматТокенаВерен(Токен) Тогда
		OData4_Сервис.ОшибкаOData(401, "Unauthorized", "Неверный формат токена доступа");
	КонецЕсли;
	Хеш = OData4_Профили.ХешТокена(Токен);
	Данные = ДанныеТокена(Хеш);
	ПроверитьТокен(Запрос, Данные);
	Контекст.Субъект = "t:" + Строка(Данные.Ссылка.УникальныйИдентификатор());
	Контекст.ИмяСубъекта = Данные.Наименование;
	Контекст.ИсточникТокена = Источник;
	Контекст.Токен = Токен;
	Контекст.ХешТокена = Хеш;
	ЗаполнитьПрофиль(Контекст, Данные.Профиль, Данные.ВерсияПрофиля);
	ОтметитьИспользование(Данные);
	ЗапомнитьСлужебнуюУчётку();
КонецПроцедуры

// Запрос по ключу продолжения: ключ одноразовый, привязан к исходному токену, набору и параметрам ссылки;
// любое несовпадение — 401 с одним текстом. Токен в заголовке допускается, только если это исходный токен.
Процедура ВойтиПоПродолжению(Запрос, Контекст, Настройки, Ключ, ТокенЗаголовка)
	ТекстОтказа = "Ключ продолжения недействителен";
	Если СтрДлина(Ключ) <> 72 Или Не OData4_Профили.ТолькоBase32(Ключ) Тогда
		OData4_Сервис.ОшибкаOData(401, "Unauthorized", ТекстОтказа);
	КонецЕсли;
	ХешКлюча = OData4_Профили.ХешТокена(Ключ);
	КаноническиеПараметры0 = КаноническиеПараметры(Запрос.ПараметрыЗапроса);
	Набор = ПутьРесурса(Запрос.ОтносительныйURL);
	Верен = Ложь;
	ХешТокена = "";
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.OData4_ТокеныПродолжения");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("ХешКлюча", ХешКлюча);
		Блокировка.Заблокировать();
		// Чтение — запросом (решение контроллера: менеджеры записей на пути запроса дают 500 платформы на границе
		// простоя сеанса); менеджер — только для записи отметки «использован».
		ЗапросКлюча = Новый Запрос(
		"ВЫБРАТЬ
		|	К.ХешТокена КАК ХешТокена,
		|	К.Профиль КАК Профиль,
		|	К.Набор КАК Набор,
		|	К.Параметры КАК Параметры,
		|	К.Срок КАК Срок,
		|	К.Использован КАК Использован
		|ИЗ
		|	РегистрСведений.OData4_ТокеныПродолжения КАК К
		|ГДЕ
		|	К.ХешКлюча = &ХешКлюча");
		ЗапросКлюча.УстановитьПараметр("ХешКлюча", ХешКлюча);
		Выборка = OData4_Хранилище.ВыполнитьЗапрос(ЗапросКлюча).Выбрать();
		Если Выборка.Следующий() И Не Выборка.Использован Тогда
			Верен = Выборка.Срок >= ТекущаяУниверсальнаяДата() И Выборка.Набор = Набор
				И Выборка.Параметры = КаноническиеПараметры0;
			// Ключ одноразовый: и неудачная попытка его расходует.
			ХешТокена = Выборка.ХешТокена;
			ЗаписатьПродолжение(Новый Структура("ХешКлюча, ХешТокена, Профиль, Набор, Параметры, Срок, Использован",
				ХешКлюча, Выборка.ХешТокена, Выборка.Профиль, Выборка.Набор, Выборка.Параметры, Выборка.Срок, Истина));
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Недоступно("Ключ продолжения не прочитан", ИнформацияОбОшибке());
	КонецПопытки;
	Если Не Верен Тогда
		OData4_Сервис.ОшибкаOData(401, "Unauthorized", ТекстОтказа);
	КонецЕсли;
	Если ТокенЗаголовка <> "" И OData4_Профили.ХешТокена(ТокенЗаголовка) <> ХешТокена Тогда
		OData4_Сервис.ОшибкаOData(401, "Unauthorized", ТекстОтказа);
	КонецЕсли;
	Данные = ДанныеТокена(ХешТокена, ТекстОтказа);
	ПроверитьТокен(Запрос, Данные, ТекстОтказа);
	Контекст.Субъект = "t:" + Строка(Данные.Ссылка.УникальныйИдентификатор());
	Контекст.ИмяСубъекта = Данные.Наименование;
	Контекст.ИсточникТокена = "Продолжение";
	Контекст.ХешТокена = ХешТокена;
	ЗаполнитьПрофиль(Контекст, Данные.Профиль, Данные.ВерсияПрофиля);
	ОтметитьИспользование(Данные);
	ЗапомнитьСлужебнуюУчётку();
КонецПроцедуры

// Данные токена по хешу; нет — 401 «Токен доступа не найден» (или ТекстОтказа, если задан).
Функция ДанныеТокена(Хеш, ТекстОтказа = "")
	Найден = Ложь;
	Данные = Новый Структура("Ссылка, Наименование, Профиль, ВерсияПрофиля, СрокДействия, Активен, ПометкаУдаления,
		|РазрешённыеIP, ДатаПоследнегоИспользования");
	Попытка
		Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.Ссылка КАК Ссылка,
		|	Т.Наименование КАК Наименование,
		|	Т.Профиль КАК Профиль,
		|	Т.Профиль.ВерсияДанных КАК ВерсияПрофиля,
		|	Т.СрокДействия КАК СрокДействия,
		|	Т.Активен КАК Активен,
		|	Т.ПометкаУдаления КАК ПометкаУдаления,
		|	Т.РазрешённыеIP КАК РазрешённыеIP,
		|	Т.ДатаПоследнегоИспользования КАК ДатаПоследнегоИспользования
		|ИЗ
		|	Справочник.OData4_Токены КАК Т
		|ГДЕ
		|	Т.ХешТокена = &Хеш");
		Запрос.УстановитьПараметр("Хеш", Хеш);
		Выборка = OData4_Хранилище.ВыполнитьЗапрос(Запрос).Выбрать();
		Если Выборка.Следующий() Тогда
			Найден = Истина;
			ЗаполнитьЗначенияСвойств(Данные, Выборка);
		КонецЕсли;
		Копия = Новый Структура("Найден", Найден);
		Для Каждого КлючИЗначение Из Данные Цикл
			Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		ЗапомнитьПрочитанное(OData4_ПрофилиКэш.ПамятьСеанса(), "Токен", Хеш, Копия, ТекущаяУниверсальнаяДата());
	Исключение
		Информация = ИнформацияОбОшибке();
		Прочитанное = ЗначениеПриСбое(OData4_ПрофилиКэш.ПамятьСеанса(), "Токен", Хеш, Информация,
			ТекущаяУниверсальнаяДата());
		Если Прочитанное = Неопределено Тогда
			Недоступно("Токен доступа не прочитан", Информация);
		КонецЕсли;
		ПредупредитьОПрочитанномРанее("Токен доступа", Информация);
		Найден = Прочитанное.Найден;
		ЗаполнитьЗначенияСвойств(Данные, Прочитанное);
	КонецПопытки;
	Если Не Найден Тогда
		OData4_Сервис.ОшибкаOData(401, "Unauthorized", ?(ТекстОтказа = "", "Токен доступа не найден", ТекстОтказа));
	КонецЕсли;
	Возврат Данные;
КонецФункции

// Активность, срок, профиль и адрес клиента токена; нарушение — 401 с фактом (или ТекстОтказа, если задан).
// Отзыв безопасности, группа A: ответ не называет ни токен, ни адрес клиента — они уходят в журнал регистрации
// (событие OData4.Безопасность). Ограничение по адресу проверяется по доверенному заголовку прокси; если у токена
// есть разрешённые IP, а заголовок не настроен или ему не доверяют, адрес проверить нечем — отказ (прежде такой
// токен пропускался с любого адреса): Запрос.Контекст с адресом соединения в режиме совместимости 8.3.11 недоступен.
Процедура ПроверитьТокен(Запрос, Данные, ТекстОтказа = "")
	Если Не Данные.Активен Или Данные.ПометкаУдаления Тогда
		ОтказТокена("Токен доступа отозван", ТекстОтказа, Данные.Наименование);
	КонецЕсли;
	Если ЗначениеЗаполнено(Данные.СрокДействия) И Данные.СрокДействия < ТекущаяДатаСеанса() Тогда
		ОтказТокена("Срок действия токена доступа истёк", ТекстОтказа, Данные.Наименование);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Данные.Профиль) Тогда
		ОтказТокена("У токена доступа нет профиля", ТекстОтказа, Данные.Наименование);
	КонецЕсли;
	Разрешённые = Новый Массив;
	Для Каждого Адрес Из СтрРазделить(Данные.РазрешённыеIP, "," + Символы.ПС + Символы.ВК + " ", Ложь) Цикл
		Разрешённые.Добавить(НРег(СокрЛП(Адрес)));
	КонецЦикла;
	Если Разрешённые.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Если Не АдресКлиентаПроверяется() Тогда
		ОтказТокена("Ограничение токена по адресу клиента не проверяется: не настроен доверенный заголовок адреса "
			+ "клиента (настройки OData4, вкладка «Аутентификация»)", ТекстОтказа, Данные.Наименование);
	КонецЕсли;
	Адрес = НРег(АдресКлиента(Запрос));
	Если Не АдресРазрешён(Адрес, Разрешённые) Тогда
		ОтказТокена("Адрес клиента не разрешён токеном", ТекстОтказа,
			Данные.Наименование + ", адрес " + ?(Адрес = "", "не определён", Адрес));
	КонецЕсли;
КонецПроцедуры

// Разрешён ли адрес клиента списком токена: точное совпадение строк или вхождение в подсеть IPv4
// «адрес/длина» (дефект приёмки 5.3 Д2: подсеть принималась проверкой ввода, но сравнивалась как строка).
// Подсетей IPv6 нет: проверка ввода их отвергает, адреса IPv6 сравниваются целиком.
Функция АдресРазрешён(Адрес, Разрешённые) Экспорт
	Если Разрешённые.Найти(Адрес) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Число0 = ЧислоIPv4(Адрес);
	Если Число0 = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого Разрешённый Из Разрешённые Цикл
		Косая = СтрНайти(Разрешённый, "/");
		Если Косая = 0 Тогда
			Продолжить;
		КонецЕсли;
		Сеть = ЧислоIPv4(Лев(Разрешённый, Косая - 1));
		Длина = Сред(Разрешённый, Косая + 1);
		Если Сеть = Неопределено Или Не ЦелоеЧисло(Длина) Или Число(Длина) > 32 Тогда
			Продолжить;
		КонецЕсли;
		Если ПрефиксСовпадает(Число0, Сеть, Число(Длина)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Совпадают ли старшие Длина бит двух адресов IPv4 (числа 0…2^32−1). Без регулярных выражений и побитовых
// операций: сравниваются целые части чисел, делённых на размер блока подсети.
Функция ПрефиксСовпадает(Первый, Второй, Длина)
	Если Длина = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Блок = Pow(2, 32 - Длина);
	Возврат Цел(Первый / Блок) = Цел(Второй / Блок);
КонецФункции

// Адрес IPv4 числом (0…2^32−1); не адрес — Неопределено.
Функция ЧислоIPv4(Текст)
	Части = СтрРазделить(СокрЛП(Текст), ".", Истина);
	Если Части.Количество() <> 4 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = 0;
	Для Каждого Часть Из Части Цикл
		Если Не ЦелоеЧисло(Часть) Или Число(Часть) > 255 Тогда
			Возврат Неопределено;
		КонецЕсли;
		Результат = Результат * 256 + Число(Часть);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Строка из одних цифр длиной не больше трёх.
Функция ЦелоеЧисло(Текст)
	Если ПустаяСтрока(Текст) Или СтрДлина(Текст) > 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Номер, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// 401 с Текст (или ТекстОтказа, если задан); Подробности (имя токена, адрес клиента) — только в журнал регистрации.
Процедура ОтказТокена(Текст, ТекстОтказа, Подробности = "")
	Если Подробности <> "" Тогда
		ЗаписьЖурналаРегистрации("OData4.Безопасность", УровеньЖурналаРегистрации.Предупреждение, , ,
			Текст + ": токен " + Подробности);
	КонецЕсли;
	OData4_Сервис.ОшибкаOData(401, "Unauthorized", ?(ТекстОтказа = "", Текст, ТекстОтказа));
КонецПроцедуры

Процедура ЗаполнитьПрофиль(Контекст, Профиль, Версия)
	Контекст.Профиль = Профиль;
	Попытка
		Контекст.ОписаниеПрофиля = OData4_ПрофилиКэш.Описание(Профиль, Версия);
	Исключение
		Недоступно("Профиль OData4 не прочитан", ИнформацияОбОшибке());
	КонецПопытки;
	Контекст.КлючПрофиля = "Профиль:" + Строка(Профиль.УникальныйИдентификатор()) + ":" + Строка(Версия);
КонецПроцедуры

// Дата последнего использования токена — не чаще раза в 10 минут; сбой записи ответ не меняет.
Процедура ОтметитьИспользование(Данные)
	Сейчас = ТекущаяДатаСеанса();
	Если ЗначениеЗаполнено(Данные.ДатаПоследнегоИспользования) И Сейчас - Данные.ДатаПоследнегоИспользования < 600 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ОбъектТокена = Данные.Ссылка.ПолучитьОбъект();
		ОбъектТокена.ДатаПоследнегоИспользования = Сейчас;
		ОбъектТокена.ОбменДанными.Загрузка = Истина;
		ОтключитьКонтрольУдаляемых(ОбъектТокена);
		ОбъектТокена.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("OData4.Безопасность", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Дата последнего использования токена не записана: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

// Служебная учётка (текущий пользователь сервиса odatat) дописывается в настройку СлужебныеПользователи без
// увеличения ВерсияНастроек: список не влияет на модель. Сбой записи ответ не меняет.
Процедура ЗапомнитьСлужебнуюУчётку()
	Имя = ИмяПользователя();
	Если СлужебныеУчётки().Найти(Имя) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ДописатьСлужебнуюУчётку(Имя);
	Исключение
		ЗаписьЖурналаРегистрации("OData4.Безопасность", УровеньЖурналаРегистрации.Предупреждение, , ,
			"Служебная учётка " + Имя + " не запомнена: " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры

// Дописывает Имя в ресурс СлужебныеПользователи единственной записи OData4_Настройки (остальные ресурсы — как были)
// набором записей: подписка БСП «ПередЗаписью» (контроль удаляемых объектов) читает параметр сеанса, на который
// у служебного пользователя без базовой роли конфигурации нет прав («Нарушение прав доступа!», проба 5.2);
// для технической записи хранилища OData4 этот контроль отключается дополнительным свойством.
Процедура ДописатьСлужебнуюУчётку(Имя)
	Блокировка = Новый БлокировкаДанных;
	Блокировка.Добавить("РегистрСведений.OData4_Настройки");
	НачатьТранзакцию();
	Попытка
		Блокировка.Заблокировать();
		Набор = РегистрыСведений.OData4_Настройки.СоздатьНаборЗаписей();
		Набор.Прочитать();
		Запись = ?(Набор.Количество() = 0, Набор.Добавить(), Набор[0]);
		Список = СтрРазделить(Запись.СлужебныеПользователи, Символы.ПС, Ложь);
		Если Список.Найти(Имя) = Неопределено Тогда
			Список.Добавить(Имя);
			Запись.СлужебныеПользователи = СтрСоединить(Список, Символы.ПС);
			ОтключитьКонтрольУдаляемых(Набор);
			Набор.Записать();
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

// Запись ключа продолжения (Значения — поля записи регистра OData4_ТокеныПродолжения) набором по ХешКлюча.
Процедура ЗаписатьПродолжение(Значения)
	Набор = РегистрыСведений.OData4_ТокеныПродолжения.СоздатьНаборЗаписей();
	Набор.Отбор.ХешКлюча.Установить(Значения.ХешКлюча);
	ЗаполнитьЗначенияСвойств(Набор.Добавить(), Значения);
	ОтключитьКонтрольУдаляемых(Набор);
	Набор.Записать();
КонецПроцедуры

// Техническая запись хранилища OData4 не проходит контроль удаляемых объектов БСП (подписка «ПередЗаписью» на все
// объекты): ему нужны права, которых у служебного пользователя может не быть.
Процедура ОтключитьКонтрольУдаляемых(Объект)
	// Единственное место (решение контроллера 5.2): подписка БСП УдалениеПомеченныхОбъектовСлужебный
	// .ЗапретитьИспользованиеУдаляемыхОбъектов читает параметр сеанса ВыполняетсяУдалениеОбъектов, который служебный
	// пользователь без базовой роли конфигурации читать не может («Нарушение прав доступа!»); это свойство подписка
	// проверяет первым и пропускает контроль. В конфигурации без БСП свойство никто не читает — оно ни на что не влияет.
	// Если запись всё же не удалась, вызывающий пишет в журнал регистрации подробный текст ошибки.
	Объект.ДополнительныеСвойства.Вставить("НеВыполнятьКонтрольУдаляемых", Истина);
КонецПроцедуры

// Счётчик окна: увеличивает на Приращение и возвращает число запросов субъекта по правилу в окне (исключительная
// блокировка).
Функция УвеличитьСчётчик(Субъект, Правило, НачалоОкна, Приращение = 1)
	Запросов = 0;
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("РегистрСведений.OData4_СчётчикиЗапросов");
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		Элемент.УстановитьЗначение("Субъект", Субъект);
		Элемент.УстановитьЗначение("Правило", Правило);
		Элемент.УстановитьЗначение("НачалоОкна", НачалоОкна);
		Блокировка.Заблокировать();
		// Чтение — запросом (решение контроллера), набор записей — только для записи.
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	С.Число КАК Число
		|ИЗ
		|	РегистрСведений.OData4_СчётчикиЗапросов КАК С
		|ГДЕ
		|	С.Субъект = &Субъект
		|	И С.Правило = &Правило
		|	И С.НачалоОкна = &НачалоОкна");
		Запрос.УстановитьПараметр("Субъект", Субъект);
		Запрос.УстановитьПараметр("Правило", Правило);
		Запрос.УстановитьПараметр("НачалоОкна", НачалоОкна);
		Выборка = OData4_Хранилище.ВыполнитьЗапрос(Запрос).Выбрать();
		Запросов = ?(Выборка.Следующий(), Выборка.Число, 0) + Приращение;
		Набор = РегистрыСведений.OData4_СчётчикиЗапросов.СоздатьНаборЗаписей();
		Набор.Отбор.Субъект.Установить(Субъект);
		Набор.Отбор.Правило.Установить(Правило);
		Набор.Отбор.НачалоОкна.Установить(НачалоОкна);
		Запись = Набор.Добавить();
		Запись.Субъект = Субъект;
		Запись.Правило = Правило;
		Запись.НачалоОкна = НачалоОкна;
		Запись.Число = Запросов;
		ОтключитьКонтрольУдаляемых(Набор);
		Набор.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Недоступно("Счётчик запросов не записан", ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Запросов;
КонецФункции

// 503 с фактом; подробности — в журнал регистрации (OData4.Безопасность).
// Запоминает в памяти сеанса удачно прочитанное значение хранилища вида Вид по ключу Ключ (имя пользователя, хеш
// токена) с моментом чтения (универсальное время).
Процедура ЗапомнитьПрочитанное(Память, Вид, Ключ, Значение, Момент) Экспорт
	Прочитанные = Память.Получить("Прочитанное:" + Вид);
	Если Прочитанные = Неопределено Тогда
		Прочитанные = Новый Соответствие;
		Память.Вставить("Прочитанное:" + Вид, Прочитанные);
	КонецЕсли;
	Прочитанные.Вставить(Ключ, Новый Структура("Значение, Момент", Значение, Момент));
КонецПроцедуры

// Значение, прочитанное ранее в этом сеансе, для сбоя чтения (решение контроллера 5.2): только при гонке сеанса
// платформы (OData4_Хранилище.ЭтоГонкаСеанса), только для того же ключа и не старше СрокПрочитанного() секунд;
// иначе — Неопределено (вызывающий отвечает 503).
Функция ЗначениеПриСбое(Память, Вид, Ключ, Информация, Момент) Экспорт
	Если Не OData4_Хранилище.ЭтоГонкаСеанса(Информация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Прочитанные = Память.Получить("Прочитанное:" + Вид);
	Прочитанное = ?(Прочитанные = Неопределено, Неопределено, Прочитанные.Получить(Ключ));
	Если Прочитанное = Неопределено Или Момент - Прочитанное.Момент > СрокПрочитанного()
		Или Момент < Прочитанное.Момент Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Прочитанное.Значение;
КонецФункции

// Наибольший возраст значения, прочитанного ранее, для гонки сеанса, секунд.
Функция СрокПрочитанного() Экспорт
	Возврат 300;
КонецФункции

Процедура ПредупредитьОПрочитанномРанее(Что, Информация)
	ЗаписьЖурналаРегистрации("OData4.Безопасность", УровеньЖурналаРегистрации.Предупреждение, , ,
		Что + ": таблица не прочитана (гонка сеанса), взято значение, прочитанное в этом сеансе не раньше "
		+ СрокПрочитанного() + " с назад: " + КраткоеПредставлениеОшибки(Информация));
КонецПроцедуры

Процедура Недоступно(Текст, Информация)
	ЗаписьЖурналаРегистрации("OData4.Безопасность", УровеньЖурналаРегистрации.Предупреждение, , ,
		Текст + ": " + ПодробноеПредставлениеОшибки(Информация));
	// Решение 16 и для 503: клиенту — постоянный текст, подробности — только в журнал регистрации.
	OData4_Сервис.ОшибкаOData(503, "ServiceUnavailable", Текст
		+ " (подробности — в журнале регистрации, событие OData4.Безопасность)");
КонецПроцедуры

// Настройки 5.2 из общего читателя OData4_НастройкиСервиса.Прочитать() (значения по умолчанию — в его
// ПоУмолчанию()). Сбой чтения — исключение.
Функция ПрочитатьНастройкиДоступа()
	Настройки = НастройкиПоУмолчанию();
	Прочитанные = OData4_НастройкиСервиса.Прочитать();
	Для Каждого КлючИЗначение Из НастройкиПоУмолчанию() Цикл
		Значение = Неопределено;
		Если Прочитанные.Свойство(КлючИЗначение.Ключ, Значение) И ЗначениеЗаполнено(Значение) Тогда
			Настройки.Вставить(КлючИЗначение.Ключ, ?(ТипЗнч(Значение) = Тип("Строка"), СокрЛП(Значение), Значение));
		КонецЕсли;
	КонецЦикла;
	Возврат Новый ФиксированнаяСтруктура(Настройки);
КонецФункции

Функция ЛимитыПрофиля()
	Контекст = OData4_БезопасностьВызов.Контекст();
	Если Контекст.ОписаниеПрофиля = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Контекст.ОписаниеПрофиля.Лимиты;
КонецФункции

Процедура ПроверитьTop(Значение, Наибольший)
	Если Значение <> Неопределено И Наибольший > 0 И Значение > Наибольший Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Значение $top больше " + Формат(Наибольший, "ЧН=0; ЧГ=0") + ": "
			+ Формат(Значение, "ЧН=0; ЧГ=0"));
	КонецЕсли;
КонецПроцедуры

// Описание профиля текущего запроса, если в нём есть отборы строк; иначе Неопределено.
Функция ОписаниеСОтборами()
	Описание = OData4_БезопасностьВызов.Контекст().ОписаниеПрофиля;
	Если Описание = Неопределено Или Не Описание.ЕстьОтборы Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Описание;
КонецФункции

// Добавляет в Результат.Условия условия отборов профиля объекта ПолноеИмя: шаблонные — по реквизитам, которые
// есть у объекта; выражения — генератором по НаборПолей полной модели через ПрефиксПолей. Допустимые —
// Соответствие полей, которыми можно выразить условие (Неопределено — любые); иначе Результат.Запрет = Истина.
// Ошибка перевода выражения — Результат.Ошибка (исключение генератора ловится здесь же, у его верхнего уровня).
Процедура ДобавитьУсловияОбъекта(Результат, Описание, Полная, Параметры, ПолноеИмя, НаборПолей, ПрефиксПолей, Допустимые)
	Контекст = OData4_Генератор.НовыйКонтекст(Полная, Параметры, НаборПолей, ПрефиксПолей);
	Контекст.Вставить("БезПрофиля", Истина);
	Для Каждого КлючИЗначение Из Описание.ОтборыШаблоны Цикл
		Реквизит = КлючИЗначение.Ключ;
		Если Не OData4_ПрофилиКэш.ЕстьПоле(ПолноеИмя, Реквизит) Тогда
			Продолжить;
		КонецЕсли;
		Если Допустимые <> Неопределено И Допустимые.Получить(Реквизит) <> Истина Тогда
			Результат.Запрет = Истина;
			Продолжить;
		КонецЕсли;
		Значения = Новый Массив;
		Для Каждого Значение Из КлючИЗначение.Значение Цикл
			Значения.Добавить(Значение);
		КонецЦикла;
		Результат.Условия.Добавить("(" + СоединитьПуть(ПрефиксПолей, Реквизит) + " В ("
			+ OData4_Генератор.ДобавитьПараметр(Контекст, Значения) + "))");
	КонецЦикла;
	Тексты = Описание.ОтборыОбъектов.Получить(ПолноеИмя);
	Если Тексты = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если НаборПолей = Неопределено Тогда
		// Объекта нет в модели (документ журнала без набора): выражение не перевести — строки закрываются.
		Результат.Запрет = Истина;
		Возврат;
	КонецЕсли;
	Для Каждого Текст Из Тексты Цикл
		Попытка
			Дерево = OData4_Разбор.РазобратьФильтр(Текст);
			Если Допустимые <> Неопределено И Не ТолькоДопустимыеПоля(Дерево, НаборПолей, Допустимые) Тогда
				Результат.Запрет = Истина;
			Иначе
				Результат.Условия.Добавить("(" + OData4_Генератор.Условие(Дерево, Контекст) + ")");
			КонецЕсли;
		Исключение
			// Выражения проверяются при записи профиля: сбой перевода здесь — внутренняя ошибка. Клиенту — 500 с
			// постоянным текстом (в тексте ошибки могли бы быть поля профиля, в том числе исключённые).
			ЗаписьЖурналаРегистрации("OData4", УровеньЖурналаРегистрации.Ошибка, , ,
				"Отбор профиля не применяется (" + ПолноеИмя + "): " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Если Результат.Ошибка = Неопределено Тогда
				Результат.Ошибка = OData4_Сервис.ТекстВнутреннейОшибки();
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Условие строк журнала документов НаборЖурнала модели Модель (решения 33, 38, 39 плана 5.2): Структура «Условия,
// Ошибка, Запрет», как у УсловияНабора. Строка видна, только если её вид документа входит в состав модели
// (Модель.Состав; так же скрывает строки неопубликованных документов standard.odata) и, при профиле Описание,
// профиль разрешает его чтение (объект, вид, «*»); отборы профиля документа X действуют на строки вида X через
// «ВЫРАЗИТЬ(Префикс.Ссылка КАК Документ.X)»: шаблоны — по реквизитам документа из метаданных (у документа без
// реквизита шаблон не действует, как у документов модели), выражения — по набору документа в модели, а у документа
// без набора ветка закрывается. Все виды видны без условий — условий нет (запрос как без профиля).
Функция УсловиеСтрокЖурнала(Параметры, Модель, НаборЖурнала, Префикс, Описание) Экспорт
	Результат = Новый Структура("Условия, Ошибка, Запрет", Новый Массив, Неопределено, Ложь);
	Журнал = Метаданные.НайтиПоПолномуИмени(OData4_ПрофильМодели.ПолноеИмяОбъекта(НаборЖурнала));
	Если Журнал = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	ПутьСсылки = СоединитьПуть(Префикс, "Ссылка");
	Ветви = Новый Массив;
	ВсеОткрыты = Истина;
	Для Каждого Документ Из Журнал.РегистрируемыеДокументы Цикл
		ПолноеИмя = Документ.ПолноеИмя();
		Если Модель.Состав.Получить(ПолноеИмя) = Неопределено
			Или Описание <> Неопределено И Не OData4_Профили.Разрешено(Описание, ПолноеИмя, "Чтение") Тогда
			ВсеОткрыты = Ложь;
			Продолжить;
		КонецЕсли;
		УсловиеВида = ПутьСсылки + " ССЫЛКА " + ПолноеИмя;
		Если Описание <> Неопределено И Описание.ЕстьОтборы Тогда
			Итог = Новый Структура("Условия, Ошибка, Запрет", Новый Массив, Неопределено, Ложь);
			ДобавитьУсловияОбъекта(Итог, Описание, Модель, Параметры, ПолноеИмя,
				OData4_ПрофильМодели.ОсновнойНабор(Модель, ПолноеИмя), "ВЫРАЗИТЬ(" + ПутьСсылки + " КАК " + ПолноеИмя + ")",
				Неопределено);
			Если Итог.Ошибка <> Неопределено И Результат.Ошибка = Неопределено Тогда
				Результат.Ошибка = Итог.Ошибка;
			КонецЕсли;
			Если Итог.Запрет Тогда
				ВсеОткрыты = Ложь;
				Продолжить;
			КонецЕсли;
			Если Итог.Условия.Количество() > 0 Тогда
				ВсеОткрыты = Ложь;
				УсловиеВида = УсловиеВида + " И " + СтрСоединить(Итог.Условия, " И ");
			КонецЕсли;
		КонецЕсли;
		Ветви.Добавить("(" + УсловиеВида + ")");
	КонецЦикла;
	Если Не ВсеОткрыты Тогда
		Результат.Условия.Добавить(?(Ветви.Количество() = 0, "ЛОЖЬ", "(" + СтрСоединить(Ветви, " ИЛИ ") + ")"));
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Все пути выражения (первые сегменты без переменной лямбды) — свойства набора с полями из Допустимые.
// Обход стеком, без рекурсии.
Функция ТолькоДопустимыеПоля(Дерево, Набор, Допустимые)
	Имена = Новый Соответствие;
	OData4_ВиртуальныеТаблицы.ДобавитьИменаПутей(Дерево, Имена);
	Для Каждого КлючИЗначение Из Имена Цикл
		Свойство = Набор.ПоИмени.Получить(КлючИЗначение.Ключ);
		Если Свойство = Неопределено Тогда
			Свойство = Набор.Навигация.Получить(КлючИЗначение.Ключ);
		КонецЕсли;
		Если Свойство = Неопределено Или Допустимые.Получить(Свойство.Поле) <> Истина Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция СоединитьПуть(Префикс, Поле)
	Возврат ?(Префикс = "", Поле, Префикс + "." + Поле);
КонецФункции

Функция ЭтоСекрет(Имя)
	ИмяНРег = НРег(СокрЛП(Имя));
	Возврат ИмяНРег = "token" Или ИмяНРег = "cont";
КонецФункции

// Значение параметра запроса без учёта регистра имени (Имя — строчными); нет — "".
Функция ПараметрЗапроса(Запрос, Имя)
	Для Каждого КлючИЗначение Из Запрос.ПараметрыЗапроса Цикл
		Если НРег(КлючИЗначение.Ключ) = Имя Тогда
			Возврат СокрЛП(КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Пользователь ИБ по имени (нужно право администрирования) или Неопределено.
Функция ПользовательИБ(Имя)
	Попытка
		Возврат ПользователиИнформационнойБазы.НайтиПоИмени(Имя);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

// Канонический текст параметров: пары «имя=значение» без token и cont, отсортированные, через «&».
// Принимает Соответствие параметров запроса или строку «a=1&b=2» (в кодировке URL).
Функция КаноническиеПараметры(Параметры) Экспорт
	Пары = Новый СписокЗначений;
	Если ТипЗнч(Параметры) = Тип("Строка") Тогда
		Для Каждого Часть Из СтрРазделить(Параметры, "&", Ложь) Цикл
			Равно = СтрНайти(Часть, "=");
			Имя = РаскодироватьСтроку(?(Равно = 0, Часть, Лев(Часть, Равно - 1)), СпособКодированияСтроки.КодировкаURL);
			Значение = ?(Равно = 0, "", РаскодироватьСтроку(Сред(Часть, Равно + 1), СпособКодированияСтроки.КодировкаURL));
			Если Не ЭтоСекрет(Имя) Тогда
				Пары.Добавить(Имя + "=" + Значение);
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого КлючИЗначение Из Параметры Цикл
			Если Не ЭтоСекрет(КлючИЗначение.Ключ) Тогда
				Пары.Добавить(КлючИЗначение.Ключ + "=" + КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Пары.СортироватьПоЗначению();
	Части = Новый Массив;
	Для Каждого Элемент Из Пары Цикл
		Части.Добавить(Элемент.Значение);
	КонецЦикла;
	Возврат СтрСоединить(Части, "&");
КонецФункции

// Запрос сервиса odatat с токеном в пути «/t/<токен>/v4/…»: Power BI и Excel строят адрес $metadata от корня
// сервиса и теряют параметр token, а путь сохраняют. Возвращает Структура с теми полями HTTPСервисЗапрос, которые
// читает сервис: HTTPМетод, ОтносительныйURL (без «/t/<токен>»), ПараметрыЗапроса, БазовыйURL (с «/t/<токен>»:
// ссылки ответа ведут туда же), Заголовки, Тело (строка UTF-8), и ТокенПути. Иной запрос возвращается как есть.
Функция ЗапросСТокеномВПути(Запрос, ИмяСервиса) Экспорт
	Если ИмяСервиса <> "odatat" Или Не СтрНачинаетсяС(Запрос.ОтносительныйURL, "/t/") Тогда
		Возврат Запрос;
	КонецЕсли;
	Остаток = Сред(Запрос.ОтносительныйURL, 4);
	Косая = СтрНайти(Остаток, "/");
	ТокенПути = ?(Косая = 0, Остаток, Лев(Остаток, Косая - 1));
	Попытка
		Тело = Запрос.ПолучитьТелоКакСтроку("UTF-8");
	Исключение
		Тело = "";
	КонецПопытки;
	Результат = Новый Структура("HTTPМетод, ОтносительныйURL, ПараметрыЗапроса, БазовыйURL, Заголовки, Тело, ТокенПути");
	Результат.HTTPМетод = Запрос.HTTPМетод;
	Результат.ОтносительныйURL = ?(Косая = 0, "", Сред(Остаток, Косая));
	Результат.ПараметрыЗапроса = Запрос.ПараметрыЗапроса;
	Результат.БазовыйURL = Запрос.БазовыйURL + "/t/" + ТокенПути;
	Результат.Заголовки = Запрос.Заголовки;
	Результат.Тело = ?(Тело = Неопределено, "", Тело);
	Результат.ТокенПути = ТокенПути;
	Возврат Результат;
КонецФункции

// Путь ресурса запроса после «/v4/»: «Catalog_X», «AccumulationRegister_X/Balance(…)».
Функция ПутьРесурса(ОтносительныйURL) Экспорт
	Путь = ОтносительныйURL;
	Если СтрНачинаетсяС(Путь, "/v4/") Тогда
		Путь = Сред(Путь, 5);
	КонецЕсли;
	Возврат Путь;
КонецФункции

#КонецОбласти
