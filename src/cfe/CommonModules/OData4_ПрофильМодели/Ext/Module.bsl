#Область ПрограммныйИнтерфейс

// Урезанная копия модели по описанию профиля (OData4_Профили.Описание), построенная целиком: только наборы, на
// объекты которых у профиля есть право «Чтение», без исключённых полей и табличных частей, без навигаций в наборы
// вне копии (свойство *_Key остаётся), с описаниями виртуальных таблиц без исключённых измерений и ресурсов.
// Исходная модель не меняется: у каждого изменённого набора копии — свои массивы и индексы. Плоские циклы, без
// рекурсии. Сеанс сервиса урезает модель лениво (МодельПрофиля).
Функция Урезать(Модель, Описание) Экспорт
	Копия = МодельПрофиля(Модель, Описание);
	ПостроитьВсё(Копия);
	Возврат Копия;
КонецФункции

// Модель профиля (этап 6.1): Порядок — открытые профилем наборы основы Модель; набор урезается при первом обращении
// (OData4_Модель.НайтиНабор → НаборПрофиля) из набора основы, который тоже строится по требованию. Решения о наборах
// (Разрешения) и урезанные наборы остаются в копии. Основа и описание профиля не меняются.
Функция МодельПрофиля(Модель, Описание) Экспорт
	Копия = Новый Структура;
	Копия.Вставить("Наборы", Новый Соответствие);
	Копия.Вставить("Перечисления", Модель.Перечисления);
	Копия.Вставить("Порядок", Новый Массив);
	Копия.Вставить("Состав", Модель.Состав);
	Копия.Вставить("ЕстьОписаниеТипов", Модель.ЕстьОписаниеТипов);
	Копия.Вставить("Основа", Модель);
	Копия.Вставить("Описание", Описание);
	Копия.Вставить("Разрешения", Новый Соответствие);
	Копия.Вставить("Построена", Ложь);
	Для Каждого Имя Из Модель.Порядок Цикл
		Если НаборРазрешён(Модель, Имя, Описание, Копия.Разрешения) Тогда
			Копия.Порядок.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Урезанный набор модели профиля Копия (МодельПрофиля) по имени или Неопределено, если профиль его не открывает.
Функция НаборПрофиля(Копия, Имя) Экспорт
	Набор = Копия.Наборы.Получить(Имя);
	Если Набор <> Неопределено Или OData4_Модель.ПостроенаЦеликом(Копия) Тогда
		Возврат Набор;
	КонецЕсли;
	Основа = Копия.Основа;
	Если Не НаборРазрешён(Основа, Имя, Копия.Описание, Копия.Разрешения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Исходный = OData4_Модель.НайтиНабор(Основа, Имя);
	Если Исходный = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Набор = КопияНабора(Основа, Исходный, Копия.Описание, Копия.Разрешения);
	Копия.Наборы.Вставить(Имя, Набор);
	Возврат Набор;
КонецФункции

// Достраивает модель профиля целиком: основу, затем все открытые профилем наборы основы, в том числе скрытые
// коллекции (их нет в Порядок).
Процедура ПостроитьВсё(Копия) Экспорт
	Основа = Копия.Основа;
	OData4_Модель.ПостроитьВсё(Основа);
	Копия.Перечисления = Основа.Перечисления;
	Копия.ЕстьОписаниеТипов = Основа.ЕстьОписаниеТипов;
	Для Каждого КлючИЗначение Из Основа.Наборы Цикл
		НаборПрофиля(Копия, КлючИЗначение.Ключ);
	КонецЦикла;
	Копия.Построена = Истина;
КонецПроцедуры

// Урезанная копия одного набора модели или Неопределено, если профиль набор не открывает. Разрешения —
// Соответствие имя набора → Булево, кэш решений (заполняется).
Функция УрезатьНабор(Модель, Набор, Описание, Разрешения) Экспорт
	Если Не НаборРазрешён(Модель, Набор.Имя, Описание, Разрешения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат КопияНабора(Модель, Набор, Описание, Разрешения);
КонецФункции

// Описание виртуальной таблицы без исключённых профилем измерений и ресурсов (для набора Набор полной модели).
Функция УрезатьОписание(Модель, Набор, Описание0, Описание, Разрешения) Экспорт
	Возврат КопияОписания(Модель, Описание0, ИсключённыеПоляНабора(Модель, Набор, Описание), Описание, Разрешения,
		Новый Соответствие);
КонецФункции

// Полное имя объекта метаданных набора («Справочник.Банки», «РегистрНакопления.X»): первые два сегмента
// таблицы запроса. У набора табличной части и набора записей — объект-владелец. У синтетических наборов
// (шаг $apply, результат функции) — "".
Функция ПолноеИмяОбъекта(Набор) Экспорт
	Части = СтрРазделить(Набор.ТаблицаЗапроса, ".");
	Если Части.Количество() < 2 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Части[0] + "." + Части[1];
КонецФункции

// Основной набор объекта в модели: набор справочника или документа, у регистра — набор записей (вид «Регистр»).
// Нет — Неопределено. Строит только наборы этого объекта (OData4_Модель.ОсновнойНабор).
Функция ОсновнойНабор(Модель, ПолноеИмя) Экспорт
	Возврат OData4_Модель.ОсновнойНабор(Модель, ПолноеИмя);
КонецФункции

// Набор, свойства которого описывают поля строки набора Набор для выражений отборов профиля: у набора записей
// по регистратору — набор записей регистра, иначе сам набор.
Функция НаборПолей(Модель, Набор) Экспорт
	Если Набор.Вид = "НаборЗаписей" И Набор.ТабличныеЧасти.Количество() > 0 Тогда
		Возврат OData4_Модель.НайтиНабор(Модель, Набор.ТабличныеЧасти[0]);
	КонецЕсли;
	Возврат Набор;
КонецФункции

// Набор открыт профилем: право «Чтение» на объект, табличная часть не исключена, поля ключа не исключены. Набор
// ленивой модели строится, только если профиль исключает поля его объекта (нужны поля ключа).
Функция НаборРазрешён(Модель, Имя, Описание, Разрешения) Экспорт
	Решение = Разрешения.Получить(Имя);
	Если Решение <> Неопределено Тогда
		Возврат Решение;
	КонецЕсли;
	Решение = Ложь;
	Сведения = OData4_Модель.СведенияНабора(Модель, Имя);
	Если Сведения = Неопределено И Не OData4_Модель.ПостроенаЦеликом(Модель) Тогда
		// Имени нет ни в индексе, ни среди построенных: это может быть скрытая коллекция ещё не построенного
		// владельца. Отказ не запоминается — после построения владельца решение принимается заново (Д1 QA 6.1).
		Возврат Ложь;
	КонецЕсли;
	Если Сведения <> Неопределено Тогда
		ПолноеИмя = Сведения.Объект;
		Решение = ПолноеИмя <> "" И OData4_Профили.Разрешено(Описание, ПолноеИмя, "Чтение");
		Если Решение И Сведения.Вид = "ТабличнаяЧасть" Тогда
			Исключённые = Описание.ИсключённыеПоля.Получить(ПолноеИмя);
			Решение = Исключённые = Неопределено Или Исключённые.ТабличныеЧасти.Найти(Сведения.ИмяВВладельце) = Неопределено;
		КонецЕсли;
		Если Решение Тогда
			Исключено = ИсключённыеПоля(ПолноеИмя, Сведения.Вид, Сведения.ИмяВВладельце, Описание);
			Набор = ?(Исключено.Количество() = 0, Неопределено, OData4_Модель.НайтиНабор(Модель, Имя));
			Если Набор <> Неопределено Тогда
				Для Каждого Свойство Из Набор.ПоляКлюча Цикл
					Если Свойство.Поле <> "" И Исключено.Получить(Свойство.Поле) = Истина Тогда
						// Без поля ключа строки набора неразличимы: набор закрывается целиком.
						Решение = Ложь;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Разрешения.Вставить(Имя, Решение);
	Возврат Решение;
КонецФункции

// Исключённые профилем поля 1С строки набора: Соответствие имя поля → Истина.
Функция ИсключённыеПоляНабора(Модель, Набор, Описание) Экспорт
	Возврат ИсключённыеПоля(ПолноеИмяОбъекта(Набор), Набор.Вид, Набор.ИмяВВладельце, Описание);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Исключённые профилем поля 1С строки набора вида Вид объекта ПолноеИмя (у табличной части — ИмяВВладельце):
// Соответствие имя поля → Истина.
Функция ИсключённыеПоля(ПолноеИмя, Вид, ИмяВВладельце, Описание)
	Результат = Новый Соответствие;
	Если Вид = "Журнал" Тогда
		ДобавитьИсключённыеГрафы(Результат, ПолноеИмя, Описание);
	КонецЕсли;
	Исключённые = Описание.ИсключённыеПоля.Получить(ПолноеИмя);
	Если Исключённые = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Если Вид = "ТабличнаяЧасть" Тогда
		Поля = Исключённые.ПоляТабличныхЧастей.Получить(ИмяВВладельце);
	Иначе
		Поля = Исключённые.Поля;
	КонецЕсли;
	Если Поля <> Неопределено Тогда
		Для Каждого Поле Из Поля Цикл
			Результат.Вставить(Поле, Истина);
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

// Графы журнала ПолноеИмя, исключённые профилем (решение контроллера 5.2, как у состава 5.1): графа исключается,
// если хотя бы в одном документе журнала она отображается на поле, которое профиль исключил у этого документа
// (или на реквизит исключённой табличной части). Результат — Соответствие имя графы → Истина (дополняется).
Процедура ДобавитьИсключённыеГрафы(Результат, ПолноеИмя, Описание)
	Если Описание.ИсключённыеПоля.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	Журнал = Метаданные.НайтиПоПолномуИмени(ПолноеИмя);
	Если Журнал = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Графа Из Журнал.Графы Цикл
		Для Каждого Реквизит Из Графа.Ссылки Цикл
			Части = СтрРазделить(Реквизит.ПолноеИмя(), ".");
			Если Части.Количество() < 4 Тогда
				Продолжить;
			КонецЕсли;
			Исключённые = Описание.ИсключённыеПоля.Получить(Части[0] + "." + Части[1]);
			Если Исключённые = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Исключена = Ложь;
			Если Части[2] = "ТабличнаяЧасть" И Части.Количество() >= 6 Тогда
				ПоляТЧ = Исключённые.ПоляТабличныхЧастей.Получить(Части[3]);
				Исключена = Исключённые.ТабличныеЧасти.Найти(Части[3]) <> Неопределено
					Или ПоляТЧ <> Неопределено И ПоляТЧ.Найти(Части[5]) <> Неопределено;
			Иначе
				Исключена = Исключённые.Поля.Найти(Части[3]) <> Неопределено;
			КонецЕсли;
			Если Исключена Тогда
				Результат.Вставить(Графа.Имя, Истина);
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

Функция КопияНабора(Модель, Набор, Описание, Разрешения)
	Если НаборНеИзменяется(Модель, Набор, Описание, Разрешения) Тогда
		// Профиль этот набор не меняет: в копии модели он тот же объект, что в полной (решение 40 плана 5.2 —
		// копия модели профиля занимала в сеансе столько же, сколько полная). Модели только читаются.
		Возврат Набор;
	КонецЕсли;
	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из Набор Цикл
		Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Исключено = ИсключённыеПоляНабора(Модель, Набор, Описание);
	Копии = Новый Соответствие;
	Копия.Свойства = ОтобратьСвойства(Модель, Набор.Свойства, Исключено, Описание, Разрешения, Копии, Ложь);
	Копия.ПоляКлюча = ОтобратьСвойства(Модель, Набор.ПоляКлюча, Исключено, Описание, Разрешения, Копии, Ложь);
	Копия.КлючПродолжения = ОтобратьСвойства(Модель, Набор.КлючПродолжения, Исключено, Описание, Разрешения, Копии,
		Ложь);
	Копия.ТабличныеЧасти = Новый Массив;
	Для Каждого ИмяТЧ Из Набор.ТабличныеЧасти Цикл
		Если НаборРазрешён(Модель, ИмяТЧ, Описание, Разрешения) Тогда
			Копия.ТабличныеЧасти.Добавить(ИмяТЧ);
		КонецЕсли;
	КонецЦикла;
	Копия.ВиртуальныеТаблицы = Новый Соответствие;
	Для Каждого КлючИЗначение Из Набор.ВиртуальныеТаблицы Цикл
		Копия.ВиртуальныеТаблицы.Вставить(КлючИЗначение.Ключ,
			КопияОписания(Модель, КлючИЗначение.Значение, Исключено, Описание, Разрешения, Копии));
	КонецЦикла;
	ЗаполнитьИндексы(Модель, Копия);
	Возврат Копия;
КонецФункции

// Профиль не меняет набор: у объекта нет исключённых полей (и граф журнала), все его табличные части открыты
// и все цели навигации разрешены. Тогда копия набора не нужна.
Функция НаборНеИзменяется(Модель, Набор, Описание, Разрешения)
	Если ИсключённыеПоляНабора(Модель, Набор, Описание).Количество() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого ИмяТЧ Из Набор.ТабличныеЧасти Цикл
		Если Не НаборРазрешён(Модель, ИмяТЧ, Описание, Разрешения) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Свойство Из Набор.Свойства Цикл
		Если Свойство.Вид = "Ссылка" И Свойство.ИмяНавигации <> ""
			И Не НаборРазрешён(Модель, Свойство.ЦелевойНабор, Описание, Разрешения) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Свойства без исключённых полей; навигация в набор вне профиля снимается (у копии свойства ИмяНавигации пусто).
// Копии — Соответствие исходное свойство → копия (одно свойство в нескольких массивах копируется один раз).
// ПоСуффиксу — поле результата виртуальной таблицы: исключено и поле с суффиксом ресурса («СуммаОстаток»).
Функция ОтобратьСвойства(Модель, Свойства, Исключено, Описание, Разрешения, Копии, ПоСуффиксу)
	Результат = Новый Массив;
	Для Каждого Свойство Из Свойства Цикл
		Если ПолеИсключено(Свойство.Поле, Исключено, ПоСуффиксу) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(КопияСвойства(Модель, Свойство, Описание, Разрешения, Копии));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КопияСвойства(Модель, Свойство, Описание, Разрешения, Копии)
	Копия = Копии.Получить(Свойство);
	Если Копия <> Неопределено Тогда
		Возврат Копия;
	КонецЕсли;
	Копия = Свойство;
	Если Свойство.Вид = "Ссылка" И Свойство.ИмяНавигации <> ""
		И Не НаборРазрешён(Модель, Свойство.ЦелевойНабор, Описание, Разрешения) Тогда
		Копия = Новый Структура;
		Для Каждого КлючИЗначение Из Свойство Цикл
			Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Копия.ИмяНавигации = "";
	КонецЕсли;
	Копии.Вставить(Свойство, Копия);
	Возврат Копия;
КонецФункции

// Поле исключено: совпадает с исключённым, а у поля результата виртуальной таблицы — ещё и исключённое поле
// с суффиксами ресурса, счёта или корреспонденции («СуммаОстаток», «СуммаОборотДт», «ВалютаКор»).
Функция ПолеИсключено(Поле, Исключено, ПоСуффиксу)
	Если Поле = "" Или Исключено.Количество() = 0 Тогда
		Возврат Ложь;
	ИначеЕсли Исключено.Получить(Поле) = Истина Тогда
		Возврат Истина;
	ИначеЕсли Не ПоСуффиксу Тогда
		Возврат Ложь;
	КонецЕсли;
	Суффиксы = СтрРазделить("Начальный,Конечный,Развернутый,Остаток,Приход,Расход,Оборот,Дт,Кт,Кор", ",");
	Для Каждого КлючИЗначение Из Исключено Цикл
		Имя = КлючИЗначение.Ключ;
		Если Не СтрНачинаетсяС(Поле, Имя) Тогда
			Продолжить;
		КонецЕсли;
		Остаток = Сред(Поле, СтрДлина(Имя) + 1);
		Пока Остаток <> "" Цикл
			Найден = Ложь;
			Для Каждого Суффикс Из Суффиксы Цикл
				Если СтрНачинаетсяС(Остаток, Суффикс) Тогда
					Остаток = Сред(Остаток, СтрДлина(Суффикс) + 1);
					Найден = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Не Найден Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если Остаток = "" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Копия описания виртуальной таблицы: свойства, измерения, ресурсы, обязательные и ключ без исключённых.
Функция КопияОписания(Модель, Описание0, Исключено, Описание, Разрешения, Копии)
	Копия = Новый Структура;
	Для Каждого КлючИЗначение Из Описание0 Цикл
		Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	Копия.Свойства = ОтобратьСвойства(Модель, Описание0.Свойства, Исключено, Описание, Разрешения, Копии, Истина);
	Копия.Ресурсы = ОтобратьСвойства(Модель, Описание0.Ресурсы, Исключено, Описание, Разрешения, Копии, Истина);
	Копия.Обязательные = ОтобратьСвойства(Модель, Описание0.Обязательные, Исключено, Описание, Разрешения, Копии,
		Истина);
	Копия.Ключ = ОтобратьСвойства(Модель, Описание0.Ключ, Исключено, Описание, Разрешения, Копии, Истина);
	Копия.Измерения = Новый Массив;
	Для Каждого Измерение Из Описание0.Измерения Цикл
		Если Исключено.Получить(Измерение.Имя1С) = Истина Тогда
			Продолжить;
		КонецЕсли;
		КопияИзмерения = Новый Структура;
		Для Каждого КлючИЗначение Из Измерение Цикл
			КопияИзмерения.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		КопияИзмерения.Свойства = ОтобратьСвойства(Модель, Измерение.Свойства, Исключено, Описание, Разрешения, Копии,
			Истина);
		Копия.Измерения.Добавить(КопияИзмерения);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// Индексы копии набора, как OData4_Модель.ЗаполнитьИндексы: ПоИмени, ВыборПоИмени, Навигация,
// ТабличныеЧастиПоИмени. Ключ — имена оставшихся полей ключа (и Имя_Type составных).
Процедура ЗаполнитьИндексы(Модель, Копия)
	ПоИмени = Новый Соответствие;
	ВыборПоИмени = Новый Соответствие;
	Навигация = Новый Соответствие;
	Для Каждого Свойство Из Копия.Свойства Цикл
		ПоИмени.Вставить(Свойство.Имя, Свойство);
		ВыборПоИмени.Вставить(Свойство.Имя, Свойство);
		Если Свойство.Вид = "Составной" Или Свойство.Вид = "Хранилище" Тогда
			ВыборПоИмени.Вставить(Свойство.Имя + "_Type", Свойство);
		КонецЕсли;
		Если Свойство.Вид = "Хранилище" Тогда
			ВыборПоИмени.Вставить(Свойство.Имя + "_Base64Data", Свойство);
		КонецЕсли;
		Если Свойство.Вид = "Ссылка" И Свойство.ИмяНавигации <> "" Тогда
			Навигация.Вставить(Свойство.ИмяНавигации, Свойство);
		КонецЕсли;
	КонецЦикла;
	ТабличныеЧасти = Новый Соответствие;
	Для Каждого ИмяТЧ Из Копия.ТабличныеЧасти Цикл
		ТабличныеЧасти.Вставить(OData4_Модель.НайтиНабор(Модель, ИмяТЧ).ИмяВВладельце, ИмяТЧ);
	КонецЦикла;
	Копия.Вставить("ПоИмени", ПоИмени);
	Копия.Вставить("ВыборПоИмени", ВыборПоИмени);
	Копия.Вставить("Навигация", Навигация);
	Копия.Вставить("ТабличныеЧастиПоИмени", ТабличныеЧасти);
КонецПроцедуры

#КонецОбласти
