#Область ПрограммныйИнтерфейс

// Добавляет в модель наборы объекта вида этапа 5.1 (ВидТаблицы — первая часть полного имени): план видов
// характеристик, план обмена, план видов расчёта, план счетов, бизнес-процесс, задача, константа или журнал
// документов. Имена, ключи, стандартные реквизиты и коллекции — как в standard.odata. Состав и права проверяет
// индекс модели (OData4_Модель.НоваяМодель).
Процедура ДобавитьОбъектВида(Модель, ОбъектМетаданных, ВидТаблицы) Экспорт
	Если ВидТаблицы = "Константа" Тогда
		ДобавитьКонстанту(Модель, ОбъектМетаданных);
		Возврат;
	ИначеЕсли ВидТаблицы = "ЖурналДокументов" Тогда
		ДобавитьЖурнал(Модель, ОбъектМетаданных);
		Возврат;
	КонецЕсли;
	Для Каждого Вид Из ВидыСсылочных() Цикл
		Если Вид.ВидТаблицы = ВидТаблицы Тогда
			ДобавитьОбъект(Модель, ОбъектМетаданных, Вид);
			Возврат;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Ссылочные виды этапа 5.1: Массив Структура("Префикс, Коллекция, ВидТаблицы, ВидСсылки").
Функция ВидыСсылочных() Экспорт
	Результат = Новый Массив;
	Результат.Добавить(НовыйВид("ChartOfCharacteristicTypes_", Метаданные.ПланыВидовХарактеристик,
		"ПланВидовХарактеристик", "ПланВидовХарактеристикСсылка"));
	Результат.Добавить(НовыйВид("ExchangePlan_", Метаданные.ПланыОбмена, "ПланОбмена", "ПланОбменаСсылка"));
	Результат.Добавить(НовыйВид("ChartOfCalculationTypes_", Метаданные.ПланыВидовРасчета, "ПланВидовРасчета",
		"ПланВидовРасчетаСсылка"));
	Результат.Добавить(НовыйВид("ChartOfAccounts_", Метаданные.ПланыСчетов, "ПланСчетов", "ПланСчетовСсылка"));
	Результат.Добавить(НовыйВид("BusinessProcess_", Метаданные.БизнесПроцессы, "БизнесПроцесс", "БизнесПроцессСсылка"));
	Результат.Добавить(НовыйВид("Task_", Метаданные.Задачи, "Задача", "ЗадачаСсылка"));
	Возврат Результат;
КонецФункции

// Имя свойства OData стандартного реквизита 1С новых видов; "" — реквизит не публикуется (как ЭтотУзел
// плана обмена у standard.odata).
Функция ИмяСтандартного(Имя) Экспорт
	Имена = Новый Соответствие;
	Имена.Вставить("ПометкаУдаления", "DeletionMark");
	Имена.Вставить("Предопределенный", "Predefined");
	Имена.Вставить("ИмяПредопределенныхДанных", "PredefinedDataName");
	Имена.Вставить("Код", "Code");
	Имена.Вставить("Наименование", "Description");
	Имена.Вставить("Родитель", "Parent");
	Имена.Вставить("Владелец", "Owner");
	Имена.Вставить("ЭтоГруппа", "IsFolder");
	Имена.Вставить("ТипЗначения", "ValueType");
	Имена.Вставить("Порядок", "Order");
	Имена.Вставить("Забалансовый", "OffBalance");
	Имена.Вставить("Вид", "Type");
	Имена.Вставить("НомерОтправленного", "SentNo");
	Имена.Вставить("НомерПринятого", "ReceivedNo");
	Имена.Вставить("Номер", "Number");
	Имена.Вставить("Дата", "Date");
	Имена.Вставить("Проведен", "Posted");
	Имена.Вставить("Стартован", "Started");
	Имена.Вставить("Завершен", "Completed");
	Имена.Вставить("ВедущаяЗадача", "HeadTask");
	Имена.Вставить("БизнесПроцесс", "BusinessProcess");
	Имена.Вставить("ТочкаМаршрута", "RoutePoint");
	Имена.Вставить("Выполнена", "Executed");
	Имена.Вставить("ПериодДействияБазовый", "ActionPeriodIsBasic");
	Имена.Вставить("Тип", "Type");
	ИмяOData = Имена.Получить(Имя);
	Возврат ?(ИмяOData = Неопределено, "", ИмяOData);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйВид(Префикс, Коллекция, ВидТаблицы, ВидСсылки)
	Возврат Новый Структура("Префикс, Коллекция, ВидТаблицы, ВидСсылки", Префикс, Коллекция, ВидТаблицы, ВидСсылки);
КонецФункции

// Ссылочный объект: Ref_Key, DataVersion, стандартные реквизиты вида, реквизиты (и признаки учёта плана счетов,
// реквизиты адресации задачи), общие реквизиты, табличные части и коллекции без собственного набора.
Процедура ДобавитьОбъект(Модель, ОбъектМетаданных, Вид)
	Имя = ОбъектМетаданных.Имя;
	Набор = OData4_Модель.НовыйНабор(Вид.Префикс + Имя, Вид.ВидТаблицы, Вид.ВидТаблицы + "." + Имя,
		Вид.ВидСсылки + "." + Имя, "");
	Набор.ПолеСвязи = "Ссылка";
	Набор.ТипСвязи = Новый ОписаниеТипов(Набор.ИмяТипаСсылки);
	Свойства = Набор.Свойства;
	Свойства.Добавить(OData4_Модель.СвойствоКлюча("Ref_Key", "Ссылка"));
	Свойства.Добавить(OData4_Модель.НовоеСвойство("DataVersion", "ВерсияДанных", "Примитив", "Edm.String"));
	ДобавитьСтандартные(Модель, Свойства, ОбъектМетаданных);
	Если Вид.ВидТаблицы = "ПланОбмена" Тогда
		// standard.odata объявляет ExchangeDate у каждого плана обмена и не выдаёт его: поля в 1С нет.
		ДатаОбмена = OData4_Модель.НовоеСвойство("ExchangeDate", "", "Пусто", OData4_Сериализация.ТипДаты("ДатаВремя"));
		ДатаОбмена.ЧастиДаты = "ДатаВремя";
		Свойства.Добавить(ДатаОбмена);
	КонецЕсли;
	ДобавитьПоляКоллекции(Модель, Свойства, ОбъектМетаданных.Реквизиты);
	Если Вид.ВидТаблицы = "ПланСчетов" Тогда
		ДобавитьПоляКоллекции(Модель, Свойства, ОбъектМетаданных.ПризнакиУчета);
	ИначеЕсли Вид.ВидТаблицы = "Задача" Тогда
		ДобавитьПоляКоллекции(Модель, Свойства, ОбъектМетаданных.РеквизитыАдресации);
	КонецЕсли;
	ДобавитьОбщиеРеквизиты(Модель, Свойства, ОбъектМетаданных, Вид.ВидТаблицы = "ПланОбмена");
	OData4_Модель.УбратьИсключённые(Модель, Набор, ОбъектМетаданных, "");
	OData4_Модель.ДобавитьТабличныеЧасти(Модель, Набор, ОбъектМетаданных);
	Если Вид.ВидТаблицы = "ПланСчетов" И ОбъектМетаданных.МаксКоличествоСубконто > 0
		И ОбъектМетаданных.ВидыСубконто <> Неопределено Тогда
		ДобавитьВидыСубконто(Модель, Набор, ОбъектМетаданных);
	ИначеЕсли Вид.ВидТаблицы = "ПланВидовРасчета" Тогда
		ДобавитьВидыРасчета(Модель, Набор, ОбъектМетаданных);
	КонецЕсли;
	OData4_Модель.ДобавитьНабор(Модель, Набор);
КонецПроцедуры

// Стандартные реквизиты по таблице ИмяСтандартного; типы — объявленные у реквизита (ссылка — «Имя_Key»
// с навигацией, составной — «Имя» и «Имя_Type»). Особые: ТипЗначения — описание типов, Вид плана счетов —
// вид счёта, ТочкаМаршрута — имя точки, Тип журнала — представление вида документа.
Процедура ДобавитьСтандартные(Модель, Свойства, ОбъектМетаданных)
	Для Каждого Реквизит Из ОбъектМетаданных.СтандартныеРеквизиты Цикл
		ИмяOData = ИмяСтандартного(Реквизит.Имя);
		Если ИмяOData = "" Или НулевойДлины(ОбъектМетаданных, Реквизит.Имя) Тогда
			Продолжить;
		ИначеЕсли Реквизит.Имя = "ТипЗначения" Тогда
			Свойства.Добавить(OData4_Модель.НовоеСвойство(ИмяOData, Реквизит.Имя, "ОписаниеТипов",
				"StandardODATA.TypeDescription"));
			Модель.Вставить("ЕстьОписаниеТипов", Истина);
		ИначеЕсли Реквизит.Имя = "Вид" Тогда
			СвойствоВида = OData4_Модель.НовоеСвойство(ИмяOData, Реквизит.Имя, "ВидДвижения", "Edm.String");
			СвойствоВида.Перечисление = "ВидСчета";
			Свойства.Добавить(СвойствоВида);
		ИначеЕсли Реквизит.Имя = "ТочкаМаршрута" Тогда
			Свойства.Добавить(OData4_Модель.НовоеСвойство(ИмяOData, Реквизит.Имя, "ТочкаМаршрута", "Edm.String"));
		ИначеЕсли Реквизит.Имя = "Тип" Тогда
			Свойства.Добавить(OData4_Модель.НовоеСвойство(ИмяOData, Реквизит.Имя, "ТипДокумента", "Edm.String"));
		Иначе
			OData4_Модель.ДобавитьРеквизит(Модель, Свойства, ИмяOData, Реквизит.Имя, Реквизит.Тип);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Код, наименование или номер нулевой длины у объекта не используются: standard.odata их не объявляет.
Функция НулевойДлины(ОбъектМетаданных, ИмяРеквизита)
	Свойства0 = Новый Структура("Код, Наименование, Номер", "ДлинаКода", "ДлинаНаименования", "ДлинаНомера");
	ИмяДлины = Неопределено;
	Если Не Свойства0.Свойство(ИмяРеквизита, ИмяДлины) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат ОбъектМетаданных[ИмяДлины] = 0;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Процедура ДобавитьПоляКоллекции(Модель, Свойства, Коллекция)
	Для Каждого Поле Из Коллекция Цикл
		OData4_Модель.ДобавитьРеквизит(Модель, Свойства, Поле.Имя, Поле.Имя, Поле.Тип);
	КонецЦикла;
КонецПроцедуры

// Общие реквизиты объекта. Разделители (РазделениеДанных = Разделять) standard.odata публикует у планов
// обмена при любом режиме использования разделяемых данных (проба p1-sep: ОбластьДанныхОсновныеДанные
// «Независимо» есть у 10 планов обмена и нет у справочников). Возвращает Массив свойств-разделителей.
Функция ДобавитьОбщиеРеквизиты(Модель, Свойства, ОбъектМетаданных, ВсеРазделители = Ложь)
	Разделители = Новый Массив;
	Для Каждого Элемент Из OData4_Модель.ОбщиеРеквизитыОбъекта(Модель, ОбъектМетаданных, ВсеРазделители) Цикл
		ОбщийРеквизит = Элемент.Реквизит;
		Свойство0 = OData4_Модель.ДобавитьРеквизит(Модель, Свойства, ОбщийРеквизит.Имя, ОбщийРеквизит.Имя,
			ОбщийРеквизит.Тип);
		Если Элемент.Разделитель Тогда
			Разделители.Добавить(Свойство0);
		КонецЕсли;
	КонецЦикла;
	Возврат Разделители;
КонецФункции

// ExtDimensionTypes плана счетов — коллекция без собственного набора (таблица «ПланСчетов.X.ВидыСубконто»):
// LineNumber, ExtDimensionType_Key, Predefined, TurnoversOnly и признаки учёта субконто.
// Стандартная табличная часть исключается составом по имени 1С (ВидыСубконто), её поля — «ВидыСубконто.Поле».
Процедура ДобавитьВидыСубконто(Модель, Набор, ОбъектМетаданных)
	Если OData4_Модель.ТЧИсключена(Модель.Состав, ОбъектМетаданных, "ВидыСубконто") Тогда
		Возврат;
	КонецЕсли;
	Коллекция = OData4_Модель.НоваяСкрытаяКоллекция(Модель, Набор, "ExtDimensionTypes", "ВидыСубконто");
	Свойства = Коллекция.Свойства;
	ТипВида = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка." + ОбъектМетаданных.ВидыСубконто.Имя);
	OData4_Модель.ДобавитьРеквизит(Модель, Свойства, "ExtDimensionType", "ВидСубконто", ТипВида);
	ТипБулево = Новый ОписаниеТипов("Булево");
	OData4_Модель.ДобавитьРеквизит(Модель, Свойства, "Predefined", "Предопределенное", ТипБулево);
	OData4_Модель.ДобавитьРеквизит(Модель, Свойства, "TurnoversOnly", "ТолькоОбороты", ТипБулево);
	ДобавитьПоляКоллекции(Модель, Свойства, ОбъектМетаданных.ПризнакиУчетаСубконто);
	OData4_Модель.УбратьИсключённые(Модель, Коллекция, ОбъектМетаданных, "ВидыСубконто.");
КонецПроцедуры

// Коллекции плана видов расчёта без собственного набора: LeadingCalculationTypes (есть всегда),
// BaseCalculationTypes (при зависимости от базы) и DisplacingCalculationTypes (при периоде действия).
// Строка — LineNumber, CalculationType (составное, как у standard.odata), Predefined.
Процедура ДобавитьВидыРасчета(Модель, Набор, ОбъектМетаданных)
	ДобавитьКоллекциюВидовРасчета(Модель, Набор, ОбъектМетаданных, "LeadingCalculationTypes", "ВедущиеВидыРасчета");
	Если Строка(ОбъектМетаданных.ЗависимостьОтВидовРасчета) <> "НеИспользовать" Тогда
		ДобавитьКоллекциюВидовРасчета(Модель, Набор, ОбъектМетаданных, "BaseCalculationTypes", "БазовыеВидыРасчета");
	КонецЕсли;
	Если ОбъектМетаданных.ИспользованиеПериодаДействия Тогда
		ДобавитьКоллекциюВидовРасчета(Модель, Набор, ОбъектМетаданных, "DisplacingCalculationTypes",
			"ВытесняющиеВидыРасчета");
	КонецЕсли;
КонецПроцедуры

// Стандартная табличная часть исключается составом по имени 1С (ВедущиеВидыРасчета и т. п.).
Процедура ДобавитьКоллекциюВидовРасчета(Модель, Набор, ОбъектМетаданных, ИмяOData, ИмяТаблицы)
	Если OData4_Модель.ТЧИсключена(Модель.Состав, ОбъектМетаданных, ИмяТаблицы) Тогда
		Возврат;
	КонецЕсли;
	Коллекция = OData4_Модель.НоваяСкрытаяКоллекция(Модель, Набор, ИмяOData, ИмяТаблицы);
	Коллекция.Свойства.Добавить(OData4_Модель.НовоеСвойство("CalculationType", "ВидРасчета", "Составной", "Edm.String"));
	OData4_Модель.ДобавитьРеквизит(Модель, Коллекция.Свойства, "Predefined", "Предопределенный",
		Новый ОписаниеТипов("Булево"));
	OData4_Модель.УбратьИсключённые(Модель, Коллекция, ОбъектМетаданных, ИмяТаблицы + ".");
КонецПроцедуры

// Константа: набор с одной строкой, ключ SurrogateKey (поля в базе нет, всегда 0), значение Value.
// У константы с общим реквизитом-разделителем ключ — разделитель, SurrogateKey нет (как у standard.odata).
Процедура ДобавитьКонстанту(Модель, ОбъектМетаданных)
	Набор = OData4_Модель.НовыйНабор("Constant_" + ОбъектМетаданных.Имя, "Константа",
		"Константа." + ОбъектМетаданных.Имя, "", "");
	Набор.ИмяОбъекта = ОбъектМетаданных.Имя;
	OData4_Модель.ДобавитьРеквизит(Модель, Набор.Свойства, "Value", "Значение", ОбъектМетаданных.Тип);
	Разделители = ДобавитьОбщиеРеквизиты(Модель, Набор.Свойства, ОбъектМетаданных);
	Для Каждого Разделитель Из Разделители Цикл
		Разделитель.ВКлюче = Истина;
	КонецЦикла;
	Если Разделители.Количество() = 0 Тогда
		Суррогат = OData4_Модель.НовоеСвойство("SurrogateKey", "", "Суррогат", "Edm.Int16");
		Суррогат.ВКлюче = Истина;
		Набор.Свойства.Добавить(Суррогат);
	КонецЕсли;
	OData4_Модель.УбратьИсключённые(Модель, Набор, ОбъектМетаданных, "");
	OData4_Модель.ДобавитьНабор(Модель, Набор);
КонецПроцедуры

// Журнал документов: ключ Ref и Ref_Type (ссылка на документ журнала — всегда составная, как у
// standard.odata), Type — представление вида документа, стандартные реквизиты и графы.
Процедура ДобавитьЖурнал(Модель, ОбъектМетаданных)
	Набор = OData4_Модель.НовыйНабор("DocumentJournal_" + ОбъектМетаданных.Имя, "Журнал",
		"ЖурналДокументов." + ОбъектМетаданных.Имя, "", "");
	Набор.ИмяОбъекта = ОбъектМетаданных.Имя;
	Свойства = Набор.Свойства;
	Ссылка = OData4_Модель.НовоеСвойство("Ref", "Ссылка", "Составной", "Edm.String");
	Ссылка.ВКлюче = Истина;
	Свойства.Добавить(Ссылка);
	ДобавитьСтандартные(Модель, Свойства, ОбъектМетаданных);
	Для Каждого Графа Из ОбъектМетаданных.Графы Цикл
		ТипКолонки = ТипГрафы(Графа);
		Если ТипКолонки <> Неопределено И Не ГрафаИсключена(Модель, Графа) Тогда
			OData4_Модель.ДобавитьРеквизит(Модель, Свойства, Графа.Имя, Графа.Имя, ТипКолонки);
		КонецЕсли;
	КонецЦикла;
	OData4_Модель.УбратьИсключённые(Модель, Набор, ОбъектМетаданных, "");
	Набор.Ключ.Добавить("Ref");
	Набор.Ключ.Добавить("Ref_Type");
	Набор.ПоляКлюча.Добавить(Ссылка);
	OData4_Модель.ДобавитьНабор(Модель, Набор);
КонецПроцедуры

// Графа журнала исключается, если хотя бы в одном документе журнала она отображается на поле, исключённое
// составом (или на реквизит исключённой табличной части): исключение не обходится через журнал.
Функция ГрафаИсключена(Модель, Графа)
	Для Каждого Реквизит Из Графа.Ссылки Цикл
		Попытка
			Части = СтрРазделить(Реквизит.ПолноеИмя(), ".");
		Исключение
			Продолжить;
		КонецПопытки;
		Если Части.Количество() < 4 Тогда
			Продолжить;
		КонецЕсли;
		Описание0 = Модель.Состав.Получить(Части[0] + "." + Части[1]);
		Если Описание0 = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если Части[2] = "ТабличнаяЧасть" И Части.Количество() >= 6 Тогда
			Если Описание0.ИсключённыеТЧ.Найти(Части[3]) <> Неопределено
				Или Описание0.ИсключённыеПоля.Найти(Части[3] + "." + Части[5]) <> Неопределено Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли Описание0.ИсключённыеПоля.Найти(Части[3]) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Тип графы журнала — объединение типов реквизитов документов, на которые она ссылается (квалификаторы —
// первого реквизита). Графа без ссылок — Неопределено.
Функция ТипГрафы(Графа)
	Результат = Неопределено;
	Для Каждого Реквизит Из Графа.Ссылки Цикл
		Если Результат = Неопределено Тогда
			Результат = Реквизит.Тип;
		Иначе
			Результат = Новый ОписаниеТипов(Результат, Реквизит.Тип.Типы());
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
