#Область ПрограммныйИнтерфейс

// Разбор тела запроса записи и сопоставление свойств OData с полями 1С (этап 6.2). Всё без рекурсии: табличные части —
// один уровень, JSON разбирает платформа.

// Тело запроса записи (описание запроса OData4_Запись.ОписаниеЗапроса, тело — строкой): Соответствие «имя свойства →
// значение» (ПрочитатьJSON с соответствиями). Пустое тело — пустое Соответствие. Content-Type задан и не JSON — 415;
// испорченный JSON или не объект на верхнем уровне — 400.
Функция РазобратьТело(Запрос) Экспорт
	Текст = Запрос.Тело;
	Если Текст = Неопределено Или ПустаяСтрока(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	ТипСодержимого = OData4_Безопасность.ЗначениеЗаголовка(Запрос, "Content-Type");
	Если ТипСодержимого <> "" И СтрНайти(НРег(ТипСодержимого), "json") = 0 Тогда
		OData4_Сервис.ОшибкаOData(415, "UnsupportedMediaType", "Тело записи принимается только в JSON: " + ТипСодержимого);
	КонецЕсли;
	Возврат ТелоИзТекста(Текст);
КонецФункции

// Тело из текста JSON (см. РазобратьТело). Движок разбора — настройка РежимРазбораТел (этап 8.2, см.
// OData4_РазборТелNative): в любом режиме результат и ошибки — как у разбора на языке 1С (ТелоBSL).
Функция ТелоИзТекста(Текст) Экспорт
	Если Лев(Текст, 1) = Символ(65279) Тогда
		Текст = Сред(Текст, 2);
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Возврат ТелоДвижком(Текст, OData4_Движок.РежимДвижка("РежимРазбораТел"));
КонецФункции

// Тело записи (текст без BOM, не пустой) движком Режим: "BSL", "Компонента" (отказ или сбой компоненты — язык 1С) или
// "Сверка" (оба, результат — язык 1С, расхождение — в журнал). Для ТелоИзТекста и тестов, которым режим нужен без
// записи настройки (настройки кэшируются на время вызова сервера).
Функция ТелоДвижком(Текст, Режим) Экспорт
	Если Режим = "BSL" Тогда
		Возврат ТелоBSL(Текст);
	КонецЕсли;
	Ответ = OData4_РазборТелNative.ТелоКомпонентой(Текст);
	Если Режим = "Компонента" Тогда
		Возврат ?(Ответ.Вид = "значение", Ответ.Значение, ТелоBSL(Текст));
	КонецЕсли;
	Попытка
		Тело = ТелоBSL(Текст);
	Исключение
		OData4_РазборТелNative.СверитьОшибку(OData4_РазборТелNative.ОписаниеТела(Текст), Ответ, ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	OData4_РазборТелNative.Сверить(OData4_РазборТелNative.ОписаниеТела(Текст), Ответ, Тело);
	Возврат Тело;
КонецФункции

// Значения свойств тела для записи в объект набора Набор (набор модели маршрута — с исключениями профиля). Вид —
// «Создание», «Изменение» или «Замена». ОбъектМетаданных — объект 1С набора (для описаний типов полей). Результат —
// Структура:
//   Поля — Массив Структура("Свойство, Поле, Значение") записываемых полей 1С;
//   Переданные — Соответствие «поле 1С → Истина» переданных (в том числе пропущенных только-для-чтения);
//   ТабличныеЧасти — Массив Структура("Имя, ИмяТЧ, Набор, Строки"), Строки — Массив Массивов полей строки;
//   Ключ — Ref_Key строкой (Неопределено — не передан); ЭтоГруппа — IsFolder (Неопределено — не передан);
//   ПометкаУдаления — DeletionMark (Неопределено — не передан).
// Неизвестные свойства, аннотации и поля только для чтения пропускаются (как у standard.odata, решение 6); Строго
// (настройка ОтвергатьНеизвестныеСвойства, решение 32) — неизвестное свойство тела и строки табличной части: 400 с его
// именем. Неверное значение — 400 «Свойство X: …».
Функция ЗначенияСвойств(Модель, Набор, ОбъектМетаданных, Тело, Вид, Строго = Ложь) Экспорт
	Результат = Новый Структура("Поля, Переданные, ТабличныеЧасти, Ключ, ЭтоГруппа, ПометкаУдаления",
		Новый Массив, Новый Соответствие, Новый Массив, Неопределено, Неопределено, Неопределено);
	Привязки = ПривязкиТела(Набор, Тело);
	Для Каждого КлючИЗначение Из Тело Цикл
		Имя = КлючИЗначение.Ключ;
		Если СтрНайти(Имя, "@") > 0 Тогда
			Продолжить;
		КонецЕсли;
		ИмяНабораТЧ = Набор.ТабличныеЧастиПоИмени.Получить(Имя);
		Если ИмяНабораТЧ <> Неопределено Тогда
			ДобавитьТабличнуюЧасть(Результат, Модель, ОбъектМетаданных, Имя, ИмяНабораТЧ, КлючИЗначение.Значение, Строго);
			Продолжить;
		КонецЕсли;
		Свойство = Набор.ПоИмени.Получить(Имя);
		Если Свойство = Неопределено Тогда
			ПроверитьИзвестное(Набор, Имя, Строго, "");
			Продолжить;
		КонецЕсли;
		ДобавитьСвойство(Результат, Набор, ОбъектМетаданных, "", Свойство, Тело, Привязки, Вид);
	КонецЦикла;
	// Навигация без свойства *_Key в теле: значение из @odata.bind.
	Для Каждого КлючИЗначение Из Привязки Цикл
		Свойство = КлючИЗначение.Ключ;
		Если Результат.Переданные.Получить(Свойство.Поле) = Неопределено Тогда
			Результат.Переданные.Вставить(Свойство.Поле, Истина);
			Результат.Поля.Добавить(Новый Структура("Свойство, Поле, Значение", Свойство, Свойство.Поле,
				ЗначениеСсылки(Свойство, КлючИЗначение.Значение)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Поле 1С записывается через OData4 (для сброса при PUT и для записи): не ключ ссылки, не версия, не признаки
// предопределённости и проведения, не номер строки, не вычисляемые виды.
Функция ПолеЗаписывается(Свойство) Экспорт
	Если Свойство.Поле = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТолькоДляЧтения().Найти(Свойство.Поле) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Вид = Свойство.Вид;
	Возврат Вид = "Примитив" Или Вид = "Ссылка" Или Вид = "Составной" Или Вид = "Перечисление" Или Вид = "ВидДвижения";
КонецФункции

// Описание типов поля 1С объекта (реквизит, стандартный реквизит, измерение, ресурс, общий реквизит, значение константы)
// или поля табличной части ИмяТЧ; Неопределено — не найдено.
Функция ОписаниеТиповПоля(ОбъектМетаданных, ИмяТЧ, Поле) Экспорт
	Если ИмяТЧ <> "" Тогда
		Для Каждого ИмяКоллекции Из СтрРазделить("ТабличныеЧасти,СтандартныеТабличныеЧасти", ",") Цикл
			ТЧ = ЭлементКоллекции(ОбъектМетаданных, ИмяКоллекции, ИмяТЧ);
			Если ТЧ <> Неопределено Тогда
				Для Каждого ИмяПолей Из СтрРазделить("Реквизиты,СтандартныеРеквизиты", ",") Цикл
					Реквизит = ЭлементКоллекции(ТЧ, ИмяПолей, Поле);
					Если Реквизит <> Неопределено Тогда
						Возврат Реквизит.Тип;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
	Если Поле = "Значение" И Метаданные.Константы.Содержит(ОбъектМетаданных) Тогда
		Возврат ОбъектМетаданных.Тип;
	КонецЕсли;
	Для Каждого ИмяКоллекции Из СтрРазделить("Реквизиты,Измерения,Ресурсы,ПризнакиУчета,РеквизитыАдресации,"
		+ "СтандартныеРеквизиты", ",") Цикл
		Реквизит = ЭлементКоллекции(ОбъектМетаданных, ИмяКоллекции, Поле);
		Если Реквизит <> Неопределено Тогда
			Возврат Реквизит.Тип;
		КонецЕсли;
	КонецЦикла;
	ОбщийРеквизит = Метаданные.ОбщиеРеквизиты.Найти(Поле);
	Если ОбщийРеквизит <> Неопределено Тогда
		Возврат ОбщийРеквизит.Тип;
	КонецЕсли;
	// Поле регистра бухгалтерии с корреспонденцией: «ИмяДт»/«ИмяКт» — тип поля «Имя» (счёт — стандартный реквизит «Счет»).
	Суффикс = Прав(Поле, 2);
	Если (Суффикс = "Дт" Или Суффикс = "Кт") И СтрДлина(Поле) > 2 Тогда
		Возврат ОписаниеТиповПоля(ОбъектМетаданных, "", Лев(Поле, СтрДлина(Поле) - 2));
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Значение свойства из JSON (не составного — у составного ещё и «_Type», см. ЗначениеСоставного): null — пустое
// значение типа поля; ссылка — по GUID; перечисление и вид движения — по имени; примитивы — по типу Edm; значение, не
// помещающееся в тип поля, — 400.
Функция ЗначениеСвойства(Свойство, Значение, ОписаниеТипов) Экспорт
	Вид = Свойство.Вид;
	Если Вид = "Хранилище" Или Вид = "ОписаниеТипов" Или Вид = "ТочкаМаршрута" Тогда
		Ошибка(Свойство, "свойство не записывается через OData4");
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат ?(ОписаниеТипов = Неопределено, Неопределено, ОписаниеТипов.ПривестиЗначение(Неопределено));
	КонецЕсли;
	ПроверитьОдноЗначение(Свойство, Значение);
	Если Вид = "Ссылка" Или Вид = "Ключ" Тогда
		Возврат ЗначениеСсылки(Свойство, Значение);
	ИначеЕсли Вид = "Перечисление" Тогда
		Текст = ТекстЗначения(Свойство, Значение);
		Если Текст = "" Тогда
			Возврат ?(ОписаниеТипов = Неопределено, Неопределено, ОписаниеТипов.ПривестиЗначение(Неопределено));
		КонецЕсли;
		Возврат ЗначениеПеречисления(Свойство, Свойство.Перечисление, Текст);
	ИначеЕсли Вид = "ВидДвижения" Тогда
		Результат = OData4_Сериализация.ВидДвиженияПоИмени(Свойство.Перечисление, ТекстЗначения(Свойство, Значение));
		Если Результат = Неопределено Тогда
			Ошибка(Свойство, "неизвестное значение " + Строка(Значение));
		КонецЕсли;
		Возврат Результат;
	КонецЕсли;
	Если Свойство.ЧастиДаты <> "" Тогда
		Возврат ПроверенноеЗначение(Свойство, ДатаИзТекста(Свойство, ТекстЗначения(Свойство, Значение)), ОписаниеТипов);
	КонецЕсли;
	ТипEdm = Свойство.ТипEdm;
	Если ТипEdm = "Edm.String" Тогда
		Возврат ПроверенноеЗначение(Свойство, СтрокаИзJSON(Значение), ОписаниеТипов);
	ИначеЕсли ТипEdm = "Edm.Boolean" Тогда
		Возврат БулевоИзJSON(Свойство, Значение);
	ИначеЕсли ТипEdm = "Edm.Guid" Тогда
		Возврат УИДИзТекста(Свойство, ТекстЗначения(Свойство, Значение));
	КонецЕсли;
	// Edm.Decimal, Edm.Double, Edm.Int16/32/64.
	Возврат ПроверенноеЗначение(Свойство, ЧислоИзJSON(Свойство, Значение), ОписаниеТипов);
КонецФункции

// Значение составного свойства по паре «Имя» и «Имя_Type» (ТекстТипа; Неопределено — не передан): Edm.String,
// Edm.Decimal/Double/Int*, Edm.Boolean, Edm.DateTimeOffset/DateTime, StandardODATA.Undefined, StandardODATA.Catalog_X
// (ссылка по GUID) и StandardODATA.<Перечисление> (значение по имени). Тип вне описания типов поля — 400.
Функция ЗначениеСоставного(Свойство, Значение, ТекстТипа, ОписаниеТипов) Экспорт
	ПроверитьОдноЗначение(Свойство, Значение);
	Если ТекстТипа = Неопределено Тогда
		Если Значение = Неопределено Тогда
			Возврат Неопределено;
		ИначеЕсли ТипЗнч(Значение) = Тип("Строка") Тогда
			Результат = Значение;
		ИначеЕсли ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
			Результат = Значение;
		Иначе
			Ошибка(Свойство, "нужен тип значения " + Свойство.Имя + "_Type");
		КонецЕсли;
	ИначеЕсли ТипЗнч(ТекстТипа) <> Тип("Строка") Тогда
		Ошибка(Свойство, "тип значения задаётся строкой в " + Свойство.Имя + "_Type");
	ИначеЕсли ТекстТипа = "" Или ТекстТипа = "StandardODATA.Undefined" Тогда
		Возврат Неопределено;
	ИначеЕсли ТекстТипа = "Edm.String" Тогда
		Результат = СтрокаИзJSON(?(Значение = Неопределено, "", Значение));
	ИначеЕсли ТекстТипа = "Edm.Boolean" Тогда
		Результат = БулевоИзJSON(Свойство, Значение);
	ИначеЕсли ТекстТипа = "Edm.DateTimeOffset" Или ТекстТипа = "Edm.DateTime" Или ТекстТипа = "Edm.Date" Тогда
		Результат = ДатаИзТекста(Свойство, ТекстЗначения(Свойство, Значение));
	ИначеЕсли СтрНачинаетсяС(ТекстТипа, "Edm.") Тогда
		Результат = ЧислоИзJSON(Свойство, Значение);
	Иначе
		Сведения = OData4_Модель.ТипПоИмениТипа(ТекстТипа);
		Если Сведения = Неопределено Тогда
			Ошибка(Свойство, "неизвестный тип значения " + ТекстТипа);
		ИначеЕсли Сведения.Перечисление <> "" Тогда
			Результат = ЗначениеПеречисления(Свойство, Сведения.Перечисление, ТекстЗначения(Свойство, Значение));
		Иначе
			Результат = ЗначениеПоТипуСсылки(Свойство, Сведения.Тип, Значение);
		КонецЕсли;
	КонецЕсли;
	Если ОписаниеТипов <> Неопределено И Не ОписаниеТипов.СодержитТип(ТипЗнч(Результат)) Тогда
		Ошибка(Свойство, "тип значения " + ?(ТекстТипа = Неопределено, Строка(ТипЗнч(Результат)), ТекстТипа)
			+ " не допускается");
	КонецЕсли;
	Возврат ?(ОписаниеТипов = Неопределено, Результат, ПроверенноеЗначение(Свойство, Результат, ОписаниеТипов));
КонецФункции

// Дата из текста OData: «ГГГГ-ММ-ДД», «чч:мм:сс», «ГГГГ-ММ-ДДТчч:мм:сс[.доли][Z|±чч:мм]». Пояс переводит время в местное
// время базы (решение 9); без пояса, а в режиме дат «Совместимый» и с «Z» — как есть (решение 39). Неверный текст — 400.
Функция ДатаИзТекста(Свойство, Текст) Экспорт
	Значение = СокрЛП(Текст);
	Если СтрДлина(Значение) = 8 И Сред(Значение, 3, 1) = ":" Тогда
		Значение = "0001-01-01T" + Значение;
	ИначеЕсли СтрДлина(Значение) = 10 Тогда
		Значение = Значение + "T00:00:00";
	КонецЕсли;
	Если СтрДлина(Значение) < 19 Или Сред(Значение, 11, 1) <> "T" Тогда
		Ошибка(Свойство, "неверная дата " + Текст);
	КонецЕсли;
	Основа = Лев(Значение, 19);
	Хвост = Сред(Значение, 20);
	Если Лев(Хвост, 1) = "." Тогда
		Позиция = 2;
		Пока Позиция <= СтрДлина(Хвост) И СтрНайти("0123456789", Сред(Хвост, Позиция, 1)) > 0 Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Хвост = Сред(Хвост, Позиция);
	КонецЕсли;
	Результат = Неопределено;
	Попытка
		Результат = XMLЗначение(Тип("Дата"), Основа);
	Исключение
		Ошибка(Свойство, "неверная дата " + Текст);
	КонецПопытки;
	Смещение = 0;
	Если Хвост = "" Тогда
		Возврат Результат;
	ИначеЕсли Хвост = "Z" Или Хвост = "z" Тогда
		Смещение = 0;
	ИначеЕсли СтрДлина(Хвост) = 6 И (Лев(Хвост, 1) = "+" Или Лев(Хвост, 1) = "-") И Сред(Хвост, 4, 1) = ":"
		И ЭтоЦифры(Сред(Хвост, 2, 2)) И ЭтоЦифры(Сред(Хвост, 5, 2)) Тогда
		Смещение = (Число(Сред(Хвост, 2, 2)) * 60 + Число(Сред(Хвост, 5, 2))) * 60 * ?(Лев(Хвост, 1) = "-", -1, 1);
	Иначе
		Ошибка(Свойство, "неверный часовой пояс в дате " + Текст);
	КонецЕсли;
	// Режим дат «Совместимый» выдаёт местное время с «Z»: «Z» пишется обратно без сдвига, явный пояс ±чч:мм переводится
	// (решение 9 уточнено решением 39, наблюдение Н4 QA).
	Если Результат = Дата(1, 1, 1) Или ВРег(Хвост) = "Z" И OData4_Сериализация.РежимДат() = "Совместимый" Тогда
		Возврат Результат;
	КонецЕсли;
	Возврат МестноеВремя(Результат - Смещение, OData4_ПовтИспВызова.ЧасовойПоясБазы());
КонецФункции

// Цель сообщения пользователя в error.details (решение 17): поле 1С «Реквизит», «Объект.Реквизит», «ТЧ[N].Реквизит» или
// «Объект.ТЧ[N].Реквизит» → «Реквизит_Key», «ТЧ[N]/Реквизит»; не удалось сопоставить — "".
Функция ЦельСообщения(Модель, Набор, Поле, ПутьКДанным = "") Экспорт
	Путь = СокрЛП(Поле);
	Если СтрНачинаетсяС(Путь, "Объект.") Тогда
		Путь = Сред(Путь, 8);
	КонецЕсли;
	Если Путь = "" Тогда
		Возврат "";
	КонецЕсли;
	Скобка = СтрНайти(Путь, "[");
	Если Скобка = 0 Тогда
		Свойство = СвойствоПоПолю(Набор, Путь);
		Если Свойство <> Неопределено Тогда
			Возврат Свойство.Имя;
		КонецЕсли;
		Возврат ?(Набор.ТабличныеЧастиПоИмени.Получить(Путь) = Неопределено, "", Путь);
	КонецЕсли;
	ИмяТЧ = Лев(Путь, Скобка - 1);
	Закрыта = СтрНайти(Путь, "]");
	ИмяНабораТЧ = Набор.ТабличныеЧастиПоИмени.Получить(ИмяТЧ);
	Если ИмяНабораТЧ = Неопределено Или Закрыта < Скобка Тогда
		Возврат "";
	КонецЕсли;
	Цель = ИмяТЧ + Сред(Путь, Скобка, Закрыта - Скобка + 1);
	ПолеСтроки = Сред(Путь, Закрыта + 2);
	Если ПолеСтроки = "" Тогда
		Возврат Цель;
	КонецЕсли;
	НаборТЧ = OData4_Безопасность.НаборМодели(Модель, ИмяНабораТЧ);
	Свойство = ?(НаборТЧ = Неопределено, Неопределено, СвойствоПоПолю(НаборТЧ, ПолеСтроки));
	Возврат ?(Свойство = Неопределено, Цель, Цель + "/" + Свойство.Имя);
КонецФункции

// Свойство набора по полю 1С (первое с таким Поле) или Неопределено.
Функция СвойствоПоПолю(Набор, Поле) Экспорт
	Для Каждого Свойство Из Набор.Свойства Цикл
		Если Свойство.Поле = Поле И Свойство.Вид <> "Суррогат" Тогда
			Возврат Свойство;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// GUID из текста: «…», «guid'…'»; неверный — 400 по свойству.
Функция УИДИзТекста(Свойство, Текст) Экспорт
	Значение = СокрЛП(Текст);
	Если СтрНачинаетсяС(НРег(Значение), "guid'") И Прав(Значение, 1) = "'" Тогда
		Значение = Сред(Значение, 6, СтрДлина(Значение) - 6);
	КонецЕсли;
	Результат = Неопределено;
	Попытка
		Результат = Новый УникальныйИдентификатор(Значение);
	Исключение
		Ошибка(Свойство, "неверный GUID " + Текст);
	КонецПопытки;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбор тела записи на языке 1С: ПрочитатьJSON с соответствиями; испорченный JSON или не объект — 400.
Функция ТелоBSL(Текст)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Причина = "";
	Тело = Неопределено;
	Попытка
		Тело = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Причина = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если Причина <> "" Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Тело записи — не JSON: " + Причина);
	КонецЕсли;
	Если ТипЗнч(Тело) <> Тип("Соответствие") Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Тело записи — не объект JSON");
	КонецЕсли;
	Возврат Тело;
КонецФункции

// Поля 1С, которые запись через OData4 пропускает (решение 6): ссылка, версия, предопределённость, проведение, номер
// строки, признак группы (он задаёт вид нового объекта), пометка удаления (пишется отдельно).
Функция ТолькоДляЧтения()
	Возврат СтрРазделить("Ссылка,ВерсияДанных,Предопределенный,ИмяПредопределенныхДанных,Проведен,НомерСтроки,ЭтоГруппа,"
		+ "ПометкаУдаления", ",");
КонецФункции

Процедура ДобавитьСвойство(Результат, Набор, ОбъектМетаданных, ИмяТЧ, Свойство, Тело, Привязки, Вид)
	Значение = Тело.Получить(Свойство.Имя);
	Если Свойство.Вид = "Ключ" И Свойство.Поле = "Ссылка" Тогда
		Если Вид = "Создание" И ИмяТЧ = "" И Значение <> Неопределено Тогда
			Результат.Ключ = Строка(УИДИзТекста(Свойство, ТекстЗначения(Свойство, Значение)));
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Если Свойство.Поле = "ЭтоГруппа" Тогда
		Если Вид = "Создание" Тогда
			Результат.ЭтоГруппа = БулевоИзJSON(Свойство, Значение);
		КонецЕсли;
		Возврат;
	ИначеЕсли Свойство.Поле = "ПометкаУдаления" Тогда
		Результат.ПометкаУдаления = БулевоИзJSON(Свойство, Значение);
		Возврат;
	КонецЕсли;
	Если Не ПолеЗаписывается(Свойство) Тогда
		Если Свойство.Вид = "Хранилище" Или Свойство.Вид = "ОписаниеТипов" Или Свойство.Вид = "ТочкаМаршрута" Тогда
			Ошибка(Свойство, "свойство не записывается через OData4");
		КонецЕсли;
		Возврат;
	КонецЕсли;
	ОписаниеТипов = ОписаниеТиповПоля(ОбъектМетаданных, ИмяТЧ, Свойство.Поле);
	Если Свойство.Вид = "Составной" Тогда
		Итог = ЗначениеСоставного(Свойство, Значение, Тело.Получить(Свойство.Имя + "_Type"), ОписаниеТипов);
	Иначе
		Итог = ЗначениеСвойства(Свойство, Значение, ОписаниеТипов);
		Если Свойство.Вид = "Ссылка" И Привязки <> Неопределено Тогда
			Привязка = Привязки.Получить(Свойство);
			Если Привязка <> Неопределено И ЗначениеСсылки(Свойство, Привязка) <> Итог Тогда
				Ошибка(Свойство, "значение отличается от " + Свойство.ИмяНавигации + "@odata.bind");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Результат.Переданные.Вставить(Свойство.Поле, Истина);
	Результат.Поля.Добавить(Новый Структура("Свойство, Поле, Значение", Свойство, Свойство.Поле, Итог));
КонецПроцедуры

// Привязки «Навигация@odata.bind» тела: Соответствие «свойство *_Key → GUID строкой». Набор ссылки должен быть целевым
// набором навигации; неизвестная навигация пропускается (как неизвестное свойство).
Функция ПривязкиТела(Набор, Тело)
	Привязки = Новый Соответствие;
	Суффикс = "@odata.bind";
	Для Каждого КлючИЗначение Из Тело Цикл
		Имя = КлючИЗначение.Ключ;
		Если Не СтрЗаканчиваетсяНа(Имя, Суффикс) Тогда
			Продолжить;
		КонецЕсли;
		Свойство = Набор.Навигация.Получить(Лев(Имя, СтрДлина(Имя) - СтрДлина(Суффикс)));
		Если Свойство = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(КлючИЗначение.Значение) <> Тип("Строка") Тогда
			Ошибка(Свойство, "в " + Имя + " ожидается адрес сущности");
		КонецЕсли;
		Адрес = КлючИЗначение.Значение;
		Сегмент = Адрес;
		Скобка = СтрНайти(Адрес, "(");
		Если Скобка > 0 Тогда
			Косая = СтрНайти(Лев(Адрес, Скобка), "/", НаправлениеПоиска.СКонца);
			Сегмент = Сред(Адрес, Косая + 1);
		КонецЕсли;
		Сегмент = РаскодироватьСтроку(Сегмент, СпособКодированияСтроки.КодировкаURL);
		Скобка = СтрНайти(Сегмент, "(");
		Если Скобка = 0 Или Прав(Сегмент, 1) <> ")" Тогда
			Ошибка(Свойство, "в " + Имя + " ожидается адрес сущности «Набор(ключ)»: " + Адрес);
		КонецЕсли;
		Если Лев(Сегмент, Скобка - 1) <> Свойство.ЦелевойНабор Тогда
			Ошибка(Свойство, "в " + Имя + " ожидается сущность набора " + Свойство.ЦелевойНабор + ": " + Адрес);
		КонецЕсли;
		Ключ = Сред(Сегмент, Скобка + 1, СтрДлина(Сегмент) - Скобка - 1);
		Равно = СтрНайти(Ключ, "=");
		Если Равно > 0 Тогда
			Ключ = Сред(Ключ, Равно + 1);
		КонецЕсли;
		Привязки.Вставить(Свойство, Строка(УИДИзТекста(Свойство, Ключ)));
	КонецЦикла;
	Возврат Привязки;
КонецФункции

// Табличная часть тела: массив объектов, строки — поля набора табличной части (набор профиля); закрытая профилем
// часть пропускается, как неизвестное свойство.
Процедура ДобавитьТабличнуюЧасть(Результат, Модель, ОбъектМетаданных, Имя, ИмяНабораТЧ, Значение, Строго)
	НаборТЧ = OData4_Безопасность.НаборМодели(Модель, ИмяНабораТЧ);
	Если НаборТЧ = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство " + Имя + ": ожидается массив строк табличной части");
	КонецЕсли;
	// Строки набора движений (RecordSet владельца по регистратору, часть 6.4) — поля самого регистра, а не табличной
	// части: ИмяТЧ пустое; регистратор строки задаёт отбор набора и из тела не берётся.
	Движения = НаборТЧ.Вид = "Регистр";
	Части = СтрРазделить(НаборТЧ.ТаблицаЗапроса, ".");
	ИмяТЧ = ?(Движения, "", Части[Части.ВГраница()]);
	Строки = Новый Массив;
	Номера = Новый Массив;
	Номер = 0;
	Для Каждого СтрокаТела Из Значение Цикл
		Если ТипЗнч(СтрокаТела) <> Тип("Соответствие") Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство " + Имя + "[" + Формат(Номер, "ЧН=0; ЧГ=0")
				+ "]: ожидается объект строки");
		КонецЕсли;
		ПоляСтроки = Новый Структура("Поля, Переданные, ТабличныеЧасти, Ключ, ЭтоГруппа, ПометкаУдаления",
			Новый Массив, Новый Соответствие, Новый Массив, Неопределено, Неопределено, Неопределено);
		Для Каждого КлючИЗначение Из СтрокаТела Цикл
			Если СтрНайти(КлючИЗначение.Ключ, "@") > 0 Тогда
				Продолжить;
			КонецЕсли;
			Свойство = НаборТЧ.ПоИмени.Получить(КлючИЗначение.Ключ);
			Если Движения И Свойство <> Неопределено И Свойство.Поле = "Регистратор" Тогда
				Продолжить;
			КонецЕсли;
			Если Свойство <> Неопределено Тогда
				ДобавитьСвойство(ПоляСтроки, НаборТЧ, ОбъектМетаданных, ИмяТЧ, Свойство, СтрокаТела, Неопределено,
					"Строка");
			Иначе
				ПроверитьИзвестное(НаборТЧ, КлючИЗначение.Ключ, Строго, Имя + "[" + Формат(Номер, "ЧН=0; ЧГ=0") + "]/");
			КонецЕсли;
		КонецЦикла;
		Строки.Добавить(ПоляСтроки.Поля);
		// LineNumber строки как есть (Неопределено — нет): по нему сопоставляются скрытые профилем колонки (решение 38).
		Номера.Добавить(СтрокаТела.Получить("LineNumber"));
		Номер = Номер + 1;
	КонецЦикла;
	Результат.Переданные.Вставить(?(Движения, Имя, ИмяТЧ), Истина);
	Результат.ТабличныеЧасти.Добавить(Новый Структура("Имя, ИмяТЧ, Набор, Строки, Номера", Имя, ИмяТЧ, НаборТЧ, Строки,
		Номера));
КонецПроцедуры

// Строгий разбор (решение 32): имя, которого нет среди свойств набора и их спутников (*_Type, *_Base64Data), — 400.
Процедура ПроверитьИзвестное(Набор, Имя, Строго, Путь)
	Если Строго И Набор.ВыборПоИмени.Получить(Имя) = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неизвестное свойство " + Путь + Имя + " набора " + Набор.Имя
			+ " (настройка «Отвергать неизвестные свойства»)");
	КонецЕсли;
КонецПроцедуры

Функция ЗначениеСсылки(Свойство, Значение)
	Если Значение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЗначениеПоТипуСсылки(Свойство, Свойство.ТипСсылки, Значение);
КонецФункции

Функция ЗначениеПоТипуСсылки(Свойство, ТипСсылки, Значение)
	УИД = УИДИзТекста(Свойство, ТекстЗначения(Свойство, Значение));
	Если ТипСсылки = Неопределено Тогда
		Ошибка(Свойство, "неизвестен тип ссылки");
	КонецЕсли;
	Результат = Неопределено;
	Попытка
		Результат = XMLЗначение(ТипСсылки, Строка(УИД));
	Исключение
		Ошибка(Свойство, "неверная ссылка " + Строка(Значение));
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция ЗначениеПеречисления(Свойство, ИмяПеречисления, ИмяЗначения)
	ОбъектПеречисления = Метаданные.Перечисления.Найти(ИмяПеречисления);
	Если ОбъектПеречисления = Неопределено Тогда
		Ошибка(Свойство, "неизвестное перечисление " + ИмяПеречисления);
	КонецЕсли;
	Если ИмяЗначения = "" Тогда
		Возврат Перечисления[ИмяПеречисления].ПустаяСсылка();
	КонецЕсли;
	Если ОбъектПеречисления.ЗначенияПеречисления.Найти(ИмяЗначения) = Неопределено Тогда
		Ошибка(Свойство, "нет значения " + ИмяЗначения + " в перечислении " + ИмяПеречисления);
	КонецЕсли;
	Возврат Перечисления[ИмяПеречисления][ИмяЗначения];
КонецФункции

// Значение свойства-примитива, ссылки или перечисления — одно значение JSON: массив или объект — 400 (а не 500 при
// преобразовании, наблюдение Н1 приёмки 7).
Процедура ПроверитьОдноЗначение(Свойство, Значение)
	Если ТипЗнч(Значение) = Тип("Массив") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Ошибка(Свойство, "ожидается одно значение, а не " + ИмяТипаJSON(Значение));
	КонецЕсли;
КонецПроцедуры

// Текст значения для разбора (GUID, дата, имя значения): строка как есть, иначе 400.
Функция ТекстЗначения(Свойство, Значение)
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Ошибка(Свойство, "ожидается строка, а не " + ИмяТипаJSON(Значение));
КонецФункции

// Строковое значение: строка как есть, число и булево — XML-представлением (как standard.odata: 123 → "123").
Функция СтрокаИзJSON(Значение)
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат XMLСтрока(Значение);
КонецФункции

Функция БулевоИзJSON(Свойство, Значение)
	Если ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли Значение = "true" Тогда
		Возврат Истина;
	ИначеЕсли Значение = "false" Тогда
		Возврат Ложь;
	КонецЕсли;
	Ошибка(Свойство, "ожидается true или false, а не " + СтрокаЗначения(Значение));
КонецФункции

// Число: число JSON или строка с числом (OData IEEE754Compatible).
Функция ЧислоИзJSON(Свойство, Значение)
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И ЭтоЧисло(Значение) Тогда
		Возврат Число(Значение);
	КонецЕсли;
	Ошибка(Свойство, "ожидается число, а не " + СтрокаЗначения(Значение));
КонецФункции

// Значение, приведённое к типу поля, должно совпасть с исходным: не помещающиеся число или строка — 400, а не молчаливое
// усечение.
Функция ПроверенноеЗначение(Свойство, Значение, ОписаниеТипов)
	Если ОписаниеТипов = Неопределено Или Значение = Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Длина = ОписаниеТипов.КвалификаторыСтроки.Длина;
		Если ОписаниеТипов.СодержитТип(Тип("Строка")) И Длина > 0 И СтрДлина(Значение) > Длина Тогда
			Ошибка(Свойство, "строка длиннее " + Формат(Длина, "ЧГ=0") + " символов");
		КонецЕсли;
		Возврат ?(ОписаниеТипов.СодержитТип(Тип("Строка")), Значение, ОписаниеТипов.ПривестиЗначение(Значение));
	КонецЕсли;
	Приведённое = ОписаниеТипов.ПривестиЗначение(Значение);
	Если ТипЗнч(Значение) = Тип("Число") И Приведённое <> Значение Тогда
		Ошибка(Свойство, "число " + XMLСтрока(Значение) + " не помещается в тип поля");
	КонецЕсли;
	Возврат Приведённое;
КонецФункции

Функция ЭтоЧисло(Текст)
	Значение = СокрЛП(Текст);
	Если Значение = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Точек = 0;
	Для Номер = 1 По СтрДлина(Значение) Цикл
		Символ0 = Сред(Значение, Номер, 1);
		Если Символ0 = "-" И Номер = 1 Тогда
			Продолжить;
		ИначеЕсли Символ0 = "." Тогда
			Точек = Точек + 1;
		ИначеЕсли СтрНайти("0123456789", Символ0) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Точек <= 1 И Значение <> "-" И Значение <> ".";
КонецФункции

Функция ЭтоЦифры(Текст)
	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Номер, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ИмяТипаJSON(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Число") Тогда
		Возврат "число";
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат "булево";
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Возврат "массив";
	ИначеЕсли ТипЗначения = Тип("Соответствие") Тогда
		Возврат "объект";
	КонецЕсли;
	Возврат "строка";
КонецФункции

Функция СтрокаЗначения(Значение)
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат """" + Значение + """";
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат XMLСтрока(Значение);
	КонецЕсли;
	Возврат ИмяТипаJSON(Значение);
КонецФункции

// Элемент коллекции метаданных по имени или Неопределено (у объекта может не быть такой коллекции). Коллекция
// стандартных реквизитов умеет только обход (проба этапа 4).
Функция ЭлементКоллекции(Владелец, ИмяКоллекции, Имя)
	Коллекция = Неопределено;
	Попытка
		Коллекция = Владелец[ИмяКоллекции];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если СтрНачинаетсяС(ИмяКоллекции, "Стандартные") Тогда
		Для Каждого Элемент Из Коллекция Цикл
			Если Элемент.Имя = Имя Тогда
				Возврат Элемент;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
	Возврат Коллекция.Найти(Имя);
КонецФункции

Процедура Ошибка(Свойство, Текст)
	OData4_Сервис.ОшибкаOData(400, "BadRequest", "Свойство " + Свойство.Имя + ": " + Текст);
КонецПроцедуры

#КонецОбласти
