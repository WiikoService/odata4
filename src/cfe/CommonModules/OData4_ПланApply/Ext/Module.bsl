#Область ПрограммныйИнтерфейс

// Переводит цепочку шагов $apply в пакет выборок: шаги, меняющие состав колонок, закрываются
// в ПОМЕСТИТЬ ВТ_ШагN (План.Шаги), а следующий шаг читает эту таблицу под псевдонимом «Ш».
// После цепочки План.Выборка, План.Набор и План.Контекст описывают результат последнего шага,
// План.ПорядокШага — порядок результата topcount/bottomcount (сохраняется через filter и compute).
// Ошибки — исключение OData на верхнем уровне (рекурсии здесь нет, вложенность шагов — один уровень).
Процедура Применить(План, Шаги) Экспорт
	// Имя источника (набор или результат виртуальной таблицы) — имя наборов шагов в сообщениях.
	План.Вставить("ИмяРезультата", План.Набор.Имя);
	Если План.Группировка И ЕстьСменаКолонок(Шаги) Тогда
		ЗакрытьИсточник(План);
	КонецЕсли;
	Для Каждого Шаг Из Шаги Цикл
		ВыполнитьШаг(План, Шаг);
	КонецЦикла;
КонецПроцедуры

// Синтетический набор колонок шага: Свойство.Поле — имя колонки предыдущего шага (К1, К2 …),
// псевдоним источника — «Ш».
Функция НаборШага(Имя, Свойства) Экспорт
	Набор = OData4_Модель.НовыйНабор(Имя, "Шаг", "", "", "");
	Для Каждого Свойство0 Из Свойства Цикл
		Набор.Свойства.Добавить(Свойство0);
	КонецЦикла;
	ПоИмени = Новый Соответствие;
	ВыборПоИмени = Новый Соответствие;
	Для Каждого Свойство0 Из Набор.Свойства Цикл
		ПоИмени.Вставить(Свойство0.Имя, Свойство0);
		ВыборПоИмени.Вставить(Свойство0.Имя, Свойство0);
		Если Свойство0.Вид = "Составной" Тогда
			ВыборПоИмени.Вставить(Свойство0.Имя + "_Type", Свойство0);
		КонецЕсли;
	КонецЦикла;
	Навигация = Новый Соответствие;
	Для Каждого Свойство0 Из Набор.Свойства Цикл
		Если Свойство0.Вид = "Ссылка" И Свойство0.ИмяНавигации <> "" Тогда
			Навигация.Вставить(Свойство0.ИмяНавигации, Свойство0);
		КонецЕсли;
	КонецЦикла;
	// Группа по навигационному пути (groupby((Owner))) — свойство «Owner/Ref_Key» с КлючНавигации: путь
	// «Owner» в следующих шагах, $filter и $orderby — это навигация к связанному объекту (как у набора).
	НавигацияГрупп = Новый Соответствие;
	Для Каждого Свойство0 Из Набор.Свойства Цикл
		Если Свойство0.Свойство("КлючНавигации") Тогда
			Косая = СтрНайти(Свойство0.Имя, "/", НаправлениеПоиска.СКонца);
			Если Косая > 1 Тогда
				НавигацияГрупп.Вставить(Лев(Свойство0.Имя, Косая - 1), Свойство0);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Набор.Вставить("ПоИмени", ПоИмени);
	Набор.Вставить("ВыборПоИмени", ВыборПоИмени);
	Набор.Вставить("Навигация", Навигация);
	Набор.Вставить("НавигацияГрупп", НавигацияГрупп);
	Набор.Вставить("ТабличныеЧастиПоИмени", Новый Соответствие);
	Возврат Набор;
КонецФункции

// Описание свойства по типу выражения генератора.
Функция СвойствоИзТипа(Имя, Поле, Тип0) Экспорт
	Вид = Тип0.Вид;
	Если Вид = "Ссылка" Тогда
		Свойство0 = OData4_Модель.НовоеСвойство(Имя, Поле, "Ссылка", "Edm.Guid");
		Свойство0.ТипСсылки = Тип0.ТипСсылки;
		Свойство0.ЦелевойНабор = ?(Тип0.Набор = Неопределено, "", Тип0.Набор.Имя);
		Возврат Свойство0;
	ИначеЕсли Вид = "Перечисление" Тогда
		Свойство0 = OData4_Модель.НовоеСвойство(Имя, Поле, "Перечисление", "StandardODATA." + Тип0.Перечисление);
		Свойство0.Перечисление = Тип0.Перечисление;
		Возврат Свойство0;
	ИначеЕсли Вид = "ВидДвижения" Тогда
		Свойство0 = OData4_Модель.НовоеСвойство(Имя, Поле, "ВидДвижения", "Edm.String");
		Свойство0.Перечисление = Тип0.Перечисление;
		Возврат Свойство0;
	ИначеЕсли Вид = "Составной" Тогда
		Возврат OData4_Модель.НовоеСвойство(Имя, Поле, "Составной", "Edm.String");
	ИначеЕсли Вид = "Хранилище" Тогда
		Возврат OData4_Модель.НовоеСвойство(Имя, Поле, "Хранилище", "Edm.Stream");
	ИначеЕсли Вид = "Дата" Тогда
		Свойство0 = OData4_Модель.НовоеСвойство(Имя, Поле, "Примитив", OData4_Сериализация.ТипДаты(Тип0.ЧастиДаты));
		Свойство0.ЧастиДаты = Тип0.ЧастиДаты;
		Возврат Свойство0;
	ИначеЕсли Вид = "Строка" Тогда
		Свойство0 = OData4_Модель.НовоеСвойство(Имя, Поле, "Примитив", "Edm.String");
		Свойство0.Длина = Тип0.Длина;
		Возврат Свойство0;
	ИначеЕсли Вид = "Булево" Или Вид = "Условие" Тогда
		Возврат OData4_Модель.НовоеСвойство(Имя, Поле, "Примитив", "Edm.Boolean");
	ИначеЕсли Вид = "Гуид" Тогда
		Возврат OData4_Модель.НовоеСвойство(Имя, Поле, "Примитив", "Edm.Guid");
	КонецЕсли;
	Возврат OData4_Модель.НовоеСвойство(Имя, Поле, "Примитив", "Edm.Decimal");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьШаг(План, Шаг)
	Вид = Шаг.kind;
	Если Вид = "identity" Тогда
		Возврат;
	ИначеЕсли Вид = "filter" Тогда
		План.Выборка.Условия.Добавить(OData4_Генератор.Условие(Шаг.filter, План.Контекст));
		Возврат;
	ИначеЕсли Вид = "groupby" Тогда
		Группировка(План, Шаг);
		Возврат;
	ИначеЕсли Вид = "aggregate" Тогда
		Агрегаты(План, Шаг.items, Новый Массив);
		Возврат;
	ИначеЕсли Вид = "compute" Тогда
		Вычисления(План, Шаг.items);
		Возврат;
	ИначеЕсли Вид = "topcount" Или Вид = "bottomcount" Тогда
		Первые(План, Шаг, Вид);
		Возврат;
	КонецЕсли;
	OData4_Сервис.ОшибкаOData(501, "NotImplemented", "Преобразование не поддерживается: " + Вид);
КонецПроцедуры

// Прежние свойства текущего набора — колонками выборки шага. Результат — Структура «Свойства, Ключ,
// Порядок»: копии свойств (Поле — колонка шага), ключ из копий и, если СПорядком, порядок предыдущего
// topcount/bottomcount (Структуры «Колонка, Убывание, Тип») — он переносится скрытыми колонками.
// Ref_Key объекта становится ссылкой: у набора шага нет своего типа ссылки. Суррогатный ключ (без поля)
// не переносится; ключ шага — копии ПоляПорядкаКлюча (у подчинённого регистра с суррогатным ключом —
// Recorder и LineNumber, чтобы порядок и продолжение шага оставались однозначными).
Функция Перенести(План, СПорядком)
	Выборка = План.Выборка;
	Выборка.Колонки = Новый Массив;
	Свойства = Новый Массив;
	Копии = Новый Соответствие;
	Для Каждого Свойство0 Из План.Набор.Свойства Цикл
		Если Свойство0.Поле = "" Тогда
			Продолжить;
		КонецЕсли;
		Колонка = OData4_Генератор.ДобавитьКолонку(Выборка, Выборка.Псевдоним + "." + Свойство0.Поле);
		Копия = Новый Структура;
		Для Каждого КлючИЗначение Из Свойство0 Цикл
			Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Если Свойство0.Вид = "Ключ" Тогда
			Тип0 = OData4_Генератор.ТипПоляНабора(Свойство0, План.Набор, План.Модель);
			Копия.Вид = "Ссылка";
			Копия.ТипСсылки = Тип0.ТипСсылки;
			Копия.ЦелевойНабор = ?(Тип0.Набор = Неопределено, "", Тип0.Набор.Имя);
		КонецЕсли;
		Копия.Поле = Колонка;
		Свойства.Добавить(Копия);
		Копии.Вставить(Свойство0.Имя, Копия);
	КонецЦикла;
	Ключ = Новый Массив;
	Для Каждого Свойство0 Из OData4_Планировщик.ПоляПорядкаКлюча(План.Набор) Цикл
		Копия = Копии.Получить(Свойство0.Имя);
		Если Копия <> Неопределено Тогда
			Ключ.Добавить(Копия);
		КонецЕсли;
	КонецЦикла;
	Порядок = Новый Массив;
	Если СПорядком Тогда
		Для Каждого Элемент Из План.ПорядокШага Цикл
			Колонка = OData4_Генератор.ДобавитьКолонку(Выборка, Элемент.Выражение);
			Порядок.Добавить(Новый Структура("Колонка, Убывание, Тип", Колонка, Элемент.Убывание, Элемент.Тип));
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("Свойства, Ключ, Порядок, Связь", Свойства, Ключ, Порядок, СвязьТабличныхЧастей(План));
КонецФункции

// Табличные части текущего набора для набора шага, сохраняющего ключ (решение 22): строки шага остаются
// сущностями набора, и их табличные части (у документа — Товары, у набора записей регистра — RecordSet)
// читаются по ссылке владельца, как у коллекции. Ссылка владельца (ПолеСвязи) переносится колонкой шага.
// Структура «Поле, ТипСвязи, ТабличныеЧасти, ТабличныеЧастиПоИмени» или Неопределено, если частей нет.
Функция СвязьТабличныхЧастей(План)
	Набор = План.Набор;
	Если Набор.ПолеСвязи = "" Или Набор.ТабличныеЧасти.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Колонка = OData4_Генератор.ДобавитьКолонку(План.Выборка, План.Выборка.Псевдоним + "." + Набор.ПолеСвязи);
	Возврат Новый Структура("Поле, ТипСвязи, ТабличныеЧасти, ТабличныеЧастиПоИмени", Колонка, Набор.ТипСвязи,
		Набор.ТабличныеЧасти, Набор.ТабличныеЧастиПоИмени);
КонецФункции

// compute(выражение as имя, …): прежние колонки плюс вычисленные; порядок предыдущего topcount сохраняется.
// Условие выдаётся логическим значением (неизвестное — NULL, как null в OData); литерал — параметром
// своего типа; null — 400: у колонки нет типа для свойства результата.
Процедура Вычисления(План, Элементы)
	Проекция = Перенести(План, Истина);
	Свойства = Проекция.Свойства;
	Имена = Новый Соответствие;
	Для Каждого Свойство0 Из Свойства Цикл
		ЗанятьИмена(Имена, Свойство0, Ложь);
	КонецЦикла;
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.alias = "" Или Имена.Получить(Элемент.alias) = Истина Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Повторное имя в $apply: " + Элемент.alias);
		КонецЕсли;
		Выр = OData4_Генератор.Выражение(Элемент.expression, План.Контекст);
		Вид = Выр.Тип.Вид;
		Если Вид = "Литерал" И Выр.Литерал.type = "null" Или Вид = "Null" Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Вычисление null не поддерживается: " + Элемент.alias);
		ИначеЕсли Вид = "Литерал" Тогда
			Выр = OData4_Генератор.ПараметрЛитерала(Выр, План.Контекст);
		ИначеЕсли Вид = "Условие" Тогда
			Выр = Новый Структура("Текст, Тип", "ВЫБОР КОГДА " + Выр.Текст + " ТОГДА ИСТИНА КОГДА НЕ " + Выр.Текст
				+ " ТОГДА ЛОЖЬ КОНЕЦ", OData4_Генератор.НовыйТипВыражения("Булево"));
		КонецЕсли;
		Колонка = OData4_Генератор.ДобавитьКолонку(План.Выборка, Выр.Текст);
		Свойство0 = СвойствоИзТипа(Элемент.alias, Колонка, Выр.Тип);
		ЗанятьИмена(Имена, Свойство0, Истина);
		Свойства.Добавить(Свойство0);
	КонецЦикла;
	Закрыть(План, Свойства, Проекция.Ключ, , , Проекция.Связь);
	Для Каждого Элемент Из Проекция.Порядок Цикл
		План.ПорядокШага.Добавить(Новый Структура("Выражение, Убывание, Тип", "Ш." + Элемент.Колонка,
			Элемент.Убывание, Элемент.Тип));
	КонецЦикла;
КонецПроцедуры

// topcount(N, выражение) и bottomcount(N, выражение): ПЕРВЫЕ N по убыванию (topcount) или возрастанию
// выражения, при равных значениях — по ключу набора (иначе выбор строк между страницами мог бы
// различаться). Порядок во временной таблице не сохраняется: план запоминает его (ПорядокШага) и
// повторяет на результате, если у запроса нет своего $orderby. Выражение порядка — скрытая колонка шага.
Процедура Первые(План, Шаг, Вид)
	Количество = ЧислоСтрок(Шаг.count, Вид);
	Убывание = Вид = "topcount";
	Выр = OData4_Генератор.ВыражениеПорядка(OData4_Генератор.Выражение(Шаг.expression, План.Контекст),
		План.Контекст);
	Ключ0 = Новый Массив;
	// Суррогатный ключ (SurrogateKey) поля не имеет — вместо него КлючПродолжения (см. ПоляПорядкаКлюча).
	Для Каждого Свойство0 Из OData4_Планировщик.ПоляПорядкаКлюча(План.Набор) Цикл
		Ключ0.Добавить(OData4_Планировщик.ВыражениеКлюча(План, Свойство0));
	КонецЦикла;
	Проекция = Перенести(План, Ложь);
	Выборка = План.Выборка;
	// Колонки порядка — в выборке: у набора записей (РАЗЛИЧНЫЕ) УПОРЯДОЧИТЬ ПО допускает только их.
	Колонка = OData4_Генератор.ДобавитьКолонку(Выборка, Выр.Текст);
	Выборка.Порядок.Добавить(Новый Структура("Выражение, Убывание", Выр.Текст, Убывание));
	Для Каждого Элемент Из Ключ0 Цикл
		OData4_Генератор.ДобавитьКолонку(Выборка, Элемент.Выражение);
		Выборка.Порядок.Добавить(Новый Структура("Выражение, Убывание", Элемент.Выражение, Ложь));
	КонецЦикла;
	Если Количество = 0 Тогда
		// ПЕРВЫЕ 0 не пишется; УПОРЯДОЧИТЬ в ПОМЕСТИТЬ допускается только с ПЕРВЫЕ.
		Выборка.Первые = 1;
		Выборка.Условия.Добавить("ЛОЖЬ");
	Иначе
		Выборка.Первые = Количество;
	КонецЕсли;
	Закрыть(План, Проекция.Свойства, Проекция.Ключ, , , Проекция.Связь);
	План.ПорядокШага.Добавить(Новый Структура("Выражение, Убывание, Тип", "Ш." + Колонка, Убывание, Выр.Тип));
КонецПроцедуры

// Число строк topcount/bottomcount: целый неотрицательный литерал не больше 1000000; иначе 400.
Функция ЧислоСтрок(Узел, Вид)
	Если Узел.kind = "literal" И Узел.type = "Edm.Int64" Тогда
		Значение = Число(Узел.value);
		Если Значение > 1000000 Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Количество в " + Вид + " больше 1000000: " + Узел.value);
		ИначеЕсли Значение >= 0 Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	OData4_Сервис.ОшибкаOData(400, "BadRequest", "Количество в " + Вид + " — только неотрицательное целое");
КонецФункции

// groupby((пути)[, цепочка]): колонки группировки и, если цепочка задана, агрегаты из неё.
// В цепочке groupby допускаются только aggregate (один) и filter: filter до aggregate отбирает строки
// источника, filter после aggregate — группы (условие по результату шага).
Процедура Группировка(План, Шаг)
	Элементы = Новый Массив;
	Имена = Новый Соответствие;
	Для Каждого Путь Из Шаг.properties Цикл
		Узел = Новый Структура("kind, variable, segments", "path", "", Путь);
		Выр = OData4_Генератор.Выражение(Узел, План.Контекст);
		Имя = ИмяПути(Путь);
		ПроверитьГруппировку(Выр, СтрСоединить(Путь, "/"));
		КлючНавигации = Выр.Тип.Навигация = Истина;
		Если КлючНавигации Тогда
			// Путь оканчивается навигацией: группа — связанный объект, он выдаётся раскрытым значением
			// с ключом целевого набора {"Owner":{"Ref_Key":…}} (расширение агрегации OData 4.0, 3.10.1).
			Имя = Имя + "/" + ИмяКлючаЦели(Выр.Тип);
		КонецЕсли;
		Если Имена.Получить(Имя) = Истина Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Повторное имя в $apply: " + Имя);
		КонецЕсли;
		Имена.Вставить(Имя, Истина);
		Элементы.Добавить(Новый Структура("Имя, Выражение, Тип, КлючНавигации", Имя, Выр.Текст, Выр.Тип,
			КлючНавигации));
	КонецЦикла;
	Агрегаты0 = Новый Массив;
	Отборы = Новый Массив;
	ЕстьАгрегат = Ложь;
	Если Шаг.steps <> Неопределено Тогда
		Для Каждого Вложенный Из Шаг.steps Цикл
			Если Вложенный.kind = "filter" Тогда
				Если ЕстьАгрегат Тогда
					Отборы.Добавить(Вложенный.filter);
				Иначе
					План.Выборка.Условия.Добавить(OData4_Генератор.Условие(Вложенный.filter, План.Контекст));
				КонецЕсли;
			ИначеЕсли Вложенный.kind = "aggregate" Тогда
				Если ЕстьАгрегат Тогда
					OData4_Сервис.ОшибкаOData(400, "BadRequest", "В groupby допускается только один aggregate");
				КонецЕсли;
				ЕстьАгрегат = Истина;
				Агрегаты0 = Вложенный.items;
			ИначеЕсли Вложенный.kind <> "identity" Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest",
					"В groupby допускаются только aggregate и filter, получено " + Вложенный.kind);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Агрегаты(План, Агрегаты0, Элементы);
	Для Каждого Отбор Из Отборы Цикл
		План.Выборка.Условия.Добавить(OData4_Генератор.Условие(Отбор, План.Контекст));
	КонецЦикла;
КонецПроцедуры

// Поле группировки: не строка неограниченной длины и не хранилище (СГРУППИРОВАТЬ ПО их не принимает).
// Выражение остаётся как есть: перечисление, вид движения и булево выдаются своими значениями.
Процедура ПроверитьГруппировку(Выр, Имя)
	Вид = Выр.Тип.Вид;
	Если Вид = "Строка" И Выр.Тип.Длина = 0 Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Строку неограниченной длины нельзя группировать: " + Имя);
	ИначеЕсли Вид = "Хранилище" Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Хранилище значения нельзя группировать: " + Имя);
	КонецЕсли;
КонецПроцедуры

// Колонки шага: сначала поля группировки (они же ключ результата), затем агрегаты.
// Пустой список группировки — одна строка на всю выборку.
Процедура Агрегаты(План, Элементы, ПоляГруппировки)
	Выборка = План.Выборка;
	Выборка.Колонки = Новый Массив;
	Свойства = Новый Массив;
	Ключ = Новый Массив;
	Для Каждого Поле Из ПоляГруппировки Цикл
		Колонка = OData4_Генератор.ДобавитьКолонку(Выборка, Поле.Выражение);
		Выборка.Группировка.Добавить(Поле.Выражение);
		Свойство0 = СвойствоИзТипа(Поле.Имя, Колонка, Поле.Тип);
		Если Поле.КлючНавигации Тогда
			// Пустая ссылка — объекта нет: выдача считает такой вложенный объект пустым (null).
			Свойство0.Вставить("КлючНавигации", Истина);
		КонецЕсли;
		Свойства.Добавить(Свойство0);
		Ключ.Добавить(Свойство0);
	КонецЦикла;
	Имена = Новый Соответствие;
	Для Каждого Свойство0 Из Свойства Цикл
		ЗанятьИмена(Имена, Свойство0, Истина);
	КонецЦикла;
	Для Каждого Элемент Из Элементы Цикл
		Если Элемент.alias = "" Или Имена.Получить(Элемент.alias) = Истина Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Повторное имя в $apply: " + Элемент.alias);
		КонецЕсли;
		Выр = ТекстАгрегата(План, Элемент);
		Колонка = OData4_Генератор.ДобавитьКолонку(Выборка, Выр.Текст);
		Свойство0 = СвойствоИзТипа(Элемент.alias, Колонка, Выр.Тип);
		ЗанятьИмена(Имена, Свойство0, Истина);
		Свойства.Добавить(Свойство0);
	КонецЦикла;
	Если Свойства.Количество() = 0 Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Пустой результат $apply");
	КонецЕсли;
	// РАЗЛИЧНЫЕ набора записей уже учтён в агрегатах (ТекстАгрегата), а поля группировки уникальны.
	Выборка.Различные = Ложь;
	Закрыть(План, Свойства, Ключ);
	// Строки результата — группы, а не сущности набора ("@odata.id": null, $expand — 501). Поля группировки
	// уникальны и становятся ключом набора шага: результат продолжается меткой по ним, как коллекция, пока
	// условие продолжения помещается в пределы генератора (решение 11; выбирает ПланЧтения).
	План.Группы = Истина;
КонецПроцедуры

// Выражение агрегата (решение 13 этапа 4): $count → КОЛИЧЕСТВО(*) (у набора записей регистра строка —
// регистратор: КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Т.Регистратор)); countdistinct → КОЛИЧЕСТВО(РАЗЛИЧНЫЕ x) — всё, кроме
// хранилищ и строк неограниченной длины; sum/average — только числа; min/max — числа, даты, ссылки,
// перечисления и строки ограниченной длины. Нарушение — 400 с именем псевдонима.
Функция ТекстАгрегата(План, Элемент)
	Метод = Элемент.method;
	Если Метод = "$count" Тогда
		Выборка = План.Выборка;
		Текст = ?(Выборка.Различные, "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ " + Выборка.ПолеКоличества + ")", "КОЛИЧЕСТВО(*)");
		Возврат Новый Структура("Текст, Тип", Текст, OData4_Генератор.НовыйТипВыражения("Число"));
	КонецЕсли;
	Выр = OData4_Генератор.Выражение(Элемент.expression, План.Контекст);
	Вид = Выр.Тип.Вид;
	Если Вид = "Литерал" Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Агрегат литерала не поддерживается: " + Элемент.alias);
	КонецЕсли;
	Если Метод = "countdistinct" Тогда
		Если Вид = "Хранилище" Или Вид = "Строка" И Выр.Тип.Длина = 0 Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "countdistinct не применяется к " + Элемент.alias);
		ИначеЕсли Вид = "Условие" Тогда
			// Условие — значением 0/1: КОЛИЧЕСТВО(РАЗЛИЧНЫЕ) от сравнения язык запросов не принимает.
			Выр = OData4_Генератор.ВыражениеПорядка(Выр, План.Контекст);
		КонецЕсли;
		Возврат Новый Структура("Текст, Тип", "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ " + Выр.Текст + ")",
			OData4_Генератор.НовыйТипВыражения("Число"));
	КонецЕсли;
	Если Метод = "sum" Или Метод = "average" Тогда
		Если Вид <> "Число" Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest",
				"Метод " + Метод + " применяется только к числам: " + Элемент.alias);
		КонецЕсли;
		Функция0 = ?(Метод = "sum", "СУММА", "СРЕДНЕЕ");
		Возврат Новый Структура("Текст, Тип", Функция0 + "(" + Выр.Текст + ")",
			OData4_Генератор.НовыйТипВыражения("Число"));
	КонецЕсли;
	Допустимый = Вид = "Число" Или Вид = "Дата" Или Вид = "Ссылка" Или Вид = "Перечисление"
		Или Вид = "Строка" И Выр.Тип.Длина > 0;
	Если Не Допустимый Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest",
			"Метод " + Метод + " не применяется к " + Элемент.alias);
	КонецЕсли;
	Функция0 = ?(Метод = "min", "МИНИМУМ", "МАКСИМУМ");
	Возврат Новый Структура("Текст, Тип", Функция0 + "(" + Выр.Текст + ")", Выр.Тип);
КонецФункции

// Шаги, меняющие состав колонок (всё, кроме identity и filter).
Функция ЕстьСменаКолонок(Шаги)
	Для Каждого Шаг Из Шаги Цикл
		Если Шаг.kind <> "identity" И Шаг.kind <> "filter" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Результат виртуальной таблицы с группировкой (остатки, обороты) — строки, которые маршрут выдаёт
// без $apply: сгруппированы по всем свойствам результата, ресурсы — суммой. Агрегаты $apply считаются
// по этим строкам, поэтому результат сначала помещается во временную таблицу ВТ_Источник: в запросе
// к виртуальной таблице 1С группирует записи только по измерениям, которые есть в запросе, и КОЛИЧЕСТВО,
// СРЕДНЕЕ, МИНИМУМ видели бы другие строки (проба: aggregate($count) по Balance() — 1, строк результата — 2).
Процедура ЗакрытьИсточник(План)
	Ресурсы = Новый Соответствие;
	Для Каждого Свойство0 Из План.Функция.Ресурсы Цикл
		Ресурсы.Вставить(Свойство0.Поле, Истина);
	КонецЦикла;
	Выборка = План.Выборка;
	Выборка.Колонки = Новый Массив;
	Свойства = Новый Массив;
	ПоИмени = Новый Соответствие;
	Для Каждого Свойство0 Из План.Набор.Свойства Цикл
		Выражение0 = Выборка.Псевдоним + "." + Свойство0.Поле;
		Если Ресурсы.Получить(Свойство0.Поле) = Истина Тогда
			Колонка = OData4_Генератор.ДобавитьКолонку(Выборка, "СУММА(" + Выражение0 + ")");
		Иначе
			Колонка = OData4_Генератор.ДобавитьКолонку(Выборка, Выражение0);
			Если Выборка.Группировка.Найти(Выражение0) = Неопределено Тогда
				Выборка.Группировка.Добавить(Выражение0);
			КонецЕсли;
		КонецЕсли;
		Копия = Новый Структура;
		Для Каждого КлючИЗначение Из Свойство0 Цикл
			Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Копия.Поле = Колонка;
		Свойства.Добавить(Копия);
		ПоИмени.Вставить(Копия.Имя, Копия);
	КонецЦикла;
	Ключ = Новый Массив;
	Для Каждого Свойство0 Из План.Набор.ПоляКлюча Цикл
		Ключ.Добавить(ПоИмени.Получить(Свойство0.Имя));
	КонецЦикла;
	Закрыть(План, Свойства, Ключ, "ВТ_Источник", План.Набор.Имя);
КонецПроцедуры

// Закрывает текущую выборку в ПОМЕСТИТЬ ВТ_ШагN (или в указанную таблицу) и открывает новую по ней.
// План.Группы не меняется: его задаёт шаг (Агрегаты), следующие шаги ключ групп сохраняют.
// Закрытая выборка сохраняет свой РАЗЛИЧНЫЕ: у набора записей регистра (строка — регистратор) шаг без
// агрегатов пишет в ВТ по строке на регистратор; сбрасывает его только Агрегаты. Группировка результата
// виртуальной таблицы (План.Группировка) к новой выборке не переходит — она уже в ВТ_Источник.
// Связь — табличные части набора, сохраняющего ключ (см. СвязьТабличныхЧастей); Неопределено — частей нет.
Процедура Закрыть(План, Свойства, Ключ, Имя = "", ИмяНабора = "", Связь = Неопределено)
	Если Имя = "" Тогда
		Номер = 1;
		Для Каждого Выборка Из План.Шаги Цикл
			Если СтрНачинаетсяС(Выборка.Поместить, "ВТ_Шаг") Тогда
				Номер = Номер + 1;
			КонецЕсли;
		КонецЦикла;
		Если Номер > 10 Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Слишком много шагов $apply");
		КонецЕсли;
		Имя = "ВТ_Шаг" + Формат(Номер, "ЧГ=0");
		// Набор шага называется набором маршрута: имя попадает в сообщения об ошибках («Свойство не
		// найдено: Набор.X»), внутренние имена шагов клиенту не видны.
		ИмяНабора = План.ИмяРезультата;
	КонецЕсли;
	План.Выборка.Поместить = Имя;
	План.Шаги.Добавить(План.Выборка);
	Набор = НаборШага(ИмяНабора, Свойства);
	Для Каждого Свойство0 Из Ключ Цикл
		Набор.Ключ.Добавить(Свойство0.Имя);
		Набор.ПоляКлюча.Добавить(Свойство0);
	КонецЦикла;
	Если Связь <> Неопределено Тогда
		Набор.ПолеСвязи = Связь.Поле;
		Набор.ТипСвязи = Связь.ТипСвязи;
		Набор.ТабличныеЧасти = Связь.ТабличныеЧасти;
		Набор.ТабличныеЧастиПоИмени = Связь.ТабличныеЧастиПоИмени;
	КонецЕсли;
	План.Набор = Набор;
	План.Выборка = OData4_Генератор.НоваяВыборка(Имя, "Ш");
	План.Контекст = OData4_Генератор.НовыйКонтекст(План.Модель, План.Параметры, Набор, "Ш");
	План.Группировка = Ложь;
	// Порядок прежнего шага относится к колонкам закрытой выборки; шаг, который его сохраняет, задаёт заново.
	План.ПорядокШага = Новый Массив;
КонецПроцедуры

// Имена, которые свойство занимает в выдаче и в путях: само имя, у составного и хранилища — Имя_Type,
// у хранилища — ещё Имя_Base64Data, у ссылки — имя навигационного свойства. С проверкой — занятое
// имя даёт 400 «Повторное имя в $apply» (иначе в JSON два одинаковых ключа или навигация скрыта).
Процедура ЗанятьИмена(Имена, Свойство0, СПроверкой)
	Список = Новый Массив;
	Список.Добавить(Свойство0.Имя);
	Если Свойство0.Вид = "Составной" Или Свойство0.Вид = "Хранилище" Тогда
		Список.Добавить(Свойство0.Имя + "_Type");
	КонецЕсли;
	Если Свойство0.Вид = "Хранилище" Тогда
		Список.Добавить(Свойство0.Имя + "_Base64Data");
	КонецЕсли;
	Если Свойство0.Вид = "Ссылка" И Свойство0.ИмяНавигации <> "" Тогда
		Список.Добавить(Свойство0.ИмяНавигации);
	КонецЕсли;
	Для Каждого Имя Из Список Цикл
		// Свойство по навигационному пути («Owner/Description») выдаётся вложенным объектом «Owner»:
		// префиксы пути заняты объектом — их могут делить другие вложенные свойства, но не плоское
		// свойство с тем же именем.
		Части = СтрРазделить(Имя, "/");
		Префикс = "";
		Для Индекс = 0 По Части.ВГраница() - 1 Цикл
			Префикс = Префикс + ?(Префикс = "", "", "/") + Части[Индекс];
			Если СПроверкой И Имена.Получить(Префикс) = Истина Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "Повторное имя в $apply: " + Префикс);
			КонецЕсли;
			Имена.Вставить(Префикс, "Объект");
		КонецЦикла;
		Если СПроверкой И Имена.Получить(Имя) <> Неопределено Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Повторное имя в $apply: " + Имя);
		КонецЕсли;
		Имена.Вставить(Имя, Истина);
	КонецЦикла;
КонецПроцедуры

// Имя ключа целевого набора навигации (у ссылочных наборов — Ref_Key).
Функция ИмяКлючаЦели(Тип0)
	Если Тип0.Набор <> Неопределено И Тип0.Набор.Ключ.Количество() = 1 Тогда
		Возврат Тип0.Набор.Ключ[0];
	КонецЕсли;
	Возврат "Ref_Key";
КонецФункции

// Имя свойства по пути группировки: путь целиком («Owner/Description»). Такое свойство выдаётся
// вложенным объектом {"Owner":{"Description":…}} (расширение агрегации OData 4.0), а следующие шаги,
// $filter, $orderby и $select обращаются к нему тем же путём.
Функция ИмяПути(Путь)
	Возврат СтрСоединить(Путь, "/");
КонецФункции

#КонецОбласти
