#Область ПрограммныйИнтерфейс

// Разбирает путь ресурса после корня HTTP-сервиса, например
// /v4/Catalog_Номенклатура(guid'…')/$count, и системные параметры запроса. Путь приходит уже раскодированным
// платформой. Маршрут: Вид (СлужебныйДокумент, Метаданные, Коллекция, Сущность, Количество), Набор, Ключ,
// Параметры (исходное Соответствие параметров), Опции (OData4_Движок.РазобратьПараметры: язык 1С или компонента).
Функция Разобрать(ОтносительныйURL, ПараметрыЗапроса) Экспорт
	Маршрут = Новый Структура("Вид, Набор, Ключ, ТекстКлюча, Функция, ПараметрыФункции, ТекстФункции, Параметры, Опции",
		"", "", Неопределено, "", "", Новый Соответствие, "", ПараметрыЗапроса, Неопределено);
	ОпределитьВид(Маршрут, ОтносительныйURL);
	Маршрут.Опции = OData4_Движок.РазобратьПараметры(ПараметрыЗапроса);
	ПроверитьОпции(Маршрут);
	Возврат Маршрут;
КонецФункции

// Маршрут записи (этап 6.2): методы POST, PUT, PATCH, MERGE, DELETE. Вид — Коллекция (POST на набор; PATCH и PUT
// константы без ключа), Сущность (по ключу) или Действие (POST «Набор(ключ)/Post», «/Post()», «/Post(Имя=…)»,
// «/StandardODATA.Post»; то же Unpost). Метод — POST, PUT, PATCH (MERGE — то же, что PATCH), DELETE. Параметры
// запроса — только $select, $expand, $format (к возвращаемому объекту), иначе 400; прочие поля — как у Разобрать.
Функция РазобратьЗапись(Метод, ОтносительныйURL, ПараметрыЗапроса) Экспорт
	Маршрут = Новый Структура("Вид, Набор, Ключ, ТекстКлюча, Функция, ПараметрыФункции, ТекстФункции, Параметры, Опции, "
		+ "Метод, Действие, ПараметрыДействия", "", "", Неопределено, "", "", Новый Соответствие, "", ПараметрыЗапроса,
		Неопределено, ВРег(Метод), "", Новый Соответствие);
	Если Маршрут.Метод = "MERGE" Тогда
		Маршрут.Метод = "PATCH";
	КонецЕсли;
	Путь = ОтносительныйURL;
	Если Путь = "/v4" Или Путь = "/v4/" Или Путь = "/v4/$metadata" Тогда
		OData4_Сервис.ОшибкаOData(405, "MethodNotAllowed", "Метод " + Маршрут.Метод + " не применяется к ресурсу " + Путь);
	КонецЕсли;
	Если Не СтрНачинаетсяС(Путь, "/v4/") Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
	КонецЕсли;
	Сегменты = РазделитьПуть(Сред(Путь, 5));
	Если Сегменты.Количество() = 0 Или Сегменты.Количество() > 2 Или Сегменты[0] = "" Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
	КонецЕсли;
	Первый = Сегменты[0];
	Скобка = СтрНайти(Первый, "(");
	Если Скобка > 0 Тогда
		Если Прав(Первый, 1) <> ")" Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверный ключ: " + Первый);
		КонецЕсли;
		Маршрут.Вид = "Сущность";
		Маршрут.Набор = Лев(Первый, Скобка - 1);
		Маршрут.ТекстКлюча = Сред(Первый, Скобка + 1, СтрДлина(Первый) - Скобка - 1);
		Маршрут.Ключ = РазобратьКлюч(Маршрут.ТекстКлюча);
	Иначе
		Маршрут.Вид = "Коллекция";
		Маршрут.Набор = Первый;
	КонецЕсли;
	Если Сегменты.Количество() = 2 Тогда
		РазобратьДействие(Маршрут, Сегменты[1], Путь);
	КонецЕсли;
	Для Каждого КлючИЗначение Из ПараметрыЗапроса Цикл
		Имя = КлючИЗначение.Ключ;
		Если СтрНачинаетсяС(Имя, "$") И Имя <> "$select" И Имя <> "$expand" И Имя <> "$format" Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Параметр " + Имя + " не применяется к записи");
		КонецЕсли;
	КонецЦикла;
	Маршрут.Опции = OData4_Движок.РазобратьПараметры(ПараметрыЗапроса);
	ПроверитьОпции(Маршрут);
	Возврат Маршрут;
КонецФункции

// Ключ ресурса: список пар «имя — текст литерала» в порядке записи в URL. Безымянная форма
// (Catalog_X(guid'…') и Catalog_X(…)) даёт одну пару с пустым именем. Значения не разбираются:
// их разрешает планировщик по ПоляКлюча набора.
Функция РазобратьКлюч(Текст) Экспорт
	Ключ = Новый Массив;
	Для Каждого Часть Из РазделитьКлюч(Текст) Цикл
		Равно = СтрНайти(Часть, "=");
		Если Равно = 0 Тогда
			Ключ.Добавить(Новый Структура("Имя, Текст", "", СокрЛП(Часть)));
		Иначе
			Ключ.Добавить(Новый Структура("Имя, Текст", СокрЛП(Лев(Часть, Равно - 1)), СокрЛП(Сред(Часть, Равно + 1))));
		КонецЕсли;
	КонецЦикла;
	Если Ключ.Количество() = 0 Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Пустой ключ");
	КонецЕсли;
	Возврат Ключ;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОпределитьВид(Маршрут, Путь)
	Если Путь = "/v4" Или Путь = "/v4/" Тогда
		Маршрут.Вид = "СлужебныйДокумент";
		Возврат;
	КонецЕсли;
	Если Не СтрНачинаетсяС(Путь, "/v4/") Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
	КонецЕсли;
	Остаток = Сред(Путь, 5);
	Если Остаток = "$metadata" Тогда
		Маршрут.Вид = "Метаданные";
		Возврат;
	КонецЕсли;
	Сегменты = РазделитьПуть(Остаток);
	Если Сегменты.Количество() = 0 Или Сегменты.Количество() > 3 Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
	КонецЕсли;
	Первый = Сегменты[0];
	Скобка = СтрНайти(Первый, "(");
	Если Скобка > 0 Тогда
		Если Прав(Первый, 1) <> ")" Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверный ключ: " + Первый);
		КонецЕсли;
		Маршрут.Вид = "Сущность";
		Маршрут.Набор = Лев(Первый, Скобка - 1);
		Маршрут.ТекстКлюча = Сред(Первый, Скобка + 1, СтрДлина(Первый) - Скобка - 1);
		Маршрут.Ключ = РазобратьКлюч(Маршрут.ТекстКлюча);
	Иначе
		Маршрут.Вид = "Коллекция";
		Маршрут.Набор = Первый;
	КонецЕсли;
	Если Сегменты.Количество() >= 2 Тогда
		Если Сегменты[1] = "$count" Тогда
			Если Маршрут.Вид <> "Коллекция" Или Сегменты.Количество() > 2 Тогда
				OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
			КонецЕсли;
			Маршрут.Вид = "Количество";
			Возврат;
		КонецЕсли;
		Если Маршрут.Вид = "Сущность" И Сегменты.Количество() = 2 И ЭтоДействиеЗаписи(Сегменты[1]) Тогда
			OData4_БезопасностьВызов.Контекст().ЗаголовкиОтвета.Вставить("Allow", "POST");
			OData4_Сервис.ОшибкаOData(405, "MethodNotAllowed", "Действие выполняется методом POST: " + Путь);
		КонецЕсли;
		Если Маршрут.Вид <> "Коллекция" Тогда
			OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
		КонецЕсли;
		РазобратьФункцию(Маршрут, Сегменты[1], Путь);
	КонецЕсли;
	Если Сегменты.Количество() = 3 Тогда
		Если Сегменты[2] <> "$count" Тогда
			OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
		КонецЕсли;
		Маршрут.Вид = "Количество";
	КонецЕсли;
КонецПроцедуры

// Сегмент вызова функции: «Имя(параметры)» или «StandardODATA.Имя(параметры)». Скобки обязательны
// (как в standard.odata). Параметры — пары «имя = текст литерала»; значения не разбираются.
Процедура РазобратьФункцию(Маршрут, Сегмент, Путь)
	Скобка = СтрНайти(Сегмент, "(");
	Если Скобка = 0 Или Прав(Сегмент, 1) <> ")" Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
	КонецЕсли;
	Имя = Лев(Сегмент, Скобка - 1);
	Если СтрНачинаетсяС(Имя, "StandardODATA.") Тогда
		Имя = Сред(Имя, 15);
	КонецЕсли;
	Если Имя = "" Или СтрНайти(Имя, ".") > 0 Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
	КонецЕсли;
	Маршрут.Функция = Имя;
	Маршрут.ТекстФункции = Сегмент;
	Аргументы = Сред(Сегмент, Скобка + 1, СтрДлина(Сегмент) - Скобка - 1);
	Для Каждого Часть Из РазделитьКлюч(Аргументы) Цикл
		Равно = СтрНайти(Часть, "=");
		Если Равно = 0 Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest",
				"Параметр функции " + Имя + " задан без имени: " + СокрЛП(Часть));
		КонецЕсли;
		ИмяПараметра = СокрЛП(Лев(Часть, Равно - 1));
		Если Маршрут.ПараметрыФункции.Получить(ИмяПараметра) <> Неопределено Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Повторный параметр функции " + Имя + ": " + ИмяПараметра);
		КонецЕсли;
		Маршрут.ПараметрыФункции.Вставить(ИмяПараметра, СокрЛП(Сред(Часть, Равно + 1)));
	КонецЦикла;
КонецПроцедуры

// Сегмент действия после сущности: «Post», «Post()», «Post(PostingModeOperational=true)», «StandardODATA.Post…»
// (standard.odata принимает только неквалифицированные формы; квалифицированная — форма связанного действия OData v4).
// Параметры — пары «имя = текст литерала», как у функций. Известны Post и Unpost; иное — 404.
Процедура РазобратьДействие(Маршрут, Сегмент, Путь)
	Имя = Сегмент;
	Аргументы = "";
	Скобка = СтрНайти(Сегмент, "(");
	Если Скобка > 0 Тогда
		Если Прав(Сегмент, 1) <> ")" Тогда
			OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
		КонецЕсли;
		Имя = Лев(Сегмент, Скобка - 1);
		Аргументы = Сред(Сегмент, Скобка + 1, СтрДлина(Сегмент) - Скобка - 1);
	КонецЕсли;
	Если СтрНачинаетсяС(Имя, "StandardODATA.") Тогда
		Имя = Сред(Имя, 15);
	КонецЕсли;
	Если Маршрут.Вид <> "Сущность" Или (Имя <> "Post" И Имя <> "Unpost") Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Ресурс не найден: " + Путь);
	КонецЕсли;
	Маршрут.Вид = "Действие";
	Маршрут.Действие = Имя;
	Для Каждого Часть Из РазделитьКлюч(Аргументы) Цикл
		Равно = СтрНайти(Часть, "=");
		Если Равно = 0 Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest",
				"Параметр действия " + Имя + " задан без имени: " + СокрЛП(Часть));
		КонецЕсли;
		ИмяПараметра = СокрЛП(Лев(Часть, Равно - 1));
		Если Маршрут.ПараметрыДействия.Получить(ИмяПараметра) <> Неопределено Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Повторный параметр действия " + Имя + ": " + ИмяПараметра);
		КонецЕсли;
		Маршрут.ПараметрыДействия.Вставить(ИмяПараметра, СокрЛП(Сред(Часть, Равно + 1)));
	КонецЦикла;
КонецПроцедуры

// Действие записи в пути ресурса чтения (GET …/Post()): у standard.odata GET проводит документ (проба 6.2, П6), здесь —
// 405: действие выполняется только методом POST.
Функция ЭтоДействиеЗаписи(Сегмент) Экспорт
	Имя = Сегмент;
	Скобка = СтрНайти(Сегмент, "(");
	Если Скобка > 0 Тогда
		Имя = Лев(Сегмент, Скобка - 1);
	КонецЕсли;
	Если СтрНачинаетсяС(Имя, "StandardODATA.") Тогда
		Имя = Сред(Имя, 15);
	КонецЕсли;
	Возврат Имя = "Post" Или Имя = "Unpost";
КонецФункции

// $format и параметры, неприменимые к виду маршрута (400).
// К одной сущности применяются только $select, $expand, $format; к /$count не применяется $skiptoken
// ($orderby, $top, $skip, $expand, $count на количество не влияют и не рассматриваются; $select не влияет,
// кроме остатков и оборотов без Dimensions: их строки группируются по свойствам $select и $filter, как
// в standard.odata, — решение 28).
Процедура ПроверитьОпции(Маршрут)
	Опции = Маршрут.Опции;
	Если Опции.format <> Неопределено Тогда
		ВидФормата = НРег(СокрЛП(СтрРазделить(Опции.format + ";", ";")[0]));
		Допустимые = "json,application/json" + ?(Маршрут.Вид = "Метаданные", ",xml,application/xml", "");
		Если СтрРазделить(Допустимые, ",").Найти(ВидФормата) = Неопределено Тогда
			OData4_Сервис.ОшибкаOData(406, "NotAcceptable", "Формат не поддерживается: " + Опции.format);
		КонецЕсли;
	КонецЕсли;
	Если Маршрут.Вид = "Сущность" Тогда
		Для Каждого Имя Из СтрРазделить("filter,orderby,top,skip,count,skiptoken,apply", ",") Цикл
			Если Опции[Имя] <> Неопределено Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest",
					"Параметр " + ИмяПараметра(Маршрут, Имя) + " не применяется к одной сущности");
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Маршрут.Вид = "Количество" И Опции.skiptoken <> Неопределено Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Параметр $skiptoken не применяется к $count");
	КонецЕсли;
	// $skiptoken и $expand с $apply проверяет планировщик: результат $apply продолжается меткой по ключу (у
	// groupby — по полям группировки), метки нет только у groupby по стольким полям, что условие продолжения
	// не помещается в пределы выражения, или по таким длинным полям, что @odata.nextLink с меткой мог бы
	// превысить 8000 символов (Apache принимает строку запроса до 8190) — тогда $skip; $expand у groupby
	// и aggregate — 501.
КонецПроцедуры

// Имя параметра для сообщения об ошибке: count клиент мог прислать как $count или как v3 $inlinecount.
Функция ИмяПараметра(Маршрут, Имя)
	Если Имя = "count" И Маршрут.Параметры.Получить("$count") = Неопределено
		И Маршрут.Параметры.Получить("$inlinecount") <> Неопределено Тогда
		Возврат "$inlinecount";
	КонецЕсли;
	Возврат "$" + Имя;
КонецФункции

Функция ГУИДИзЛитерала(Литерал)
	Текст = Литерал;
	Если СтрНачинаетсяС(НРег(Текст), "guid'") И Прав(Текст, 1) = "'" Тогда
		Текст = Сред(Текст, 6, СтрДлина(Текст) - 6);
	КонецЕсли;
	Попытка
		Возврат Строка(Новый УникальныйИдентификатор(Текст));
	Исключение
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверный GUID: " + Литерал);
	КонецПопытки;
КонецФункции

Функция ЧислоИзЛитерала(Литерал)
	Текст = Литерал;
	Если Прав(ВРег(Текст), 1) = "L" Тогда
		Текст = Лев(Текст, СтрДлина(Текст) - 1);
	КонецЕсли;
	Попытка
		Возврат Число(Текст);
	Исключение
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверное число: " + Литерал);
	КонецПопытки;
КонецФункции

// Разделение пути по косой черте вне строкового литерала и скобок функции:
// Condition может содержать навигационный путь «Организация/Description».
Функция РазделитьПуть(Текст)
	Части = Новый Массив;
	Текущая = "";
	ВСтроке = Ложь;
	Глубина = 0;
	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) Цикл
		Сим = Сред(Текст, Позиция, 1);
		Если Сим = "'" Тогда
			Если ВСтроке И Позиция < СтрДлина(Текст) И Сред(Текст, Позиция + 1, 1) = "'" Тогда
				Текущая = Текущая + "''";
				Позиция = Позиция + 2;
				Продолжить;
			КонецЕсли;
			ВСтроке = Не ВСтроке;
		ИначеЕсли Не ВСтроке И Сим = "(" Тогда
			Глубина = Глубина + 1;
		ИначеЕсли Не ВСтроке И Сим = ")" Тогда
			Глубина = Макс(0, Глубина - 1);
		ИначеЕсли Сим = "/" И Не ВСтроке И Глубина = 0 Тогда
			Части.Добавить(Текущая);
			Текущая = "";
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		Текущая = Текущая + Сим;
		Позиция = Позиция + 1;
	КонецЦикла;
	Части.Добавить(Текущая);
	Возврат Части;
КонецФункции

// Разделение ключа запятыми вне строковых литералов: значение может содержать запятую
// (Recorder_Type='StandardODATA.Document_X', строки с запятыми внутри кавычек).
Функция РазделитьКлюч(Текст)
	Части = Новый Массив;
	Текущая = "";
	ВСтроке = Ложь;
	Позиция = 1;
	Длина = СтрДлина(Текст);
	Пока Позиция <= Длина Цикл
		Сим = Сред(Текст, Позиция, 1);
		Если Сим = "'" Тогда
			ВСтроке = Не ВСтроке;
			Текущая = Текущая + Сим;
		ИначеЕсли Сим = "," И Не ВСтроке Тогда
			Если СокрЛП(Текущая) <> "" Тогда
				Части.Добавить(Текущая);
			КонецЕсли;
			Текущая = "";
		Иначе
			Текущая = Текущая + Сим;
		КонецЕсли;
		Позиция = Позиция + 1;
	КонецЦикла;
	Если СокрЛП(Текущая) <> "" Тогда
		Части.Добавить(Текущая);
	КонецЕсли;
	Возврат Части;
КонецФункции

#КонецОбласти
