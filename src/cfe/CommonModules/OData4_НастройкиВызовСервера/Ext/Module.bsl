#Область ПрограммныйИнтерфейс

// Тексты предупреждений об опасных настройках OData4 для показа при запуске 1С:Предприятия: пустой массив,
// если пользователь не администратор OData4 или опасного нет. Никогда не бросает исключение: сбой не мешает
// запуску и пишется в журнал регистрации (событие OData4.Настройки).
Функция ПредупрежденияПриЗапуске() Экспорт
	Попытка
		// Права проверяются до чтения настроек: у пользователя без роли OData4 прав на регистр настроек нет,
		// и чтение оставляло бы две записи в журнале регистрации при каждом входе (дефект приёмки 5.3 Д7).
		Если Не (ПравоДоступа("Администрирование", Метаданные) Или АдминистраторOData4()) Тогда
			Возврат Новый Массив;
		КонецЕсли;
		Возврат ТекстыПредупреждений(ОпасныеНастройки(), Истина);
	Исключение
		// Узнанная гонка сеанса (настройки доступа недоступны, 503) — предупреждение: при развёртывании она
		// бывает у каждого запуска и не значит поломки. Всё остальное — ошибка.
		Информация = ИнформацияОбОшибке();
		Уровень = ?(СтрНайти(Информация.Описание, "ODATA4|503") > 0, УровеньЖурналаРегистрации.Предупреждение,
			УровеньЖурналаРегистрации.Ошибка);
		ЗаписьЖурналаРегистрации("OData4.Настройки", Уровень, , ,
			"Предупреждения при запуске не проверены: " + ПодробноеПредставлениеОшибки(Информация));
	КонецПопытки;
	Возврат Новый Массив;
КонецФункции

// Тексты для показа: опасные настройки — только администратору OData4.
Функция ТекстыПредупреждений(Опасное, ЭтоАдминистратор) Экспорт
	Тексты = Новый Массив;
	Если Не ЭтоАдминистратор Тогда
		Возврат Тексты;
	КонецЕсли;
	Для Каждого Текст Из Опасное Цикл
		Тексты.Добавить(Текст);
	КонецЦикла;
	Возврат Тексты;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Тексты опасных настроек доступа (OData4_Безопасность.ОпасныеНастройки: служебная учётка с правами
// администратора, привилегированный режим, роли расширения без OData4Права и т. п.).
Функция ОпасныеНастройки()
	Тексты = Новый Массив;
	Для Каждого Опасное Из OData4_Безопасность.ОпасныеНастройки() Цикл
		Тексты.Добавить(Опасное.Текст);
	КонецЦикла;
	Возврат Тексты;
КонецФункции

// Доступна ли текущему пользователю роль OData4_Администратор: настройки OData4 ведёт и тот, у кого нет
// права «Администрирование» конфигурации (замечание QA 7).
Функция АдминистраторOData4()
	Возврат Метаданные.Роли.Найти("OData4_Администратор") <> Неопределено И РольДоступна("OData4_Администратор");
КонецФункции

#КонецОбласти
