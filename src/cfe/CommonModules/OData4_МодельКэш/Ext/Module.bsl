#Область ПрограммныйИнтерфейс

// Изменяемое Соответствие на время сеанса: модель и документы $metadata текущего ключа (кэш с явной границей —
// OData4_МодельПовтИсп.ЗначениеКэша), последний прочитанный ключ состава и т. п. Платформа может очистить этот
// кэш в любой момент — значения строятся заново.
Функция ПамятьСеанса() Экспорт
	Возврат Новый Соответствие;
КонецФункции

// Функции языка запросов, доступные на этой платформе в режиме совместимости базы: Соответствие имя → Булево.
// Кэш на сеанс.
Функция ДоступныеФункции() Экспорт
	Проверки = Новый Структура;
	Проверки.Вставить("ДЛИНАСТРОКИ", "ДЛИНАСТРОКИ(&С)");
	Проверки.Вставить("ВРЕГ", "ВРЕГ(&С)");
	Проверки.Вставить("НРЕГ", "НРЕГ(&С)");
	Проверки.Вставить("СТРНАЙТИ", "СТРНАЙТИ(&С, &С)");
	Проверки.Вставить("СОКРЛП", "СОКРЛП(&С)");
	Проверки.Вставить("ОКР", "ОКР(&Ч, 0)");
	Проверки.Вставить("ЦЕЛ", "ЦЕЛ(&Ч)");
	Результат = Новый Соответствие;
	Для Каждого КлючИЗначение Из Проверки Цикл
		Запрос = Новый Запрос("ВЫБРАТЬ " + КлючИЗначение.Значение + " КАК З");
		Запрос.УстановитьПараметр("С", "абв");
		Запрос.УстановитьПараметр("Ч", 1.5);
		Попытка
			Запрос.Выполнить();
			Результат.Вставить(КлючИЗначение.Ключ, Истина);
		Исключение
			Результат.Вставить(КлючИЗначение.Ключ, Ложь);
		КонецПопытки;
	КонецЦикла;
	Возврат Новый ФиксированноеСоответствие(Результат);
КонецФункции

#КонецОбласти
