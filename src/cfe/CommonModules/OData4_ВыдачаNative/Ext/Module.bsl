#Область ПрограммныйИнтерфейс

// Выдача JSON внешней компонентой OData4Native (этап 8.1, настройка «Выдача JSON»). Язык 1С выполняет запрос,
// загружает табличные части и считает головные поля ответа (@odata.context, @odata.count, @odata.nextLink); компонента
// пишет весь текст ответа по описанию узла выдачи (OData4_Планировщик.УзелВыдачи) и строкам, переданным
// ЗначениеВСтрокуВнутр (массив: основная выборка и таблицы коллекций), побайтно как OData4_Чтение.ЗаписатьСвойстваУзла.
// Типы ссылок, перечисления, представления типов и смещения часового пояса базы компонента берёт из словаря
// (СловарьJSON): он строится один раз на процесс, ключ меняется со сменой конфигурации, расширений или пояса.

// Текст ответа компонентой или Неопределено: узел содержит вид, который пишет только язык 1С (хранилище, описание
// типов, точка маршрута), компонента недоступна или дала сбой (сбой — в журнал регистрации, событие
// OData4.Компонента). Параметры — Структура:
//   Вид — "collection" или "entity"; Узел — узел выдачи плана; Строки — ТаблицаЗначений основной выборки;
//   С, По — номера строк основной выборки, которые выдаются (По — не включая); Таблицы — Соответствие
//   «код коллекции → ТаблицаЗначений» (OData4_Чтение.ЗагрузитьКоллекции); Контекст — @odata.context;
//   Количество — @odata.count или Неопределено; БезИдентификатора — "@odata.id": null у строк; Следующая —
//   @odata.nextLink или Неопределено.
Функция Текст(Параметры) Экспорт
	Если Не Поддерживается(Параметры.Узел) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Компонента = OData4_Движок.КомпонентаСеанса();
	Если Компонента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ключ = ОбеспечитьСловарь(Компонента, Ложь);
		Описание = ОписаниеВыдачи(Параметры, Ключ);
		Данные = ДанныеВыдачи(Параметры, Описание);
		// Захват входа компоненты тестами (общие примеры tests/fixtures/output): массив в памяти сеанса.
		Захват = OData4_МодельКэш.ПамятьСеанса().Получить("ЗахватВыдачи");
		Если Захват <> Неопределено Тогда
			Захват.Добавить(Новый Структура("Описание, Данные", ТекстОписания(Описание), Данные));
		КонецЕсли;
		Ответ = Компонента.ВыдатьJSON(ТекстОписания(Описание), Данные);
		Если СтрНачинаетсяС(Ответ, "!нет типа") Или СтрНачинаетсяС(Ответ, "!нет значения перечисления") Тогда
			// Тип, появившийся после сборки словаря (динамическое обновление): словарь пересобирается один раз.
			Описание.Вставить("dict", ОбеспечитьСловарь(Компонента, Истина));
			Ответ = Компонента.ВыдатьJSON(ТекстОписания(Описание), Данные);
		КонецЕсли;
	Исключение
		OData4_Движок.ЗаписатьСбойКомпоненты("Выдача JSON", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
	Если Не СтрНачинаетсяС(Ответ, "{") Тогда
		OData4_Движок.ЗаписатьСбойКомпоненты("Выдача JSON", Сред(Ответ, 2));
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ответ;
КонецФункции

// Узел выдачи пишет компонента: нет видов, которые пишет только язык 1С (хранилище, описание типов, точка маршрута).
// Глубина рекурсии — вложенность раскрытий и табличных частей плана (ограничена разбором $expand).
Функция Поддерживается(Узел) Экспорт
	Для Каждого Элемент Из Узел.Свойства Цикл
		Вид = Элемент.Свойство.Вид;
		Если Вид = "Хранилище" Или Вид = "ОписаниеТипов" Или Вид = "ТочкаМаршрута" Тогда
			Возврат Ложь;
		ИначеЕсли Вид = "Вложенный" И Не Поддерживается(Элемент.Узел) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ТЧ Из Узел.ТабличныеЧасти Цикл
		Если Не Поддерживается(ТЧ.Узел) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Раскрытие Из Узел.Раскрытия Цикл
		Если Не Поддерживается(Раскрытие.Узел) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

// Словарь выдачи JSON-ом (формат — odata4_core::output::load_dictionary): типы ссылок всех объектов метаданных с
// XML-именем типа, значения перечислений конфигурации и системных перечислений видов движения и вида счёта, тип
// УникальныйИдентификатор, точки смены смещения пояса базы по местному времени.
Функция СловарьJSON() Экспорт
	Типы = Новый Соответствие;
	Значения = Новый Соответствие;
	Для Каждого Коллекция Из КоллекцииСсылок() Цикл
		Для Каждого ОбъектМетаданных Из Коллекция.Метаданные Цикл
			Пустая = Коллекция.Менеджер[ОбъектМетаданных.Имя].ПустаяСсылка();
			ТипСсылки = ТипЗнч(Пустая);
			ТипXML = XMLТип(ТипСсылки);
			Если ТипXML = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Описание = OData4_ПовтИспВызова.ОписаниеТипаЗначения(ТипXML.ИмяТипа, ТипXML.URIПространстваИмен);
			ИдТипа = ЧастьВнутр(ЗначениеВСтрокуВнутр(Пустая), 2);
			Сведения = Новый Массив;
			Сведения.Добавить(Описание.ИмяТипа);
			Сведения.Добавить(Описание.ЭтоПеречисление);
			Сведения.Добавить(Строка(ТипСсылки));
			Типы.Вставить(ИдТипа, Сведения);
			Если Коллекция.Перечисление Тогда
				Для Каждого ЗначениеМетаданных Из ОбъектМетаданных.ЗначенияПеречисления Цикл
					ЗначениеПеречисления = Коллекция.Менеджер[ОбъектМетаданных.Имя][ЗначениеМетаданных.Имя];
					Значения.Вставить(КлючЗначения(ЗначениеПеречисления), XMLСтрока(ЗначениеПеречисления));
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Системные = Новый Массив;
	Системные.Добавить(ВидДвиженияНакопления.Приход);
	Системные.Добавить(ВидДвиженияНакопления.Расход);
	Системные.Добавить(ВидДвиженияБухгалтерии.Дебет);
	Системные.Добавить(ВидДвиженияБухгалтерии.Кредит);
	Системные.Добавить(ВидСчета.Активный);
	Системные.Добавить(ВидСчета.Пассивный);
	Системные.Добавить(ВидСчета.АктивноПассивный);
	Для Каждого Системное Из Системные Цикл
		Значения.Вставить(КлючЗначения(Системное), OData4_Сериализация.ИмяВидаДвижения(Системное));
	КонецЦикла;
	Словарь = Новый Структура;
	Словарь.Вставить("types", Типы);
	Словарь.Вставить("enums", Значения);
	Словарь.Вставить("uuid", ЧастьВнутр(ЗначениеВСтрокуВнутр(Новый УникальныйИдентификатор), 2));
	Словарь.Вставить("tz", ТочкиПояса());
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Словарь);
	Возврат Запись.Закрыть();
КонецФункции

// Ключ словаря: SHA-256 отпечатка среды (платформа, конфигурация, расширения — OData4_КэшМетаданных.ОтпечатокСреды,
// с учётом настройки «Проверка изменений конфигурации») и часового пояса базы.
Функция КлючСловаря() Экспорт
	Хеш = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеш.Добавить(OData4_КэшМетаданных.ОтпечатокСреды() + "|" + OData4_ПовтИспВызова.ЧасовойПоясБазы());
	Возврат НРег(ПолучитьHexСтрокуИзДвоичныхДанных(Хеш.ХешСумма));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ключ словаря, загруженного в компоненту. Память сеанса помнит загруженный ключ: словарь строится один раз на
// процесс (компонента держит его в static), новые сеансы только спрашивают компоненту. Заново — пересборка.
Функция ОбеспечитьСловарь(Компонента, Заново)
	Память = OData4_МодельКэш.ПамятьСеанса();
	Ключ = Память.Получить("СловарьВыдачи");
	Если Ключ <> Неопределено И Не Заново Тогда
		Возврат Ключ;
	КонецЕсли;
	Ключ = КлючСловаря();
	Если Заново Или Не Компонента.ЕстьСловарьВыдачи(Ключ) Тогда
		Ошибка = Компонента.ЗагрузитьСловарьВыдачи(Ключ, СловарьJSON());
		Если Ошибка <> "" Тогда
			ВызватьИсключение Ошибка;
		КонецЕсли;
	КонецЕсли;
	Память.Вставить("СловарьВыдачи", Ключ);
	Возврат Ключ;
КонецФункции

Функция ОписаниеВыдачи(Параметры, Ключ)
	Описание = Новый Структура;
	Описание.Вставить("dict", Ключ);
	Описание.Вставить("mode", OData4_Сериализация.РежимДат());
	Описание.Вставить("kind", Параметры.Вид);
	Описание.Вставить("context", Параметры.Контекст);
	Описание.Вставить("count", Параметры.Количество);
	Описание.Вставить("idNull", Параметры.БезИдентификатора);
	Описание.Вставить("next", Параметры.Следующая);
	Описание.Вставить("from", Параметры.С);
	Описание.Вставить("to", Параметры.По);
	Описание.Вставить("tables", Новый Соответствие);
	Номер = 1;
	Для Каждого КлючИЗначение Из Параметры.Таблицы Цикл
		Описание.tables.Вставить(КлючИЗначение.Ключ, Номер);
		Номер = Номер + 1;
	КонецЦикла;
	Описание.Вставить("node", ОписаниеУзла(Параметры.Узел));
	Возврат Описание;
КонецФункции

// Массив таблиц в порядке номеров описания (tables): основная выборка, затем коллекции.
Функция ДанныеВыдачи(Параметры, Описание)
	Таблицы = Новый Массив;
	Таблицы.Добавить(Параметры.Строки);
	Для Каждого КлючИЗначение Из Параметры.Таблицы Цикл
		Таблицы.Добавить(КлючИЗначение.Значение);
	КонецЦикла;
	Возврат ЗначениеВСтрокуВнутр(Таблицы);
КонецФункции

// Описание узла выдачи для компоненты: p — свойства (n имя, k вид, c колонка, e тип Edm, d части даты, z NULL как
// пустое, nk ключ навигации, node — узел вложенного свойства), v — колонка версии данных, r — колонка ссылки,
// t — табличные части (n, code, cnt, s, f, node), x — раскрытия (n, node). Глубина — как у плана.
Функция ОписаниеУзла(Узел)
	Свойства = Новый Массив;
	Для Каждого Элемент Из Узел.Свойства Цикл
		Свойство = Элемент.Свойство;
		Описание = Новый Структура;
		Описание.Вставить("n", Свойство.Имя);
		Описание.Вставить("k", Свойство.Вид);
		Описание.Вставить("c", Элемент.Колонка);
		Описание.Вставить("e", Свойство.ТипEdm);
		Описание.Вставить("d", Свойство.ЧастиДаты);
		Описание.Вставить("z", Свойство.Свойство("NullКакПустое") И Свойство.NullКакПустое);
		Описание.Вставить("nk", Свойство.Свойство("КлючНавигации"));
		Если Свойство.Вид = "Вложенный" Тогда
			Описание.Вставить("node", ОписаниеУзла(Элемент.Узел));
		КонецЕсли;
		Свойства.Добавить(Описание);
	КонецЦикла;
	Табличные = Новый Массив;
	Для Каждого ТЧ Из Узел.ТабличныеЧасти Цикл
		Табличные.Добавить(Новый Структура("n, code, cnt, s, f, node", ТЧ.Имя, ТЧ.Код, ТЧ.СКоличеством, ТЧ.Пропуск,
			ТЧ.Первые, ОписаниеУзла(ТЧ.Узел)));
	КонецЦикла;
	Раскрытия = Новый Массив;
	Для Каждого Раскрытие Из Узел.Раскрытия Цикл
		Раскрытия.Добавить(Новый Структура("n, node", Раскрытие.Имя, ОписаниеУзла(Раскрытие.Узел)));
	КонецЦикла;
	Результат = Новый Структура("p, t, x", Свойства, Табличные, Раскрытия);
	Если Узел.Свойство("КолонкаСсылки") Тогда
		Результат.Вставить("r", Узел.КолонкаСсылки);
	КонецЕсли;
	Результат.Вставить("v", OData4_Чтение.КолонкаВерсии(Узел));
	Возврат Результат;
КонецФункции

Функция ТекстОписания(Описание)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Описание);
	Возврат Запись.Закрыть();
КонецФункции

// Коллекции объектов метаданных со ссылочными типами: Метаданные, Менеджер, Перечисление.
Функция КоллекцииСсылок()
	Коллекции = Новый Массив;
	Коллекции.Добавить(Новый Структура("Метаданные, Менеджер, Перечисление", Метаданные.Справочники, Справочники, Ложь));
	Коллекции.Добавить(Новый Структура("Метаданные, Менеджер, Перечисление", Метаданные.Документы, Документы, Ложь));
	Коллекции.Добавить(Новый Структура("Метаданные, Менеджер, Перечисление", Метаданные.ПланыВидовХарактеристик,
		ПланыВидовХарактеристик, Ложь));
	Коллекции.Добавить(Новый Структура("Метаданные, Менеджер, Перечисление", Метаданные.ПланыСчетов, ПланыСчетов, Ложь));
	Коллекции.Добавить(Новый Структура("Метаданные, Менеджер, Перечисление", Метаданные.ПланыВидовРасчета,
		ПланыВидовРасчета, Ложь));
	Коллекции.Добавить(Новый Структура("Метаданные, Менеджер, Перечисление", Метаданные.ПланыОбмена, ПланыОбмена, Ложь));
	Коллекции.Добавить(Новый Структура("Метаданные, Менеджер, Перечисление", Метаданные.БизнесПроцессы, БизнесПроцессы, Ложь));
	Коллекции.Добавить(Новый Структура("Метаданные, Менеджер, Перечисление", Метаданные.Задачи, Задачи, Ложь));
	Коллекции.Добавить(Новый Структура("Метаданные, Менеджер, Перечисление", Метаданные.Перечисления, Перечисления, Истина));
	Возврат Коллекции;
КонецФункции

// Часть номер Номер (с 1) текста внутреннего формата ссылочного значения `{"#",<UUID типа>,<значение>}`.
Функция ЧастьВнутр(Текст, Номер)
	Части = СтрРазделить(СтрЗаменить(СтрЗаменить(Текст, "{", ""), "}", ""), ",");
	Возврат СокрЛП(Части[Номер - 1]);
КонецФункции

// Ключ значения перечисления в словаре: «UUID типа|атом значения».
Функция КлючЗначения(Значение)
	Текст = ЗначениеВСтрокуВнутр(Значение);
	Возврат ЧастьВнутр(Текст, 2) + "|" + ЧастьВнутр(Текст, 3);
КонецФункции

// Точки смены смещения пояса базы (как OData4_Сериализация.СмещениеПояса) по местному времени: Массив пар
// «ГГГГММДДччммсс, смещение», первая — 0001-01-01. Поиск: годы 0001–1899 и 2101–3999 — по году, 1900–2100 — по
// месяцу, смена внутри шага уточняется делением пополам до секунды.
Функция ТочкиПояса()
	Пояс = OData4_ПовтИспВызова.ЧасовойПоясБазы();
	Точки = Новый Массив;
	Момент = Дата(1, 1, 1);
	Смещение = OData4_Сериализация.СмещениеПояса(Момент, Пояс);
	Точки.Добавить(ТочкаПояса(Момент, Смещение));
	Пока Момент < Дата(3999, 12, 1) Цикл
		Если Год(Момент) < 1900 Или Год(Момент) > 2100 Тогда
			Следующий = ДобавитьМесяц(Момент, 12);
		Иначе
			Следующий = ДобавитьМесяц(Момент, 1);
		КонецЕсли;
		СмещениеСледующего = OData4_Сериализация.СмещениеПояса(Следующий, Пояс);
		Если СмещениеСледующего <> Смещение Тогда
			Левый = Момент;
			Правый = Следующий;
			Пока Правый - Левый > 1 Цикл
				Середина = Левый + Цел((Правый - Левый) / 2);
				Если OData4_Сериализация.СмещениеПояса(Середина, Пояс) = Смещение Тогда
					Левый = Середина;
				Иначе
					Правый = Середина;
				КонецЕсли;
			КонецЦикла;
			Смещение = OData4_Сериализация.СмещениеПояса(Правый, Пояс);
			Точки.Добавить(ТочкаПояса(Правый, Смещение));
			Если Смещение <> СмещениеСледующего Тогда
				// Две смены в одном шаге: поиск продолжается с найденной точки.
				Момент = Правый;
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		Момент = Следующий;
	КонецЦикла;
	Возврат Точки;
КонецФункции

Функция ТочкаПояса(Момент, Смещение)
	Точка = Новый Массив;
	Точка.Добавить(Формат(Момент, "ДФ=yyyyMMddHHmmss; ДП=00010101000000"));
	Точка.Добавить(Смещение);
	Возврат Точка;
КонецФункции

#КонецОбласти
