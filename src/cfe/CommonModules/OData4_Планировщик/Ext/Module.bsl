#Область ПрограммныйИнтерфейс

// План чтения набора. ВидМаршрута: Коллекция, Сущность или Количество. Опции — результат
// OData4_Разбор.РазобратьПараметры. План: Модель, Набор, ИмяНабора (набор маршрута — для сообщений: Набор
// после $apply — набор шага), Параметры (общие для всех запросов плана),
// Выборка (основной запрос), Узел (узел выдачи основной выборки), Порядок (элементы метки продолжения),
// Коллекции (запросы строк табличных частей), Контекст (контекст выражений основной выборки),
// Шаги (выборки $apply с ПОМЕСТИТЬ, выполняются в одном пакете перед основной), Продолжение
// («Ключ» — метка по ключу набора; «Пропуск» — $skip у результата groupby, условие продолжения которого
// не помещается в пределы генератора), Группы (строки — группы groupby/aggregate $apply, а не сущности),
// ПорядокШага (порядок результата topcount/bottomcount: Структуры «Выражение, Убывание, Тип»;
// применяется, если $orderby не задан).
// Узлы выдачи строятся рекурсивно; ошибка в глубине запоминается (План.Ошибка) и бросается здесь,
// на верхнем уровне; условия и порядок коллекций строятся после обхода, плоским циклом.
Функция ПланЧтения(Модель, Набор, Опции, ВидМаршрута, Функция0 = "", ПараметрыФункции = Неопределено) Экспорт
	План = Новый Структура;
	План.Вставить("Модель", Модель);
	План.Вставить("Набор", Набор);
	План.Вставить("ИмяНабора", Набор.Имя);
	План.Вставить("Параметры", Новый Структура);
	План.Вставить("Выборка", OData4_Генератор.НоваяВыборка(OData4_Модель.ТаблицаЧтения(Набор), "Т"));
	Если Набор.Вид = "НаборЗаписей" Тогда
		План.Выборка.Различные = Истина;
		План.Выборка.ПолеКоличества = "Т." + Набор.ПолеСвязи;
	КонецЕсли;
	План.Вставить("Узел", Неопределено);
	План.Вставить("Порядок", Новый Массив);
	План.Вставить("КлючПорядка", Новый Массив);
	План.Вставить("Коллекции", Новый Массив);
	План.Вставить("Контекст", OData4_Генератор.НовыйКонтекст(Модель, План.Параметры, Набор, "Т"));
	План.Вставить("Ошибка", Неопределено);
	План.Вставить("Функция", Неопределено);
	План.Вставить("Значения", Неопределено);
	План.Вставить("Группировка", Ложь);
	План.Вставить("Шаги", Новый Массив);
	План.Вставить("Продолжение", "Ключ");
	План.Вставить("Группы", Ложь);
	План.Вставить("ПричинаПропуска", "");
	// Отзыв безопасности: раскрытия (соединения навигаций и выборки табличных частей раскрытых объектов) считаются,
	// сверх базового лимита — 400 (у «$expand=*($expand=*($expand=*))» их сотни).
	План.Вставить("Раскрытий", 0);
	План.Вставить("НаибольшееЧислоРаскрытий", OData4_Безопасность.НаибольшееЧислоРаскрытий());
	План.Вставить("ПорядокШага", Новый Массив);
	Если Функция0 <> "" Тогда
		// Отборы профиля у виртуальной таблицы — в её условии (OData4_ВиртуальныеТаблицы.ИсточникПлана).
		ПрименитьФункцию(План, Функция0, ПараметрыФункции, Опции, ВидМаршрута);
	Иначе
		// Отборы строк профиля (5.2) — в выборке источника: до $apply, поэтому действуют и в шагах, и в ВТ_Источник.
		ДобавитьУсловияПрофиля(План, План.Выборка, План.Набор, План.Выборка.Псевдоним);
		Если План.Ошибка <> Неопределено Тогда
			OData4_Сервис.ОшибкаOData(План.Ошибка.Статус, План.Ошибка.Код, План.Ошибка.Сообщение);
		КонецЕсли;
	КонецЕсли;
	// $apply — после источника (набор или результат виртуальной таблицы), $filter — после $apply.
	Шаги = Неопределено;
	Если Опции.Свойство("apply", Шаги) И Шаги <> Неопределено Тогда
		OData4_ПланApply.Применить(План, Шаги);
	КонецЕсли;
	Если Опции.filter <> Неопределено Тогда
		План.Выборка.Условия.Добавить(OData4_Генератор.Условие(Опции.filter, План.Контекст));
	КонецЕсли;
	Если ВидМаршрута = "Количество" Тогда
		Если План.Группировка Тогда
			ПрименитьГруппировкуКоличества(План);
		КонецЕсли;
		Возврат План;
	КонецЕсли;
	Если Опции.expand <> Неопределено И План.Группы Тогда
		// Строки groupby и aggregate — не сущности набора; у цепочек, сохраняющих ключ, $expand работает.
		OData4_Сервис.ОшибкаOData(501, "NotImplemented", "$expand поверх результата groupby/aggregate не поддерживается");
	КонецЕсли;
	Если План.Группировка И Опции.expand <> Неопределено Тогда
		// Раскрытие добавляет колонки связанного объекта, а группировать можно только колонки функции.
		ЗакрытьГруппировкуРезультата(План);
	КонецЕсли;
	План.Узел = УзелВыдачи(План, План.Выборка, План.Набор, План.Выборка.Псевдоним, Опции.select, Опции.expand, 0,
		Новый Структура("Код, Волна", "", 0));
	Если План.Ошибка <> Неопределено Тогда
		OData4_Сервис.ОшибкаOData(План.Ошибка.Статус, План.Ошибка.Код, План.Ошибка.Сообщение);
	КонецЕсли;
	Для Каждого Описание Из План.Коллекции Цикл
		ПрименитьОпцииКоллекции(План, Описание);
	КонецЦикла;
	Если План.Набор.Вид = "Шаг" Тогда
		// Результат $apply со сменой колонок (решение 12): свойства по навигационным путям — вложенными
		// объектами, @odata.context — набор и перечень выданных свойств «Валюта_Key,Макс,Owner(Description)».
		План.Узел.Свойства = ВложенныеСвойства(План.Узел.Свойства);
		План.Узел.СписокКонтекста = СписокКонтекстаШага(План.Узел, Опции.select);
	КонецЕсли;
	ЗаполнитьКлючПорядка(План);
	Если ВидМаршрута = "Коллекция" Тогда
		ДобавитьПорядок(План, Опции.orderby);
		Помещается = ПродолжениеПомещается(План);
		Если План.Группы И Не Помещается Тогда
			// Результат groupby по многим полям: лексикографическое условие по ним и $orderby вышло бы за пределы
			// вложенности или длины выражения — продолжение по $skip (решение 11).
			План.Продолжение = "Пропуск";
			План.ПричинаПропуска = "условие продолжения по " + Формат(План.Порядок.Количество()
				+ План.КлючПорядка.Количество(), "ЧГ=0") + " полям превышает пределы выражения";
		ИначеЕсли Не Помещается Тогда
			// Отзыв безопасности: без проверки первая страница выдавалась, а переход по @odata.nextLink давал 500.
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Условие продолжения по "
				+ Формат(План.Порядок.Количество() + План.КлючПорядка.Количество(), "ЧГ=0")
				+ " полям ($orderby и ключ набора) превышает пределы выражения: сократите $orderby");
		КонецЕсли;
	КонецЕсли;
	Если План.Выборка.Колонки.Количество() = 0 Тогда
		// Выбраны только свойства без поля в базе ($select=SurrogateKey): ВЫБРАТЬ без колонок недопустимо,
		// строка всё равно нужна — колонка-заглушка.
		OData4_Генератор.ДобавитьКолонку(План.Выборка, "ИСТИНА");
	КонецЕсли;
	// Группировка — после всех колонок и порядка: колонки ключа и $orderby тоже должны войти в неё.
	Если План.Группировка Тогда
		ПрименитьГруппировкуРезультата(План);
	КонецЕсли;
	Возврат План;
КонецФункции

// Условие по ключу сущности: по одному равенству на каждое поле ключа набора (Набор.ПоляКлюча).
// Ключ — массив пар «Имя, Текст» из маршрутизатора; безымянная пара допустима, только если поле ключа
// одно. Составное поле (Recorder) требует пары «Имя» и «Имя_Type».
Процедура ДобавитьУсловиеКлюча(План, Ключ) Экспорт
	Набор = План.Набор;
	Тексты = Новый Соответствие;
	Для Каждого Пара Из Ключ Цикл
		Имя = Пара.Имя;
		Если Имя = "" Тогда
			Если Набор.Ключ.Количество() <> 1 Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest",
					"Ключ набора " + Набор.Имя + " состоит из свойств: " + СтрСоединить(Набор.Ключ, ", "));
			КонецЕсли;
			Имя = Набор.Ключ[0];
		ИначеЕсли Набор.Ключ.Найти(Имя) = Неопределено Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неизвестное свойство ключа: " + Имя);
		КонецЕсли;
		Если Тексты.Получить(Имя) <> Неопределено Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Повторное свойство ключа: " + Имя);
		КонецЕсли;
		Тексты.Вставить(Имя, Пара.Текст);
	КонецЦикла;
	Для Каждого Свойство Из Набор.ПоляКлюча Цикл
		Текст = Тексты.Получить(Свойство.Имя);
		Если Текст = Неопределено Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "В ключе нет " + Свойство.Имя);
		КонецЕсли;
		Если Свойство.Поле = "" Тогда
			// Суррогатный ключ: SurrogateKey каждой записи — 0 (как у standard.odata в константах). Без
			// КлючПродолжения (независимый регистр) запись не больше одной: ключ 0 — она (без условия),
			// другое число — ни одной. У подчинённого регистра записей много — ключ ни одну не выделяет.
			Если Набор.КлючПродолжения.Количество() > 0 Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "Суррогатный ключ не выделяет одну запись набора "
					+ Набор.Имя + ": у каждой записи SurrogateKey = 0");
			ИначеЕсли ЗначениеПоля(План, Свойство, Текст) <> 0 Тогда
				План.Выборка.Условия.Добавить("ЛОЖЬ");
			КонецЕсли;
			Продолжить;
		ИначеЕсли Свойство.Вид = "Составной" Тогда
			ТекстТипа = Тексты.Получить(Свойство.Имя + "_Type");
			Если ТекстТипа = Неопределено Тогда
				OData4_Сервис.ОшибкаOData(400, "BadRequest", "В ключе нет " + Свойство.Имя + "_Type");
			КонецЕсли;
			Значение = СоставнаяСсылка(План, Свойство, Текст, ТекстТипа);
		Иначе
			Значение = ЗначениеПоля(План, Свойство, Текст);
		КонецЕсли;
		План.Выборка.Условия.Добавить(План.Выборка.Псевдоним + "." + Свойство.Поле + " = "
			+ ДобавитьПараметр(План, Значение));
	КонецЦикла;
КонецПроцедуры

// Метка продолжения ($skiptoken) для строки основной выборки: JSON-массив значений порядка,
// затем значений ключа набора.
Функция МеткаПродолжения(План, СтрокаВыборки) Экспорт
	Значения = Новый Массив;
	Для Каждого Элемент Из План.Порядок Цикл
		Значения.Добавить(ЗначениеМетки(СтрокаВыборки[Элемент.Колонка]));
	КонецЦикла;
	Для Каждого Элемент Из План.КлючПорядка Цикл
		Если Элемент.Тип.Вид = "Составной" Тогда
			Значения.Добавить(ЗначениеМеткиСоставного(План, СтрокаВыборки[Элемент.Колонка]));
		Иначе
			Значения.Добавить(ЗначениеМетки(СтрокаВыборки[Элемент.Колонка]));
		КонецЕсли;
	КонецЦикла;
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значения);
	Возврат Запись.Закрыть();
КонецФункции

// Условие «строки после метки» в порядке выборки: (о1 > з1) ИЛИ (о1 = з1 И (о2 > з2 ИЛИ …)).
// Хвост цепочки — равенство по всем полям ключа, кроме последнего, и «больше» по последнему.
// NULL — как в УПОРЯДОЧИТЬ ПО 1С: меньше любого значения (первым по возрастанию, последним по убыванию).
Процедура ДобавитьПродолжение(План, Метка) Экспорт
	Если План.Продолжение = "Пропуск" Тогда
		// Результат groupby, условие продолжения которого не помещается в пределы генератора, продолжается
		// $skip (решение 11): метку расширение не выдаёт.
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Параметр $skiptoken не применяется к результату $apply: "
			+ План.ПричинаПропуска);
	КонецЕсли;
	Если План.Порядок.Количество() + План.КлючПорядка.Количество() = 0 Тогда
		// Нет ни $orderby, ни полей ключа (ПоляПорядкаКлюча пусто): у набора с одним суррогатным ключом без
		// КлючПродолжения — запись не больше одной, у результата $apply без ключа (aggregate) — одна
		// строка; следующей страницы не бывает, метке продолжать не по чему.
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "У ключа набора нет полей для $skiptoken: " + План.ИмяНабора);
	КонецЕсли;
	Значения = ПрочитатьМетку(План, Метка);
	План.Выборка.УсловияПродолжения.Добавить(ТекстПродолжения(План, Значения));
КонецПроцедуры

// Наибольшая длина метки продолжения плана в @odata.nextLink (после кодирования URL) — оценка сверху по
// типам элементов: строка — 9 символов на символ длины (кириллица в UTF-8 — «%D0%90», экранирование JSON
// «\"» — «%5C%22»), число — 40, дата — 30, GUID — 45, ссылка — GUID и имя типа (6 символов на символ имени),
// составное значение и прочее — 1000; скобки и запятые массива — по 3.
Функция НаибольшаяДлинаМетки(План) Экспорт
	Длина = 6;
	Элементы = Новый Массив;
	Для Каждого Элемент Из План.Порядок Цикл
		Элементы.Добавить(Элемент.Тип);
	КонецЦикла;
	Для Каждого Элемент Из План.КлючПорядка Цикл
		Элементы.Добавить(Элемент.Тип);
	КонецЦикла;
	Для Каждого Тип0 Из Элементы Цикл
		Вид = Тип0.Вид;
		Если Вид = "Строка" Тогда
			Длина = Длина + ?(Тип0.Длина = 0, 100000, Тип0.Длина * 9 + 6);
		ИначеЕсли Вид = "Число" Тогда
			Длина = Длина + 40;
		ИначеЕсли Вид = "Дата" Тогда
			Длина = Длина + 30;
		ИначеЕсли Вид = "Гуид" Тогда
			Длина = Длина + 45;
		ИначеЕсли Вид = "Ссылка" И Тип0.Набор <> Неопределено Тогда
			Длина = Длина + 60 + СтрДлина("StandardODATA." + Тип0.Набор.Имя) * 6;
		Иначе
			Длина = Длина + 1000;
		КонецЕсли;
		Длина = Длина + 3;
	КонецЦикла;
	Возврат Длина;
КонецФункции

// Условие продолжения помещается в пределы генератора (вложенность 60, длина 50000): проверяется текст
// с непустыми значениями — самый длинный и глубокий (у NULL «больше» короче).
Функция ПродолжениеПомещается(План)
	Если План.Порядок.Количество() + План.КлючПорядка.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Текст = ТекстПродолжения(План, Неопределено);
	Возврат СтрДлина(Текст) <= 50000 И OData4_Генератор.ВложенностьВыражения(Текст) <= 60;
КонецФункции

// Текст условия «строки после метки» (см. ДобавитьПродолжение). Значения — значения метки; Неопределено —
// текст для проверки пределов: вместо параметров «&П0», параметры плана не добавляются.
Функция ТекстПродолжения(План, Значения)
	Элементы = Новый Массив;
	Для Каждого Элемент Из План.Порядок Цикл
		Элементы.Добавить(Новый Структура("Выражение, Убывание", Элемент.Выражение, Элемент.Убывание));
	КонецЦикла;
	Для Каждого Элемент Из План.КлючПорядка Цикл
		Элементы.Добавить(Новый Структура("Выражение, Убывание", Элемент.Выражение, Ложь));
	КонецЦикла;
	Условие = "";
	Для Индекс = 1 По Элементы.Количество() Цикл
		Номер = Элементы.Количество() - Индекс;
		Элемент = Элементы[Номер];
		Значение = ?(Значения = Неопределено, Неопределено, Значения[Номер]);
		Выражение = Элемент.Выражение;
		Если Значения <> Неопределено И Значение = NULL Тогда
			Равно = Выражение + " ЕСТЬ NULL";
			Больше = ?(Элемент.Убывание, "", "НЕ " + Выражение + " ЕСТЬ NULL");
		Иначе
			Параметр = ?(Значения = Неопределено, "&П0", ДобавитьПараметр(План, Значение));
			Равно = Выражение + " = " + Параметр;
			Больше = ?(Элемент.Убывание, "(" + Выражение + " < " + Параметр + " ИЛИ " + Выражение + " ЕСТЬ NULL)",
				Выражение + " > " + Параметр);
		КонецЕсли;
		Если Условие = "" Тогда
			Условие = ?(Больше = "", Равно + " И ЛОЖЬ", Больше);
		Иначе
			Условие = "(" + ?(Больше = "", "", Больше + " ИЛИ ") + Равно + " И " + Условие + ")";
		КонецЕсли;
	КонецЦикла;
	Возврат Условие;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДобавитьПараметр(План, Значение)
	Возврат OData4_Генератор.ДобавитьПараметр(План.Контекст, Значение);
КонецФункции

// Отборы строк профиля (OData4_Безопасность.УсловияНабора) в условия выборки; ошибка перевода — ОшибкаПлана.
Процедура ДобавитьУсловияПрофиля(План, Выборка, Набор, Псевдоним)
	Итог = OData4_Безопасность.УсловияНабора(План.Параметры, Набор, Псевдоним);
	Если Итог.Ошибка <> Неопределено Тогда
		ВнутренняяОшибкаПлана(План, Итог.Ошибка);
		Возврат;
	КонецЕсли;
	Для Каждого Условие0 Из Итог.Условия Цикл
		Выборка.Условия.Добавить(Условие0);
	КонецЦикла;
КонецПроцедуры

// Запоминает первую ошибку как внутреннюю (500): отбор профиля не переводится, подробности уже в журнале
// регистрации, Сообщение — постоянный текст.
Процедура ВнутренняяОшибкаПлана(План, Сообщение)
	Если План.Ошибка = Неопределено Тогда
		План.Ошибка = Новый Структура("Статус, Код, Сообщение", 500, "InternalError", Сообщение);
	КонецЕсли;
КонецПроцедуры

// Запоминает первую ошибку построения узлов (400); узлы раскручиваются обычными возвратами,
// исключение бросает ПланЧтения.
Процедура ОшибкаПлана(План, Сообщение)
	Если План.Ошибка = Неопределено Тогда
		План.Ошибка = Новый Структура("Статус, Код, Сообщение", 400, "BadRequest", Сообщение);
	КонецЕсли;
КонецПроцедуры

// Ещё одно раскрытие плана (соединение навигации или выборка табличной части раскрытого объекта); сверх
// План.НаибольшееЧислоРаскрытий — ОшибкаПлана и Ложь (узлы раскручиваются обычными возвратами).
Функция СчитатьРаскрытие(План)
	План.Раскрытий = План.Раскрытий + 1;
	Если План.Раскрытий > План.НаибольшееЧислоРаскрытий Тогда
		ОшибкаПлана(План, "Раскрытий $expand больше " + Формат(План.НаибольшееЧислоРаскрытий, "ЧГ=0")
			+ " (соединения навигаций и табличные части раскрытых объектов): сузьте $expand или $select");
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Узел выдачи: какие свойства набора выводятся (Свойства — Структуры «Свойство, Колонка»), табличные части
// (ТабличныеЧасти — Структуры «Имя, Код, Узел, Пропуск, Первые, СКоличеством»), раскрытые навигационные свойства
// (Раскрытия — Структуры «Имя, Узел»). КолонкаСсылки — колонка ссылки объекта (у раскрытия — NULL, если
// объекта нет), КолонкаСтроки — номер строки табличной части. Источник — где
// лежат колонки узла: Структура «Код, Волна» — код коллекции ("" — основная выборка) и номер волны (0 — основная).
// При ошибке (План.Ошибка) возвращает недостроенный узел.
Функция УзелВыдачи(План, Выборка, Набор, Псевдоним, Выбор, Раскрытие, Глубина, Источник)
	Узел = Новый Структура;
	Узел.Вставить("Набор", Набор);
	Узел.Вставить("Свойства", Новый Массив);
	Узел.Вставить("ТабличныеЧасти", Новый Массив);
	Узел.Вставить("Раскрытия", Новый Массив);
	Узел.Вставить("КолонкаСсылки", "");
	Узел.Вставить("КолонкаСтроки", "");
	Узел.Вставить("Источник", Источник);
	Узел.Вставить("СписокКонтекста", "");
	Если Набор.ПолеСвязи <> "" Тогда
		Узел.КолонкаСсылки = OData4_Генератор.ДобавитьКолонку(Выборка, Псевдоним + "." + Набор.ПолеСвязи);
	КонецЕсли;
	Если Набор.Вид = "ТабличнаяЧасть" Тогда
		Узел.КолонкаСтроки = OData4_Генератор.ДобавитьКолонку(Выборка, Псевдоним + ".НомерСтроки");
	КонецЕсли;
	Раскрытия = РаскрытияНабора(План, Набор, Раскрытие);
	Если План.Ошибка <> Неопределено Тогда
		Возврат Узел;
	КонецЕсли;
	Выбранные = ВыбранныеСвойства(План, Набор, Выбор, Раскрытия);
	Если План.Ошибка <> Неопределено Тогда
		Возврат Узел;
	КонецЕсли;
	Для Каждого Свойство Из Набор.Свойства Цикл
		Если Выбранные.Свойства.Получить(Свойство.Имя) <> Истина Тогда
			Продолжить;
		ИначеЕсли Свойство.Поле = "" Тогда
			// Суррогатный ключ (SurrogateKey) в базе не хранится: колонки нет, значение выдаёт сериализация.
			Колонка = "";
		ИначеЕсли Свойство.Вид = "Ключ" И Узел.КолонкаСсылки <> "" Тогда
			Колонка = Узел.КолонкаСсылки;
		ИначеЕсли Свойство.Вид = "Составной" И Свойство.Поле = Набор.ПолеСвязи И Узел.КолонкаСсылки <> "" Тогда
			Колонка = Узел.КолонкаСсылки;
		ИначеЕсли Свойство.Имя = "LineNumber" И Набор.Вид = "ТабличнаяЧасть" Тогда
			Колонка = Узел.КолонкаСтроки;
		Иначе
			Колонка = OData4_Генератор.ДобавитьКолонку(Выборка, Псевдоним + "." + Свойство.Поле);
		КонецЕсли;
		Узел.Свойства.Добавить(Новый Структура("Свойство, Колонка", Свойство, Колонка));
	КонецЦикла;
	Для Каждого ИмяТЧ Из Набор.ТабличныеЧасти Цикл
		ТЧ = OData4_Безопасность.НаборМодели(План.Модель, ИмяТЧ);
		Опции = Раскрытия.ТабличныеЧасти.Получить(ТЧ.ИмяВВладельце);
		Если Опции = Неопределено И Выбранные.ТабличныеЧасти.Получить(ТЧ.ИмяВВладельце) <> Истина Тогда
			Продолжить;
		КонецЕсли;
		ТабличнаяЧасть = Коллекция(План, Узел, ТЧ, Опции, Глубина);
		Если План.Ошибка <> Неопределено Тогда
			Возврат Узел;
		КонецЕсли;
		Узел.ТабличныеЧасти.Добавить(ТабличнаяЧасть);
	КонецЦикла;
	Для Каждого Элемент Из Раскрытия.Навигация Цикл
		РаскрытиеНавигации = РаскрытиеСсылки(План, Выборка, Псевдоним, Элемент.Свойство, Элемент.Опции,
			Глубина, Источник);
		Если План.Ошибка <> Неопределено Тогда
			Возврат Узел;
		КонецЕсли;
		Узел.Раскрытия.Добавить(РаскрытиеНавигации);
	КонецЦикла;
	Узел.СписокКонтекста = СписокКонтекста(Выбор, Узел);
	Возврат Узел;
КонецФункции

// Выбранные свойства и табличные части: Структура «Свойства, ТабличныеЧасти» (Соответствия имя → Истина).
// Без $select или со «*» — все. Путь «Навигация/Свойство» (v3) — вложенный $select раскрытия этой навигации,
// «ТабличнаяЧасть/Свойство» — вложенный $select табличной части. «*» в пути из нескольких сегментов и имена
// с точкой — несуществующие свойства.
Функция ВыбранныеСвойства(План, Набор, Выбор, Раскрытия)
	Результат = Новый Структура("Свойства, ТабличныеЧасти", Новый Соответствие, Новый Соответствие);
	Если Выбор = Неопределено Тогда
		ВыбратьВсе(Набор, Результат);
		Возврат Результат;
	КонецЕсли;
	Для Каждого Путь Из Выбор Цикл
		Имя = Путь[0];
		Если Путь.Количество() = 1 И Имя = "*" Тогда
			ВыбратьВсе(Набор, Результат);
			Продолжить;
		ИначеЕсли Путь.Количество() > 1 И Путь[Путь.ВГраница()] = "*" Тогда
			ОшибкаПлана(План, "Свойство не найдено: " + Набор.Имя + "." + СтрСоединить(Путь, "/"));
			Возврат Результат;
		ИначеЕсли Набор.Вид = "Шаг" И ВыбратьВложенные(Набор, СтрСоединить(Путь, "/"), Результат) Тогда
			Продолжить;
		КонецЕсли;
		Свойство = Набор.ВыборПоИмени.Получить(Имя);
		Если Путь.Количество() = 1 И Свойство <> Неопределено Тогда
			Результат.Свойства.Вставить(Свойство.Имя, Истина);
		ИначеЕсли Набор.ТабличныеЧастиПоИмени.Получить(Имя) <> Неопределено Тогда
			Результат.ТабличныеЧасти.Вставить(Имя, Истина);
			Если Путь.Количество() > 1 Тогда
				ДобавитьВложенныйВыбор(Раскрытия.ТабличныеЧасти, Имя, Путь);
			КонецЕсли;
		ИначеЕсли Набор.Навигация.Получить(Имя) <> Неопределено Тогда
			Если Путь.Количество() > 1 Тогда
				Элемент = Неопределено;
				Для Каждого Кандидат Из Раскрытия.Навигация Цикл
					Если Кандидат.Свойство.ИмяНавигации = Имя Тогда
						Элемент = Кандидат;
					КонецЕсли;
				КонецЦикла;
				Если Элемент = Неопределено Тогда
					ОшибкаПлана(План, "Путь $select через навигацию без $expand: " + СтрСоединить(Путь, "/"));
					Возврат Результат;
				КонецЕсли;
				ДобавитьПутьВыбора(Элемент.Опции, Путь);
			КонецЕсли;
		Иначе
			ОшибкаПлана(План, "Свойство не найдено: " + Набор.Имя + "." + СтрСоединить(Путь, "/"));
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// $select по результату groupby с навигационным путём: «Owner/Description» — это свойство, «Owner» —
// все свойства вложенного объекта. Истина, если путь выбрал хотя бы одно свойство.
Функция ВыбратьВложенные(Набор, Полное, Результат)
	Выбрано = Ложь;
	Для Каждого Свойство Из Набор.Свойства Цикл
		Если Свойство.Имя = Полное И СтрНайти(Полное, "/") > 0 Или СтрНачинаетсяС(Свойство.Имя, Полное + "/") Тогда
			Результат.Свойства.Вставить(Свойство.Имя, Истина);
			Выбрано = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Выбрано;
КонецФункции

Процедура ВыбратьВсе(Набор, Результат)
	Для Каждого Свойство Из Набор.Свойства Цикл
		Результат.Свойства.Вставить(Свойство.Имя, Истина);
	КонецЦикла;
	Для Каждого КлючИЗначение Из Набор.ТабличныеЧастиПоИмени Цикл
		Результат.ТабличныеЧасти.Вставить(КлючИЗначение.Ключ, Истина);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьВложенныйВыбор(ТабличныеЧасти, Имя, Путь)
	Опции = ТабличныеЧасти.Получить(Имя);
	Если Опции = Неопределено Тогда
		Опции = OData4_Разбор.НовыеОпции();
		ТабличныеЧасти.Вставить(Имя, Опции);
	КонецЕсли;
	ДобавитьПутьВыбора(Опции, Путь);
КонецПроцедуры

// Добавляет в вложенный $select путь без первого сегмента.
Процедура ДобавитьПутьВыбора(Опции, Путь)
	Хвост = Новый Массив;
	Для Индекс = 1 По Путь.ВГраница() Цикл
		Хвост.Добавить(Путь[Индекс]);
	КонецЦикла;
	Если Опции.select = Неопределено Тогда
		Опции.select = Новый Массив;
	КонецЕсли;
	Опции.select.Добавить(Хвост);
КонецПроцедуры

// Раскрытия набора: Структура «Навигация, ТабличныеЧасти». Навигация — Массив Структур «Свойство, Опции»
// в порядке $expand; ТабличныеЧасти — Соответствие имя → опции. «*» — все навигационные свойства.
// Путь из нескольких сегментов — вложенное раскрытие первого сегмента; «*» в таком пути и имена с точкой —
// несуществующие навигационные свойства.
Функция РаскрытияНабора(План, Набор, Раскрытие)
	Результат = Новый Структура("Навигация, ТабличныеЧасти", Новый Массив, Новый Соответствие);
	Если Раскрытие = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Встречены = Новый Соответствие;
	Для Каждого Элемент Из Раскрытие Цикл
		Путь = Элемент.path;
		Опции = Элемент.options;
		Если Путь.Количество() = 1 И Путь[0] = "*" Тогда
			Для Каждого Свойство Из Набор.Свойства Цикл
				Если Свойство.Вид = "Ссылка" И Свойство.ИмяНавигации <> "" И Встречены.Получить(Свойство.ИмяНавигации) = Неопределено Тогда
					Встречены.Вставить(Свойство.ИмяНавигации, Истина);
					Результат.Навигация.Добавить(Новый Структура("Свойство, Опции", Свойство, КопияОпций(Опции)));
				КонецЕсли;
			КонецЦикла;
			Продолжить;
		ИначеЕсли Путь[Путь.ВГраница()] = "*" Тогда
			ОшибкаПлана(План, "Навигационное свойство не найдено: " + Набор.Имя + "." + СтрСоединить(Путь, "/"));
			Возврат Результат;
		КонецЕсли;
		Имя = Путь[0];
		Если Путь.Количество() > 1 Тогда
			Хвост = Новый Массив;
			Для Индекс = 1 По Путь.ВГраница() Цикл
				Хвост.Добавить(Путь[Индекс]);
			КонецЦикла;
			Вложенное = Новый Массив;
			Вложенное.Добавить(Новый Структура("path, options", Хвост, Опции));
			Опции = OData4_Разбор.НовыеОпции();
			Опции.expand = Вложенное;
		КонецЕсли;
		Если Встречены.Получить(Имя) <> Неопределено Тогда
			ОшибкаПлана(План, "Повторное раскрытие: " + Имя);
			Возврат Результат;
		КонецЕсли;
		Встречены.Вставить(Имя, Истина);
		Навигация = Набор.Навигация.Получить(Имя);
		Если Навигация <> Неопределено Тогда
			Результат.Навигация.Добавить(Новый Структура("Свойство, Опции", Навигация, Опции));
		ИначеЕсли Набор.ТабличныеЧастиПоИмени.Получить(Имя) <> Неопределено Тогда
			Результат.ТабличныеЧасти.Вставить(Имя, Опции);
		Иначе
			ОшибкаПлана(План, "Навигационное свойство не найдено: " + Набор.Имя + "." + Имя);
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Раскрытие ссылки: ЛЕВОЕ СОЕДИНЕНИЕ целевой таблицы в той же выборке, колонки объекта — в узле.
// При ошибке (План.Ошибка) возвращает Неопределено.
Функция РаскрытиеСсылки(План, Выборка, Псевдоним, Свойство, Опции, Глубина, Источник)
	Если Глубина >= МаксимальнаяГлубинаРаскрытия() Тогда
		ОшибкаПлана(План, "Глубина $expand больше "
			+ Формат(МаксимальнаяГлубинаРаскрытия(), "ЧГ=0") + ": " + Свойство.ИмяНавигации);
		Возврат Неопределено;
	КонецЕсли;
	Если Опции.filter <> Неопределено Или Опции.orderby <> Неопределено Или Опции.top <> Неопределено
		Или Опции.skip <> Неопределено Или Опции.count <> Неопределено Тогда
		ОшибкаПлана(План,
			"$filter, $orderby, $top, $skip и $count не применяются к навигации на один объект: " + Свойство.ИмяНавигации);
		Возврат Неопределено;
	КонецЕсли;
	Целевой = OData4_Безопасность.НаборМодели(План.Модель, Свойство.ЦелевойНабор);
	Если Целевой = Неопределено Тогда
		ОшибкаПлана(План, "Навигация в неопубликованный набор: " + Свойство.ИмяНавигации);
		Возврат Неопределено;
	КонецЕсли;
	Если Не СчитатьРаскрытие(План) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ПсевдонимЦели = "Р" + Формат(Выборка.Соединения.Количество() + 1, "ЧГ=0");
	УсловиеСоединения = Псевдоним + "." + Свойство.Поле + " = " + ПсевдонимЦели + ".Ссылка";
	// Отборы профиля цели (5.2) — в условии соединения: скрытая профилем цель раскрывается в null.
	УсловияЦели = OData4_Безопасность.УсловияНабора(План.Параметры, Целевой, ПсевдонимЦели);
	Если УсловияЦели.Ошибка <> Неопределено Тогда
		ВнутренняяОшибкаПлана(План, УсловияЦели.Ошибка);
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Условие0 Из УсловияЦели.Условия Цикл
		УсловиеСоединения = УсловиеСоединения + " И " + Условие0;
	КонецЦикла;
	Выборка.Соединения.Добавить(Новый Структура("Таблица, Псевдоним, Условие", OData4_Модель.ТаблицаЧтения(Целевой), ПсевдонимЦели,
		УсловиеСоединения));
	Дочерний = УзелВыдачи(План, Выборка, Целевой, ПсевдонимЦели, Опции.select, Опции.expand, Глубина + 1, Источник);
	Возврат Новый Структура("Имя, Узел", Свойство.ИмяНавигации, Дочерний);
КонецФункции

// Коллекция — строки табличной части ТЧ для объектов узла Родитель: отдельная выборка
// «ГДЕ Т.Ссылка В (ВЫБРАТЬ … ИЗ ВТ_КлючиN)», выполняется волной после выборки родителя.
// Условие и порядок из опций строит ПрименитьОпцииКоллекции после обхода узлов (Описание.Опции).
Функция Коллекция(План, Родитель, ТЧ, Опции, Глубина)
	// Табличные части самого набора маршрута выдаются всегда; считаются части раскрытых объектов.
	Если Глубина > 0 И Не СчитатьРаскрытие(План) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Номер = План.Коллекции.Количество() + 1;
	Код = "ТЧ" + Формат(Номер, "ЧГ=0");
	Выборка = OData4_Генератор.НоваяВыборка(OData4_Модель.ТаблицаЧтения(ТЧ), "Т");
	Выборка.Условия.Добавить("Т." + ТЧ.ПолеСвязи + " В (ВЫБРАТЬ ВК.Ссылка ИЗ ВТ_Ключи"
		+ Формат(Номер, "ЧГ=0") + " КАК ВК)");
	// Записи регистра по регистратору — с отборами профиля (5.2). Строки табличной части отбирать не нужно: ключи
	// владельцев — из уже отобранной выборки родителя (скрытая цель раскрытия — NULL, ключом не становится).
	Если ТЧ.Вид <> "ТабличнаяЧасть" Тогда
		ДобавитьУсловияПрофиля(План, Выборка, ТЧ, "Т");
	КонецЕсли;
	Описание = Новый Структура;
	Описание.Вставить("Код", Код);
	Описание.Вставить("Номер", Номер);
	Описание.Вставить("Волна", Родитель.Источник.Волна + 1);
	Описание.Вставить("Источник", Родитель.Источник.Код);
	Описание.Вставить("Выборка", Выборка);
	Описание.Вставить("Родитель", Родитель);
	Описание.Вставить("Узел", Неопределено);
	Описание.Вставить("Опции", Опции);
	План.Коллекции.Добавить(Описание);
	Выбор = Неопределено;
	Раскрытие = Неопределено;
	Пропуск = 0;
	Первые = -1;
	СКоличеством = Ложь;
	Если Опции <> Неопределено Тогда
		Выбор = Опции.select;
		Раскрытие = Опции.expand;
		Пропуск = ?(Опции.skip = Неопределено, 0, Опции.skip);
		Первые = ?(Опции.top = Неопределено, -1, Опции.top);
		СКоличеством = Опции.count = Истина;
	КонецЕсли;
	Описание.Узел = УзелВыдачи(План, Выборка, ТЧ, "Т", Выбор, Раскрытие, Глубина,
		Новый Структура("Код, Волна", Код, Описание.Волна));
	Возврат Новый Структура("Имя, Код, Узел, Пропуск, Первые, СКоличеством",
		ТЧ.ИмяВВладельце, Код, Описание.Узел, Пропуск, Первые, СКоличеством);
КонецФункции

// $filter и $orderby коллекции: условие, порядок «Т.Ссылка, элементы $orderby, Т.НомерСтроки».
Процедура ПрименитьОпцииКоллекции(План, Описание)
	Выборка = Описание.Выборка;
	Опции = Описание.Опции;
	Контекст = OData4_Генератор.НовыйКонтекст(План.Модель, План.Параметры, Описание.Узел.Набор, "Т");
	Если Опции <> Неопределено И Опции.filter <> Неопределено Тогда
		Выборка.Условия.Добавить(OData4_Генератор.Условие(Опции.filter, Контекст));
	КонецЕсли;
	Выборка.Порядок.Добавить(Новый Структура("Выражение, Убывание", "Т." + Описание.Узел.Набор.ПолеСвязи, Ложь));
	Если Опции <> Неопределено И Опции.orderby <> Неопределено Тогда
		Для Каждого Элемент Из Опции.orderby Цикл
			Выр = OData4_Генератор.ВыражениеПорядка(OData4_Генератор.Выражение(Элемент.expression, Контекст), Контекст);
			Выборка.Порядок.Добавить(Новый Структура("Выражение, Убывание", Выр.Текст, Элемент.direction = "desc"));
		КонецЦикла;
	КонецЕсли;
	Если Описание.Узел.КолонкаСтроки <> "" Или Описание.Узел.Набор.Вид = "Регистр" Тогда
		Выборка.Порядок.Добавить(Новый Структура("Выражение, Убывание", "Т.НомерСтроки", Ложь));
	КонецЕсли;
КонецПроцедуры

// Порядок основной выборки: элементы $orderby (колонки О-значений для метки), без $orderby — порядок
// шага topcount/bottomcount (План.ПорядокШага), затем ключ набора.
Процедура ДобавитьПорядок(План, Порядок)
	Выборка = План.Выборка;
	Если Порядок = Неопределено Тогда
		Для Каждого Элемент Из План.ПорядокШага Цикл
			Колонка = OData4_Генератор.ДобавитьКолонку(Выборка, Элемент.Выражение);
			Выборка.Порядок.Добавить(Новый Структура("Выражение, Убывание", Элемент.Выражение, Элемент.Убывание));
			План.Порядок.Добавить(Новый Структура("Выражение, Тип, Убывание, Колонка", Элемент.Выражение, Элемент.Тип,
				Элемент.Убывание, Колонка));
		КонецЦикла;
	Иначе
		Для Каждого Элемент Из Порядок Цикл
			Выр = OData4_Генератор.ВыражениеПорядка(
				OData4_Генератор.Выражение(Элемент.expression, План.Контекст), План.Контекст);
			Убывание = Элемент.direction = "desc";
			Колонка = OData4_Генератор.ДобавитьКолонку(Выборка, Выр.Текст);
			Выборка.Порядок.Добавить(Новый Структура("Выражение, Убывание", Выр.Текст, Убывание));
			План.Порядок.Добавить(Новый Структура("Выражение, Тип, Убывание, Колонка", Выр.Текст, Выр.Тип, Убывание, Колонка));
		КонецЦикла;
	КонецЕсли;
	Для Каждого Элемент Из План.КлючПорядка Цикл
		Выборка.Порядок.Добавить(Новый Структура("Выражение, Убывание", Элемент.Выражение, Ложь));
	КонецЦикла;
КонецПроцедуры

// Список $select для @odata.context: «Code,Description,Контрагент(Description)»; пусто — без $select.
Функция СписокКонтекста(Выбор, Узел)
	Если Выбор = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Элементы = Новый Массив;
	Для Каждого Путь Из Выбор Цикл
		Если Путь.Количество() = 1 Тогда
			Элементы.Добавить(Путь[0]);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Раскрытие Из Узел.Раскрытия Цикл
		Вложенный = Раскрытие.Узел.СписокКонтекста;
		Элементы.Добавить(Раскрытие.Имя + "(" + Вложенный + ")");
	КонецЦикла;
	Возврат СтрСоединить(Элементы, ",");
КонецФункции

// Свойства узла результата $apply: свойства с путём в имени («Owner/Description») собираются во вложенные
// узлы на месте первого из них — элемент «Свойство, Колонка, Узел» со свойством вида «Вложенный»
// (имя — первый сегмент пути), свойства вложенного узла — с остатком пути в имени. Глубина рекурсии —
// число сегментов пути, исключений нет.
Функция ВложенныеСвойства(Элементы)
	Результат = Новый Массив;
	Группы = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		Имя = Элемент.Свойство.Имя;
		Косая = СтрНайти(Имя, "/");
		Если Косая = 0 Тогда
			Результат.Добавить(Элемент);
			Продолжить;
		КонецЕсли;
		ИмяОбъекта = Лев(Имя, Косая - 1);
		Копия = Новый Структура;
		Для Каждого КлючИЗначение Из Элемент.Свойство Цикл
			Копия.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		Копия.Имя = Сред(Имя, Косая + 1);
		Группа = Группы.Получить(ИмяОбъекта);
		Если Группа = Неопределено Тогда
			Группа = Новый Структура("Свойство, Колонка, Узел, Элементы",
				OData4_Модель.НовоеСвойство(ИмяОбъекта, "", "Вложенный", ""), "", Неопределено, Новый Массив);
			Группы.Вставить(ИмяОбъекта, Группа);
			Результат.Добавить(Группа);
		КонецЕсли;
		Группа.Элементы.Добавить(Новый Структура("Свойство, Колонка", Копия, Элемент.Колонка));
	КонецЦикла;
	Для Каждого КлючИЗначение Из Группы Цикл
		Группа = КлючИЗначение.Значение;
		Группа.Узел = Новый Структура("Свойства, ТабличныеЧасти, Раскрытия, СписокКонтекста",
			ВложенныеСвойства(Группа.Элементы), Новый Массив, Новый Массив, "");
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Перечень выданных свойств для @odata.context результата $apply: «Валюта_Key,Макс», вложенный
// объект — «Owner(Description,Code)».
Функция СписокСвойствУзла(Узел)
	Имена = Новый Массив;
	Для Каждого Элемент Из Узел.Свойства Цикл
		Если Элемент.Свойство.Вид = "Вложенный" Тогда
			Имена.Добавить(Элемент.Свойство.Имя + "(" + СписокСвойствУзла(Элемент.Узел) + ")");
		Иначе
			Имена.Добавить(Элемент.Свойство.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");
КонецФункции

// @odata.context результата $apply: выданные свойства (СписокСвойствУзла), затем, как у коллекции
// (СписокКонтекста), навигационные свойства из $select и раскрытия «Owner(…)» — у цепочек, сохраняющих
// ключ, $expand работает, и контекст должен называть раскрытое.
Функция СписокКонтекстаШага(Узел, Выбор)
	Имена = Новый Массив;
	Список = СписокСвойствУзла(Узел);
	Если Список <> "" Тогда
		Имена.Добавить(Список);
	КонецЕсли;
	// Табличные части строк шага, сохраняющего ключ (решение 22), называются, как у коллекции (СписокКонтекста):
	// выбранные $select одним сегментом; без $select и с «*» — все выданные. Раскрытая только $expand табличная часть
	// и путь «Товары/LineNumber» перечень не пополняют.
	Для Каждого ТабличнаяЧасть Из Узел.ТабличныеЧасти Цикл
		Если Выбор = Неопределено Или ВыбранаОднимСегментом(Выбор, ТабличнаяЧасть.Имя)
			Или ВыбранаОднимСегментом(Выбор, "*") Тогда
			Имена.Добавить(ТабличнаяЧасть.Имя);
		КонецЕсли;
	КонецЦикла;
	Если Выбор <> Неопределено Тогда
		Встречены = Новый Соответствие;
		Для Каждого Путь Из Выбор Цикл
			Если Путь.Количество() = 1 И Узел.Набор.Навигация.Получить(Путь[0]) <> Неопределено
				И Встречены.Получить(Путь[0]) = Неопределено Тогда
				Встречены.Вставить(Путь[0], Истина);
				Имена.Добавить(Путь[0]);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Для Каждого Раскрытие Из Узел.Раскрытия Цикл
		Имена.Добавить(Раскрытие.Имя + "(" + Раскрытие.Узел.СписокКонтекста + ")");
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");
КонецФункции

// В $select есть путь из одного сегмента Имя.
Функция ВыбранаОднимСегментом(Выбор, Имя)
	Для Каждого Путь Из Выбор Цикл
		Если Путь.Количество() = 1 И Путь[0] = Имя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Значение для метки: составное (регистратор) — «StandardODATA.Document_X|<guid>», дата — XML-строка,
// ссылка — GUID, NULL — null.
Функция ЗначениеМетки(Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если Значение = NULL Тогда
		Возврат Неопределено;
	ИначеЕсли ТипЗначения = Тип("Строка") Или ТипЗначения = Тип("Число") Или ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("УникальныйИдентификатор") Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат OData4_Сериализация.ИмяТипаЗначения(Значение) + "|" + OData4_Сериализация.ГУИД(Значение);
КонецФункции

// Значение составного поля ключа для метки: ссылка на набор модели — «StandardODATA.Document_X|<guid>»;
// у субконто бывают и Неопределено, примитивы и ссылки вне модели (план счетов, перечисления) —
// «Undefined|», «Edm.String|текст», «Edm.Decimal|…», «Edm.Boolean|…», «Edm.DateTimeOffset|…»
// и «XML.<имя XML-типа>|<XML-строка>». NULL — null.
Функция ЗначениеМеткиСоставного(План, Значение)
	Если Значение = NULL Тогда
		Возврат Неопределено;
	ИначеЕсли Значение = Неопределено Тогда
		Возврат "Undefined|";
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат "Edm.String|" + Значение;
	ИначеЕсли ТипЗначения = Тип("Число") Тогда
		Возврат "Edm.Decimal|" + XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("Булево") Тогда
		Возврат "Edm.Boolean|" + XMLСтрока(Значение);
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Возврат "Edm.DateTimeOffset|" + XMLСтрока(Значение);
	КонецЕсли;
	ИмяТипа = OData4_Сериализация.ИмяТипаЗначения(Значение);
	ИмяНабора = ?(СтрНачинаетсяС(ИмяТипа, "StandardODATA."), Сред(ИмяТипа, 15), ИмяТипа);
	Целевой = OData4_Безопасность.НаборМодели(План.Модель, ИмяНабора);
	Если Целевой <> Неопределено И Целевой.ИмяТипаСсылки <> "" Тогда
		Возврат ИмяТипа + "|" + OData4_Сериализация.ГУИД(Значение);
	КонецЕсли;
	Возврат "XML." + XMLТипЗнч(Значение).ИмяТипа + "|" + XMLСтрока(Значение);
КонецФункции

// Значение составного поля из метки (см. ЗначениеМеткиСоставного); неверное — исключение.
Функция ЗначениеСоставногоИзМетки(План, Значение)
	Части = РазделитьЗначениеМетки(Значение);
	Вид = Части.Тип;
	Текст = Части.ГУИД;
	Если Вид = "Undefined" Тогда
		Возврат Неопределено;
	ИначеЕсли Вид = "Edm.String" Тогда
		Возврат Текст;
	ИначеЕсли Вид = "Edm.Decimal" Тогда
		Возврат XMLЗначение(Тип("Число"), Текст);
	ИначеЕсли Вид = "Edm.Boolean" Тогда
		Возврат XMLЗначение(Тип("Булево"), Текст);
	ИначеЕсли Вид = "Edm.DateTimeOffset" Тогда
		Возврат XMLЗначение(Тип("Дата"), Текст);
	ИначеЕсли СтрНачинаетсяС(Вид, "XML.") Тогда
		// Пространство имён XML-типов конфигурации пустое (проба: XMLТипЗнч(Перечисления.X.Y) —
		// «EnumRef.X» и URI ""); с URI current-config ИзXMLТипа не находит тип. Метку пишет клиент, поэтому
		// принимаются только ссылочные типы — те, что кодирует ЗначениеМеткиСоставного (ссылки вне модели:
		// перечисления, планы счетов, виды характеристик и т. п.).
		Если Не СсылочныйТипМетки(Сред(Вид, 5)) Тогда
			ВызватьИсключение "Недопустимый тип значения метки";
		КонецЕсли;
		ТипXML = ИзXMLТипа(Сред(Вид, 5), "");
		Если ТипXML = Неопределено Тогда
			ВызватьИсключение "Неизвестный тип значения метки";
		КонецЕсли;
		Возврат XMLЗначение(ТипXML, Текст);
	КонецЕсли;
	ИмяНабора = ?(СтрНачинаетсяС(Вид, "StandardODATA."), Сред(Вид, 15), Вид);
	Целевой = OData4_Безопасность.НаборМодели(План.Модель, ИмяНабора);
	Если Целевой = Неопределено Или Целевой.ИмяТипаСсылки = "" Тогда
		ВызватьИсключение "Неизвестный тип значения метки";
	КонецЕсли;
	Возврат XMLЗначение(Тип(Целевой.ИмяТипаСсылки), Текст);
КонецФункции

// Имя XML-типа из метки — ссылка объекта конфигурации: «CatalogRef.X», «EnumRef.X», «ChartOfAccountsRef.X» и
// другие виды ссылок (имя вида и имя объекта через точку).
Функция СсылочныйТипМетки(ИмяXML) Экспорт
	Точка = СтрНайти(ИмяXML, ".");
	Если Точка < 2 Или Точка = СтрДлина(ИмяXML) Тогда
		Возврат Ложь;
	КонецЕсли;
	Виды = "CatalogRef,DocumentRef,EnumRef,ChartOfAccountsRef,ChartOfCharacteristicTypesRef,"
		+ "ChartOfCalculationTypesRef,ExchangePlanRef,BusinessProcessRef,BusinessProcessRoutePointRef,TaskRef";
	Возврат СтрРазделить(Виды, ",").Найти(Лев(ИмяXML, Точка - 1)) <> Неопределено;
КонецФункции

Функция ЗначениеИзМетки(План, Значение, Тип0)
	Если Значение = Неопределено Тогда
		Возврат NULL;
	ИначеЕсли Тип0.Вид = "Строка" Тогда
		Возврат Строка(Значение);
	ИначеЕсли Тип0.Вид = "Число" Тогда
		Возврат Число(Значение);
	ИначеЕсли Тип0.Вид = "Дата" Тогда
		Возврат XMLЗначение(Тип("Дата"), Значение);
	ИначеЕсли Тип0.Вид = "Гуид" Тогда
		Возврат Новый УникальныйИдентификатор(Значение);
	ИначеЕсли Тип0.Вид = "Ссылка" Тогда
		Возврат XMLЗначение(Тип0.ТипСсылки, РазделитьЗначениеМетки(Значение).ГУИД);
	ИначеЕсли Тип0.Вид = "Составной" Тогда
		Возврат ЗначениеСоставногоИзМетки(План, Значение);
	КонецЕсли;
	ВызватьИсключение "Неверный тип значения метки";
КонецФункции

// «StandardODATA.Document_X|<guid>» → Структура «Тип, ГУИД»; без «|» — только GUID.
Функция РазделитьЗначениеМетки(Значение)
	Текст = Строка(Значение);
	Черта = СтрНайти(Текст, "|");
	Если Черта = 0 Тогда
		Возврат Новый Структура("Тип, ГУИД", "", Текст);
	КонецЕсли;
	Возврат Новый Структура("Тип, ГУИД", Лев(Текст, Черта - 1), Сред(Текст, Черта + 1));
КонецФункции

// Значения метки в типах выражений порядка и полей ключа; неверная метка — 400.
Функция ПрочитатьМетку(План, Метка)
	Значения = ПлоскийМассивМетки(Метка);
	Ожидается = План.Порядок.Количество() + План.КлючПорядка.Количество();
	Если Значения = Неопределено Или ТипЗнч(Значения) <> Тип("Массив") Или Значения.Количество() <> Ожидается Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверный $skiptoken: " + Метка);
	КонецЕсли;
	Результат = Новый Массив;
	Попытка
		Для Индекс = 0 По План.Порядок.Количество() - 1 Цикл
			Результат.Добавить(ЗначениеИзМетки(План, Значения[Индекс], План.Порядок[Индекс].Тип));
		КонецЦикла;
		Для Индекс = 0 По План.КлючПорядка.Количество() - 1 Цикл
			Результат.Добавить(ЗначениеИзМетки(План, Значения[План.Порядок.Количество() + Индекс],
				План.КлючПорядка[Индекс].Тип));
		КонецЦикла;
	Исключение
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверный $skiptoken: " + Метка);
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Метка, прочитанная по лексемам: ровно один плоский JSON-массив строк, чисел, булевых и null без хвоста.
// Иначе — Неопределено. Дерево значений не строится: глубокая вложенность отклоняется на второй «[».
Функция ПлоскийМассивМетки(Метка)
	Значения = Новый Массив;
	Верно = Ложь;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Метка);
		Если Чтение.Прочитать() И Чтение.ТипТекущегоЗначения = ТипЗначенияJSON.НачалоМассива Тогда
			Пока Чтение.Прочитать() Цикл
				ТипЛексемы = Чтение.ТипТекущегоЗначения;
				Если ТипЛексемы = ТипЗначенияJSON.КонецМассива Тогда
					Верно = Истина;
					Прервать;
				ИначеЕсли ТипЛексемы = ТипЗначенияJSON.Строка Или ТипЛексемы = ТипЗначенияJSON.Число
					Или ТипЛексемы = ТипЗначенияJSON.Булево Тогда
					Значения.Добавить(Чтение.ТекущееЗначение);
				ИначеЕсли ТипЛексемы = ТипЗначенияJSON.Null Тогда
					Значения.Добавить(Неопределено);
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Верно И Чтение.Прочитать() Тогда
				Верно = Ложь;
			КонецЕсли;
		КонецЕсли;
		Чтение.Закрыть();
	Исключение
		Верно = Ложь;
	КонецПопытки;
	Возврат ?(Верно, Значения, Неопределено);
КонецФункции

Функция МаксимальнаяГлубинаРаскрытия()
	Возврат 3;
КонецФункции

// Копия опций раскрытия со своим списком $select (для «*»: вложенный $select из пути v3 не должен попасть
// в раскрытия других навигационных свойств).
Функция КопияОпций(Опции)
	Копия = OData4_Разбор.НовыеОпции();
	ЗаполнитьЗначенияСвойств(Копия, Опции);
	Если Опции.select <> Неопределено Тогда
		Копия.select = Новый Массив;
		Для Каждого Путь Из Опции.select Цикл
			Копия.select.Добавить(Путь);
		КонецЦикла;
	КонецЕсли;
	Возврат Копия;
КонецФункции

// Значение поля ключа: текст разбирается как выражение $filter (один литерал) и приводится
// к типу свойства. Не литерал — 400 с фактом.
Функция ЗначениеПоля(План, Свойство, Текст)
	Попытка
		Узел = OData4_Разбор.РазобратьФильтр(Текст);
	Исключение
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверное значение ключа " + Свойство.Имя + ": " + Текст);
	КонецПопытки;
	Если Узел.kind <> "literal" Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверное значение ключа " + Свойство.Имя + ": " + Текст);
	КонецЕсли;
	Тип0 = OData4_Генератор.ТипПоляНабора(Свойство, План.Набор, План.Модель);
	Возврат OData4_Генератор.ЗначениеПоТипу(Узел, Тип0, План.Контекст);
КонецФункции

// Ссылка составного поля ключа по паре «Имя» (GUID строкой или guid'…') и «Имя_Type»
// (строка вида 'StandardODATA.Document_X').
Функция СоставнаяСсылка(План, Свойство, Текст, ТекстТипа)
	ИмяНабора = ТекстСтроки(ТекстТипа);
	Если СтрНачинаетсяС(ИмяНабора, "StandardODATA.") Тогда
		ИмяНабора = Сред(ИмяНабора, 15);
	КонецЕсли;
	Целевой = OData4_Безопасность.НаборМодели(План.Модель, ИмяНабора);
	Если Целевой = Неопределено Или Целевой.ИмяТипаСсылки = "" Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неизвестный тип ключа: " + ТекстТипа);
	КонецЕсли;
	Попытка
		Возврат XMLЗначение(Тип(Целевой.ИмяТипаСсылки), ТекстГУИД(Текст));
	Исключение
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неверное значение ключа " + Свойство.Имя + ": " + Текст);
	КонецПопытки;
КонецФункции

// Содержимое строкового литерала: 'текст' → текст (удвоенная кавычка внутри — одна), иначе как есть.
Функция ТекстСтроки(Текст)
	Если СтрДлина(Текст) >= 2 И Лев(Текст, 1) = "'" И Прав(Текст, 1) = "'" Тогда
		Возврат СтрЗаменить(Сред(Текст, 2, СтрДлина(Текст) - 2), "''", "'");
	КонецЕсли;
	Возврат Текст;
КонецФункции

// GUID из литерала guid'…', из строкового литерала или из голого текста.
Функция ТекстГУИД(Текст)
	Значение = ТекстСтроки(Текст);
	Если СтрНачинаетсяС(НРег(Значение), "guid'") И Прав(Значение, 1) = "'" Тогда
		Возврат Сред(Значение, 6, СтрДлина(Значение) - 6);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Колонки ключа для порядка и метки продолжения: по одной на поле ключа набора (ПоляПорядкаКлюча).
Процедура ЗаполнитьКлючПорядка(План)
	Для Каждого Свойство Из ПоляПорядкаКлюча(План.Набор) Цикл
		Выр = ВыражениеКлюча(План, Свойство);
		Колонка = "";
		Если План.Узел <> Неопределено Тогда
			Колонка = OData4_Генератор.ДобавитьКолонку(План.Выборка, Выр.Выражение);
		КонецЕсли;
		План.КлючПорядка.Добавить(Новый Структура("Выражение, Тип, Колонка, Свойство",
			Выр.Выражение, Выр.Тип, Колонка, Свойство));
	КонецЦикла;
КонецПроцедуры

// Свойства, по которым строки набора упорядочиваются после $orderby и продолжаются меткой: поля ключа
// в порядке ПоляКлюча без суррогатного ключа (SurrogateKey — поля в базе нет), затем КлючПродолжения
// (у записей подчинённого регистра с суррогатным ключом — Регистратор и НомерСтроки). Пусто — только
// у набора с одним суррогатным ключом без КлючПродолжения: в нём не больше одной записи.
Функция ПоляПорядкаКлюча(Набор) Экспорт
	Поля = Новый Массив;
	Для Каждого Свойство Из Набор.ПоляКлюча Цикл
		Если Свойство.Поле <> "" Тогда
			Поля.Добавить(Свойство);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Свойство Из Набор.КлючПродолжения Цикл
		Поля.Добавить(Свойство);
	КонецЦикла;
	Возврат Поля;
КонецФункции

// Выражение поля ключа текущей выборки плана для УПОРЯДОЧИТЬ ПО и метки продолжения:
// Структура «Выражение, Тип».
Функция ВыражениеКлюча(План, Свойство) Экспорт
	Выражение = План.Выборка.Псевдоним + "." + Свойство.Поле;
	Тип0 = OData4_Генератор.ТипПоляНабора(Свойство, План.Набор, План.Модель);
	Если Тип0.Вид = "ВидДвижения" Или Тип0.Вид = "Булево" Тогда
		// Вид движения (Субконто) и булево (поле группировки $apply) в ключе: порядок и метка — числом 0/1
		// (метка [true] не читалась обратно, а «>» к булеву язык запросов не применяет).
		Выр = OData4_Генератор.ВыражениеПорядка(
			Новый Структура("Текст, Тип, Литерал", Выражение, Тип0, Неопределено), План.Контекст);
		Выражение = Выр.Текст;
		Тип0 = Выр.Тип;
	ИначеЕсли Тип0.Вид = "Перечисление" Тогда
		// Перечисление в ключе (поле группировки $apply, измерение результата виртуальной таблицы):
		// метка — число порядка (ссылка перечисления GUID в метку не даёт). Порядок пустого значения —
		// NULL, как у отсутствующего (проба), поэтому пустое — -1, а NULL остаётся NULL.
		Выражение = "ВЫБОР КОГДА " + Выражение + " ЕСТЬ NULL ТОГДА NULL ИНАЧЕ ЕСТЬNULL(" + Выражение
			+ ".Порядок, -1) КОНЕЦ";
		Тип0 = OData4_Генератор.НовыйТипВыражения("Число");
	КонецЕсли;
	Возврат Новый Структура("Выражение, Тип", Выражение, Тип0);
КонецФункции

// Источник плана — виртуальная таблица: текст источника с параметрами и, у результата-не-набора,
// подмена набора описанием результата (свойства результата вместо свойств набора).
Процедура ПрименитьФункцию(План, Функция0, ПараметрыФункции, Опции, ВидМаршрута)
	Набор = План.Набор;
	Описание0 = OData4_ВиртуальныеТаблицы.Описание(Набор, Функция0);
	Если Описание0 = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Функция не найдена: " + Набор.Имя + "/" + Функция0);
	КонецЕсли;
	Тексты = ?(ПараметрыФункции = Неопределено, Новый Соответствие, ПараметрыФункции);
	Значения = OData4_ВиртуальныеТаблицы.ЗначенияПараметров(План.Модель, План.Параметры, Набор, Описание0, Тексты);
	План.Функция = Описание0;
	План.Значения = Значения;
	Если Не Описание0.ВозвратНабор Тогда
		// Результат — не набор записей: у него нет регистратора, строки считаются все, без РАЗЛИЧНЫЕ.
		План.Выборка.Различные = Ложь;
		План.Выборка.ПолеКоличества = "*";
		Имена = Неопределено;
		Если Значения.Свойство("Dimensions") Тогда
			Имена = OData4_ВиртуальныеТаблицы.ИменаИзмерений(Описание0, Значения.Dimensions);
		КонецЕсли;
		// Без Dimensions остатки и обороты группируются, как в standard.odata, по упомянутым в запросе
		// свойствам (решение 28): Balance()?$select=СуммаBalance — одна строка общего остатка.
		Упомянутые = Неопределено;
		Если Имена = Неопределено И Описание0.Ресурсы.Количество() > 0 Тогда
			Упомянутые = УпомянутыеСвойства(Опции, ВидМаршрута);
		КонецЕсли;
		План.Набор = OData4_ВиртуальныеТаблицы.НаборРезультата(План.Модель, Описание0, Имена, Значения, Упомянутые);
		Если Упомянутые <> Неопределено И План.Набор.Свойства.Количество() = 0 Тогда
			// $select не назвал ни одного свойства результата: у коллекции это 400 при разборе $select, а /$count
			// $select не проверяет — считаются строки по всем измерениям, как без $select.
			План.Набор = OData4_ВиртуальныеТаблицы.НаборРезультата(План.Модель, Описание0, Имена, Значения);
		КонецЕсли;
		План.Контекст = OData4_Генератор.НовыйКонтекст(План.Модель, План.Параметры, План.Набор, "Т");
		// Остатки и обороты группируются всегда: без Dimensions группировка по всем измерениям
		// ничего не меняет, но /$count и $count=true идут подзапросом — КОЛИЧЕСТВО(*) прямо из
		// такой таблицы 1С отвергает («должно быть указано хотя бы одно измерение или ресурс»).
		План.Группировка = Описание0.Ресурсы.Количество() > 0;
	КонецЕсли;
	План.Выборка.Источник = OData4_ВиртуальныеТаблицы.ИсточникПлана(План, Описание0, Значения, Набор);
КонецПроцедуры

// Имена свойств результата, которые упоминает запрос с $select (Соответствие имя → Истина): первые сегменты
// путей $select и $filter, у коллекции ещё $orderby и раскрываемые навигации ($expand выдаёт объект измерения,
// значит, строки различаются и им). standard.odata считает /$count по $select и $filter, без $orderby и $expand
// (проба: /$count?$select=СуммаBalance&$orderby=ФизическоеЛицо_Key — 1, у коллекции — 2 строки). Неопределено —
// группировка по всем измерениям: без $select, с «*» в $select или $expand и с $apply ($select выбирает из
// результата шагов и группировку источника не меняет).
Функция УпомянутыеСвойства(Опции, ВидМаршрута)
	Шаги = Неопределено;
	Если Опции.select = Неопределено Или Опции.Свойство("apply", Шаги) И Шаги <> Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Имена = Новый Соответствие;
	Для Каждого Путь Из Опции.select Цикл
		Если Путь[0] = "*" Тогда
			Возврат Неопределено;
		КонецЕсли;
		Имена.Вставить(Путь[0], Истина);
	КонецЦикла;
	Если Опции.filter <> Неопределено Тогда
		OData4_ВиртуальныеТаблицы.ДобавитьИменаПутей(Опции.filter, Имена);
	КонецЕсли;
	Если ВидМаршрута <> "Коллекция" Тогда
		Возврат Имена;
	КонецЕсли;
	Если Опции.orderby <> Неопределено Тогда
		Для Каждого Элемент Из Опции.orderby Цикл
			OData4_ВиртуальныеТаблицы.ДобавитьИменаПутей(Элемент.expression, Имена);
		КонецЦикла;
	КонецЕсли;
	Если Опции.expand <> Неопределено Тогда
		Для Каждого Элемент Из Опции.expand Цикл
			Если Элемент.path[0] = "*" Тогда
				Возврат Неопределено;
			КонецЕсли;
			Имена.Вставить(Элемент.path[0], Истина);
		КонецЦикла;
	КонецЕсли;
	Возврат Имена;
КонецФункции

// Группировка результата по параметру Dimensions: колонки-ресурсы оборачиваются в СУММА,
// остальные колонки выборки (выбранные свойства, ключ, выражения $orderby) становятся полями
// группировки. Порядок по ресурсу — тем же агрегатом. Условия ($filter, метка продолжения)
// остаются в ГДЕ: виртуальная таблица 1С уже сгруппирована по измерениям, которые есть в запросе,
// поэтому ресурс в ГДЕ — итог группы (как в standard.odata: Balance(Dimensions='Организация')
// с $filter=СуммаBalance lt 0 пуст, хотя отрицательная строка по физическому лицу есть).
Процедура ПрименитьГруппировкуРезультата(План)
	Если План.Набор.ПоляКлюча.Количество() = 0 Тогда
		// Упомянуты только ресурсы (решение 28): таблица 1С без полей группировки уже свёрнута в одну строку
		// (или ни одной, если ресурсы нулевые или строку отбросил $filter). СУММА без СГРУППИРОВАТЬ дала бы
		// строку с NULL и там, где строк нет; число строк — подзапросом.
		План.Выборка.КоличествоПодзапросом = Истина;
		Возврат;
	КонецЕсли;
	Ресурсы = ВыраженияРесурсов(План);
	Для Каждого Колонка Из План.Выборка.Колонки Цикл
		Если Ресурсы.Получить(Колонка.Выражение) = Истина Тогда
			Колонка.Выражение = "СУММА(" + Колонка.Выражение + ")";
		ИначеЕсли План.Выборка.Группировка.Найти(Колонка.Выражение) = Неопределено Тогда
			План.Выборка.Группировка.Добавить(Колонка.Выражение);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Элемент Из План.Выборка.Порядок Цикл
		Если Ресурсы.Получить(Элемент.Выражение) = Истина Тогда
			Элемент.Выражение = "СУММА(" + Элемент.Выражение + ")";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Сгруппированный результат остатков и оборотов с $expand. Раскрытие присоединяет колонки связанного
// объекта (ЛЕВОЕ СОЕДИНЕНИЕ), и в СГРУППИРОВАТЬ ПО они попали бы вместе с колонками функции, а строку
// неограниченной длины и хранилище 1С не группирует (проба: Balance()?$expand=Организация — «Недопустимое поле
// для группировки "НаименованиеТерриториальногоОрганаПФР"»). Поэтому результат функции сначала помещается
// в ВТ_Источник так, как маршрут выдаёт его без $expand (измерения — поля группировки, ресурсы — СУММА),
// с колонками под именами полей функции. Основная выборка читает ВТ_Источник под тем же псевдонимом «Т»
// без группировки: набор, контекст выражений и выражения «Т.Поле» остаются прежними, условия $filter и шага
// filter, уже добавленные к выборке, остаются в запросе к функции (ресурс в них — итог группы, решение 5).
Процедура ЗакрытьГруппировкуРезультата(План)
	Ресурсы = ВыраженияРесурсов(План);
	Выборка = План.Выборка;
	Выборка.Колонки = Новый Массив;
	Встречены = Новый Соответствие;
	Для Каждого Свойство0 Из План.Набор.Свойства Цикл
		Если Свойство0.Поле = "" Или Встречены.Получить(Свойство0.Поле) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Встречены.Вставить(Свойство0.Поле, Истина);
		Выражение0 = "Т." + Свойство0.Поле;
		Если Ресурсы.Получить(Выражение0) = Истина Тогда
			Выборка.Колонки.Добавить(Новый Структура("Выражение, Имя", "СУММА(" + Выражение0 + ")", Свойство0.Поле));
		Иначе
			Выборка.Колонки.Добавить(Новый Структура("Выражение, Имя", Выражение0, Свойство0.Поле));
			Если Выборка.Группировка.Найти(Выражение0) = Неопределено Тогда
				Выборка.Группировка.Добавить(Выражение0);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Выборка.Поместить = "ВТ_Источник";
	План.Шаги.Добавить(Выборка);
	План.Выборка = OData4_Генератор.НоваяВыборка("ВТ_Источник", "Т");
	План.Группировка = Ложь;
КонецПроцедуры

// Группировка для /$count: колонки — поля ключа результата (они же группировка) и СУММА ресурсов набора
// результата, как в выборке коллекции (остатки без ресурсов в выборке 1С считает иначе: строка с одним
// нулевым ресурсом отбрасывается, только если в запросе нет других); число строк подзапроса — число групп.
// Набор, сгруппированный по упомянутым свойствам (решение 28), содержит только упомянутые ресурсы; без полей
// ключа ресурсы не суммируются — таблица 1С уже свёрнута в одну строку, а СУММА дала бы строку и без строк.
Процедура ПрименитьГруппировкуКоличества(План)
	Для Каждого Свойство0 Из План.Набор.ПоляКлюча Цикл
		Выражение0 = "Т." + Свойство0.Поле;
		OData4_Генератор.ДобавитьКолонку(План.Выборка, Выражение0);
		Если План.Выборка.Группировка.Найти(Выражение0) = Неопределено Тогда
			План.Выборка.Группировка.Добавить(Выражение0);
		КонецЕсли;
	КонецЦикла;
	БезКлюча = План.Набор.ПоляКлюча.Количество() = 0;
	Ресурсы = ВыраженияРесурсов(План);
	Для Каждого Свойство0 Из План.Набор.Свойства Цикл
		Выражение0 = "Т." + Свойство0.Поле;
		Если Ресурсы.Получить(Выражение0) = Истина Тогда
			OData4_Генератор.ДобавитьКолонку(План.Выборка, ?(БезКлюча, Выражение0, "СУММА(" + Выражение0 + ")"));
		КонецЕсли;
	КонецЦикла;
	План.Выборка.КоличествоПодзапросом = БезКлюча;
КонецПроцедуры

// Выражения колонок ресурсов результата: «Т.СуммаОстаток» → Истина.
Функция ВыраженияРесурсов(План)
	Ресурсы = Новый Соответствие;
	Для Каждого Свойство0 Из План.Функция.Ресурсы Цикл
		Ресурсы.Вставить("Т." + Свойство0.Поле, Истина);
	КонецЦикла;
	Возврат Ресурсы;
КонецФункции

#КонецОбласти
