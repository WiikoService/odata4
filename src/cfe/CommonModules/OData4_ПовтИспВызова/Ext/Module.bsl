#Область ПрограммныйИнтерфейс

// Настройки OData4 на время вызова: ФиксированнаяСтруктура всех ресурсов регистра OData4_Настройки
// (см. OData4_НастройкиСервиса.Прочитать); сбой чтения — значения по умолчанию.
Функция Настройки() Экспорт
	Возврат OData4_НастройкиСервиса.ПрочитатьБезОшибок();
КонецФункции

// Часовой пояс информационной базы, если не задан — сеанса. Кэш на время вызова.
Функция ЧасовойПоясБазы() Экспорт
	Пояс = ПолучитьЧасовойПоясИнформационнойБазы();
	Если Не ЗначениеЗаполнено(Пояс) Тогда
		Пояс = ЧасовойПояс();
	КонецЕсли;
	Возврат Пояс;
КонецФункции

// Описание типа значения по его XML-типу: ИмяТипа — значение *_Type (StandardODATA.Catalog_X,
// StandardODATA.<Перечисление> или StandardODATA.Undefined), ЭтоПеречисление. Кэш на время вызова.
Функция ОписаниеТипаЗначения(ИмяТипа, URIПространстваИмен) Экспорт
	ОбъектТипа = Неопределено;
	ТипЗначения = ИзXMLТипа(ИмяТипа, URIПространстваИмен);
	Если ТипЗначения <> Неопределено Тогда
		ОбъектТипа = Метаданные.НайтиПоТипу(ТипЗначения);
	КонецЕсли;
	Если ОбъектТипа = Неопределено Тогда
		Возврат Новый ФиксированнаяСтруктура("ИмяТипа, ЭтоПеречисление", "StandardODATA.Undefined", Ложь);
	КонецЕсли;
	Возврат Новый ФиксированнаяСтруктура("ИмяТипа, ЭтоПеречисление",
		"StandardODATA." + OData4_Модель.ИмяНабора(ОбъектТипа), Метаданные.Перечисления.Содержит(ОбъектТипа));
КонецФункции

// Ключ состава публикации. Кэш на время вызова: регистр читается один раз за запрос.
Функция КлючСостава() Экспорт
	Возврат СоставЗапроса().Ключ;
КонецФункции

// Состав запроса (OData4_Состав.СоставЗапроса: Структура «Ключ, Строки») — одно чтение регистра на вызов;
// по нему считается ключ модели и строится модель. Изменять нельзя.
Функция СоставЗапроса() Экспорт
	Возврат OData4_Состав.СоставЗапроса();
КонецФункции

#КонецОбласти
