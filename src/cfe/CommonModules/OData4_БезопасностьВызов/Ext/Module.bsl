#Область ПрограммныйИнтерфейс

// Контекст текущего запроса: изменяемая Структура, одна на вызов сервера (модуль с повторным использованием
// «на время вызова» возвращает в пределах вызова один и тот же объект). Заполняет OData4_Безопасность.Войти;
// остальные модули читают через OData4_Безопасность.ТекущийКонтекст() или напрямую (внутренние точки 5.2).
// Сервис — "odata" или "odatat"; Субъект — "u:<пользователь ИБ>" или "t:<UUID токена>"; ИмяСубъекта — имя
// пользователя или токена; Профиль — ссылка или Неопределено; ОписаниеПрофиля — OData4_Профили.Описание;
// ИсточникТокена — "", "Заголовок", "Путь", "Адрес", "Продолжение"; Токен — текст токена (только для nextLink при
// токене в адресе; наружу не отдаётся); ХешТокена — SHA-256 токена; КлючПрофиля — часть ключа модели;
// Настройки — настройки доступа; ЗаголовкиОтвета — заголовки, которые добавляются и к ответу об ошибке
// (Retry-After); НаборыПрофиля и РазрешенияПрофиля — кэш наборов в режиме «проверки по месту».
Функция Контекст() Экспорт
	Контекст = Новый Структура;
	Контекст.Вставить("Сервис", "");
	Контекст.Вставить("Субъект", "");
	Контекст.Вставить("ИмяСубъекта", "");
	Контекст.Вставить("Профиль", Неопределено);
	Контекст.Вставить("ОписаниеПрофиля", Неопределено);
	Контекст.Вставить("ИсточникТокена", "");
	Контекст.Вставить("Токен", "");
	Контекст.Вставить("ХешТокена", "");
	Контекст.Вставить("КлючПрофиля", "");
	Контекст.Вставить("Настройки", Неопределено);
	Контекст.Вставить("ЗаголовкиОтвета", Новый Соответствие);
	Контекст.Вставить("НаборыПрофиля", Новый Соответствие);
	Контекст.Вставить("РазрешенияПрофиля", Новый Соответствие);
	Возврат Контекст;
КонецФункции

#КонецОбласти
