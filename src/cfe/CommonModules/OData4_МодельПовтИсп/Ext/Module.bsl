#Область ПрограммныйИнтерфейс

// Фасад модели. Модель и документы $metadata хранятся в памяти сеанса (OData4_МодельКэш.ПамятьСеанса) по одному
// значению на вид: модель по составу, урезанная по профилю модель, XML- и JSON-документы каждой из них. Ключ вида
// меняется — прежнее значение освобождается (решение 40 плана 5.2: кэш платформы по ключу держал копию модели
// на каждый ключ до конца сеанса, и сеанс веб-сервера вырастал на ~320 МБ на ключ).
// Модели в кэше ленивые (этап 6.1): модель по составу — индекс наборов и построенные по требованию описания
// (OData4_Модель.НоваяМодель), модель профиля урезает набор при его построении (OData4_ПрофильМодели.МодельПрофиля).
// $metadata строится по временной полной копии, в памяти сеанса остаётся только документ.

// Модель EDM текущего запроса: при профиле в режиме «Представление модели на профиль» — урезанная копия, иначе
// полная модель по составу. Изменять возвращаемое значение нельзя.
Функция Модель() Экспорт
	Ключ = КлючМодели();
	Если СтрНайти(Ключ, "|Профиль:") = 0 Тогда
		Возврат ПолнаяМодель();
	КонецЕсли;
	Возврат МодельПрофиля(Ключ);
КонецФункции

// Модель служебного документа и $metadata: при профиле — урезанная в обоих режимах применения профиля
// (решение 3 плана 5.2), без профиля — полная.
Функция МодельДокументов() Экспорт
	Ключ = КлючДокументов();
	Если СтрНайти(Ключ, "|Профиль:") = 0 Тогда
		Возврат ПолнаяМодель();
	КонецЕсли;
	Возврат МодельПрофиля(Ключ);
КонецФункции

// Полная модель по составу без профиля (в режиме прав служебного пользователя «Привилегированный» — построенная
// привилегированно): основа урезания и отборов профиля (решение 7 плана 5.2).
Функция ПолнаяМодель() Экспорт
	Ключ = КлючМоделиБезПрофиля();
	Если Не OData4_Безопасность.ПривилегированноеЧтение() Тогда
		Возврат МодельСостава(Ключ, Ложь);
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Модель0 = МодельСостава(Ключ, Истина);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Модель0;
КонецФункции

// Функции языка запросов, доступные на этой платформе: Соответствие имя → Булево. Кэш на сеанс.
Функция ДоступныеФункции() Экспорт
	Возврат OData4_МодельКэш.ДоступныеФункции();
КонецФункции

// Документ $metadata в формате "XML" или "JSON" по модели документов (см. МодельДокументов). Кэш на сеанс по ключу.
Функция Метаданные(ВидДокумента) Экспорт
	Ключ = КлючДокументов();
	Если СтрНайти(Ключ, "|Профиль:") = 0 Тогда
		Возврат ДокументМетаданных(ВидДокумента, Ключ, Ложь);
	КонецЕсли;
	Возврат ДокументМетаданных(ВидДокумента, Ключ, Истина);
КонецФункции

// Ключ кэша модели и $metadata: состав публикации, версия настроек и, при профиле в режиме «Представление модели
// на профиль», ключ профиля (ссылка и версия данных профиля); в режиме «Привилегированный» — отдельная модель.
Функция КлючМодели() Экспорт
	Ключ = КлючМоделиБезПрофиля();
	Контекст = OData4_БезопасностьВызов.Контекст();
	Если Контекст.ОписаниеПрофиля <> Неопределено И Не OData4_Безопасность.ПроверкиПоМесту() Тогда
		Ключ = Ключ + "|" + Контекст.КлючПрофиля;
	КонецЕсли;
	Возврат Ключ;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Ленивая модель по составу для ключа Ключ из памяти сеанса; ключ изменился — строится заново (индекс).
// Привилегированно — модель строится в привилегированном режиме (признак Привилегированная); вызывает только
// ПолнаяМодель, чтобы модель ключа строилась одинаково, какой бы запрос сеанса ни был первым (решение 8 плана 6.1).
Функция МодельСостава(Ключ, Привилегированно)
	Значение = ЗначениеКэша("Модель", Ключ);
	Если Значение = Неопределено Тогда
		Значение = OData4_Модель.НоваяМодель(OData4_Состав.СоставПоСтрокам(OData4_ПовтИспВызова.СоставЗапроса().Строки));
		Значение.Вставить("Привилегированная", Привилегированно);
		ЗаписатьВКэш("Модель", Ключ, Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Ленивая модель профиля над полной моделью для ключа Ключ («…|Профиль:<UUID>:<версия данных>») из памяти сеанса.
Функция МодельПрофиля(Ключ)
	Значение = ЗначениеКэша("МодельПрофиля", Ключ);
	Если Значение = Неопределено Тогда
		Значение = OData4_ПрофильМодели.МодельПрофиля(ПолнаяМодель(), OData4_БезопасностьВызов.Контекст().ОписаниеПрофиля);
		ЗаписатьВКэш("МодельПрофиля", Ключ, Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Документ $metadata («XML» или «JSON») по ключу Ключ: ПоПрофилю — по урезанной модели профиля, иначе по модели
// состава (ПолнаяМодель: в режиме «Привилегированный» — привилегированно, как у запроса набора). Хранится в
// памяти сеанса по одному документу каждого вида. При промахе строится временная полная копия модели
// (OData4_Метаданные → OData4_Модель.Целиком) и документ только запрошенного формата; копия отпускается. Второй
// формат в том же сеансе строит копию заново — сознательная цена (решение 10 плана 6.1).
// Этап 8.3: между памятью сеанса и построением — кэш между сеансами (OData4_КэшМетаданных, флажок КэшМетаданных):
// промах памяти сеанса читает документ из регистра по ключу записи (ключ документов, индекс полной модели и
// отпечаток среды), промах регистра строит документ движком настройки РежимМетаданных (OData4_Метаданные.Документ)
// и сохраняет его в регистр.
Функция ДокументМетаданных(ВидДокумента, Ключ, ПоПрофилю)
	Формат0 = ?(ВидДокумента = "JSON", "JSON", "XML");
	Вид = "Документ" + Формат0;
	Значение = ЗначениеКэша(Вид, Ключ);
	Если Значение <> Неопределено Тогда
		Возврат Значение;
	КонецЕсли;
	КлючЗаписи = Неопределено;
	ТаблицаДоступна = Ложь;
	Если OData4_КэшМетаданных.Включён() Тогда
		КлючЗаписи = OData4_КэшМетаданных.КлючЗаписи(Ключ, ПолнаяМодель());
		Значение = OData4_КэшМетаданных.Прочитать(КлючЗаписи, Формат0, ТаблицаДоступна);
		Если Значение <> Неопределено Тогда
			ЗаписатьВКэш(Вид, Ключ, Значение);
			Возврат Значение;
		КонецЕсли;
	КонецЕсли;
	Модель0 = ?(ПоПрофилю, МодельПрофиля(Ключ), ПолнаяМодель());
	Значение = OData4_Метаданные.Документ(Модель0, Формат0);
	ЗаписатьВКэш(Вид, Ключ, Значение);
	// Запись — только если чтение в этом вызове дошло до таблицы: в сеансе, который не видит таблиц и типов
	// расширения (гонка начала сеанса HTTP-сервиса, ИО-1), создание набора записей даёт неперехватываемый ответ 500
	// «Тип не определен», а запрос — перехватываемую ошибку.
	Если КлючЗаписи <> Неопределено И ТаблицаДоступна И OData4_КэшМетаданных.ЗаписьДоступна() Тогда
		OData4_КэшМетаданныхЗапись.Записать(КлючЗаписи, Формат0, Значение);
	КонецЕсли;
	Возврат Значение;
КонецФункции

// Значение вида Вид из памяти сеанса, если оно сохранено для ключа Ключ; иначе Неопределено. Память сеанса —
// изменяемое Соответствие кэша повторно используемых значений (платформа может очистить его в любой момент).
Функция ЗначениеКэша(Вид, Ключ)
	Сохранённое = OData4_МодельКэш.ПамятьСеанса().Получить("Кэш:" + Вид);
	Если Сохранённое = Неопределено Или Сохранённое.Ключ <> Ключ Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Сохранённое.Значение;
КонецФункции

// Сохраняет значение вида Вид для ключа Ключ, освобождая прежнее значение этого вида (одно значение на вид:
// сеанс держит модель и документы только текущего ключа).
Процедура ЗаписатьВКэш(Вид, Ключ, Значение)
	OData4_МодельКэш.ПамятьСеанса().Вставить("Кэш:" + Вид, Новый Структура("Ключ, Значение", Ключ, Значение));
КонецПроцедуры

Функция КлючМоделиБезПрофиля()
	Ключ = OData4_ПовтИспВызова.КлючСостава() + "|В"
		+ Формат(OData4_Безопасность.НастройкиДоступа().ВерсияНастроек, "ЧН=0; ЧГ=0");
	Если OData4_Безопасность.ПривилегированноеЧтение() Тогда
		Ключ = Ключ + "|Привилегированный";
	КонецЕсли;
	Возврат Ключ;
КонецФункции

Функция КлючДокументов()
	Ключ = КлючМоделиБезПрофиля();
	Контекст = OData4_БезопасностьВызов.Контекст();
	Если Контекст.ОписаниеПрофиля <> Неопределено Тогда
		Ключ = Ключ + "|" + Контекст.КлючПрофиля;
	КонецЕсли;
	Возврат Ключ;
КонецФункции

#КонецОбласти
