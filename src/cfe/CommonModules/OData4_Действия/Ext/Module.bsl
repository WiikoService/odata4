#Область ПрограммныйИнтерфейс

// Действия над сущностью (этап 6.2): Post и Unpost документа. Адрес — «Document_X(ключ)/Post», «/Post()»,
// «/Post(PostingModeOperational=true)», «/StandardODATA.Post»; параметр PostingModeOperational — в адресе или в теле
// JSON (адрес главнее). Модель рассчитана на новые действия (Copy, SetDeletionMark): описание действия —
// ОписаниеДействия, выполнение — ветка в ВыполнитьДействие. Ответ — 204 с ETag новой версии (решение 2).
Функция ВыполнитьДействие(К) Экспорт
	Описание = ОписаниеДействия(К.Маршрут.Действие);
	Если Описание = Неопределено Тогда
		OData4_Сервис.ОшибкаOData(404, "NotFound", "Действие не найдено: " + К.Маршрут.Действие);
	КонецЕсли;
	ПроверитьПрименимость(К, Описание);
	OData4_Запись.УстановитьОперацию(К, Описание.Операция);
	OData4_Запись.ПроверитьОперацию(К, Описание.Операция);
	OData4_Запись.ПроверитьНаличиеУсловия(К);
	Оперативно = ПараметрОперативно(К);
	Ссылка = OData4_Запись.СтрокаСущности(К, К.Маршрут.Ключ).Получить("Ссылка");
	НачатьТранзакцию();
	Попытка
		OData4_Запись.ЗаблокироватьСсылку(К, Ссылка);
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			OData4_Сервис.ОшибкаOData(404, "NotFound", "Объект не найден: " + К.Набор.Имя + "(" + К.Маршрут.ТекстКлюча + ")");
		КонецЕсли;
		OData4_Запись.ПроверитьВерсию(К, Объект.ВерсияДанных);
		Если Описание.Имя = "Post" Тогда
			OData4_Запись.ЗаписатьОбъект(К, Объект, "Проведение", OData4_Запись.РежимПроведения(К, Объект, Оперативно));
		Иначе
			OData4_Запись.ЗаписатьОбъект(К, Объект, "ОтменаПроведения");
		КонецЕсли;
		OData4_Запись.ПроверитьВидимость(К, OData4_Запись.КлючСсылки(Ссылка));
		// Ответ — до фиксации (отзыв безопасности, группа B): после фиксации ответ уже не сбоит.
		Заголовки = Новый Соответствие;
		Версия = ВерсияОбъекта(Ссылка);
		Если Версия <> "" Тогда
			Заголовки.Вставить("ETag", OData4_Сериализация.ЗначениеETag(Версия));
		КонецЕсли;
		Ответ = OData4_Запись.ОтветБезТела(Заголовки);
		ЗафиксироватьТранзакцию();
	Исключение
		OData4_Запись.ОтменитьИПередать(К, ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// Описание действия по имени: Структура("Имя, Операция, Параметры") или Неопределено. Параметры — имена параметров
// действия (Булево).
Функция ОписаниеДействия(Имя) Экспорт
	Если Имя = "Post" Тогда
		Возврат Новый Структура("Имя, Операция, Параметры", "Post", "Проведение", "PostingModeOperational");
	ИначеЕсли Имя = "Unpost" Тогда
		Возврат Новый Структура("Имя, Операция, Параметры", "Unpost", "ОтменаПроведения", "PostingModeOperational");
	КонецЕсли;
	Возврат Неопределено;
КонецФункции


// Объявления действий набора в CSDL XML (решение 40, паритет со standard.odata, где Post и Unpost объявлены у всех
// документов как FunctionImport IsBindable IsSideEffecting): связанные Action с параметром PostingModeOperational.
Процедура ЗаписатьДействияCSDL(Запись, Набор) Экспорт
	Для Каждого Имя Из ДействияНабора(Набор) Цикл
		Запись.ЗаписатьНачалоЭлемента("Action");
		Запись.ЗаписатьАтрибут("Name", Имя);
		Запись.ЗаписатьАтрибут("IsBound", "true");
		Запись.ЗаписатьНачалоЭлемента("Parameter");
		Запись.ЗаписатьАтрибут("Name", "bindingParameter");
		Запись.ЗаписатьАтрибут("Type", "StandardODATA." + Набор.Имя);
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьНачалоЭлемента("Parameter");
		Запись.ЗаписатьАтрибут("Name", "PostingModeOperational");
		Запись.ЗаписатьАтрибут("Type", "Edm.Boolean");
		Запись.ЗаписатьАтрибут("Nullable", "true");
		Запись.ЗаписатьКонецЭлемента();
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;
КонецПроцедуры

// Объявления действий в CSDL JSON: перегрузки одного имени — одним массивом на уровне схемы (как функции). Модель —
// целиком (строится для ).
Процедура ЗаписатьДействияJSON(Запись, Модель) Экспорт
	Перегрузки = Новый Соответствие;
	Для Каждого ИмяНабора Из Модель.Порядок Цикл
		Набор = OData4_Модель.НайтиНабор(Модель, ИмяНабора);
		Для Каждого Имя Из ДействияНабора(Набор) Цикл
			Список = Перегрузки.Получить(Имя);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				Перегрузки.Вставить(Имя, Список);
			КонецЕсли;
			Список.Добавить(Набор.Имя);
		КонецЦикла;
	КонецЦикла;
	Для Каждого Имя Из СтрРазделить("Post,Unpost", ",") Цикл
		Список = Перегрузки.Получить(Имя);
		Если Список = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Запись.ЗаписатьИмяСвойства(Имя);
		Запись.ЗаписатьНачалоМассива();
		Для Каждого ИмяНабора Из Список Цикл
			Запись.ЗаписатьНачалоОбъекта();
			Запись.ЗаписатьИмяСвойства("$Kind");
			Запись.ЗаписатьЗначение("Action");
			Запись.ЗаписатьИмяСвойства("$IsBound");
			Запись.ЗаписатьЗначение(Истина);
			Запись.ЗаписатьИмяСвойства("$Parameter");
			Запись.ЗаписатьНачалоМассива();
			Запись.ЗаписатьНачалоОбъекта();
			Запись.ЗаписатьИмяСвойства("$Name");
			Запись.ЗаписатьЗначение("bindingParameter");
			Запись.ЗаписатьИмяСвойства("$Type");
			Запись.ЗаписатьЗначение("StandardODATA." + ИмяНабора);
			Запись.ЗаписатьКонецОбъекта();
			Запись.ЗаписатьНачалоОбъекта();
			Запись.ЗаписатьИмяСвойства("$Name");
			Запись.ЗаписатьЗначение("PostingModeOperational");
			Запись.ЗаписатьИмяСвойства("$Type");
			Запись.ЗаписатьЗначение("Edm.Boolean");
			Запись.ЗаписатьИмяСвойства("$Nullable");
			Запись.ЗаписатьЗначение(Истина);
			Запись.ЗаписатьКонецОбъекта();
			Запись.ЗаписатьКонецМассива();
			Запись.ЗаписатьКонецОбъекта();
		КонецЦикла;
		Запись.ЗаписатьКонецМассива();
	КонецЦикла;
КонецПроцедуры

// Имена действий набора: Post и Unpost — у набора любого документа (как standard.odata: проба — 186 объявлений на 186
// документов, в том числе 24 непроводимых; вызов у непроводимого — 400), иначе пусто.
Функция ДействияНабора(Набор) Экспорт
	Результат = Новый Массив;
	Если Набор = Неопределено Или Набор.Вид <> "Документ" Тогда
		Возврат Результат;
	КонецЕсли;
	Результат.Добавить("Post");
	Результат.Добавить("Unpost");
	Возврат Результат;
КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Post и Unpost — у проводимых документов (как у standard.odata, где действия объявлены только у них); иначе 400.
Процедура ПроверитьПрименимость(К, Описание)
	Если К.Набор.Вид <> "Документ" Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Действие " + Описание.Имя + " применяется только к документам, а не к "
			+ К.Набор.Имя);
	КонецЕсли;
	Если К.ОбъектМетаданных.Проведение <> Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Документ " + К.Набор.Имя + " не проводится");
	КонецЕсли;
КонецПроцедуры

// PostingModeOperational из адреса («true»/«false») или из тела JSON (Булево); не задан — Неопределено (настройка).
Функция ПараметрОперативно(К)
	Текст = К.Маршрут.ПараметрыДействия.Получить("PostingModeOperational");
	Для Каждого КлючИЗначение Из К.Маршрут.ПараметрыДействия Цикл
		Если КлючИЗначение.Ключ <> "PostingModeOperational" Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неизвестный параметр действия " + К.Маршрут.Действие + ": "
				+ КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Если Текст <> Неопределено Тогда
		Если НРег(Текст) = "true" Тогда
			Возврат Истина;
		ИначеЕсли НРег(Текст) = "false" Тогда
			Возврат Ложь;
		КонецЕсли;
		OData4_Сервис.ОшибкаOData(400, "BadRequest", "Параметр PostingModeOperational: ожидается true или false, а не " + Текст);
	КонецЕсли;
	Тело = OData4_ЗаписьПоля.РазобратьТело(К.Запрос);
	Для Каждого КлючИЗначение Из Тело Цикл
		Если КлючИЗначение.Ключ <> "PostingModeOperational" И СтрНайти(КлючИЗначение.Ключ, "@") = 0 Тогда
			OData4_Сервис.ОшибкаOData(400, "BadRequest", "Неизвестный параметр действия " + К.Маршрут.Действие + ": "
				+ КлючИЗначение.Ключ);
		КонецЕсли;
	КонецЦикла;
	Значение = Тело.Получить("PostingModeOperational");
	Если Значение = Неопределено Или ТипЗнч(Значение) = Тип("Булево") Тогда
		Возврат Значение;
	КонецЕсли;
	OData4_Сервис.ОшибкаOData(400, "BadRequest", "Параметр PostingModeOperational: ожидается true или false");
КонецФункции

Функция ВерсияОбъекта(Ссылка)
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Возврат ?(Объект = Неопределено, "", Объект.ВерсияДанных);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

#КонецОбласти
