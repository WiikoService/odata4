#Область ОбработчикиСобытийФормы

// Форма «Выпуск токена OData4» (задача 12 плана 5.3): параметры токена, затем однократный показ значения.
// Значение токена нигде не сохраняется: в базе только его хеш, реквизит формы очищается при закрытии.
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Адрес = "";
	Параметры.Свойство("АдресТокенов", Адрес);
	АдресСТокеном = Адрес;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПараметры;
	// Отзыв безопасности, группа A: ограничение по IP без доверенного заголовка прежде молча не действовало, теперь
	// такой токен отвергается — форма говорит об этом до выпуска.
	Проверяется = Истина;
	Попытка
		Проверяется = OData4_Безопасность.АдресКлиентаПроверяется();
	Исключение
		Проверяется = Истина;
	КонецПопытки;
	Если Не Проверяется Тогда
		Элементы.ДекорацияIP.Заголовок = Элементы.ДекорацияIP.Заголовок + Символы.ПС
			+ "Сейчас доверенный заголовок адреса клиента НЕ настроен: токен с разрешёнными IP не пустит никого.";
		Элементы.ДекорацияIP.ЦветТекста = WebЦвета.Красный;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	// Значение токена не остаётся ни в одном реквизите формы: в адрес оно подставлено целиком.
	Токен = "";
	АдресСТокеном = "";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаВыпустить(Команда)
	Выпустить();
КонецПроцедуры

// Выпускает токен и показывает его; Истина — выпущен. Экспорт — для клиентского теста формы.
&НаКлиенте
Функция Выпустить() Экспорт
	Если ПустаяСтрока(ИмяТокена) Или Не ЗначениеЗаполнено(ПрофильТокена) Тогда
		ПоказатьПредупреждение(, "Укажите имя токена и профиль.");
		Возврат Ложь;
	КонецЕсли;
	Итог = ВыпуститьНаСервере();
	Если Не ПустаяСтрока(Итог) Тогда
		ПоказатьПредупреждение(, Итог);
		Возврат Ложь;
	КонецЕсли;
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаПоказ;
	ТекущийЭлемент = Элементы.Токен;
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура КомандаЗакрытьФорму(Команда)
	Закрыть(Истина);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выпускает токен (OData4_Профили.ВыпуститьТокен) и готовит адрес с ним; возвращает текст ошибки (пустой — ок).
// Экспорт — для клиентского теста формы.
&НаСервере
Функция ВыпуститьНаСервере() Экспорт
	// Адреса и срок проверяет сама OData4_Профили.ВыпуститьТокен (дефект приёмки 5.3 Д3): форма показывает
	// её текст отказа.
	Попытка
		Значение = OData4_Профили.ВыпуститьТокен(ИмяТокена, ПрофильТокена, СрокДействия, РазрешённыеIP);
	Исключение
		Возврат "Токен не выпущен: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Токен = Значение;
	АдресСТокеном = СтрЗаменить(АдресСТокеном, "<токен>", Значение);
	Возврат "";
КонецФункции

#КонецОбласти
