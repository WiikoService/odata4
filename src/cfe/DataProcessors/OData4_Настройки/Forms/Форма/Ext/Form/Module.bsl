	Модифицированность = Истина;
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПачкаЖурналаПриИзменении(Элемент)
	Модифицированность = Истина;
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура АдресПриИзменении(Элемент)
	Модифицированность = Истина;
	ЗаполнитьАдреса(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ТокеныПродолженияПриИзменении(Элемент)
	Модифицированность = Истина;
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура РежимПравПриИзменении(Элемент)
	ВосстановитьЗначениеИзСписка(Элемент);
	Модифицированность = Истина;
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПрофильПользователяПриИзменении(Элемент)
	ПрофилиПользователейИзменены = Истина;
	Модифицированность = Истина;
КонецПроцедуры

// Отметка служебной учётки — такая же правка настроек, как любое поле (дефект приёмки Р1: отметку теряли
// молча, потому что флажок таблицы не сообщал форме об изменении).
&НаКлиенте
Процедура СлужебнаяУчёткаПриИзменении(Элемент)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОтборПриИзменении(Элемент)
	ПрименитьОтбор();
КонецПроцедуры

// Вкладка «Удаление» (план 6.3, решение 8): чек-лист физического удаления считается при первом открытии вкладки
// и по кнопке «Проверить» — на открытие формы он времени не тратит.
&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница = Элементы.СтраницаУдаление И Не ЧекЛистПроверен Тогда
		ОбновитьЧекЛистУдаления();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаПроверитьУдаление(Команда)
	ОбновитьЧекЛистУдаления();
КонецПроцедуры

// Экспорт — для клиентского теста формы.
&НаКлиенте
Процедура ОбновитьЧекЛистУдаления() Экспорт
	ПроверитьУдалениеНаСервере();
КонецПроцедуры

// Пункты OData4_ПроверкаУдаления по значениям полей формы (режим и отмеченные служебные учётки — ещё не
// записанные).
&НаСервере
Процедура ПроверитьУдалениеНаСервере()
	Значения = Новый Структура("РазрешитьФизическоеУдаление, СлужебныеПользователи, РежимПравСлужебногоПользователя",
		Настройки_РазрешитьФизическоеУдаление, СлужебныеУчёткиСтрокой(), Настройки_РежимПравСлужебногоПользователя);
	ЧекЛистУдаления.Очистить();
	Для Каждого Пункт Из OData4_ПроверкаУдаления.Пункты(Значения) Цикл
		ЗаполнитьЗначенияСвойств(ЧекЛистУдаления.Добавить(), Пункт);
	КонецЦикла;
	ЧекЛистПроверен = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаЗаписатьИЗакрыть(Команда)
	Если ЗаписатьНаКлиенте() Тогда
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗаписать(Команда)
	ЗаписатьНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура КомандаПеречитать(Команда)
	ПрочитатьНастройки();
	ПрочитатьСоставНаСервере();
	ПрочитатьДоступНаСервере();
	Модифицированность = Ложь;
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура КомандаСоздатьПрофиль(Команда)
	ОткрытьКарточкуПрофиля(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КомандаИзменитьПрофиль(Команда)
	Текущий = Элементы.СписокПрофилей.ТекущаяСтрока;
	Если Текущий = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите профиль в списке.");
		Возврат;
	КонецЕсли;
	ОткрытьКарточкуПрофиля(Текущий);
КонецПроцедуры

&НаКлиенте
Процедура КомандаПометитьПрофильНаУдаление(Команда)
	Текущий = Элементы.СписокПрофилей.ТекущаяСтрока;
	Если Текущий = Неопределено Тогда
		ПоказатьПредупреждение(, "Выберите профиль в списке.");
		Возврат;
	КонецЕсли;
	Вопрос = ?(ПометкаУдаленияТекущегоПрофиля(), "Снять пометку удаления с профиля ", "Пометить на удаление профиль ")
		+ """" + Строка(Текущий) + """?";
	Оповещение = Новый ОписаниеОповещения("ПометитьПрофильЗавершение", ЭтотОбъект, Текущий);
	ПоказатьВопрос(Оповещение, Вопрос, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура СписокПрофилейВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
