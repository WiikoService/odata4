#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьСпискиВыбора();
	ПрочитатьНастройки();
	ПрочитатьСоставНаСервере();
	ПрочитатьДоступНаСервере();
	Состояние = OData4_Движок.СостояниеКомпоненты();
	Если Состояние.БезопасныйРежим Тогда
		СостояниеКомпоненты = "Не подключается: расширение в безопасном режиме. Разбор, выдача и $metadata — на языке 1С.";
		// Режимы этапа 8 без компоненты не действуют (OData4_Движок.РежимДвижка): поля только для чтения.
		Для Каждого Имя Из СтрРазделить("Настройки_РежимВыдачи,Настройки_РежимРазбораТел,Настройки_РежимМетаданных", ",") Цикл
			Элементы[Имя].Доступность = Ложь;
		КонецЦикла;
	ИначеЕсли Состояние.Доступна Тогда
		СостояниеКомпоненты = "Доступна, версия " + Состояние.Версия;
	Иначе
		СостояниеКомпоненты = "Недоступна: " + Состояние.Ошибка;
	КонецЕсли;
	ЭлементПорядка = Список.Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("Время");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	ЭлементПорядка.Использование = Истина;
	ОтборСтатус = "";
	УправлениеФормой(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	// Серверные вызовы при завершении работы запрещены, поэтому признак изменений — только клиентский
	// (блокер ручной проверки: закрытие клиента с открытой формой давало ошибку).
	Если Не ЕстьИзменения() Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	Если ЗавершениеРаботы Тогда
		ТекстПредупреждения = "Настройки OData4 не записаны.";
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, "Настройки изменены. Записать?", РежимДиалогаВопрос.ДаНетОтмена);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

// Экспорт — для клиентского теста формы (он же пересобирает надписи через УправлениеФормой).
